# Negative values jump through one table, in the order of signed numbers, for words and longs.
noinline func word(x: i32) -> i32:
    switch x:
    case -6:
        return 60
    case -5:
        return 50
    case -4:
        return 40
    case -3:
        return 30
    case -2:
        return 20
    case -1:
        return 10
    case 0:
        return 0
    case 1:
        return -10
    case 2:
        return -20
    case:
        return 999

noinline func long(x: i64) -> i64:
    switch x:
    case -9223372036854775807 - 1:
        return 1
    case -9223372036854775807:
        return 2
    case -9223372036854775806:
        return 3
    case -9223372036854775805:
        return 4
    case -9223372036854775804:
        return 5
    case -9223372036854775803:
        return 6
    case -9223372036854775802:
        return 7
    case -9223372036854775801:
        return 8
    case:
        return 0

noinline func top(x: i64) -> i64:
    switch x:
    case 9223372036854775807:
        return 1
    case 9223372036854775806:
        return 2
    case 9223372036854775805:
        return 3
    case 9223372036854775804:
        return 4
    case 9223372036854775803:
        return 5
    case 9223372036854775802:
        return 6
    case 9223372036854775801:
        return 7
    case 9223372036854775800:
        return 8
    case:
        return 0

noinline func byte(x: i8) -> i64:
    switch x:
    case -128:
        return 1
    case -127:
        return 2
    case -126:
        return 3
    case 124:
        return 4
    case 125:
        return 5
    case 126:
        return 6
    case 127:
        return 7
    case -1:
        return 8
    case 0:
        return 9
    case:
        return 0

func main():
    for x in -8..5:
        print(x, " ", word(i32(x)))
    print(word(-2147483648), " ", word(2147483647))
    least := -9223372036854775807 - 1
    for k in 0..10:
        print(long(least + k), " ", long(9223372036854775807 - k), " ", top(9223372036854775807 - k), " ", top(least + k))
    s := 0
    for x in -128..128:
        s = s * 7 + byte(i8(x))
    print(s)
