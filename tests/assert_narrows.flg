type error Missing

func find(n: i32) -> i32|Missing:
    if n > 0:
        return n
    return Missing

func half(n: i32) -> i32|null:
    if n % 2 == 0:
        return n / 2
    return null

func main():
    found := find(3)
    assert found is i32
    print(found * 2)
    again := find(4)
    assert not again is Missing
    print(again + 1)
    h := half(8)
    assert h != null
    print(h + 1)
    k := half(6)
    assert null != k, "k has no half"
    print(k)
