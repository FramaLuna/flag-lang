context state:
    pad: array[i64, 600]
    counts: array[i64, 8]
    old: &list[i32] = heap([])
    kept: &list[i32] = heap([])

func renew(n: i64):
    state.counts[n] += 1
    free(state.old)
    state.old = heap([])
    append(state.kept, i32(n))

func main():
    renew(3)
    print(state.counts[3], state.kept[0])
    free(state.old)
    free(state.kept)
