extern "c":
    func kept(run: *bytes) -> i32

export func mix():
    x := f64(@argc())
    a := x * 1.5
    b := x * 2.5
    c := x * 3.5
    d := x * 4.5
    e := x * 5.5
    f := x * 6.5
    g := x * 7.5
    h := x * 8.5
    i := x * 9.5
    j := x * 10.5
    k := x * 11.5
    l := x * 12.5
    m := x * 13.5
    n := x * 14.5
    print(a + b + c + d + e + f + g + h + i + j + k + l + m + n)

func main():
    print(kept(ptr(mix)))
