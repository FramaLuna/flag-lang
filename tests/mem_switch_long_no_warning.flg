noinline func pick(x: i64) -> &str:
    made: &str = heap("start")
    switch x:
    case 0:
        made += "0"
    case 1:
        made += "1"
    case 2:
        made += "2"
    case 3:
        made += "3"
    case 4:
        made += "4"
    case 5:
        made += "5"
    case 6:
        made += "6"
    case 7:
        made += "7"
    case 8:
        made += "8"
    case 9:
        made += "9"
    case 10:
        made += "10"
    case 11:
        made += "11"
    case 12:
        made += "12"
    case 13:
        made += "13"
    case 14:
        made += "14"
    case 15:
        made += "15"
    case 16:
        made += "16"
    case 17:
        made += "17"
    case 18:
        made += "18"
    case 19:
        made += "19"
    case 20:
        made += "20"
    case 21:
        made += "21"
    case 22:
        made += "22"
    case 23:
        made += "23"
    case 24:
        made += "24"
    case 25:
        made += "25"
    case 26:
        made += "26"
    case 27:
        made += "27"
    case 28:
        made += "28"
    case 29:
        made += "29"
    case 30:
        made += "30"
    case 31:
        made += "31"
    case 32:
        made += "32"
    case 33:
        made += "33"
    case 34:
        made += "34"
    case 35:
        made += "35"
    case 36:
        made += "36"
    case 37:
        made += "37"
    case 38:
        made += "38"
    case 39:
        made += "39"
    case:
        free(made)
        made = heap("other")
    return made

func main():
    for x in [3, 39, 40]:
        s := pick(x)
        print(s, "\n")
        free(s)
