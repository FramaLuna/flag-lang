# the modules of the library that need nothing of the host
use bits
use json
use math
use ring
use utf8

func main():
    print(PI, " ", sin(1.0), " ", cos(1.0), " ", tan(0.5), " ", exp(1.0), " ", log(10.0), " ", log2(1000.0), " ", log10(0.5), " ", pow(2.0, 0.5), " ", pow(-8.0, 3.0))
    print(asin(0.5), " ", acos(-0.5), " ", atan(1e10), " ", atan2(-1.0, -1.0), " ", hypot(3.0, 4.0), " ", fmod(10.5, 3.0), " ", round(-2.5), " ", floor(-2.5), " ", ceil(-2.5), " ", trunc(-2.5), " ", sqrt(2.0))
    print(sin(1e22), " ", cos(1e300), " ", tan(1e100), " ", exp(-745.0), " ", exp(709.0), " ", log(5e-324), " ", pow(10.0, -320.0), " ", sin(f32(1.0)))
    seed(42)
    print(random(1, 6), " ", random(1, 6), " ", random() < 1.0)
    parsed := parse_json("{\"name\": \"flag\", \"tags\": [1, 2.5, true, null], \"nested\": {\"deep\": \"\\u00e9\"}}")
    print(parsed)
    q := ring(i64)
    defer free(q)
    for i in 0..10:
        append(q, i)
    prepend(q, -1)
    print(q.len, " ", take(q), " ", pop(q), " ", q)
    set: Bits[2]
    for k in [3, 64, 100, 127]:
        set[k] = true
    print(count(ptr(set)), " ", set[64], " ", set[65], " ", empty(ptr(set)))
    text := "añ€😀"
    print(count_chars(text), " ", text.len, " ", first_code(text[1:]), " ", valid_utf8(text), " ", valid_utf8(text[:2]))
