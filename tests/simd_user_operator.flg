type Mat4:
    rows: array[simd[f32, 4], 4]

operator *(m: Mat4, v: simd[f32, 4]) -> simd[f32, 4]:
    return [sum(m.rows[0] * v), sum(m.rows[1] * v), sum(m.rows[2] * v), sum(m.rows[3] * v)]

func main():
    m: Mat4
    m.rows[0] = [1.0, 0.0, 0.0, 0.0]
    m.rows[1] = [0.0, 2.0, 0.0, 0.0]
    m.rows[2] = [0.0, 0.0, 3.0, 0.0]
    m.rows[3] = [0.0, 0.0, 0.0, 1.0]
    v: simd[f32, 4] = [1.0, 1.0, 1.0, 1.0]
    print(m * v)
