type Pair[$T]:
    a: $T
    b: $T

func biggest(items: &list[$T]) -> $T:
    best := items[0]
    for x in items:
        if x > best:
            best = x
    return best

func main():
    p := Pair[i64]{3, 4}
    print(p.a + p.b, " ", sizeof(Pair[u8]))
    l: &list[u64]
    defer free(l)
    append(l, 5)
    append(l, 50)
    append(l, 7)
    print(biggest(l))
