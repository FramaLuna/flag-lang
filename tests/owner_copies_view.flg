func main():
    t: &str = heap("start")
    defer free(t)
    v: &strview = "hola"
    t = v
    print(t, " ", t.len)
    l: &list[i64] = heap([])
    defer free(l)
    source := [7, 8, 9]
    l = ptr(source)
    source[0] = 0
    print(l, " ", source)
    copy := heap(l[1:])
    defer free(copy)
    append(copy, 4)
    print(copy, " ", l)
