use os

# a process is waited once, like a thread: a copy of one waited already is gone
func main() -> i32:
    if args().len > 1:
        return 3
    me := executable()
    if ends_with(me, ".exe"):
        me = me[:-4]
    p := start(ptr([me, "child"])) iferror Process{}
    q := p
    print(wait p)
    flush()
    print(wait q)
    return 0
