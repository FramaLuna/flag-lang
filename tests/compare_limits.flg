func main() -> i32:
    a: u8 = 255
    b: u8 = 1
    print(a > b, " ", a < b, " ", a == 255, " ", a >= 200)
    c: u16 = 65535
    d: u32 = 4294967295
    e: u32 = 0
    print(c > 1, " ", d > e, " ", d < e, " ", d > 2147483647)
    f: u64 = 18446744073709551615
    print(f > 0, " ", f > 9223372036854775807, " ", f == 18446744073709551615)
    g: i8 = -1
    h: i8 = 1
    i: i16 = -32768
    print(g < h, " ", g < 0, " ", i < 32767, " ", i <= -32768)
    j: i64 = -9223372036854775807 - 1
    k: usize = 0
    k -= 1
    print(j < 0, " ", j < 9223372036854775807, " ", k > 0, " ", k == 18446744073709551615)
    return 0
