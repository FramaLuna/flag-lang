func main():
    path := "build/tests/file_write_values.txt"
    out := create(path)
    if out is FsError:
        print(out)
        return
    write(out, 42)
    write(out, " ")
    write(out, [1, 2])
    write(out, " ")
    write(out, 2.5)
    write(out, "\nsecond line\r\n")
    print(flush(out))
    close(out)
    back := open(path)
    if back is File:
        line := read_line(back)
        while line is &strview:
            print("<", line, ">")
            line = read_line(back)
        print(line)
        close(back)
    print(open("build/tests/no/such/file.txt"))
