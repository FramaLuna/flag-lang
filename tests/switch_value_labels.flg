type Limits:
    low: i32
    high: i32

func main():
    l := Limits{1, 9}
    t := [4, 9]
    for n in 0..10:
        switch n:
        case l.low:
            print("low")
        case t[1]:
            print("t1")
        case (l.high):
            print("high")
        case l.low + 3:
            print("four")
