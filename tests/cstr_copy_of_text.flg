extern "c":
    func strlen(s: cstr) -> usize
func main():
    names: &list[&str]
    for i in 0..40:
        s: &str = "12345678901234567890123456789012"
        append(names, s)
    total: usize = 0
    for n in names:
        total += strlen(n)
    print(total)
    moved := 0
    for n in names:
        if n.cap != 32:
            moved += 1
    print("caps changed in the list: ", moved)
    for i in 0..names.len:
        names[i] += "x"
    print(names[0], " ", names[39])
    for i in 0..names.len:
        free(names[i])
    free(names)
