func main():
    good: &list[&str] = heap([])
    bad: &list[&str] = heap([])
    for line in ["ana", "#bo", "cy"]:
        s: &str = heap(line)
        if starts_with(line, "#"):
            append(bad, s)
        else:
            append(good, s)
    for n in good:
        free(n)
    for n in bad:
        free(n) # for the checker the two lists may hold the same block
    free(good)
    free(bad)
