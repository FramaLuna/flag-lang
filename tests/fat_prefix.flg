func shout(s: &strview) -> usize:
    return s.len

func total(s: &slice[i32]) -> i32:
    sum := 0
    for x in s:
        sum += x
    return sum

func main() -> i32:
    name: &str = "flag"
    name += "!"
    print(shout(name), " ", find(name, "g") is usize, " ", starts_with(name, "fl"))
    view_of: &strview = name
    print(view_of)
    l: &list[i32]
    append(l, 3)
    append(l, 1)
    append(l, 2)
    print(total(l), " ", l[1])
    sort(l)
    for x in l:
        print(x)
    return 0
