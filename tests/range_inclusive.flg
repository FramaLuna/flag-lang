func main():
    last: u8 = 255
    n := 0
    for b in 0..=last:
        n += 1
    print(n)
    for b in reverse 0..=last:
        n += 1
    print(n)
    for i in 2..=4:
        print(i)
    for i in reverse 2..=4:
        print(i)
    for i in 3..=2:
        print("never")
    for i in 3..=3:
        print("once ", i)
    low: i8 = -128
    high: i8 = 127
    k := 0
    for x in low..=high:
        k += 1
    print(k)
    top: i64 = 9223372036854775807
    for x in top - 1..=top:
        print(x)
    for x in reverse top - 1..=top:
        if x == top:
            continue
        print(x)
    a := [5, 6, 7, 8]
    sum := 0
    for i in 0..=3:
        sum += a[i]
    print(sum)
