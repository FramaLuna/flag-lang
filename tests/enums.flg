type enum Shade = Red|Green|Blue

type enum Token:
    Word, Number
    Space

func name(s: Shade) -> &strview:
    out: &strview = "?"
    switch s:
    case Red:
        out = "red"
    case Green, Blue:
        out = "cool"
    return out

func code(t: Token) -> i32:
    switch t:
    case Word:
        return 1
    case Number:
        return 2
    case Space:
        return 3

func main() -> i32:
    s: Shade = Green
    print(name(s), " ", name(Red))
    if s == Green:
        print("green")
    s = Blue
    print(s != Green, " ", code(Space))
    n := 5
    switch n:
    case 1, 2:
        print("small")
    case 5:
        print("five")
    case:
        print("other")
    word: &strview = "beta"
    switch word:
    case "alpha":
        print("a")
    case "beta", "gamma":
        print("b")
    case:
        print("c")
    return 0
