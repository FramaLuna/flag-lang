use fs
use os

func main():
    path := "build/tests/fs_modified.txt"
    _ = write_file(path, "first")
    first := modified(path) iferror 0.0
    print(first > now() - 60.0 and first < now() + 60.0)
    sleep(0.05)
    _ = write_file(path, "second")
    second := modified(path) iferror 0.0
    print(second > first) # 50 ms apart, and the times tell them apart
    print(modified("build/tests") is f64)
    print(modified("build/tests/fs_modified.none"))
    _ = remove(path)
