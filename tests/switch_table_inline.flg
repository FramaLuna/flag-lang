# A switch with a table inlined into two callers and into a loop: each copy has its own table.
inline func digit(c: u8) -> i64:
    switch c:
    case '0':
        return 0
    case '1':
        return 1
    case '2':
        return 2
    case '3':
        return 3
    case '4':
        return 4
    case '5':
        return 5
    case '6':
        return 6
    case '7':
        return 7
    case '8':
        return 8
    case '9':
        return 9
    case:
        return -1

noinline func number(text: &strview) -> i64:
    n := 0
    for c in items(text):
        d := digit(c)
        if d < 0:
            return -1
        n = n * 10 + d
    return n

noinline func last(text: &strview) -> i64:
    return digit(items(text)[text.len - 1])

func main():
    print(number("90210"), " ", number("12a"), " ", last("x7"), " ", last("xy"))
