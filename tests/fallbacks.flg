type error Missing

func find(name: &strview) -> i32|Missing:
    if name == "ana":
        return 30
    return Missing

func maybe(n: i32) -> i32?:
    if n > 0:
        return n
    return null

func loud(n: i32) -> i32:
    print("fallback ran")
    return n

func main():
    print(find("ana") iferror -1, " ", find("bo") iferror -1)
    print(maybe(4) ifnull 0, " ", maybe(-4) ifnull 0)
    print(maybe(2) ifnull loud(9))
    print(maybe(-2) ifnull loud(9))
    x := maybe(-1) ifnull 7
    print(x + 1, " ", maybe(5) ifnull 0 > 3)
    mixed := find("bo") iferror "none"
    print(mixed)
