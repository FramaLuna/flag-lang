SIZE = 20

type Color:
    r: u8
    g: u8
    b: u8

func label(text: &strview, size: i32 = SIZE, color: Color = Color{255, 0, 0}, bold: bool = false):
    print(text, " ", size, " ", color.r, " ", color.g, " ", bold)

func twice(x: $T, times: $T = 2) -> $T:
    return x * times

func main() -> i32:
    size := 99
    label("a")
    label("b", 10)
    label("c", bold = true)
    label("d", color = Color{1, 2, 3}, size = size)
    print(twice(21), " ", twice(1.5, 3))
    return 0
