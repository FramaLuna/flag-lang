# [] in a constant, a typed constant or a default is every element at zero, and the code after it stays its own
type P:
    a: array[i64, 1]
    b: i64

type Grid:
    cells: array[i64, 2] = []
    w: i64 = 3

ORIGIN = P{[], 7}
Z = []
K = 42
TYPED: array[i64, 2] = array[i64, 2]{}
BRACES: array[i64, 3] = {}

func main():
    print(ORIGIN, " ", P{[], 7})
    a: array[i64, 3] = Z
    print(a, " ", K, " ", TYPED, " ", BRACES)
    g: Grid
    print(g, " ", LAST)

LAST: array[i64, 2] = []
