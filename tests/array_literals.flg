func main() -> i32:
    a := [1, 2]
    b := [1, "hola"]
    c := [u8(1), 2]
    d := [1, 2.5]
    print(a, " ", b, " ", c, " ", d, " ", sizeof(array[i32, 2]))
    x: array[u8, 3] = [1, 2, 3]
    nest := [[1, 2], [3, 4]]
    print(x, " ", nest[1][0], " ", [1, 2, 3][2])
    p: *array[i32, 2] = heap([1, 2])
    l: &list[i32] = p
    append(l, 3)
    print(l, " ", l.len)
    empty: &list[&strview] = heap([])
    append(empty, "z")
    none: &list[i32] = []
    print(empty, " ", none.len)
    free(l)
    free(empty)
    return 0
