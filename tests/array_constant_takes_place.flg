type Point:
    x: u8
    y: u8

SHADER = [0x0723_0203, 0x0001_0000, 0x0008_000b]
ORIGIN = {1, 2}

func words(code: &slice[u32]) -> usize:
    return code.len

func main():
    code: &slice[u32] = ptr(SHADER)
    print(words(code), " ", code[0])
    small: *array[u16, 2] = ptr([7, 8])
    print(small.*)
    floats: &slice[f32] = ptr([1, 2])
    print(floats)
    p: *Point = ptr(ORIGIN)
    print(p.x + p.y)
    q: *Point = ptr({3, 4})
    print(q.*)
