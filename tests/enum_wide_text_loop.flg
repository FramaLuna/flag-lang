func show(s: *&str, items: &slice[Op]):
    for i in 0..items.len:
        if i > 0:
            s.* += ", "
        s.* += items[i]

func main():
    ops: array[Op, 2] = [Op7, Op2499]
    s: &str
    defer free(s)
    show(ptr(s), ptr(ops))
    print(s)
