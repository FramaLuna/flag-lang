func kind(x: u8) -> &strview:
    return "u8"

func kind(x: i32) -> &strview:
    return "i32"

func kind(x: i64) -> &strview:
    return "i64"

func main():
    x: u8 = 1
    n: i32 = 3
    print(x << n, " ", kind(x << n))
    n = 9
    print(x << n, " ", x << 300)
    one: i64 = 1
    a: u8 = 40
    print(one << a, " ", kind(one << a))
    word: u64 = 0xff00
    by: i64 = 8
    print(word >> by)
    print(1 << n, " ", kind(1 << n))
