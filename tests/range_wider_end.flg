# the two ends of a range of different integer types take the wider one, and a literal end takes the type of the other
func kind(x: i64) -> &strview:
    return "i64"

func kind(x: i32) -> &strview:
    return "i32"

func kind(x: u8) -> &strview:
    return "u8"

func main():
    a: i32 = 1
    b: i64 = 3
    for x in a..b:
        print(kind(x), " ", x)
    for x in reverse b - 2..=a + 1:
        print(kind(x), " ", x)
    small: u8 = 254
    for x in small..=255:
        print(kind(x), " ", x)
    for x in 0..a:
        print(kind(x), " ", x)
