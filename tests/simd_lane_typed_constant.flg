# a lane is chosen with a number the compiler knows, a constant with a type too
LANE: i64 = 2
FIRST: i32 = 0
LAST: u8 = 3

func main():
    v: simd[f32, 4] = [1.0, 2.0, 3.0, 4.0]
    v[LANE] = 9.0
    v[LAST] += 1.0
    m := v > 2.5
    m[FIRST] = true
    print(v[LANE], " ", v[FIRST], " ", v, " ", m, " ", m[LANE + 1])
