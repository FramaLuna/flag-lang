func slice_of(text: &strview, from: i64 = 0, to: i64 = text.len) -> &strview:
    return text[from:to]

type Box:
    w: i64
    h: i64

func area(b: Box, scale: i64 = 1, total: i64 = b.w * b.h * scale) -> i64:
    return total

func make(kind: type $T, n: i64 = 2, total: i64 = n * 3) -> i64:
    return total

func twice(p: *i64, by: i64 = p.*) -> i64:
    return p.* + by

func main():
    print(slice_of("hola", 1), " ", slice_of("hola", to = 2), " ", slice_of(to = 3, text = "hola"))
    print(area(Box{2, 3}), " ", area(Box{2, 3}, 2), " ", area(Box{2, 3}, total = 5))
    x: i64 = 4
    print(make(i32), " ", make(u8, 5), " ", twice(x), " ", twice(x, 1))
