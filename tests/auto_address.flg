type Counter:
    n: i32

func bump(c: *Counter):
    c.n += 1

func show(c: Counter) -> &strview:
    return "by value"

func show(c: *Counter) -> &strview:
    return "by pointer"

func grow(x: *i32):
    x.* *= 2

func main():
    c := Counter{1}
    bump(c)
    bump(ptr(c))
    print(c.n, " ", show(c), " ", show(ptr(c)))
    n: i32 = 5
    grow(n)
    print(n)
