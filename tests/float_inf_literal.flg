# inf and nan are words of the language, with the values print writes
LOW = -inf
HIGH: f64 = inf

type Range:
    low: f64
    high: f32

func main():
    x: f32 = inf
    y := -x
    print(LOW, " ", HIGH, " ", x, " ", y, " ", nan, " ", -nan)
    print(inf == inf, " ", nan == nan, " ", nan != nan, " ", inf > 1e308, " ", -inf < LOW + 1.0)
    print(i32(inf), " ", i32(-inf), " ", i32(nan), " ", u8(inf), " ", f32(inf), " ", f64(x))
    print(inf - inf, " ", inf * 2.0, " ", inf * 0.0, " ", 1.0 / inf, " ", 1 + inf)
    z := 0.0
    q := z / z
    print(q == nan, " ", q != q, " ", inf as u64, " ", nan as u64)
    r := Range{LOW, inf}
    print(r, " ", (parse_float("" + inf) ifnull 0.0) == inf, " ", (parse_float("-inf") ifnull 0.0) == -inf)
    v: simd[f32, 4] = [1.0, nan, inf, -inf]
    print(v != v, " ", v == inf, " ", array[f32, 2]([nan, inf]))
    best := inf
    for k in [3.0, 1.5, 2.0]:
        if k < best:
            best = k
    print(best)
