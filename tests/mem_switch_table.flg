# Each way out of a table frees what it holds, and -memory follows every one of them.
func main():
    for k in 0..12:
        names: &list[&strview] = heap([])
        switch k:
        case 0:
            append(names, "zero")
            free(names)
        case 1:
            free(names)
        case 2:
            append(names, "two")
            free(names)
        case 3:
            free(names)
        case 4:
            free(names)
        case 5:
            free(names)
        case 6:
            free(names)
        case 7:
            free(names)
        case:
            free(names)
