func loud(s: &strview) -> &str:
    out: &str = s
    out += "!"
    return out

@trust
func shout(names: &list[&strview]):
    print(loud(names[0]))
    for n in names:
        print(loud(n))

func main() -> i32:
    names: &list[&strview]
    defer free(names)
    append(names, "ada")
    shout(names)
    print(loud("bob"))
    return 0
