func main():
    level: Arena
    defer free(level)
    empty: &list[i64] = arena(level, [])
    start := arena(level, [1, 2, 3])
    bytes: &list[u8] = arena(level, [250, 251])
    for i in 0..100000:
        append(empty, i64(i))
        append(start, i)
    insert(bytes, 0, 7)
    reserve(bytes, 1000)
    print(empty.len, " ", empty[99999], " ", start.len, " ", start[:5], " ", start[-1], " ", bytes, " ", bytes.cap)
