func title(name: &strview) -> &strview:
    return upper(name[0:1]) + name[1:name.len]

func main() -> i32:
    for i in 0..3:
        with scratch():
            print(title("ada") + " #" + i)
    outer := upper("x")
    with scratch():
        print(outer, lower("Y"))
    print(outer)
    return 0
