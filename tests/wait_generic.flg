func finish(t: Thread[$T]) -> $T:
    return wait(t)

func nothing():
    print("nothing")

func twice(n: i64) -> i64:
    return n * 2

func main():
    a := parallel nothing()
    x := finish(a)
    print(x)
    b := parallel nothing()
    finish(b)
    c := parallel twice(21)
    print(finish(c))
