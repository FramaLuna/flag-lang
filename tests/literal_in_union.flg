type Point:
    x: f32
    y: f32

type Missing:
    name: &strview

corners: array[u8, 3]|Missing = [1, 2, 200]

func main():
    p: Point|null = {1.0, 2.0}
    a: array[u8, 3]|null = [1, 2, 300 - 100]
    v: simd[f32, 4]|null = [1.0, 2.0, 3.0, 4.0]
    m: &map[&strview, f32]|null = {"a": 1.0}
    print(p, " ", a, " ", v, " ", m, " ", corners)
    if m is &map[&strview, f32]:
        free(m)
    l: &list[u8]|null = null
    work: Arena
    defer free(work)
    l = arena(work, [4, 5])
    print(l)
