type World:
    arena: Arena
    lock: Lock
    name: &strview

func main():
    fresh: Arena
    copy := fresh
    l: Lock
    other := l
    w := heap(World{})
    defer free(w)
    worlds: &list[World]
    defer free(worlds)
    append(worlds, World{name = "first"})
    print(copy.count, " ", other.depth, " ", worlds[0].name)
