func tag(s: &strview, n: i64) -> i64:
    print(s)
    return n

func named(a: i64, b: i64):
    print(a, " ", b)

func defaults(a: i64, b: i64 = tag("default b", 9), c: i64 = tag("default c", 0)):
    print(a, " ", b, " ", c)

type Pair:
    a: i64
    b: i64

func main():
    named(b = tag("b", 2), a = tag("a", 1))
    defaults(tag("a", 1), c = tag("c", 3))
    p := Pair{b = tag("b", 2), a = tag("a", 1)}
    print(p.a, " ", p.b)
