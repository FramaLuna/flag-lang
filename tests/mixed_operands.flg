func kind(x: i32) -> &strview:
    return "i32"

func kind(x: i64) -> &strview:
    return "i64"

func kind(x: u8) -> &strview:
    return "u8"

func kind(x: u16) -> &strview:
    return "u16"

func main():
    digits: &strview = "7"
    n: i32 = 3
    print(digits[0] - '0' + n, " ", kind(digits[0] + n))
    a: i32 = 1
    b: i64 = 2
    c := a + b
    print(c, " ", kind(c), " ", kind(b - a), " ", b * a, " ", b / a, " ", b % a)
    big: u32 = 4000000000
    print(big + b, " ", kind(big + b))
    b += a
    print(b)
    e: u8 = 255
    f: u16 = 1
    print(e + f, " ", kind(e + f), " ", e + e, " ", kind(e + e), " ", e and f, " ", f or e, " ", e xor f)
