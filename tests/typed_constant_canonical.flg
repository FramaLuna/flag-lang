# an i32 made from 32 bits without sign is the number of its type, -1 here, which the compiler knows as such
LAST: i32 = 0xffff_ffff as i32
M: u32 = 0xffff_ffff
NEG1: i32 = i32(M)
BACK: i32 = -1
HIGH: u32 = M - 1
SIZE: u32 = 2 + M + 1

noinline func id(x: $T) -> $T:
    return x

func main():
    x := id(i32(-2147483648))
    print(LAST, " ", NEG1, " ", LAST == BACK, " ", NEG1 == -1, " ", @sizeof(array[u8, HIGH]))
    print(x / LAST, " ", x % LAST, " ", x / NEG1, " ", x % NEG1, " ", x / (0xffff_ffff as i32), " ", x / i32(u32(0xffff_ffff)))
    l: array[i64, 3] = [1, 2, 3]
    buf: array[u8, SIZE]
    print(l[LAST], " ", l[NEG1], " ", l[BACK], " ", buf.len)
