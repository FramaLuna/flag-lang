context g:
    rows: &list[&list[i64]] = heap([])

func main() -> i32:
    first: &list[i64] = heap([])
    second: &list[i64] = heap([])
    append(g.rows, first)
    append(g.rows, second)
    for i in 0..10:
        append(g.rows[i % 2], i)
    print(g.rows[0][0], " ", g.rows[1].len)
    return 0
