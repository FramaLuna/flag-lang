type Pair:
    a: i64
    b: i64

context app:
    p: Pair

func bump(p: Pair) -> i64:
    p.a += 10
    return p.a

func same(p: Pair) -> Pair:
    return p

func both(v: Pair, w: *Pair) -> i64:
    w.a = 100
    return v.a

func current() -> Pair:
    return app.p

func change() -> i64:
    app.p.a = 7
    return 0

func first(p: Pair, n: i64) -> i64:
    return p.a + n

func main():
    x := Pair{1, 2}
    print(bump(x), " ", x)
    y := same(x)
    x.a = 5
    print(y, " ", x)
    print(both(x, ptr(x)), " ", x)
    app.p = Pair{3, 4}
    print(first(current(), change()), " ", app.p)
