use utf8

func main():
    for s in ["\xc3a", "\x80\x80a", "h\xc3\xa9llo", "\xe2\x82", "\xe2\x82\xacx", "\xf0\x9f\x98\x80", "\xf0\x9f\x98", "\x80\x80\x80\x80\x80", "\xc3\xa9\xa9", "\xff\xfe", "\xf8\x80\x80\x80\x80", ""]:
        forward: &str
        for c in s:
            forward += c.len
        back: &str
        for c in reverse s:
            back += c.len
        print(forward, " ", back, " ", count(s))
        free(forward)
        free(back)
