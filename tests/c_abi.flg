type Division:
    quot: i32
    rem: i32

type Wide:
    quot: i64
    rem: i64

extern "c":
    func div(a: i32, b: i32) -> Division
    func lldiv(a: i64, b: i64) -> Wide
    func toupper(c: i32) -> i32

func main() -> i32:
    d := div(17, 5)
    print(d.quot, " ", d.rem)
    w := lldiv(100000000000, 7)
    print(w.quot, " ", w.rem)
    print(toupper('a'))
    return 0
