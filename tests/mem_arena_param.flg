type Enemy:
    name: &str

func load(a: *Arena) -> &list[*Enemy]:
    enemies: &list[*Enemy] = arena(a, [])
    for i in 0..3:
        name := arena(a, "orc ")
        name += i
        append(enemies, arena(a, Enemy{name}))
    return enemies

func main():
    level: Arena
    defer free(level)
    print(load(level)[2].name)
