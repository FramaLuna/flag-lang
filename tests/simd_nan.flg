use math

func main():
    zero := 0.0
    n := f32(zero / zero)
    v: simd[f32, 4] = [n, 1.0, -0.0, 0.0]
    w: simd[f32, 4] = [1.0, n, 0.0, -0.0]
    print(v < w, " ", v <= w, " ", v == w, " ", v != w, " ", v > w, " ", v >= w)
    print(min(v, w) != min(v, w), " ", max(v, w) != max(v, w), " ", sum(w) != sum(w))
    print((min(v, w)[2] as u32) >> 31, " ", (min(v, w)[3] as u32) >> 31, " ", (max(v, w)[2] as u32) >> 31, " ", (max(v, w)[3] as u32) >> 31)
    print((abs(v) as simd[u32, 4]) >> 31, " ", (-w as simd[u32, 4])[2] >> 31, " ", (-w as simd[u32, 4])[3] >> 31)
