func main() -> i32:
    m := {"a": 1, "b": 2}
    print(m["a"], " ", m["b"], " ", m.len)
    ages: &map[&strview, u8] = heap({"ana": u8(30)})
    blank: &map[i32, i32] = heap({})
    put(blank, 7, 49)
    mixed := {1: "one", 2: 2}
    print(ages, " ", blank, " ", mixed[1], " ", mixed[2])
    free(ages)
    free(blank)
    return 0
