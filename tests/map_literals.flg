func main() -> i32:
    m := {"a": 1, "b": 2}
    print(get(m, "a"), " ", get(m, "b"), " ", m.len)
    ages: &map[&strview, u8] = {"ana": 30}
    blank: &map[i32, i32] = {}
    put(blank, 7, 49)
    mixed := {1: "one", 2: 2}
    print(ages, " ", blank, " ", get(mixed, 1), " ", get(mixed, 2))
    free(m)
    free(ages)
    free(blank)
    free(mixed)
    return 0
