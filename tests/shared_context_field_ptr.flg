type Inner:
    a: i32
    b: i64

shared context stats:
    x: i64 = 4
    y: i64 = 9
    inner: Inner
    many: array[i64, 4]

Y: *i64 = ptr(stats.y)
B: *i64 = ptr(stats.inner.b)
ELEMENT: *i64 = ptr(stats.many[2])

type Holder:
    p: *i64 = ptr(stats.y)

HELD: Holder = {ptr(stats.many[3])}

func main():
    Y.* = 11
    B.* = 12
    ELEMENT.* = 13
    h: Holder
    print(stats.y, " ", stats.inner.b, " ", stats.many[2], " ", h.p.*)
    HELD.p.* = 14
    print(stats.many[3], " ", Y == ptr(stats.y))
