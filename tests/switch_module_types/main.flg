use shapes as s

func main():
    all: array[s.Shape, 4] = [s.Circle{2}, s.Box{3, {true}}, s.Box.lid{false}, null]
    for x in all:
        switch x:
        case s.Circle:
            print("circle ", x.r)
        case s.Box.lid:
            print("lid ", x.open)
        case s.Box:
            print("box ", x.side)
        case null:
            print("nothing")
