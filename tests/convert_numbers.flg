func main() -> i32:
    big: i32 = 300
    neg: i32 = -1
    print(u8(big), " ", i8(big), " ", u8(neg), " ", u16(neg), " ", u32(neg), " ", u64(neg))
    s: i8 = -1
    print(i64(s), " ", u64(s), " ", u8(s), " ", usize(s))
    w: u64 = 18446744073709551615
    print(i32(w), " ", u32(w), " ", i64(w), " ", u8(w), " ", i16(w))
    b: u8 = 200
    print(i8(b), " ", i16(b), " ", u64(b))
    t := true
    print(i32(t), " ", u8(false), " ", f64(t))
    x := 3.99
    y := -3.99
    print(i32(x), " ", i32(y), " ", u8(x), " ", u32(y), " ", u8(-0.5))
    huge := 1.0e30
    print(i32(huge), " ", i8(huge), " ", u16(huge), " ", i64(-huge), " ", u64(huge))
    z := 0.0
    nan := z / z
    print(i32(nan), " ", u64(nan), " ", i8(nan))
    e19 := 1.0e19
    print(u64(e19), " ", i64(e19))
    edge := 2147483647.0
    print(i32(edge), " ", i32(edge + 1.0), " ", i32(-edge - 2.0))
    return 0
