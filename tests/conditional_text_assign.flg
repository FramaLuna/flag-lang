# a text a if c else b goes into the memory that an existing &str already has
func main():
    yes := true
    s: &str = heap("start")
    defer free(s)
    s = "direct"
    print(s)
    s = "first" if yes else "second"
    print(s)
    s = "first" if not yes else "second"
    print(s)
    view_of: &strview = "kept"
    s = view_of if yes else "other"
    print(s, " ", view_of)
