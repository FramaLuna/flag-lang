type error Bad

type Holder:
    v: i32|Bad

func may() -> i32|Bad:
    return 1

func nothing() -> i32|null:
    return null

func take(v: i32|Bad, more: i32 = 2) -> i32:
    if v is Bad:
        return 0
    return v + more

func main():
    argument := may()
    print(take(v = argument))
    field := may()
    h := Holder{v = field}
    print(h.v is Bad)
    replacement := may()
    y := nothing() ifnull replacement
    if y is Bad:
        return
    print(y)
