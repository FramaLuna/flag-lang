type Job:
    name: &str

func main():
    jobs: &list[Job] = heap([])
    append(jobs, Job{name = heap("b")})
    append(jobs, Job{name = heap("a")})
    for j in jobs:
        free(j.name)
    free(jobs)
    names: &list[&str] = heap([])
    for i in 0..5:
        s: &str = heap("n")
        s += 5 - i
        append(names, s)
    sort(names) # moving elements around puts no block in two of them
    first := names[0]
    names[0] = names[1]
    names[1] = first
    for i in 0..names.len / 2:
        swap(names, i, names.len - 1 - i)
    for n in names:
        free(n)
    free(names)
