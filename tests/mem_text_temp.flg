func title(name: &strview) -> &strview:
    return upper(name[0:1]) + name[1:name.len]

func main() -> i32:
    for i in 0..3:
        with scratch():
            print(title("ada") + " #" + i)
    words := split("a,b,c", ",")
    print(join(words, "-"), " ", replace("x-y", "-", "+"), " ", lower("HEY"))
    path := cstr("hola " + 42)
    print(view(path))
    return 0
