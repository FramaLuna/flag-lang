type Circle:
    r: f64

type Square:
    side: f64

type Rect:
    w: f64
    h: f64

type Shape = Circle|Square|Rect

func area(s: Shape) -> f64:
    if s is Circle:
        return 3.0 * s.r * s.r
    elif s is Square:
        return s.side * s.side
    else:
        return s.w * s.h

func kind(s: Shape) -> &strview:
    name: &strview = "rect"
    if s is Circle|Square:
        name = "round or square"
        if s is Circle:
            return "circle"
    return name

func main() -> i32:
    shapes: &list[Shape]
    one: Shape = Circle{1.0}
    append(shapes, one)
    two: Shape = Square{2.0}
    append(shapes, two)
    three: Shape = Rect{2.0, 3.5}
    append(shapes, three)
    total := 0.0
    for s in shapes:
        total += area(s)
        print(kind(s))
    print(total)
    c := one as Circle
    print(c.r)
    return 0
