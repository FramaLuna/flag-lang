func main():
    f: simd[f32, 4] = [1.9, -1.9, 3000000000.0, -3000000000.0]
    print(simd[i32, 4](f), " ", simd[u32, 4](f), " ", simd[i64, 2](simd[f64, 2]([1e300, -0.5])))
    zero := 0.0
    nan := zero / zero
    print(simd[i32, 4]([nan, 1.0 / zero, -1.0 / zero, 2.5]))
    i: simd[i32, 4] = [1, -2, 16777217, 0]
    print(simd[f32, 4](i), " ", simd[u32, 4](i), " ", simd[f32, 4](7), " ", simd[i32, 4](true))
    a: array[f32, 4] = [0.5, 1.5, 2.5, 3.5]
    v := simd[f32, 4](a)
    print(v, " ", array[f32, 4](v * 2.0), " ", array[i32, 4](v), " ", simd[f32, 4]([1, 2, 3, 4]))
    m := v > 1.0
    print(simd[i32, 4](m), " ", array[bool, 4](m), " ", simd[bool, 4](array[bool, 4](m)))
    bits := v as simd[u32, 4]
    print(bits >> 23, " ", (bits as simd[f32, 4]) == v, " ", v as array[f32, 4])
    w: simd[i16, 8] = [-1, 2, -3, 4, -5, 6, -7, 8]
    print(simd[u16, 8](w), " ", simd[f64, 2](simd[i64, 2]([3, -4])))
