func main() -> i32:
    l: &list[i32]
    for i in 0..5:
        append(l, i * i)
    total := 0
    for i in 0..5:
        total += l[i]
    word := "flag"
    k: u8 = 1
    print(total, " ", l[k], " ", word[1:3], " ", items(word)[2])
    j := -1
    print(l[j], " ", l[-5], " ", word[-1], " ", word[-3:-1])
    print(l[-6])
    return 0
