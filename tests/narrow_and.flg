func pick(a: i64?, b: i64?) -> i64:
    if a is i64 and b is i64:
        return a + b
    if a is null or a < 0:
        return 0
    return a

func main() -> i32:
    print(pick(2, 3), " ", pick(4, null), " ", pick(null, 1), " ", pick(-4, null))
    x: i32|&strview = 7
    if x is i32 and x > 5:
        print("big ", x)
    while x is i32 and x > 0:
        x -= 3
    print(x is i32)
    return 0
