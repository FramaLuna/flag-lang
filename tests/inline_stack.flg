type Pair:
    a: i64
    b: i64

type Wide:
    cells: array[i64, 16]

func swap(p: Pair) -> Pair:
    q := Pair{p.b, p.a}
    return q

func touch(w: Wide, i: i64) -> i64:
    copy := w
    copy.cells[0] = i
    return copy.cells[0] + w.cells[1]

func main():
    p := Pair{1, 2}
    total: i64 = 0
    w: Wide
    for i in 0..10000000:
        p = swap(p)
        total += touch(w, i64(i) and 1)
    print(p, " ", total)
