func main():
    s: &str
    defer free(s)
    for i in 0..100000:
        s += "abc."
    print(find_last(s, "."), " ", find_last(s, "c."), " ", find_last(s, "x"), " ", find_last(s, ""), " ", find_last("ab", "abc"))
    print(find_last("aaa", "aa"), " ", find_last("a.b.c", "."), " ", find_last("", ""), " ", find_last("", "a"))
