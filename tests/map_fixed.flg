func main():
    ages: fixmap[&strview, i32, 3] = {"ana": 30}
    _ = put(ages, "bo", 25)
    _ = put(ages, "cy", 7)
    print(ages, " ", ages.len, " ", ages["bo"], " ", ages["zoe"])
    print(put(ages, "di", 1) is MapFull, " ", put(ages, "bo", 26) is null)
    print(remove(ages, "ana"), " ", contains(ages, "ana"), " ", ages)
    for e in ages:
        print(e.key, " = ", e.value)
    clear(ages)
    print(ages.len, " ", ages)
    empty: fixmap[i32, i32, 2] = {}
    print(empty, " ", sizeof(fixmap[i32, i32, 2]))
