context app:
    names: &list[i64] = heap([])

func emptied(x: i64) -> i64:
    free(app.names)
    return x

type Op: # its default makes emptied the first function of the program
    run: func(i64) -> i64 = emptied

func main():
    append(app.names, 1)
    first := ptr(app.names[0])
    o: Op
    print(o.run(2))
    print(first.*)
