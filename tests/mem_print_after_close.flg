use fs

func main():
    print("before")
    f := open("build/tests/mem_print_after_close.txt")
    if f is File:
        close(f)
    print("after")
    t := read_file("build/tests/mem_print_after_close.txt")
    if t is FsError:
        eprint(t)
        return
    defer free(t)
    print("again")
