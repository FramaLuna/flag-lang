func main():
    a: fixmap[i32, i32, 3] = {1: 10, 2: 20}
    b: fixmap[i32, i32, 3] = {1: 10}
    _ = remove(a, 2)
    print(a, " ", b, " ", a == b)
    keys: &map[fixmap[i32, i32, 3], i32]
    defer free(keys)
    keys[a] = 1
    print(keys[b])
    c: fixmap[i32, i32, 3] = {2: 20, 1: 10}
    d: fixmap[i32, i32, 3] = {1: 10, 2: 20}
    e: fixmap[i32, i32, 3] = {1: 10, 2: 21}
    print(c == d, " ", hash(c) == hash(d), " ", d == e)
