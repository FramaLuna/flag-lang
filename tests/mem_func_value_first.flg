func twice(x: i64) -> i64:
    return x * 2

type Op: # its default makes twice the first function of the program
    run: func(i64) -> i64 = twice

context app:
    names: &list[i64] = heap([])

func fill(o: Op):
    append(app.names, 1)
    print(o.run(2))

func main():
    o: Op
    fill(o)
    print(app.names.len)
    free(app.names)
