type P:
    v: i64

type Big:
    a: i64
    b: i64
    c: i64

func bump(p: *i64) -> i64:
    p.* += 10
    return p.*

func bumpp(p: *P) -> i64:
    p.v += 10
    return p.v

func pick(a: i64, b: i64) -> i64:
    return a * 100 + b

func show(a: i64, b: i64):
    print(a, " ", b)

func add(to: *i64, n: i64):
    to.* += n

func sum(b: Big, n: i64) -> i64:
    return b.a + b.b + b.c + n

func grown(b: *Big) -> i64:
    b.a = 100
    return 0

func main():
    x: i64 = 1
    print(x + bump(ptr(x)))
    x = 1
    print(x + bump(ptr(x)) * 1)
    x = 1
    print(x * 1 + bump(ptr(x)))
    x = 1
    print(x < bump(ptr(x)))
    p := P{1}
    print(p.v + bumpp(ptr(p)))
    x = 1
    print(pick(x, bump(ptr(x))))
    x = 1
    show(x, bump(ptr(x)))
    x = 1
    print([x, bump(ptr(x))])
    x = 1
    pairs := {x: bump(ptr(x))}
    print(pairs)
    x = 1
    print(x, " ", bump(ptr(x)))
    x = 1
    f := pick
    print(f(x, bump(ptr(x))))
    x = 1
    l := [x, 2]
    print(l[0] + bump(ptr(l[0])))
    x = 1
    add(x, bump(ptr(x)))
    print(x)
    big := Big{1, 2, 3}
    print(sum(big, grown(ptr(big))), " ", big.a)
    q := P{1}
    print(q == P{bumpp(ptr(q)) - 10}, " ", q.v)
