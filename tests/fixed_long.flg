func main():
    print(fixed(1.0e300, 2))
    big: &str
    defer free(big)
    big += fixed(-1.7976931348623157e308, 3)
    print(big.len, " ", big[0:6], " ", big[big.len - 5:big.len])
    print(fixed(1.0, 100))
    print(fixed(0.5, 70), " ", fixed(2.5, 0))
    print(fixed(1.5, -1), " ", fixed(2.5, -3), " ", fixed(-1234.5678, -2), " ", fixed(f32(0.25), -1))
