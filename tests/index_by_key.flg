func at(l: &list[i32], name: &strview) -> i32:
    return l[name.len]

func main():
    l: &list[i32]
    defer free(l)
    for i in 0..6:
        append(l, i32(i * 10))
    print(l["four"], " ", l[1], " ", l[-1])
    m: fixmap[&strview, i32, 4]
    trust put(m, "a", 1)
    trust put(m, "b", 2)
    for e in m:
        print(e.key, " ", e.value)
    swap(l, 0, 5)
    print(l[0], " ", l[5])
    swap(l, 0, 9)
