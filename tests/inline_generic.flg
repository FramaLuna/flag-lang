type V:
    x: f64
    y: f64

operator +(a: V, b: V) -> V:
    return V{a.x + b.x, a.y + b.y}

operator ==(a: V, b: V) -> bool:
    return a.x == b.x and a.y == b.y

func bigger(a: $T, b: $T) -> $T:
    if b > a:
        return b
    return a

func scale(v: V, k: f64) -> V:
    return V{v.x * k, v.y * k}

func main():
    acc := V{0.0, 0.0}
    for i in 0..1000:
        acc = acc + scale(V{1.0, 2.0}, 0.5)
    print(acc, " ", acc == V{500.0, 1000.0}, " ", acc + acc == acc)
    print(bigger(3, 9), " ", bigger(2.5, -1.0), " ", bigger("pear", "apple"))
