func keep(items: &slice[$T], fits: (func($T) -> bool)?) -> usize:
    n: usize = 0
    for v in items:
        if fits is null:
            n += 1
        elif fits(v):
            n += 1
    return n
func even(x: i32) -> bool:
    return x % 2 == 0
func main():
    l := [1, 2, 3, 4]
    print(keep(ptr(l), even))
    print(keep(ptr(l), null))
