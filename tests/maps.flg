func main() -> i32:
    m: &map[&strview, usize]
    words: &strview = "the cat and the dog and the bird"
    start: usize = 0
    for i in 0..words.len + 1:
        if i == words.len or words[i:i + 1] == " ":
            w := words[start:i]
            got := get(m, w)
            if got is usize:
                put(m, w, got + 1)
            else:
                put(m, w, 1)
            start = i + 1
    print(m.len, " ", squares())
    the := get(m, "the")
    if the is usize:
        print("the ", the)
    miss := get(m, "fish")
    if miss is null:
        print("no fish")
    return 0

func squares() -> i32:
    m: &map[usize, usize]
    for i in 0..usize(100):
        put(m, i, i * i)
    got := get(m, 12)
    if got is usize:
        return i32(got)
    return 0
