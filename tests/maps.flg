func main() -> i32:
    m: &map[&strview, i64] = heap({})
    words: &strview = "the cat and the dog and the bird"
    start: i64 = 0
    for i in 0..words.len + 1:
        if i == words.len or words[i:i + 1] == " ":
            w := words[start:i]
            got := m[w]
            if got is i64:
                put(m, w, got + 1)
            else:
                put(m, w, 1)
            start = i + 1
    print(m.len, " ", squares())
    the := m["the"]
    if the is i64:
        print("the ", the)
    miss := m["fish"]
    if miss is null:
        print("no fish")
    return 0

func squares() -> i32:
    m: &map[i64, i64] = heap({})
    for i in 0..i64(100):
        put(m, i, i * i)
    got := m[12]
    if got is i64:
        return i32(got)
    return 0
