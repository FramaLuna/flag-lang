use os

func main():
    if args().len > 1:
        for i in 0..20000:
            print("line ", i)
        write(stdout, "no new line at the end")
        return
    text: &str
    defer free(text)
    print(output(ptr([args()[0], "child"]), text))
    lines := split(text, "\n")
    print(lines.len, " ", lines[0], " ", lines[19999], " ", lines[-1], " ", text.len)
