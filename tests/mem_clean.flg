type Point:
    x: i32
    y: i32

func main() -> i32:
    points: &list[Point]
    defer free(points)
    for i in 0..3:
        append(points, Point{i, i * 2})
    total := 0
    for p in points:
        total += p.x + p.y
    print(total)
    words := split("a,b,c", ",")
    print(words.len)
    ages: &map[&strview, i32]
    defer free(ages)
    put(ages, "ada", 36)
    print(get(ages, "ada"))
    text: &str = "hola"
    defer free(text)
    text += " mundo"
    shout := upper(text)
    print(text, " ", shout)
    return 0
