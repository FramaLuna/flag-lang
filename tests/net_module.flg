use net
use os

extern "c":
    func fcntl(fd: i32, command: i32, ...) -> i32
    func GetHandleInformation(handle: *bytes, flags: *u32) -> i32
    func signal(number: i32, handler: usize) -> usize

func inherited(fd: i32) -> bool where not @windows():
    return (fcntl(fd, 1) and 1) == 0 # F_GETFD and FD_CLOEXEC

func inherited(fd: i32) -> bool where @windows():
    flags: u32 = 0
    GetHandleInformation(usize(fd) as *bytes, ptr(flags))
    return (flags and 1) != 0 # HANDLE_FLAG_INHERIT

func default_broken_pipe() where not @windows():
    signal(13, 0) # SIGPIPE to SIG_DFL, the CI runner starts us with it ignored

func default_broken_pipe() where @windows():
    pass

func broken_pipe() where not @windows():
    _ = run("yes | head -1")

func broken_pipe() where @windows():
    print("y")

func main() -> i32:
    default_broken_pipe()
    server := listen(0)
    if server is NetError:
        print(server)
        return 1
    client := connect("127.0.0.1", port(server))
    if client is NetError:
        print(client)
        return 1
    peer := accept(server)
    if peer is NetError:
        print(peer)
        return 1
    print(inherited(server.fd), " ", inherited(client.fd), " ", inherited(peer.fd))
    write(client, "hello over tcp\r\n")
    write(client, 42)
    write(client, "\n")
    print(read_line(peer))
    print(read_line(peer))
    write(peer, "and back")
    _ = flush(peer)
    got: &str
    defer free(got)
    print(read(client, got, 3), " ", got)
    print(read(client, got, 1024), " ", got)
    timeout(peer, 0.05)
    start := clock()
    late := read_line(peer)
    if late is NetError:
        print(late.code == TIMED_OUT, " ", clock() - start >= 0.04, " ", late)
    close(client)
    print(read_line(peer))
    write(peer, "nobody")
    lost := flush(peer)
    for i in 0..300:
        if lost is null:
            sleep(0.01)
            write(peer, "nobody listens")
            lost = flush(peer)
    if lost is NetError:
        print(lost.action)
    close(peer)
    broken_pipe()
    taken := listen(port(server))
    if taken is NetError:
        print(taken.action, " ", taken.address == "" + port(server))
    close(server)
    refused := connect("127.0.0.1", 1)
    if refused is NetError:
        print(refused.action, " ", starts_with("" + refused, "cannot connect to 127.0.0.1:1: "))
    unknown := connect("nosuch.invalid", 80)
    if unknown is NetError:
        print(unknown.code < 0, " ", starts_with("" + unknown, "cannot connect to nosuch.invalid:80: "))
    return 0
