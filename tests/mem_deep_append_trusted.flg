type L:
    names: &list[i64] = heap([])
type T2:
    f: *L
type T1:
    f: *T2
type T0:
    f: *T1

func grow(a: *T0):
    append(a.f.f.f.names, 1)

func main():
    l: L
    append(l.names, 0)
    x2 := T2{ptr(l)}
    x1 := T1{ptr(x2)}
    x0 := T0{ptr(x1)}
    first := ptr(l.names[0])
    grow(ptr(x0)) @trust
    print(first.*)
    free(l.names)
