func main():
    level: Arena
    defer free(level)
    m: &map[i32, i32] = arena(level, {})
    for i in 0..10000:
        m[i] = i * 2
    remove(m, 5)
    named := arena(level, {"a": 1, "b": 2})
    named["c"] = 3
    total := 0
    for e in m:
        total += e.value
    print(m.len, " ", m[9999], " ", m[5], " ", total, " ", named.len, " ", named["c"])
