type Byte:
    a: u8

type Half:
    a: i16

type Single:
    a: f32

extern "c":
    func small_on_stack(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, b: Byte, after_b: i64, h: Half, after_h: i64, s: Single, after_s: i64) -> i64
    func call_back() -> i64

export func flag_small_on_stack(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64, b: Byte, after_b: i64, h: Half, after_h: i64, s: Single, after_s: i64) -> i64:
    return i64(b.a) * 100000 + after_b * 10000 + i64(h.a) * 1000 + after_h * 100 + i64(s.a) * 10 + after_s

func main():
    print(small_on_stack(0, 0, 0, 0, 0, 0, 0, 0, Byte{1}, 2, Half{3}, 4, Single{5.0}, 6))
    print(call_back())
