noinline func swap_many(rounds: i32) -> i32:
    a0: i32 = 1
    a1: i32 = 2
    a2: i32 = 3
    a3: i32 = 4
    a4: i32 = 5
    a5: i32 = 6
    a6: i32 = 7
    a7: i32 = 8
    a8: i32 = 9
    a9: i32 = 10
    b0: i32 = 11
    b1: i32 = 12
    b2: i32 = 13
    b3: i32 = 14
    b4: i32 = 15
    b5: i32 = 16
    b6: i32 = 17
    b7: i32 = 18
    b8: i32 = 19
    b9: i32 = 20
    for i in 0..rounds:
        a0, b0 = b0, a0
        a1, b1 = b1, a1
        a2, b2 = b2, a2
        a3, b3 = b3, a3
        a4, b4 = b4, a4
        a5, b5 = b5, a5
        a6, b6 = b6, a6
        a7, b7 = b7, a7
        a8, b8 = b8, a8
        a9, b9 = b9, a9
    return a0 * 100 + b0 + a9 * 10 + b9

func main():
    print(swap_many(1))
    print(swap_many(2))
    print(swap_many(5))
