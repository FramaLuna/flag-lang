context app:
    items: &list[i64] = heap([])

func rebuild():
    kept: &list[i64] = heap([])
    for e in app.items:
        append(kept, e)
    free(app.items)
    app.items = kept

func run() -> i64:
    for i in 0..3:
        rebuild()
    return 0

func main():
    print(run())
    free(app.items)
