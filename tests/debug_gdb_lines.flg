type enum Color:
    Red, Green, Blue

func classify(n: i32, c: Color) -> i32:
    r := 0
    if n > 10:
        r = 1
    elif n > 5:
        r = 2
    switch c:
    case Red:
        r += 10
    case Green:
        r += 20
    case:
        r += 30
    return r

func total(items: &list[i32]) -> i32:
    sum := 0
    for x in items:
        if x < 0:
            continue
        sum += x
    return sum

func main():
    items: &list[i32]
    defer free(items)
    append(items, -1)
    print(classify(7, Blue), " ", total(items))
