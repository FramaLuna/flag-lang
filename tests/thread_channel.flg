type Jobs = Channel[i64, 4]
type Results = Channel[i64, 2]

func produce(jobs: *Jobs, count: i64):
    for i in 0..count:
        send(jobs, i)
    close(jobs)

func consume(jobs: *Jobs, results: *Results):
    sum: i64 = 0
    for n in jobs:
        sum += n * n
    send(results, sum)

func names(into: *Channel[&str, 3]):
    for name in ["ana", "luis", "eva", "ivo"]:
        owned: &str = name
        send(into, owned)
    close(into)

func main():
    jobs: Jobs
    results: Results
    p := parallel produce(jobs, 1000)
    consumers: &list[Thread[null]]
    defer free(consumers)
    for k in 0..3:
        append(consumers, parallel consume(jobs, results))
    total: i64 = 0
    for k in 0..3:
        total += trust receive(results)
    wait p
    for c in consumers:
        wait c
    print(total)
    texts: Channel[&str, 3]
    n := parallel names(texts)
    for name in texts:
        print(name)
        free(name)
    wait n
    print(receive(texts))
