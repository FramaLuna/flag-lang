func greet(out: *&str, name: &strview):
    out.* += "hello " + name + "!"

func count(s: &strview, c: &strview) -> usize:
    n: usize = 0
    for i in 0..s.len:
        if s[i:i + 1] == c:
            n += 1
    return n

func main() -> i32:
    s: &str
    greet(s, "world")
    print(s, " ", s.len)
    v := s[0:4]
    print(v)
    print(count("banana", "a"))
    t: &str
    t = "abc"
    t += t
    print(t)
    if t == "abcabc":
        print("same")
    e: &strview = "tab\there \"q\" \\ \e[0m"
    print(e.len)
    b := items(s)[1]
    print(b)
    free(s)
    return 0
