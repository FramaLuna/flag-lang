type Mixed:
    a: u8
    b: i64
    c: u8

packed type Tight:
    a: u8
    b: i64
    c: u8

packed type Word:
    all: u32
    low: u16 @all
    tag: u8

func main():
    print(sizeof(Mixed), " ", sizeof(Tight), " ", sizeof(Word))
    t := Tight{1, 1234567890123, 3}
    t.b += 1
    print(t)
    w := Word{0x12345678, 9}
    print(w.low, " ", w.tag, " ", hex(u64(w.all)))
