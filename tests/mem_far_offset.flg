type Big:
    head: *bytes
    middle: array[u8, 5000]
    tail: *bytes

func main():
    b: Big
    b.head = malloc(8)
    b.tail = malloc(8)
    free(b.tail)
    free(b.head)
    rows: array[*bytes, 600]
    rows[0] = malloc(8)
    rows[550] = malloc(8)
    rows[551] = malloc(8)
    free(rows[0])
    free(rows[550])
    free(rows[551])
