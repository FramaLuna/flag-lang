type Countdown:
    from: i32

type Down:
    at: i32

type Up:
    at: i32
    to: i32

func iter(c: Countdown) -> Up:
    return Up{0, c.from}

func next(u: *Up) -> i32|IterationEnd:
    if u.at >= u.to:
        return IterationEnd
    u.at += 1
    return u.at

func reverse_iter(c: Countdown) -> Down:
    return Down{c.from}

func next(d: *Down) -> i32|IterationEnd:
    if d.at == 0:
        return IterationEnd
    d.at -= 1
    return d.at + 1

func main() -> i32:
    for i in reverse 0..4:
        print(i)
    names: &list[&strview] = heap([])
    append(names, "ana")
    append(names, "bo")
    for i, n in reverse names:
        print(i, " ", n)
    for c in reverse "añb":
        print(c)
    for n in Countdown{3}:
        print("up ", n)
    for n in reverse Countdown{3}:
        print("down ", n)
    free(names)
    return 0
