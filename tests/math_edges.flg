use math

func main():
    lowest: i64 = 5
    highest: i64 = 1
    for i in 0..1000:
        r := random(5, 1)
        lowest = min(lowest, r)
        highest = max(highest, r)
    print(lowest, " ", highest, " ", random(-3, -3))
    print(abs(-0.0), " ", abs(0.0), " ", abs(f32(-0.0)), " ", abs(-2.5), " ", abs(-3), " ", abs(3), " ", abs(i8(-128)))
