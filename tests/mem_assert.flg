type error Missing

func find(n: i32) -> i32|Missing:
    if n > 0:
        return n
    return Missing

func main():
    total: i32 = 3
    assert total == 3
    found := find(total)
    assert found is i32
    words: &list[&strview] = heap([])
    defer free(words)
    assert words.len == 0, "there are " + words.len + " words"
    print(found, " ", words.len)
