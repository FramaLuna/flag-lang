use math

func main() -> i32:
    print(sqrt(16), " ", sqrt(f32(2.25)), " ", floor(-2.5), " ", round(f32(2.5)))
    print(abs(-3), " ", abs(-1.5), " ", min(3, 7), " ", max(f32(1), 2), " ", clamp(15, 0, 10))
    print(pow(2, 10), " ", atan2(1.0, 1.0) * 4.0 == PI, " ", cos(0))
    seed(42)
    first := random(1, 6)
    in_range := true
    for i in 0..1000:
        d := random(1, 6)
        in_range = in_range and d >= 1 and d <= 6
        r := random()
        in_range = in_range and r >= 0.0 and r < 1.0
    seed(42)
    print(in_range, " ", random(1, 6) == first)
    return 0
