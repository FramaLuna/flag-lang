func main():
    a: simd[f32, 4] = [1.0, 2.0, 3.0, 4.0]
    b := simd[f32, 4](2.0)
    print(a + b, " ", a - b, " ", a * b, " ", a / b)
    print(a * 3.0, " ", 1.0 - a, " ", -a, " ", 12.0 / a)
    print(a < b, " ", a <= b, " ", a > b, " ", a >= b, " ", a == b, " ", a != b)
    a += b
    a *= 0.5
    print(a)
    d: simd[f64, 2] = [0.25, -8.0]
    print(d * d, " ", d / 4.0, " ", d > 0.0)
    i: simd[i32, 4] = [7, -7, 2147483647, -2147483648]
    print(i + 1, " ", i - 1, " ", i * 3, " ", -i)
    print(i << 1, " ", i >> 1, " ", i and 0xff, " ", i or 1, " ", i xor -1, " ", not i)
    u: simd[u32, 4] = [1, 2, 4294967295, 2147483648]
    print(u + 1, " ", u >> 31, " ", u < 3, " ", u > 2147483647)
    h: simd[i16, 8] = [1, -1, 32767, -32768, 100, -100, 0, 2]
    print(h + h, " ", h * h, " ", h >> 2, " ", h < 0)
    b8: simd[u8, 16] = [0, 1, 2, 3, 4, 5, 6, 7, 250, 251, 252, 253, 254, 255, 128, 127]
    print(b8 + 10, " ", b8 > 127)
    s8 := simd[i8, 16](100)
    print(s8 + s8, " ", not s8)
    l: simd[i64, 2] = [9223372036854775807, -3]
    print(l + 1, " ", l * l, " ", l >> 1, " ", l < 0)
    q: simd[u64, 2] = [18446744073709551615, 5]
    print(q + 1, " ", q > 4, " ", q - q == 0)
