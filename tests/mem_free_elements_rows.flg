type Box:
    items: &list[i32]

func main():
    rows: &list[&list[i32]]
    for k in 0..3:
        row: &list[i32]
        append(row, k)
        append(rows, row)
    for i in 0..10:
        append(rows[i % 3], i)
    for r in rows:
        free(r)
    free(rows)
    boxes: &list[Box]
    defer free(boxes)
    append(boxes, Box{})
    append(boxes, Box{})
    for i in 0..10:
        append(boxes[i % 2].items, i)
    for b in boxes:
        free(b.items)
