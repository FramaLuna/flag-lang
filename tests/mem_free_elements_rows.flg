type Box:
    items: &list[i64] = heap([])

func main():
    rows: &list[&list[i64]] = heap([])
    for k in 0..3:
        row: &list[i64] = heap([])
        append(row, k)
        append(rows, row)
    for i in 0..10:
        append(rows[i % 3], i)
    for r in rows:
        free(r)
    free(rows)
    boxes: &list[Box] = heap([])
    defer free(boxes)
    append(boxes, Box{})
    append(boxes, Box{})
    for i in 0..10:
        append(boxes[i % 2].items, i)
    for b in boxes:
        free(b.items)
