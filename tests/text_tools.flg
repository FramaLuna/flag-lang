func main() -> i32:
    line := "  12, -7 ,x, 3.5  "
    for part in split(trim(line), ","):
        t := trim(part)
        n := parse_int(t)
        f := parse_float(t)
        if n is i64:
            print("int ", n)
        elif f is f64:
            print("float ", f)
        else:
            print("text ", t)
    at := find("hello world", "o w")
    if at is usize:
        print(at, " ", find("abc", "z") is null)
    print(starts_with("flag.flg", "flag"), " ", ends_with("flag.flg", ".flg"), " ", ends_with("a", "abc"))
    big := parse_int("9223372036854775807")
    small := parse_int("-9223372036854775808")
    if big is i64 and small is i64:
        print(big, " ", small)
    print(parse_int("9223372036854775808") is null, " ", parse_int("-") is null, " ", parse_int("") is null)
    thousand := parse_float("1e3")
    if thousand is f64:
        print(parse_float(" 1") is null, " ", thousand)
    return 0
