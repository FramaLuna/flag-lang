use fs

func main() -> i32:
    text := "line one\nline two\n"
    wrote := write_file("build/tests/fs_write.txt", items(text))
    back := read_text_file("build/tests/fs_write.txt")
    if wrote is usize and back is &str:
        print(wrote, " ", back == text)
    print(write_file("build/no/such/dir/x", items(text)) is CannotOpen)
    return 0
