type P:
    n: i32

func tag(s: &strview, n: i64) -> i64:
    print(s)
    return n

func asked(s: &strview, answer: bool) -> bool:
    print(s)
    return answer

func stop() -> never:
    panic("never runs")

func kind(x: u8) -> &strview:
    return "u8"

func kind(x: i64) -> &strview:
    return "i64"

func main():
    print(tag("then", 1) if asked("condition", true) else tag("else", 2))
    print(tag("then", 1) if asked("condition", false) else tag("else", 2))
    small: u8 = 7
    yes := true
    print(kind(0 if yes else small), " ", kind(small if yes else 0), " ", kind(1 if yes else 2))
    wide: i64 = 1 if yes else 2
    mixed := 1 if not yes else "text"
    print(wide, " ", mixed, " ", "big" if small > 5 else "small")
    for n in [1, 5, 9]:
        print("low" if n < 3 else "middle" if n < 7 else "high")
    p: P|null = P{7}
    q: P|null = null
    print(p.n if p is P else 0, " ", 0 if q is null else q.n)
    given: i32|null = 4
    sure := given if given is i32 else stop()
    print(sure + 1)
    print(yes or false if not yes else false, " ", [1 if yes else 2, 3])
