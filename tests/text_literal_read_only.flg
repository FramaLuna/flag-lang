use os

func main():
    if args().len > 1:
        bytes := items("abc")
        bytes[0] = 'A'
        print("written")
        return
    said: &str
    defer free(said)
    code := output(executable() + " write 2>&1", ptr(said)) iferror 0
    print(code != 0, " ", contains(view(said), "flag: invalid memory access"), " ", contains(view(said), "written"), " abc")
