func mix(a: i32, b: f64, c: i32, d: f32, e: f32, f: f64, g: i32, h: f32, i: f64, j: f32, k: f32, l: f64, m: f32, n: f64) -> f64:
    return f64(a) + b + f64(c) + f64(d) + f64(e) + f + f64(g) + f64(h) + i + f64(j) + f64(k) + l + f64(m) + n

type Pair:
    count: i32
    ratio: f32

func made(a: i32, b: i32, c: i32, d: i32, e: i32, ratio: f32) -> Pair:
    return Pair{a + b + c + d + e, ratio}

func main():
    through := mix
    print(through(1, 0.5, 2, 0.25, 0.125, 4.0, 3, 1.5, 8.0, 2.5, 0.75, 16.0, 3.25, 32.0))
    build := made
    print(build(1, 2, 3, 4, 5, 2.5))
