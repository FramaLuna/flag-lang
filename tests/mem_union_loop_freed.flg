type A:
    items: &list[i32]

type B:
    reason: &strview

func main():
    kept: &list[i32]
    for i in 0..3:
        x: A|B
        if i % 2 == 0:
            a: A
            append(a.items, i)
            x = a
        else:
            x = B{"odd"}
        if x is A:
            kept = x.items
            free(x.items)
    print(kept.len, kept[0])
