# Functions with more variables than registers, of the four widths, that permute them in loops: each prints what the
# compiler made of it, and this program what it interprets.
use fs
use math
use os

Functions = 200

Perm = 0
Xa = 1
Xb = 2
Mix = 3
Call = 4
Conv = 5
Loop = 6

type Step:
    kind: i64
    x: i64 # the variable it writes, or the first of its moves or of its steps
    y: i64 # the variable it reads
    end: i64 # the end of its moves or of its steps

context fuzz:
    code: &str = heap("")
    steps: &list[Step] = heap([])
    writes: &list[i64] = heap([]) # of the moves of each Perm, the variable it writes
    reads: &list[i64] = heap([]) # and the one it reads
    values: &list[i64] = heap([]) # of each variable; a float holds an integer, which every conversion keeps
    olds: &list[i64] = heap([])
    first: array[i64, 5] # of i32, i64, f32 and f64, the first variable, then the end of the last

func put(v: i64):
    t := 0
    while v >= fuzz.first[t + 1]:
        t += 1
    fuzz.code += "abgf"[t:t + 1]
    fuzz.code += v

func pick(t: i64) -> i64:
    return random(fuzz.first[t], fuzz.first[t + 1] - 1)

func block(indent: &strview):
    made := 0
    count := random(1, 7)
    while made < count:
        kind := random(-2, Loop if indent.len == 8 else Conv) # below Perm is Perm too, three times as likely
        at := fuzz.steps.len
        step := Step{max(kind, Perm), pick(0), pick(0), 0}
        switch step.kind:
        case Perm:
            step.x = fuzz.writes.len
            for t in 0..4:
                n := fuzz.first[t + 1] - fuzz.first[t]
                if n < 2 or random(0, 1) == 0:
                    continue
                chosen: &list[i64] = heap([])
                for v in fuzz.first[t]..fuzz.first[t + 1]:
                    append(chosen, v)
                for k in reverse 1..n:
                    swap(chosen, k, random(0, k))
                size := random(2, n)
                append(fuzz.writes, chosen[:size])
                for k in reverse 1..size:
                    swap(chosen, k, random(0, k))
                append(fuzz.reads, chosen[:size])
                free(chosen)
            step.end = fuzz.writes.len
            if step.x == step.end:
                continue
            fuzz.code += indent
            for k in step.x..step.end:
                if k > step.x:
                    fuzz.code += ", "
                put(fuzz.writes[k])
            fuzz.code += " = "
            for k in step.x..step.end:
                if k > step.x:
                    fuzz.code += ", "
                put(fuzz.reads[k])
        case Xa:
            fuzz.code += indent
            put(step.x)
            fuzz.code += " = "
            put(step.x)
            fuzz.code += " xor ("
            put(step.y)
            fuzz.code += " >> 3) xor i32(i)"
        case Xb:
            step.x = pick(1)
            fuzz.code += indent
            put(step.x)
            fuzz.code += " = "
            put(step.x)
            fuzz.code += " xor i64("
            put(step.y)
            fuzz.code += ") xor (i << 20)"
        case Mix:
            step.y = pick(1)
            fuzz.code += indent
            put(step.x)
            fuzz.code += " = "
            put(step.x)
            fuzz.code += " xor i32("
            put(step.y)
            fuzz.code += " and 0xffff)"
        case Call:
            step.x = pick(1)
            fuzz.code += indent
            put(step.x)
            fuzz.code += " = touch("
            put(step.x)
            fuzz.code += ")"
        case Conv:
            if fuzz.first[2] == fuzz.first[3] or fuzz.first[3] == fuzz.first[4]:
                continue
            step.x = pick(2)
            step.y = pick(3)
            fuzz.code += indent
            put(step.x)
            fuzz.code += ", "
            put(step.y)
            fuzz.code += " = f32("
            put(step.y)
            fuzz.code += "), f64("
            put(step.x)
            fuzz.code += ")"
        case Loop:
            fuzz.code += indent + "for j in 0..m:\n"
            append(fuzz.steps, step)
            step.x = fuzz.steps.len
            block(indent + "    ")
            step.end = fuzz.steps.len
            fuzz.steps[at] = step
            made += 1
            continue
        fuzz.code += "\n"
        append(fuzz.steps, step)
        made += 1

func play(from: i64, to: i64, i: i64, m: i64):
    v := fuzz.values
    s := from
    while s < to:
        p := fuzz.steps[s]
        s += 1
        switch p.kind:
        case Perm:
            fuzz.olds.len = 0
            for k in p.x..p.end:
                append(fuzz.olds, v[fuzz.reads[k]])
            for k in p.x..p.end:
                v[fuzz.writes[k]] = fuzz.olds[k - p.x]
        case Xa:
            v[p.x] = v[p.x] xor v[p.y] >> 3 xor i
        case Xb:
            v[p.x] = v[p.x] xor v[p.y] xor i << 20
        case Mix:
            v[p.x] = v[p.x] xor (v[p.y] and 0xffff)
        case Call:
            v[p.x] = v[p.x] xor 5
        case Conv:
            swap(v, p.x, p.y)
        case Loop:
            for j in 0..m:
                play(p.x, p.end, i, m)
            s = p.end

func main():
    seed(7)
    expected: &str = heap("")
    defer free(expected)
    calls: &str = heap("")
    defer free(calls)
    fuzz.code += "noinline func touch(x: i64) -> i64:\n    return x xor 5\n"
    for f in 0..Functions:
        fuzz.steps.len = 0
        fuzz.writes.len = 0
        fuzz.reads.len = 0
        fuzz.values.len = 0
        fuzz.code += "\nnoinline func run"
        fuzz.code += f
        fuzz.code += "(n: i64, m: i64) -> i64:\n"
        for t in 0..4:
            fuzz.first[t + 1] = fuzz.first[t] + random(2 if t < 2 else 0, 28 if t < 2 else 24)
        for t in 0..4:
            for v in fuzz.first[t]..fuzz.first[t + 1]:
                value := random(-1000000000, 1000000000) if t < 2 else random(-5000, 5000)
                if t == 1:
                    value *= 1000003
                append(fuzz.values, value)
                fuzz.code += "    "
                put(v)
                fuzz.code += ": " + ["i32", "i64", "f32", "f64"][t] + " = "
                fuzz.code += value
                fuzz.code += ".0\n" if t >= 2 else "\n"
        fuzz.code += "    for i in 0..n:\n"
        block("        ")
        n := random(1, 6)
        m := random(1, 3)
        for i in 0..n:
            play(0, fuzz.steps.len, i, m)
        fuzz.code += "    s: i64 = 0\n"
        s: i64 = 0
        for v in 0..fuzz.values.len:
            fuzz.code += "    s = (s << 5) xor (s >> 59) xor i64("
            put(v)
            fuzz.code += ")\n"
            s = s << 5 xor s >> 59 xor fuzz.values[v]
        fuzz.code += "    return s\n"
        calls += "    print(run"
        calls += f
        calls += "("
        calls += n
        calls += ", "
        calls += m
        calls += "))\n"
        expected += s
        expected += "\n"
    fuzz.code += "\nfunc main():\n" + calls
    path := dir_of(args()[0]) + "fuzz_registers_case.flg"
    if write_file(path, fuzz.code) is FsError:
        panic("cannot write " + path)
    said: &str = heap("")
    defer free(said)
    code := output(ptr([env("FLAGC") ifnull "build/flagc", "run", path]), said)
    if code is FsError or code != 0 or said != expected:
        print(path, " printed:")
        print(said)
        print("instead of:")
        print(expected)
    else:
        print(Functions, " functions agree")
