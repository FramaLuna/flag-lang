use json

func main():
    d := trust parse_json("{\"a\": null, \"b\": [1, 2]}")
    defer free(ptr(d))
    print("[", raw(d, 50), "] ", kind(d, -1), " [", key(d, 99), "] ", count(d, 70), " ", number(d, 9) is null, " ", text(d, 8) is null, " ", get(d, 40, "a") is null)
    a := get(d, 0, "a")
    print(key(d, a), " ", kind(d, a), " ", count(d, get(d, 0, "b")))
