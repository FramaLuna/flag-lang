type Point:
    x: i32
    y: i32

type enum Mode = Slow|Fast

type Settings:
    mode: Mode
    size: u16
    name: &strview

counter: i32
names: array[&strview, 3] = ["a", "bb", "ccc"]
origin: Point = {3, 4}
corner: Point = Point{y = 9}
mode: Mode = Fast
start: Mode
limit: i64? = 100
nothing: i64?
ratio: f64 = 1.5
small: f32 = -0.25
LIMIT = 7
seven: u8 = LIMIT * 2 - LIMIT
greeting: &strview = "hi\tthere"
GREETING = "constant"
again: &strview = GREETING
where: *i32 = ptr(counter)
settings: Settings = {size = 640}
modes: array[Mode, 3]
table: array[Point, 2] = [{1, 2}, {3, 4}]
handler: func(i32) -> i32 = twice
flags: array[bool, 2] = [true, false]

func twice(x: i32) -> i32:
    return x * 2

func bump():
    counter += 1

func main():
    bump()
    bump()
    print(counter, " ", where.*)
    print(names, " ", origin, " ", corner, " ", table)
    print(mode, " ", start, " ", modes, " ", settings)
    print(limit, " ", nothing, " ", ratio, " ", small, " ", seven)
    print(greeting, " ", again, " ", flags)
    print(handler(21))
    origin.x = 30
    names[1] = "changed"
    print(origin, " ", names)
