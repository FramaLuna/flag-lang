# structs, packed structs, fields that share storage, tuples, unions, enums and generics
type Point:
    x: i32
    y: i32

type Shape:
    name: &strview
    corner: Point
    size: f64 = 1.5
    flags: u8

packed type Header:
    tag: u8
    length: u32
    kind: u16

type Number:
    bits: u64
    float: f64 @bits

type error Missing

type enum Light:
    Red, Yellow, Green

type Pair[$A, $B]:
    first: $A
    second: $B

func swap(p: Pair[$A, $B]) -> Pair[$B, $A]:
    return Pair[$B, $A]{p.second, p.first}

func grow(s: Shape) -> Shape: # takes and gives a struct by value
    s.corner.x += 10
    s.size *= 2.0
    return s

func split(n: i64) -> (i64, i64):
    return {n / 10, n % 10}

func lookup(n: i64) -> &strview|Missing:
    if n == 3:
        return "three"
    return Missing

func describe(v: i64|f64|&strview|null) -> &str:
    switch v:
    case i64:
        return heap("integer " + v)
    case f64:
        return heap("float " + v)
    case &strview:
        return heap("text " + v)
    case null:
        return heap("nothing")

func next(l: Light) -> Light:
    switch l:
    case Red:
        return Green
    case Green:
        return Yellow
    case Yellow:
        return Red

func main():
    s := Shape{name = "box", corner = {3, 4}}
    t := grow(s)
    print(s, " ", t, " ", @sizeof(Shape), " ", @offset_of(Shape, size))
    h := Header{7, 1000, 3}
    print(h, " ", @sizeof(Header), " ", @offset_of(Header, kind))
    n := Number{bits = 0x4000_0000_0000_0000}
    print(n.float, " ", n.bits)
    n.float = 0.75
    print(hex(n.bits))
    q, r := split(1234)
    print(q, " ", r, " ", split(98))
    for k in [2, 3]:
        found := lookup(k)
        if found is Missing:
            print(k, ": missing")
        else:
            print(k, ": ", found)
    values: array[i64|f64|&strview|null, 4] = [5, 2.5, "word", null]
    for v in values:
        shown := describe(v)
        print(shown)
        free(shown)
    l: Light = Red
    for k in 0..4:
        print(l)
        l = next(l)
    p := Pair[i32, &strview]{1, "one"}
    print(p, " ", swap(p))
    u: i32||f32 = 1.0
    print(u as u32, " ", (u as f32) * 2.0)
    shapes: &list[Shape] = heap([])
    for i in 0..3:
        append(shapes, Shape{name = "s", corner = {i32(i), i32(i * i)}, flags = u8(i)})
    print(shapes)
    free(shapes)
