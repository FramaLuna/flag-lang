type Lines:
    text: &str

type Buffer:
    lines: *Lines

type Window:
    buffer: *Buffer

func close(w: *Window):
    free(w.buffer.lines.text)
    free(w.buffer.lines as *bytes)
    free(w.buffer as *bytes)

func main():
    lines := heap(Lines{})
    lines.text = "x"
    buffer := heap(Buffer{lines})
    w := Window{buffer}
    close(w)
