type error Fail

func g(n: i32) -> i32|Fail:
    if n > 0:
        return n
    return Fail

func f(x: i64|&strview|null) -> i32|Fail:
    defer if x is i64:
        while true:
            print("never")
    y := try g(1)
    if x is null:
        print("null")
    else:
        print(x.len + usize(y))
        print(x)
    while true:
        exit(0)

func main():
    _ = f(12345)
