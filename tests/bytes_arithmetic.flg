func main():
    buf: array[u8, 8] = [104, 111, 108, 97, 32, 116, 117, 32]
    p := ptr(buf) as *bytes
    q := p + 2
    print((q as *u8).*)
    print(q - p, " ", p - q)
    small: i32 = 1
    tiny: u8 = 3
    count: i64 = 5
    wide: u64 = 6
    print(((q - small) as *u8).*, " ", ((p + tiny) as *u8).*, " ", ((p + count) as *u8).*, " ", ((p + wide) as *u8).*, " ", ((q + -2) as *u8).*)
    q += 1
    q -= 2
    print((q as *u8).*)
    print(p < q, " ", q <= p + 1, " ", p > q, " ", p + 8 >= q, " ", q - 1 == p)
    low := 0x10 as *bytes
    high := 0x8000_0000_0000_0000 as *bytes
    print(low < high, " ", high - low > 0)
    words: array[i64, 3] = [10, 20, 30]
    second := ptr(words) as *bytes + @sizeof(i64)
    print((second as *i64).*, " ", ((second + 8) as *i64).*)
