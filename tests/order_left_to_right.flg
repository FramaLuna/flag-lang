type V:
    n: i64

operator +(a: V, b: V) -> V:
    return V{a.n + b.n}

func tag(s: &strview, n: i64) -> i64:
    print(s)
    return n

func tv(s: &strview, n: i64) -> V:
    print(s)
    return V{n}

func arr(s: &strview) -> array[i64, 3]:
    print(s)
    return [1, 2, 3]

func twice(x: i64) -> i64:
    return 2 * x

func getf(s: &strview) -> func(i64) -> i64:
    print(s)
    return twice

func main():
    print(tag("a", 1) - tag("b", 2) * tag("c", 3))
    print(arr("indexed")[tag("index", 1)])
    print(getf("callee")(tag("argument", 3)))
    m := {tag("k1", 1): tag("v1", 2), tag("k2", 3): tag("v2", 4)}
    print((tv("left", 1) + tv("right", 2)).n)
    switch tag("subject", 2):
    case tag("c1", 1):
        print("one")
    case tag("c2", 2), tag("c3", 2):
        print("two")
    case tag("c4", 2):
        print("four")
