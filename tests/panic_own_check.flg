func panic(message: &strview, place: &strview = @here()) -> never:
    print("mine: ", message)
    exit(3)

func out_of_bounds(i: $I, len: i64, place: &strview = @here()) -> never where $I is Integer:
    print("mine: ", i)
    exit(3)

func main():
    l := [1, 2, 3]
    i := 5
    print(l[i]) # a check of the compiler calls the one of core
