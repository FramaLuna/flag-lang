type Door:
    n: i32

func close(d: Door):
    print("close ", d.n)

func pick(n: i32) -> &strview|i64:
    if n > 0:
        return "hello"
    return i64(n)

func main():
    n := 2
    x: i32? = 4
    y := pick(1)
    if y is i64:
        return
    defer print("deferred y = ", y)
    y = i64(-1)
    defer for i in 0..n:
        print("deferred ", i)
    defer if x is i32:
        k := 10
        print(x + k)
    defer with scratch():
        print("a" + n)
    defer with Door{7}:
        print("inside")
    print("body")
