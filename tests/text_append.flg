extern "c":
    func strlen(s: *u8) -> usize

type Box:
    label: &str

func main() -> i32:
    name: &str
    print(strlen(name))
    name += "level" + 3 + ".txt"
    print(name, " ", strlen(name))
    name.len = 0
    name += -12 + " " + 2.5 + " " + true
    print(name, " ", strlen(name))
    b: Box
    b.label += "box " + u8(7)
    print(b.label)
    parts: &list[&str]
    append(parts, name)
    parts[0] += "!"
    print(parts[0])
    return 0
