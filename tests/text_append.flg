extern "c":
    func strlen(s: cstr) -> i64

type Box:
    label: &str = heap("")

func main() -> i32:
    name: &str = heap("")
    print(strlen(c_text(name)))
    name += "level" + 3 + ".txt"
    print(name, " ", strlen(c_text(name)))
    name.len = 0
    name += -12 + " " + 2.5 + " " + true
    print(name, " ", strlen(c_text(name)))
    b: Box
    b.label += "box " + u8(7)
    print(b.label)
    parts: &list[&str] = heap([])
    append(parts, name)
    parts[0] += "!"
    print(parts[0])
    return 0
