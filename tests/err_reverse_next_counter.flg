type Countdown:
    from: i32

type Down:
    at: i32

func reverse_iter(c: Countdown) -> Down:
    return Down{c.from}

func next(d: *Down) -> i32|IterationEnd:
    if d.at == 0:
        return IterationEnd
    d.at -= 1
    return d.at + 1

func main():
    for i, n in reverse Countdown{3}:
        print(i, " ", n)
