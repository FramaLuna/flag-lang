type Card:
    rank: i32
    name: &strview

operator <(a: Card, b: Card) -> bool:
    return a.rank < b.rank

func main() -> i32:
    n: &list[i32]
    for x in split("5 3 9 1 5 0 -2 8", " "):
        v := parse_int(x)
        if v is i64:
            append(n, i32(v))
    sort(n)
    line: &str
    for x in n:
        line += x + " "
    print(line)
    cards: &list[Card]
    append(cards, Card{3, "three"})
    append(cards, Card{1, "one"})
    append(cards, Card{2, "two"})
    sort(cards)
    for c in cards:
        print(c.name)
    counts: &map[&strview, i32]
    for w in split("a b a c b a", " "):
        seen := get(counts, w)
        if seen is i32:
            put(counts, w, seen + 1)
        else:
            put(counts, w, 1)
    total := 0
    for e in counts:
        total += e.value
    print(counts.len, " ", total)
    return 0
