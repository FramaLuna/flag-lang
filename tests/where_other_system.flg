# a function for a system that is not the target is not checked: its types belong to that system
func size() -> i32 where not (@linux() or @macos() or @windows()):
    n: i32 = "no system has this function"
    return n

func size() -> i32 where @linux() or @macos() or @windows():
    return 4

func main():
    print(size())
