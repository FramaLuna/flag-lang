shared context totals:
    counter: Lock[i64]

func add(times: i32, by: i64):
    for i in 0..times:
        with lock(totals.counter):
            totals.counter.value += by

func nested(c: *Lock[i64]):
    with lock(c):
        with lock(c):
            c.value += 1000

func main():
    workers: &list[Thread[null]]
    defer free(workers)
    for k in 0..8:
        append(workers, parallel add(100000, 1))
    for w in workers:
        wait(w)
    print(totals.counter.value)
    local: Lock[i64]
    nested(local)
    print(local.value)
