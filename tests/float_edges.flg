func main() -> i32:
    z := 0.0
    undefined := z / z
    infinite := 1.0 / z
    print(undefined == undefined, " ", undefined != undefined, " ", undefined < 1.0, " ", undefined > 1.0, " ", undefined <= undefined)
    print(infinite > 1.0e308, " ", -infinite < -1.0e308, " ", infinite == infinite, " ", infinite - infinite == infinite - infinite)
    print(-0.0, " ", z - z, " ", -z, " ", -z == z)
    print(0.5, " ", 2.5, " ", 100.0, " ", 0.1 + 0.2, " ", 1.0 / 3.0)
    big: u64 = 18446744073709551615
    n: i64 = -3
    q: u32 = 4294967295
    print(f64(big), " ", f64(n), " ", f64(q))
    print(0.0001, " ", 123456789.0, " ", 1.0e15)
    return 0
