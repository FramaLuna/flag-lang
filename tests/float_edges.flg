func main() -> i32:
    z := 0.0
    nan := z / z
    inf := 1.0 / z
    print(nan == nan, " ", nan != nan, " ", nan < 1.0, " ", nan > 1.0, " ", nan <= nan)
    print(inf > 1.0e308, " ", -inf < -1.0e308, " ", inf == inf, " ", inf - inf == inf - inf)
    print(-0.0, " ", z - z, " ", -z, " ", -z == z)
    print(0.5, " ", 2.5, " ", 100.0, " ", 0.1 + 0.2, " ", 1.0 / 3.0)
    big: u64 = 18446744073709551615
    n: i64 = -3
    q: u32 = 4294967295
    print(f64(big), " ", f64(n), " ", f64(q))
    print(0.0001, " ", 123456789.0, " ", 1.0e15)
    return 0
