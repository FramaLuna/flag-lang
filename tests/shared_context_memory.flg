shared context saved:
    items: &list[i32] = heap([])
    kept: &list[&str] = heap([])

func keep(text: &strview):
    owned: &str = heap(text)
    append(saved.kept, owned)

func main():
    append(saved.items, 1)
    keep("a")
    print(saved.items, " ", saved.kept)
    free(saved.items)
    for k in saved.kept:
        free(k)
    free(saved.kept)
    print(saved.items)
