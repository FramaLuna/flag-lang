type File:
    fd: i32

func close(f: File):
    print("closed ", f.fd)

func open_file(fd: i32) -> File:
    print("opened ", fd)
    return File{fd}

func early(fd: i32) -> i32:
    with open_file(fd):
        if fd > 1:
            return fd
        print("using ", fd)
    return 0

func main() -> i32:
    f := File{7}
    with f:
        print("using")
    print("after")
    a := early(1)
    b := early(2)
    print(a, " ", b)
    i := 0
    while i < 2:
        i += 1
        with File{10 + i}:
            if i == 1:
                continue
            print("second")
    return 0
