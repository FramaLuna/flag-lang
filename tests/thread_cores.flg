func part(from: i64, to: i64) -> i64:
    total: i64 = 0
    for i in from..to:
        total += i % 7
    return total

func main():
    n := cores()
    print(n >= 1)
    size: i64 = 1000000
    pieces: &list[Thread[i64]]
    defer free(pieces)
    count := i64(n)
    for k in 0..count:
        append(pieces, parallel part(size * k / count, size * (k + 1) / count))
    total: i64 = 0
    for p in pieces:
        total += wait p
    print(total == part(0, size))
