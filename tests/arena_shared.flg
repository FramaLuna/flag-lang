context world:
    level: Arena
    enemies: &list[i32]

func spawn(a: *Arena, n: i32) -> &list[i32]:
    l: &list[i32] = arena(a, [])
    for i in 0..n:
        append(l, i)
    return l

func main():
    world.enemies = spawn(world.level, 5)
    mine: Arena
    defer free(mine)
    other := spawn(mine, 3)
    print(world.enemies, " ", other)
    free(world.level)
