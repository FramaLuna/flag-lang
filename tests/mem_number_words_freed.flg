type Row:
    cells: array[i64, 500]
    name: &str = heap("")

func fill(rows: *&list[Row]):
    for k in 0..3:
        append(rows, Row{})
        rows[k].cells[k] = k
        rows[k].name += "row"

func main():
    rows: &list[Row] = heap([])
    fill(rows)
    first := rows[0].name[0:1]
    for r in rows:
        free(r.name)
    print(first)
    free(rows)
