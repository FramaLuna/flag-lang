use fs

func main() -> i32:
    root := "build/tests/fs_more.dir"
    _ = remove(join(root, "a/b/two.txt"))
    _ = remove(join(root, "a/b/moved.txt"))
    _ = remove(join(root, "a/one.txt"))
    _ = remove(join(root, "a/b"))
    _ = remove(join(root, "a"))
    print(make_dir(join(root, "a/b")) is null, " ", is_dir(join(root, "a")), " ", exists(join(root, "a/one.txt")))
    _ = write_file(join(root, "a/one.txt"), "one")
    _ = append_file(join(root, "a/one.txt"), " more")
    _ = write_file(join(root, "a/b/two.txt"), "2")
    print(read_text_file(join(root, "a/one.txt")), " ", file_size(join(root, "a/one.txt")))
    print(list_dir(join(root, "a")))
    print(rename(join(root, "a/b/two.txt"), join(root, "a/b/moved.txt")) is null, " ", list_dir(join(root, "a/b")))
    print(remove(join(root, "a/missing")) is CannotRemove, " ", list_dir(join(root, "nowhere")) is CannotOpen)
    print(base_name("x/y/game.flg"), " ", extension("x/y/game.flg"), " ", dir_of("x/y/game.flg"), " ", base_name("plain"), " ", extension(".hidden"))
    return 0
