type error Done
type error Skip

func step(n: i32) -> i32|Done|Skip:
    if n >= 5:
        return Done
    if n % 2 == 1:
        return Skip
    return n

func main() -> i32:
    n := 0
    sum := 0
    r := step(n)
    while r is i32|Skip:
        if r is i32:
            sum += r
        n += 1
        r = step(n)
    print(sum)
    v := step(3)
    if v is Done|Skip:
        print("not a number")
        if v is Skip:
            print("skipped")
    w := step(2)
    if w is Done|Skip:
        return 1
    print(w * 10)
    x: i32? = null
    if x is i32:
        print("never")
    else:
        print("null")
    return 0
