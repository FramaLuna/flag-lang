func total(s: &slice[i32]) -> i32:
    sum := 0
    for x in s:
        sum += x
    return sum

func main():
    values := [1, 2, 3, 4]
    middle := values[1:3]
    print(middle, " ", middle.len, " ", total(values[0:4]))
    middle[0] = 9
    print(values, " ", values[-2:4], " ", values[2:2].len)
    print(values[3:5])
