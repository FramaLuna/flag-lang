type A
type B
type C

type Box:
    v: i32|null
    kind: A|B|C

func name(k: A|B|C) -> i32:
    switch k:
    case A:
        return 1
    case B:
        return 2
    case C:
        return 3

func main() -> i32:
    b: Box
    v := b.v
    print(v is null)
    print(name(b.kind) > 0)
    x: i32|null
    print(x is null)
    l: array[Box, 2]
    print(name(l[1].kind) > 0)
    return 0
