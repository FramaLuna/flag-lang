type Point:
    x: i32
    y: i32

type Box[$T]:
    item: $T

type enum Color = Red | Green

context app:
    depth: i64
    inner:
        a: i32

func main():
    print(@sizeof(app), " ", @sizeof(app.inner), " ", @sizeof(Red), " ", @sizeof(Color))
    print(@sizeof(Point?), " ", @sizeof((Point)), " ", @sizeof(Box[&strview]), " ", @sizeof(Box[Box[i32]?]))
    print(@sizeof(Thread[i32]), " ", @sizeof(extern func(i32)), " ", @sizeof(*Box[u8]), " ", @sizeof(simd[f32, 4]|null))
