type enum Color = Red|Green|Blue

func show(x: i32?):
    if x != null:
        print(x + 1)
    else:
        print("none")

func early(x: i32?) -> i32:
    if x == null:
        return 0
    return x * 2

func flipped(x: i32?) -> i32:
    if null == x:
        return -1
    return x

func name(c: Color) -> &strview:
    if c == Red:
        return "red"
    return "not red: " + (1 if c == Green else 2)

func main():
    show(3)
    show(null)
    print(early(4), " ", early(null), " ", flipped(5), " ", flipped(null))
    print(name(Red), " ", name(Blue))
    y: i32? = 7
    while y != null:
        print(y)
        y = null
    z: i32? = 2
    print(z + 1 if z != null else 0)
    w: i32? = 5
    if w != null and w > 3:
        print("big")
    if w == null or w < 3:
        print("small")
