context app:
    pad: array[i64, 600]
    names: &list[i64] = heap([])
    count: i64 = 7

context other:
    more: &list[i64] = heap([])

func main():
    append(app.names, 1)
    append(other.more, 2)
    append(other.more, 3)
    print(app.count, " ", app.names.len, " ", other.more.len, " ", other.more[1])
