func main() -> i32:
    a: i8 = -128
    b: i8 = 64
    c: u8 = 200
    print(a >> 1, " ", b << 1, " ", c >> 1, " ", c << 1)
    d: i16 = 1
    e: u16 = 65535
    print(d << 15, " ", e >> 8, " ", e << 4)
    f: i32 = -1
    g: u32 = 4294967295
    print(f >> 31, " ", f << 31, " ", g >> 31, " ", g << 31)
    h: i64 = -9223372036854775807 - 1
    k: u64 = 18446744073709551615
    print(h >> 63, " ", h >> 1, " ", k >> 63, " ", k << 63)
    n: u64 = 1
    s: u64 = 40
    print(n << s)
    return 0
