type Point:
    x: i32
    y: i32

context app:
    p: Point

func main():
    l: &list[Point] = heap([Point{0, 0}, Point{0, 0}])
    defer free(l)
    n := 0
    l[0], l[1] = {1, 2}, {3, 4}
    m: &map[&strview, Point] = heap({})
    defer free(m)
    m["a"], n = {5, 6}, 1
    p := Point{0, 0}
    pp := ptr(p)
    pp.*, n = {7, 8}, 2
    app.p, n = {x = 9, y = 10}, 3
    buf: array[u8, 2] = [0, 0]
    up := true
    buf[1], n = 200 if up else 100, 4
    print(l, " ", m["a"], " ", p, " ", app.p, " ", buf, " ", n)
