type Mark

func main():
    l: &list[null]
    defer free(l)
    for i in 0..100:
        append(l, null)
    count := 0
    for x in l:
        count += 1
    print(l.len, " ", count, " ", l[-1], " ", pop(l), " ", l.len)
    insert(l, 0, null)
    print(remove(l, 50), " ", l.len, " ", l[0:2])
    marks: &list[Mark]
    defer free(marks)
    for i in 0..20:
        append(marks, Mark)
    reverse(marks)
    print(marks.len, " ", marks[19], " ", temp(marks).len)
