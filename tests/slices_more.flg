func main():
    a: &list[i32] = heap([1, 2, 3])
    b: &list[i32] = heap([1, 2, 3])
    defer free(a)
    defer free(b)
    print(a == b, " ", a[0:2] == b[1:3], " ", a[1:3] != b[1:3])
    print(binary_search(a, 2), " ", binary_search(a, 7))
    print("[", trim_start("  hi  "), "][", trim_end("  hi  "), "][", trim("\t hi \n"), "]")
    words := "one two three"
    print(words[-5:-1], " ", words[-3], " ", insert_and_remove())

func insert_and_remove() -> i32:
    l: &list[i32] = heap([1, 2, 3])
    defer free(l)
    insert(l, -1, 9)
    return remove(l, -2) * 10 + l[-1]
