use fs

func main():
    path := "build/tests/io_create_append.txt"
    first := trust create(path)
    write(first, "one\n")
    close(first)
    more := trust create(path, append = true)
    write(more, "two\n")
    close(more)
    again := trust create(path, true)
    write(again, "three\n")
    close(again)
    write(stdout, read_file(path))
    fresh := trust create(path)
    write(fresh, "empty again\n")
    close(fresh)
    write(stdout, read_file(path))
