func kind(c: u8) -> &strview:
    switch c:
    case 'a'..='z', 'A'..='Z':
        return "letter"
    case '0'..='9':
        return "digit"
    case 128..=255:
        return "high"
    case:
        return "other"

func main():
    print(kind('q'), " ", kind('z'), " ", kind('Z'), " ", kind('9'), " ", kind('{'), " ", kind(255))
