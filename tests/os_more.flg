use os

func main() -> i32:
    args: &list[&strview]
    append(args, "printf")
    append(args, "%s|%s")
    append(args, "a b")
    append(args, "c")
    quiet: &list[&strview]
    append(quiet, "true")
    print(output(args), " ", run(quiet))
    fail: &list[&strview]
    append(fail, "false")
    print(run(fail), " ", contains(executable(), "os_more"), " ", system_name().len > 0, " ", current_dir().len > 0)
    d := date()
    print(d.year >= 2024, " ", d.month >= 1 and d.month <= 12, " ", os.args().len)
    return 0
