func main():
    names: &list[&str]
    for i in 0..3:
        s: &str = "n"
        s += i
        append(names, s)
    last := pop(names)
    if last is &str:
        free(last)
    first := remove(names, 0)
    free(first)
    free(names[0])
    free(names)
    m: &map[i32, &str]
    defer free(m)
    s: &str = "x"
    put(m, 1, s)
    got := remove(m, 1)
    if got is &str:
        free(got)
