func show(x: u8):
    print("u8 ", x)

func main():
    a: u32 = 5
    b: u8 = 0x0f
    c: i16 = 0
    d: u64 = 0
    e: i8 = 0x7f
    print(not a, " ", not b, " ", not c, " ", not d, " ", not e)
    print(not not a, " ", (not b) and 0xf0, " ", (not b) >> 4)
    print(not 5, " ", not -1, " ", not 0x8000_0000_0000_0000)
    mask: u32 = not 0xff
    small: u8 = not 1
    wide: u64 = not 0
    signed: i32 = not 0xff
    print(mask, " ", small, " ", wide, " ", signed)
    print(a and not 0xff, " ", b and not 0b11, " ", not 0 == b)
    show(not 0)
    print(u32(not 0), " ", (not 0xf) and 0xff)
