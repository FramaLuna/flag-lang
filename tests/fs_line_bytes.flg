use fs

func main():
    path := "build/tests/fs_line_bytes.txt"
    _ = write_file(path, "one\x00two\x00\nthree\r\n\n\x00\nlast\r")
    file := open(path)
    if file is CannotOpen:
        return
    with file:
        while true:
            line := read_line(file)
            if line is null:
                break
            print(line.len, " ", items(line))
    long: &str
    defer free(long)
    for i in 0..5000:
        long += "ab\x00"
    _ = write_file(path, long + "\nend")
    again := open(path)
    if again is File:
        print((read_line(again) ifnull "").len, " ", read_line(again), " ", read_line(again))
        close(again)
    _ = remove(path)
