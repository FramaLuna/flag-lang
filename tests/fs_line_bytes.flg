use fs

func main():
    path := "build/tests/fs_line_bytes.txt"
    _ = write_file(path, "one\x00two\x00\nthree\r\n\n\x00\nlast\r")
    file := open(path)
    if file is FsError:
        return
    with file:
        line := read_line(file)
        while line is &strview:
            print(line.len, " ", items(line))
            line = read_line(file)
    long: &str
    defer free(long)
    for i in 0..5000:
        long += "ab\x00"
    _ = write_file(path, long + "\nend")
    again := open(path)
    if again is File:
        print((trust read_line(again) ifnull "").len, " ", trust read_line(again), " ", trust read_line(again))
        _ = close(again)
    _ = remove(path)
