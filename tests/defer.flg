func step(n: i32):
    print("step ", n)

func early(flag: bool) -> i32:
    defer step(1)
    defer step(2)
    if flag:
        return 10
    print("body")
    return 20

func loop():
    i := 0
    while i < 3:
        defer step(i)
        i += 1
        if i == 2:
            continue
        print("iter ", i)

func main() -> i32:
    print(early(true))
    print(early(false))
    loop()
    n := 1
    defer print("last ", n)
    n = 9
    return 0
