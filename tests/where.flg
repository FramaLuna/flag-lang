func small(a: array[u8, $$n]) -> i32 where $$n <= 4:
    return 1

func small(a: array[u8, $$n]) -> i32 where $$n > 4:
    return 2

func kind(v: $T) -> i32 where $T is u8|u16|u32:
    return 3

func kind(v: $T) -> i32 where $T is i32|i64:
    return 4

func pair(a: $T, b: $V) -> i32 where $T != $V:
    return 5

func pair(a: $T, b: $T) -> i32:
    return 6

func wide(v: $T) -> i32 where sizeof($T) >= 8 and not ($T is f64):
    return 7

func wide(v: $T) -> i32 where sizeof($T) < 8 or $T is f64:
    return 8

func takes_text(v: $T) -> i32 where can_assign(&str, $T):
    return 9

func takes_text(v: $T) -> i32 where not can_assign(&str, $T):
    return 10

func main() -> i32:
    three: array[u8, 3]
    six: array[u8, 6]
    print(small(three), small(six))
    print(kind(u8(1)), kind(1), kind(i64(2)))
    print(pair(i32(1), u8(2)), pair(1, u8(2)))
    print(wide(u64(1)), wide(1), wide(1.5))
    print(takes_text("abc"), takes_text(5))
    return 0
