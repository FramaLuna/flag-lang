use os

extern "c":
    func abort()

func main() -> i32:
    if args().len > 1:
        print("before")
        abort()
    said: &str = heap("")
    defer free(said)
    code := output(executable() + " child 2>&1", said) iferror 0
    print(contains(said, "before\nflag: aborted\n"), " ", code)
    return 0
