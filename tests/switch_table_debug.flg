# switch_table with -debug: the tables sit in the code, after each function.
noinline func name(x: i64) -> &strview:
    switch x:
    case 0:
        return "zero"
    case 1:
        return "one"
    case 2:
        return "two"
    case 3, 4:
        return "three or four"
    case 6:
        return "six"
    case 7:
        return "seven"
    case 8:
        return "eight"
    case 9:
        return "nine"
    case 10:
        return "ten"
    case 12:
        return "twelve"
    case:
        return "other"

# Without a default the gaps go past the switch.
noinline func count(x: u16) -> i64:
    n := 100
    switch x:
    case 1:
        n += 1
    case 2:
        n += 2
    case 3:
        n += 3
    case 5:
        n += 5
    case 6:
        n += 6
    case 7:
        n += 7
    case 8:
        n += 8
    case 9:
        n += 9
    return n

func main():
    for x in -3..15:
        print(x, " ", name(x))
    total := 0
    for x in 0..12:
        total = total * 3 + count(u16(x))
    print(total, " ", count(65535))
