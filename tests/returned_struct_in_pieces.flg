type V:
    x: f32
    y: f32

type Mixed:
    count: i64
    best: i32
    seen: bool

type Lanes:
    wide: simd[f32, 4]
    tail: i64

type Inner:
    a: i16
    b: u8

type Outer:
    inner: Inner
    c: i32
    d: f64

noinline func sums(n: i32) -> V:
    v := V{1.0, 2.0}
    for i in 0..n:
        v.x += 1.0
        v.y += v.x
    return v

noinline func scan(n: i64) -> Mixed:
    m: Mixed
    for i in 0..n:
        m.count += i
        if i % 7 == 3:
            m.best = i32(i)
            m.seen = true
    return m

noinline func either(first: bool) -> V:
    a := V{1.0, 2.0}
    b := V{3.0, 4.0}
    if first:
        a.y = 7.0
        return a
    b.x = 8.0
    return b

noinline func only_on_a_path(write: bool) -> Mixed:
    m: Mixed
    if write:
        m.best = 5
    return m

noinline func lanes(n: i64, k: simd[f32, 4]) -> Lanes:
    l := Lanes{k, 0}
    for i in 0..n:
        l.wide[1] = l.wide[1] + 1.0
        l.tail += i
    return l

noinline func copied(o: Outer) -> Outer:
    r := o
    r.inner.b += 1
    r.c = -r.c
    return r

noinline func early(n: i64) -> V:
    v := V{0.5, 0.25}
    for i in 0..n:
        v.x += 1.0
        if v.x > 3.0:
            return v
        v.y *= 2.0
    return v

func main():
    print(sums(3), " ", scan(20), "\n")
    print(either(true), " ", either(false), "\n")
    print(only_on_a_path(true), " ", only_on_a_path(false), "\n")
    k: simd[f32, 4] = [1.0, 2.0, 3.0, 4.0]
    l := lanes(3, k)
    print(l.wide, " ", l.tail, "\n")
    print(copied(Outer{Inner{-3, 200}, 9, 1.5}), "\n")
    print(early(2), " ", early(9), "\n")
