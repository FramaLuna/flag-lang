type Point:
    x: i32
    y: i32

func main():
    values := [3, 1, 2]
    total := 0
    for v in values:
        total += v
    print(total)
    for i, v in reverse values:
        print(i, " ", v)
    for p in [Point{1, 2}, Point{3, 4}]:
        print(p.x + p.y)
    pointed := ptr(values)
    for v in pointed:
        print(v)
    print(values[-1], " ", values[-3])
    print(values[-4])
