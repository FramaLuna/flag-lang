func classify(n: i32) -> i32:
    if n < 0:
        return 0 - 1
    elif n == 0:
        return 0
    else:
        return 1

func main() -> i32:
    print(classify(-5), classify(0), classify(9))
    total := 0
    i := 0
    while i < 10:
        i += 1
        if i % 2 == 0:
            continue
        if i > 7:
            break
        total += i
    print(total)
    sum := 0
    for k in 0..5:
        sum += k
    print(sum)
    n: u8 = 3
    for j in 0..n:
        print(j)
    count := 0
    while true:
        count += 1
        if count == 4:
            break
    print(count)
    return 0
