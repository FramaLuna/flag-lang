func main():
    l: &list[i32]
    defer free(l)
    append(l, 1)
    append(l, ptr([2, 3]))
    other: &list[i32]
    defer free(other)
    append(other, 4)
    append(l, other)
    print(l)
    append(l, l)
    print(l, " ", l.len)
    append(l, l[1:3])
    print(l)
    clear(l)
    print(l, " ", l.len, " ", l.cap >= 10)
    reserve(l, 100)
    print(l.cap >= 100, " ", l.len)
