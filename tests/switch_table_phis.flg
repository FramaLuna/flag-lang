# What each case gives meets after the switch, in a loop, with many values live across the jump.
noinline func mix(n: i64) -> i64:
    a := 1
    b := 2
    c := 3
    d := 4
    e := 5
    f := 6
    g := 7
    h := 8
    for i in 0..n:
        switch i % 11:
        case 0:
            a += i
        case 1:
            b += a
        case 2:
            c += b
        case 3:
            d += c
        case 4:
            e += d
        case 5:
            f += e
        case 6:
            g += f
        case 7:
            h += g
        case 8:
            a = a xor h
        case 9:
            b = b - c
        case:
            c = c * 3 and 0xffff
    return a + b * 3 + c * 5 + d * 7 + e * 11 + f * 13 + g * 17 + h * 19

func main():
    print(mix(1000), " ", mix(7), " ", mix(0))
