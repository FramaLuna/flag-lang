context g:
    a: &map[&strview, i64] = heap({})
    b: &map[&strview, i64] = heap({})

func first(k: &strview, n: i64):
    put(g.a, k, n)

func second(k: &strview, n: i64):
    put(g.b, k, n)

func main() -> i32:
    for i in 0..i64(50):
        first("x", i)
        second("y", i)
    print(g.a["x"], " ", g.b["y"])
    return 0
