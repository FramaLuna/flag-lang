context g:
    a: &map[&strview, usize]
    b: &map[&strview, usize]

func first(k: &strview, n: usize):
    put(g.a, k, n)

func second(k: &strview, n: usize):
    put(g.b, k, n)

func main() -> i32:
    for i in 0..usize(50):
        first("x", i)
        second("y", i)
    print(get(g.a, "x"), " ", get(g.b, "y"))
    return 0
