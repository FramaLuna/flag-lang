ONES: simd[f32, 4] = [1.0, 1.0, 1.0, 1.0]
ODD: simd[bool, 4] = [true, false, true, false]
NONE: simd[u16, 8]

func swap(v: simd[f32, 4]) -> simd[f32, 4]:
    return [v[1], v[0], v[3], v[2]]

func main():
    v: simd[f32, 4] = [1.0, 2.0, 3.0, 4.0]
    w := simd[f32, 4](-1.0)
    print(v[0], " ", v[3], " ", w[2])
    v[1] = 20.0
    v[2] += 10.0
    print(v)
    zipped: simd[f32, 4] = [v[0], w[0], v[1], w[1]]
    print(zipped, " ", swap(zipped), " ", swap(swap(v)) == v)
    v = [v[3], v[2], v[1], v[0]]
    print(v)
    m := v > 10.0
    print(m[0], " ", m[1])
    m[0] = true
    m[1] = false
    print(m, " ", ODD, " ", ONES, " ", NONE)
    d: simd[f64, 2] = [0.5, 0.25]
    d[1] = d[0] * 3.0
    print(d)
    k := ptr(v)
    k[3] = 9.0
    print(k[3], " ", v)
