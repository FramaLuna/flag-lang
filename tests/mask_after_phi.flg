# Masks that value numbering keeps: one side of the and below reaches a phi of a value wider than the mask, and the
# other side reaches the same phi.
noinline func low(n: i64) -> i32:
    a: i32 = -609542420
    t: i32 = 0
    for i in 0..n:
        t = (a and (-6)) and a and 7
        if t == 3:
            a = 5
    return t

noinline func byte(n: i64) -> i32:
    a: i32 = -609542420
    t: i32 = 0
    for i in 0..n:
        t = i32(u8((a and (-6)) and a))
        if t == 3:
            a = 5
    return t

func main():
    print(low(1), " ", low(0), " ", byte(1))
