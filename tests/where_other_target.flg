# each system calls a helper that only that system has
func name() -> &strview where @windows():
    return windows_name()

func name() -> &strview where not @windows():
    return other_name()

priv func windows_name() -> &strview where @windows():
    return "chosen"

priv func other_name() -> &strview where not @windows():
    return "chosen"

func main():
    print(name())
