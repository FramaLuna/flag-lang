type error Failed:
    code: i32

type Node:
    value: i32
    next: *Node

func check(n: i32) -> i32|Failed:
    if n < 0:
        return Failed{n * 10}
    return n

func length(list: *Node) -> i32:
    if list as usize == 0:
        return 0
    return 1 + length(list.next)

func even(n: u32) -> bool:
    if n == 0:
        return true
    return odd(n - 1)

func odd(n: u32) -> bool:
    if n == 0:
        return false
    return even(n - 1)

func main():
    r := check(-3)
    if r is Failed:
        print("failed ", r.code)
    third := heap(Node{3, usize(0) as *Node})
    second := heap(Node{2, third})
    first := Node{1, second}
    print(length(ptr(first)))
    print(even(10), " ", odd(7))
    free(second)
    free(third)
