# an integer literal goes to an integer before a float, to i64 if there is one, and else to the first integer where it fits
func show(x: u8|i8) -> &strview:
    if x is u8:
        return "u8"
    return "i8"

func f(x: i32) -> &strview:
    return "i32"

func f(x: f64) -> &strview:
    return "f64"

func g(x: u8) -> &strview:
    return "u8"

func g(x: i16) -> &strview:
    return "i16"

func h(x: i32) -> &strview:
    return "i32"

func h(x: i64) -> &strview:
    return "i64"

func main():
    y: u8|i8 = 5
    z: i32|f64 = 3
    w: u16|u64 = 70000
    print(show(5), " ", y is i8, " ", z is i32, " ", w is u64)
    print(f(3), " ", f(3.5), " ", g(3), " ", g(200), " ", h(3))
