type Window:
    items: array[i32, 6]
    len: usize

func slice(w: Window, from: usize, to: usize) -> &strview:
    return "window " + from + ":" + to

type Plain:
    x: i32

func slice(p: Plain, from: usize, to: usize) -> usize:
    return to

func main():
    t: &strview = "hello world"
    print(t[6:], "|", t[:5], "|", t[:], "|", t[-3:], "|", t[:-6])
    i: i32 = -5
    k: usize = 2
    small: u8 = 7
    print(t[i:], "|", t[k:], "|", t[small:], "|", t[:k])
    owned: &str = "abcdef"
    defer free(owned)
    print(owned[3:], " ", owned[:2])
    l: &list[i32] = heap([1, 2, 3, 4, 5])
    defer free(l)
    print(l[2:], " ", l[:2], " ", l[-2:], " ", l[:])
    s := l[1:]
    print(s[1:], " ", s[:1])
    a := [10, 20, 30, 40]
    print(a[1:], " ", a[:3], " ", a[-1:], " ", a[:])
    p := ptr(a)
    print(p[2:])
    w := Window{len = 4}
    print(w[1:], " ", w[:2])
    print(f()[1:])

func f() -> &strview:
    print("called once")
    return "xyz"
