type Set:
    words: &list[u64] = heap([])

func add(s: *Set, w: u64):
    append(s.words, w)

context app:
    sets: array[Set, 2]

func fill():
    add(ptr(app.sets[0]), 0)
    add(ptr(app.sets[1]), 0)
    first := app.sets[0].words[0:1]
    for i in 0..10:
        add(ptr(app.sets[i % 2]), u64(i))
    print(first)

func main():
    fill()
    for s in app.sets:
        free(s.words)
