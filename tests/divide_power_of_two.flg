# a division and a remainder by a power of two the compiler knows are shifts, and round toward zero like C, also the most negative value
func main():
    for x in [-9223372036854775808, -9223372036854775807, -1025, -1024, -1023, -9, -8, -7, -2, -1, 0, 1, 2, 7, 8, 9, 1023, 1024, 9223372036854775807]:
        print(x / 1, " ", x % 1, " ", x / 2, " ", x % 2, " ", x / 8, " ", x % 8, " ", x / 1024, " ", x % 1024, " ", x / 0x4000_0000_0000_0000, " ", x % 0x4000_0000_0000_0000)
    small: array[i32, 19] = [-2147483648, -2147483647, -1025, -1024, -1023, -9, -8, -7, -2, -1, 0, 1, 2, 7, 8, 9, 1023, 1024, 2147483647]
    for y in small:
        print(y / 2, " ", y % 2, " ", y / 16, " ", y % 16, " ", y / 0x4000_0000, " ", y % 0x4000_0000, " ", y / 1, " ", y % 1)
    tiny: array[i8, 12] = [-128, -127, -9, -8, -7, -1, 0, 1, 7, 8, 9, 127]
    for z in tiny:
        print(z / 2, " ", z % 2, " ", z / 8, " ", z % 8, " ", z / 64, " ", z % 64)
