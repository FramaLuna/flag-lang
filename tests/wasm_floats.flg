# the decimals of floats, which wasm writes and reads exactly with a natural number of its own, as snprintf and strtod do
func main():
    values := [0.0, -0.0, 1.0, 0.1, 0.2, 0.3, 1.0 / 3.0, 2.0 / 3.0, 100.0, 1e15, 1e16, 1e17, 123456789.125, 5e-324, 2.2250738585072014e-308, 2.225073858507201e-308, 1.7976931348623157e308, 9007199254740993.0, 0.000123, 1e-5, 4.35, 2.5, -7.75e-10, 3.141592653589793, 1e23, 8.98846567431158e307, 4.9406564584124654e-324]
    for v in values:
        print(v, " ", f32(v), " ", fixed(v, 3), " ", fixed(v, 0), " ", hex(v as u64))
    print(fixed(0.125, 2), " ", fixed(0.375, 2), " ", fixed(2.5, 0), " ", fixed(3.5, 0), " ", fixed(-0.0004, 3), " ", fixed(1e-20, 25), " ", fixed(123.456, 30))
    texts := ["1.5", "-0.25", "1e10", "1E-5", ".5", "5.", "0x10", "inf", "-inf", "nan", "1e400", "1e-400", "4.9e-324", "2.4703282292062328e-324", "2.4703282292062327e-324", "1.7976931348623158e308", "1.7976931348623159e308", "abc", "", "1.2.3", "007", "123456789012345678901234567890", "0.1000000000000000055511151231257827021181583404541015625", "1e", "+3"]
    for t in texts:
        print("[", t, "] ", parse_float(t))
    state: u64 = 99
    same := 0
    for k in 0..20000: # each random double reads back from what it writes
        state = state * 6364136223846793005 + 1442695040888963407
        x := state as f64
        back := parse_float("" + x)
        if x != x or back is f64 and back == x:
            same += 1
    print("read back ", same, " of 20000")
    print(parse_int("-9223372036854775808"), " ", parse_int("9223372036854775808"), " ", parse_int("12a"), " ", parse_hex("ff"))
