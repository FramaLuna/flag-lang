type enum Color = Red|Green|Blue

type fatptr box:
    len: usize
    mode: Color

type S:
    x: i32
    y: i32

func take(x: i64||f32) -> i64:
    return x as i64

func main():
    b: &box
    print(b.mode == Red, " ", b.mode)
    u: S||i64
    p := ptr(u as S)
    p.x = 5
    (u as S).y = 1
    print(u as i64)
    print(take(3))
