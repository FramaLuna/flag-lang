type Set:
    bits: u8

operator and(a: Set, b: Set) -> Set:
    return Set{a.bits and b.bits}

operator not(s: Set) -> Set:
    return Set{not s.bits}

func pick(first: bool) -> func(i32) -> i32:
    if (first) and (true):
        return twice
    return negate

func twice(x: i32) -> i32:
    return (2 * x)

func negate(x: i32) -> i32:
    return -(x)

func main():
    steps := [twice, negate]
    print(steps[1](3), " ", pick(true)(4), " ", u8(7))
    s := Set{6} and Set{3}
    print(s.bits, " ", (not s).bits)
    x: i32|null = 5
    if x is (i32):
        print(not (x == 5))
    for v in reverse ([1, 2]):
        print(v)
