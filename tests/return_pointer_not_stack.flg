type Node:
    value: i64
    next: *Node

func second(n: *Node) -> *i64:
    return ptr(n.next.value)

func element(l: &list[i64], i: i64) -> *i64:
    return ptr(l[i])

func inside(n: *Node) -> *Node:
    return ptr(n.*)

func main():
    last := Node{2, 0 as *Node}
    head := Node{1, ptr(last)}
    print(second(ptr(head)).*, " ", inside(ptr(head)).value)
    l: &list[i64] = heap([7, 8])
    defer free(l)
    element(l, 1).* = 9
    print(l)
