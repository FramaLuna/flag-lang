use json

func main():
    d := parse("{\"q\\\"k\": 6, \"\\u0061\\n\": 7, \"plain\": {\"x\\/y\": [8]}, \"\\ud83d\\ude00\": 9}")
    if d is NotJson:
        return
    defer free(d)
    print(integer(d, get(d, 0, "q\"k")), " ", integer(d, get(d, 0, "a\n")), " ", raw(d, get(d, 0, "plain.x/y")), " ", integer(d, get(d, 0, "😀")))
    print(get(d, 0, "q\\\"k"), " ", get(d, 0, "\\u0061\\n"), " ", key(d, 0, 0), " ", key(d, 0, 3))
