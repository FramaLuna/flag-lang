use json

func main():
    d := trust parse("{\"name\": \"\", \"age\": 3, \"nothing\": null, \"user\": {\"nick\": \"bo\"}}")
    defer free(d)
    print("[", text(d, get(d, 0, "name")), "] ", text(d, get(d, 0, "age")), " ", text(d, get(d, 0, "nothing")), " ", text(d, get(d, 0, "missing")))
    print(text(d, get(d, 0, "missing")) ifnull "anonymous", " ", text(d, get(d, 0, "user.nick")) ifnull "anonymous")
    for v in children(d, 0):
        print(key(d, v))
