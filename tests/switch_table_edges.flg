noinline func pick_u64(x: u64) -> i64:
    switch x:
    case 0x7fff_ffff_ffff_fffc:
        return 1
    case 0x7fff_ffff_ffff_fffd:
        return 2
    case 0x7fff_ffff_ffff_fffe:
        return 3
    case 0x7fff_ffff_ffff_ffff:
        return 4
    case 0x8000_0000_0000_0000:
        return 5
    case 0x8000_0000_0000_0001:
        return 6
    case 0x8000_0000_0000_0002:
        return 7
    case 0x8000_0000_0000_0003:
        return 8
    case:
        return 0

noinline func pick_u32(y: u64) -> i64:
    switch u32(y):
    case 0x7fff_fffc:
        return 10
    case 0x7fff_fffd:
        return 20
    case 0x7fff_fffe:
        return 30
    case 0x7fff_ffff:
        return 40
    case 0x8000_0000:
        return 50
    case 0x8000_0001:
        return 60
    case 0x8000_0002:
        return 70
    case 0x8000_0003:
        return 80
    case:
        return -1

func main():
    print(pick_u64(0x7fff_ffff_ffff_fffc), " ", pick_u64(0x8000_0000_0000_0000), " ", pick_u64(0x8000_0000_0000_0003), " ", pick_u64(0))
    print(pick_u32(0x1234_0000_7fff_fffc), " ", pick_u32(0xffff_ffff_8000_0000), " ", pick_u32(0xabcd_0000_8000_0003), " ", pick_u32(0xffff_ffff_0000_0000))
