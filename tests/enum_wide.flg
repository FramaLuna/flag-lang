type Box[$T]:
    value: $T

func main():
    l: &list[Op]
    defer free(l)
    append(l, Opcode0003)
    b := Box[Op]{Opcode0001}
    x: Op = Opcode1499
    if x is Opcode0001:
        return
    print(l.len, " ", b.value is Opcode0001, " ", x is Opcode1499)
