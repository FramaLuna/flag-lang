export func score(x: i32) -> i32:
    switch x:
    case 1:
        return 10
    case 2:
        return 20
    case 3:
        return 30
    case 4:
        return 40
    case 6:
        return 60
    case 7:
        return 70
    case 8:
        return 80
    case 9:
        return 90
    case:
        return -1
