extern "c":
    func fcntl(fd: i32, command: i32, ...) -> i32
    func _get_osfhandle(fd: i32) -> *bytes
    func GetHandleInformation(handle: *bytes, flags: *u32) -> i32

func inherited(fd: i32) -> bool where not @windows():
    return (fcntl(fd, 1) and 1) == 0 # F_GETFD and FD_CLOEXEC

func inherited(fd: i32) -> bool where @windows():
    flags: u32 = 0
    GetHandleInformation(_get_osfhandle(fd), ptr(flags))
    return (flags and 1) != 0 # HANDLE_FLAG_INHERIT

func main():
    out := trust create("build/tests/io_close_on_exec.txt")
    print("created ", inherited(out.fd))
    close(out)
    input := trust open("build/tests/io_close_on_exec.txt")
    print("opened ", inherited(input.fd))
    close(input)
