use bits

func main():
    one: Bits[1]
    print(one, " ", empty(one), " ", count(one), " ", count(complement(one)))
    one[0] = true
    one[63] = true
    print(one, " ", one[0], " ", one[63], " ", one[62], " ", count(one))
    one[0] = false
    one[0] = false
    print(one)
    all := complement(one)
    total: usize = 0
    for n in all:
        total += n
    print(count(all), " ", total, " ", all[63], " ", all[62])
    wide: Bits[4]
    for i in 0..256:
        wide[usize(i)] = i % 3 == 0
    print(count(wide), " ", wide[255], " ", wide[192], " ", wide[193])
    seen := 0
    last: usize = 0
    for n in wide:
        if n < last:
            print("out of order")
        last = n
        seen += 1
    print(seen, " ", last)
    a: Bits[2]
    b: Bits[2]
    a[0] = true
    a[100] = true
    b[100] = true
    b[127] = true
    print(a - b, " ", b - a, " ", (a or b) - (a and b) == (a xor b), " ", complement(complement(a)) == a)
    one[64] = true
