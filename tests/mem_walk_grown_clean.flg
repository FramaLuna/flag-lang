func grow(s: *&str):
    s.* += "z"

func main():
    names: &list[&str] = heap([])
    for i in 0..3:
        append(names, heap("n"))
    for s in names:
        s += "x"
    for i in 0..names.len:
        names[i] += "y"
        grow(ptr(names[i]))
    rows: &list[&list[i64]] = heap([])
    append(rows, heap([1, 2]))
    for r in rows:
        for i in 0..100:
            append(r, i)
    v := names[0][0:1] # a view taken after the walks that grew the elements
    print(v)
    for s in names:
        print(s)
        free(s)
    free(names)
    for r in rows:
        free(r)
    free(rows)
