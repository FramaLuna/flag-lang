use utf8

func main():
    for s in ["\x7f", "\xc2\x80", "\xdf\xbf", "\xe0\xa0\x80", "\xef\xbf\xbf", "\xf0\x90\x80\x80", "\xf4\x8f\xbf\xbf"]:
        print(code(s), " ", valid(s), " ", count(s))
    for s in ["\xc0\x80", "\xc1\xbf", "\xe0\x9f\xbf", "\xed\xa0\x80", "\xed\xbf\xbf", "\xf0\x8f\xbf\xbf", "\xf4\x90\x80\x80", "\xf5\x80\x80\x80", "\xff", "\x80", "\xe2\x82", "a\xe2\x82"]:
        print(code(s), " ", valid(s), " ", count(s))
    print(code("€uro"), " ", count("€uro"), " ", valid("€uro"), " ", count("😀😀"))
