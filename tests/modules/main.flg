use geometry
use shapes as s

type Point:
    label: &strview

func main() -> i32:
    print(area(3, 4), " ", geometry.area(2, 5))
    p := geometry.Point{7, 8}
    mine := Point{"own"}
    print(p.x + p.y, " ", mine.label)
    if far(p) == geometry.Far:
        print("far")
    print(s.sides(), " ", s.name())
    return 0
