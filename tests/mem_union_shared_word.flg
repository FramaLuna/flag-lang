type error Bad:
    line: usize
    column: usize
    reason: &strview

type Document:
    text: &strview
    nodes: &list[i32]

func make(t: &strview) -> Document|Bad:
    if t.len == 0:
        return Bad{1, 1, "empty"}
    d: Document
    append(d.nodes, 7)
    return d

func free(d: *Document):
    free(d.nodes)

func main():
    d := make("abc")
    if d is Bad:
        return
    defer free(d)
    print(d.nodes[0])
