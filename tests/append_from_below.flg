# a text or a list in a big block of its own, above the small ones and the scratch, takes a view from below without copying it to the scratch
func main():
    small: &str = heap("small")
    defer free(small)
    big: &str
    defer free(big)
    reserve(big, 1 << 20)
    big += "big "
    big += small
    big += big[:3]
    print(big)
    few: &list[i64]
    defer free(few)
    append(few, ptr([1, 2, 3]))
    many: &list[i64]
    defer free(many)
    reserve(many, 1 << 17)
    append(many, few[:])
    append(many, many[1:])
    print(many)
