use math

func main():
    a: simd[f32, 4] = [1.0, -2.0, 3.0, -4.0]
    b: simd[f32, 4] = [0.5, 0.5, 5.0, -5.0]
    print(select(a > b, a, b), " ", select(a > 0.0, a, 0.0), " ", select(a < 0.0, 9.0, a))
    print(min(a, b), " ", max(a, b), " ", max(a, 0.0), " ", min(1.0, a), " ", clamp(a, -1.0, 2.0))
    print(abs(a), " ", sqrt(abs(a)), " ", sum(a), " ", sum(b))
    print(any(a > 2.0), " ", all(a > -5.0), " ", any(a > 9.0), " ", all(a > 0.0))
    d: simd[f64, 2] = [-9.0, 16.0]
    print(sqrt(abs(d)), " ", sum(d), " ", min(d, 0.0))
    i: simd[i32, 4] = [-3, 5, -2147483648, 0]
    print(abs(i), " ", min(i, 1), " ", max(i, 1), " ", sum(i), " ", select(i < 0, -i, i))
    h: simd[u16, 8] = [65535, 1, 2, 3, 4, 5, 6, 7]
    print(sum(h), " ", max(h, 3), " ", any(h == 7), " ", all(h > 0))
    m := a > 0.0
    print(any(m and b > 1.0), " ", all(m or a < 0.0), " ", any(not m))
