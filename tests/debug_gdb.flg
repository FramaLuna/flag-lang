type Point:
    x: i32
    y: i32

type enum Color:
    Red, Green, Blue

func area(p: Point, scale: f64) -> f64:
    total := f64(p.x * p.y) * scale
    return total

func sum(cells: array[i32, 4]) -> i32:
    total := 0
    for c in cells:
        total += c
    return total

func main():
    p := Point{3, 4}
    bits: i32||f32 = 7
    c: Color = Green
    print(area(p, 2.0), " ", sum([1, 2, 3, 4]), " ", bits as i32, " ", c)
