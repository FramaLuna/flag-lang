context calls:
    n: i32

func yes() -> bool:
    calls.n += 1
    return true

func no() -> bool:
    calls.n += 1
    return false

func main() -> i32:
    if no() and yes():
        print("wrong")
    print(calls.n)
    if yes() or no():
        print("right")
    print(calls.n)
    x := no() or no() and yes()
    print(x, " ", calls.n)
    y := yes() and (no() or yes())
    print(y, " ", calls.n)
    z := not no() and not yes()
    print(z, " ", calls.n)
    return 0
