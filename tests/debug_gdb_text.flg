type Holder:
    title: &strview
    values: &listview[i64]

func stop(n: i64):
    print(n)

func main():
    text: &str = heap("año €")
    part := view(text)[:1]
    empty: &str = heap("")
    numbers: &list[i64] = heap([i64(10), 20, 30])
    names: &list[&strview] = heap(["ana", "luz"])
    holders: &list[Holder] = heap([Holder{"uno", numbers[:2]}])
    none: &list[i64] = heap([])
    wild: &listview[i64]
    wild = 16 as *bytes
    wild.len = 1 << 60
    stop(part.len + empty.len + names.len + holders.len + none.len + wild.len)
    free(text)
    free(empty)
    free(numbers)
    free(names)
    free(holders)
    free(none)
