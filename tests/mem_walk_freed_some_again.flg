type Rec:
    n: i64

func main():
    names: &list[&str] = heap([])
    append(names, heap("abc"))
    append(names, heap("d"))
    for s in names:
        if s.len > 1:
            free(s) # in place, so the element is left empty
    for s in names:
        free(s)
    free(names)
    recs: &list[*Rec] = heap([])
    append(recs, heap(Rec{1}))
    append(recs, heap(Rec{2}))
    for r in recs:
        if r.n > 1:
            print(r.n)
    for r in recs:
        free(r)
    free(recs)
