func main():
    print(words("  a  b\tc\n\n d \r\n"))
    print(words(""), " ", words("   "), " ", words("one"))
    counts: &map[&strview, i32]
    defer free(counts)
    for w in words("the cat and the hat and the bat"):
        counts[w] += 1
    print(counts["the"], " ", counts["and"], " ", counts["cat"])
