type Car:
    name: &strview
    motor:
        hp: u32
        parts:
            count: i32

func power(m: Car.motor) -> u32:
    return m.hp * 2

func main() -> i32:
    motor: Car.motor = Car.motor{hp = 12}
    car := Car{"mini", motor}
    car.motor.parts.count = 4
    part := Car.motor.parts{7}
    print(car, " ", power(car.motor), " ", part.count)
    return 0
