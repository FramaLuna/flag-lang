# each kind of declaration goes in a where block, with its own blocks indented inside it
where @linux() or @macos() or @windows():
    type Car:
        motor:
            power: i32
        wheels: i32

    type enum Gear:
        Low, High

    context app:
        depth: i32

    extern "c":
        func abs(x: i32) -> i32

    extern "c" where @windows() or not @windows():
        func labs(x: i64) -> i64

    priv HIDDEN = 5

    counter: i32 = 3

func main():
    c := Car{motor = {power = 90}, wheels = 4}
    app.depth = 2
    counter += 1
    print(c, " ", Gear(High), " ", app.depth, " ", abs(-3), " ", labs(-4), " ", HIDDEN, " ", counter)
