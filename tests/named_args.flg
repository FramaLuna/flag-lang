func area(width: i32, height: i32) -> i32:
    return width * height

func label(x: i32, y: f32) -> i32:
    return 1

func label(x: f32, y: i32) -> i32:
    return 2

func main() -> i32:
    print(area(height = 3, width = 5), " ", area(2, height = 10))
    print(label(y = 2, x = 1.5), " ", label(x = 1, y = 2.5))
    return 0
