type Grid:
    cells: array[i32, 9]

func at(g: *Grid, i: $I, place: &strview = @here()) -> *i32 where $I is i32|usize:
    n := natural(i, 9)
    if n >= 9:
        out_of_bounds(i, 9, place)
    return ptr(g.cells[n])

func main():
    g: Grid
    g[4] = 7
    g[-1] = 3
    last: usize = 8
    print(g[4], " ", g[last], " ", g[-5], " ", natural(-9, 9), " ", natural(-10, 9) >= 9, " ", natural(u8(200), 9))
    print(g[-10])
