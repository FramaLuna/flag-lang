type Grid:
    cells: array[i32, 9]

func at(g: *Grid, i: $I, place: &strview = @here()) -> *i32 where $I is i64|usize:
    if i < 0 or i >= 9:
        out_of_bounds(i, 9, place)
    return ptr(g.cells[i])

func main():
    g: Grid
    g[4] = 7
    g[8] = 3
    last: usize = 8
    print(g[4], " ", g[last], " ", g[0])
    print(g[-1])
