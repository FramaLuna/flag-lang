type Bag:
    items: array[i32, 3]

func at(b: Bag, i: usize) -> i32:
    return b.items[i]

func put(b: *Bag, i: usize, v: i32):
    b.items[i] = v

func bump(x: *i32, by: i32):
    x.* += by

func next(i: *i32) -> i32:
    i.* += 1
    return 0

func grow(m: *&map[i32, i32]) -> i32:
    for i in 100..200:
        m.*[i] = i
    return 1

func main():
    groups: &map[&strview, &list[i32]]
    for w in words("a b a c a b"):
        append(groups[w], i32(w.len))
    more: &list[i32]
    append(more, 7)
    append(more, 8)
    append(groups["a"], more)
    free(more)
    print(groups)
    bag := Bag{[1, 2, 3]}
    bump(bag[1], 10)
    print(bag)
    counts: &map[i32, i32]
    k: i32 = 1
    bump(counts[k], next(ptr(k)))
    bump(counts[5], grow(ptr(counts)))
    print(counts[1], " ", counts[2], " ", counts[5], " ", counts.len)
    print(groups["zz"], " ", groups.len)
