type Box:
    n: i32

func bump(b: *Box) -> i32:
    b.n += 1
    return b.n

func main():
    l: &list[i32]
    defer free(l)
    append(l, 1)
    append(l, 2)
    print(l.len, " ", pop(l), " ", l.len)
    b := Box{1}
    print(b, " ", bump(b), " ", b)
    m := {"a": 1}
    defer free(m)
    print(m.len, " ", remove(m, "a"), " ", m)
