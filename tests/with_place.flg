type Tracker:
    n: i32

func close(t: Tracker):
    print("close ", t.n)

func close(c: *&list[i32]):
    append(c, 99)

func run(k: i32) -> i32:
    defer print("deferred")
    t := Tracker{1}
    with t:
        t.n = 2
        if k == 1:
            return 5
    return 0

func main() -> i32:
    l: &list[i32]
    append(l, 1)
    with l:
        append(l, 2)
    print(l.len, " ", l[2])
    print(run(1))
    return 0
