noinline func over(a: f32, b: f32) -> f32:
    return b / a

noinline func wide_over(a: f64, b: f64) -> f64:
    return b / a

noinline func negated(a: f32, b: f32) -> f32:
    c := -a
    return c + b * a

noinline func wide_negated(a: f64, b: f64) -> f64:
    c := -a
    return c + b * a

noinline func widened(a: f32, b: f32) -> f64:
    c := f64(a)
    return c + f64(b)

noinline func narrowed(a: f64, b: f64) -> f32:
    c := f32(a)
    return c * f32(b)

noinline func counted(n: i32, m: i64, a: f32) -> f32:
    return f32(n) + f32(m) * a

noinline func wide_counted(n: i32, m: i64, a: f64) -> f64:
    return f64(n) + f64(m) * a

noinline func splat(a: f32, b: f64) -> f64:
    v: simd[f32, 4] = [a, a, a, a]
    w: simd[f64, 2] = [b, b]
    v = v + v
    w = w + w
    return f64(v[3]) + w[1]

func main():
    print(over(4.0, 10.0), " ", wide_over(4.0, 10.0), "\n")
    print(negated(1.5, 2.0), " ", wide_negated(1.5, 2.0), "\n")
    print(widened(1.5, 2.25), " ", narrowed(1.5, 2.0), "\n")
    print(counted(3, 5, 0.5), " ", wide_counted(3, 5, 0.5), "\n")
    print(splat(1.5, 2.5), "\n")
