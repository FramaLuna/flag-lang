# Literal cases before a range or a variable go through a table, then the rest is tested in order.
noinline func kind(x: i64, special: i64) -> &strview:
    switch x:
    case 1:
        return "one"
    case 2:
        return "two"
    case 3:
        return "three"
    case 4:
        return "four"
    case 5:
        return "five"
    case 6:
        return "six"
    case 7:
        return "seven"
    case 8:
        return "eight"
    case 20..=29:
        return "twenties"
    case special:
        return "special"
    case 9:
        return "nine"
    case 30, 31:
        return "thirty-something"
    case:
        return "other"

func main():
    for x in -1..34:
        print(x, " ", kind(x, 9 if x % 2 == 0 else 12))
