# a function of yours named like a lane function of the language, with other arguments, is yours
func sum(v: simd[f32, 4], scale: f32) -> f32:
    return (v[0] + v[1] + v[2] + v[3]) * scale

func max(v: simd[f32, 4]) -> f32:
    m := v[0]
    for x in array[f32, 4](v):
        if x > m:
            m = x
    return m

func main():
    v: simd[f32, 4] = [1.0, 7.0, 3.0, 2.0]
    print(sum(v, 2.0), " ", max(v), " ", sum(v), " ", max(v, simd[f32, 4](5.0)))
