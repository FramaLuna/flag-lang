type enum Size:
    Small, Medium,
    Large

type enum Coin = Heads|Tails

type Plain

func name(s: Size) -> &strview:
    switch s:
    case Small:
        return "small"
    case Medium:
        return "medium"
    case Large:
        return "large"

func main() -> i32:
    print(name(Large), " ", name(Small))
    c: Coin
    print(c is Heads)
    p := Plain
    return 0
