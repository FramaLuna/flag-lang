type User:
    name: &strview
    age: i32

func by_age(a: User, b: User) -> bool:
    return a.age < b.age

func longer(a: &strview, b: &strview) -> bool:
    return a.len > b.len

func descending(a: i32, b: i32) -> bool:
    return a > b

func adult(u: User) -> bool:
    return u.age >= 18

func negative(n: i32) -> bool:
    return n < 0

func main():
    users: &list[User]
    defer free(users)
    append(users, User{"carol", 30})
    append(users, User{"alice", 12})
    append(users, User{"bob", 30})
    append(users, User{"dave", 7})
    sort(users, by_age)
    for u in users:
        print(u.name, " ", u.age)
    print(find(users, adult), " ", find(users[0:2], adult))
    words := ["bb", "a", "dddd", "ccc", "ee"]
    sort(ptr(words), longer)
    print(words)
    nums := [3, 1, 2]
    sort(ptr(nums), descending)
    print(nums, " ", find(ptr(nums), negative), " ", find(ptr(nums), 2))
    sort(ptr(nums))
    print(nums)
