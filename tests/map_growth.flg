type P:
    x: i32
    y: i32

func main() -> i32:
    m: &map[usize, usize]
    for i in usize(0)..10000:
        put(m, i, i * i)
    print(trust get(m, 9999), " ", trust get(m, 0), " ", get(m, 10000) is null)
    for i in usize(0)..10000:
        put(m, i, i)
    print(trust get(m, 9999), " ", m.len)
    words: &map[&strview, i32]
    text: &strview = "one two one three two one"
    start: usize = 0
    for i in 0..text.len + 1:
        if i == text.len or text[i:i + 1] == " ":
            w := text[start:i]
            got := get(words, w)
            if got is i32:
                put(words, w, got + 1)
            else:
                put(words, w, 1)
            start = i + 1
    print(trust get(words, "one"), " ", trust get(words, "two"), " ", trust get(words, "three"), " ", get(words, "four") is null)
    pts: &map[i32, P]
    put(pts, -5, P{1, 2})
    put(pts, 7, P{3, 4})
    got := get(pts, -5)
    if got is P:
        print(got.x + got.y)
    print(get(pts, 5) is null)
    return 0
