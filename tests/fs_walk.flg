use fs

func main():
    _ = make_dir("build/tests/walk/b/c")
    _ = write_file("build/tests/walk/z.txt", "z")
    _ = write_file("build/tests/walk/b/a.flg", "a")
    _ = write_file("build/tests/walk/b/c/d.txt", "d")
    found := walk("build/tests/walk")
    if found is &slice[&strview]:
        for path in found:
            print(path)
    print(walk("build/tests/nowhere") is CannotOpen)
