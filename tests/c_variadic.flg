NAME = "flag"

extern "c":
    func abs(n: i32) -> i32
    func snprintf(into: *u8, size: usize, format: *u8, ...) -> i32

func main():
    print(abs(0 - 42))
    buf: array[u8, 32]
    format: &strview = "%s=%d %.1f"
    n := snprintf(ptr(buf) as *u8, 32, ptr(format.*) as *u8, ptr(NAME.*) as *u8, 7, f32(2.5))
    print(n, " ", buf[0], buf[6])
    many: &strview = "%d %d %d %d %d %d %d" # each literal goes as the int of C, also past the registers
    n = snprintf(ptr(buf) as *u8, 32, ptr(many.*) as *u8, -1, 2, -3, 4, -5, 6, 0x7fff_ffff)
    print(n, " ", view(ptr(buf) as cstr))
