func main() -> i32:
    a: i32 = -7
    b: i32 = 2
    c: i32 = 7
    d: i32 = -2
    print(a / b, " ", a % b, " ", c / d, " ", c % d, " ", a / d, " ", a % d)
    e: u8 = 200
    f: u8 = 3
    print(e / f, " ", e % f)
    g: u16 = 65535
    print(g / 2, " ", g % 1000)
    h: u32 = 4000000000
    print(h / 3, " ", h % 7)
    k: u64 = 18446744073709551615
    print(k / 10, " ", k % 10, " ", k / 18446744073709551615)
    m: i8 = -128
    n: i8 = -1
    print(m / n, " ", m % n)
    p: i16 = -32768
    q: i16 = -1
    print(p / q, " ", p % q)
    return 0
