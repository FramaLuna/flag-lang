extern "c":
    func qsort(base: *bytes, count: usize, size: usize, compare: *bytes)

export func descending(a: *i32, b: *i32) -> i32:
    return b.* - a.*

export func twice(x: i32) -> i32:
    return x * 2

func main():
    values := [5, 3, 9, 1, 7]
    qsort(ptr(values) as *bytes, 5, 4, ptr(descending))
    print(values, " ", twice(21))
