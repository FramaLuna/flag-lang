type Player:
    name: &str
    score: i64

func main():
    players: &list[Player] = heap([])
    append(players, Player{name = heap("ana"), score = 1})
    append(players, Player{name = heap("bob"), score = 2})
    best: &strview = ""
    for p in players:
        p.name += " (champion of the season, with many points)"
        best = p.name
    print(best)
    names: &list[&str] = heap([])
    append(names, heap("abc"))
    append(names, heap("d"))
    last: &strview = ""
    for s in names:
        if s.len > 1:
            free(s)
        else:
            last = s
    print(last)
    for s in names:
        free(s)
    free(names)
    for p in players:
        free(p.name)
    free(players)
