type P:
    x: i32
    y: i8

func total(a: array[i32, 4]) -> i32:
    t: i32 = 0
    for i in 0..4:
        t += a[i]
    a[0] = 1000
    return t

func main() -> i32:
    a: array[P, 3]
    for i in 0..3:
        a[i].x = i32(i) * 10
        a[i].y = i8(i) - 1
    b := a
    b[1].x = 77
    print(a[1].x, " ", b[1].x, " ", a[0].y, " ", sizeof(array[P, 3]))
    n := array[i32, 4]{1, 2, 3, 4}
    print(total(n), " ", n[0])
    g: array[array[u8, 3], 2]
    g[1][2] = 9
    g[0][0] = 1
    row := g[1]
    row[2] = 50
    print(g[1][2], " ", row[2], " ", g[0][0], " ", sizeof(array[array[u8, 3], 2]))
    p := ptr(n)
    p[3] = 40
    k: u8 = 2
    print(n[3], " ", n[k])
    return 0
