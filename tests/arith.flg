func square(n: i32) -> i32:
    return n * n

func main() -> i32:
    a: i32 = 7
    b := 3
    print(a + b, " ", a - b, " ", a * b, " ", a / b, " ", a % b)
    print(square(a) - 1)
    c: i64 = a
    print(c * 1000000000)
    u: u8 = 250
    u += 10
    print(u)
    s: i8 = 0 - 100
    s -= 100
    print(s)
    x: usize = 18446744073709551615
    print(x)
    print(-5 + 2, " ", 0 - 2147483648)
    print(1 << 4, " ", 256 >> 2, " ", 6 and 3, " ", 6 or 3, " ", 6 xor 3)
    print(7 > 3, " ", 3 >= 3, " ", 2 == 3, " ", not (2 != 3))
    y: i32 = -8
    print(y >> 1, " ", u32(4294967295) >> 4)
    return 0
