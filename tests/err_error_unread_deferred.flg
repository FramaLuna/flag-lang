type error Bad

type Holder:
    v: i32|Bad

func may() -> i32|Bad:
    return 1

func opt() -> i32|null:
    return null

func take(v: i32|Bad, more: i32 = 2) -> i32:
    if v is Bad:
        return 0
    return v + more

func show(v: *(i32|Bad)):
    if v.* is Bad:
        print("bad")

func main():
    x := may()
    defer x = may()
