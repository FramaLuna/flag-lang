func main():
    l: &list[i32] = heap([1, 2, 3, 4])
    for i, x in reverse l:
        if x == 4:
            _ = pop(l)
        print(i, " ", x)
    a := [10, 20, 30]
    p := ptr(a)
    for i, v in p:
        print(i, " ", v)
    for v in reverse a[1:3]:
        print(v)
    text: &str = "hola"
    print(text[-1], " ", text[0], " ", items(view(text))[-2])
    big: &list[array[i64, 20]]
    row: array[i64, 20]
    row[19] = 7
    append(big, row)
    append(big, row)
    total: i64 = 0
    for r in big:
        total += r[19]
    print(total)
    none: &list[null]
    append(none, null)
    for n in none:
        print(n)
    free(l)
    free(text)
    free(big)
    free(none)
