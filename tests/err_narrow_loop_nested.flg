func main():
    x: i32|i64|&strview = 1
    if x is &strview:
        return
    n := 0
    while n < 2:
        n += 1
        if x is i32:
            x = i64(7)
            k := 0
            while k < 1:
                k += 1
                x = "s"
        else:
            print(x + i64(1))
