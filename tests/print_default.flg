type enum Suit = Hearts|Spades

type Card:
    rank: i32
    suit: Suit

type Hand:
    cards: array[Card, 2]
    owner: &strview
    best: Card?

func main() -> i32:
    m: &map[&strview, i32]
    put(m, "a", 1)
    print(get(m, "a"), " ", get(m, "b"))
    c := Card{7, Spades}
    print(c)
    h := Hand{array[Card, 2]{c, Card{2, Hearts}}, "ana", null}
    print(h)
    l: &list[i32]
    append(l, 1)
    append(l, 2)
    print(l, " ", m)
    print(fixed(3.14159, 2), " ", fixed(f32(2.5), 0), " ", hex(255))
    n: i32|&strview|null = "text"
    print(n, " ", Suit{})
    return 0
