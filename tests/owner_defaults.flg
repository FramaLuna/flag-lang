type Player:
    name: &str = heap("")
    scores: &list[i32] = heap([])
    tag: &strview = ""

context game:
    players: &list[Player] = heap([])
    names: &map[&strview, i64] = heap({})

shared context log:
    lines: &list[&strview] = heap([])

EMPTY: &list[i32] = heap([])

func main():
    p := Player{tag = "p1"}
    p.name += "ana"
    append(p.scores, 3)
    append(game.players, p)
    game.names["ana"] = 0
    append(log.lines, "joined")
    l := EMPTY
    append(l, 7)
    by_id: &map[i32, Player] = heap({})
    by_id[4].name += "bo"
    print(game.players[0], " ", game.names, " ", log.lines, " ", l, " ", by_id[4])
