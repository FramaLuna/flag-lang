type Halves:
    lo: u16
    hi: u16

type Record:
    code: u32
    id: u32 @code
    halves: Halves @code
    tag: u8

type Point:
    x: i32
    y: i32

func main() -> i32:
    record := Record{id = 1}
    record.halves.hi = 0
    record.code = 65539
    print(record.id, " ", record.halves.lo, " ", record.halves.hi, " ", sizeof(Record))
    positional := Record{7, 9}
    print(positional.code, " ", positional.tag)
    p := Point{y = 5, x = 4}
    q := Point{y = 2}
    print(p.x, p.y, " ", q.x, q.y)
    return 0
