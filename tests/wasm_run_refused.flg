# a module of wasm-wasm64 runs only in a WebAssembly host, so run and test refuse it
use os

func main():
    compiler := env("FLAGC") ifnull "build/flagc"
    for command in ["run", "test"]:
        said: &str = heap("")
        code := output(ptr([compiler, command, "tests/wasm_exit.flg", "-target", "wasm-wasm64"]), said)
        print(code, " ", said)
