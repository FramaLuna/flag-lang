func main() -> i32:
    m: &map[usize, usize]
    for i in usize(0)..2000:
        put(m, i * 7919 % 10007, i)
    removed: usize = 0
    for i in usize(0)..2000:
        if i % 3 != 0:
            if remove(m, i * 7919 % 10007) is usize:
                removed += 1
    ok := true
    for i in usize(0)..2000:
        got := get(m, i * 7919 % 10007)
        if i % 3 == 0:
            ok = ok and got is usize and got == i
        else:
            ok = ok and got is null
    print(removed, " ", m.len, " ", ok)
    for i in usize(0)..2000:
        put(m, i * 7919 % 10007, i + 1)
    all := true
    for i in usize(0)..2000:
        got := get(m, i * 7919 % 10007)
        all = all and got is usize and got == i + 1
    print(m.len, " ", all)
    return 0
