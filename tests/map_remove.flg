func main() -> i32:
    m: &map[i64, i64] = heap({})
    for i in i64(0)..2000:
        put(m, i * 7919 % 10007, i)
    removed: i64 = 0
    for i in i64(0)..2000:
        if i % 3 != 0:
            if remove(m, i * 7919 % 10007) is i64:
                removed += 1
    ok := true
    for i in i64(0)..2000:
        got := m[i * 7919 % 10007]
        if i % 3 == 0:
            ok = ok and got is i64 and got == i
        else:
            ok = ok and got is null
    print(removed, " ", m.len, " ", ok)
    for i in i64(0)..2000:
        put(m, i * 7919 % 10007, i + 1)
    all := true
    for i in i64(0)..2000:
        got := m[i * 7919 % 10007]
        all = all and got is i64 and got == i + 1
    print(m.len, " ", all)
    return 0
