use fs

func main():
    _ = make_dir("build/tests/fs_size_folder.dir")
    _ = write_file("build/tests/fs_size_folder.dir/five.txt", "12345")
    print(file_size("build/tests/fs_size_folder.dir/five.txt"), " ", file_size("build/tests/fs_size_folder.dir") is FsError, " ", file_size("build/tests/fs_size_folder.dir/none") is CannotOpen)
