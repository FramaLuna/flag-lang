func main():
    m: &map[&str, i32]
    key: &str = "port"
    put(m, key, 8080)
    wanted: &strview = "port"
    print(m[wanted], " ", m["port"], " ", m["host"], " ", m[key])
    print(contains(m, wanted), " ", contains(m, "host"), " ", contains(m, key))
    line: &strview = "port=1"
    print(m[line[:4]] ifnull 0)
