func main():
    t: &str = "ab"
    defer free(t)
    for i in 0..6:
        t += t
    print(t.len, " ", t[0:8])
    s: &str = "hello world"
    defer free(s)
    s += s[0:2]
    print(s)
    s = s[1:s.len]
    print(s)
    s = view(s)
    print(s)
    big: &str
    defer free(big)
    for i in 0..10:
        big += "0123456789"
    big += big[95:100]
    print(big.len, " ", big[95:105])
    big = big[100:105]
    print(big)
