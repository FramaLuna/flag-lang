type error Empty

func load(a: *Arena, n: i32) -> &list[i32]|Empty:
    if n == 0:
        return Empty
    l: &list[i32] = arena(a, [])
    for i in 0..n:
        append(l, i)
    return l

func counts(a: *Arena) -> &map[&strview, i32]?:
    return arena(a, {})

func main():
    level: Arena
    defer free(level)
    l := load(level, 3)
    if l is &list[i32]:
        print(l)
    m := counts(level)
    if m is &map[&strview, i32]:
        m["a"] += 1
        print(m)
