func main():
    d: simd[f64, 2] = [1.5, -4.0]
    e: simd[f64, 2] = [0.25, -4.0]
    print(d + e, " ", d - e, " ", d == e, " ", d <= e, " ", d >= e, " ", max(d, e), " ", min(e, d))
    b: simd[i8, 16] = [1, -1, 127, -128, 0, 5, -5, 9, 1, 2, 3, 4, 5, 6, 7, 8]
    print(b - 1, " ", b == 5, " ", b != 1)
    h: simd[u16, 8] = [1, 2, 3, 0x8000, 65535, 7, 8, 9]
    k: i32 = 3
    print(h - 1, " ", h << 4, " ", h >> 1, " ", h == 7)
    print(h << u16(k), " ", h >> u16(k + 14))
    s: simd[i16, 8] = [-1, 2, -3, 4, -32768, 6, -7, 8]
    print(s - s, " ", s << 1, " ", s >> 15)
    w: simd[i32, 4] = [0, -1, 7, 7]
    print(w == 7, " ", w != 0)
    q: simd[u64, 2] = [1, 18446744073709551615]
    n: u64 = 63
    print(q << 1, " ", q >> 1, " ", q << n, " ", q >> n)
