# a size that a constant reads from the len of an array constant, outside any function
NAMES = ["red", "green", "blue"]
COUNT = NAMES.len
N = Q.len
Q = [7, 8]
ZEROS: array[u8, N] = []

type Tally:
    counts: array[i64, COUNT]

context app:
    seen: array[u8, N]

export func answer() -> i32 where COUNT > 2:
    return 42

func main():
    t: Tally
    t.counts[1] += 1
    print(t.counts, " ", app.seen, " ", ZEROS, " ", answer())
