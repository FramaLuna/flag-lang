use os

func main():
    text: &str = heap("")
    defer free(text)
    nothing: &list[&strview] = heap([])
    print(run(nothing))
    print(output(nothing, text), " [", text, "]")
    missing: &list[&strview] = heap([])
    defer free(missing)
    append(missing, "flag-surely-not-a-program")
    print(run(missing))
    print(output(missing, text), " [", text, "]")
