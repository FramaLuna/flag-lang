use os

func main():
    text: &str
    defer free(text)
    nothing: &list[&strview]
    print(run(nothing))
    print(output(nothing, text), " [", text, "]")
    missing: &list[&strview]
    defer free(missing)
    append(missing, "flag-surely-not-a-program")
    print(run(missing))
    print(output(missing, text), " [", text, "]")
