use os

func main():
    nothing: &list[&strview]
    code := run(nothing)
    print(code == 127 or code == -1, " [", output(nothing), "]")
    missing: &list[&strview]
    defer free(missing)
    append(missing, "flag-surely-not-a-program")
    code = run(missing)
    print(code == 127 or code == -1, " [", output(missing), "]")
