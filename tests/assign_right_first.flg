func grow(l: *&list[i32]) -> i32:
    for i in 0..100:
        append(l, i32(i))
    return 77

func said(what: &strview, n: usize) -> usize:
    print(what)
    return n

func main():
    l: &list[i32]
    defer free(l)
    append(l, 1)
    l[0] = grow(l)
    print(l[0], " ", l.len)
    a := [1, 2, 3]
    a[said("index", 1)] = i32(said("value", 9))
    a[said("index", 2)] += i32(said("value", 1))
    print(a)
    print(a[0:2], " ", a[1:3].len)
    m: &map[i32, i32]
    defer free(m)
    m[i32(said("key", 4))] = i32(said("put", 5))
    print(m)
