type Red
type Green
type Blue

func code(c: Red|Green|Blue) -> i32:
    switch c:
    case Red:
        return 1
    case Green, Blue:
        return 2

func band(n: i32) -> &strview:
    switch n:
    case -10..0:
        return "negative"
    case 0:
        return "zero"
    case 1..10, 100:
        return "small"
    case:
        return "other"

func main() -> i32:
    print(code(Red), " ", code(Blue), " ", code(Green))
    print(band(-10), " ", band(-1), " ", band(0), " ", band(1), " ", band(9), " ", band(10), " ", band(100), " ", band(-11))
    t: &strview = "go"
    switch t:
    case "stop":
        print("stop")
    case "go", "run":
        print("moving")
    print("after")
    u: u8 = 255
    switch u:
    case 250..255:
        print("high")
    case 255:
        print("max")
    case:
        print("none")
    c: Red|Green|Blue = Blue
    switch c:
    case Red:
        print("red")
    case:
        print("not red")
    return 0
