func main() -> i32:
    names: &list[&strview]
    append(names, "ana")
    append(names, "bo")
    append(names, "cy")
    for i, name in names:
        if i == 1:
            continue
        print(i, " ", name)
    for i, c in "héllo":
        if c == "l":
            print("l at ", i)
    return 0
