type Point:
    x: i32
    y: i32
PAIR = {3, 4}
PICK = double
func double(x: i32) -> i32:
    return x * 2
func double(x: f64) -> f64:
    return x * 2.0
func takes(f: func(f64) -> f64) -> f64:
    return f(1.5)
func main():
    p: Point = PAIR
    f: func(i32) -> i32 = PICK
    print(p, f(2))
    q := PAIR
