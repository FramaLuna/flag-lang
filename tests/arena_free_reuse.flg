func main():
    level: Arena
    for round in 0..3:
        names: &list[&strview] = arena(level, [])
        append(names, "a")
        append(names, "b")
        n := arena(level, round)
        print(names, " ", n.*, " ", level.blocks.len)
        free(level)
        print(level.count, " ", level.used, " ", level.blocks.len)
