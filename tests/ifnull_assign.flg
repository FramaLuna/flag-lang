type error Bad

func may(n: i32) -> i32|Bad:
    if n < 0:
        return Bad
    return n

func main():
    bad := 0
    total: i64 = 0
    for text in ["1", "x", "3", "y"]:
        parse_int(text) ifnull bad += 1
        total += parse_int(text) ifnull 0
    print(bad, " ", total)
    last := 0
    may(-2) iferror last = -1
    may(5) iferror last = -2
    print(last)
    m: &map[&strview, i32]
    m["a"] ifnull m["a"] = 7
    m["a"] ifnull m["a"] = 9
    print(m["a"])
    x: i32? = null
    x ifnull x = 4
    print(x)
