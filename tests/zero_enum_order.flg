type enum Color:
    Red, Green, Blue

type Paint:
    c: Color

func name(c: Color) -> &strview:
    switch c:
    case Red:
        return "red"
    case Green:
        return "green"
    case Blue:
        return "blue"

func main() -> i32:
    g := Blue
    print(name(g))
    p: Paint
    print(name(p.c))
    return 0
