type Pair:
    a: i32
    b: i32

func fill(l: *&list[i32], n: i32):
    i := 0
    while i < n:
        append(l, i * i)
        i += 1

func main() -> i32:
    l: &list[i32]
    fill(l, 5)
    print(l.len, " ", l[3])
    l[3] = 100
    total := 0
    for v in l:
        total += v
    print(total)
    pairs: &list[Pair]
    append(pairs, Pair{1, 2})
    append(pairs, Pair{3, 4})
    pairs[1].b = 40
    print(pairs[0].a + pairs[1].b)
    last := pop(l)
    if last is i32:
        print("popped ", last, " left ", l.len)
    free(l)
    print(l.len)
    return 0
