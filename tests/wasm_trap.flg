# a trap ends the module after what it printed: without -debug the functions have no names to show
noinline func deeper(n: i64) -> i64:
    if n == 0:
        return 0
    return deeper(n - 1) + 1

func main():
    print(deeper(1000))
    values: array[i64, 2]
    p := (ptr(values) as *bytes + 0x7fff_0000) as *i64
    print(p.*)
