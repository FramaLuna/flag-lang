func grow(l: *&list[i32]):
    append(l, 4)

func main():
    l: &list[i32] = heap([])
    s: &str = heap("")
    m: &map[&strview, i32] = heap({})
    print(ptr(l.*) as u64 == 0, " ", ptr(s.*) as u64 == 0, " ", ptr(m.*) as u64 == 0, " ", l.cap, " ", s.cap, " ", m.cap) # an owner with no memory until it grows
    append(l, 1)
    s += "text"
    m["k"] = 2
    print(l, " ", s, " ", m)
    free(l)
    l = heap([])
    grow(l)
    print(l)
    free(l)
    free(s)
    free(m)
