func grow(l: *&list[i32]) -> usize:
    for i in 0..1000:
        append(l, i32(i))
    return 0

func main():
    l: &list[i32]
    append(l, 7)
    other: &list[i32]
    append(other, 1)
    m: array[i32, 2]
    m[grow(l)] = l[0]
    print(m[0])
    nums: &list[i32]
    append(nums, 7)
    nums[grow(nums)] += nums[0]
    print(nums[0])
    names: &list[&str]
    one: &str = "first"
    append(names, one)
    names[many(names)] += names[0]
    print(names[0])

func many(l: *&list[&str]) -> usize:
    for i in 0..1000:
        empty: &str
        append(l, empty)
    return 0
