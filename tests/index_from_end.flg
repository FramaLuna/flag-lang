N = 2
M = i64(1)
K = i8(-1)

func main():
    l: &list[i64] = heap([10, 20, 30])
    defer free(l)
    a := [1, 2, 3]
    word := "flag"
    print(l[-1], " ", l[-N], " ", l[-M], " ", l[K], " ", l[i32(-3)])
    print(a[-1], " ", a[-N], " ", a[-M], " ", word[-1], " ", word[-N:], " ", a[-3:-M])
    print(l[1 - 2], " ", a[N - 3], " ", -M, " ", -K)
    i := 0
    print(l[(i - 1) % 3])
