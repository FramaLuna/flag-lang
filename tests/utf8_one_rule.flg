use utf8

func show(s: &strview):
    out: &str
    for c in s:
        out += "" + c.len
    out += " |"
    for c in reverse s:
        out += " " + c.len
    print(out, " ", count(s), " ", valid(s), " ", code(s))
    free(out)

func main():
    show("\x61\xc3\xa9\xe2\x82\xac\x7a")
