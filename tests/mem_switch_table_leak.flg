# One way out of a table keeps its list: -memory follows that way too.
func main():
    for k in 0..12:
        names: &list[&strview] = heap([])
        append(names, "name")
        switch k:
        case 0:
            free(names)
        case 1:
            free(names)
        case 2:
            free(names)
        case 3:
            free(names)
        case 4:
            free(names)
        case 5:
            print(names.len)
        case 6:
            free(names)
        case 7:
            free(names)
        case:
            free(names)
