type Point:
    x: i32
    y: i32

type Pair:
    a: i32
    b: i32

type Box:
    a: Point
    b: Point

type Holder:
    nums: array[i32, 4]

type Maybe:
    p: Point?

BOX = Box{Point{1, 2}, Point{3, 4}}
POINTS = [Point{1, 2}, Point{3, 4}]
GRID = [[1, 2], [3, 4]]
H = Holder{[4, 3, 2, 1]}
T = [9, 8, 7]
M = Maybe{Point{5, 6}}

func bump(p: *Point):
    p.x += 10

func swap(p: *Pair):
    p.a = p.b

func zero(s: &slice[i32]):
    s[0] = 0

func first(a: *array[i32, 2]):
    a[0] = 0

func main():
    bump(BOX.a)
    bump(POINTS[1])
    p := ptr(BOX.b)
    p.x = 9
    swap(BOX.a as Pair)
    first(GRID[1])
    zero(T[:])
    zero(H.nums[1:3])
    view := H.nums[1:3]
    view[1] = 5
    bump(trust M.p)
    bump(M.p as Point)
    print(BOX, " ", POINTS[1], " ", p.x)
    print(GRID, " ", T, " ", H.nums, " ", view, " ", M.p)
