func main():
    names: &list[&str] = heap([])
    scores: &list[i64] = heap([])
    defer free(scores)
    for i in 0..4:
        s: &str = heap("n")
        s += i
        append(names, s)
        append(scores, i)
    for i, x in scores: # the length of scores, which may be shorter than names
        print(x)
        free(names[i])
    free(names)
