type Pair:
    x: f32
    y: f32

type Num = f32||i32

extern "c":
    func twice(n: Num, is_float: i32) -> Num
    func sum(u: Pair||f64, is_pair: i32) -> f64

func main() -> i32:
    a: Num = f32(1.25)
    b: Num = i32(21)
    print(twice(a, 1) as f32, " ", twice(b, 0) as i32)
    p: Pair||f64 = Pair{1.5, 2.0}
    d: Pair||f64 = f64(0.25)
    print(sum(p, 1), " ", sum(d, 0))
    return 0
