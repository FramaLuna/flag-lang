# a text literal is the address of its bytes, which end with a 0: a cstr the compiler knows
NAME = "window"
TITLE: cstr = "window"
AGAIN: cstr = NAME

type Options:
    name: cstr = "app"
    size: i32 = 3

PLAIN: Options = {size = 4}

extern "c":
    func strlen(s: cstr) -> i64

func main():
    o := Options{}
    print(TITLE, " ", AGAIN, " ", o.name, " ", PLAIN.name, " ", strlen(TITLE), " ", strlen(PLAIN.name), " ", PLAIN.size)
