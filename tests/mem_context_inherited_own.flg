inherited context app:
    names: &list[i64] = heap([])

func work():
    app.names = heap([])
    for i in 0..1000:
        append(app.names, i64(i))
    free(app.names)

func main():
    append(app.names, 1)
    t := parallel work()
    wait(t)
    append(app.names, 2)
    print(app.names)
    free(app.names)
