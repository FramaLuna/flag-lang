# an integer constant with a type is a number the compiler knows, and what it computes from one is the number the program would get
LEVEL: i32 = 2
N: u8 = 4
WIDTH: i32 = 640
TOP: u32 = 0xffff_fff0
END: u64 = 0xffff_ffff_ffff_fff0
BACK: i16 = 1

AREA: i64 = WIDTH
SMALL: i64 = u8(19)
SUM: i64 = LEVEL * N * 10 + i64(TOP >> 28)
WRAPPED: u32 = TOP + 0x20
AROUND: u64 = END + 32
LOW: i8 = i8(-LEVEL * 64)
DOWN: i64 = 0 - u8(19)
MIXED: bool = LEVEL < TOP and -LEVEL < 0

type Window:
    width: i64 = WIDTH
    height: i64 = LEVEL * 100
    cells: array[u8, N]

func mode() -> &strview:
    where LEVEL > 1 and N == 4:
        return "verbose"
    where LEVEL <= 1 or N != 4:
        return "quiet"

func main():
    print(mode(), " ", AREA, " ", SMALL, " ", SUM, " ", WRAPPED, " ", AROUND, " ", LOW, " ", DOWN, " ", MIXED)
    w: Window
    print(w.width, " ", w.height, " ", w.cells.len)
    buf: array[u8, N]
    one := 1 if LEVEL == 2 else "two"
    print(buf.len, " ", one + 1)
    names := ["a", "b", "c"]
    print(names[-BACK], " ", names[-LEVEL])
