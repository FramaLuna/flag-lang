func main():
    tiny := 5e-324
    print(tiny, " ", tiny * 3.0, " ", 2.2250738585072014e-308, " ", 1.7976931348623157e308)
    print(1e16, " ", 9999999999999998.0, " ", 1e-5, " ", 0.00012, " ", 2.5e-7, " ", 1e300)
    print(123.456, " ", 1.0 / 3.0, " ", 2.0 / 3.0, " ", 0.1 * 3.0, " ", 1e15 + 0.3)
    small: f32 = 1e-45
    big: f32 = 3.4028235e38
    third: f32 = 1.0 / 3.0
    print(small, " ", big, " ", third, " ", f32(1e-5), " ", f32(123456.7))
