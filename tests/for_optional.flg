type Maybe:
    left: i32

func iter(m: Maybe) -> Maybe:
    return m

func next(m: *Maybe) -> i32?|IterationEnd:
    if m.left == 0:
        return IterationEnd
    m.left -= 1
    if m.left % 2 == 1:
        return null
    return m.left

func main():
    found: &list[i32?]
    defer free(found)
    append(found, 1)
    append(found, null)
    append(found, 3)
    for i, x in found:
        print(i, " ", x)
    for x in reverse found:
        print(x)
    for x in Maybe{4}:
        print("maybe ", x)
