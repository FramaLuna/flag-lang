use math

func main():
    print(round(-2.5), " ", round(2.5), " ", round(f32(-0.5)), " ", trunc(-2.7), " ", floor(f32(-0.5)), " ", ceil(-0.5))
    print(fmod(7.5, 2.0), " ", fmod(f32(-7.5), 2), " ", hypot(3.0, 4.0), " ", hypot(f32(5), 12))
    print(exp(0.0), " ", log(E), " ", fixed(asin(1.0) * 2.0, 6), " ", fixed(acos(-1.0), 6), " ", fixed(atan(1.0) * 4.0, 6), " ", fixed(tan(PI / 4.0), 6))
    print(min(2.5, -1.0), " ", max(f32(2), 3), " ", clamp(-5, 0, 10), " ", clamp(5, 0, 10), " ", clamp(2.5, 0.0, 1.0), " ", min("b", "a"))
    print(lerp(0.0, 10.0, 0.25), " ", lerp(f32(1), 3, 0.5), " ", abs(i64(-9223372036854775807)), " ", TAU == 2.0 * PI)
    seed(7)
    seen: array[bool, 7]
    for i in 0..10000:
        r := random(-3, 3)
        seen[r + 3] = true
    print(seen)
    wide := random(-9223372036854775807 - 1, 9223372036854775807)
    print(wide == wide)
