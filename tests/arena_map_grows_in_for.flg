func main():
    a: Arena
    m: &map[i64, i64] = arena(a, {})
    for i in 0..8:
        m[i] = i
    seen := 0
    total := 0
    for e in m:
        seen += 1
        total += e.key
        if seen == 1:
            for k in 100..200:
                m[k] = k
    print(seen, " ", total, " ", m.len)
    free(a)
