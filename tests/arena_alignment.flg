type Mixed:
    a: u8
    b: f64

func main():
    level: Arena
    defer free(level)
    ok := true
    for i in 0..100:
        b := arena(level, u8(i))
        m := arena(level, Mixed{u8(i), f64(i)})
        n := arena(level, i64(i))
        text := arena(level, "x")
        ok = ok and b as usize % 8 == 0 and m as usize % 8 == 0 and n as usize % 8 == 0 and ptr(text.*) as usize % 8 == 0 and m.b == f64(i) and b.* == u8(i)
    print(ok)
