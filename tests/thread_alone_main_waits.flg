use os

func count(numbers: *array[i64, 32], kept: *&list[i64]):
    sleep(0.05)
    same := 0
    for k in 0..32:
        if numbers[k] == 7 and kept[k] == 7:
            same += 1
    print(same, " of 32 are still there")

func main():
    numbers: array[i64, 32]
    kept: &list[i64]
    defer free(kept)
    defer print("then main frees what it keeps")
    for k in 0..32:
        numbers[k] = 7
        append(kept, 7)
    parallel count(numbers, kept)
