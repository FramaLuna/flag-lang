func main():
    names: &list[&str] = heap([])
    scores: &list[i64] = heap([])
    defer free(scores)
    for i in 0..4:
        s: &str = heap("n")
        s += i
        append(names, s)
        append(scores, i)
    for i in 0..names.len: # a list of numbers read beside the one walked whole
        print(scores[i])
        free(names[i])
    free(names)
    pair: array[&str, 2] = [heap("a"), heap("b")]
    for i in 0..2:
        free(pair[i])
