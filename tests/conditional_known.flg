# a if c else b whose c the compiler knows is the side it chose, and a literal when that side is one
NAME_AT = 19 if @linux() else 21 if @arm64() else 8
WIDE = true

func twice(n: i32) -> i32:
    return n * 2

func windows_name() -> &strview where @windows():
    return "Windows"

func main():
    names: array[u8, NAME_AT]
    print(names.len == NAME_AT, " ", twice(NAME_AT) == 2 * NAME_AT)
    print(twice(3 if not @windows() else 3), " ", twice(4 if WIDE else 5), " ", twice(4 if false else 5))
    name := windows_name() if @windows() else "elsewhere"
    print(name.len > 0)
