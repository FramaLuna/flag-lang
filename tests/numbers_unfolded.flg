# the operations of numbers on values the compiler cannot fold, also into a slot of the stack: a long the assembler takes in halves
noinline func keep(x: $T) -> $T:
    return x

func main():
    a := keep(i32(-7))
    b := keep(i32(3))
    print(a + b, " ", a - b, " ", a * b, " ", a / b, " ", a % b, " ", -a, " ", not a)
    print(a << 3, " ", a >> 1, " ", a and 12, " ", a or 12, " ", a xor 12)
    c := keep(u32(0xffff_fff0))
    print(c + 32, " ", c * 3, " ", c / 7, " ", c % 7, " ", c >> 4, " ", c << 4, " ", not c)
    d := keep(i64(-1) << 40)
    e := keep(u64(0xfedc_ba98_7654_3210))
    s := keep(u32(36))
    print(d, " ", d >> s, " ", e >> s, " ", e << u64(s), " ", e / 1000, " ", e % 1000, " ", i64(e))
    small := keep(i8(-128))
    byte := keep(u8(200))
    short := keep(i16(-32768))
    word := keep(u16(65535))
    print(small, " ", small / -1, " ", small % -1, " ", byte + 100, " ", short - 1, " ", word + 1, " ", i8(byte), " ", u16(short))
    least := keep(i64(-9223372036854775807) - 1)
    print(least / -1, " ", least % -1, " ", least / 2, " ", least % 10)
    print(a < b, " ", a <= b, " ", a > b, " ", a >= b, " ", a == b, " ", a != b, " ", c > u32(b), " ", e > u64(d))
    f := keep(2.75)
    g := keep(-0.1)
    h := keep(f32(1.5))
    print(f + g, " ", f - g, " ", f * g, " ", f / g, " ", -f, " ", h * h, " ", h / f32(3.0))
    nan_value := keep(f / 0.0 - f / 0.0)
    print(f < g, " ", f > g, " ", nan_value == nan_value, " ", nan_value != nan_value, " ", nan_value < 1.0, " ", f / 0.0, " ", g / 0.0)
    print(i64(f), " ", i64(g), " ", i32(keep(-2.9)), " ", u8(keep(300.7)), " ", i32(keep(1e20)), " ", u64(keep(1.8e19)), " ", i64(nan_value), " ", u64(keep(-5.0)))
    print(f64(a), " ", f64(c), " ", f64(e), " ", f32(e), " ", f64(least), " ", f32(f), " ", f64(h), " ", f32(keep(1e300)))
    print(f as u64, " ", h as u32, " ", u64(0x3ff8_0000_0000_0000) as f64, " ", keep(u32(0x4048_0000)) as f32, " ", a as u32, " ", byte as i8)
    big := keep(u64(1) << 63)
    print(f64(big), " ", u64(f64(big)), " ", u64(keep(9.223372036854775807e18)), " ", u64(keep(18446744073709549568.0)))
