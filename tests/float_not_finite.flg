func main():
    zero := 0.0
    print(1.0 / zero, " ", -1.0 / zero, " ", zero / zero, " ", -(zero / zero))
    single: f32 = 0.0
    print(f32(1.0) / single, " ", f32(-1.0) / single, " ", single / single)
    print("" + 1.0 / zero + " " + [zero / zero, 1.5])
    print(fixed(1.0 / zero, 2), " ", fixed(-1.0 / zero, 0), " ", fixed(zero / zero, 2), " ", fixed(-(zero / zero), 2))
    print(parse_float("inf"), " ", parse_float("-inf"), " ", parse_float("nan"))
