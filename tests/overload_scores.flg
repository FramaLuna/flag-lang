func f(x: $T) -> &strview:
    return "any"

func f(x: &slice[$T]) -> &strview:
    return "slice"

func g(x: &slice[$T]) -> &strview:
    return "slice of any"

func g(x: &slice[i32]) -> &strview:
    return "slice of i32"

func h(x: &list[$T]) -> &strview:
    return "list"

func h(x: &slice[$T]) -> &strview:
    return "slice"

func main():
    l: &list[i32]
    defer free(l)
    append(l, 1)
    a := [1, 2]
    print(f(l), " ", f(ptr(a)), " ", f(l[0:1]), " ", f(3))
    print(g(l), " ", g(l[0:1]))
    print(h(l), " ", h(l[0:1]))
