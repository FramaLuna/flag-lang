# Switches on every integer width, with dense and sparse values, ranges, a variable case and a default, called with
# values on both sides of each case and with a constant: each function prints what the compiler made of it, and this
# program what it interprets.
use fs
use math
use os

Functions = 160
Probes = 24
Names = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"]

Value = 0
Inclusive = 1
Exclusive = 2
Given = 3

type Label:
    kind: i64
    low: i64 # each value as its type holds it in an i64: sign-extended when signed, else zero-extended
    high: i64

context fuzz:
    labels: &list[Label] = heap([])
    ends: &list[i64] = heap([]) # of each case, the end of its labels
    t: i64 # the type of the subject, an index of Names
    looped: bool # the switch runs on x, x + 1 and x + 2, and sums what it chose
    fallback: bool

func fit(v: i64) -> i64:
    shift := 64 - (8 << (fuzz.t and 3))
    if fuzz.t < 4:
        return v << shift >> shift
    return i64(u64(v) << shift >> shift)

func below(a: i64, b: i64) -> bool:
    return a < b if fuzz.t < 4 else u64(a) < u64(b)

func put(text: *&str, v: i64):
    if fuzz.t >= 4:
        text.* += u64(v)
    elif v < 0:
        text.* += "("
        text.* += v
        text.* += ")"
    else:
        text.* += v

func choose(x: i64, k: i64) -> i64:
    first := 0
    for c, last in fuzz.ends:
        for l in fuzz.labels[first:last]:
            above := not below(x, l.low)
            if l.kind == Value and x == l.low or l.kind == Inclusive and above and not below(l.high, x) or l.kind == Exclusive and above and below(x, l.high) or l.kind == Given and x == k:
                return c
        first = last
    return -1 if fuzz.fallback else -2

func play(x: i64, k: i64) -> i64:
    if not fuzz.looped:
        return choose(x, k)
    acc: i64 = 0
    for j in 0..3:
        c := choose(fit(x + j), k)
        if c != -2:
            acc = acc * 7 + c
    return acc

func any_value() -> i64:
    return fit(random(-9223372036854775808, 9223372036854775807))

func main():
    seed(11)
    code: &str = heap("")
    defer free(code)
    expected: &str = heap("")
    defer free(expected)
    calls: &str = heap("")
    defer free(calls)
    probes: &list[i64] = heap([])
    defer free(probes)
    for f in 0..Functions:
        fuzz.t = random(0, 7)
        fuzz.labels.len = 0
        fuzz.ends.len = 0
        half := i64(1) << ((8 << (fuzz.t and 3)) - 1)
        lowest := fit(half) if fuzz.t < 4 else 0
        span := random(8, 300)
        starts := [lowest, fit(lowest - span), fit(random(-40, 40)), fit(half - span / 2), any_value()]
        start := starts[random(0, 4)]
        dense := random(1, 3)
        count := random(1, 40)
        while fuzz.ends.len < count:
            for n in 0..random(1, 3):
                kind := random(-4, Given) # below Value is Value too
                v := any_value() if random(0, 5) == 0 else fit(start + random(0, span / dense))
                high := v
                if kind == Inclusive or kind == Exclusive:
                    high = fit(v + random(0, 3) if random(0, 3) > 0 else v + random(100, 200))
                append(fuzz.labels, Label{max(kind, Value), v, high})
            append(fuzz.ends, fuzz.labels.len)
        fuzz.fallback = random(0, 3) > 0
        fuzz.looped = random(0, 2) == 0
        name := Names[fuzz.t]
        code += "\n" + ["", "noinline ", "inline "][random(0, 2)] + "func s"
        code += f
        code += "(x: " + name + ", k: " + name + ") -> i64:\n"
        indent: &strview = "    "
        if fuzz.looped:
            code += "    acc: i64 = 0\n    for j in 0..3:\n        v := x + " + name + "(j)\n        switch v:\n"
            indent = "        "
        else:
            code += "    switch x:\n"
        first := 0
        for c, last in fuzz.ends:
            code += indent + "case "
            for n in first..last:
                l := fuzz.labels[n]
                if l.kind == Given:
                    code += "k"
                else:
                    put(code, l.low)
                if l.kind == Inclusive or l.kind == Exclusive:
                    code += "..=" if l.kind == Inclusive else ".."
                    put(code, l.high)
                code += ":\n" if n == last - 1 else ", "
            code += indent + ("    acc = acc * 7 + " if fuzz.looped else "    return ")
            code += c
            code += "\n"
            first = last
        if fuzz.fallback:
            code += indent + "case:\n" + indent + ("    acc = acc * 7 - 1\n" if fuzz.looped else "    return -1\n")
        if fuzz.looped:
            code += "    return acc\n"
        elif not fuzz.fallback:
            code += "    return -2\n"
        probes.len = 0
        for l in fuzz.labels:
            if l.kind != Given:
                append(probes, l.low)
                append(probes, fit(l.low - 1))
                append(probes, l.high)
                append(probes, fit(l.high + 1))
        append(probes, any_value())
        k := probes[random(0, probes.len - 1)]
        calls += "    h = 0\n    p"
        calls += f
        calls += ": array[" + name + ", "
        calls += Probes
        calls += "] = ["
        h: i64 = 0
        for n in 0..Probes:
            x := any_value() if random(0, 4) == 0 else probes[random(0, probes.len - 1)]
            h = h * 31 + play(x, k)
            if n > 0:
                calls += ", "
            put(calls, x)
        h = h * 31 + play(probes[0], k)
        calls += "]\n    for x in p"
        calls += f
        calls += ":\n        h = h * 31 + s"
        calls += f
        calls += "(x, "
        put(calls, k)
        calls += ")\n    h = h * 31 + s" # a constant, which inlined chooses its case at compile time
        calls += f
        calls += "("
        put(calls, probes[0])
        calls += ", "
        put(calls, k)
        calls += ")\n    print(h)\n"
        expected += h
        expected += "\n"
    code += "\nfunc main():\n    h: i64 = 0\n" + calls
    path := dir_of(args()[0]) + "fuzz_switch_case.flg"
    if write_file(path, code) is FsError:
        panic("cannot write " + path)
    said: &str = heap("")
    defer free(said)
    command: &list[&strview] = heap([])
    defer free(command)
    append(command, env("FLAGC") ifnull "build/flagc")
    append(command, "run")
    append(command, path)
    for debug in [false, true]:
        if debug:
            append(command, "-debug")
        said.len = 0
        status := output(command, said)
        if status is FsError or status != 0 or said != expected:
            print(path, " printed with ", command[3:], ":")
            print(said)
            print("instead of:")
            print(expected)
            return
    print(Functions, " functions agree")
