type Block:
    cells: array[i64, 128]

func first(b: Block) -> i64:
    return b.cells[0] + 1

func deep(n: i32) -> i64:
    if n == 0:
        return 0
    s: i64 = 0
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    s += first(Block{})
    return s + deep(n - 1)

func main():
    print(deep(600))
