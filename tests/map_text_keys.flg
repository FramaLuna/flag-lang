func main():
    m: &map[&str, i32] = heap({})
    defer free(m)
    m["host"] = 1
    line: &strview = "port=80 port=81"
    for w in split(line, " "):
        m[w[:4]] += 1
    m["host"] = 2
    put(m, "host", 3)
    key: &str = heap("port")
    defer free(key)
    print(m["host"], " ", m[key], " ", contains(m, key), " ", m.len)
    print(remove(m, key), " ", remove(m, "port"), " ", m.len)
    clear(m)
    m["again"] = 4
    print(m)
