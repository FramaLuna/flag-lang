ON_WINDOWS = @windows()

func main():
    unix := @linux() or @macos()
    print(unix != @windows(), " ", ON_WINDOWS == @windows(), " ", @x86_64() or @arm64() or @riscv64())
    if @windows():
        print("the same line on every system")
    else:
        print("the same line on every system")
    print(@can_assign(&strview, i32), " ", @can_assign(i64, i32), " ", @can_assign(&strview, &str))
