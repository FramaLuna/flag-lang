type Job:
    id: i32
    result: i64

func worker(jobs: *Channel[*Job, 8]):
    for j in jobs:
        j.result = i64(j.id) * 10

func main():
    all: &list[Job]
    for i in 0..5:
        append(all, Job{id = i})
    jobs: Channel[*Job, 8]
    t := parallel worker(jobs)
    for i in 0..all.len:
        send(jobs, ptr(all[i]))
    close(jobs)
    wait t
    total: i64 = 0
    for j in all:
        total += j.result
    print(total)
    free(all)
