type S:
    a: u8
    b: i32
    c: u8
    d: u32 @b

type Car:
    name: &str
    motor:
        power: f64
        on: bool

N = offset_of(S, c)

func main():
    print(offset_of(S, a), " ", offset_of(S, b), " ", N, " ", offset_of(S, d), " ", sizeof(S))
    print(offset_of(Car, motor), " ", offset_of(Car.motor, on), " ", offset_of(&str, len), " ", offset_of(&list[i64], arena))
    bytes: array[u8, N]
    print(sizeof(array[u8, N]), " ", bytes)
    small: u8 = offset_of(Car, motor)
    print(small)
