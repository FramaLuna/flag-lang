type Point:
    x: i32
    y: i32

type PointF:
    x: f64
    y: f64

type enum Shape:
    Round, Square

type Named:
    name: &strview
    size: f32
    tag: i32?
    shape: Shape

type Holder:
    pick: func(i32) -> i32

TABLE = [3, 1, 4, 1, 5, 9, 2, 6]
PAIR = {3, 4}
BOTH = [TABLE, TABLE]
DAYS = ["mon", "tue", "wed"]
ITEM = Named{"box", 1.5, 7, Square}
NONE = Named{name = "none"}
DOUBLE = Holder{twice}
SHAPES = [Round, Square, Round]
SIZE = [sizeof($T), 1]

func twice(x: i32) -> i32:
    return x * 2

func change(a: *array[i32, 8]):
    a[0] = 100

func size_of(x: $T) -> i32:
    return SIZE[0]

func main():
    total := 0
    for i in 0..16:
        total += TABLE[i and 7]
    print(total)
    p: Point = PAIR
    q: PointF = PAIR
    print(p, " ", q)
    print(BOTH[1][5], " ", DAYS[2], " ", DAYS)
    print(ITEM)
    print(NONE)
    print(DOUBLE.pick(21))
    copy := TABLE
    copy[0] = 7
    change(TABLE)
    print(copy[0], " ", TABLE[0])
    print(SHAPES)
    print(size_of(u8(1)), " ", size_of(i64(1)))
