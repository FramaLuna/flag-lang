func main() -> i32:
    buckets: array[&list[i32], 2]
    for i in 0..10:
        append(buckets[i % 2], i)
    names: array[&str, 3]
    for i in 0..3:
        names[i] += "n"
    print(buckets[0][0], " ", names[0])
    for i in 0..2:
        free(buckets[i])
    for i in 0..3:
        free(names[i])
    return 0
