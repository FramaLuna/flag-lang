type Vec:
    x: i32
    y: i32

operator +(a: Vec, b: Vec) -> Vec:
    return Vec{a.x + b.x, a.y + b.y}

operator ==(a: Vec, b: Vec) -> bool:
    return a.x == b.x and a.y == b.y

type Celsius:
    degrees: i32

type Fahrenheit:
    degrees: i32

operator =(dest: Fahrenheit, src: Celsius) -> Fahrenheit:
    return Fahrenheit{src.degrees * 9 / 5 + 32}

func main() -> i32:
    a := Vec{1, 2}
    b := Vec{10, 20}
    c := a + b
    print(c.x, " ", c.y)
    c += a
    print(c.x, " ", c.y, " ", c == Vec{12, 24})
    f: Fahrenheit = Celsius{100}
    print(f.degrees)
    return 0
