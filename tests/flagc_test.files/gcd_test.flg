module mathx

func test_gcd():
    print("a test that passes says nothing")
    assert gcd(test_input(6), 18) == 6

func test_gcd_of_zero():
    print("checking gcd(7, 0)")
    assert gcd(7, 0) == 1, "gcd(7, 0) is 7"

func test_out_of_bounds():
    l: &list[i32]
    print(l[3])

func test_hangs():
    while true:
        pass

func test_exits():
    exit(3)

func test_crashes():
    p := 0 as *i32
    print(p.*)

func test_input(n: i64) -> i64: # a helper: a test has no parameters and no result
    return n * 2
