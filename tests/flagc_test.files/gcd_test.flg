module mathx

func test_gcd():
    print("a test that passes says nothing")
    assert(gcd(12, 18) == 6)

func test_gcd_of_zero():
    print("checking gcd(7, 0)")
    assert(gcd(7, 0) == 1, "gcd(7, 0) is 7")

func test_out_of_bounds():
    l: &list[i32]
    print(l[3])

func test_hangs():
    while true:
        pass

func test_exits():
    exit(3)

func test_crashes():
    p := usize(0) as *i32
    print(p.*)
