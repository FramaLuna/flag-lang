func total(p: *&list[i32]) -> i32:
    sum := 0
    for x in p:
        sum += x
    return sum

func letters(t: *&str) -> i32:
    n := 0
    for i, c in reverse t:
        n += 1
    return n

func main():
    l: &list[i32]
    append(l, 1)
    append(l, 2)
    s: &str = "aé"
    a := [3, 4]
    v: &slice[i32] = ptr(a)
    sum := 0
    for x in ptr(v):
        sum += x
    print(total(ptr(l)), " ", letters(ptr(s)), " ", sum)
    free(l)
    free(s)
