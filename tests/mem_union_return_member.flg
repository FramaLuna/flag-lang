type error Bad:
    line: usize
    column: usize
    reason: &strview

type Document:
    text: &strview
    nodes: &list[i32]

func make(t: &strview) -> Document|Bad:
    if t.len == 0:
        return Bad{1, 1, "empty"}
    d: Document
    append(d.nodes, 7)
    return d

func load(t: &strview) -> Document:
    d := make(t)
    if d is Bad:
        return Document{}
    return d

func main():
    d := load("abc")
    print(d.nodes[0])
    free(d.nodes)
