use fs
use os

extern "c":
    func dup2(from: i32, to: i32) -> i32

func main() -> i32:
    if args().len > 1:
        _ = write_file("build/tests/io_lost_stdout_exit_code.txt", "")
        reader := trust open_file("build/tests/io_lost_stdout_exit_code.txt")
        dup2(reader.fd, 1)
        print("this line has nowhere to go")
        if args()[1] == "exit":
            exit(3)
        if args()[1] == "main":
            return 5
        panic("stopped", place = "")
    for how in ["exit", "main", "panic"]:
        said: &str = heap("")
        defer free(said)
        code := output(executable() + " " + how + " 2>&1", said) iferror 0
        print(how, " ", code, " ", contains(said, "flag: cannot write the standard output: Bad file descriptor"))
    return 0
