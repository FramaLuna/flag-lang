use os

func dive(n: i32) -> i32:
    return dive(n + 1) + 1

func start(n: i32) -> i32:
    return dive(n)

func main():
    if args().len > 1:
        t := parallel start(0)
        print(wait t)
    text: &str
    defer free(text)
    code := output(executable() + " dive 2>&1", text) iferror -1
    lines := split(view(text), "\n")
    print(lines[0])
    print(starts_with(lines[1], "  in dive, tests/thread_stack_overflow.flg:3, ") and ends_with(lines[1], " times"))
    print(lines[2])
    print(lines.len)
    print(code != 0)
