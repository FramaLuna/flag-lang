func is_letter(b: u8) -> bool:
    return b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b == '_'

func main() -> i32:
    word: &strview = "Hola_mundo 42"
    letters := 0
    for i in 0..word.len:
        if is_letter(items(word)[i]):
            letters += 1
    print(letters, " ", 'A', " ", '\n', " ", '\\', " ", '\'')
    return 0
