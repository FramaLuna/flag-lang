type World:
    arena: Arena
    count: i32

func worker(c: *Channel[&str, 4]) -> i32:
    n := 0
    for s in c:
        n += i32(s.len)
    return n

func main():
    w := heap(World{})
    c: Channel[&str, 4]
    t := parallel worker(c)
    for i in 0..3:
        s := arena(w.arena, "name ")
        s += i
        send(c, s)
    close(c)
    print(wait t)
    free(w.arena)
    free(w)
