func loud(s: &strview) -> &str:
    out: &str = s
    out += "!"
    return out

func shout(names: &list[&strview]): @trust
    print(loud(names[0]))
    for n in names:
        print(loud(n))

func main() -> i32:
    names: &list[&strview]
    defer free(names)
    append(names, "ada")
    shout(names)
    print(loud("bob")) @trust
    return 0
