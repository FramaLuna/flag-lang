use window

func main():
    w := open("Flag test", 160, 120)
    if w is WindowError: # no display on this machine
        return
    set_title(w, "título")
    set_cursor(w, CursorHand)
    set_size(w, 200, 150)
    while true:
        e := poll(w)
        if e == null:
            break
    close(w)
