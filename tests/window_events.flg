use window

func main() where @riscv64(): # the cross compiler that builds the tests for riscv64 has no libX11 to link with
    pass

func main() where not @riscv64():
    w := open("Flag test", 160, 120)
    if w is WindowError: # no display on this machine
        return
    set_title(w, "título")
    set_cursor(w, CursorHand)
    set_size(w, 200, 150)
    while true:
        e := poll(w)
        if e == null:
            break
    close(w)
