func kind(x: i16) -> &strview:
    return "i16"

func kind(x: i32) -> &strview:
    return "i32"

func kind(x: i64) -> &strview:
    return "i64"

func big(a: $T, b: $T) -> $T:
    if a > b:
        return a
    return b

func last(a: $T, b: $T, c: $T) -> $T:
    return c

func first_in(x: $T, l: &list[$T]) -> $T:
    return x

func pick(first: $T, other: $T|null) -> $T:
    if other is null:
        return first
    return other

func check(x: $T, as_type: type $T) -> $T:
    return x

func main():
    x: i32 = 3
    y: i64 = 4
    print(big(x, y), " ", kind(big(x, y)), " ", kind(big(y, x)), " ", big(x, 9))
    u: u8 = 1
    s: i8 = -2
    h: i16 = 300
    print(last(u, s, h), " ", kind(last(h, s, u)))
    l: &list[i64] = heap([])
    defer free(l)
    print(kind(first_in(x, l)), " ", kind(pick(x, y)), " ", kind(pick(y, x)), " ", pick(x, null))
    print(kind(check(x, i64)))
