module app

func work():
    l: &list[i32]
    defer free(l)
    for i in 0..40:
        append(l, 40 - i)
    sort(l)
    print(l[0:3], " ", l[-1])
    for i, x in reverse l:
        if i == 1:
            print(x)
    m: &map[&strview, f64]
    defer free(m)
    m["a"] = 1.5
    print(m, " ", fixed(2.5, 1), " [", trim("  x "), "]")
    print(remove(m, "a"), " ", m)
    f: fixmap[i32, i32, 4]
    trust put(f, 1, 2)
    for e in f:
        print(e.key, " ", e.value, " ", f)
    for c in "né":
        print(c)
    for c in reverse "né":
        print(c)
    a := [1, 2, 3]
    for x in reverse a:
        print(x)
