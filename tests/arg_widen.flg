func twice(x: i64) -> i64:
    return 2 * x

func show(x: i32):
    print("i32")

func show(x: i64):
    print("i64")

func size(x: i32) -> &strview:
    return "i32"

func size(x: i64) -> &strview:
    return "i64"

func described(x: i64|&strview) -> &strview:
    if x is i64:
        return "number"
    return x

func found() -> i64?:
    x: i32 = -3
    return x

func main():
    a: i32 = 5
    print(twice(a))
    show(a)
    s: i16 = 2
    print(size(s))
    l: &list[i64] = heap([])
    defer free(l)
    append(l, a)
    for k in 0..2:
        append(l, k)
    print(l, " ", contains(l, a))
    u: i64|&strview = a
    print(u, " ", described(a), " ", found())
    m: i32|i64 = s
    print(m is i32)
