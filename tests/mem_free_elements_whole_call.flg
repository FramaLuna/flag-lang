func drop(names: &listview[&str]):
    for s in names:
        free(s)
func main():
    names: &list[&str] = heap([])
    append(names, heap("a"))
    append(names, heap("b"))
    drop(names[:])
    free(names)
    others: &list[&str] = heap([])
    append(others, heap("c"))
    drop(others[0:others.len])
    free(others)
    pair := [heap("d"), heap("e")]
    drop(pair[0:2])
