func positive_sum(x: i32|&strview|null, n: i32) -> bool:
    return x is i32 and x > 0 and n > 1 and x + n > 5

func cancels(x: i32|null, y: i32|null) -> bool:
    return x is null or y is null or x + y == 0

func main():
    print(positive_sum(3, 4), " ", positive_sum(3, 1), " ", positive_sum("a", 9), " ", positive_sum(null, 9))
    print(cancels(null, 1), " ", cancels(1, null), " ", cancels(2, -2), " ", cancels(2, 3))
    a := 1
    b := 2
    print(a == 1 and b == 2 or a == 2, " ", a == 1 and b == 3 or a == 2, " ", a == 2 or b == 2 and a == 1, " ", (a == 1 or b == 1) and (a == 2 or b == 3))
