T = [1, 2, 3]

func const(x: i32) -> i32:
    return x + 1

func sv(x: i32) -> i32:
    return x + 3

func main():
    y := T
    f := const
    h := sv
    print(f(1) + h(1) + y[0], " ", "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z")
