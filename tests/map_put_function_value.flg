func show(x: i32):
    print("i32 ", x)

func show(x: &strview):
    print("text ", x)

func biggest(a: $T, b: $T) -> $T:
    if a > b:
        return a
    return b

func main():
    shows: &map[&strview, func(i32)]
    defer free(shows)
    shows["a"] = show
    f := shows["a"]
    if f is func(i32):
        f(3)
    picks: &map[i32, func(i64, i64) -> i64]
    defer free(picks)
    picks[1] = biggest
    g := picks[1]
    if g is func(i64, i64) -> i64:
        print(g(4, 9))
