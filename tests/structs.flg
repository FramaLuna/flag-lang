type Point:
    x: i32
    y: i32

type Box:
    min: Point
    max: Point
    tag: u8

func area(b: Box) -> i32:
    return (b.max.x - b.min.x) * (b.max.y - b.min.y)

func moved(p: Point, dx: i32) -> Point:
    return Point{p.x + dx, p.y}

func shift(p: *Point):
    p.x += 100

func main() -> i32:
    b := Box{Point{1, 2}, Point{4, 6}, 9}
    print(area(b), " ", sizeof(Box), " ", b.tag)
    p := moved(b.min, 10)
    print(p.x, ",", p.y)
    shift(ptr(p))
    print(p.x)
    b.max.y = 12
    print(area(b))
    q: Point
    print(q.x + q.y)
    pp := ptr(q)
    pp.y = 5
    print(q.y, " ", pp.*.y)
    return 0
