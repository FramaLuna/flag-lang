type Value = i32|f64|bool|&strview|u8|u16|u32|u64|i8|i16|f32

func name(v: *Value) -> &strview:
    switch v.*:
    case i32, i8, i16:
        print("signed")
        return "i32"
    case f64, f32:
        print("float")
        return "f64"
    case bool:
        print("bool")
        return "bool"
    case &strview:
        print("text")
        return "text"
    case u8, u16, u32, u64:
        print("unsigned")
        return "unsigned"

func main():
    good: Value = 2.5
    print(name(ptr(good)))
    words := [99, 0, 0, 0]
    print(name(ptr(words) as usize as *Value))
