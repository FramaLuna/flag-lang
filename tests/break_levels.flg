func main():
    for i in 0..3:
        for j in 0..3:
            if j == 1:
                continue 2
            if i == 2:
                break 2
            print(i, " ", j)
    n := 0
    while true:
        while true:
            n += 1
            if n == 3:
                break 2
    print(n)
