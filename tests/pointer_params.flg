func grow(l: *&list[i32]):
    l[0] += 10
    append(l, l[0] + i32(l.len))

func shout(s: *&str):
    s.* += "!"
    print(s[0:2], " ", s.len)

func local(l: &list[i32]):
    append(l, 99)
    print("inside ", l.len)

func pick(l: &list[i32]) -> &strview:
    return "copy"

func pick(l: *&list[i32]) -> &strview:
    return "pointer"

func main() -> i32:
    xs: &list[i32]
    append(xs, 1)
    grow(xs)
    print(xs, " ", xs[0:1])
    local(xs)
    print("outside ", xs.len)
    t: &str = "hola"
    shout(t)
    print(t)
    print(pick(xs), " ", pick(ptr(xs)))
    return 0
