N = 4

func total(a: array[$T, $$n]) -> $T:
    sum: $T = 0
    for i in 0..$$n:
        sum += a[i]
    return sum

func main():
    a := [1, 2, 3, 4]
    for i in reverse 0..N:
        a[i] = a[i] * 10 + i
    for i in 0..2:
        print(a[i], " ", a[i + 2], " ", a[3])
    print(total(a), " ", total([u8(1), 2]))
