use math

type Pair:
    key: i32
    order: i32

operator <(a: Pair, b: Pair) -> bool:
    return a.key < b.key

func main():
    seed(3)
    for n in [0, 1, 2, 5, 16, 17, 33, 1000, 12345]:
        l: &list[i64]
        for i in 0..n:
            append(l, random(-50, 50))
        sort(l)
        ok := true
        for i in 1..l.len:
            ok = ok and not (l[i] < l[i - 1])
        print(n, " sorted ", ok)
        free(l)
    pairs: &list[Pair]
    defer free(pairs)
    for i in 0..300:
        append(pairs, Pair{i32(random(0, 5)), i})
    sort(pairs)
    stable := true
    for i in 1..pairs.len:
        if pairs[i].key == pairs[i - 1].key:
            stable = stable and pairs[i - 1].order < pairs[i].order
    print("stable ", stable)
    words := ["pear", "apple", "fig", "apple", "kiwi"]
    s: &slice[&strview] = ptr(words)
    sort(s)
    print(words)
