func main() -> i32:
    l: &list[i32]
    for x in split("5 1 4", " "):
        v := parse_int(x)
        if v is i64:
            append(l, i32(v))
    insert(l, 1, 9)
    print(l, " ", find(l, 4), " ", contains(l, 7))
    print(remove(l, 0), " ", l)
    reverse(l)
    print(join(l, "-"))
    m: &map[&strview, i32]
    for i, w in split("a b c d e f g h i j", " "):
        put(m, w, i32(i))
    print(remove(m, "c"), " ", remove(m, "zz"), " ", contains(m, "c"), " ", m.len)
    ok := true
    for w in split("a b d e f g h i j", " "):
        ok = ok and contains(m, w)
    print(ok)
    clear(m)
    print(m.len, " ", contains(m, "a"))
    free(m)
    print(replace("a-b-c", "-", "+"), " ", replace("aaa", "a", "bb"), " ", upper("Hello World 42"), " ", lower("ABC"))
    print(contains("flag", "la"), " ", join(split("x,y", ","), " | "))
    return 0
