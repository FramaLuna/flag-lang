func pick(n: i32) -> i32|u8:
    if n == 0:
        return u8(200)
    return n * 1000

func text(n: i32, owned: &str) -> &strview|&str:
    if n == 0:
        return "view"
    return owned

func main() -> i32:
    a: i64 = pick(0)
    b: i64 = pick(7)
    print(a, " ", b)
    owned: &str = "owned"
    s: &str
    s = text(0, owned)
    print(s)
    s = text(1, owned)
    print(s)
    return 0
