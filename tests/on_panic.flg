func save(message: &strview, place: &strview):
    eprint("saved: ", message, " at ", place)

func last(message: &strview, place: &strview):
    eprint("last: ", message, " at ", place)
    exit(5)

func main():
    on_panic(save)
    on_panic(last) # a new one replaces the one before
    total := 3
    assert total == 4
