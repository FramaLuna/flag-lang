type Big:
    a: i64
    b: i64
    c: i64
    d: i64
    e: i64
    f: i64
    g: i64
    h: i64

noinline func make(x: i64) -> Big:
    return Big{x, x, x, x, x, x, x, x}

noinline func peek() -> i64:
    return (8 as *i64).*

func main():
    before := peek()
    s := make(77)
    print(before, " ", peek())
