type Rgb:
    r: u8
    g: u8
    b: u8

func kind(c: u8) -> &strview:
    switch c:
    case 'a'..'z' + 1, 'A'..'Z' + 1:
        return "letter"
    case '0'..'9' + 1:
        return "digit"
    case:
        return "other"

func main() -> i32:
    primes := array[u16, 5]{2, 3, 5, 7, 11}
    total: u16 = 0
    for i in 0..5:
        total += primes[i]
    print(total, " ", sizeof(array[u16, 5]))
    palette := array[Rgb, 2]{Rgb{255, 0, 0}, Rgb{0, 0, 255}}
    print(palette[1].b)
    print(kind('q'), " ", kind('7'), " ", kind('-'))
    assert(total == 28)
    return 0
