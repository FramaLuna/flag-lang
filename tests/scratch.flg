func main() -> i32:
    first: usize = 0
    for i in 0..3:
        with scratch():
            line := "round " + i
            at := ptr(line.*) as usize
            if i == 0:
                first = at
            print(line, " ", at == first)
    kept: &str = "kept"
    defer free(kept)
    with scratch():
        kept += " " + upper("copied")
    print(kept)
    return 0
