type Point:
    x: i32
    y: i32

type error Missing

func find_name(ok: bool) -> &strview|Missing:
    if ok:
        return "ada"
    return Missing

func main() -> i32:
    n := 3
    print("n = " + n + ", double " + n * 2)
    print(1 + 2 + " is three")
    print("half " + 0.5 + " ok " + true)
    print("point " + Point{1, 2})
    print("found " + find_name(true) + " " + find_name(false))
    s: &str = "a"
    defer free(s)
    s += "b" + n + "c"
    s += 7
    s += n + n
    print(s)
    parts := split("x,y,z", ",")
    print(parts.len, " ", join(parts, "+"), " ", upper("abc") + lower("DEF"))
    return 0
