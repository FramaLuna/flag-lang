type P:
    x: i32

func bump(p: *P):
    p.x += 1

func main():
    m: &map[&strview, P]
    defer free(m)
    m["a"] = P{1}
    q := ptr(m["a"])
    q.* = P{50}
    print(m["a"])
    added := ptr(m["b"])
    added.x = 7
    print(m["b"], " ", m.len)
    bump(ptr(m["a"]))
    names: &map[&str, P]
    defer free(names)
    ptr(names["c"]).x = 3
    print(names, " ", m["a"])
    fixed: fixmap[i32, P, 2] = {1: P{1}}
    copy := ptr(fixed[1])
    copy.* = P{9}
    print(fixed[1])
