use net
use os

func late(s: Socket):
    sleep(0.5)
    write(s, "late\n")
    _ = flush(s)

func main():
    server := trust listen(0, "127.0.0.1")
    c := trust connect("127.0.0.1", port(server))
    peer := trust accept(server)
    timeout(c, 0.2)
    timeout(c, inf)
    t := parallel late(peer)
    print(read_line(c))
    wait(t)
    close(c)
    close(peer)
    close(server)
