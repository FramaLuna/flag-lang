use bits

type Set = Bits[2]

func main():
    a: Set
    b: Set
    for i in [1, 5, 64, 127]:
        a[usize(i)] = true
    for i in [5, 64, 70]:
        b[usize(i)] = true
    print(a, " ", b, " ", a[64], " ", a[2])
    print(a or b, " ", a and b, " ", a xor b, " ", a - b)
    print(count(a), " ", empty(a - a), " ", a == a, " ", a != b, " ", count(complement(a)))
    a[64] = false
    total: usize = 0
    for i in a:
        total += i
    print(a, " ", total)
