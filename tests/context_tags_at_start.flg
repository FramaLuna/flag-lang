use fs
use os

type enum Cell = Wall | Floor

context grid:
    cells: array[Cell, 1000000]
    exit: Cell|i64

func main():
    walls := 0
    for c in grid.cells:
        if c is Wall:
            walls += 1
    print(walls, " ", grid.exit)
    size := file_size(executable())
    print(size is usize and (size < 1000000 or system_name() == "Windows")) # Windows keeps the zeros of thread data in the file
