func sign(x: i32) -> i32:
    if x < 0:
        return -1
    if x == 0:
        return 0
    return 1

func digits(n: i32) -> i32:
    count := 1
    while n >= 10:
        n /= 10
        count += 1
    return count

func fact(n: i64) -> i64:
    if n < 2:
        return 1
    return n * fact(n - 1)

func even(n: i32) -> bool:
    if n == 0:
        return true
    return odd(n - 1)

func odd(n: i32) -> bool:
    if n == 0:
        return false
    return even(n - 1)

func noisy(x: i32) -> i32:
    defer print("leaving ", x)
    if x > 2:
        return x * 10
    return x

func first_even(l: &list[i32]) -> i32?:
    for x in l:
        if x % 2 == 0:
            return x
    return null

func main():
    print(sign(-5), " ", sign(0), " ", sign(7))
    print(digits(7), " ", digits(12345))
    print(fact(10))
    print(even(10), " ", odd(7))
    print(noisy(1) + noisy(3))
    l: &list[i32]
    defer free(l)
    append(l, 3)
    append(l, 8)
    print(first_even(l))
    l.len = 1
    print(first_even(l))
