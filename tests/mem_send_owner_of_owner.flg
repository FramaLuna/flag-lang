type Msg:
    body: &str
    id: i64

func worker(c: *Channel[*Msg, 2]) -> i64:
    n: i64 = 0
    for m in c:
        n += m.body.len
        free(m.body)
        free(m)
    return n

func main():
    c: Channel[*Msg, 2]
    t := parallel worker(c)
    send(c, heap(Msg{heap("job"), 1}))
    close(c)
    print(wait(t))
