extern "c":
    func strlen(s: cstr) -> usize

type Block:
    buf: array[u8, 4]
    guard: array[u8, 4]

func main():
    b := Block{[104, 111, 108, 97], [33, 33, 33, 33]}
    text: &str
    text = ptr(b.buf) as *bytes
    text.len = 4
    print(text.len, " ", text.cap, " ", b.guard)
    print(strlen(text))
    print(b.guard)
