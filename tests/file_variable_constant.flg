type enum Shape:
    Round, Square

TABLE = [3, 1, 4]
NAMES = ["a", "b"]
SHAPES = [Square, Round, Square]

table: array[i32, 3] = TABLE
names: array[&strview, 2] = NAMES
shapes: array[Shape, 3] = SHAPES
greeting: &strview = "hi"

func main():
    print(table, " ", TABLE, " ", names, " ", NAMES, " ", greeting, " ", "hi")
    print(shapes, " ", SHAPES, " ", SHAPES[1])
