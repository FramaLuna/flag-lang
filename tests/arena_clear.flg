func main():
    frame: Arena
    defer free(frame)
    first: u64 = 0
    for round in 0..3:
        clear(frame)
        a := arena(frame, round)
        l: &list[i32] = arena(frame, [])
        for i in 0..20000:
            append(l, i32(i))
        if round == 0:
            first = a as u64
        print(round, " ", a.*, " ", l.len, " ", a as u64 == first, " ", frame.blocks.len)
