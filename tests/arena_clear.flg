func main():
    frame: Arena
    defer free(frame)
    first: usize = 0
    for round in 0..3:
        clear(frame)
        a := arena(frame, round)
        l: &list[i32] = arena(frame, [])
        for i in 0..20000:
            append(l, i)
        if round == 0:
            first = a as usize
        print(round, " ", a.*, " ", l.len, " ", a as usize == first, " ", frame.blocks.len)
