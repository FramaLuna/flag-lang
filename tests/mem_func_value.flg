func grow(l: *&list[i32], n: i32):
    append(l, n)

func each(items: &slice[i32], f: func(i32) -> i32) -> i32:
    total := 0
    for v in items:
        total += f(v)
    return total

func double(x: i32) -> i32:
    return x * 2

func main():
    add: func(*&list[i32], i32) = grow
    l: &list[i32]
    defer free(l)
    add(l, 1)
    add(l, 2)
    print(each(l, double))
