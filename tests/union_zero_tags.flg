type enum Color = Red|Green|Blue
type enum Size = Small|Big

type Paint:
    c: Color
    s: Size
    note: &strview?

type Circle:
    fill: Color
    r: i32

type Square:
    side: i32

context shop:
    best: Color
    wall: array[Paint, 3]

func zero() -> i32|i64:
    y: i32|i64
    return y

func main():
    x: i32|i64|null = 5
    if x is i32|i64:
        x = zero()
    print(x, " ", x is null)
    m: &map[Color, i32]
    defer free(m)
    m[Red] = 1
    p: Paint
    print(p.c == Red, " ", m[p.c], " ", contains(m, p.c))
    m[p.c] = 2
    print(m.len, " ", m)
    shape: Circle|Square
    print(shape)
    row: array[Color, 12]
    print(row[0], " ", row[11])
    grid: array[Paint, 5]
    print(grid[4])
    print(Paint{s = Big})
    print(shop.best, " ", shop.wall[2])
