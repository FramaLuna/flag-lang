type Pair:
    a: i64
    b: i64

func main():
    text := malloc(64) as *u8
    at := text
    for i in 0..8:
        at.* = 1
        at = (at as usize + 8) as *u8
    free(text as *bytes)
    p := heap(Pair{})
    field := ptr(p.a)
    if arg_count() > 1:
        field = ptr(p.b)
    field.* = 7
    print(p.a + p.b)
    free(p as *bytes)
