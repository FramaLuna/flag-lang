type Rgba:
    r: u8
    g: u8
    b: u8
    a: u8

func main():
    one := 0x3f800000 as f32
    print(one, " ", 0xbf800000 as f32, " ", -1 as u8, " ", 255 as u8, " ", 0x0102 as array[u8, 2])
    c := 0x04030201 as Rgba
    print(c.r, " ", c.a, " ", 1 as bool, " ", hex(0x4000000000000000 as f64 as u64))
