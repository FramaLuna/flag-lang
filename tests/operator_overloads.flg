type V:
    x: i32
    y: i32

operator +(a: V, b: V) -> V:
    return V{a.x + b.x, a.y + b.y}

operator *(a: V, k: i32) -> V:
    return V{a.x * k, a.y * k}

operator ==(a: V, b: V) -> bool:
    return a.x == b.x and a.y == b.y

operator <(a: V, b: V) -> bool:
    return a.x * a.x + a.y * a.y < b.x * b.x + b.y * b.y

func biggest(a: $T, b: $T) -> $T:
    if a > b:
        return a
    return b

func main() -> i32:
    a := V{1, 2}
    b := V{3, 4}
    c := a + b * 2
    print(c.x, " ", c.y)
    print(a == V{1, 2}, " ", a != b, " ", a < b, " ", b > a, " ", a <= a, " ", a >= b)
    d := biggest(a, b)
    print(d.x)
    c *= 3
    print(c.x, " ", c.y)
    return 0
