func squares(n: i64) -> i64:
    a: Arena
    defer free(a)
    values: &list[i64] = arena(a, [])
    for i in 0..n:
        append(values, i * i)
    total: i64 = 0
    for v in values:
        total += v
    return total

func named(n: i32) -> &str:
    a: Arena
    defer free(a)
    parts: &list[&str] = arena(a, [])
    for i in 0..n:
        part: &str = arena(a, "part ")
        part += i
        append(parts, part)
    out: &str = heap("")
    for part in parts:
        out += part[part.len - 1:]
    return out

func main():
    sums: &list[Thread[i64]] = heap([])
    defer free(sums)
    for k in 1..9:
        append(sums, parallel squares(k * 10000))
    names := parallel named(10)
    for t in sums:
        print(wait(t))
    text := wait(names)
    defer free(text)
    print(text)
