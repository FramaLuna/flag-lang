type Opt[$T] = $T|null
type Two[$T] = array[$T, 2]
type Pairs[$K, $V] = &map[$K, &list[$V]]

func get(x: Opt[$T], fallback: $T) -> $T:
    if x is null:
        return fallback
    return x

func sum(t: Two[$T]) -> $T:
    return t[0] + t[1]

func count(m: Pairs[$K, $V]) -> usize:
    n: usize = 0
    for e in m:
        n += e.value.len
    return n

func main():
    a: Opt[i32] = 5
    b: Opt[i32]
    print(get(a, 0), " ", get(b, 7))
    print(sum([3, 4]), " ", sum([1.5, 2.0]))
    m: Pairs[&strview, i32]
    defer free(m)
    print(count(m))
