type Halves:
    lo: u16
    hi: u16

func read(value: u32) -> i32:
    return value as i32

func main() -> i32:
    bits: u32||i32 = 42
    unsigned: u32 = bits
    signed: i32 = bits as i32
    print(unsigned, " ", signed, " ", read(bits), " ", sizeof(u32||i32))
    wide: u64||f64 = 1.5
    print(wide as u64, " ", sizeof(u8||Halves||u64))
    pair: u32||Halves = u32(65537)
    h: Halves = pair as Halves
    print(h.lo, " ", h.hi)
    small: u8||u32 = u8(7)
    print(small as u32)
    mixed: (i32|null)||u64 = u64(3)
    print(sizeof((i32|null)||u64), " ", sizeof(i32|null))
    return 0
