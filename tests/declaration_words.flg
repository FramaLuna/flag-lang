type Decl:
    type: i32
    func: i32
    module: i32

func main():
    l: &list[i32]
    append(l, 1)
    append(l, 2)
    reverse(l)
    for x in reverse l:
        print(x)
    module := 3
    func := 4
    export := 5
    where := 6
    d := Decl{type = 1, func = 2, module = 3}
    print(module + func + export + where, " ", d)
