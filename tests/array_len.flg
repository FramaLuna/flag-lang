NAMES = ["a", "b", "c"]

func count(grid: *array[array[i32, 4], 2]) -> usize:
    return grid.len * grid[0].len

func main():
    print(NAMES.len)
    grid: array[array[i32, 4], 2]
    print(count(ptr(grid)))
    small: u8 = NAMES.len
    print(small)
    for i in 0..NAMES.len:
        print(NAMES[i])
