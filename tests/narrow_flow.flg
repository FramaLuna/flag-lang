type error Stop

func next_value(n: i32) -> i32|Stop|null:
    if n >= 4:
        return Stop
    if n == 2:
        return null
    return n * 10

func plus_one(n: i32) -> i32:
    return n + 1

func is_int(v: i32|Stop|null) -> bool:
    return v is i32

func main() -> i32:
    total: i32 = 0
    i: i32 = 0
    while i < 6:
        v := next_value(i)
        i += 1
        if v is Stop:
            break
        if v is null:
            continue
        total += plus_one(v)
    print(total)
    x: i32|null = 5
    if x is null:
        return 1
    print(x * 2)
    x = null
    print(x is null)
    x = 3
    if x is i32:
        print(is_int(x))
    y: i32|Stop|null = Stop
    if y is i32:
        print("int")
    elif y is null:
        print("null")
    else:
        print("stop")
    z: i32|null = null
    n: i32 = 0
    while z is null:
        n += 1
        if n == 3:
            z = n
    print(n, " ", z is i32)
    return 0
