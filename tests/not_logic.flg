type error Missing

func find(key: &strview) -> i32|Missing|null:
    if key == "one":
        return 1
    if key == "none":
        return null
    return Missing

func main():
    a := 3
    b := 4
    yes := true
    print(not a == b, " ", not a < b, " ", (not a) == -4)
    print(not yes and false, " ", not yes or true, " ", yes and not yes, " ", not not yes)
    found := find("one")
    if not found is i32:
        print("not i32")
    else:
        print("i32 ", found + 1)
    v := find("two")
    if not v is Missing and not v is null and v > 0:
        print("positive ", v)
    elif not v is i32:
        print("left ", v)
