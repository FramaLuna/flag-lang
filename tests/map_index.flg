type enum Color = Red|Green|Blue

func main():
    ages: &map[&strview, i32]
    defer free(ages)
    ages["ana"] = 30
    ages["bo"] = 25
    ages["ana"] = (ages["ana"] ifnull 0) + 1
    print(ages["ana"], " ", ages["zoe"], " ", ages.len)
    colors: &map[Color, &strview] = {Red: "rojo", Blue: "azul"}
    defer free(colors)
    print(colors[Red], " ", colors[Green], " ", colors[Blue])
    flags: &map[bool, i32] = {true: 1, false: 0}
    defer free(flags)
    print(flags[true], " ", flags[false])
    scores: &map[f64, i32] = {0.0: 1, 2.5: 2}
    defer free(scores)
    print(scores[-0.0], " ", scores[2.5], " ", scores[1.0])
