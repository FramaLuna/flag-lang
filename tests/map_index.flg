type enum Color = Red|Green|Blue

func main():
    ages: &map[&strview, i32] = heap({})
    defer free(ages)
    ages["ana"] = 30
    ages["bo"] = 25
    ages["ana"] = (ages["ana"] ifnull 0) + 1
    print(ages["ana"], " ", ages["zoe"], " ", ages.len)
    names: fixmap[Color, &strview, 2] = {Red: "rojo", Blue: "azul"}
    colors := heap(names)
    defer free(colors)
    print(colors[Red], " ", colors[Green], " ", colors[Blue])
    truths: fixmap[bool, i32, 2] = {true: 1, false: 0}
    flags := heap(truths)
    defer free(flags)
    print(flags[true], " ", flags[false])
    scores: &map[f64, i32] = heap({})
    defer free(scores)
    scores[0.0] = 1
    scores[2.5] = 2
    print(scores[-0.0], " ", scores[2.5], " ", scores[1.0])
