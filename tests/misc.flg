WIDTH = 80
HALF = WIDTH / 2
NAME = "flag"

extern "c":
    func abs(n: i32) -> i32
    func snprintf(into: *u8, size: usize, format: *u8, ...) -> i32

func fact(n: u64) -> u64:
    if n <= 1:
        return 1
    return n * fact(n - 1)

func main() -> i32:
    print(WIDTH, " ", HALF, " ", NAME)
    print(abs(0 - 42))
    print(fact(20))
    x: i32 = 1
    f := f32(x) / 2.0
    print(i32(f * 10.0))
    bits := 1.0 as u64
    print(bits)
    big: i64 = 300
    print(u8(big), " ", i8(u8(200)), " ", u16(i8(0 - 1)))
    buf: array[u8, 32]
    format: &strview = "%s=%d %.1f"
    n := snprintf(ptr(buf) as *u8, 32, ptr(format.*) as *u8, ptr(NAME.*) as *u8, 7, f32(2.5))
    print(n, " ", buf[0], buf[6])
    grid: array[array[i32, 3], 2]
    grid[1][2] = 7
    print(grid[1][2], " ", sizeof(array[array[i32, 3], 2]))
    return 0
