# the digits fill with zeros on the left, and a value with more digits keeps them all
func main():
    print(hex(u8(7), 2), " ", hex(7, 4), " ", hex(0x1234, 2), " ", hex(i8(-1), 4), " ", hex(0, 1), " ", hex(0))
    print(hex(1, 20), " ", hex(255, -3), " ", pad(hex(10, 2), 6), " ", hex(u64(0xdead_beef_0000_0001), 16))
