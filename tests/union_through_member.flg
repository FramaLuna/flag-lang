func count(x: &slice[i32]?) -> usize:
    if x is null:
        return 0
    return x.len

func main():
    t: &str = "abc"
    w: &strview|i32 = t
    m: &map[i32|&strview, i32]
    m[t] = 7
    k := ["a", t]
    keys: &map[array[&strview, 2], i32]
    keys[k] = 1
    l: &list[i32]
    append(l, 4)
    print(w, " ", m["abc"], " ", keys[["a", "abc"]], " ", count(l), " ", count(null))
    free(m)
    free(keys)
    free(l)
    free(t)
