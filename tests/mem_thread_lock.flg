func add(names: *Lock[&list[&str]], name: &strview):
    owned: &str = heap(name)
    with lock(names):
        append(names.value, owned)

func main():
    names := Lock[&list[&str]]{value = heap([])}
    t := parallel add(names, "one")
    add(names, "two")
    wait(t)
    for name in names.value:
        free(name)
    free(names.value)
