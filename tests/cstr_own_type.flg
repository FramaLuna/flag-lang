extern "c":
    func getenv(name: cstr) -> cstr
    func snprintf(into: *u8, size: i64, format: cstr, ...) -> i32

func main():
    unset := getenv("FLAG_NOT_SET_ANYWHERE")
    print("[", unset, "] ", unset as u64)
    c: cstr = "hola"
    d := c
    e := cstr("hola")
    print(c, " ", c.*, " ", c == d, " ", c == e, " ", c as u64 == e as u64)
    buf := array[u8, 4]{111, 107, 0, 0}
    p := ptr(buf[0]) as cstr
    print(p, ", " + p + ",")
    (p as *u8).* = 'O'
    print(p)
    line: array[u8, 64]
    snprintf(ptr(line[0]), 64, "%s and %s, %d", "hola", c, 7)
    print(ptr(line[0]) as cstr)
    w := wstr("añ€")
    print(w, " ", tmp(w).len, " [", 0 as wstr, "]")
