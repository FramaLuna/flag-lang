use ring

func main():
    q: &ring[i32]
    defer free(q)
    for i in 0..6:
        append(q, i)
    prepend(q, -1)
    prepend(q, -2)
    print(q, " ", q.len, " ", q[0], " ", q[-1])
    print(take(q), " ", take(q), " ", pop(q), " ", q)
    for i in 10..20:
        append(q, i)
        _ = take(q)
    q[0] = 100
    total := 0
    for v in q:
        total += v
    print(q, " ", total)
    while q.len > 0:
        _ = pop(q)
    print(take(q), " ", pop(q), " ", q)
