type Point:
    x: i32
    y: i32

func kind(x: i64) -> &strview:
    return "i64"

func kind(x: u64) -> &strview:
    return "u64"

func kind(x: i32) -> &strview:
    return "i32"

func count(a: array[u8, $$n]) -> &strview:
    n := $$n
    return kind(n)

func main():
    n := 5
    small := 0x7fff_ffff
    huge := 0xffff_ffff_ffff_ffff
    print(kind(n), " ", kind(small), " ", small + 1, " ", kind(huge), " ", kind(3), " ", kind(i32(3)))
    a: array[u8, 3]
    size := @sizeof(Point)
    at := @offset_of(Point, y)
    len := a.len
    c := 'a'
    letter: u8 = 'a'
    print(kind(size), " ", kind(at), " ", kind(len), " ", kind(c), " ", c, " ", letter, " ", count(a))
    for i in 0..1:
        print(kind(i))
    pair := [1, 2]
    squares := {3: 9}
    for e in squares:
        print(kind(pair[0]), " ", kind(e.key), " ", kind(e.value), " ", @sizeof(array[i64, 2]) == 16)
    flipped := not 0
    print(kind(flipped), " ", flipped)
