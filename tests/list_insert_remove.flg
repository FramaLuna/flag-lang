func main():
    l: &list[i64]
    defer free(l)
    for i in 0..6:
        append(l, i)
    insert(l, 0, 100)
    insert(l, 3, 300)
    insert(l, l.len, 999)
    insert(l, l.len - 1, 42)
    print(l)
    print(remove(l, 0), " ", remove(l, l.len - 1), " ", remove(l, 2), " ", l)
    insert(l, -1, 7)
