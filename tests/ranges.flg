func main() -> i32:
    e: i32 = 0
    for x in 5..5:
        e += 1
    for x in 6..2:
        e += 1
    print(e)
    k: u8 = 250
    n: i32 = 0
    last: u8 = 0
    for x in k..255:
        n += 1
        last = x
    print(n, " ", last)
    s: i8 = -3
    total: i32 = 0
    for x in s..3:
        total += i32(x)
    print(total)
    top: i64 = 9223372036854775807
    steps: i32 = 0
    for x in top - 2..top:
        steps += 1
    print(steps)
    empty: &list[i32]
    count := 0
    for v in empty:
        count += 1
    print(count)
    t := 0
    for i in 0..10:
        if i % 2 == 0:
            continue
        for j in 0..10:
            if j > i:
                break
            t += j
    print(t)
    w := 0
    while false:
        w += 1
    print(w)
    return 0
