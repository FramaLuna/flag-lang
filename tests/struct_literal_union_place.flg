type Point:
    x: i32
    y: i32

func origin(ok: bool) -> Point?:
    if not ok:
        return null
    return {1, 2}

func main():
    print(origin(true), " ", origin(false))
    m: &map[&strview, Point]
    defer free(m)
    m["a"] = {x = 3, y = 4}
    print(m["a"])
    p: Point|i32 = {5, 6}
    print(p)
