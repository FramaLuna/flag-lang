# a shared field fills the first bytes of the field it shares, in a constant the rest keep its default, as in a literal that runs
type W:
    whole: u32 = 0xdead_beef
    low: u16 @whole

type R:
    ratio: f64 = 0.1
    head: u32 @ratio

K: W = {low = 5}
U = W{low = 5}
F: R = {head = 0}

func main():
    a := W{low = 5}
    r := R{head = 0}
    print(K.whole, " ", U.whole, " ", a.whole, " ", K == a, " ", F.ratio, " ", F.ratio as u64 == r.ratio as u64)
