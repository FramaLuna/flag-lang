func f(x: f32) -> &strview:
    return "f32"

func f(x: f64) -> &strview:
    return "f64"

func g(x: i64) -> &strview:
    return "i64"

func g(x: f32) -> &strview:
    return "f32"

func main() -> i32:
    print(f(2), " ", f(2.0), " ", g(2))
    a: f32? = 5
    b: u8|f32 = 5
    c: f32|f64 = 5
    if a is f32 and b is u8 and c is f64:
        print(a, " ", b, " ", c)
    return 0
