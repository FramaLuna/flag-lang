func name() -> &strview where @linux():
    return "linux"

func name() -> &strview where @macos():
    return "macos"

func name() -> &strview where @windows():
    return "windows"

func bits() -> i32 where @x86_64() or @arm64() or @riscv64():
    return 64

func unix() -> bool where @linux() or @macos():
    return true

func unix() -> bool where not (@linux() or @macos()):
    return false

func main() -> i32:
    print(name().len > 0, " ", bits(), " ", unix() == (name() != "windows"))
    return 0
