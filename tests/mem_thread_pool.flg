type Served:
    count: i32
    log: &list[&str] = heap([])

type Pool:
    jobs: Channel[&str, 16]
    served: Lock[Served]

func worker(p: *Pool, n: i32) -> i32:
    mine: i32 = 0
    for path in p.jobs:
        line: &str = heap("worker ")
        line += n
        line += " served " + path
        with lock(p.served):
            p.served.value.count += 1
            append(p.served.value.log, line)
        free(path)
        mine += 1
    return mine

func main():
    pool: Pool
    workers: &list[Thread[i32]] = heap([])
    defer free(workers)
    for n in 0..4:
        append(workers, parallel worker(pool, i32(n)))
    for i in 0..20:
        path: &str = heap("/page/")
        path += i
        send(pool.jobs, path)
    close(pool.jobs)
    total := 0
    for w in workers:
        total += wait(w)
    print(total, " ", pool.served.value.count, " ", pool.served.value.log.len)
    for l in pool.served.value.log:
        free(l)
    free(pool.served.value.log)
