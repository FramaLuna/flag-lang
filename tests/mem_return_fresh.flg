func text(n: i32) -> &str:
    out: &str
    if n < 0:
        return out
    i := 0
    while i < n:
        out += "a"
        i += 1
    return out

func key(n: i32) -> &str:
    if n == 7:
        empty: &str
        return empty
    return text(n)

func main() -> i32:
    k := key(3)
    print(k)
    free(k)
    return 0
