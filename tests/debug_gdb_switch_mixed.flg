noinline func classify(n: i64, special: i64) -> i64:
    r := 0
    switch n:
    case 1:
        r = 10
    case 2:
        r = 20
    case 3:
        r = 30
    case 4:
        r = 40
    case 5:
        r = 50
    case 6:
        r = 60
    case 7:
        r = 70
    case 8:
        r = 80
    case special:
        r = 90
    case 9:
        r = 99
    return r + 1

func main():
    print(classify(6, 7), " ", classify(9, 12))
