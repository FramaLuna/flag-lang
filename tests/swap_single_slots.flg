noinline func touch(x: i64) -> i64:
    return x xor 5

noinline func run(n: i64, m: i64) -> i64:
    g0: f32 = -1720.0
    g1: f32 = 4779.0
    g2: f32 = 4014.0
    g3: f32 = 528.0
    g4: f32 = 2970.0
    g5: f32 = -2658.0
    g6: f32 = -4319.0
    g7: f32 = 1607.0
    g8: f32 = -1283.0
    g9: f32 = 944.0
    f0: f64 = -1757.0
    f1: f64 = -607.0
    f2: f64 = 1419.0
    f3: f64 = -490.0
    f4: f64 = 1761.0
    f5: f64 = -3813.0
    f6: f64 = 2655.0
    f7: f64 = 3746.0
    f8: f64 = 227.0
    f9: f64 = 2141.0
    f10: f64 = 1464.0
    f11: f64 = 3991.0
    f12: f64 = 3985.0
    for i in 0..n:
        g3, g8, g5, g0, g7, g2, g9, g6, g1, g4, f11, f8, f6, f7, f5, f0, f10, f1, f9, f3, f2, f12 = g0, g5, g2, g1, g9, g4, g6, g8, g7, g3, f2, f1, f8, f5, f10, f9, f3, f7, f12, f11, f0, f6
        g7, f1 = f32(f1), f64(g7)
    s: i64 = 0
    s = (s << 5) xor (s >> 59) xor i64(g0)
    s = (s << 5) xor (s >> 59) xor i64(g1)
    s = (s << 5) xor (s >> 59) xor i64(g2)
    s = (s << 5) xor (s >> 59) xor i64(g3)
    s = (s << 5) xor (s >> 59) xor i64(g4)
    s = (s << 5) xor (s >> 59) xor i64(g5)
    s = (s << 5) xor (s >> 59) xor i64(g6)
    s = (s << 5) xor (s >> 59) xor i64(g7)
    s = (s << 5) xor (s >> 59) xor i64(g8)
    s = (s << 5) xor (s >> 59) xor i64(g9)
    s = (s << 5) xor (s >> 59) xor i64(f0)
    s = (s << 5) xor (s >> 59) xor i64(f1)
    s = (s << 5) xor (s >> 59) xor i64(f2)
    s = (s << 5) xor (s >> 59) xor i64(f3)
    s = (s << 5) xor (s >> 59) xor i64(f4)
    s = (s << 5) xor (s >> 59) xor i64(f5)
    s = (s << 5) xor (s >> 59) xor i64(f6)
    s = (s << 5) xor (s >> 59) xor i64(f7)
    s = (s << 5) xor (s >> 59) xor i64(f8)
    s = (s << 5) xor (s >> 59) xor i64(f9)
    s = (s << 5) xor (s >> 59) xor i64(f10)
    s = (s << 5) xor (s >> 59) xor i64(f11)
    s = (s << 5) xor (s >> 59) xor i64(f12)
    return s

func main():
    print(run(2, 1))
