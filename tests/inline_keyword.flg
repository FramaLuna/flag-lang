type V:
    x: f64
    y: f64

inline operator +(a: V, b: V) -> V:
    return V{a.x + b.x, a.y + b.y}

inline func clamp(x: $T, low: $T, high: $T) -> $T:
    if x < low:
        return low
    if x > high:
        return high
    return x

inline func tally(n: i32) -> i32:
    total := 0
    for i in 0..n:
        if i % 3 == 0:
            total += i
        elif i % 5 == 0:
            total -= 1
        elif i % 7 == 0:
            total *= 2
        else:
            total += 1
    words: &list[&strview]
    defer free(words)
    append(words, "a")
    append(words, "b")
    return total + i32(words.len)

priv inline func twice(x: i32) -> i32:
    return x * 2

func main():
    f := tally
    print(tally(20), " ", f(20), " ", twice(21))
    print(clamp(15, 0, 10), " ", clamp(-2.5, 0.0, 1.0), " ", clamp("m", "a", "k"))
    print(V{1.0, 2.0} + V{3.0, 4.0})
    inline := 3
    print(inline)
