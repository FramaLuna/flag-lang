# a pointer of wasm32 past 2 GiB reaches a host of JavaScript as an i32 below 0, which it reads unsigned: args_get
# writes there, and fd_write finds the line of print there
func main():
    low := malloc(1 << 31)
    given: &listview[cstr]
    given = @argv()
    given.len = @argc()
    path := view(given[0])
    print(low as u64 < 1 << 31, " ", ptr(given.*) as u64 >= 1 << 31, " ", path[(find_last(path, "/") ifnull -1) + 1:])
