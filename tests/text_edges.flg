func main() -> i32:
    e: &str
    print(e.len, " [", e, "]")
    e += ""
    print(e.len, " ", e == "")
    s: &str = "abc"
    s += "def"
    print(s, " ", s.len, " ", s[0:0].len, " ", s[6:6].len, " ", s[2:4])
    print("ab" == "ab", " ", "ab" == "abc", " ", "abc" == "abd", " ", "" == "", " ", "b" != "a")
    copy: &str = view(s)
    copy += "!"
    print(s, " ", copy)
    n := 0
    for c in "héllo":
        n += 1
    word: &strview = "héllo"
    print(n, " ", word.len)
    joined: &str
    for i in 0..3:
        joined += "ab"
    print(joined, " ", joined.len)
    return 0
