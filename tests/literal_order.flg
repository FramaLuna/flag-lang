# a literal reads each value when it gives it, whatever the width of its fields
type Narrow:
    a: i32
    b: i32

type Wide:
    a: i64
    b: i64

type enum Color:
    Red, Green, Blue

type Small:
    on: bool
    n: i16
    c: Color

func bump(p: *i32) -> i32:
    p.* += 10
    return p.*

func change(c: *Color, on: *bool) -> i16:
    c.* = Blue
    on.* = false
    return 7

func main():
    x: i32 = 1
    print(Narrow{x, bump(ptr(x))})
    y: i32 = 1
    print(Wide{y, bump(ptr(y))})
    z: i32 = 1
    print(Narrow{a = z, b = bump(ptr(z))})
    c: Color = Red
    on := true
    print(Small{on, change(ptr(c), ptr(on)), c})
    w: i32 = 1
    print(array[i32, 2]{w, bump(ptr(w))})
