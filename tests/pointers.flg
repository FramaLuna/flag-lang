type Node:
    value: i32
    next: *Node|null

type Cell:
    n: i64

func push_front(head: *Node|null, v: i32) -> *Node:
    return heap(Node{v, head})

func main() -> i32:
    head: *Node|null = null
    for i in 1..6:
        head = push_front(head, i)
    total: i32 = 0
    count := 0
    cur := head
    while cur is *Node:
        total += cur.value
        count += 1
        cur = cur.next
    print(total, " ", count)
    c := Cell{1}
    p := ptr(c)
    pp := ptr(p)
    pp.*.n += 10
    p.n *= 2
    print(c.n, " ", pp.*.*.n)
    arr: array[u16, 4]
    base := ptr(arr) as usize
    third := (base + 4) as *u16
    third.* = 65535
    print(arr[2])
    cells: &list[Cell]
    append(cells, Cell{5})
    first := at(cells, 0)
    first.n = 50
    print(cells[0].n)
    cells[0].n += 1
    print(cells[0].n)
    return 0
