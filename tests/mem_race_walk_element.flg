func sum(l: &listview[i64]) -> i64:
    s: i64 = 0
    for v in l:
        s += v
    return s

func main():
    values: &list[i64] = heap([1, 2, 3])
    defer free(values)
    sums: &list[Thread[i64]] = heap([])
    defer free(sums)
    for v in values:
        append(sums, parallel sum(values))
        v = 5
    for t in sums:
        print(wait(t))
