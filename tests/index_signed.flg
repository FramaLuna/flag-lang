func main():
    l: &list[i32]
    defer free(l)
    for k in 0..5:
        append(l, k * 10)
    a := [1, 2, 3]
    n: i64 = 5
    for i in 0..n:
        l[i] += 1
    for i in reverse 0..n:
        print(i, " ", l[i], " ", l[i - n])
    for i in -3..3:
        print(i, " ", a[i], " ", l[i8(i)], " ", l[:5][i32(i)])
    m: i64 = 2
    for i in m - 4..m:
        print(i, " ", a[i])
    far: i64 = -4
    print(a[far])
