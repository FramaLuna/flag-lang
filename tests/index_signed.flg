func main():
    l: &list[i64]
    defer free(l)
    for k in 0..5:
        append(l, k * 10)
    a := [1, 2, 3]
    n: i64 = 5
    for i in 0..n:
        l[i] += 1
    for i in reverse 0..n:
        print(i, " ", l[i], " ", l[n - 1 - i])
    for i in 0..3:
        print(i, " ", a[i], " ", l[i8(i)], " ", l[:5][i32(i)])
    m: i64 = 2
    for i in m - 2..m + 1:
        print(i, " ", a[i])
    for i in -1..3:
        print(i, " ", a[i])
