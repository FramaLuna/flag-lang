type A
type B

func name(v: A|B|null) -> &strview:
    if v is null:
        return "null"
    if v is A:
        return "a"
    return "b"

func main() -> i32:
    p := calloc(2, sizeof(A|B)) as *(A|B)
    q := p.*
    print(q is A)
    r: A|B|null = q
    print(name(r))
    o := calloc(1, sizeof(A|B|null)) as *(A|B|null)
    print(name(o.*))
    return 0
