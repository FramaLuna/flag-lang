type A
type B

func name(v: A|B|null) -> &strview:
    if v is null:
        return "null"
    if v is A:
        return "a"
    return "b"

func main() -> i32:
    made: A|B
    print(made is A)
    r: A|B|null = made
    print(name(r))
    o := calloc(1, sizeof(A|B|null)) as *(A|B|null)
    print(name(o.*))
    return 0
