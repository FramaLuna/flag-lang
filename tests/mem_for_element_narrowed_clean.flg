func main():
    u: &list[i32|&strview] = heap([])
    defer free(u)
    append(u, 1)
    append(u, "a")
    for i, v in u:
        if v is i32:
            print(v + 1)
        if v is &strview:
            print(v)
        switch v:
        case i32:
            print(v * 2)
        case &strview:
            print(v.len)
        if v is i32:
            u[i] = 5
            print(v + 1)
