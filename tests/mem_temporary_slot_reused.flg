func main():
    a := heap(i64(1))
    b := heap(i64(2))
    c := heap(i64(3))
    d := heap(i64(4))
    for row in 0..2:
        for p in [a, b, c, d]:
            print(p.*, row, "\n")
    free(a)
    free(b)
    free(c)
    free(d)
    ages: &map[&strview, i64] = heap({})
    ages["ana"] = 30
    print(ages.len, "\n")
    free(ages)
