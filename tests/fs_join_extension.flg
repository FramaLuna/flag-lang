use fs

func main():
    print(join_path("a/", "/b"), " ", join_path("a", "b"), " ", join_path("a/", "b"), " ", join_path("a", "/b"), " ", join_path("a//", "//b"), " ", join_path("/", "b"), " ", join_path("", "b"), " ", join_path("a", ""), " [", join_path("", ""), "]")
    print("[", extension(".config.json"), "] [", extension(".."), "] [", extension("."), "] [", extension(".hidden"), "] [", extension("a/b.c/name"), "] [", extension("x.tar.gz"), "] [", extension("..a.b"), "] [", extension("name."), "]")
