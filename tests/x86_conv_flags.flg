noinline func choose_f32(x: u64, y: u64) -> f32:
    return f32(max(f32(x), f32(y))) if not (i16(x) != i16(y)) else f32(-0.0) - f32(y)

noinline func choose_u64(a: f64, b: f64, cond: i32) -> u64:
    return u64(a) if cond == 0 else u64(b)

func main():
    print(choose_f32(0, 16))
    print(choose_f32(5, 5))
    print(choose_u64(42.0, 99.0, 0))
    print(choose_u64(42.0, 99.0, 1))
