type error Bad:
    line: usize
    column: usize
    reason: &str

type Document:
    text: &strview
    nodes: &list[i32]

func make(t: &strview) -> Document|Bad:
    if t.len == 0:
        reason: &str = "empty " + t.len
        return Bad{1, 1, reason}
    d: Document
    append(d.nodes, 7)
    return d

func free(d: *Document):
    free(d.nodes)

func main():
    d := make("abc")
    if d is Document:
        free(d)
        return
    print(d.line)
