type Count:
    n: i64

type Walk:
    i: i64
    n: i64

operator for(c: Count) -> Walk:
    return Walk{0, c.n}

operator next(w: *Walk) -> i64|IterationEnd:
    if w.i == w.n:
        return IterationEnd
    w.i += 1
    return w.i

func next(w: *Walk) -> i64:
    w.i += 10
    return w.i

func main():
    for x in Count{3}:
        print(x)
    w := Walk{0, 3}
    print(next(ptr(w)), " ", next(ptr(w)))
