func main():
    level: Arena
    defer free(level)
    l := heap([1, 2, 3])
    defer free(l)
    m := heap({"a": 1, "b": 2})
    defer free(m)
    t := heap("text")
    defer free(t)
    append(l, 4)
    m["c"] = 3
    t += "!"
    print(l, " ", m.len, " ", m["c"], " ", t)
    a := arena(level, [u8(250), 251])
    n := arena(level, {1: "one"})
    s := arena(level, "in the arena")
    print(a, " ", n, " ", s)
    pairs := {2: 4, 3: 9}
    squares := heap(pairs)
    defer free(squares)
    print(pairs, " ", squares[3], " ", pairs.len)
