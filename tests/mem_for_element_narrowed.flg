type P:
    x: i32

func main():
    l: &list[P] = heap([])
    defer free(l)
    append(l, P{1})
    append(l, P{2})
    for e in l:
        e.x = 99
    print(l)
    u: &list[i32|&strview] = heap([])
    defer free(u)
    append(u, 1)
    for i, v in u:
        if v is i32:
            u[i] = "texto"
            print(v + 1)
    g: &list[i64] = heap([])
    defer free(g)
    append(g, 1)
    for x in g:
        for k in 0..1000:
            append(g, 7)
        x = 5
