func pick(flag: bool) -> i32:
    if flag:
        t := 1
        return t
    else:
        t := 2
        return t

func main() -> i32:
    print(pick(true), " ", pick(false))
    for i in 0..2:
        v := i * 10
        print(v)
    for i in 0..1:
        v := 7
        print(v)
    k := 0
    while k < 2:
        inner := k + 100
        k += 1
        print(inner)
    switch k:
    case 2:
        w := 1
        print(w)
    case:
        w := 2
        print(w)
    return 0
