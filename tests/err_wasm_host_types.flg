# fd_write of the host is declared by core with an i32 descriptor, and once more here with an i64 one
extern "wasi_snapshot_preview1":
    func fd_write(fd: i64, pieces: *bytes, count: i64, moved: *bytes) -> i32

func main():
    moved: i64 = 0
    fd_write(1, 0 as *bytes, 0, ptr(moved) as *bytes)
    print("once")
