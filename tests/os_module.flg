use os

func main() -> i32:
    path := env("PATH")
    print(path is &strview, " ", env("FLAG_SURELY_UNSET") is null)
    text: &str
    defer free(text)
    print(run("exit 3"), " ", run("exit 0"), " ", output("echo one", text), " ", trim(text))
    start := now()
    sleep(0.01)
    took := now() - start
    print(took >= 0.01 and took < 1.0)
    return 0
