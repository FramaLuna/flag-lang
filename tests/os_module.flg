use os

func main() -> i32:
    path := env("PATH")
    print(path is &strview, " ", env("FLAG_SURELY_UNSET") is null)
    print(run("exit 3"), " ", run("exit 0"), " ", trim(output("echo one")))
    start := now()
    sleep(0.01)
    took := now() - start
    print(took >= 0.01 and took < 1.0)
    return 0
