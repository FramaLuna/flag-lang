# a library of pure computation: it imports nothing from the host
export func fib(n: i32) -> i32:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

export func answer() -> i64:
    total: i64 = 0
    for i in 0..10:
        total += i64(fib(i32(i)))
    return total

export func area() -> f64:
    return 2.5 * 4.0

func twice(x: i32) -> i32:
    return x * 2

export func doubled() -> i32:
    return twice(21)
