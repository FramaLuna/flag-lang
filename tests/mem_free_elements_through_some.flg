type Box:
    value: *i64

func main():
    boxes: &list[*Box] = heap([])
    v := heap(i64(1))
    b := heap(Box{heap(i64(2))})
    if v.* > 3: # v is lost on the other path, which the checker doesn't see
        free(b.value)
        b.value = v
    append(boxes, b)
    for x in boxes:
        free(x.value)
        free(x)
    free(boxes)
