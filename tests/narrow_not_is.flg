type error Missing

func find(key: &strview) -> i32|Missing|null:
    if key == "one":
        return 1
    if key == "none":
        return null
    return Missing

func show(key: &strview):
    found := find(key)
    if not (found is i32):
        print(key, ": ", found)
        return
    print(key, ": ", found + 1)

func main():
    show("one")
    show("none")
    show("two")
    v := find("one")
    if not (v is Missing or v is null) and v > 0:
        print("positive ", v)
    while not (v is null):
        print("left ", v)
        v = null
    w := find("two")
    if not (w is Missing):
        print("not missing ", w)
    else:
        print("missing ", w)
