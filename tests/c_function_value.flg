extern "m":
    func sqrt(x: f64) -> f64
    func floor(x: f64) -> f64

export func twice(x: f64) -> f64:
    return x * 2.0

func apply(f: extern func(f64) -> f64, x: f64) -> f64:
    return f(x)

func main():
    f := sqrt
    print(f(16.0), " ", apply(floor, 2.5), " ", apply(twice, 4.0))
    steps: array[extern func(f64) -> f64, 3] = [sqrt, floor, twice]
    for s in steps:
        print(s(9.5))
    empty: extern func(f64) -> f64
    print(empty == sqrt, " ", f == sqrt, " ", steps[2] == twice)
