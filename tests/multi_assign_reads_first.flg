context app:
    scale: i64 = 1

type M:
    n: i64

operator +(a: M, b: M) -> M:
    print("adding")
    return {(a.n + b.n) * app.scale}

func main():
    l: &list[i64] = heap([1, 2])
    defer free(l)
    n, last := l.len, trust pop(l)
    print(n, " ", last)
    a := 1
    b := 2
    pa := ptr(a)
    pa.*, b = b, a
    print(a, " ", b)
    v := M{1}
    total := M{0}
    app.scale, total = 10, v + v
    print(total)
    _, k := v + v, 5
    print(k)
