type Entry:
    nick: &str|null = null

func listed():
    es: &list[Entry] = heap([])
    for i in 0..4:
        e: Entry
        if i % 2 == 0:
            e.nick = heap("n")
        append(es, e)
    for e in es:
        n := e.nick
        if n is &str:
            free(n)
    free(es)

func indexed():
    es: &list[Entry] = heap([])
    for i in 0..4:
        e: Entry
        e.nick = heap("n")
        append(es, e)
    for i in 0..es.len:
        n := es[i].nick
        if n is &str:
            free(n)
    free(es)

func arrayed():
    es: array[Entry, 4]
    for i in 0..4:
        es[i].nick = heap("n")
    for e in es:
        n := e.nick
        if n is &str:
            free(n)

func main():
    listed()
    indexed()
    arrayed()
