type Cell:
    a: &list[i64] = heap([])
    b: &list[i64] = heap([])
    c: &list[i64] = heap([])
    d: &list[i64] = heap([])
    e: &list[i64] = heap([])
    f: &list[i64] = heap([])
    g: &list[i64] = heap([])
    h: &list[i64] = heap([])

context grid:
    cells: array[Cell, 16]

export func count() -> i64:
    append(grid.cells[0].a, 1)
    return grid.cells[0].a.len

func main(): @trust
    print(count())
