type Box:
    items: &list[i32]

func first(items: &slice[$T]) -> $T:
    return items[0]

operator ==(a: Box, b: Box) -> bool:
    return first(a.items) == first(b.items)

func main():
    full: &list[i32]
    append(full, 5)
    empty: &list[i32]
    print(Box{full} == Box{full})
    print(Box{full} == Box{empty})
