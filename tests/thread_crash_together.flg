shared context start:
    ready: Lock[i32]

func work(p: *i64) -> i64:
    with lock(start.ready):
        start.ready.value += 1
    while true: # the 16 threads fail at once
        with lock(start.ready):
            if start.ready.value == 16:
                break
    return p.*

func main():
    ts: &list[Thread[i64]]
    defer free(ts)
    for i in 0..16:
        append(ts, parallel work(0 as *i64))
    for t in ts:
        print(wait(t))
