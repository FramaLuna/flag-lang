context app:
    depth: u32
    names: &list[&strview]

func deeper() -> u32:
    app.depth += 1
    return app.depth

func main() -> i32:
    print(app.depth)
    _ = deeper()
    print(deeper())
    append(app.names, "x")
    append(app.names, "y")
    print(app.names.len, " ", app.names[1])
    return 0
