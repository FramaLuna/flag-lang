func main():
    l: &list[i32] = heap([])
    defer free(l)
    append(l, 1)
    i: i32 = 0
    while i < l.len:
        i += 1
    print(i)
    s: i32 = -1
    u: u32 = 1
    print(s < u, s <= u, s > u, s >= u, s == u, s != u)
    print(u < s, u <= s, u > s, u >= s, u == s, u != s)
    n: i64 = -1
    w: u64 = 0
    print(n < w, n <= w, n > w, n >= w, n == w, n != w)
    print(w < n, w <= n, w > n, w >= n, w == n, w != n)
    m: i64 = 5
    v: u64 = 5
    top: u64 = 18446744073709551615
    print(m == v, m < top, top > m, m >= v)
    b: u8 = 200
    k: i8 = -100
    print(b > k, k < b, b == 200)
