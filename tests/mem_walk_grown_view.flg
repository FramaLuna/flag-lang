type Player:
    name: &str
    score: i64

func main():
    players: &list[Player] = heap([])
    append(players, Player{name = heap("ana"), score = 1})
    append(players, Player{name = heap("bob"), score = 2})
    best := players[1].name[0:3]
    for p in players:
        p.name += " (champion of the season, with many points)" # moves the text that best sees
    print(best)
    for p in players:
        free(p.name)
    free(players)
