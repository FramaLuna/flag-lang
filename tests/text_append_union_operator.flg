type Value = &str|i64

operator +=(s: *&str, v: Value):
    switch v:
    case &str:
        s.* += "\"" + view(v) + "\""
    case i64:
        s.* += "" + v

func main():
    out: &str
    v: Value = 42
    out += v
    print(out)
    name: &str = "ana"
    v = name
    out += " " + v
    print(out)
    print("" + name + v)
