use ring

type Queue:
    jobs: &ring[i32]
    name: &strview

func fill(q: *Queue, count: i32):
    for i in 0..count:
        append(q.jobs, i)

func main() -> i32:
    r: &ring[i32]
    defer free(r)
    for i in 0..20:
        append(r, i)
    prepend(r, 7)
    total := 0
    for v in r:
        total += v
    last := pop(r)
    first := take(r)
    print(total, " ", last, " ", first, " ", r[0], " ", r)
    q: Queue
    fill(q, 3)
    fill(q, 30)
    print(q.jobs.len)
    free(q.jobs)
    words: &ring[&strview]
    append(words, "a")
    append(words, "b")
    print(words)
    free(words)
    return 0
