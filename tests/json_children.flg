use json

func main():
    d := trust parse("{\"a\": [1, [2, 3], {\"x\": 4}], \"b\": {\"k\": \"v\", \"n\": null}, \"c\": []}")
    defer free(d)
    for i, c in children(d, 0):
        print(i, " ", key(d, 0, i), " ", kind(d, c), " ", count(d, c))
    for c in children(d, get(d, 0, "a")):
        print(raw(d, c))
    for c in children(d, get(d, 0, "missing")):
        print("never")
    print(key(d, get(d, 0, "b"), 1), " ", item(d, get(d, 0, "a"), 5) is null)
