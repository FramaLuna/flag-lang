type Pair[$T]:
    a: $T
    b: $T

func sum(p: Pair[$T]) -> $T:
    return p.a + p.b

func biggest(a: $T, b: $T) -> $T:
    if a > b:
        return a
    return b

func first(a: array[$T, $$n]) -> $T:
    return a[0]

func size(a: array[$T, $$n]) -> usize:
    return $$n

type Stack[$T]:
    items: &list[$T]

func push_on(s: *Stack[$T], v: $T):
    append(s.items, v)

func main() -> i32:
    p: Pair[i32]
    p.a = 3
    p.b = 4
    print(sum(p))
    q: Pair[f64]
    q.a = 1.5
    q.b = 2.25
    print(sum(q) > 3.0)
    print(biggest(3, 9), " ", biggest(u8(7), u8(2)))
    a: array[i64, 3]
    a[0] = 42
    print(first(a), " ", size(a))
    s: Stack[i32]
    push_on(ptr(s), 5)
    push_on(ptr(s), 6)
    print(s.items.len, " ", s.items[1])
    return 0
