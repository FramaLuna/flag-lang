type Motor:
    hp: u32
    cc: u32

type Car:
    model: &strview
    motor: Motor
    seats: array[u8, 2]

type Point:
    x: i32
    y: i32

func origin() -> Point:
    return {0, 0}

func main():
    c: Car = {"mini", {120, 1300}, [4, 5]}
    d: Car = {model = "fiat", motor = {hp = 90}}
    print(c)
    print(d)
    d = {"seat", {cc = 1200}, [2, 2]}
    print(d.model, " ", d.motor, " ", d.seats)
    points: array[Point, 3] = [{1, 2}, {x = 3}, origin()]
    print(points)
    empty: Point = {}
    print(empty)
