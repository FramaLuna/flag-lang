shared context start:
    ready: Lock[i32]

func work(n: i64) -> i64:
    with lock(start.ready):
        start.ready.value += 1
    while true: # the 16 threads fail at once
        with lock(start.ready):
            if start.ready.value == 16:
                break
    xs: array[i64, 3]
    return xs[n]

func main():
    ts: &list[Thread[i64]] = heap([])
    defer free(ts)
    for i in 0..16:
        append(ts, parallel work(5))
    for t in ts:
        print(wait(t))
