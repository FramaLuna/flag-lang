type Start:
    lock: Lock
    ready: i32

start: Start

func work(n: i64) -> i64:
    with lock(start.lock):
        start.ready += 1
    while true: # the 16 threads fail at once
        with lock(start.lock):
            if start.ready == 16:
                break
    xs: array[i64, 3]
    return xs[n]

func main():
    ts: &list[Thread[i64]]
    defer free(ts)
    for i in 0..16:
        append(ts, parallel work(5))
    for t in ts:
        print(wait t)
