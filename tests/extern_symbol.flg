extern "c":
    func absolute(x: i64) -> i64 = "labs"
    func magnitude(x: i32) -> i32 = "abs"
    func magnitude(x: i64) -> i64 = "labs"
    func wait_child(status: *i32) -> i32 = "wait"

func main():
    print(absolute(-5), " ", magnitude(-7), " ", magnitude(i64(-9)))
    f: extern func(i64) -> i64 = magnitude
    print(f(-11), " ", f == absolute)
