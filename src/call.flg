@trust
func binary(o: &strview, a: Value, b: Value, at: usize) -> Value|Fail:
    l := a
    r := b
    if l.lit and r.lit and integer(l.type) and integer(r.type):
        nb := r.neg
        m: usize = 0
        negative := false
        overflow := false
        switch o:
        case "==", "!=", "<", "<=", ">", ">=":
            less := l.neg and not nb or l.neg and nb and l.n > r.n or not l.neg and not nb and l.n < r.n
            same := l.neg == nb and l.n == r.n
            switch o:
            case "==":
                return truth(same)
            case "!=":
                return truth(not same)
            case "<":
                return truth(less)
            case "<=":
                return truth(less or same)
            case ">":
                return truth(not less and not same)
            case:
                return truth(not less)
        case "+", "-":
            if o == "-":
                nb = not nb and r.n != 0
            if l.neg == nb:
                overflow = l.n > 0xffff_ffff_ffff_ffff - r.n
                m = l.n + r.n
                negative = nb
            elif l.n >= r.n:
                m = l.n - r.n
                negative = l.neg
            else:
                m = r.n - l.n
                negative = nb
        case "*":
            m = l.n * r.n
            overflow = l.n != 0 and m / l.n != r.n
            negative = l.neg != nb
        case "/", "%":
            if r.n == 0:
                return fail("division by zero", at)
            m = l.n / r.n
            negative = l.neg != nb
            if o == "%":
                m = l.n % r.n
                negative = l.neg
        case "<<", ">>":
            if nb or r.n > 63:
                sign: &strview
                if nb:
                    sign = "-"
                return fail("a shift expects an amount from 0 to 63, this one is " + sign + r.n, at)
            if o == "<<":
                overflow = l.n > 0xffff_ffff_ffff_ffff >> r.n
                m = l.n << r.n
                negative = l.neg
            elif l.neg:
                m = ((l.n - 1) >> r.n) + 1
                negative = true
            else:
                m = l.n >> r.n
        case:
            x := l.n
            if l.neg:
                x = 0 - x
            y := r.n
            if nb:
                y = 0 - y
            switch o:
            case "and":
                m = x and y
                negative = l.neg and nb
            case "or":
                m = x or y
                negative = l.neg or nb
            case:
                m = x xor y
                negative = l.neg != nb
            if negative:
                m = 0 - m
        if overflow or negative and m > 1 << 63:
            return fail("the result of this literal arithmetic does not fit in 64 bits", at)
        return literal(negative, m)
    if l.lit and r.lit and numeric(l.type) and numeric(r.type):
        x := real(l)
        y := real(r)
        switch o:
        case "+":
            return float_literal(x + y, at)
        case "-":
            return float_literal(x - y, at)
        case "*":
            return float_literal(x * y, at)
        case "/":
            return float_literal(x / y, at)
        case "==":
            return truth(x == y)
        case "!=":
            return truth(x != y)
        case "<":
            return truth(x < y)
        case "<=":
            return truth(x <= y)
        case ">":
            return truth(x > y)
        case ">=":
            return truth(x >= y)
    if l.lit and not r.lit and numeric(l.type) and numeric(r.type):
        l = try convert(l, r.type, Arg{}, at)
    if r.lit and not l.lit and numeric(r.type) and numeric(l.type):
        r = try convert(r, l.type, Arg{}, at)
    lt := comp.types[l.type]
    rt := comp.types[r.type]
    if numeric(l.type) and numeric(r.type) and l.type != r.type:
        return fail(o + " expects two numbers of one type but got " + lt.name + " and " + rt.name + ", convert one side with " + lt.name + "(...) or " + rt.name + "(...)", at)
    if o == "==" or o == "!=":
        c: &strview = "ceqw"
        if o == "!=":
            c = "cnew"
        if lt.kind == Union and rt.kind == Void and has(members(l.type), r.type):
            return Value{type = BOOL, at = op(W, c, tag(l), tag_of(r.type))}
        if rt.kind == Union and lt.kind == Void and has(members(r.type), l.type):
            return Value{type = BOOL, at = op(W, c, tag(r), tag_of(l.type))}
        if lt.kind == Union and lt.size == 4 and rt.kind == Union and rt.size == 4 and (within(l.type, r.type) or within(r.type, l.type)):
            return Value{type = BOOL, at = op(W, c, tag(l), tag(r))}
    k := lt.kind
    if l.type != r.type or not (k == Bool or k == Int or k == Uint or k == Float or k == Ptr or k == Func):
        return operate(o, l, r, at)
    x := load(l).at
    y := load(r).at
    name := native(o, k)
    if name.len == 0:
        return operate(o, l, r, at)
    if o == "==" or o == "!=" or o == "<" or o == "<=" or o == ">" or o == ">=":
        return Value{type = BOOL, at = op(W, cmp_name(name, l.type), x, y)}
    if (o == "<<" or o == ">>") and lt.size == 8:
        y = op1(W, "copy", y)
    if k != Float and (o == "/" or o == "%") and y.kind == Const and y.n == 0:
        return fail("division by zero", at)
    if k != Float and (o == "/" or o == "%") and y.kind == Temp:
        try panic_if(op(W, cmp_name("ceq", l.type), y, int_arg(0)), "division by zero", at)
    if k == Int and (name == "div" or name == "rem") and (y.kind == Temp or y.kind == Const and y.n == -1):
        slot := alloc(l.type)
        l_minus := label()
        l_plain := label()
        l_done := label()
        branch(op(W, cmp_name("ceq", l.type), y, int_arg(-1)), l_minus, l_plain)
        open_block(l_minus)
        if name == "div":
            store(l.type, Value{type = l.type, at = extend(l.type, op1(cls(l.type), "neg", x))}, slot)
        else:
            store(l.type, Value{type = l.type, at = int_arg(0)}, slot)
        jump(l_done)
        open_block(l_plain)
        store(l.type, Value{type = l.type, at = op(cls(l.type), name, x, y)}, slot)
        jump(l_done)
        open_block(l_done)
        return load(Value{type = l.type, at = slot, mem = true})
    return Value{type = l.type, at = extend(l.type, op(cls(l.type), name, x, y))}

func native(o: &strview, k: TypeKind) -> &strview:
    whole := k == Int or k == Uint
    arith := whole or k == Float
    scalar := arith or k == Bool or k == Ptr or k == Func
    switch o:
    case "==":
        if scalar:
            return "ceq"
    case "!=":
        if scalar:
            return "cne"
    case "<":
        if arith or k == Ptr:
            return "cslt"
    case "<=":
        if arith or k == Ptr:
            return "csle"
    case ">":
        if arith or k == Ptr:
            return "csgt"
    case ">=":
        if arith or k == Ptr:
            return "csge"
    case "+":
        if arith:
            return "add"
    case "-":
        if arith:
            return "sub"
    case "*":
        if arith:
            return "mul"
    case "/":
        if k == Uint:
            return "udiv"
        if arith:
            return "div"
    case "%":
        if k == Int:
            return "rem"
        if k == Uint:
            return "urem"
    case "and", "or", "xor":
        if whole or k == Bool:
            return o
    case "<<":
        if whole:
            return "shl"
    case ">>":
        if k == Int:
            return "sar"
        if k == Uint:
            return "shr"
    return ""

func panic_if(bad: Arg, message: &strview, at: usize) -> Fail?:
    l_bad := label()
    l_good := label()
    branch(bad, l_bad, l_good)
    open_block(l_bad)
    args: &list[Value]
    append(args, Value{type = try fat_type("strview", VOID, at), at = text_data(message), mem = true})
    try invoke("panic", args, at)
    terminate("hlt", Arg{})
    open_block(l_good)
    return null

func operate(o: &strview, l: Value, r: Value, at: usize) -> Value|Fail:
    name := o
    if o == "!=":
        name = "=="
    elif o == ">" or o == "<=" or o == ">=":
        name = "<"
    args: &list[Value]
    if o == ">" or o == "<=":
        append(args, r)
        append(args, l)
    else:
        append(args, l)
        append(args, r)
    v := try invoke(name, args, at)
    if o != "!=" and o != "<=" and o != ">=":
        return v
    if v.type != BOOL:
        return fail(o + " is the negation of " + name + ", which answers " + comp.types[v.type].name + " here instead of bool", at)
    return Value{type = BOOL, at = op(W, "xor", load(v).at, int_arg(1))}

func invoke(name: &strview, args: &list[Value], at: usize) -> Value|Fail:
    names: &list[&strview]
    return call(name, "", args, names, at)

func returned(name: &strview, args: &list[Value], at: usize) -> usize|Fail:
    names: &list[&strview]
    best := try choose(name, "", args, names, at)
    if best == 0:
        return VOID
    f := comp.syms[best].node
    saved := comp.frame
    comp.frame = comp.binds.len
    try bind(f, trust arrange(f, args.len, names), args)
    ret := result(f)
    comp.binds.len = comp.frame
    comp.frame = saved
    return ret

func call(name: &strview, module: &strview, args: &list[Value], names: &list[&strview], at: usize) -> Value|Fail:
    best := try choose(name, module, args, names, at)
    if best == 0 and name == "==" and args.len == 2 and args[0].type == args[1].type:
        k := comp.types[args[0].type].kind
        if k == Struct or k == Union or k == Void:
            return equal(args[0], args[1], at)
    if best == 0 and name == "hash" and args.len == 1:
        return hashed(args[0], at)
    if best == 0:
        for label in names:
            declared := label.len == 0
            s := first_sym(name)
            while s != 0 and not declared:
                f := comp.syms[s].node
                for k in 0..params(f):
                    declared = declared or callable(s, module, args, at) and text(kid(f, k)) == label
                s = comp.syms[s].next
            if not declared:
                return fail(name + " has no parameter named " + label, at)
        hint: &strview
        for a in args:
            if comp.types[a.type].kind == Union and comp.types[a.type].size > 4 and not is_letter(items(name)[0]):
                hint = ", a union is narrowed with is before its value is used"
        if name == "at" and args.len == 2 and integer(args[1].type):
            hint = ", an element is x[i] and a pointer to it is ptr(x[i])"
        failed := fail("no overload of " + name + " matches (" + listed(args) + ")" + hint, at)
        said: usize = 0
        s := first_sym(name)
        while s != 0 and hint.len == 0 and said < 4:
            if callable(s, module, args, at):
                said += 1
                decl := comp.nodes[comp.syms[s].node].tok
                note("an overload of " + name + " is declared here", comp.tokens[decl].at)
                if noted(at) and comp.tokens[comp.target].text == name:
                    mark(decl, header(decl))
            s = comp.syms[s].next
        return failed
    f := comp.syms[best].node
    if noted(at) and comp.tokens[comp.target].text == name:
        mark(comp.nodes[f].tok, header(comp.nodes[f].tok))
    order := trust arrange(f, args.len, names)
    saved := comp.frame
    comp.frame = comp.binds.len
    try bind(f, order, args)
    taken: &list[usize]
    for k in 0..order.len:
        append(taken, try resolve(kid(f, k) + 1))
    id := try instantiate(f, at)
    comp.binds.len = comp.frame
    comp.frame = saved
    foreign := body(f) == 0 or comp.insts[id].export
    passes: &list[Pass]
    for k in 0..order.len:
        if order[k] < args.len:
            append(passes, try hand(args[order[k]], taken[k], foreign, at))
        else:
            given := node_end(kid(f, k) + 1)
            aside := set_aside(0)
            site := comp.site
            comp.site = at
            append(passes, try hand(try gen(given, taken[k]), taken[k], foreign, source(given)))
            put_back(0, aside)
            comp.site = site
    if order.len < params(f):
        append(passes, Pass{})
        for k in order.len..args.len:
            v := args[k]
            t := comp.types[v.type]
            if aggregate(v.type) or t.kind == Void or t.kind == Func:
                return fail(name + " expects integers, floats, bool and pointers after its declared parameters but got " + t.name, at)
            x := load(v).at
            if v.type == F32:
                append(passes, Pass{D, op1(D, "exts", x), false})
            else:
                append(passes, Pass{cls(v.type), x, is_number(x)})
    return emit(global(comp.insts[id].name), passes, comp.insts[id].ret, foreign, at)

func choose(name: &strview, module: &strview, args: &list[Value], names: &list[&strview], at: usize) -> usize|Fail:
    key: &str
    key += name + "|" + module + "|" + file_of(at)
    for a in args:
        key += "|" + a.type
        if a.lit:
            key += " " + a.neg + " " + a.n
    for given in names:
        key += "|" + given
    known := get(comp.chosen, view(key))
    if known is usize:
        free(key)
        return known
    best: usize = 0
    best_score: i64 = -1
    best_near: usize = 0
    tied := false
    seen := false
    scores: &list[i64]
    here := comp.files[file_of(at)].module
    kept := false
    s := first_sym(name)
    while s != 0:
        kept = kept or comp.syms[s].priv and callable(s, module, args, at)
        s = comp.syms[s].next
    s = first_sym(name)
    while s != 0:
        f := comp.syms[s].node
        if callable(s, module, args, at):
            seen = true
            order := arrange(f, args.len, names)
            if order is &list[usize]:
                saved := comp.frame
                comp.frame = comp.binds.len
                score := try bind(f, order, args)
                comp.binds.len = comp.frame
                comp.frame = saved
                if score >= 0 and kept and comp.files[file_of(comp.tokens[comp.nodes[f].tok].at)].module == here:
                    score += PRIVATE
                append(scores, score)
                if score > best_score or score >= 0 and score == best_score and near(s, at) < best_near:
                    best = s
                    best_score = score
                    best_near = near(s, at)
                    tied = false
                elif score >= 0 and score == best_score and near(s, at) == best_near:
                    tied = true
        s = comp.syms[s].next
    if not seen and is_letter(items(name)[0]):
        try hidden(name, true, at)
        try hidden(name, false, at)
        if module.len == 0 and lookup(name) != 0:
            return fail(name + " is a variable of type " + comp.types[comp.vars[lookup(name) - 1].type].name + ", only a function value can be called", at)
        return fail("no function named " + name + " is visible here", at)
    if tied:
        failed := fail("ambiguous call to " + name + ", several overloads match (" + listed(args) + ") equally", at)
        k: usize = 0
        s = first_sym(name)
        while s != 0:
            if callable(s, module, args, at) and arrange(comp.syms[s].node, args.len, names) is &list[usize]:
                if scores[k] == best_score:
                    decl := comp.nodes[comp.syms[s].node].tok
                    note("an overload of " + name + " is declared here", comp.tokens[decl].at)
                    if noted(at) and comp.tokens[comp.target].text == name:
                        mark(decl, header(decl))
                k += 1
            s = comp.syms[s].next
        return failed
    put(comp.chosen, view(key), best)
    return best

func listed(args: &list[Value]) -> &str:
    shown: &str
    for a in args:
        if shown.len > 0:
            shown += ", "
        shown += brief(comp.types[a.type].name)
    return shown

func near(s: usize, at: usize) -> usize:
    if comp.syms[s].module == comp.files[file_of(at)].module:
        return 0
    if comp.syms[s].module.len == 0:
        return 1
    return 2

func hand(given: Value, to: usize, foreign: bool, at: usize) -> Pass|Fail:
    v := given
    if comp.types[to].kind == Ptr and comp.types[to].elem == given.type:
        for l in comp.vars:
            if l.bound != 0 and given.mem and l.addr.kind == given.at.kind and l.addr.n == given.at.n:
                return fail(l.name + " counts this loop, so a pointer to it is not taken on its own: write ptr(" + l.name + ")", at)
        if not given.mem and not aggregate(given.type):
            v.at = alloc(given.type)
            store(given.type, given, v.at)
        v = Value{type = to, at = v.at}
    else:
        v = try convert(given, to, Arg{}, at)
    how: u32 = L
    if foreign or comp.types[to].kind != Fat and not big(to):
        how = try passing(to, foreign, at)
    x := load(v).at
    if comp.types[to].kind == Func and x.kind != Global:
        try panic_if(op(W, "ceql", x, int_arg(0)), "an argument is an empty function value", at)
    return Pass{how, x, is_number(x)}

func emit(callee: Arg, passes: &list[Pass], ret: usize, foreign: bool, at: usize) -> Value|Fail:
    called := Ins{op = "call", a = callee, first = u32(comp.passes.len)}
    for p in passes:
        append(comp.passes, p)
    result := Arg{}
    if big(ret) and not foreign:
        result = alloc(ret)
        append(comp.passes, Pass{L, result, false})
    elif ret != VOID:
        called.cls = try passing(ret, foreign, at)
        result = temp()
        called.to = u32(result.n)
    called.count = u32(comp.passes.len) - called.first
    here := comp.at
    comp.at = at
    add(called)
    comp.at = here
    if foreign and ret != VOID and not aggregate(ret):
        result = extend(ret, result)
    return Value{type = ret, at = result, mem = aggregate(ret)}

func bind(f: usize, order: &list[usize], args: &list[Value]) -> i64|Fail:
    score: i64 = 0
    for round in 0..3:
        for k in 0..order.len:
            if order[k] < args.len and turn(args[order[k]]) == round:
                got := try match(kid(f, k) + 1, args[order[k]])
                if got < 0 or score < 0:
                    score = -1
                else:
                    score += got
    c := kid(f, params(f))
    while c < node_end(f) and score >= 0:
        if comp.nodes[c].kind == Where:
            choosing := comp.choosing
            comp.choosing = true
            kept := holds(c + 1)
            comp.choosing = choosing
            if kept is Fail:
                return Fail
            if not kept:
                score = -1
        c = node_end(c)
    return score

func turn(v: Value) -> i32:
    if v.type == NULL:
        return 2
    return i32(v.lit) + i32(v.lit and integer(v.type))

func arrange(f: usize, count: usize, names: &list[&strview]) -> &list[usize]?:
    fixed := params(f)
    variadic := fixed > 0 and text(kid(f, fixed - 1)) == ".."
    if variadic:
        fixed -= 1
    order: &list[usize]
    for k in 0..fixed:
        append(order, count)
    next: usize = 0
    for i in 0..count:
        named := i < names.len and names[i].len > 0
        slot := next
        if named:
            slot = fixed
            for k in 0..fixed:
                if text(kid(f, k)) == names[i]:
                    slot = k
        else:
            next += 1
        if named and (slot == fixed or variadic) or slot >= fixed and not variadic:
            return null
        if slot < fixed and order[slot] != count:
            return null
        if slot < fixed:
            order[slot] = i
    for k in 0..fixed:
        if order[k] == count and kids(kid(f, k)) == 1:
            return null
    return order

func passing(t: usize, foreign: bool, at: usize) -> u32|Fail:
    ty := comp.types[t]
    if foreign and ty.kind == Func:
        return fail(ty.name + " cannot cross the C ABI, C takes the address of an export func: declare the parameter as *bytes and pass ptr(name)", at)
    if foreign and aggregate(t):
        return c_type(t, at)
    if foreign and ty.size == 1 and ty.kind == Int:
        return SB
    if foreign and ty.size == 1:
        return UB
    if foreign and ty.size == 2 and ty.kind == Int:
        return SH
    if foreign and ty.size == 2:
        return UH
    return cls(t)

func c_type(t: usize, at: usize) -> u32|Fail:
    ty := comp.types[t]
    if has(comp.c_types, t):
        return CAGG + u32(t)
    if ty.kind != Struct and ty.kind != Untagged:
        return fail(ty.name + " cannot cross the C ABI, only integers, floats, bool, pointers, structs and untagged unions of them do", at)
    if ty.packed:
        return fail(ty.name + " cannot cross the C ABI by value, it is packed: pass a pointer", at)
    fields: &str
    for i in 0..ty.count:
        item := comp.items[ty.first + i]
        e := item.type
        count: usize = 1
        if comp.types[e].kind == Array:
            count = comp.types[e].count
            e = comp.types[e].elem
        k := comp.types[e].kind
        one: &str
        if item.shared:
            return fail(ty.name + " cannot cross the C ABI by value, its field " + item.name + " shares storage: pass a pointer, or declare that part as an untagged union", at)
        elif comp.types[e].size == 0:
            continue
        elif k == Struct or k == Untagged:
            one += ":c" + (try c_type(e, at) - CAGG)
        elif k == Bool or comp.types[e].size == 1 and integer(e):
            one += "b"
        elif comp.types[e].size == 2 and integer(e):
            one += "h"
        elif cls(e) == S:
            one += "s"
        elif cls(e) == D:
            one += "d"
        elif cls(e) == L and k != Func:
            one += "l"
        elif numeric(e) or k == Ptr:
            one += "w"
        else:
            return fail(ty.name + " cannot cross the C ABI, it holds " + comp.types[item.type].name, at)
        one += " " + count
        if ty.kind == Untagged:
            fields += "{ " + one + " } "
        else:
            fields += one + ", "
    append(comp.c_types, t)
    comp.c_defs += "type :c" + t + " = { " + fields + "}\n"
    return CAGG + u32(t)

func match(n: usize, v: Value) -> i64|Fail:
    node := comp.nodes[n]
    tok := comp.tokens[node.tok]
    t := comp.types[v.type]
    if node.kind == TName and tok.kind == Generic:
        b := bound(tok.text)
        if b == 0:
            append(comp.binds, Item{tok.text, v.type, 0, false})
            return 0
        if comp.binds[b - 1].type == v.type:
            return 0
        return accepts(comp.binds[b - 1].type, v)
    if not generic(n):
        score := accepts(try resolve(n), v)
        if score < 0 and node.kind == TUnary and tok.text == "*" and try resolve(n + 1) == v.type:
            return STEP
        return score
    if node.kind == TUnion or node.kind == TUnary and tok.text == "?":
        concrete: &list[usize]
        binder: usize = 0
        if node.kind == TUnary:
            append(concrete, NULL)
        c := n + 1
        while c < node_end(n):
            if binder == 0 and generic(c):
                binder = c
            elif generic(c):
                return -1
            else:
                for m in members(try resolve(c)):
                    append(concrete, m)
            c = node_end(c)
        rest: &list[usize]
        for m in members(v.type):
            if not has(concrete, m):
                append(rest, m)
        if rest.len == 0:
            for i in binder..node_end(binder):
                if comp.tokens[comp.nodes[i].tok].kind == Generic and bound(text(i)) == 0:
                    return -1
            return STEP
        inner := try match(binder, Value{type = try union_of(rest, Union, tok.at), at = v.at})
        if inner < 0 or accepts(try resolve(n), v) < 0:
            return -1
        return inner + STEP
    if node.kind == TUnary and tok.text == "*":
        if t.kind == Ptr:
            inner := try match(n + 1, Value{type = t.elem, at = v.at})
            if inner < 0:
                return -1
            return inner + STEP
        pointee := comp.nodes[n + 1]
        if pointee.kind == TName and comp.tokens[pointee.tok].kind == Generic:
            return -1
        inner := try match(n + 1, v)
        if inner < STEP or try resolve(n + 1) != v.type:
            return -1
        return inner - STEP
    if node.kind == TFunc:
        if t.kind != Func or t.count != params(n) or t.count + usize(t.elem != VOID) != kids(n):
            return -1
        score: i64 = STEP
        for k in 0..kids(n):
            part := Value{type = t.elem}
            if k < t.count:
                part.type = comp.items[t.first + k].type
            inner := try match(kid(n, k) + usize(k < t.count), part)
            if inner < 0:
                return -1
            score += inner
        if try resolve(n) != v.type:
            return -1
        return score
    fat := node.kind == TUnary and tok.text == "&"
    head := n + usize(fat)
    spreads := fat and t.kind == Ptr and comp.types[t.elem].kind == Array
    if comp.nodes[head].kind != TName:
        return -1
    s := try find_type(text(head), comp.nodes[head].module, comp.tokens[comp.nodes[head].tok].at)
    if s != 0 and not fat and kids(head) > 0 and comp.nodes[comp.syms[s].node].kind == Alias:
        alias := comp.syms[s].node
        if type_params(alias) != kids(head) or has(comp.resolving, alias):
            return -1
        before := comp.nodes.len
        append(comp.resolving, alias)
        score := try match(expand(kid(alias, type_params(alias)), alias, head), v)
        comp.resolving.len -= 1
        comp.nodes.len = before
        return score
    if fat != (t.kind == Fat) and not spreads:
        return -1
    if text(head) == "array" and comp.nodes[head].module.len == 0:
        if t.kind != Array or not try arg_fits(kid(head, 1), VOID, t.count):
            return -1
        inner := try match(head + 1, Value{type = t.elem, at = v.at})
        if inner < 0:
            return -1
        return inner + STEP
    if spreads:
        if s == 0 or kids(head) != 1:
            return -1
        inner := try match(head + 1, Value{type = comp.types[t.elem].elem, at = v.at})
        if inner < 0 or not spread(v.type, try resolve(n)):
            return -1
        return inner + 1
    if s == 0 or kids(head) == 0 or t.decl != comp.syms[s].node and (not fat or type_params(t.decl) != kids(head)):
        return -1
    score: i64 = STEP
    c := head + 1
    i: usize = 0
    while c < node_end(head):
        arg := comp.items[t.args + i]
        if arg.type == VOID or comp.nodes[c].kind == Literal:
            if not try arg_fits(c, arg.type, arg.n):
                return -1
        else:
            inner := try match(c, Value{type = arg.type, at = v.at})
            if inner < 0:
                return -1
            score += inner
        c = node_end(c)
        i += 1
    if t.decl != comp.syms[s].node:
        if not prefix(v.type, try resolve(n)):
            return -1
        score -= STEP - 1
    return score

func expand(n: usize, alias: usize, given: usize) -> usize:
    made := comp.nodes.len
    for k in 0..type_params(alias):
        if comp.nodes[n].size == 1 and comp.tokens[comp.nodes[n].tok].kind == Generic and text(n) == text(kid(alias, k)):
            for i in kid(given, k)..node_end(kid(given, k)):
                append(comp.nodes, comp.nodes[i])
            return made
    append(comp.nodes, comp.nodes[n])
    c := n + 1
    while c < node_end(n):
        expand(c, alias, given)
        c = node_end(c)
    comp.nodes[made].size = comp.nodes.len - made
    return made

func prefix(from: usize, to: usize) -> bool:
    a := comp.types[from]
    b := comp.types[to]
    if a.kind != Fat or b.kind != Fat or from == to or b.count > a.count or type_params(a.decl) != type_params(b.decl):
        return false
    for i in 0..type_params(a.decl):
        if comp.items[a.args + i].type != comp.items[b.args + i].type or comp.items[a.args + i].n != comp.items[b.args + i].n:
            return false
    for i in 0..b.count:
        if comp.items[a.first + i].name != comp.items[b.first + i].name or comp.items[a.first + i].type != comp.items[b.first + i].type:
            return false
    return true

func arg_fits(n: usize, t: usize, value: usize) -> bool|Fail:
    if t != VOID:
        return false
    count := try count_of(n)
    if count is usize:
        return count == value
    tok := comp.tokens[comp.nodes[n].tok]
    if tok.kind != Generic or bound(tok.text) != 0:
        return false
    append(comp.binds, Item{tok.text, VOID, value, false})
    return true

func generic(n: usize) -> bool:
    i := n
    while i < node_end(n):
        k := comp.nodes[i].kind
        if k == Field or k == Where or k == Block:
            i = node_end(i)
        elif comp.tokens[comp.nodes[i].tok].kind == Generic:
            return true
        else:
            i += 1
    return false

func accepts(to: usize, v: Value) -> i64:
    if to == v.type:
        return 2 * STEP
    if prefix(v.type, to) or spread(v.type, to):
        return STEP
    target := comp.types[to]
    if v.lit and integer(v.type) and integer(to):
        if fits(v, to):
            return STEP
        return -1
    if v.lit and comp.types[v.type].kind == Float and target.kind == Float:
        return STEP
    if v.lit and integer(v.type) and target.kind == Float:
        return STEP * i64(to == F64)
    if (v.lit or comp.types[v.type].name == "&str") and comp.types[v.type].kind == Fat and target.kind == Ptr and target.elem == U8:
        return STEP
    if v.lit and numeric(v.type) and (target.kind == Union or target.kind == Untagged):
        for i in 0..target.count:
            if accepts(comp.items[target.first + i].type, v) >= 0:
                return STEP
    if untagged_member(to, v.type) or untagged_member(v.type, to):
        return STEP
    if target.kind == Union and within(v.type, to):
        return STEP
    return -1

func fits(v: Value, t: usize) -> bool:
    if comp.types[t].kind == Uint:
        return not v.neg and v.n <= largest(t)
    if v.neg:
        return v.n <= largest(t) + 1
    return v.n <= largest(t)

func largest(t: usize) -> usize:
    bits := comp.types[t].size * 8
    if comp.types[t].kind == Int:
        bits -= 1
    if bits == 64:
        return 0xffff_ffff_ffff_ffff
    return (usize(1) << bits) - 1

func convert(v: Value, to: usize, dest: Arg, at: usize) -> Value|Fail:
    if v.type == to:
        return v
    if prefix(v.type, to):
        slot := alloc(to)
        blit(v.at, slot, to)
        return Value{type = to, at = slot, mem = true}
    if spread(v.type, to):
        slot := dest
        if slot.kind == Empty:
            slot = alloc(to)
        zero(to, slot)
        if comp.types[v.type].kind == Ptr:
            store(v.type, v, slot)
            count: usize = 0
            if comp.types[v.type].elem != EMPTYARRAY:
                count = comp.types[comp.types[v.type].elem].count
            for i in 0..comp.types[to].count:
                field := comp.items[comp.types[to].first + i]
                if field.name == "len" or field.name == "cap":
                    store(USIZE, Value{type = USIZE, at = int_arg(i64(count))}, offset(slot, field.n))
        return Value{type = to, at = slot, mem = true}
    from := comp.types[v.type]
    target := comp.types[to]
    if v.lit and integer(v.type) and integer(to):
        if fits(v, to):
            return Value{type = to, at = v.at}
        shown: &str
        if v.neg:
            shown += "-"
        shown += v.n
        if v.neg and target.kind == Uint:
            return fail(shown + " does not fit in " + target.name + ", the smallest " + target.name + " is 0", at)
        return fail(shown + " does not fit in " + target.name + ", the largest " + target.name + " is " + largest(to), at)
    if v.lit and numeric(v.type) and target.kind == Float:
        x := real(v)
        if to == F32 and f32(x) - f32(x) != 0.0:
            return fail(x + " does not fit in f32", at)
        f := try float_literal(x, at)
        if to == F32:
            f.at.kind = Single
        return Value{type = to, at = f.at}
    if v.lit and from.kind == Fat and target.kind == Ptr and target.elem == U8:
        return Value{type = to, at = op1(L, "loadl", v.at)}
    if from.name == "&str" and target.kind == Ptr and target.elem == U8:
        args: &list[Value]
        append(args, v)
        return invoke("c_text", args, at)
    if v.lit and numeric(v.type) and (target.kind == Union or target.kind == Untagged) and not has(members(to), v.type) and not untagged_member(to, v.type):
        found: usize = VOID
        tied: usize = VOID
        best: i64 = -1
        for i in 0..target.count:
            m := comp.items[target.first + i].type
            score := accepts(m, v)
            if score > best:
                found = m
                tied = VOID
                best = score
            elif score == best and score >= 0:
                tied = m
        if tied != VOID:
            shown: &str
            if v.neg:
                shown += "-"
            if comp.types[v.type].kind == Float:
                shown += v.f
            else:
                shown += v.n
            return fail(shown + " fits more than one member of " + target.name + " equally, name its type: " + comp.types[found].name + "(" + shown + ")", at)
        if found != VOID:
            return convert(try convert(v, found, Arg{}, at), to, dest, at)
    if target.kind == Untagged and untagged_member(to, v.type):
        slot := alloc(to)
        zero(to, slot)
        store(v.type, v, slot)
        return Value{type = to, at = slot, mem = true}
    if from.kind == Untagged and untagged_member(v.type, to):
        return Value{type = to, at = v.at, mem = true, place = v.place}
    if widens(v.type, to):
        x := load(v).at
        if target.size == 8 and from.kind == Int:
            x = op1(L, "extsw", x)
        elif target.size == 8:
            x = op1(L, "extuw", x)
        return Value{type = to, at = x}
    if target.kind == Union and within(v.type, to):
        slot := alloc(to)
        if from.kind == Union:
            blit(v.at, slot, v.type)
        else:
            add(Ins{op = "storew", a = tag_of(v.type), b = slot})
            store(v.type, v, payload(slot, v.type))
        return Value{type = to, at = slot, mem = true}
    args: &list[Value]
    append(args, Value{type = to, at = dest, mem = true})
    append(args, v)
    if try offers("=", args, at):
        if dest.kind == Empty:
            args[0].at = alloc(to)
            zero(to, args[0].at)
        return invoke("=", args, at)
    if from.kind == Union:
        current := tag(v)
        slot := alloc(to)
        l_done := label()
        for m in members(v.type):
            l_arm := label()
            l_next := label()
            branch(op(W, "ceqw", current, tag_of(m)), l_arm, l_next)
            open_block(l_arm)
            store(to, try convert(Value{type = m, at = payload(v.at, m), mem = true}, to, dest, at), slot)
            jump(l_done)
            open_block(l_next)
        terminate("hlt", Arg{})
        open_block(l_done)
        return Value{type = to, at = slot, mem = true}
    return fail("cannot assign " + from.name + " to " + target.name, at)

func spread(from: usize, to: usize) -> bool:
    target := comp.types[to]
    if target.kind != Fat:
        return false
    elem := element(to)
    if from == EMPTYMAP:
        return text(target.decl) == "map"
    if from == EMPTYARRAY:
        return elem != VOID
    source := comp.types[from]
    if source.kind != Ptr or elem == VOID:
        return false
    return source.elem == EMPTYARRAY or comp.types[source.elem].kind == Array and comp.types[source.elem].elem == elem

func element(fat: usize) -> usize:
    params := type_params(comp.types[fat].decl)
    if params == 0:
        return U8
    if params == 1:
        return comp.items[comp.types[fat].args].type
    return VOID

func within(part: usize, whole: usize) -> bool:
    all := members(whole)
    i: usize = 0
    for m in members(part):
        while i < all.len and all[i] < m:
            i += 1
        if i == all.len or all[i] != m:
            return false
    return true

func untagged_member(t: usize, m: usize) -> bool:
    if comp.types[t].kind != Untagged:
        return false
    for i in 0..comp.types[t].count:
        if comp.items[comp.types[t].first + i].type == m:
            return true
    return false

func widens(from: usize, to: usize) -> bool:
    a := comp.types[from]
    b := comp.types[to]
    return integer(from) and integer(to) and b.size > a.size and (a.kind == b.kind or a.kind == Uint)

func offers(name: &strview, args: &list[Value], at: usize) -> bool|Fail:
    names: &list[&strview]
    return try choose(name, "", args, names, at) != 0

func noted(at: usize) -> bool:
    return comp.asked and comp.tokens[comp.target].at == at

func described(name: &strview, t: usize) -> &strview:
    out: &str
    out += name + ": " + comp.types[t].name
    return view(out)

func callable(s: usize, module: &strview, args: &list[Value], at: usize) -> bool:
    sym := comp.syms[s]
    if comp.nodes[sym.node].kind != Func:
        return false
    if visible(s, module, at):
        return true
    if module.len > 0 or sym.priv:
        return false
    for a in args:
        t := a.type
        while comp.types[t].kind == Ptr:
            t = comp.types[t].elem
        for m in members(t):
            if sym.module == comp.files[file_of(comp.tokens[comp.nodes[comp.types[m].decl].tok].at)].module:
                return true
    return false

func holds(n: usize) -> bool|Fail:
    try deeper(source(n))
    defer comp.depth -= 1
    node := comp.nodes[n]
    o := text(n)
    left := n + 1
    if node.kind == Unary and o == "not":
        return not try holds(left)
    if node.kind == Call and o == "can_assign" and kids(n) == 2:
        return assignable(try resolve(left), try resolve(node_end(left)), source(n))
    if node.kind == Binary and (o == "and" or o == "or"):
        chain: &list[usize]
        c := n
        while comp.nodes[c].kind == Binary and (text(c) == "and" or text(c) == "or"):
            append(chain, c)
            c += 1
        result := try holds(c)
        for k in reverse chain:
            other := try holds(node_end(k + 1))
            if text(k) == "and":
                result = result and other
            else:
                result = result or other
        return result
    if node.kind == Binary and o == "is":
        return within(try resolve(left), try resolve(node_end(left)))
    if node.kind == Binary and (o == "==" or o == "!="):
        b := bound(text(left))
        if b == 0:
            b = bound(text(node_end(left)))
        if b != 0 and comp.binds[b - 1].type != VOID:
            return (try resolve(left) == try resolve(node_end(left))) == (o == "==")
    v := try gen(n, VOID)
    if v.type != BOOL or not v.lit:
        return fail("a where compares types and numbers known when the call is chosen, this one is not", source(n))
    return v.n == 1

func assignable(to: usize, from: usize, at: usize) -> bool|Fail:
    v := Value{type = from}
    args: &list[Value]
    append(args, Value{type = to, mem = true})
    append(args, v)
    if accepts(to, v) >= 0 or widens(from, to) or try offers("=", args, at):
        return true
    if comp.types[from].kind != Union:
        return false
    for m in members(from):
        if not try assignable(to, m, at):
            return false
    return true

func convert_number(v: Value, to: usize, at: usize) -> Value|Fail:
    from := comp.types[v.type]
    target := comp.types[to]
    if not numeric(v.type) and from.kind != Bool:
        return fail(target.name + "() converts numbers, " + from.name + " is not one", at)
    if v.lit and (integer(v.type) or target.kind == Float):
        typed := try convert(v, to, Arg{}, at)
        typed.lit = false
        return typed
    if v.type == to:
        return v
    x := load(v).at
    if from.kind == Float and target.kind == Float:
        if to == F64:
            return Value{type = to, at = op1(D, "exts", x)}
        return Value{type = to, at = op1(S, "truncd", x)}
    if from.kind == Float:
        wide := x
        if from.size == 4:
            wide = op1(D, "exts", x)
        top := Arg{Double, f64(largest(to)) as i64}
        bottom := Arg{Double, 0.0 as i64}
        low: i64 = 0
        if target.kind == Int:
            low = 0 - i64(largest(to)) - 1
            bottom = Arg{Double, f64(low) as i64}
        name: &strview = "dtoui"
        if target.kind == Int:
            name = "dtosi"
        slot := alloc(to)
        zero(to, slot)
        l_number := label()
        l_high := label()
        l_low := label()
        l_below := label()
        l_inside := label()
        l_done := label()
        branch(op(W, "ceqd", wide, wide), l_number, l_done)
        open_block(l_number)
        branch(op(W, "cged", wide, top), l_high, l_low)
        open_block(l_high)
        store(to, Value{type = to, at = int_arg(i64(largest(to)))}, slot)
        jump(l_done)
        open_block(l_low)
        branch(op(W, "cled", wide, bottom), l_below, l_inside)
        open_block(l_below)
        store(to, Value{type = to, at = int_arg(low)}, slot)
        jump(l_done)
        open_block(l_inside)
        store(to, Value{type = to, at = extend(to, op1(cls(to), name, wide))}, slot)
        jump(l_done)
        open_block(l_done)
        return load(Value{type = to, at = slot, mem = true})
    if target.kind == Float:
        if from.kind == Uint and from.size == 4:
            return Value{type = to, at = op1(cls(to), "ultof", op1(L, "extuw", x))}
        name: &str = "u"
        if from.kind == Int:
            name = "s"
        if from.size == 8:
            name += "ltof"
        else:
            name += "wtof"
        return Value{type = to, at = op1(cls(to), view(name), x)}
    if target.size == 8 and from.size < 8:
        if from.kind == Int:
            return Value{type = to, at = op1(L, "extsw", x)}
        return Value{type = to, at = op1(L, "extuw", x)}
    if target.size < 8 and from.size == 8:
        x = op1(W, "copy", x)
    return Value{type = to, at = extend(to, x)}

func assign(addr: Arg, t: usize, v: Value, at: usize) -> Fail?:
    if comp.types[t].kind == Fat and comp.types[v.type].kind == Ptr and (comp.types[v.type].elem == BYTES or comp.types[v.type].elem == element(t)):
        store(v.type, v, addr)
        return null
    converted := try convert(v, t, addr, at)
    if not converted.mem or converted.at.kind != addr.kind or converted.at.n != addr.n:
        store(t, converted, addr)
    return null
