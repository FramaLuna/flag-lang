@trust
func binary(o: &strview, l: Value, r: Value, at: i64) -> Value|Fail:
    if l.lit and r.lit and integer(l.type) and integer(r.type):
        nb := r.neg
        m: u64 = 0
        negative := false
        overflow := false
        switch o:
        case "==", "!=", "<", "<=", ">", ">=":
            less := l.neg and not nb or l.neg and nb and l.n > r.n or not l.neg and not nb and l.n < r.n
            same := l.neg == nb and l.n == r.n
            switch o:
            case "==":
                return truth(same)
            case "!=":
                return truth(not same)
            case "<":
                return truth(less)
            case "<=":
                return truth(less or same)
            case ">":
                return truth(not less and not same)
            case:
                return truth(not less)
        case "+", "-":
            if o == "-":
                nb = not nb and r.n != 0
            if l.neg == nb:
                overflow = l.n > 0xffff_ffff_ffff_ffff - r.n
                m = l.n + r.n
                negative = nb
            elif l.n >= r.n:
                m = l.n - r.n
                negative = l.neg
            else:
                m = r.n - l.n
                negative = nb
        case "*":
            m = l.n * r.n
            overflow = l.n != 0 and m / l.n != r.n
            negative = l.neg != nb
        case "/", "%":
            if r.n == 0:
                return fail("division by zero", at)
            m = l.n / r.n
            negative = l.neg != nb
            if o == "%":
                m = l.n % r.n
                negative = l.neg
        case "<<", ">>":
            if nb or r.n > 63:
                sign: &strview
                if nb:
                    sign = "-"
                return fail("shift count must be between 0 and 63, got " + sign + r.n, at)
            if o == "<<":
                overflow = l.n > 0xffff_ffff_ffff_ffff >> r.n
                m = l.n << r.n
                negative = l.neg
            elif l.neg:
                m = ((l.n - 1) >> r.n) + 1
                negative = true
            else:
                m = l.n >> r.n
        case:
            x := l.n
            if l.neg:
                x = 0 - x
            y := r.n
            if nb:
                y = 0 - y
            switch o:
            case "and":
                m = x and y
                negative = l.neg and nb
            case "or":
                m = x or y
                negative = l.neg or nb
            case:
                m = x xor y
                negative = l.neg != nb
            if negative:
                m = 0 - m
        if overflow or negative and m > 1 << 63:
            return fail("constant integer expression overflows 64 bits", at)
        return literal(negative, m)
    if l.lit and r.lit and numeric(l.type) and numeric(r.type):
        x := real(l)
        y := real(r)
        switch o:
        case "+", "-", "*", "/":
            z := x + y if o == "+" else x - y if o == "-" else x * y if o == "*" else x / y
            if z - z != 0.0 and x - x == 0.0 and y - y == 0.0:
                return fail("constant floating-point expression is not finite; write 'inf' or 'nan' explicitly", at)
            return float_literal(z)
        case "==":
            return truth(x == y)
        case "!=":
            return truth(x != y)
        case "<":
            return truth(x < y)
        case "<=":
            return truth(x <= y)
        case ">":
            return truth(x > y)
        case ">=":
            return truth(x >= y)
    compares := o == "==" or o == "!=" or o == "<" or o == "<=" or o == ">" or o == ">="
    if (comp.types[l.type].kind == Simd or comp.types[r.type].kind == Simd) and not try offers(o, ptr([l, r]), at):
        sides: &list[Value] = heap([])
        append(sides, l)
        append(sides, r)
        t := l.type
        if comp.types[t].kind != Simd:
            t = r.type
        lane := lane_value(t)
        shown := comp.types[t].name
        shift := o == "<<" or o == ">>"
        bits := o == "and" or o == "or" or o == "xor"
        if lane == BOOL and shift:
            return fail("'" + o + "' requires integer simd lanes, not mask " + shown, at)
        if lane == BOOL and not bits and o != "==" and o != "!=":
            return fail("'" + o + "' requires numeric simd lanes, not mask " + shown, at)
        if (bits or shift) and comp.types[lane].kind == Float:
            return fail("'" + o + "' requires integer simd lanes, not float simd " + shown + "; reinterpret bits with: as simd[u" + 8 * comp.types[lane].size + ", " + comp.types[t].count + "]", at)
        try simd_args(o, sides, at)
        if shift and (sides[0].type != t or sides[1].type == t):
            return fail("'" + o + "' shifts all simd lanes by a single scalar count on the right", at)
        if (o == "/" or o == "%") and integer(lane):
            return fail("'" + o + "' is not supported on integer simd (" + comp.types[lane].name + " lanes) because hardware lacks integer vector division; convert to an array instead", at)
        if o == "%":
            return fail("'%' requires integer simd lanes, not float simd " + shown, at)
        if compares:
            t = try mask_of(t, at)
        return lanes(o, sides, t, at)
    if (o == "==" or o == "!=") and comp.types[l.type].kind == Array and holds_lanes(l.type):
        return fail("cannot compare " + comp.types[l.type].name + " directly because simd '==' produces a lane mask; compare elements with all(a[i] == b[i])", at)
    amount := (o == "<<" or o == ">>") and integer(l.type) and integer(r.type)
    if l.lit and not r.lit and numeric(l.type) and numeric(r.type) and (integer(l.type) or not integer(r.type)): # a float literal is not an integer
        l = try convert(l, r.type, Arg{}, at)
    if r.lit and not l.lit and numeric(r.type) and numeric(l.type) and (integer(r.type) or not integer(l.type)) and not amount:
        r = try convert(r, l.type, Arg{}, at)
    lt := comp.types[l.type]
    rt := comp.types[r.type]
    bytes := lt.kind == Ptr and lt.elem == BYTES
    if bytes and (o == "+" or o == "-") and integer(r.type):
        return Value{type = l.type, at = op(L, native(o, Int), load(l).at, load(try convert_number(r, I64, at)).at)}
    if bytes and o == "-" and r.type == l.type:
        return Value{type = I64, at = add(Ins{op = "sub", cls = L, to = u32(temp().n), a = load(l).at, b = load(r).at, number = true})}
    if integer(l.type) and integer(r.type) and l.type != r.type and not amount:
        if widens(l.type, r.type):
            return binary(o, try convert(l, r.type, Arg{}, at), r, at)
        if widens(r.type, l.type):
            return binary(o, l, try convert(r, l.type, Arg{}, at), at)
        if not compares:
            return fail("cannot apply '" + o + "' to " + lt.name + " and " + rt.name + " because neither type contains all values of the other; convert one side with " + lt.name + "(...) or " + rt.name + "(...)", at)
        if lt.size < 8 and rt.size < 8:
            return binary(o, try convert(l, I64, Arg{}, at), try convert(r, I64, Arg{}, at), at)
        unsigned := r.type
        signed := l
        if rt.kind == Int:
            unsigned = l.type
            signed = r
        raw := try binary(o, try convert_number(l, unsigned, at), try convert_number(r, unsigned, at), at)
        if lt.kind != Int and rt.kind != Int:
            return raw
        if o == "!=" or o != "==" and (signed.type == l.type) == (o == "<" or o == "<="):
            return binary("or", try binary("<", try convert(signed, I64, Arg{}, at), literal(false, 0), at), raw, at)
        return binary("and", try binary(">=", try convert(signed, I64, Arg{}, at), literal(false, 0), at), raw, at)
    if numeric(l.type) and numeric(r.type) and l.type != r.type and not amount:
        return fail("'" + o + "' requires operands of the same numeric type, got " + lt.name + " and " + rt.name + "; convert one side with " + lt.name + "(...) or " + rt.name + "(...)", at)
    if (o == "and" or o == "or" or o == "xor") and (integer(l.type) and r.type == BOOL or l.type == BOOL and integer(r.type)):
        return fail("'" + o + "' requires two integers or two bools, got " + lt.name + " and " + rt.name, at)
    if o == "==" or o == "!=":
        c: &strview = "ceqw"
        if o == "!=":
            c = "cnew"
        if lt.kind == Union and rt.kind == Void and contains(members(l.type), r.type):
            return Value{type = BOOL, at = op(W, c, tag(l), tag_of(r.type))}
        if rt.kind == Union and lt.kind == Void and contains(members(r.type), l.type):
            return Value{type = BOOL, at = op(W, c, tag(r), tag_of(l.type))}
        if lt.kind == Union and lt.size == 4 and rt.kind == Union and rt.size == 4 and (within(l.type, r.type) or within(r.type, l.type)):
            return Value{type = BOOL, at = op(W, c, tag(l), tag(r))}
        empty := r.type
        whole := l.type
        if rt.kind != Void:
            empty = l.type
            whole = r.type
        if comp.types[empty].kind == Void and not contains(members(whole), empty) and o == "==":
            return fail(comp.types[whole].name + " can never be " + comp.types[empty].name + "; this comparison is always false", at)
        if comp.types[empty].kind == Void and not contains(members(whole), empty):
            return fail(comp.types[whole].name + " can never be " + comp.types[empty].name + "; this comparison is always true", at)
    k := lt.kind
    if l.type != r.type and not amount or not (k == Bool or k == Int or k == Uint or k == Float or k == Ptr or k == Func):
        return operate(o, l, r, at)
    x := load(l).at
    y := load(r).at
    name := native(o, k)
    if name.len == 0:
        return operate(o, l, r, at)
    if compares:
        return Value{type = BOOL, at = op(W, cmp_name(name, l.type), x, y)}
    if amount and rt.size == 8:
        y = op1(W, "copy", y)
    if k != Float and (o == "/" or o == "%") and y.kind == Const and y.n == 0:
        return fail("division by zero", at)
    if k != Float and (o == "/" or o == "%") and y.kind == Temp:
        try panic_if(op(W, cmp_name("ceq", l.type), y, int_arg(0)), "division by zero", at)
    if k == Int and (name == "div" or name == "rem") and (y.kind == Temp or y.kind == Const and y.n == -1 and x.kind == Temp):
        slot := alloc(l.type)
        l_minus := label()
        l_plain := label()
        l_done := label()
        branch(op(W, cmp_name("ceq", l.type), y, int_arg(-1)), l_minus, l_plain)
        open_block(l_minus)
        if name == "div":
            store(l.type, Value{type = l.type, at = extend(l.type, op1(cls(l.type), "neg", x))}, slot)
        else:
            store(l.type, Value{type = l.type, at = int_arg(0)}, slot)
        jump(l_done)
        open_block(l_plain)
        store(l.type, Value{type = l.type, at = op(cls(l.type), name, x, y)}, slot)
        jump(l_done)
        open_block(l_done)
        return load(Value{type = l.type, at = slot, mem = true})
    return Value{type = l.type, at = extend(l.type, op(cls(l.type), name, x, y))}

# the simd among args, where a literal beside it takes the type of its lanes
func simd_args(o: &strview, args: &listview[Value], at: i64) -> i64|Fail:
    t := VOID
    for a in args:
        if t == VOID and comp.types[a.type].kind == Simd:
            t = a.type
    lane := lane_value(t)
    for k in 0..args.len:
        a := args[k]
        given := comp.types[a.type]
        if given.kind == Simd and a.type != t:
            return fail("'" + o + "' requires two simd values of the same type, got " + comp.types[t].name + " and " + given.name + "; convert one side with " + comp.types[t].name + "(...) or " + given.name + "(...)", at)
        if a.lit and numeric(a.type) and numeric(lane):
            args[k] = try convert(a, lane, Arg{}, at)
        elif a.type != t and a.type != lane:
            hint: &strview
            if numeric(a.type):
                hint = "; convert it with " + comp.types[lane].name + "(...)"
            elif given.kind == Array:
                hint = "; convert it with " + comp.types[t].name + "([...])"
            return fail("'" + o + "' expects " + comp.types[t].name + " or " + comp.types[lane].name + " alongside " + comp.types[t].name + ", got " + given.name + hint, at)
    return t

func native(o: &strview, k: TypeKind) -> &strview:
    whole := k == Int or k == Uint
    arith := whole or k == Float
    scalar := arith or k == Bool or k == Ptr or k == Func
    switch o:
    case "==":
        if scalar:
            return "ceq"
    case "!=":
        if scalar:
            return "cne"
    case "<":
        if arith or k == Ptr:
            return "cslt"
    case "<=":
        if arith or k == Ptr:
            return "csle"
    case ">":
        if arith or k == Ptr:
            return "csgt"
    case ">=":
        if arith or k == Ptr:
            return "csge"
    case "+":
        if arith:
            return "add"
    case "-":
        if arith:
            return "sub"
    case "*":
        if arith:
            return "mul"
    case "/":
        if k == Uint:
            return "udiv"
        if arith:
            return "div"
    case "%":
        if k == Int:
            return "rem"
        if k == Uint:
            return "urem"
    case "and", "or", "xor":
        if whole or k == Bool:
            return o
    case "<<":
        if whole:
            return "shl"
    case ">>":
        if k == Int:
            return "sar"
        if k == Uint:
            return "shr"
    return ""

func panic_if(bad: Arg, message: &strview, at: i64) -> Fail?:
    l_bad := label()
    l_good := label()
    branch(bad, l_bad, l_good)
    open_block(l_bad)
    args: &list[Value] = heap([])
    append(args, Value{type = try fat_type("strview", VOID, at), at = text_data(message), mem = true})
    append(args, try place_of(at))
    try runtime("panic", args, at)
    open_block(l_good)
    return null

func operate(o: &strview, l: Value, r: Value, at: i64) -> Value|Fail:
    name := o
    if o == "!=":
        name = "=="
    elif o == ">" or o == "<=" or o == ">=":
        name = "<"
    args: &list[Value] = heap([])
    if o == ">" or o == "<=":
        append(args, r)
        append(args, l)
    else:
        append(args, l)
        append(args, r)
    v := try invoke(name, args, at)
    if o != "!=" and o != "<=" and o != ">=":
        return v
    if v.type != BOOL:
        return fail("'" + o + "' negates '" + name + "', which returns " + comp.types[v.type].name + " instead of bool", at)
    return Value{type = BOOL, at = op(W, "xor", load(v).at, int_arg(1))}

func invoke(name: &strview, args: &list[Value], at: i64) -> Value|Fail:
    names: &list[&strview] = heap([])
    return call(name, "", args, names, comp.turns.len, at, false)

func returned(name: &strview, args: &listview[Value], at: i64) -> i64|Fail:
    names: &list[&strview] = heap([])
    best := try choose(name, "", args, names, at)
    if best == 0:
        return VOID
    f := comp.syms[best].node
    saved := open_frame()
    try bind(f, trust arrange(f, args.len, names), args)
    ret := result(f)
    close_frame(saved)
    return ret

# the turns of the arguments start at comp.turns[turns], to read them in their turn
func call(name: &strview, module: &strview, args: &list[Value], names: &list[&strview], turns: i64, at: i64, threaded: bool) -> Value|Fail:
    count := 0 # the arguments of an operation of an atomic, and 0 for any other call
    first := VOID
    if args.len > 0 and module.len == 0:
        first = args[0].type
    behind := comp.types[first].kind == Ptr and comp.types[comp.types[first].elem].kind == Atomic
    if comp.types[first].kind == Atomic or behind:
        switch name:
        case "get":
            count = 1
        case "set", "add", "swap":
            count = 2
        case "compare_swap":
            count = 3
    if count > 0 and behind:
        return fail("atomic '" + name + "' takes the atomic directly, not pointer " + comp.types[first].name + "; dereference it with .*", at)
    if count > 0:
        if threaded:
            return fail("'parallel' requires a function call, but atomic '" + name + "' is a built-in operation; wrap it in a function", at)
        for label in names:
            if label.len > 0:
                return fail("atomic '" + name + "' is a built-in operation and does not accept named arguments", at)
        if args.len != count:
            return fail("atomic '" + name + "' expects " + counted(count, "argument", "arguments") + ", got " + args.len, at)
        held := comp.types[args[0].type]
        t := held.elem
        if name == "add" and not integer(t):
            return fail("atomic 'add' only works on integer atomics, not pointer atomic " + held.name + "; use set, swap, or compare_swap", at)
        i := Ins{op = "aload", cls = cls(t), a = args[0].at, number = integer(t)}
        if count > 1:
            i.b = load(try convert(args[1], t, Arg{}, at)).at
        if count > 2:
            i.c = load(try convert(args[2], t, Arg{}, at)).at
        switch name:
        case "set": # the value goes first, as in a store
            i = Ins{op = "astorel", a = i.b, b = i.a, number = i.number}
            if cls(t) == W:
                i.op = "astorew"
            add(i)
            return Value{}
        case "add":
            i.op = "aadd"
        case "swap":
            i.op = "aswap"
        case "compare_swap":
            i.op = "acas"
        i.to = u32(temp().n)
        old := add(i)
        if name == "compare_swap":
            return Value{type = BOOL, at = op(W, cmp_name("ceq", t), old, i.b)}
        return Value{type = t, at = old}
    simd := false
    for a in args:
        simd = simd or comp.types[a.type].kind == Simd
    wanted := 0
    switch name:
    case "any", "all", "sum", "abs", "sqrt":
        wanted = 1
    case "min", "max":
        wanted = 2
    case "select":
        wanted = 3
    if simd and args.len == wanted and (module.len == 0 or module == "math" and name == "sqrt"):
        if threaded:
            return fail("'parallel' requires a function call, but simd '" + name + "' is a built-in operation; wrap it in a function", at)
        for label in names:
            if label.len > 0:
                return fail("simd '" + name + "' is a built-in operation and does not accept named arguments", at)
        vector := comp.types[args[0].type]
        if name == "any" or name == "all" or name == "sum":
            if name == "sum" and lane_value(args[0].type) == BOOL:
                return fail("'sum' requires a numeric simd, not mask " + vector.name, at)
            if name != "sum" and lane_value(args[0].type) != BOOL:
                return fail("'" + name + "' requires a simd mask, not numeric simd " + vector.name + "; compare lanes first, like: " + name + "(v > 0)", at)
            o: &strview = "+"
            if name == "any":
                o = "or"
            elif name == "all":
                o = "and"
            whole := Value{type = args[0].type, at = alloc(args[0].type, true), mem = true} # the lanes are read from a slot of their own, so the simd stays whole in a register
            blit(args[0].at, whole.at, args[0].type)
            if vector.size == 32 and vectors(): # one instruction joins the halves, as the first round below would
                half := try simd_of(vector.elem, vector.count / 2, at)
                whole = try lanes(o, ptr([Value{type = half, at = whole.at, mem = true}, Value{type = half, at = offset(whole.at, 16), mem = true}]), half, at)
            parts: &list[Value] = heap([])
            for i in 0..comp.types[whole.type].count:
                append(parts, lane(whole, i))
            while parts.len > 1:
                half := parts.len / 2
                for i in 0..half:
                    parts[i] = try binary(o, parts[i], parts[i + half], at)
                parts.len = half
            return load(parts[0])
        if name == "select":
            if comp.types[args[1].type].kind != Simd and comp.types[args[2].type].kind != Simd:
                return fail("'select' chooses between simd lanes, but both value arguments are scalars; pass at least one simd", at)
            t := try simd_args(name, args[1:], at)
            mask := try mask_of(t, at)
            if args[0].type != mask:
                return fail("'select' expects mask " + comp.types[mask].name + " for " + comp.types[t].name + ", got " + vector.name, at)
            return lanes(name, args, t, at)
        t := try simd_args(name, args, at)
        lane := comp.types[comp.types[t].elem]
        if (name == "min" or name == "max") and lane.kind == Bool:
            return fail("'" + name + "' requires numeric simd lanes, not mask " + comp.types[t].name, at)
        if name == "abs" and lane.kind != Int and lane.kind != Float:
            return fail("'abs' requires signed integer or float simd lanes, but " + comp.types[t].name + " has " + lane.name + " lanes", at)
        if name == "sqrt" and lane.kind != Float:
            return fail("'sqrt' requires float simd lanes, but " + comp.types[t].name + " has " + lane.name + " lanes", at)
        return lanes(name, args, t, at)
    best := try choose(name, module, args, names, at)
    if best == 0 and simd and wanted > 0 and module.len == 0:
        return fail("simd '" + name + "' expects " + counted(wanted, "argument", "arguments") + ", got " + args.len, at)
    if best == 0 and args.len > 0:
        t := args[0].type
        k := comp.types[t].kind
        if name == "==" and args.len == 2 and args[1].type == t and k == Void:
            return truth(true)
        if name == "for" or name == "reverse":
            return fail(comp.types[t].name + " does not define 'operator " + name + "' and cannot be iterated over", at)
        if name == "with":
            return fail(comp.types[t].name + " does not define 'operator with' and cannot be used in a 'with' block", at)
        if name == "hash" and args.len == 1 and (k == Struct or k == Union) and try offers("==", ptr([args[0], args[0]]), at):
            return fail(comp.types[t].name + " defines 'operator ==' but not 'operator hash'; equal values must have equal hashes, so define 'operator hash' for " + comp.types[t].name, at)
        if name == "hash" and args.len == 1 and k == Simd:
            return fail(comp.types[t].name + " cannot be hashed because simd '==' produces a lane mask; convert it to an array: array[" + comp.types[lane_value(t)].name + ", " + comp.types[t].count + "](v)", at)
        if (name == "hash" and args.len == 1 or name == "==" and args.len == 2) and k == Atomic:
            return fail(comp.types[t].name + " is not a plain value and cannot use '" + name + "'; define 'operator " + name + "' on the enclosing type instead", at)
        if name == "hash" and args.len == 1 and not (k == Bool or k == Ptr or k == Func or k == Struct or k == Union or k == Array or k == Void):
            return fail(comp.types[t].name + " is not hashable; define: operator hash(x: " + comp.types[t].name + ") -> u64", at)
        if name == "==" and args.len == 2 and args[1].type == t and (k == Struct or k == Union) or name == "hash" and args.len == 1:
            ret := BOOL
            label: &strview = "eq"
            if name == "hash":
                ret = U64
                label = "hash"
            id := written(label, t, ret, at)
            passes: &list[Pass] = heap([])
            for a in args:
                x := load(a).at
                how := cls(t)
                if aggregate(t):
                    how = L
                append(passes, Pass{how, x, is_number(x), VOID})
            return emit(global(comp.insts[id].name), passes, ret, false, at)
    if best == 0:
        seen := first_sym(name)
        while seen != 0 and not callable(seen, module, args, at):
            seen = comp.syms[seen].next
        if seen == 0 and is_letter(items(name)[0]):
            if module.len == 0 and name == "temp":
                return fail("'temp' has been renamed to 'tmp'", at)
            if module.len == 0 and name == "open":
                return fail("'open' has been renamed to 'open_file' in module fs", at)
            if module.len == 0 and name == "create":
                return fail("'create' has been renamed to 'create_file' in module fs", at)
            if module.len == 0 and name == "at":
                return fail("'at' has been replaced by 'operator []'; use x[i] for the element or ptr(x[i]) for its pointer", at)
            if module.len == 0 and name == "slice":
                return fail("'slice' has been replaced by 'operator [:]'; use x[a:b]", at)
            try hidden(name, true, at)
            try hidden(name, false, at)
            if module.len == 0 and lookup(name) != 0:
                return fail(name + " is a variable of type " + comp.types[comp.vars[lookup(name) - 1].type].name + " and cannot be called", at)
            if module.len == 0 and name == "usize":
                return fail(NO_USIZE, at)
            return fail("unknown function " + name, at)
        for label in names:
            declared := label.len == 0 or label == ".."
            s := first_sym(name)
            while s != 0 and not declared:
                f := comp.syms[s].node
                for k in 0..params(f):
                    declared = declared or callable(s, module, args, at) and text(kid(f, k)) == label
                s = comp.syms[s].next
            if not declared:
                return fail(name + " has no parameter named " + label, at)
        hint: &strview
        for k, a in args:
            if comp.types[a.type].kind == Union and comp.types[a.type].size > 4 and not is_letter(items(name)[0]):
                hint = "; narrow the union with 'is' before using its value"
            elif comp.types[a.type].kind == Union and (contains(members(a.type), NULL) or fails(a.type)):
                kept: &list[i64] = heap([])
                for m in members(a.type):
                    if m != NULL and not comp.types[m].error:
                        append(kept, m)
                handled := false # an overload takes it once the null or the error is handled
                s := first_sym(name)
                while s != 0 and kept.len > 0:
                    f := comp.syms[s].node
                    if callable(s, module, args, at) and params(f) == args.len and not generic(kid(f, k)):
                        handled = handled or accepts(try resolve(kid(f, k) + 1), Value{type = try union_of(kept, Union, at)}) >= 0
                    s = comp.syms[s].next
                if handled and contains(members(a.type), NULL):
                    hint = "; " + comp.types[a.type].name + " may be null, handle it with 'ifnull' or 'trust'"
                elif handled:
                    hint = "; " + comp.types[a.type].name + " may be an error, handle it with 'try', 'iferror', or 'trust'"
        compares := name == "==" or name == "!=" or name == "<" or name == "<=" or name == ">" or name == ">="
        if args.len == 2 and comp.types[args[0].type].kind == Array and comp.types[args[1].type].kind == Array and native(name, Int).len > 0 and not compares:
            hint = "; arrays do not support element-wise operations, use simd instead"
        elif args.len == 2 and compares and (args[0].type == U8 and textual(args[1].type) or textual(args[0].type) and args[1].type == U8):
            hint = "; cannot compare a byte (u8) with text, use a single-quoted character literal like 'a'"
        elif args.len == 2 and compares and (numeric(args[0].type) and textual(args[1].type) or textual(args[0].type) and numeric(args[1].type)):
            hint = "; cannot compare a number with text, convert with \"\" + n or parse_int(s)"
        elif args.len == 2 and (name == "==" or name == "!=") and comp.types[args[0].type].kind == Array and comp.types[args[1].type].kind == Array:
            hint = "; arrays can only be compared when they have the same element type and length"
        elif args.len == 2 and compares and comp.types[args[0].type].kind == Array:
            hint = "; arrays do not support ordering comparisons, compare their elements instead"
        if name == "free" and args.len == 1 and (textual(args[0].type) or sequence(args[0].type)) and comp.types[args[0].type].name != "&str" and not starts_with(comp.types[args[0].type].name, "&list["):
            hint = "; " + comp.types[args[0].type].name + " is a non-owning view, free its owner instead"
        if (name == "+" or name == "-") and args.len == 2 and comp.types[args[0].type].kind == Ptr and integer(args[1].type):
            hint = "; pointer arithmetic is only allowed on *bytes: p as *bytes + n"
        if name == "-" and args.len == 2 and comp.types[args[0].type].kind == Ptr and comp.types[args[1].type].kind == Ptr:
            hint = "; pointer subtraction is only allowed on *bytes: p as *bytes - q as *bytes"
        if name == "[:]" and args.len == 3 and integer(args[1].type) and integer(args[2].type) and args[1].type != args[2].type:
            hint = "; both slice bounds must have the same integer type"
        if name == "[]=" and args.len == 3 and try offers("[]", ptr([args[0], args[1]]), at):
            hint = "; x[i] = v requires 'operator []=(x, i)' returning a pointer, 'operator []=(x, i, v)', or 'operator []' returning a pointer for " + comp.types[args[0].type].name
            if try offers("[]=", ptr([args[0], args[1]]), at):
                hint = "; 'operator []=(x, i)' on " + comp.types[args[0].type].name + " does not return a pointer to assign through"
        if name == "[]" and try offers("at", args, at):
            hint = "; x[i] now calls 'operator []' instead of 'at', replace 'func at' with 'operator []'"
        if name == "[]=" and try offers("put", args, at):
            hint = "; x[i] = v now calls 'operator []=' instead of 'put', replace 'func put' with 'operator []='"
        if name == "[:]" and try offers("slice", args, at):
            hint = "; x[a:b] now calls 'operator [:]' instead of 'slice', replace 'func slice' with 'operator [:]'"
        if name == "operator next" and try offers("next", args, at):
            hint = "; 'for' now calls 'operator next' instead of 'next', replace 'func next' with 'operator next'"
        crossing: &strview = ""
        for k, a in args:
            s := first_sym(name)
            while s != 0 and crossing.len == 0:
                f := comp.syms[s].node
                held := a.type
                if comp.types[held].kind == Ptr:
                    held = comp.types[held].elem
                whole := comp.types[held].kind == Array
                if whole and is_letter(items(name)[0]) and callable(s, module, args, at) and k < params(f) and starts_with(code_of(kid(f, k) + 1), "&listview") and (generic(kid(f, k)) or element(try resolve(kid(f, k) + 1)) == comp.types[held].elem):
                    crossing = "pass an array as a &listview by slicing it: a[:]"
                if crossing.len == 0 and callable(s, module, args, at) and k < params(f) and text(kid(f, k)) != ".." and not generic(kid(f, k)):
                    p := try resolve(kid(f, k) + 1)
                    crossing = text_of_c(a, p)
                    if a.lit and integer(a.type) and integer(p) and not fits(a, p):
                        crossing = spelled_number(a) + " does not fit in " + comp.types[p].name
                    if tuple(a.type) and comp.types[p].kind == Struct and not tuple(p):
                        crossing = "a tuple does not convert to a struct; prefix the literal with its type: " + comp.types[p].name + "{...}"
                    if (comp.types[a.type].kind == Array or comp.types[a.type].kind == Ptr and comp.types[comp.types[a.type].elem].kind == Array) and comp.types[p].kind == Fat and text(comp.types[p].decl) == "list":
                        crossing = "an array converts to &listview, not heap-owned &list; copy it with heap(a)"
                    if comp.types[a.type].name == "&strview" and comp.types[p].name == "&str":
                        crossing = "text literals are &strview, not owned &str; take &strview for read-only text (which also accepts &str)"
                    if comp.types[a.type].kind == Func and not comp.types[a.type].foreign and comp.types[p].kind == Func and comp.types[p].foreign:
                        crossing = "only an 'export func' can be passed as C function type " + comp.types[p].name
                s = comp.syms[s].next
        if crossing.len > 0:
            hint = ", " + crossing
        spread := names.len > 0 and names[-1] == ".." and sequence(args[-1].type)
        gathered := false
        mixed := false # extra arguments given one by one and with .. too
        fits := false # a ..items: T that takes the elements of the view after .. as they are
        free_type := 0 # the $T that ..items leaves without a type when no extra argument gives it one
        g := first_sym(name)
        while g != 0:
            f := comp.syms[g].node
            last := kid(f, params(f) - 1)
            if callable(g, module, args, at) and params(f) > 0 and gathers(last):
                gathered = true
                fits = fits or spread and (generic(last) or try resolve(last + 1) == element(args[-1].type))
                mixed = mixed or spread and args.len > params(f)
                if args.len < params(f) and free_type == 0:
                    free_type = unbound(last + 1)
            g = comp.syms[g].next
        named := false # an argument with a name, before the view after ..
        for label in names:
            named = named or label.len > 0 and label != ".."
        if free_type != 0:
            hint = "; " + name + " infers " + text(free_type) + " from its variadic arguments, but none were passed"
        elif names.len > 0 and names[-1] == ".." and not gathered:
            hint = "; " + name + " has no variadic '..items: T' parameter to receive a '..' spread"
        elif names.len > 0 and names[-1] == ".." and gathered and named:
            hint = "; named arguments cannot be combined with a '..' spread"
        elif gathered and named:
            hint = "; functions with a variadic '..items' parameter only accept positional arguments"
        elif names.len > 0 and names[-1] == ".." and gathered and not spread:
            whole := args[-1].type
            if comp.types[whole].kind == Ptr:
                whole = comp.types[whole].elem
            hint = "; '..' spread requires a view or list"
            if comp.types[whole].kind == Array:
                hint = "; '..' spread requires a view, slice the array first: ..a[:]"
        elif mixed:
            hint = "; the '..' spread supplies all variadic arguments to " + name + " and cannot be preceded by individual ones"
        elif spread and not fits:
            hint = "; '..' spread has element type " + comp.types[element(args[-1].type)].name + ", which must match '..items: T' without implicit conversion"
        counts := true # no overload takes as many arguments as this call gives, and they all take the same
        least := -1
        most := -1
        positional := 0
        while positional < names.len and names[positional].len == 0:
            positional += 1
        twice: &strview = ""
        put: &strview = "" # a place parameter that a value given in order would fill
        h := first_sym(name)
        while h != 0:
            f := comp.syms[h].node
            if callable(h, module, args, at):
                need := 0
                for k in 0..params(f):
                    if k < positional and placed(f, k) and not gathers(kid(f, params(f) - 1)): # with ..items the values go past it
                        put = text(kid(f, k))
                    if kids(kid(f, k)) == 1 and text(kid(f, k)) != "..":
                        need += 1
                    for label in names[positional:]:
                        if k < positional and text(kid(f, k)) == label:
                            twice = label
                counts = counts and (args.len < need or args.len > params(f)) and (params(f) == 0 or not gathers(kid(f, params(f) - 1))) and (most < 0 or least == need and most == params(f))
                least = need
                most = params(f)
            h = comp.syms[h].next
        if hint.len == 0 and twice.len > 0:
            hint = "; parameter " + twice + " is passed both positionally and by name"
        elif hint.len == 0 and put.len > 0:
            hint = "; call-site parameter " + put + " must be passed by name: " + put + " = ..."
        elif hint.len == 0 and counts and least == most and most >= 0:
            hint = "; " + name + " expects " + counted(least, "argument", "arguments")
        if name == "put" and args.len == 2:
            holder := args[0].type
            if comp.types[holder].kind == Ptr:
                holder = comp.types[holder].elem
            if comp.types[holder].kind == Fat and text(comp.types[holder].decl) == "map":
                hint = "; two-argument 'put' is internal to core operators; use ptr(m[k]) for a pointer, or m[k] += v / m[k].field = v to mutate in place"
        failed := fail("no overload of " + name + " matches (" + listed(args) + ")" + hint, at)
        said := 0
        s := first_sym(name)
        while s != 0 and hint.len == 0 and said < 4:
            if callable(s, module, args, at):
                said += 1
                decl := comp.nodes[comp.syms[s].node].tok
                note("candidate overload of " + name + " declared here", comp.tokens[decl].at)
                if noted(at, name):
                    mark(decl)
            s = comp.syms[s].next
        return failed
    f := comp.syms[best].node
    if noted(at, name):
        mark(comp.nodes[f].tok)
    order := trust arrange(f, args.len, names)
    taken: &list[i64] = heap([])
    id := try instantiate_for(f, order, args, ptr(taken), at)
    if id == comp.entry:
        return fail(ENTRY, at)
    foreign := body(f) == 0 or comp.insts[id].export
    if comp.turns.len > turns:
        to: &list[i64] = heap([]) # the type each argument goes to
        for a in args:
            append(to, VOID)
        for k in 0..order.len:
            if order[k] < args.len:
                to[order[k]] = taken[k]
            elif kids(kid(f, k)) == 1: # ..items, with no default
                for i in extra(order, k, args.len)..args.len:
                    to[i] = element(taken[k])
        in_turn(args, turns, to)
    passes: &list[Pass] = heap([])
    back: &list[Value] = heap([])
    extras: Value # the array of this frame that holds the extra arguments of ..items one by one
    for k in 0..order.len:
        if comp.types[taken[k]].kind == Given:
            continue # a type takes nothing at run time
        if order[k] < args.len:
            given := args[order[k]]
            if given.element != 0:
                given = try through_copy(given, taken[k], back, at)
            append(passes, try hand(given, taken[k], foreign, at))
        elif kids(kid(f, k)) == 1: # ..items, with no default
            elem := element(taken[k])
            whole := Value{type = EMPTYARRAY}
            start := extra(order, k, args.len)
            if args.len > start:
                extras = try fresh(try array_of(elem, args.len - start, at))
                for i in start..args.len:
                    given := args[i]
                    if given.element != 0:
                        given = try through_copy(given, elem, back, at)
                    store(elem, Value{type = elem, at = (try hand(given, elem, foreign, at)).arg}, offset(extras.at, (i - start) * comp.types[elem].size))
                whole = address(extras)
            append(passes, try hand(whole, taken[k], foreign, at))
        else:
            given := node_end(kid(f, k) + 1)
            aside := set_aside(0)
            for i in given..node_end(given):
                j := 0
                while comp.nodes[i].kind == Name and j < k and text(i) != text(kid(f, j)):
                    j += 1
                if comp.nodes[i].kind == Name and j < k and lookup(text(i)) == 0: # a parameter before it, that it reads
                    p := Value{type = taken[j]}
                    if comp.types[p.type].kind != Given:
                        used := j # its pass, a type has none
                        for t in taken[:j]:
                            used -= i64(comp.types[t].kind == Given)
                        p = Value{type = p.type, at = passes[used].arg, mem = aggregate(p.type)}
                    if not p.mem:
                        slot := alloc(p.type)
                        store(p.type, p, slot)
                        p.at = slot
                    append(comp.vars, Local{text(i), p.type, p.at, comp.loops.len, comp.nodes[kid(f, j)].tok, 0, "", 0, true, false})
            site := comp.site
            comp.site = at
            saved := open_frame() # it sees the $T of its function, not those of the caller
            inst := comp.insts[id]
            for b in inst.binds..inst.binds + inst.count:
                append(comp.binds, comp.inst_binds[b])
            append(passes, try hand(try gen(given, taken[k]), taken[k], foreign, at_of(given)))
            close_frame(saved)
            put_back(0, aside)
            comp.site = site
    if order.len < params(f):
        append(passes, Pass{})
        for k in order.len..args.len:
            v := args[k]
            if v.lit and integer(v.type) and fits(v, I32): # the int of C
                v = try convert(v, I32, Arg{}, at)
            if v.lit and textual(v.type):
                v = try convert(v, CSTR, Arg{}, at)
            if textual(v.type):
                return fail(text_of_c(v, CSTR), at)
            t := comp.types[v.type]
            if aggregate(v.type) or t.kind == Void or t.kind == Func and not t.foreign:
                return fail("C variadic function " + name + " only accepts integers, floats, bool, and pointers in '...' arguments, not " + t.name, at)
            x := load(v).at
            if v.type == F32:
                append(passes, Pass{D, op1(D, "exts", x), false, VOID})
            else:
                append(passes, Pass{cls(v.type), x, is_number(x), VOID})
    if threaded and foreign:
        return fail("'parallel' cannot run C-convention function " + name + " directly; wrap it in a Flag function", at)
    if threaded and back.len > 0:
        return fail("'parallel' cannot pass x[i] to pointer parameter of " + name + " because a thread cannot write the copy back; pass a pointer to a variable instead", at)
    if threaded:
        ret := comp.insts[id].ret
        if ret == NEVER:
            ret = VOID # its thread is waited for like one that returns nothing
        for k in reverse 0..taken.len:
            if comp.types[taken[k]].kind == Given:
                remove(taken, k)
        comp.insts[id].taken_as = func_of(taken, ret, false)
        return spawn(global(comp.insts[id].name), passes, comp.insts[id].taken_as, extras, at)
    result := try emit(global(comp.insts[id].name), passes, comp.insts[id].ret, foreign, at)
    while back.len > 0:
        element := back[back.len - 3:]
        three: &list[Value] = heap([])
        append(three, element)
        back.len -= 3
        copy := three[2]
        three.len = 2
        if points_to(try returned("[]=", three, at), copy.type): # the place of x[i] takes the copy back
            try assign(load(try invoke("[]=", three, at)).at, copy.type, copy, at)
            continue
        append(three, copy)
        if not try offers("[]=", three, at):
            return fail(comp.types[element[0].type].name + " returns a copy from x[i] and has no 'operator []=(x, i, v)' to write back changes made by " + name + "; copy the element to a variable, mutate it, and assign it back", at)
        gives := try returned("[]=", three, at)
        if gives != VOID:
            return fail("passing x[i] to " + name + " writes back via 'operator []=' on " + comp.types[element[0].type].name + ", which returns " + comp.types[gives].name + " and cannot propagate errors here; mutate a local copy and call 'try put(x, i, v)'", at)
        try invoke("[]=", three, at)
    return result

# a pointer argument to x[i] where operator [] gives a copy: the call gets a pointer to the copy, and back keeps x, i and the copy to put it back after
func through_copy(given: Value, to: i64, back: *&list[Value], at: i64) -> Value|Fail:
    if comp.types[to].kind != Ptr or given.type == to:
        return given
    if given.element < 0:
        return fail("passing a field of x[i] to a pointer parameter would only mutate a temporary copy; copy the element to a variable, update it, and assign it back", at)
    if comp.types[comp.elements[given.element - 2].type].name == "&strview":
        return fail(VIEW, at)
    append(back, comp.elements[given.element - 2])
    append(back, comp.elements[given.element - 1])
    copy := try filled(given, comp.types[to].elem)
    append(back, copy)
    return copy

# the block of a new thread: what it returns, the function, its arguments, the contexts it inherits and the extra arguments of ..items, which the frame of the caller would not keep
func spawn(code: Arg, passes: &list[Pass], shape: i64, extras: Value, at: i64) -> Value|Fail:
    ty := comp.types[shape]
    start := HEAD + align_up(comp.types[ty.ret].size, 8)
    size := start + 8
    for k in 0..ty.count:
        size += room(comp.items[ty.first + k].type)
    copied := inherited()
    for t in copied:
        size += room(t)
    if extras.type != VOID:
        size += room(extras.type)
    args: &list[Value] = heap([])
    append(args, literal(false, u64(size)))
    block := try runtime("spawn", args, at)
    add(Ins{op = "storel", a = code, b = offset(block.at, start)})
    used := start + 8
    view := used
    for k in 0..ty.count:
        t := comp.items[ty.first + k].type
        if aggregate(t):
            blit(passes[k].arg, offset(block.at, used), t)
        else:
            store(t, Value{type = t, at = passes[k].arg}, offset(block.at, used))
        view = used
        used += room(t)
    for t in copied:
        blit(global("thread $ctx." + comp.types[t].name), offset(block.at, used), t)
        used += room(t)
    if extras.type != VOID: # the view of the last argument sees the copy
        blit(extras.at, offset(block.at, used), extras.type)
        add(Ins{op = "storel", a = offset(block.at, used), b = offset(block.at, view)})
    first := comp.body.len
    used = start + 8
    for k in 0..ty.count: # a value that is not a number or a pointer goes to the function from the block, like in the thread
        t := comp.items[ty.first + k].type
        if aggregate(t):
            passes[k].arg = offset(block.at, used)
        used += room(t)
    if big(ty.ret): # and the result goes to the block
        try emit(code, passes, ty.ret, false, at, shape, offset(block.at, HEAD))
    else:
        store(ty.ret, try emit(code, passes, ty.ret, false, at, shape), offset(block.at, HEAD))
    for i in first..comp.body.len:
        comp.body[i].ghost = true # the call as -memory sees it, in this thread
    args.len = 0
    append(args, block)
    run := written("run", shape, VOID, at)
    comp.insts[run].taken_as = pointer(BYTES)
    append(args, Value{type = pointer(BYTES), at = global(comp.insts[run].name)})
    append(args, try place_of(at))
    try runtime("launch", args, at)
    result := ty.ret
    if result == VOID:
        result = NULL
    return Value{type = thread_of(result), at = block.at}

# the contexts that a thread of parallel starts with a copy of, from the thread that starts it
func inherited() -> &list[i64]:
    out: &list[i64] = heap([])
    for k in 1..comp.syms.len:
        d := comp.syms[k].node
        if comp.nodes[d].kind == Context and declared(d) == "inherited":
            append(out, trust make_type(k, [], false, 0))
    return out

# a call as core sees it: the runtime is priv, and a check of the compiler calls the panic of core, not one of yours
func runtime(name: &strview, args: &list[Value], at: i64) -> Value|Fail:
    first := comp.body.len
    v := try invoke(name, args, 0)
    for k in first..comp.body.len:
        comp.body[k].pos = at
    return v

func place_of(at: i64) -> Value|Fail:
    return Value{type = try fat_type("strview", VOID, at), at = text_data(view(location(at))), mem = true, lit = true}

func written(label: &strview, t: i64, ret: i64, at: i64) -> i64:
    key: &str = heap(label)
    key += "." + t
    id := comp.inst_ids[view(key)]
    if id is i64:
        free(key)
        return id
    name: &str = heap("$")
    name += label + "." + comp.insts.len
    append(comp.insts, Inst{0, view(name), comp.inst_binds.len, 1, ret, site(at), false, true, 0, VOID})
    append(comp.inst_binds, Item{name = "$T", type = t})
    put(comp.inst_ids, view(key), comp.insts.len - 1)
    return comp.insts.len - 1

func instantiate_for(f: i64, order: &list[i64], args: &list[Value], taken: *&list[i64], at: i64) -> i64|Fail:
    saved := open_frame()
    if generic(f):
        try bind(f, order, args)
    for k in 0..params(f):
        c := kid(f, k)
        if gathers(c):
            append(taken, try fat_type("listview", try resolve(c + 1), at))
        elif text(c) != "..":
            append(taken, try resolve(c + 1))
    id := try instantiate(f, at)
    close_frame(saved)
    return id

func choose(name: &strview, module: &strview, args: &listview[Value], names: &list[&strview], at: i64) -> i64|Fail:
    key: &str = heap("")
    key += name + "|" + module + "|" + file_of(at)
    for a in args:
        key += "|" + a.type
        if a.lit:
            key += " " + a.neg + " " + a.n + " " + a.flipped
    for given in names:
        key += "|" + given
    known := comp.chosen[view(key)]
    if known is i64:
        free(key)
        return known
    here := comp.files[file_of(at)].module
    kept := false
    s := first_sym(name)
    while s != 0:
        kept = kept or comp.syms[s].priv and callable(s, module, args, at)
        s = comp.syms[s].next
    fits: &list[i64] = heap([])
    scores: &list[&list[i64]] = heap([])
    s = first_sym(name)
    while s != 0:
        f := comp.syms[s].node
        if callable(s, module, args, at):
            order := arrange(f, args.len, names)
            if order is &list[i64]:
                saved := open_frame()
                score := try bind(f, order, args)
                close_frame(saved)
                if score is &list[i64]:
                    if kept and comp.files[file_of(comp.tokens[comp.nodes[f].tok].at)].module == here:
                        for k in 0..score.len:
                            score[k] += PRIVATE
                    append(score, 0 - i64(near(s, at)) - 4 * i64(variadic(f))) # at equal scores the one without extra arguments wins, and then the nearest
                    append(fits, s)
                    append(scores, score)
        s = comp.syms[s].next
    best := 0
    for k in 1..fits.len:
        if beats(scores[k], scores[best]):
            best = k
    for k in 0..fits.len:
        if k != best and not beats(scores[best], scores[k]):
            tied: &list[i64] = heap([])
            for i in 0..fits.len:
                beaten := false
                for j in 0..fits.len:
                    beaten = beaten or beats(scores[j], scores[i])
                if not beaten:
                    append(tied, fits[i])
            apart := true # each one is of a module of its own, that this file names
            ways: &str = heap("")
            for i in reverse 0..tied.len:
                m := comp.syms[tied[i]].module
                apart = apart and m.len > 0 and module_of(m, file_of(at)) == m
                for o in tied[i + 1:]:
                    apart = apart and comp.syms[o].module != m
                if i == 0:
                    ways += " or "
                elif ways.len > 0:
                    ways += ", "
                ways += m + "." + name
            if scores[k] == scores[best] and apart:
                _ = fail("ambiguous call to " + name + " with (" + listed(args) + "): multiple overloads match equally; qualify with a module name: " + ways, at)
            elif scores[k] == scores[best]:
                _ = fail("ambiguous call to " + name + " with (" + listed(args) + "): multiple overloads match equally", at)
            elif apart:
                _ = fail("ambiguous call to " + name + " with (" + listed(args) + "): no overload is best for all arguments; qualify with a module name: " + ways, at)
            else:
                _ = fail("ambiguous call to " + name + " with (" + listed(args) + "): no overload is best for all arguments", at)
            for f in tied:
                decl := comp.nodes[comp.syms[f].node].tok
                note("candidate overload of " + name + " declared here", comp.tokens[decl].at)
                if noted(at, name):
                    mark(decl)
            return Fail
    found := 0
    if fits.len > 0:
        found = fits[best]
    put(comp.chosen, view(key), found)
    return found

# a fits each argument at least as well as b and one better, or each as well and wins the tie its last score says
func beats(a: &list[i64], b: &list[i64]) -> bool:
    better := false
    for k in 0..a.len - 1:
        if a[k] < b[k]:
            return false
        better = better or a[k] > b[k]
    return better or a[-1] > b[-1]

func listed(args: &listview[Value]) -> &str:
    shown: &str = heap("")
    for a in args:
        if shown.len > 0:
            shown += ", "
        shown += brief(comp.types[a.type].name)
    return shown

func near(s: i64, at: i64) -> i64:
    sym := comp.syms[s]
    here := comp.files[file_of(at)]
    if sym.module == here.module:
        return 0
    if sym.module.len == 0:
        return 1 + i64(sym.library != here.library)
    return 3

func hand(given: Value, to: i64, foreign: bool, at: i64) -> Pass|Fail:
    v := given
    if points_to(to, given.type):
        v = address(given)
    else:
        v = try convert(given, to, Arg{}, at)
    how: u32 = L
    if foreign or comp.types[to].kind != Fat and not big(to):
        how = try passing(to, foreign, at)
    x := load(v).at
    if comp.types[to].kind == Func and not comp.types[to].foreign and x.kind != Global:
        try panic_if(op(W, "ceql", x, int_arg(0)), "passed an uninitialized (empty) function value as an argument", at)
    return Pass{how, x, is_number(x), VOID}

# a call through a function value keeps its type in c, -memory follows it into each function taken as that type
func emit(callee: Arg, passes: &list[Pass], ret: i64, foreign: bool, at: i64, shape: i64 = VOID, into: Arg = Arg{}) -> Value|Fail:
    i := Ins{op = "call", a = callee, c = int_arg(shape), first = u32(comp.passes.len)}
    for p in passes:
        append(comp.passes, p)
    result := into
    if big(ret) and not foreign:
        if into.kind == Empty:
            result = alloc(ret)
        append(comp.passes, Pass{L, result, false, VOID})
    elif ret != VOID and ret != NEVER:
        i.cls = try passing(ret, foreign, at)
        result = temp()
        i.to = u32(result.n)
    i.count = u32(comp.passes.len) - i.first
    here := comp.at
    comp.at = at
    add(i)
    comp.at = here
    if ret == NEVER:
        terminate("hlt", Arg{})
    else:
        comp.calls += 1
    if foreign and ret != VOID and not aggregate(ret):
        result = extend(ret, result)
    return Value{type = ret, at = result, mem = aggregate(ret)}

# the score of each argument, matched in rounds: first what fixes a $T, then a $T alone or in a union, which takes the widest of its integers, then the literals, which take what is bound
func bind(f: i64, order: &list[i64], args: &listview[Value]) -> &list[i64]?|Fail:
    scores: &list[i64] = heap([]) # -r until round r matches its argument
    for a in args:
        append(scores, 0)
    given := args # what each argument matches, where a view given with .. gives its elements
    extras := order.len # the parameter ..items that takes the extra arguments one by one, after those of the others
    first := args.len # the first of them
    span := order.len
    c := f + 1
    j := 0
    while j < span:
        if j + 1 == order.len and order[j] == args.len and kids(c) == 1:
            extras = j
            first = extra(order, j, args.len)
            span = max(j, j + args.len - first)
        elif j + 1 == order.len and order[j] + 1 == args.len and gathers(c) and not sequence(args[order[j]].type):
            return null
        elif j + 1 == order.len and order[j] + 1 == args.len and gathers(c):
            given = heap(args)
            given[order[j]] = Value{type = element(args[order[j]].type)}
        i := order[j] if j < extras else j - extras + first
        if i < args.len and turn(given[i]) > 0:
            scores[i] = -1 - turn(given[i])
        elif i < args.len and loose(c + 1):
            scores[i] = -1
        if j + 1 < order.len:
            c = node_end(c)
        j += 1
    for round in 0..4:
        if round == 1:
            fixed := comp.binds.len
            c = f + 1
            for k in 0..span:
                i := order[k] if k < extras else k - extras + first
                if i < args.len and scores[i] == -1 and integer(given[i].type):
                    saved := open_frame()
                    alone := Item{} # what this integer binds by itself
                    if try match(c + 1, given[i]) >= 0 and comp.binds.len > comp.frame:
                        alone = comp.binds[-1]
                    close_frame(saved)
                    b := bound(alone.name)
                    if b == 0 and alone.name.len > 0:
                        append(comp.binds, alone)
                    elif b > fixed and widens(comp.binds[b - 1].type, alone.type):
                        comp.binds[b - 1].type = alone.type
                if k + 1 < order.len:
                    c = node_end(c)
        c = f + 1
        for k in 0..span:
            i := order[k] if k < extras else k - extras + first
            if i < args.len and scores[i] == -i64(round):
                got := try match(c + 1, given[i])
                if got < 0 or given[i].type != args[i].type and try resolve(c + 1) != given[i].type: # the elements of the view are T itself
                    return null
                scores[i] = got
            if k + 1 < order.len:
                c = node_end(c)
    if first >= args.len and extras < order.len and unbound(kid(f, extras) + 1) != 0: # with no extra argument the $T of ..items has no type
        return null
    if not try holds_where(f):
        return null
    return scores

# a $T alone or in a union, which takes a value that widens or converts
func loose(n: i64) -> bool:
    node := comp.nodes[n]
    return node.kind == TUnion or node.kind == TUnary and text(n) == "?" or node.kind == TName and comp.tokens[node.tok].kind == Generic

func holds_where(f: i64) -> bool|Fail:
    choosing := comp.choosing
    comp.choosing = true
    defer comp.choosing = choosing
    c := kid(f, params(f))
    while c < node_end(f):
        if comp.nodes[c].kind == Where and not try holds(c + 1):
            return false
        c = node_end(c)
    return true

func turn(v: Value) -> i64:
    if v.type == NULL:
        return 2
    return i64(v.lit) + i64(v.lit and integer(v.type))

# the argument of each parameter, count when it takes its default, and for ..items the one given with .., or count when the extra ones go one by one
func arrange(f: i64, count: i64, names: &list[&strview]) -> &list[i64]?:
    fixed := params(f)
    last := kid(f, fixed - 1)
    gathered := fixed > 0 and gathers(last)
    extra := gathered or fixed > 0 and text(last) == ".."
    if extra:
        fixed -= 1
    order: &list[i64] = heap([])
    for k in 0..fixed:
        append(order, count)
    next := 0
    view := count
    for i in 0..count:
        named := i < names.len and names[i].len > 0
        while not named and i < names.len and next < fixed and placed(f, next): # a value you write in order goes past the place of the call, the compiler gives its own in order
            next += 1
        if named and names[i] == "..":
            for k in next..fixed:
                if kids(kid(f, k)) == 1:
                    return null
            if not gathered or next > fixed or i + 1 != count:
                return null
            view = i
            continue
        slot := next
        if named:
            slot = fixed
            for k in 0..fixed:
                if text(kid(f, k)) == names[i]:
                    slot = k
        else:
            next += 1
        if named and (slot == fixed or extra) or slot >= fixed and not extra:
            return null
        if slot < fixed and order[slot] != count:
            return null
        if slot < fixed:
            order[slot] = i
    for k in 0..fixed:
        if order[k] == count and kids(kid(f, k)) == 1:
            return null
    if gathered:
        append(order, view)
    return order

# the first extra argument of ..items, the parameter k: after those that the others take in order, which skip the place of the call
func extra(order: &listview[i64], k: i64, count: i64) -> i64:
    first := 0
    for j in order[:k]:
        first += i64(j < count)
    return first

# an integer that the compiler knows, as it was written
func spelled_number(v: Value) -> &strview:
    shown: &str = heap("")
    if v.flipped:
        shown += "not " + (v.n - 1)
    elif v.neg:
        shown += "-" + v.n
    else:
        shown += v.n
    return view(shown)

# the parameter k of f takes the place of the call, its default is @here()
func placed(f: i64, k: i64) -> bool:
    d := node_end(kid(f, k) + 1)
    return kids(kid(f, k)) == 2 and comp.nodes[d].kind == Call and text(d) == "@here"

func passing(t: i64, foreign: bool, at: i64) -> u32|Fail:
    ty := comp.types[t]
    if foreign and ty.kind == Func and not ty.foreign:
        return fail(ty.name + " cannot cross the C ABI; C expects 'extern " + ty.name + "' (from an 'export func')", at)
    if foreign and ty.kind == Thread:
        return fail(ty.name + " cannot cross the C ABI; Flag threads can only be awaited from Flag", at)
    if foreign and aggregate(t):
        return c_type(t, at)
    if foreign and ty.size == 1 and ty.kind == Int:
        return SB
    if foreign and ty.size == 1:
        return UB
    if foreign and ty.size == 2 and ty.kind == Int:
        return SH
    if foreign and ty.size == 2:
        return UH
    return cls(t)

func c_type(t: i64, at: i64) -> u32|Fail:
    ty := comp.types[t]
    if contains(comp.c_types, t):
        return CAGG + u32(t)
    if ty.kind != Struct and ty.kind != Untagged:
        return fail(ty.name + " cannot cross the C ABI; only integers, floats, bool, pointers, structs, and untagged unions of those are allowed", at)
    if ty.packed:
        return fail("packed struct " + ty.name + " cannot cross the C ABI by value; pass a pointer instead", at)
    fields: &str = heap("")
    for i in 0..ty.count:
        item := comp.items[ty.first + i]
        e := item.type
        count := 1
        if comp.types[e].kind == Array:
            count = comp.types[e].count
            e = comp.types[e].elem
        k := comp.types[e].kind
        one: &str = heap("")
        if item.shared:
            return fail("struct " + ty.name + " cannot cross the C ABI by value because field " + item.name + " shares storage; pass a pointer or use an untagged union", at)
        elif comp.types[e].size == 0:
            continue
        elif k == Struct or k == Untagged:
            one += ":c" + (try c_type(e, at) - CAGG)
        elif k == Bool or comp.types[e].size == 1 and integer(e):
            one += "b"
        elif comp.types[e].size == 2 and integer(e):
            one += "h"
        elif cls(e) == S:
            one += "s"
        elif cls(e) == D:
            one += "d"
        elif cls(e) == L and (k != Func or comp.types[e].foreign) and k != Thread:
            one += "l"
        elif numeric(e) or k == Ptr:
            one += "w"
        else:
            return fail(ty.name + " cannot cross the C ABI because it contains " + comp.types[item.type].name, at)
        one += " " + count
        if ty.kind == Untagged:
            fields += "{ " + one + " } "
        else:
            fields += one + ", "
    append(comp.c_types, t)
    comp.c_defs += "type :c" + t + " = { " + fields + "}\n"
    return CAGG + u32(t)

func match(n: i64, v: Value) -> i64|Fail:
    node := comp.nodes[n]
    tok := comp.tokens[node.tok]
    t := comp.types[v.type]
    if v.element != 0 and node.kind == TUnary and tok.text == "*":
        return match(n, Value{type = try present(v.type, tok.at), at = v.at})
    if node.kind == TUnary and tok.text == "type":
        given := v.type # a void type is its one value
        if t.kind == Given:
            given = t.elem
        elif t.kind != Void:
            return -1
        b := bound(text(n + 1))
        if b == 0:
            append(comp.binds, Item{name = text(n + 1), type = given})
            return 0
        if comp.binds[b - 1].type == given:
            return 0
        return -1
    if t.kind == Given:
        return -1
    if node.kind == TName and tok.kind == Generic:
        b := bound(tok.text)
        if b == 0 and v.type == NEVER: # what heap([]) holds, which gives a $T no type
            return -1
        if b == 0:
            append(comp.binds, Item{name = tok.text, type = v.type})
            return 0
        if comp.binds[b - 1].type == v.type:
            return 0
        return accepts(comp.binds[b - 1].type, v)
    if not generic(n):
        score := accepts(try resolve(n), v)
        if score < 0 and node.kind == TUnary and tok.text == "*" and try resolve(n + 1) == v.type:
            return STEP
        return score
    if node.kind == TUnion or node.kind == TUnary and tok.text == "?":
        plain: &list[i64] = heap([])
        binder := 0
        if node.kind == TUnary:
            append(plain, NULL)
        c := n + 1
        while c < node_end(n):
            if binder == 0 and generic(c):
                binder = c
            elif generic(c):
                return -1
            else:
                for m in members(try resolve(c)):
                    append(plain, m)
            c = node_end(c)
        rest: &list[i64] = heap([])
        for m in members(v.type):
            if not contains(plain, m):
                append(rest, m)
        if rest.len == 0:
            for i in binder..node_end(binder):
                if comp.tokens[comp.nodes[i].tok].kind == Generic and bound(text(i)) == 0:
                    return -1
            return STEP
        rested := v # a literal stays one, so it adapts to the $T it meets
        rested.type = try union_of(rest, Union, tok.at)
        inner := try match(binder, rested)
        if inner < 0 or accepts(try resolve(n), v) < 0:
            return -1
        return inner + STEP
    if node.kind == TUnary and tok.text == "*":
        if points_to(v.type, t.elem):
            inner := try match(n + 1, Value{type = t.elem, at = v.at})
            if inner < 0 or try resolve(n + 1) != t.elem:
                return -1
            return inner + STEP
        pointee := comp.nodes[n + 1]
        if pointee.kind == TName and comp.tokens[pointee.tok].kind == Generic:
            return -1
        inner := try match(n + 1, v)
        if inner < STEP or try resolve(n + 1) != v.type:
            return -1
        return inner - STEP
    if node.kind == TTuple:
        if not tuple(v.type) or t.count != kids(n):
            return -1
        score: i64 = STEP
        c := n + 1
        for k in 0..t.count:
            inner := try match(c, Value{type = comp.items[t.first + k].type})
            if inner < 0:
                return -1
            score += inner
            c = node_end(c)
        if try resolve(n) != v.type:
            return -1
        return score
    if node.kind == TFunc:
        if t.kind != Func or t.count != params(n) or t.count + i64(t.ret != VOID) != kids(n):
            return -1
        score: i64 = STEP
        for k in 0..kids(n):
            part := Value{type = t.ret}
            if k < t.count:
                part.type = comp.items[t.first + k].type
            inner := try match(kid(n, k) + i64(k < t.count), part)
            if inner < 0:
                return -1
            score += inner
        if try resolve(n) != v.type:
            return -1
        return score
    fat := node.kind == TUnary and tok.text == "&"
    head := n + i64(fat)
    spreads := fat and t.kind == Ptr and comp.types[t.elem].kind == Array
    if comp.nodes[head].kind != TName:
        return -1
    s := try find_type(text(head), comp.nodes[head].module, comp.tokens[comp.nodes[head].tok].at)
    if s != 0 and not fat and kids(head) > 0 and comp.nodes[comp.syms[s].node].kind == Alias:
        alias := comp.syms[s].node
        if type_params(alias) != kids(head) or contains(comp.resolving, alias):
            return -1
        before := comp.nodes.len
        append(comp.resolving, alias)
        score := try match(expand(kid(alias, type_params(alias)), alias, head), v)
        comp.resolving.len -= 1
        comp.nodes.len = before
        return score
    if fat != (t.kind == Fat) and not spreads:
        return -1
    if (text(head) == "Thread" or text(head) == "atomic") and comp.nodes[head].module.len == 0 and not fat and kids(head) > 0:
        shape: TypeKind = Thread
        if text(head) == "atomic":
            shape = Atomic
        if t.kind != shape or kids(head) != 1:
            return -1
        inner := try match(head + 1, Value{type = t.elem, at = v.at})
        if inner < 0 or try resolve(head + 1) != t.elem:
            return -1
        return inner + STEP
    if (text(head) == "array" or text(head) == "simd") and comp.nodes[head].module.len == 0:
        shape: TypeKind = Array
        if text(head) == "simd":
            shape = Simd
        if t.kind != shape or not try arg_fits(kid(head, 1), VOID, t.count):
            return -1
        inner := try match(head + 1, Value{type = t.elem, at = v.at})
        if inner < 0 or try resolve(head + 1) != t.elem:
            return -1
        return inner + STEP
    if spreads:
        if s == 0 or kids(head) != 1:
            return -1
        inner := try match(head + 1, Value{type = comp.types[t.elem].elem, at = v.at})
        if inner < 0 or not spread(v.type, try resolve(n)):
            return -1
        return inner + 1
    if s == 0 or kids(head) == 0 or t.decl != comp.syms[s].node and (not fat or type_params(t.decl) != kids(head)):
        return -1
    score: i64 = STEP
    c := head + 1
    i := 0
    while c < node_end(head):
        arg := comp.items[t.args + i]
        if arg.type == VOID or comp.nodes[c].kind == Literal:
            if not try arg_fits(c, arg.type, arg.n):
                return -1
        else:
            inner := try match(c, Value{type = arg.type, at = v.at})
            if inner < 0 or try resolve(c) != arg.type:
                return -1
            score += inner
        c = node_end(c)
        i += 1
    if t.decl != comp.syms[s].node:
        if not prefix(v.type, try resolve(n)):
            return -1
        score -= STEP - 1
    return score

func expand(n: i64, alias: i64, given: i64) -> i64:
    made := comp.nodes.len
    for k in 0..type_params(alias):
        if comp.nodes[n].size == 1 and comp.tokens[comp.nodes[n].tok].kind == Generic and text(n) == text(kid(alias, k)):
            for i in kid(given, k)..node_end(kid(given, k)):
                append(comp.nodes, comp.nodes[i])
            return made
    append(comp.nodes, comp.nodes[n])
    c := n + 1
    while c < node_end(n):
        expand(c, alias, given)
        c = node_end(c)
    comp.nodes[made].size = comp.nodes.len - made
    return made

func prefix(from: i64, to: i64) -> bool:
    a := comp.types[from]
    b := comp.types[to]
    if a.kind != Fat or b.kind != Fat or from == to or b.count > a.count or type_params(a.decl) != type_params(b.decl):
        return false
    for i in 0..type_params(a.decl):
        if comp.items[a.args + i].type != NEVER and (comp.items[a.args + i].type != comp.items[b.args + i].type or comp.items[a.args + i].n != comp.items[b.args + i].n):
            return false
    for i in 0..b.count:
        if comp.items[a.first + i].name != comp.items[b.first + i].name or comp.items[a.first + i].type != comp.items[b.first + i].type:
            return false
    return true

func arg_fits(n: i64, t: i64, value: i64) -> bool|Fail:
    if t != VOID:
        return false
    count := try count_of(n)
    if count is i64:
        return count == value
    tok := comp.tokens[comp.nodes[n].tok]
    if tok.kind != Generic or bound(tok.text) != 0:
        return false
    append(comp.binds, Item{name = tok.text, type = VOID, n = value})
    return true

# the first $T in the type n that nothing binds yet, or 0
func unbound(n: i64) -> i64:
    for i in n..node_end(n):
        if comp.tokens[comp.nodes[i].tok].kind == Generic and bound(text(i)) == 0:
            return i
    return 0

func generic(n: i64) -> bool:
    i := n
    while i < node_end(n):
        k := comp.nodes[i].kind
        if k == Field or k == Where or k == Block:
            i = node_end(i)
        elif comp.tokens[comp.nodes[i].tok].kind == Generic:
            return true
        else:
            i += 1
    return false

func accepts(to: i64, v: Value) -> i64:
    if to == v.type:
        return 2 * STEP
    if prefix(v.type, to) or spread(v.type, to):
        return STEP
    target := comp.types[to]
    if v.lit and integer(v.type) and integer(to):
        if fits(v, to):
            return STEP - i64(to) # the first integer where it fits, in the order of a union
        return -1
    if widens(v.type, to):
        return STEP - i64(target.size) # the shortest widening fits best
    if v.lit and comp.types[v.type].kind == Float and target.kind == Float:
        return STEP
    if v.lit and integer(v.type) and target.kind == Float:
        return i64(to == F64) # below any integer
    if v.lit and textual(v.type) and to == CSTR:
        return STEP
    if untagged_member(to, v.type) or untagged_member(v.type, to) or target.kind == Union and within(v.type, to):
        return STEP
    best := -1
    if target.kind == Union or v.lit and numeric(v.type) and target.kind == Untagged:
        for i in 0..target.count:
            score := accepts(comp.items[target.first + i].type, v)
            if score > best:
                best = score
    return best

func fits(v: Value, t: i64) -> bool:
    if comp.types[t].kind == Uint:
        return not v.neg and v.n <= largest(t) or v.flipped and v.n - 1 <= largest(t)
    if v.neg:
        return v.n <= largest(t) + 1
    return v.n <= largest(t)

func largest(t: i64) -> u64:
    bits := comp.types[t].size * 8
    if comp.types[t].kind == Int:
        bits -= 1
    if bits == 64:
        return 0xffff_ffff_ffff_ffff
    return (u64(1) << bits) - 1

func convert(v: Value, to: i64, dest: Arg, at: i64) -> Value|Fail:
    if v.type == to:
        return v
    if prefix(v.type, to):
        slot := alloc(to)
        blit(v.at, slot, to)
        return Value{type = to, at = slot, mem = true}
    if spread(v.type, to):
        slot := dest
        if slot.kind == Empty:
            slot = alloc(to)
        try zero(to, slot)
        if comp.types[v.type].kind == Ptr and comp.types[v.type].elem != EMPTYARRAY:
            store(v.type, v, slot)
            length := field_of(to, "len")
            store(length.type, Value{type = length.type, at = int_arg(comp.types[comp.types[v.type].elem].count)}, offset(slot, length.n))
        return Value{type = to, at = slot, mem = true}
    from := comp.types[v.type]
    target := comp.types[to]
    if target.kind == Atomic:
        return fail("cannot assign directly to " + target.name + "; atomics start at 0 and must be updated with set, add, swap, or compare_swap", at)
    if v.lit and integer(v.type) and integer(to):
        if fits(v, to) and v.neg and target.kind == Uint:
            return Value{type = to, at = int_arg(i64(largest(to) - v.n + 1))}
        if fits(v, to):
            return Value{type = to, at = v.at}
        shown := spelled_number(v)
        if v.neg and target.kind == Uint and not v.flipped:
            return fail(shown + " does not fit in unsigned type " + target.name + " (minimum is 0)", at)
        return fail(shown + " does not fit in " + target.name + " (maximum is " + largest(to) + ")", at)
    if v.lit and numeric(v.type) and target.kind == Float:
        x := real(v)
        if to == F32 and x - x == 0.0 and f32(x) - f32(x) != 0.0:
            return fail(x + " overflows f32 (maximum is 3.4028234663852886e+38)", at)
        if to == F32:
            x = f64(f32(x)) # the f32 it rounds to, which the compiler computes with
        return Value{type = to, at = Arg{Single if to == F32 else Double, x as i64}}
    if v.lit and textual(v.type) and to == CSTR: # a literal ends with a 0 already
        return Value{type = to, at = op1(L, "loadl", v.at)}
    if (target.kind == Union or v.lit and numeric(v.type) and target.kind == Untagged) and not contains(members(to), v.type) and not untagged_member(to, v.type):
        found := try member_for(to, v, at)
        if found != VOID:
            return convert(try convert(v, found, Arg{}, at), to, dest, at)
    if target.kind == Untagged and untagged_member(to, v.type):
        slot := alloc(to)
        try zero(to, slot)
        store(v.type, v, slot)
        return Value{type = to, at = slot, mem = true}
    if from.kind == Untagged and untagged_member(v.type, to):
        return Value{type = to, at = v.at, mem = true, place = v.place}
    if widens(v.type, to):
        x := load(v).at
        if target.size == 8 and from.kind == Int:
            x = op1(L, "extsw", x)
        elif target.size == 8:
            x = op1(L, "extuw", x)
        return Value{type = to, at = x}
    if target.kind == Union and within(v.type, to):
        slot := alloc(to)
        if from.kind == Union:
            blit(v.at, slot, v.type)
        else:
            set_tag(to, v.type, slot)
            store(v.type, v, payload(slot, v.type))
        return Value{type = to, at = slot, mem = true}
    args: &list[Value] = heap([])
    append(args, Value{type = to, at = dest, mem = true, place = true})
    append(args, v)
    if owner(to) and dest.kind == Empty and accepts(to, Value{type = try returned("heap", args[1:], at)}) >= 0:
        return fail("new " + target.name + " has no allocated memory to copy " + from.name + " into; wrap the value in heap(...) or arena(a, ...)", at)
    if try offers("=", args, at):
        if dest.kind == Empty:
            args[0].at = alloc(to)
            try zero(to, args[0].at)
        return invoke("=", args, at)
    if from.kind == Union:
        missed := VOID # the null or the error that keeps the union from the place, when the other members go there
        fits := true
        for m in members(v.type):
            args[1] = Value{type = m}
            if accepts(to, args[1]) < 0 and not try offers("=", args, at) and (m == NULL or comp.types[m].error):
                missed = m
            elif accepts(to, args[1]) < 0 and not try offers("=", args, at):
                fits = false
        if fits and missed != VOID:
            handled: &strview = "null with 'ifnull'" if missed == NULL else "the error with 'try' or 'iferror'"
            return fail("cannot assign " + from.name + " to " + target.name + " because it may be " + comp.types[missed].name + "; handle " + handled + ", or use 'trust'", at)
        current := tag(v)
        slot := alloc(to)
        l_done := label()
        for m in members(v.type):
            l_arm := label()
            l_next := label()
            branch(op(W, "ceqw", current, tag_of(m)), l_arm, l_next)
            open_block(l_arm)
            member := convert(Value{type = m, at = payload(v.at, m), mem = true}, to, dest, at)
            if member is Fail:
                note("value has union type " + from.name + " and may hold " + comp.types[m].name + " here; narrow it with 'is' first", at)
                return Fail
            store(to, member, slot)
            jump(l_done)
            open_block(l_next)
        terminate("hlt", Arg{})
        open_block(l_done)
        return Value{type = to, at = slot, mem = true}
    if integer(v.type) and integer(to):
        return fail("cannot implicitly narrow or change sign from " + from.name + " to " + target.name + "; convert explicitly with " + target.name + "(...)", at)
    if v.type == NULL and (target.kind == Ptr or target.kind == Fat):
        return fail("cannot assign null to non-optional type " + target.name + "; use " + target.name + "? to allow null", at)
    if numeric(v.type) and numeric(to):
        return fail("cannot implicitly convert " + from.name + " to " + target.name + "; convert explicitly with " + target.name + "(...)", at)
    if from.kind == Fat and target.kind == Fat and text(from.decl) == "list" and text(target.decl) == "list" and numeric(comp.items[from.args].type) and numeric(comp.items[target.args].type):
        return fail("cannot assign " + from.name + " to " + target.name + "; list elements do not convert implicitly (for literals, type the first element: heap([" + comp.types[comp.items[target.args].type].name + "(1), 2]))", at)
    crossing := text_of_c(v, to)
    if crossing.len > 0:
        return fail(crossing, at)
    if from.decl != 0 and from.decl == target.decl:
        for i in 0..type_params(from.decl):
            part := comp.items[from.args + i].type
            whole := comp.items[target.args + i].type
            if part != whole and comp.types[whole].kind == Union and comp.types[whole].decl != 0 and within(part, whole):
                return fail("cannot assign " + from.name + " to " + target.name + ", and no 'operator =' converts between them; a literal of variants has the union of those variants as its type, so name the enum on its first element: [" + text(comp.types[whole].decl) + "(" + comp.types[members(part)[0]].name + "), ...]", at)
    return fail("cannot assign " + from.name + " to " + target.name + ", and no 'operator =' converts between them", at)

func member_for(to: i64, v: Value, at: i64) -> i64|Fail:
    target := comp.types[to]
    found := VOID
    tied := VOID
    best := -1
    for i in 0..target.count:
        m := comp.items[target.first + i].type
        score := accepts(m, v)
        if score > best:
            found = m
            tied = VOID
            best = score
        elif score == best and score >= 0:
            tied = m
    if tied != VOID and v.lit:
        shown: &str = heap("")
        if v.neg:
            shown += "-"
        if comp.types[v.type].kind == Float:
            shown += real(v)
        else:
            shown += v.n
        return fail("literal " + shown + " matches multiple members of " + target.name + " equally; specify the type explicitly: " + comp.types[found].name + "(" + shown + ")", at)
    if tied != VOID:
        return VOID
    return found

# [] and an array through a pointer go to a view of their elements, an owner gets its memory from heap or arena
func spread(from: i64, to: i64) -> bool:
    elem := element(to)
    if comp.types[to].kind != Fat or owner(to) or elem == VOID:
        return false
    p := comp.types[from]
    return from == EMPTYARRAY or p.kind == Ptr and (p.elem == EMPTYARRAY or comp.types[p.elem].kind == Array and comp.types[p.elem].elem == elem)

# a fat pointer that grows into its cap, so it owns its memory, which a view does not
func owner(t: i64) -> bool:
    return comp.types[t].kind == Fat and field_of(t, "cap").type != VOID

func element(fat: i64) -> i64:
    params := type_params(comp.types[fat].decl)
    if params == 0:
        return U8
    if params == 1:
        return comp.items[comp.types[fat].args].type
    return VOID

func within(part: i64, whole: i64) -> bool:
    all := members(whole)
    i := 0
    for m in members(part):
        while i < all.len and all[i] < m:
            i += 1
        if i == all.len or all[i] != m:
            return false
    return true

func untagged_member(t: i64, m: i64) -> bool:
    if comp.types[t].kind != Untagged:
        return false
    for i in 0..comp.types[t].count:
        if comp.items[comp.types[t].first + i].type == m:
            return true
    return false

# a pointer to t, which takes a variable of t by its address, and not a text of C
inline func points_to(p: i64, t: i64) -> bool:
    return comp.types[p].kind == Ptr and comp.types[p].elem == t and p != CSTR and p != WSTR

# how a text of C goes to or from a text of Flag or a pointer, or nothing when v goes there by itself or they are no such pair
func text_of_c(v: Value, to: i64) -> &strview:
    from := comp.types[v.type].name
    if (to == CSTR or to == WSTR) and points_to(v.type, comp.types[to].elem):
        return from + " requires an explicit 'as " + comp.types[to].name + "' cast to promise null-terminated C text"
    if (v.type == CSTR or v.type == WSTR) and points_to(to, comp.types[v.type].elem):
        return from + " requires an explicit 'as " + comp.types[to].name + "' cast"
    if points_to(to, U8) and textual(v.type):
        return "Flag text does not convert to *u8; C text uses 'cstr'"
    if to == CSTR and from == "&str":
        return "convert &str to C text with cstr(s) (temporary copy) or c_text(s) (appends a trailing 0 byte)"
    if to == CSTR and textual(v.type) and not v.lit:
        return "convert &strview to C text with cstr(s) (temporary copy)"
    if to == WSTR and textual(v.type):
        return "convert Flag text to UTF-16 wstr with wstr(s) (temporary copy)"
    if v.type == CSTR and textual(to):
        return "convert cstr to &strview with view(c) (computes length)"
    if v.type == WSTR and textual(to):
        return "convert UTF-16 wstr to UTF-8 &strview with tmp(w) (temporary copy)"
    return ""

func widens(from: i64, to: i64) -> bool:
    a := comp.types[from]
    b := comp.types[to]
    return integer(from) and integer(to) and b.size > a.size and (a.kind == b.kind or a.kind == Uint)

func offers(name: &strview, args: &listview[Value], at: i64) -> bool|Fail:
    names: &list[&strview] = heap([])
    return try choose(name, "", args, names, at) != 0

func noted(at: i64, name: &strview = "") -> bool:
    return comp.asked != 0 and comp.tokens[comp.asked - 1].at == at and (name.len == 0 or comp.tokens[comp.asked - 1].text == name)

func described(name: &strview, t: i64) -> &strview:
    out: &str = heap("")
    out += name + ": " + comp.types[t].name
    return view(out)

func callable(s: i64, module: &strview, args: &listview[Value], at: i64) -> bool:
    sym := comp.syms[s]
    if comp.nodes[sym.node].kind != Func:
        return false
    if visible(s, module, at):
        return true
    if module.len > 0 or sym.priv:
        return false
    for a in args:
        if brings(a.type, sym.module):
            return true
    return false

# a type brings the functions of the module of every type named in it: a.Table[b.Door] brings those of a and of b
func brings(t: i64, module: &strview) -> bool:
    ty := comp.types[t]
    if ty.decl != 0 and module == comp.files[file_of(comp.tokens[comp.nodes[ty.decl].tok].at)].module:
        return true
    if ty.kind == Ptr or ty.kind == Array or ty.kind == Simd or ty.kind == Thread or ty.kind == Given or ty.kind == Atomic:
        return brings(ty.elem, module)
    if ty.kind == Func and brings(ty.ret, module):
        return true
    if ty.kind == Union or ty.kind == Untagged or ty.kind == Func or tuple(t):
        for i in 0..ty.count:
            if brings(comp.items[ty.first + i].type, module):
                return true
    if ty.kind == Struct and not tuple(t) or ty.kind == Fat:
        for i in 0..type_params(ty.decl):
            if brings(comp.items[ty.args + i].type, module):
                return true
    return false

func holds(n: i64) -> bool|Fail:
    try deeper(at_of(n))
    defer comp.depth -= 1
    node := comp.nodes[n]
    o := text(n)
    left := n + 1
    if node.kind == Unary and o == "not":
        return not try holds(left)
    if node.kind == Binary and (o == "and" or o == "or"):
        chain: &list[i64] = heap([])
        c := n
        while comp.nodes[c].kind == Binary and (text(c) == "and" or text(c) == "or"):
            append(chain, c)
            c += 1
        result := try holds(c)
        for k in reverse chain:
            other := try holds(node_end(k + 1))
            if text(k) == "and":
                result = result and other
            else:
                result = result or other
        return result
    if node.kind == Binary and o == "is":
        return within(try resolve(left), try resolve(node_end(left)))
    if node.kind == Binary and (o == "==" or o == "!="):
        b := bound(text(left))
        if b == 0:
            b = bound(text(node_end(left)))
        if b != 0 and comp.binds[b - 1].type != VOID:
            return (try resolve(left) == try resolve(node_end(left))) == (o == "==")
    v := try gen(n, VOID)
    if v.type != BOOL or v.at.kind != Const:
        return fail("'where' condition must be a compile-time constant expression", at_of(n))
    return v.at.n == 1

func assignable(to: i64, from: i64, at: i64) -> bool|Fail:
    v := Value{type = from}
    args: &list[Value] = heap([])
    append(args, Value{type = to, mem = true})
    append(args, v)
    if accepts(to, v) >= 0 or try offers("=", args, at):
        return true
    if comp.types[from].kind != Union:
        return false
    for m in members(from):
        if not try assignable(to, m, at):
            return false
    return true

func convert_number(v: Value, to: i64, at: i64) -> Value|Fail:
    from := comp.types[v.type]
    target := comp.types[to]
    if not numeric(v.type) and from.kind != Bool:
        return fail(target.name + "() only converts numeric or bool values, not " + from.name, at)
    if v.lit and (integer(v.type) or target.kind == Float):
        typed := try convert(v, to, Arg{}, at)
        typed.lit = false
        return typed
    if v.type == to:
        return v
    x := load(v).at
    if from.kind == Float and target.kind == Float:
        if to == F64:
            return Value{type = to, at = op1(D, "exts", x)}
        return Value{type = to, at = op1(S, "truncd", x)}
    if from.kind == Float:
        wide := x
        if from.size == 4:
            wide = op1(D, "exts", x)
        low := 0
        name: &strview = "dtoui"
        if target.kind == Int:
            low = 0 - i64(largest(to)) - 1
            name = "dtosi"
        top := Arg{Double, f64(largest(to)) as i64}
        bottom := Arg{Double, f64(low) as i64}
        if wide.kind == Double and (wide.n as f64) > f64(low) and (wide.n as f64) < f64(largest(to)): # a number the compiler knows, inside the range
            return Value{type = to, at = extend(to, op1(cls(to), name, wide))}
        slot := alloc(to)
        try zero(to, slot)
        l_number := label()
        l_high := label()
        l_low := label()
        l_below := label()
        l_inside := label()
        l_done := label()
        branch(op(W, "ceqd", wide, wide), l_number, l_done)
        open_block(l_number)
        branch(op(W, "cged", wide, top), l_high, l_low)
        open_block(l_high)
        store(to, Value{type = to, at = int_arg(i64(largest(to)))}, slot)
        jump(l_done)
        open_block(l_low)
        branch(op(W, "cled", wide, bottom), l_below, l_inside)
        open_block(l_below)
        store(to, Value{type = to, at = int_arg(low)}, slot)
        jump(l_done)
        open_block(l_inside)
        store(to, Value{type = to, at = extend(to, op1(cls(to), name, wide))}, slot)
        jump(l_done)
        open_block(l_done)
        return load(Value{type = to, at = slot, mem = true})
    if target.kind == Float:
        if from.kind == Uint and from.size == 4:
            return Value{type = to, at = op1(cls(to), "ultof", op1(L, "extuw", x))}
        name: &str = heap("u")
        if from.kind == Int:
            name = "s"
        if from.size == 8:
            name += "ltof"
        else:
            name += "wtof"
        return Value{type = to, at = op1(cls(to), view(name), x)}
    if target.size == 8 and from.size < 8:
        if from.kind == Int:
            return Value{type = to, at = op1(L, "extsw", x)}
        return Value{type = to, at = op1(L, "extuw", x)}
    if target.size < 8 and from.size == 8:
        x = op1(W, "copy", x)
    return Value{type = to, at = extend(to, x)}

# held says that addr holds a value already, so an owner there copies a view into its memory, and a new one has none
func assign(addr: Arg, t: i64, v: Value, at: i64, held: bool = false) -> Fail?:
    if comp.types[t].kind == Fat and comp.types[v.type].kind == Ptr and (points_to(v.type, BYTES) or points_to(v.type, element(t))):
        store(v.type, v, addr)
        return null
    dest := addr
    if owner(t) and not held:
        dest = Arg{}
    converted := try convert(v, t, dest, at)
    if not converted.mem or converted.at.kind != addr.kind or converted.at.n != addr.n:
        store(t, converted, addr)
    return null
