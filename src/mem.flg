                if o.to != 0 and o.blob:
                    define(o.to, Target{slot = o.slot + 1})
                elif o.to != 0:
                    define(o.to, translate(mem.fns[g].ret))
        case Fresh, Arena:
            touch_args(o)
            from := mem.callees[o.callee]
            h := birth((u64(i) << 16) or SITE, Obj{kind = Heap, site = i64(i), born = i64(i), pos = o.pos, from = from[1:], arena = o.code == Arena})
