@trust
use bits

ANY = -1
NONE = -1
FULL = 0xffff_ffff_ffff_ffff
EVERY = 1 # the layout where any word may hold a pointer, after 0 where none does
ALL = 0xffff_ffff
DROPPED = 1 << 31
AGED = 1 << 63
POOLED = 1 << 62

EXACT = 4096
FAR = 1 << 30
RUN = 1 << 18
HOPS = 3
VISITS = 30
ROUNDS = 20

SLOTS = 1024
FNVBASIS = 0xcbf2_9ce4_8422_2325
FNVPRIME = 0x100_0000_01b3

NOWHERE = 0
OUTSIDE = 1
STATIC = 2
GONE = 3
RETURNED = 4

PARAM = 1
FIELD = 2
SHARED = 3
SITE = 4
GLOBAL = 5
RECURSIVE = 6
FIXED = 7
PLACE = 8
BLOCKS = 9
COPY = 10
ENDED = 11
FOCUS = 12
VISITED = 13
ROUND = 14
HELD = 15
NOW = 16
MEMBERS = 1 << 13

UNSETTLED = "its memory state did not converge"
UNFOLLOWED = "-memory cannot track a pointer after it is stored into C-allocated memory"

type enum Code:
    Alloc, Load, Word, Store, Clear, Blit, Offset, Count, Scale, Mix, Plain, Call, Locks, Unlocks, Emptied, Fresh, Arena, Rewind, Take, Reclaim, Grow, Resize, Release, Discard, Launch, Reap, Detach, Settle, Give, Taken, Copy, Fill, Absent, Ended, Round, Walked, Narrowed, Counted, Reused, Part, Parse, Stop, Extern, Goto, Fork, Leave, Halt

type enum Kind:
    Pinned, Heap, Entry, Shared, Slot, Focus

type Operand:
    n: i64
    temp: u32
    data: u32

type Op:
    pos: i64
    shape: u32 # the layout of what it copies
    a: Operand
    b: Operand
    to: u32
    first: u32
    count: u32
    callee: u32
    slot: u32
    size: u32
    from: u32
    upto: u32
    member: u32
    code: Code
    blob: bool
    named: bool
    ghost: bool
    atomic: bool

type Span:
    first: u32
    end: u32
    yes: u32
    no: u32

type Set = Bits[16]

type enum Reach:
    ByLive, ByMust, ByAny, FromGlobals, FromValue

type Target:
    live: Set
    dead: Set
    must: Set
    off: i32
    stride: i32
    count: u32
    slot: u32
    member: u32
    writer: u32
    killer: i64
    element: bool
    part: bool # through a slice that leaves out some of a list

type Cell:
    owner: u32
    next: u32
    off: i32
    stride: i32
    count: u32
    member: u32

type Obj:
    key: u64
    pos: i64
    sent: i64
    name: &strview = ""
    from: &strview = ""
    parent: i64
    root: i64
    depth: u32
    off: i32
    stride: i32
    count: u32
    member: u32
    born: i64
    home: u32
    kind: Kind
    many: bool
    strict: bool
    arena: bool
    pool: bool
    loose: bool
    element: bool
    twice: bool # in more than one element of a list, so a round of a walk doesn't have it as its own
    thread: bool
    alone: bool
    core: bool # in a context of core
    taken: bool # pop or remove took it out of its list
    part: bool # freed through a slice that leaves out some of a list
    shape: u32 # the layout of the element of a round

type Marks:
    live: Set
    freed: Set
    killed: Set
    sure: Set
    gone: Set
    used: Set
    made: Set
    waited: Set

# the threads at a point: the blocks of the ones that may run, the walks in whose round each was started, an object for each pair, the locks taken, each an object of its own, and the threads of the callers waited on every path
type Runs:
    running: Set
    now: Set
    locks: Set
    joined: Set

# memory that a function reads or writes, that another thread may use at the same time
type Touch:
    owner: u32
    off: i32
    stride: i32
    count: u32
    size: u32
    locks: Set
    after: Set # the threads waited before it
    wrote: bool
    atomic: bool # it races only with a write that is not atomic

# what a thread touches, by the block that stands for it, or the function itself with block NONE
type Footprint:
    block: i64
    at: i64
    touch: Touch

type State:
    ids: &list[u32] = heap([])
    vals: &list[u32] = heap([])
    temps: &list[u32] = heap([])
    marks: Marks
    runs: Runs
    seen: bool

type Summary:
    ids: &list[u32] = heap([])
    aims: &list[Target] = heap([])
    marks: Marks
    seen: bool

type Write:
    value: Target
    id: i64
    strong: bool

# blocks that a call may have moved through a place, which holds them still where it did not
type Regrown:
    at: Target
    blocks: Set

type Warning:
    text: &strview
    at: i64
    note: &strview
    also: i64
    strict: bool

type Fn:
    name: &strview = ""
    shown: &strview = ""
    params: &list[u32] = heap([])
    copies: &list[bool] = heap([])
    values: &list[i64] = heap([]) # what each parameter takes by value, also a big struct that QBE gets by its address
    spans: &list[Span] = heap([])
    names: &list[&strview] = heap([])
    variables: &list[bool] = heap([]) # a temp that is a variable keeps its name, a slot of temporaries takes the name of what it holds
    places: &list[i64] = heap([])
    cross: &list[bool] = heap([])
    last: &list[u32] = heap([])
    crossing: &list[u32] = heap([])
    calls: &list[i64] = heap([])
    swaps: &list[u32] = heap([])
    slots: &list[u32] = heap([])
    alive: &list[u64] = heap([])
    keys: &list[u64] = heap([])
    objs: &list[Obj] = heap([])
    cells: &list[Cell] = heap([])
    heads: &list[u32] = heap([])
    found: &list[Warning] = heap([])
    touches: &list[Footprint] = heap([]) # of the memory its callers see, and of the threads it leaves running
    sum: Summary
    ret: Target
    heaps: Set
    outer: Set
    roots: Set
    many: Set
    far: Set
    focus: Set # the element of a round of a walk, and the ones it visited
    walks: bool # it has one of those
    arenas: Set
    relevant: Set
    global: Set
    size: i64
    at: i64
    order: i64
    low: i64
    group: i64
    strict: bool
    blob: bool
    settles: bool
    stacked: bool
    dirty: bool
    done: bool
    deep: bool # it changes memory past HOPS pointers, which its callers don't follow
    guarded: bool # of core, it copies a view of the memory it grows before it reads it, as the += of text does
    takes: bool # of core, pop or remove
    stuck: &strview = ""
    stuck_in: i64
    runs: i64
    node: i64
    inst: i64

context mem:
    pinned: Set
    fns: &list[Fn] = heap([])
    ids: &map[&strview, i64] = heap({})
    shared: &map[&strview, u32] = heap({})
    globals: &list[&strview] = heap([])
    apart: &list[i64] = heap([]) # per global, the type of a context of the program that a thread of parallel starts with its own of
    local: &list[bool] = heap([]) # per global, a context that no other thread sees, or that the runtime of core keeps in order
    core: &list[bool] = heap([]) # per global, a context of core
    layouts: &list[&list[u64]] = heap([]) # a bit for each word that holds a pointer
    shaped: &map[i64, u32] = heap({}) # the layout of a type, and of the owners in it
    threaded: bool # the program starts threads
    arena: u32 # the size of an Arena of core, whose words its operations touch
    footprints: &list[Footprint] = heap([]) # of the threads this function starts, and of those that its calls leave running
    starting: &list[Touch] = heap([]) # what the thread that the next launch starts touches
    passed: &list[Touch] = heap([])
    touched: &map[Touch, bool] = heap({})
    callees: &list[&strview] = heap([])
    ops: &list[Op] = heap([])
    args: &list[Operand] = heap([])
    f: i64
    fn: Fn
    here: u32
    words: i64
    viewed: bool
    temps: &list[Target] = heap([])
    active: &list[u32] = heap([])
    cur: &list[Target] = heap([])
    fresh: &list[u32] = heap([])
    ticked: &list[u32] = heap([])
    present: &list[u32] = heap([])
    known: &list[u32] = heap([])
    pool: &list[Target] = heap([])
    pooled: &map[Target, u32] = heap({})
    refs: &list[&list[u32]] = heap([])
    swept: &list[u64] = heap([])
    interned: &list[u32] = heap([])
    renamed: &list[u32] = heap([])
    ages: u32
    tick: u32
    marks: Marks
    runs: Runs
    seen: bool
    ins: &list[State] = heap([])
    held: &list[u64] = heap([])
    pointed: &list[u64] = heap([]) # the slots that a cell holds a pointer into, by bit
    walking: &list[i64] = heap([]) # the lists and arrays that a walk that ends keeps up to date
    rounding: bool # this function has the element of a round in place
    exit: State
    ret: Target
    final: bool
    speak: bool
    condemned: Set
    strong: Set
    released: Set # what a free condemned, not a move
    callee: i64
    call: u32
    who: &strview = ""
    binds: &list[Target] = heap([])
    bound: Set
    writes: &list[Write] = heap([])
    regrown: &list[Regrown] = heap([])
    order: &list[u64] = heap([])
    warnings: &list[Warning] = heap([])
    said: &map[&strview, bool] = heap({})
    index: &map[u64, u32] = heap({})
    counter: i64
    stack: &list[i64] = heap([])

operator <(a: Warning, b: Warning) -> bool:
    return a.at < b.at

func check_memory():
    mem.pinned = bit(NOWHERE) or bit(OUTSIDE) or bit(STATIC)
    for t in comp.types:
        if t.kind == Struct and t.decl != 0 and file_of(comp.tokens[comp.nodes[t.decl].tok].at) == 0 and text(t.decl) == "Arena":
            mem.arena = u32(t.size)
    append(mem.layouts, heap([]))
    append(mem.layouts, heap([FULL]))
    labels: &map[u32, u32] = heap({})
    defer free(labels)
    blocks: &list[u32] = heap([])
    defer free(blocks)
    born: &list[u32] = heap([])
    defer free(born)
    derived: &list[u32] = heap([])
    defer free(derived)
    aims: &list[&strview] = heap([])
    defer free(aims)
    held: &list[&strview] = heap([])
    defer free(held)
    ways: &list[u32] = heap([])
    defer free(ways)
    for func in comp.procs:
        clear(labels)
        blocks.len = 0
        f: Fn
        f.name = func.name
        f.shown = func.name[1:]
        f.blob = func.cls >= AGG
        f.node = func.node
        f.inst = func.inst
        if func.node != 0:
            f.shown = text(func.node)
            if comp.tokens[comp.nodes[func.node].tok].kind != Name:
                quoted: &str = heap("'")
                quoted += text(func.node) + "'"
                f.shown = view(quoted)
        for k in func.temps..func.last + 2:
            append(f.names, "")
            append(f.variables, false)
        for k in func.params..func.params + func.count:
            p := comp.passes[k]
            t := u32(p.arg.n) + 1 - func.temps
            if p.cls != Int64 and p.cls < AGG or p.number:
                t = 0
            append(f.params, t)
            append(f.copies, p.cls >= AGG)
            append(f.values, p.value)
        for k in func.mentions..func.mentioned:
            f.names[comp.mentions[k].temp + 1 - func.temps] = comp.mentions[k].name
            f.variables[comp.mentions[k].temp + 1 - func.temps] = true
        append(f.spans, Span{first = u32(mem.ops.len)})
        for k in func.code..func.end:
            i := comp.code[k]
            if f.at == 0:
                f.at = i.pos
            if i.op == Olabel:
                begin(f.spans, blocks, block_of(labels, blocks, u32(i.a.n)))
                continue
            o := Op{pos = i.pos, shape = EVERY, member = i.member, ghost = i.ghost}
            if i.copy:
                o.shape = layout(i.shape, false)
            if i.to != 0:
                o.to = i.to + 1 - func.temps
                o.blob = i.cls >= AGG
            if i.op == Ocall and i.a.kind == Global and comp.globals[i.a.n] == "$flag.stamp" and func.export and func.inst != comp.entry: # a thread new to an export turns the zeros of its contexts into their defaults, and neither holds memory
                continue
            if i.op == Otable: # two ways at a time: a fork to each block of the table in turn, and a goto to the last one
                ways.len = 0
                for given in comp.passes[i.first:i.first + i.count]:
                    append(ways, u32(given.arg.n))
                sort(ways)
                for n, way in ways:
                    if n + 1 < ways.len and ways[n + 1] == way:
                        continue
                    to := block_of(labels, blocks, way)
                    if n + 1 == ways.len:
                        append(mem.ops, Op{pos = i.pos, code = Goto, a = Operand{n = i64(to)}})
                        continue
                    append(mem.ops, Op{pos = i.pos, code = Fork, a = Operand{n = i64(to)}, b = Operand{n = i64(blocks.len)}})
                    append(blocks, u32(0))
                    begin(f.spans, blocks, u32(blocks.len) - 1)
                continue
            if i.op == Ocall:
                o.code = Call
                o.first = u32(mem.args.len)
                for j in i.first..i.first + i.count:
                    if comp.passes[j].cls != Nothing:
                        append(mem.args, operand(func.temps, comp.passes[j].arg))
                o.count = u32(mem.args.len) - o.first
                if o.blob:
                    o.slot = u32(f.slots.len)
                    append(f.slots, o.to)
                if i.a.kind == Global:
                    o.callee = u32(mem.callees.len)
                    append(mem.callees, comp.globals[i.a.n])
                    append(mem.ops, o)
                    continue
                aims.len = 0
                if i.c.n != VOID and not comp.types[i.c.n].foreign: # without closures a function value is one of the functions taken as its type, each a path
                    for p in comp.procs:
                        if comp.insts[p.inst].name == p.name and comp.insts[p.inst].taken_as == i.c.n:
                            append(aims, p.name)
                    variable := 0 # a local that only ever holds named functions calls one of those
                    for c in comp.code[func.code:func.end]:
                        if c.to == i.a.n and c.op == Oload and c.cls == Int64 and c.a.kind == Temp:
                            variable = c.a.n
                    held.len = 0
                    for c in comp.code[func.code:func.end]:
                        if variable != 0 and c.op == Ostorei64 and c.b.kind == Temp and c.b.n == variable:
                            if c.a.kind == Global and contains(aims, comp.globals[c.a.n]):
                                append(held, comp.globals[c.a.n])
                            elif c.a.kind != Const or c.a.n != 0:
                                variable = 0
                        elif variable != 0 and not (c.op == Oload and c.cls == Int64) and (c.a.kind == Temp and c.a.n == variable or c.b.kind == Temp and c.b.n == variable or c.c.kind == Temp and c.c.n == variable):
                            variable = 0
                        elif variable != 0 and c.op == Ocall:
                            for j in c.first..c.first + c.count:
                                if comp.passes[j].arg.kind == Temp and comp.passes[j].arg.n == variable:
                                    variable = 0
                    if variable != 0 and held.len > 0:
                        aims.len = 0
                        for h in held:
                            if not contains(aims, h):
                                append(aims, h)
                if aims.len == 0:
                    append(aims, "")
                join := u32(blocks.len)
                if aims.len > 1:
                    append(blocks, u32(0))
                for n, aim in aims:
                    if n + 1 < aims.len:
                        append(mem.ops, Op{pos = i.pos, code = Fork, a = Operand{n = i64(blocks.len)}, b = Operand{n = i64(blocks.len) + 1}})
                        append(blocks, u32(0))
                        append(blocks, u32(0))
                        begin(f.spans, blocks, u32(blocks.len) - 2)
                    o.callee = u32(mem.callees.len)
                    append(mem.callees, aim)
                    append(mem.ops, o)
                    if n + 1 < aims.len:
                        append(mem.ops, Op{pos = i.pos, code = Goto, a = Operand{n = i64(join)}})
                        begin(f.spans, blocks, u32(blocks.len) - 1)
                if aims.len > 1:
                    begin(f.spans, blocks, join)
                continue
            o.a = operand(func.temps, i.a)
            o.b = operand(func.temps, i.b)
            if is_alloc(i.op):
                o.code = Alloc
                o.slot = u32(f.slots.len)
                append(f.slots, o.to)
            elif is_load(i.op) or is_store(i.op):
                o.code = Clear
                if i.op == Oload and i.cls == Int64 and not i.number:
                    o.code = Load
                elif is_load(i.op):
                    o.code = Word
                elif i.op == Ostorei64 and not i.number:
                    o.code = Store
                access := Instr{op = i32(i.op), cls = i32(i.cls)}
                o.size = u32(load_size(access) if is_load(i.op) else store_size(access))
            else:
                switch i.op:
                case Oblit:
                    o.code = Blit
                    o.size = u32(i.c.n)
                case Oabsent:
                    o.code = Absent
                    o.size = u32(i.c.n)
                case Oadd, Ocopy:
                    o.code = Offset
                    o.count = i.count
                    o.from = i.first # the walk whose element of the round this is
                    if i.number:
                        o.code = Count
                case Omul:
                    o.code = Scale
                case Osub, Oand, Oor, Oxor, Oshl, Oshr, Osar, Oudiv, Odiv, Orem, Ourem, Oneg, Oexti32, Oextu32, Oexti8, Oextu8, Oexti16, Oextu16:
                    o.code = Mix
                    o.size = u32(i.op == Osub)
                    if i.number:
                        o.code = Plain
                case Ojump:
                    o.code = Goto
                    o.a.n = i64(block_of(labels, blocks, u32(i.a.n)))
                case Obranch:
                    o.code = Fork
                    o.a.n = i64(block_of(labels, blocks, u32(i.b.n)))
                    o.b.n = i64(block_of(labels, blocks, u32(i.c.n)))
                    test := comp.code[k - 1]
                    if test.to == i.a.n and (test.op == Oeqi64 or test.op == Onei64) and test.a.kind == Temp and test.b.kind == Const and test.b.n == 0: # a pointer against null, whose side size - 1 is null
                        o.from = u32(test.a.n) + 1 - func.temps
                        o.size = 1 if test.op == Oeqi64 else 2
                case Oreturn:
                    o.code = Leave
                    if f.blob: # the value goes back like a blit into the caller's place
                        t := func.cls - AGG
                        if func.cls >= CAGG:
                            t = func.cls - CAGG
                        o.size = u32(comp.types[t].size)
                        o.shape = layout(t, false)
                case Ohalt:
                    o.code = Halt
                case Oended:
                    o.code = Ended
                case Oround:
                    o.code = Round
                    o.size = u32(i.c.n)
                case Owalked:
                    o.code = Walked
                    o.size = u32(i.c.n)
                case Onarrowed:
                    o.code = Narrowed
                case Ocounted:
                    o.code = Counted
                case Oreused:
                    o.code = Reused
                case Opart:
                    o.code = Part
                case Oatomicload, Oatomicadd, Oatomicswap, Oatomicexpected: # each reads the word at a, then the others write it, swap with b and acas with c, as if it always did
                    o.code = Word
                    o.atomic = true
                    o.size = 4 << u32(i.cls == Int64)
                    if i.cls == Int64 and not i.number:
                        o.code = Load
                    if i.op != Oatomicload:
                        append(mem.ops, o)
                        o.to = 0
                        o.b = o.a
                        o.code = Clear
                        if not i.number:
                            o.code = Store
                            o.a = operand(func.temps, i.c if i.op == Oatomicexpected else i.b)
                case Oatomicstorei64, Oatomicstorei32:
                    o.code = Clear
                    o.atomic = true
                    o.size = 4 << u32(i.op == Oatomicstorei64)
                    if i.op == Oatomicstorei64 and not i.number:
                        o.code = Store
                case:
                    o.code = Plain
            append(mem.ops, o)
        f.spans[-1].end = u32(mem.ops.len)
        f.size = mem.ops.len - f.spans[0].first
        born.len = 0
        derived.len = 0
        for t in 0..f.names.len:
            append(born, u32(0))
            append(derived, u32(0))
            append(f.cross, false)
            append(f.last, u32(0))
        for t in f.params:
            born[t] = 1
            f.cross[t] = t != 0
        for s in 0..f.spans.len:
            span := f.spans[s]
            if span.end > span.first:
                last := mem.ops[span.end - 1]
                if last.code == Goto:
                    f.spans[s].yes = blocks[last.a.n] + 1
                elif last.code == Fork:
                    f.spans[s].yes = blocks[last.a.n] + 1
                    f.spans[s].no = blocks[last.b.n] + 1
                elif last.code != Leave and last.code != Halt and s + 1 < f.spans.len:
                    f.spans[s].yes = u32(s + 2)
            elif s + 1 < f.spans.len:
                f.spans[s].yes = u32(s + 2)
            for k in span.first..span.end:
                o := mem.ops[k]
                if o.to != 0:
                    born[o.to] = u32(s + 1)
                if o.code == Alloc or o.code == Call and o.blob:
                    derived[o.to] = o.slot + 1
                elif o.code == Offset and o.b.temp == 0 and o.b.data == 0:
                    derived[o.to] = derived[o.a.temp]
        words := (f.slots.len + 63) / 64
        for k in 0..f.spans.len * words:
            append(f.alive, u64(0))
        for s in 0..f.spans.len:
            for k in f.spans[s].first..f.spans[s].end:
                o := mem.ops[k]
                count := 2
                if o.code == Call:
                    count = 2 + i64(o.count)
                for m in 0..count:
                    t := o.a.temp
                    if m == 1:
                        t = o.b.temp
                    elif m > 1:
                        t = mem.args[o.first + m - 2].temp
                    if t != 0 and born[t] != u32(s + 1):
                        f.cross[t] = true
                    f.last[t] = u32(k)
                    if derived[t] != 0:
                        d := i64(derived[t] - 1)
                        f.alive[s * words + d / 64] = f.alive[s * words + d / 64] or (u64(1) << u64(d % 64))
        grew := true
        while grew:
            grew = false
            s := f.spans.len
            while s > 0:
                s -= 1
                for side in 0..2:
                    next := f.spans[s].yes
                    if side == 1:
                        next = f.spans[s].no
                    if next != 0:
                        for w in 0..words:
                            x := f.alive[s * words + w] or f.alive[(next - 1) * words + w]
                            if x != f.alive[s * words + w]:
                                f.alive[s * words + w] = x
                                grew = true
        for t in 0..f.names.len:
            if f.cross[t] and derived[t] != 0:
                f.cross[t] = false
            if f.cross[t]:
                append(f.crossing, u32(t))
        put(mem.ids, f.name, mem.fns.len)
        append(mem.fns, f)
    exact: &list[bool] = heap([]) # the name is the path the program wrote, not an element of it
    defer free(exact)
    for g in 0..mem.fns.len:
        spans := mem.fns[g].spans
        proc := comp.procs[g]
        places := mem.fns[g].places
        exact.len = 0
        for t in mem.fns[g].names:
            append(places, VOID)
            append(exact, false)
        for m in comp.mentions[proc.mentions:proc.mentioned]:
            t := m.temp + 1 - proc.temps
            exact[t] = true
            places[t] = m.type # what the slot of a variable holds
            if not aggregate(m.type) and not contains(mem.fns[g].slots, t):
                places[t] = pointee(m.type)
        mem.fns[g].places = places
        decl := mem.fns[g].node
        if decl != 0 and file_of(comp.tokens[comp.nodes[decl].tok].at) == 0 and (text(decl) == "+=" or text(decl) == "=" or text(decl) == "append") and params(decl) > 1:
            view := kid(decl, 1) + 1 # the type of the second parameter, a &strview or a &listview
            mem.fns[g].guarded = comp.nodes[view].kind == TUnary and text(view) == "&" and (text(view + 1) == "strview" or text(view + 1) == "listview")
        mem.fns[g].takes = decl != 0 and file_of(comp.tokens[comp.nodes[decl].tok].at) == 0 and (text(decl) == "pop" or text(decl) == "remove")
        for k in spans[0].first..spans[-1].end:
            if mem.ops[k].code == Call:
                name := mem.callees[mem.ops[k].callee]
                found := mem.ids[name]
                code: Code = Extern # what a function of C does, also one that core writes for wasm
                switch name:
                case "$malloc", "$calloc", "$realpath":
                    code = Fresh
                case "$realloc":
                    code = Grow
                case "$free":
                    code = Release
                case "$memcpy", "$memmove":
                    code = Copy
                case "$memset":
                    code = Fill
                case "$pthread_mutex_lock", "$AcquireSRWLockExclusive":
                    code = Taken
                case "$strtod":
                    code = Parse
                case "$exit", "$_exit":
                    code = Stop
                if found is i64 and code == Extern:
                    node := mem.fns[found].node
                    called := token_at(mem.ops[k].pos)
                    mem.ops[k].named = node != 0 and comp.tokens[called].text == text(node) and comp.tokens[called + 1].text == "(" # a for or a with calls the operator of its word without naming it
                    core := node != 0 and file_of(comp.tokens[comp.nodes[node].tok].at) == 0
                    closed: &strview = "" # the type that a with of core closes
                    if core and text(node) == "with" and comp.passes[comp.procs[found].params].cls >= AGG:
                        closed = comp.types[comp.passes[comp.procs[found].params].cls - AGG].name
                    if core and text(node) == "tmp" and comp.types[comp.insts[mem.fns[found].inst].ret].kind == Ptr:
                        mem.ops[k].code = Arena
                    elif core and text(node) == "detach":
                        mem.ops[k].code = Detach
                    elif core and text(node) == "ending":
                        mem.ops[k].code = Extern # the exit code of main, from the standard output, which is of core
                    elif core and text(node) == "launch":
                        mem.ops[k].code = Launch
                        mem.threaded = true
                    elif core and text(node) == "reap":
                        mem.ops[k].code = Reap
                    elif core and text(node) == "settle":
                        mem.ops[k].code = Settle
                        mem.fns[g].settles = true
                    elif core and text(node) == "send":
                        inst := comp.insts[mem.fns[found].inst]
                        for b in comp.inst_binds[inst.binds:inst.binds + inst.count]:
                            if b.name == "$T":
                                mem.ops[k].shape = layout(b.type, true)
                                if aggregate(b.type):
                                    mem.ops[k].size = u32(comp.types[b.type].size)
                        mem.ops[k].code = Give # what the value points to goes to the thread that receives it
                    elif closed == "Scratch":
                        mem.ops[k].code = Rewind
                        d := k
                        while d > spans[0].first and mem.ops[d].to != mem.args[mem.ops[k].first].temp:
                            d -= 1
                        mem.ops[k].from = u32(d)
                    elif core and text(node) == "take":
                        mem.ops[k].code = Take
                        mem.ops[k].callee = u32(found + 1)
                    elif core and text(node) == "resize":
                        mem.ops[k].code = Resize
                    elif core and text(node) == "discard":
                        mem.ops[k].code = Discard
                    elif core and text(node) == "reclaim":
                        mem.ops[k].code = Reclaim
                    else:
                        if core and (text(node) == "lock" or text(node) == "try_lock"): # a try_lock that fails holds nothing, and core touches nothing of the lock then
                            mem.ops[k].code = Locks
                        elif closed == "Locked":
                            mem.ops[k].code = Unlocks
                        elif core and text(node) == "clear" and starts_with(code_of(kid(node, 0) + 1), "*&list["):
                            mem.ops[k].code = Emptied
                        mem.ops[k].callee = u32(found + 1)
                        if not contains(mem.fns[g].calls, found):
                            append(mem.fns[g].calls, found)
                else:
                    mem.ops[k].code = code
            elif mem.ops[k].code == Walked:
                d := k
                while mem.ops[d].code != Round or mem.ops[d].b.n != mem.ops[k].b.n:
                    d -= 1
                mem.ops[k].from = u32(d) # the round of the walk, where its body starts
            o := mem.ops[k]
            if o.code == Store and o.a.temp != 0 and places[o.a.temp] == VOID:
                places[o.a.temp] = pointee(places[o.b.temp]) # a value has the type of the variable it goes to, like a parameter
                if contains(mem.fns[g].params, o.a.temp) and mem.fns[g].variables[o.b.temp]:
                    mem.fns[g].names[o.a.temp] = mem.fns[g].names[o.b.temp]
            heir := o.to
            from := o.a.temp
            if o.code == Blit:
                heir = o.b.temp
            elif o.code == Call and not o.named and o.count > 0:
                from = mem.args[o.first].temp
            elif o.code != Load and o.code != Offset and o.code != Mix:
                heir = 0
            if heir != 0 and (mem.fns[g].names[heir].len == 0 or o.code == Blit and not mem.fns[g].variables[heir]):
                name := mem.fns[g].names[from]
                place := places[from]
                field := o.code == Offset and o.b.temp == 0 and o.b.data == 0
                off := 0
                if field:
                    off = o.b.n
                elif o.code == Mix or o.code == Call or o.count != 0 and comp.types[place].kind != Array:
                    place = VOID
                elif o.count != 0:
                    place = comp.types[place].elem # an element of an array, and of a list it stays the element
                exact[heir] = exact[from] and (o.code == Load or o.code == Blit or field)
                while place != VOID and comp.types[place].kind == Struct and (o.code == Load or off > 0):
                    ty := comp.types[place]
                    place = VOID
                    for item in comp.items[ty.first:ty.first + ty.count]:
                        if not item.shared and item.n <= off and off < item.n + comp.types[item.type].size:
                            if exact[heir]:
                                path: &str = heap("")
                                path += name + "." + item.name
                                name = view(path)
                            place = item.type
                            off -= item.n
                            break
                if off != 0:
                    place = VOID
                elif o.code == Load and comp.types[place].kind == Fat:
                    place = element(place)
                elif o.code == Load:
                    place = pointee(place)
                places[heir] = place
                mem.fns[g].names[heir] = name
    closes: &list[i64] = heap([])
    defer free(closes)
    for k in 0..mem.ops.len:
        if mem.ops[k].code == Rewind:
            append(closes, k)
    for k in closes:
        for j in closes:
            if mem.ops[j].from == mem.ops[k].from and u32(j) > mem.ops[k].upto:
                mem.ops[k].upto = u32(j)
    none: Target
    while mem.binds.len < SLOTS:
        append(mem.binds, none)
    for g in 0..mem.fns.len:
        for t in comp.trusted:
            if t.check and t.from <= mem.fns[g].at and mem.fns[g].at < t.to:
                mem.fns[g].strict = true
    stamper := mem.ids["$flag.stamp"]
    if stamper is i64: # what the contexts of a thread start with, also in a library, where only exports would call it
        connect(stamper)
    for g in 0..mem.fns.len:
        node := mem.fns[g].node
        start := comp.tokens[comp.nodes[node].tok].at
        end := start
        for n in node..node_end(node):
            if comp.tokens[comp.nodes[n].tok].at > end:
                end = comp.tokens[comp.nodes[n].tok].at
        inner := innermost(start)
        hidden := inner.to != 0 and not inner.check
        for t in comp.trusted:
            hidden = hidden and not (t.check and t.from > start and t.from <= end)
        for c in mem.fns[g].calls:
            hidden = hidden and not mem.fns[c].strict
        if (node != 0 and not hidden or mem.fns[g].strict) and mem.fns[g].order == 0:
            connect(g)
    sort(mem.warnings)
    for w in mem.warnings:
        inner := innermost(w.at)
        hidden := inner.to != 0 and not inner.check
        if hidden and w.strict:
            low := token_at(w.at)
            while comp.tokens[low].kind != Line:
                low -= 1
            hidden = comp.tokens[low].at == inner.from
        if hidden:
            continue
        eprint(comp.warn, w.text)
        if w.at != 0:
            show(w.at)
        if w.also != 0:
            eprint(comp.note, w.note)
            show(w.also)

# the name of the argument t of a call to g, down to the field at its start that has the type of parameter k
func named(t: u32, g: i64, k: i64) -> &strview:
    name := mem.fn.names[t]
    place := mem.fn.places[t]
    want := mem.fns[g].places[mem.fns[g].params[k]]
    while want != VOID and place != want and place != VOID and comp.types[place].kind == Struct:
        ty := comp.types[place]
        place = VOID
        for item in comp.items[ty.first:ty.first + ty.count]:
            if item.n == 0 and not item.shared and comp.types[item.type].size > 0:
                path: &str = heap("")
                path += name + "." + item.name
                name = view(path)
                place = item.type
                break
    if place != want:
        return mem.fn.names[t]
    return name

func pointee(t: i64) -> i64:
    if comp.types[t].kind == Ptr:
        return comp.types[t].elem
    return VOID

func innermost(at: i64) -> Trust:
    found: Trust
    for t in comp.trusted:
        if t.from <= at and at < t.to and t.from >= found.from:
            found = t
    return found

func block_of(labels: *&map[u32, u32], blocks: *&list[u32], name: u32) -> u32:
    found := labels[name]
    if found is u32:
        return found
    put(labels, name, u32(blocks.len))
    append(blocks, u32(0))
    return u32(blocks.len - 1)

func begin(spans: *&list[Span], blocks: *&list[u32], block: u32):
    spans[-1].end = u32(mem.ops.len)
    blocks[block] = u32(spans.len)
    append(spans, Span{first = u32(mem.ops.len)})

func operand(first: u32, a: Arg) -> Operand:
    out: Operand
    if a.kind == Temp:
        out.temp = u32(a.n) + 1 - first
    elif a.kind == Global and (starts_with(comp.globals[a.n], "thread $ctx.") or starts_with(comp.globals[a.n], "$ctx.")):
        text := comp.globals[a.n]
        found := mem.shared[text]
        if found is u32:
            out.data = found + 2
        else:
            out.data = u32(mem.globals.len) + 2
            put(mem.shared, text, u32(mem.globals.len))
            append(mem.globals, text)
            t := comp.type_ids[text[trust find(text, "$ctx.") + "$ctx.".len:]] ifnull VOID
            core := t != VOID and file_of(comp.tokens[comp.nodes[comp.types[t].decl].tok].at) == 0
            mine := t != VOID and starts_with(text, "thread ") and declared(comp.types[t].decl) != "inherited"
            append(mem.local, core or mine)
            append(mem.core, core)
            if core or not starts_with(text, "thread "):
                t = VOID
            append(mem.apart, t)
    elif a.kind == Global:
        out.data = 1
    elif a.kind == Const:
        out.n = a.n
    return out

func connect(v: i64):
    mem.counter += 1
    mem.fns[v].order = mem.counter
    mem.fns[v].low = mem.counter
    append(mem.stack, v)
    mem.fns[v].stacked = true
    for w in mem.fns[v].calls:
        if mem.fns[w].order == 0:
            connect(w)
            if mem.fns[w].low < mem.fns[v].low:
                mem.fns[v].low = mem.fns[w].low
        elif mem.fns[w].stacked and mem.fns[w].order < mem.fns[v].low:
            mem.fns[v].low = mem.fns[w].order
    if mem.fns[v].low != mem.fns[v].order:
        return
    members: &list[i64] = heap([])
    defer free(members)
    while true:
        w := trust pop(mem.stack)
        mem.fns[w].stacked = false
        mem.fns[w].group = v + 1
        append(members, w)
        if w == v:
            break
    if members.len > 1 or contains(mem.fns[v].calls, v):
        for f in members:
            mem.fns[f].dirty = true
        budget := members.len * ROUNDS
        while budget > 0:
            picked := members.len
            for k in 0..members.len:
                if mem.fns[members[k]].dirty and (picked == members.len or mem.fns[members[k]].size < mem.fns[members[picked]].size):
                    picked = k
            if picked == members.len:
                break
            f := members[picked]
            mem.fns[f].dirty = false
            budget -= 1
            if analyze(f):
                for m in members:
                    if contains(mem.fns[m].calls, f):
                        mem.fns[m].dirty = true
    settled := true
    for f in members:
        settled = settled and not mem.fns[f].dirty and mem.fns[f].runs > 0
    for f in members:
        if mem.fns[f].dirty:
            mem.fns[f].stuck = UNSETTLED
        if not settled:
            analyze(f)
    for f in members:
        if mem.fns[f].stuck_in != 0:
            for m in members:
                mem.fns[m].stuck_in = mem.fns[f].stuck_in
            break
    for f in members:
        for w in mem.fns[f].found:
            key: &str = heap("")
            key += w.text + " " + w.at
            if contains(mem.said, view(key)):
                free(key)
            else:
                put(mem.said, view(key), true)
                append(mem.warnings, w)
        free(mem.fns[f].found)

func analyze(f: i64) -> bool:
    mem.f = f
    mem.fn = mem.fns[f]
    mem.fn.runs += 1
    mem.fn.found.len = 0
    mem.fn.touches = heap([])
    clear(mem.touched)
    mem.footprints.len = 0
    mem.starting.len = 0
    mem.words = (mem.fn.slots.len + 63) / 64
    mem.rounding = false
    mem.pointed.len = 0
    for w in 0..mem.words:
        append(mem.pointed, u64(0))
    clear(mem.index)
    for k in 0..mem.fn.keys.len:
        mem.index[mem.fn.keys[k]] = u32(k)
    mem.viewed = false
    for c in mem.fn.cells:
        mem.viewed = mem.viewed or c.member != 0
    if mem.fn.objs.len == 0:
        mem.fn.keys = malloc(SLOTS * @sizeof(u64))
        mem.fn.keys.cap = SLOTS
        mem.fn.objs = malloc(SLOTS * @sizeof(Obj))
        mem.fn.objs.cap = SLOTS
        for k in 0..=RETURNED:
            kind: Kind = Pinned
            if k == RETURNED:
                kind = Slot
            object((u64(k) << 8) or FIXED, Obj{kind = kind})
        for k in 0..SLOTS + mem.fn.slots.len:
            append(mem.fn.heads, u32(0))
    blank: Target
    grow_cells()
    mem.pool.len = 0
    clear(mem.pooled)
    while mem.refs.len < SLOTS:
        nothing: &list[u32] = heap([])
        append(mem.refs, nothing)
        append(mem.swept, u64(0))
    for k in 0..SLOTS:
        mem.refs[k].len = 0
    while mem.temps.len < mem.fn.names.len:
        append(mem.temps, blank)
        append(mem.interned, u32(0))
    for t in 0..mem.fn.names.len:
        mem.temps[t] = blank
        mem.interned[t] = 0
    params := mem.fn.params
    for k in 0..params.len:
        if params[k] != 0:
            e := object((u64(k) << 8) or PARAM, Obj{kind = Entry, root = k + 1, name = mem.fn.names[params[k]]})
            mem.temps[params[k]] = Target{live = bit(e), must = bit(e)}
    spans := mem.fn.spans
    none: State
    queued: &list[bool] = heap([])
    defer free(queued)
    for b in 0..spans.len:
        append(mem.ins, none)
        append(queued, false)
    mem.ins[0].seen = true
    for t in mem.fn.crossing:
        append(mem.ins[0].temps, intern(mem.temps[t]))
    queued[0] = true
    low := 0
    visits := 0
    while true:
        while low < spans.len and not queued[low]:
            low += 1
        if low == spans.len:
            break
        b := low
        queued[b] = false
        visits += 1
        if visits > spans.len * VISITS + 100:
            mem.fn.stuck = UNSETTLED
            break
        visit(b)
        if mem.seen:
            out := snapshot()
            mem.held.len = 0
            for w in 0..mem.words:
                append(mem.held, u64(0))
            for v in out.vals:
                hold(mem.pool[v].slot)
            for v in out.temps:
                hold(mem.pool[v].slot)
            failed := out
            nulled := NONE
            last := spans[b].end - 1
            if spans[b].end > spans[b].first and mem.ops[last].code == Fork and mem.ops[last].size != 0 and mem.temps[mem.ops[last].from].killer != 0 and empty(mem.temps[mem.ops[last].from].dead): # realloc gave null: it moved nothing and made nothing
                tested := mem.temps[mem.ops[last].from]
                held := objects(tested.live)
                made := held and mem.fn.heaps
                for id in mem.present:
                    if mem.ticked[id] == mem.tick and cell_value(id).killer == tested.killer and not empty(cell_value(id).dead and held):
                        made = made - cell_value(id).dead
                        rewrite(i64(id), unmoved(cell_value(id), held))
                for t in mem.fn.crossing:
                    if mem.temps[t].killer == tested.killer and not empty(mem.temps[t].dead and held):
                        mem.temps[t] = unmoved(mem.temps[t], held)
                        mem.interned[t] = 0
                mem.marks.sure = mem.marks.sure - held
                vanish(made)
                nulled = i64(mem.ops[last].size) - 1
                failed = snapshot()
            for side in 0..2:
                s := spans[b].yes
                if side == 1:
                    s = spans[b].no
                if s != 0:
                    old := mem.ins[s - 1]
                    joined := merge(old, failed if side == nulled else out, s - 1)
                    if old.seen and joined == old:
                        release(joined)
                    else:
                        release(old)
                        mem.ins[s - 1] = joined
                        queued[s - 1] = true
                        if s - 1 < low:
                            low = s - 1
            if nulled != NONE:
                release(failed)
            release(out)
    mem.final = true
    mem.speak = true
    release(mem.exit)
    mem.exit = none
    mem.ret = blank
    for b in 0..spans.len:
        if mem.ins[b].seen:
            visit(b)
    if mem.speak and mem.fn.stuck.len > 0:
        at := 0
        if mem.fn.node != 0:
            at = comp.tokens[comp.nodes[mem.fn.node].tok].at
        for k in spans[0].first..spans[-1].end:
            if at == 0:
                at = mem.ops[k].pos
        text: &str = heap("")
        text += "-memory stopped checking " + mem.fn.shown + " because " + mem.fn.stuck + "; checks for this function are incomplete"
        warn(view(text), at, "", 0, false)
        mem.fn.stuck_in = mem.f + 1
    mem.final = false
    mem.speak = false
    for b in 0..spans.len:
        release(mem.ins[b])
    mem.ins.len = 0
    sum: Summary
    ret: Target
    relevant: Set
    global: Set
    mem.fn.deep = false
    if mem.exit.seen:
        restore(mem.exit)
        escaping := reach(mem.ret, ByLive)
        global = reach(blank, FromGlobals)
        sum.seen = true
        for k in 0..mem.exit.ids.len:
            id := mem.exit.ids[k]
            c := mem.fn.cells[id]
            owner := i64(c.owner)
            if owner >= SLOTS or not (owner == RETURNED or owner == OUTSIDE or mem.fn.outer[owner] or escaping[owner]):
                continue
            v := mem.pool[mem.exit.vals[k]]
            if mem.fn.outer[owner] and v == initial(owner, c.off, c.stride, c.count, c.member) and empty(v.live and (mem.exit.marks.killed or mem.exit.marks.made)):
                continue
            if mem.fn.far[owner]:
                mem.fn.deep = mem.fn.deep or not mem.fn.objs[owner].core and (v.slot != 0 or not empty(objects(v.live or v.dead) - bit(owner))) # it is all that it reaches, itself included
                continue
            if v.slot != 0:
                v.slot = 0
                v.dead = v.dead or bit(GONE)
            append(sum.ids, id)
            append(sum.aims, v)
            relevant = relevant or v.live or v.dead
        ret = mem.ret
        if ret.slot != 0:
            ret.slot = 0
            ret.dead = ret.dead or bit(GONE)
        relevant = relevant or mem.fn.outer or escaping or ret.live or ret.dead
        m := mem.exit.marks # past HOPS pointers a block tells its callers only what it frees, and they say that they don't follow the rest
        for x in (m.made or m.killed - m.freed) and relevant and mem.fn.far:
            mem.fn.deep = mem.fn.deep or not mem.fn.objs[x].core
        running := mem.exit.runs.running and m.live
        for h in running:
            if mem.fn.objs[h].alone or relevant[h]: # a thread that runs alone, or that the callers get, runs on in them
                relevant[h] = true
                for p in mem.footprints:
                    if p.block == newest(h):
                        append(mem.fn.touches, Footprint{h, p.at, p.touch})
        sum.marks = Marks{m.live and relevant, m.freed and relevant, m.killed and relevant - (mem.fn.far - m.freed), m.sure and relevant, m.gone and relevant, m.used and relevant, m.made and relevant - mem.fn.far, m.waited and relevant}
        global = global and mem.fn.heaps
    old := mem.fns[f]
    changed := true
    if old.done:
        past := pack(old.sum)
        fresh := pack(sum)
        joined := merge(past, fresh, NONE)
        unknown := (mem.fn.heaps or mem.fn.outer) - (old.heaps or old.outer)
        joined.marks.sure = joined.marks.sure or sum.marks.sure and unknown
        joined.marks.gone = joined.marks.gone or sum.marks.gone and unknown
        ret = unite(old.ret, ret, alive(old.sum.marks), alive(sum.marks))
        relevant = relevant or old.relevant
        global = global or old.global
        changed = joined != past or ret != old.ret or relevant != old.relevant or global != old.global or mem.fn.touches.len != old.touches.len
        release(sum)
        sum = Summary{marks = joined.marks, seen = joined.seen}
        for k in 0..joined.ids.len:
            append(sum.ids, joined.ids[k])
            append(sum.aims, mem.pool[joined.vals[k]])
        release(past)
        release(fresh)
        release(joined)
    release(old.sum)
    release(mem.exit)
    mem.exit = none
    mem.fn.swaps.len = 0
    for k in 0..mem.fn.objs.len:
        append(mem.fn.swaps, u32(0))
    for k in 0..sum.ids.len:
        c := mem.fn.cells[sum.ids[k]]
        owner := i64(c.owner)
        if owner < SLOTS and mem.fn.outer[owner] and mem.fn.objs[owner].depth < HOPS:
            was := mem.index[child(owner, c.off, c.stride)]
            if was is u32 and sum.marks.killed[i64(was)]:
                fresh := objects(sum.aims[k].live) and mem.fn.heaps
                if not empty(fresh):
                    sum.marks.made[i64(was)] = true
                    sum.marks.gone[i64(was)] = false
                for x in fresh:
                    if mem.fn.swaps[x] == 0:
                        mem.fn.swaps[x] = was + 1
                        if mem.fn.objs[x].home != 0:
                            mem.fn.objs[was].home = mem.fn.objs[x].home
    mem.fn.sum = sum
    mem.fn.ret = ret
    mem.fn.relevant = relevant
    mem.fn.global = global
    mem.fn.done = true
    mem.fns[f] = mem.fn
    free(old.touches)
    return changed

# v as it was before a realloc that gave null
func unmoved(v: Target, blocks: Set) -> Target:
    back := v.dead and blocks
    v.must = v.must or back - v.live
    v.live = v.live or back
    v.dead = v.dead - back
    return v

func hold(slot: u32):
    if slot == ALL:
        for w in 0..mem.words:
            mem.held[w] = FULL
    elif slot != 0:
        k := i64(slot) - 1
        mem.held[k / 64] = mem.held[k / 64] or (u64(1) << u64(k % 64))

func restore(st: State):
    mem.tick += 1
    mem.present.len = 0
    for k in 0..st.ids.len:
        id := st.ids[k]
        mem.ticked[id] = mem.tick
        mem.known[id] = st.vals[k] + 1
        append(mem.present, id)
    for k in 0..st.temps.len:
        mem.temps[mem.fn.crossing[k]] = mem.pool[st.temps[k]]
        mem.interned[mem.fn.crossing[k]] = st.temps[k] + 1
    mem.marks = st.marks
    mem.runs = st.runs

func visit(block: i64):
    restore(mem.ins[block])
    mem.seen = true
    mem.active.len = 0
    span := mem.fn.spans[block]
    for i in span.first..span.end:
        if not mem.seen:
            break
        o := mem.ops[i]
        mem.here = i
        switch o.code:
        case Alloc:
            define(o.to, Target{slot = o.slot + 1})
        case Load, Word:
            address := target_of(o.a)
            touch(address, mem.fn.names[o.a.temp])
            access(address, false, o.size)
            r := sole(address)
            if mem.speak and address.member != 0 and r != NONE and r < SLOTS and (mem.fn.keys[r] and 0xff) == ROUND:
                written := fetch(Target{live = address.live, off = address.off}).writer
                if written != 0 and written != address.member:
                    text: &str = heap("")
                    text += mem.fn.names[o.a.temp] + " may no longer hold " + comp.types[address.member].name + " because its enclosing list was modified after narrowing; re-check it with 'is'"
                    warn(view(text), o.pos, "", 0, false)
            if o.code == Word:
                define(o.to, number(ANY))
            else:
                define(o.to, fetch(address))
        case Store, Clear:
            address := target_of(o.b)
            touch(address, mem.fn.names[o.b.temp])
            access(address, true, o.size)
            if o.code == Store and mem.fn.names[o.a.temp].len == 0 and mem.fn.variables[o.b.temp] and (comp.types[mem.fn.places[o.b.temp]].kind == Ptr or comp.types[mem.fn.places[o.b.temp]].kind == Thread):
                christen(target_of(o.a), mem.fn.names[o.b.temp])
            elif o.code == Store and mem.fn.names[o.a.temp].len == 0 and sole(address) != NONE and address.off != ANY and address.stride == 0: # a field, like c.last = heap(...)
                christen(target_of(o.a), spelled(sole(address), address.off, 8).name)
            if o.code == Store:
                stash(address, target_of(o.a))
            elif address.member != 0: # a number holds no memory, but in a union it says which member is there
                stash(address, number(0))
        case Blit:
            from := target_of(o.a)
            to := target_of(o.b)
            touch(from, mem.fn.names[o.a.temp])
            touch(to, mem.fn.names[o.b.temp])
            access(from, false, o.size)
            access(to, true, o.size)
            if mem.speak:
                copied(from, mem.fn.places[o.a.temp], mem.fn.names[o.a.temp])
            if not mem.fn.variables[o.b.temp]:
                mem.fn.names[o.b.temp] = mem.fn.names[o.a.temp]
            elif mem.fn.names[o.a.temp].len == 0 and comp.types[mem.fn.places[o.b.temp]].kind == Fat:
                christen(fetch(from), mem.fn.names[o.b.temp])
            transfer(to, from, i64(o.size), o.shape)
        case Offset:
            x := target_of(o.a)
            y := target_of(o.b)
            if o.member != 0:
                x.member = o.member
            out := plus(amount(x), amount(y).off, amount(y).stride, 0)
            if pointing(x) and pointing(y):
                out = blur(x, y)
            elif pointing(y):
                out = plus(y, amount(x).off, amount(x).stride, o.count)
            elif pointing(x):
                out = plus(x, amount(y).off, amount(y).stride, o.count)
            if o.from != 0: # x[i] with the i that counts a walk is the element of its round, when x is what the round walks
                r := rounded(u64(o.from), out, o.shape, mem.fn.names[o.a.temp])
                at := placed(mem.fn.objs[r])
                if r != OUTSIDE and out.off == at.off and out.stride == at.stride and out.count == at.count and (not empty(objects(out.live) and at.live) or out.slot != 0 and out.slot == at.slot):
                    out = Target{live = bit(r), must = bit(r), dead = out.dead, killer = out.killer}
            define(o.to, out)
        case Scale:
            x := amount(target_of(o.a))
            y := amount(target_of(o.b))
            if y.off == ANY or y.stride != 0:
                y = x
                x = amount(target_of(o.b))
            n := i64(y.off)
            v := number(ANY)
            if y.off == ANY or y.stride != 0:
                v = number(ANY)
            elif n == 0:
                v = number(0)
            elif x.off != ANY and x.stride == 0 and i64(x.off) * n > 0 - FAR and i64(x.off) * n < FAR:
                v = number(i32(i64(x.off) * n))
            elif x.off != ANY and x.stride == 0 and i64(x.off) * n >= FAR:
                v = number(FAR)
            elif n > 0 and x.off != ANY and x.stride != 0 and i64(x.stride) * n <= EXACT:
                v = Target{live = bit(NOWHERE), off = i32(i64(x.off) * n), stride = i32(i64(x.stride) * n)}
            elif n > 0 and n <= EXACT:
                v = Target{live = bit(NOWHERE), stride = i32(n)}
            define(o.to, v)
        case Mix:
            x := target_of(o.a)
            y := target_of(o.b)
            if o.size != 0 and pointing(x) and objects(x.live) == objects(y.live) and x.slot == y.slot and x.slot != ALL: # the distance between two places of one block is a number
                define(o.to, number(ANY))
            else:
                define(o.to, blur(x, y))
        case Count:
            if mem.speak:
                counted(target_of(o.a), mem.fn.names[o.a.temp])
            define(o.to, number(ANY))
        case Reused:
            wipe(SLOTS + i64(target_of(o.a).slot) - 1)
        case Part:
            shown := target_of(o.a)
            data := fetch(shown)
            data.part = true
            stash(shown, data)
        case Counted:
            if mem.speak:
                counted(fetch(target_of(o.a)), "")
        case Plain:
            define(o.to, number(ANY))
        case Call, Locks, Unlocks, Emptied:
            g := i64(o.callee) - 1
            if not mem.fns[g].done:
                define(o.to, number(ANY))
            elif not mem.fns[g].sum.seen:
                mem.seen = false
            else:
                sum := mem.fns[g].sum
                marks := sum.marks
                relevant := mem.fns[g].relevant
                heaps := mem.fns[g].heaps
                outer := mem.fns[g].outer
                mem.callee = g
                mem.call = i
                mem.who = ""
                if o.named:
                    mem.who = mem.fns[g].shown
                mem.bound = Set{}
                inner := mem.fns[g].group == mem.fn.group
                stuck := mem.fns[g].stuck_in
                if stuck != 0:
                    mem.fn.stuck_in = stuck
                if stuck != 0 and mem.speak and not inner:
                    text: &str = heap("")
                    text += "-memory stopped checking " + mem.fns[stuck - 1].shown + " because " + mem.fns[stuck - 1].stuck + "; this call is not checked"
                    warn(view(text), o.pos, "", 0, false)
                if mem.fns[g].deep and mem.speak and not inner:
                    text: &str = heap("")
                    text += "-memory stopped checking " + mem.fns[g].shown + " because it modifies memory more than three pointer indirections from its parameters; this call is not checked"
                    warn(view(text), o.pos, "", 0, mem.fns[g].strict)
                running := mem.runs.running and mem.marks.live # the threads that run while it does
                left: Set # the threads it leaves running
                for f in mem.fns[g].touches:
                    if f.block != NONE:
                        left[f.block] = true
                recursive := NONE
                born := i64(i)
                if o.ghost:
                    born = NONE # what a thread makes is in no scratch of this one until wait takes it
                ended: Set # the temporaries of a thread whose result holds no pointer, which it frees when it ends
                for x in relevant and heaps:
                    if not marks.live[x] and not marks.freed[x] and not marks.killed[x]:
                        continue
                    if x < mem.fns[g].swaps.len and mem.fns[g].swaps[x] != 0:
                        b := binding(i64(mem.fns[g].swaps[x]) - 1)
                        if not empty(objects(b.live)):
                            mem.binds[x] = Target{live = objects(b.live), must = b.must, off = b.off, stride = b.stride}
                            mem.bound = mem.bound or bit(x)
                            continue
                    ob := obj_of(g, x)
                    h := 0
                    replace := true
                    if mem.fns[g].global[x]:
                        key := (u64(g) << 24) or (u64(x) << 8) or GLOBAL # the line of a block that g keeps in a context, the same through every call
                        if (ob.key and 0xff) == GLOBAL:
                            key = ob.key and (AGED - 1)
                        made := Obj{kind = Heap, many = true, born = born, pos = ob.pos, from = ob.from, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread, alone = ob.alone, core = ob.core or mem.fns[g].node == 0 or file_of(comp.tokens[comp.nodes[mem.fns[g].node].tok].at) == 0}
                        replace = not inner and not made.core # the blocks core keeps stay one per line, which costs less
                        h = birth(key, made) if replace else object(key, made)
                    elif inner and recursive != NONE:
                        h = recursive
                        replace = false
                    elif inner:
                        h = birth(RECURSIVE, Obj{kind = Heap, many = true, born = born, pos = o.pos, from = mem.who, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread, alone = ob.alone})
                        recursive = h
                    else:
                        h = lodge(arena_of(ob), (u64(i) << 24) or (u64(x) << 8) or SITE, Obj{kind = Heap, many = mem.fns[g].many[x], born = born, pos = o.pos, from = mem.who, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread, alone = ob.alone})
                    mem.marks.live = carry(marks.live, x, mem.marks.live, h, replace)
                    mem.marks.freed = carry(marks.freed, x, mem.marks.freed, h, replace)
                    mem.marks.killed = carry(marks.killed, x, mem.marks.killed, h, replace)
                    mem.runs.running = carry(left, x, mem.runs.running, h, replace)
                    mem.binds[x] = Target{live = bit(h), must = bit(h)}
                    if mem.fns[g].global[x]:
                        mem.binds[x].must = Set{}
                    mem.fn.objs[h].strict = mem.fn.objs[h].strict or mem.fns[g].strict
                    mem.bound = mem.bound or bit(x)
                    if o.ghost and ob.arena and not ob.pool and not holds_pointer(comp.insts[mem.fns[g].inst].ret):
                        ended[h] = true
                for x in relevant and outer:
                    binding(x)
                again := false # the lock was taken already, so its with lets go of nothing
                if o.code == Locks:
                    k := lock_of(target_of(mem.args[o.first]), false)
                    again = k != NONE and mem.runs.locks[k]
                    if k != NONE:
                        mem.runs.locks[k] = true
                if mem.threaded and (mem.final or o.ghost) and o.code == Call: # taking a lock and letting it go touch only the lock
                    mem.passed.len = 0
                    locks := mem.runs.locks
                    if o.ghost: # a thread holds none of the locks of the one that starts it
                        locks = Set{}
                    for f in mem.fns[g].touches:
                        if f.block == NONE:
                            rebound(g, f.touch, locks)
                    if o.ghost: # each function that a function value may be
                        for t in mem.passed:
                            append(mem.starting, t)
                    else:
                        for t in mem.passed:
                            touched(t, o.pos, running, Set{})
                for x in left and relevant and heaps:
                    for h in objects(mem.binds[x].live) and mem.fn.heaps:
                        retire(newest(h))
                        mem.passed.len = 0
                        for f in mem.fns[g].touches:
                            if f.block == x:
                                rebound(g, f.touch, Set{})
                        for t in mem.passed:
                            append(mem.footprints, Footprint{newest(h), o.pos, t})
                            started(newest(h), t)
                if o.code == Unlocks:
                    k := lock_of(fetch(target_of(mem.args[o.first])), false)
                    if k != NONE:
                        mem.runs.locks[k] = false
                if mem.speak:
                    who := mem.who
                    if who.len == 0:
                        who = "this call"
                    node := mem.fns[g].node
                    mine := o.named and node != 0 and file_of(comp.tokens[comp.nodes[node].tok].at) != 0
                    for k in 0..i64(o.count):
                        if k < mem.fns[g].values.len and mem.fns[g].values[k] != VOID:
                            given := mem.args[o.first + k]
                            t := mem.fns[g].values[k]
                            found := lockable(Target{}, t, true)
                            if mine and found.type != VOID:
                                text: &str = heap("")
                                text += "passing " + (mem.fn.names[given.temp] if mem.fn.names[given.temp].len > 0 else "this argument") + " by value to " + who + " copies "
                                if found.name.len == 0:
                                    text += kind_of(found.type)
                                else:
                                    text += "the " + text(comp.types[found.type].decl) + " " + found.name + " in it"
                                text += "; change the parameter type to *" + comp.types[t].name
                                warn(view(text), o.pos, "", 0, mem.fns[g].strict)
                            elif found.type != VOID:
                                copied(target_of(given), t, mem.fn.names[given.temp])
                    for x in relevant and outer:
                        b := mem.binds[x]
                        ob := obj_of(g, x)
                        name: &strview
                        if ob.root > 0 and ob.root <= o.count:
                            name = named(mem.args[i64(o.first) + ob.root - 1].temp, g, ob.root - 1)
                        why := refusal(b, ob.loose)
                        if why.len == 0 and marks.freed[x] and ob.depth == 0 and b.off != ANY and b.off != 0 and b.stride == 0 and not empty(freeable(b.live)): # what the call frees is where its argument points
                            why = "; pointer is inside a heap block, not at its start"
                        homeless: &strview = "" # why it cannot grow: its arena is 0 on every path, or on some path in a word followed path by path
                        if marks.killed[x] and ob.home != 0:
                            arena := obj_of(g, i64(ob.home) - 1)
                            v := arena_of(ob)
                            followed := arena.depth == 0
                            if not followed:
                                at := plus(binding(arena.parent), arena.off, arena.stride, arena.count)
                                holder := sole(at)
                                followed = at.off != ANY and at.stride == 0 and holder != NONE and (holder >= SLOTS or mem.fn.outer[holder])
                            zero := v.live[NOWHERE] and (not plain(v) or v.off == 0 or v.off == ANY)
                            if zero and (plain(v) and v.off == 0 or followed and not v.element):
                                homeless = "; it may not have allocated memory to grow"
                                if arena.depth == 1 and arena.root > 0:
                                    given := emptied(mem.fns[g].places[mem.fns[g].params[arena.root - 1]])
                                    if given.len > 0:
                                        homeless = "; it may not have allocated memory to grow (initialize with " + given + ")"
                        far := ob.depth > HOPS # it stands for all that it reaches, some of it off the heap
                        if marks.freed[x] and why.len > 0 and not far:
                            refuse(who, name, why, b, mem.fns[g].strict)
                        elif marks.killed[x] and offheap(b) and not far:
                            immovable(who, name, "; it is not heap-allocated", mem.fns[g].strict)
                        elif homeless.len > 0:
                            immovable(who, name, homeless, mem.fns[g].strict)
                        elif marks.used[x]:
                            stale(b, name, mem.fns[g].strict)
                        if marks.killed[x] and not mem.fns[g].guarded:
                            for y in relevant and outer:
                                oy := obj_of(g, y)
                                c := mem.binds[y]
                                sibling := ob.depth > 0 and oy.depth > 0 and ob.parent == oy.parent
                                shared := not empty((b.live and c.live) - mem.pinned - mem.fn.far) or b.slot != 0 and c.slot != 0 and (b.slot == c.slot or b.slot == ALL or c.slot == ALL)
                                if y != x and not sibling and (ob.root > 0 or oy.root > 0) and (marks.used[y] or marks.killed[y]) and shared:
                                    said: &str = heap("")
                                    said += who + " may free or reallocate memory that it also reads"
                                    if ob.root != oy.root:
                                        said += " through another argument"
                                    warn(view(said), o.pos, "", 0, mem.fns[g].strict)
                                    break
                for x in relevant and outer:
                    b := mem.binds[x]
                    ob := obj_of(g, x)
                    passed := b.live and mem.fn.outer
                    if mem.fn.walks:
                        passed = passed or b.live and mem.fn.focus
                    if marks.killed[x]:
                        killed := freeable(b.live)
                        if ob.pool:
                            killed = killed or b.live and mem.fn.arenas
                        for h in killed:
                            condemn(h, marks.sure[x] and b.must[h], marks.freed[x])
                            mem.fn.objs[h].element = mem.fn.objs[h].element or marks.freed[x] and b.element
                            mem.fn.objs[h].part = mem.fn.objs[h].part or marks.freed[x] and not inner and (b.part or ob.part) # a function that calls itself on the rest of a list walks it
                        if marks.made[x] and not marks.freed[x] and ob.depth > 0 and not empty(killed):
                            append(mem.regrown, Regrown{plus(binding(ob.parent), ob.off, ob.stride, ob.count), killed})
                        for h in passed:
                            mem.fn.objs[h].pool = mem.fn.objs[h].pool or ob.pool
                            mem.fn.objs[h].loose = mem.fn.objs[h].loose or ob.loose
                    if ob.taken:
                        for h in objects(b.live) and (mem.fn.heaps or mem.fn.outer):
                            mem.fn.objs[h].taken = true
                    if marks.gone[x]:
                        vanish(freeable(b.must))
                    if marks.used[x]:
                        use(b.live)
                    if marks.made[x]:
                        mem.marks.made = mem.marks.made or passed
                        if ob.home != 0:
                            home := home_of(arena_of(ob))
                            for h in passed:
                                mem.fn.objs[h].home = home
                    if marks.waited[x]:
                        reap(b)
                if mem.fns[g].deep: # what it may have freed or moved past HOPS pointers is not followed from here
                    for x in relevant and outer and mem.fns[g].far:
                        vanish(freeable(binding(x).live))
                sweep()
                if o.blob:
                    wipe(SLOTS + i64(o.slot))
                mem.writes.len = 0
                kept: Set # what it freed, gave back or left somewhere
                if mem.speak:
                    kept = marks.killed or mem.fns[g].ret.live or mem.fns[g].ret.dead
                    for a in sum.aims:
                        kept = kept or a.live or a.dead
                for k in 0..sum.ids.len:
                    c: Cell
                    if g == mem.f:
                        c = mem.fn.cells[sum.ids[k]]
                    else:
                        c = mem.fns[g].cells[sum.ids[k]]
                    x := i64(c.owner)
                    if mem.speak and not o.ghost and x < SLOTS and c.off != ANY and c.stride == 0 and c.member == 0 and obj_of(g, x).kind == Shared and not obj_of(g, x).core:
                        lost := true
                        for y in kept and outer:
                            lost = lost and not (obj_of(g, y).parent == x and obj_of(g, y).off == c.off and obj_of(g, y).stride == 0)
                        place := sole(binding(x))
                        w := mem.fn.heads[place] if lost and place != NONE else 0
                        while w != 0:
                            d := mem.fn.cells[w - 1]
                            if d.off == c.off and d.stride == 0 and d.member == 0 and mem.ticked[w - 1] == mem.tick and single(cell_value(w - 1).live): # surely this block, so not a first call
                                for b in (cell_value(w - 1).live - cell_value(w - 1).dead) and mem.fn.heaps and mem.marks.live:
                                    elsewhere := (mem.fn.keys[b] and 0xff) != GLOBAL
                                    for id in mem.refs[b]:
                                        elsewhere = elsewhere or i64(id) != i64(w) - 1 and mem.ticked[id] == mem.tick and cell_value(id).live[b]
                                    if not elsewhere:
                                        text: &str = heap("memory leak: ")
                                        text += (mem.who if mem.who.len > 0 else "this call") + " replaces " + spelled(place, c.off, 8).name + " while it still holds memory; free it first"
                                        warn(view(text), o.pos, "", 0, mem.fns[g].strict)
                            w = d.next
                    if x == RETURNED and o.blob:
                        v := translate(sum.aims[k])
                        if mem.fns[g].takes:
                            v = taken(v)
                        append(mem.writes, Write{v, cell_at(SLOTS + i64(o.slot), c.off, c.stride, c.count, c.member), true})
                    ob := obj_of(g, x)
                    if x != RETURNED and not (ob.kind == Entry and ob.depth == 0 and ob.root > 0 and mem.fns[g].copies[ob.root - 1]):
                        t := binding(x)
                        v := translate(sum.aims[k])
                        p := plus(t, c.off, c.stride, c.count)
                        if v.writer == 0:
                            v.writer = p.member
                        exact := p.off != ANY and p.stride == 0
                        one := sole(t) != NONE
                        for h in t.live - mem.pinned:
                            append(mem.writes, Write{v, cell_at(h, p.off, p.stride, p.count, c.member), (one or t.must[h]) and exact and not mem.fn.many[h]})
                        if t.slot != 0 and t.slot != ALL:
                            append(mem.writes, Write{v, cell_at(SLOTS + i64(t.slot) - 1, p.off, p.stride, p.count, c.member), one and exact})
                        if t.live[OUTSIDE]:
                            if x != OUTSIDE and mem.speak and mem.fn.stuck.len == 0 and stuck == 0 and followable(v): # a call already said to be not checked says no more
                                warn(UNFOLLOWED, o.pos, "", 0, mem.fns[g].strict)
                            append(mem.writes, Write{v, cell_at(OUTSIDE, ANY, 0, 0, 0), false})
                mem.order.len = 0
                for k in 0..mem.writes.len:
                    append(mem.order, (u64(mem.writes[k].id) << 32) or u64(k))
                sort(mem.order)
                live := alive(mem.marks)
                k := 0
                while k < mem.order.len:
                    id := i64(mem.order[k] >> 32)
                    v: Target
                    strong := false
                    while k < mem.order.len and i64(mem.order[k] >> 32) == id:
                        w := i64(mem.order[k] and 0xffff_ffff)
                        v = unite(v, mem.writes[w].value, live, live)
                        strong = strong or mem.writes[w].strong
                        k += 1
                    settle(id, v, strong)
                for h in ended:
                    condemn(h, true, false)
                vanish(ended)
                sweep()
                if again and o.blob:
                    stash(Target{slot = o.slot + 1}, number(0))
                if o.to != 0 and o.blob:
                    define(o.to, Target{slot = o.slot + 1})
                elif o.to != 0:
                    define(o.to, taken(translate(mem.fns[g].ret)) if mem.fns[g].takes else translate(mem.fns[g].ret))
                if o.code == Emptied: # the elements are not in the list any more
                    data := fetch(target_of(mem.args[o.first]))
                    d := sole(data)
                    if d != NONE and data.must[d] and not mem.fn.many[d]:
                        wipe(d)
        case Fresh, Arena:
            touch_args(o)
            from := mem.callees[o.callee]
            h := birth((u64(i) << 24) or SITE, Obj{kind = Heap, born = i64(i), pos = o.pos, from = from[1:], arena = o.code == Arena})
            define(o.to, Target{live = bit(h), must = bit(h)})
        case Rewind:
            released: Set
            for h in mem.fn.arenas:
                if not mem.fn.objs[h].pool and mem.fn.objs[h].born > o.from and mem.fn.objs[h].born < o.upto:
                    released[h] = true
            if mem.speak:
                outlived(released, o.pos, "its with scratch() releases it here")
            for h in released:
                condemn(h, true, false)
            vanish(released)
            sweep()
        case Take:
            touch_args(o)
            worded(target_of(mem.args[o.first])) # the counts and the blocks of the arena
            k := chunk(target_of(mem.args[o.first]), named(mem.args[o.first].temp, i64(o.callee) - 1, 0), (u64(i) << 24) or SITE, Obj{kind = Heap, born = i64(i), pos = o.pos, from = "arena"})
            define(o.to, Target{live = bit(k), must = bit(k)})
        case Reclaim:
            touch_args(o)
            arena := target_of(mem.args[o.first])
            worded(arena)
            held := fetch(arena)
            blocks := objects(held.live)
            chunks := objects(fetch(Target{live = blocks, off = ANY}).live) and (mem.fn.arenas or mem.fn.outer - mem.fn.roots)
            access(Target{live = chunks, off = ANY}, true, 0) # what it gave goes, also for a thread that reads it
            for h in chunks:
                mem.fn.objs[h].pool = true
                condemn(h, true, false)
            vanish(chunks)
            if target_of(mem.args[o.first + 1]).off != 0:
                freed := freeable(blocks)
                for h in freed:
                    condemn(h, held.must[h], true)
                vanish(freed and held.must)
                stash(arena, number(0))
            sweep()
        case Grow, Resize:
            touch_args(o)
            arena := number(0)
            if o.code == Resize:
                arena = target_of(mem.args[o.first])
                worded(arena)
            given := mem.args[o.first + u32(o.code == Resize)]
            first := target_of(given)
            access(plus(first, ANY, 0, 0), true, 0) # it may move all of it
            if mem.speak and offheap(first):
                immovable(comp.tokens[token_at(o.pos)].text, mem.fn.names[given.temp], "; it is not heap-allocated", false)
            blocks := freeable(first.live)
            for h in blocks:
                condemn(h, first.must[h], false)
            for h in blocks and mem.fn.outer:
                mem.fn.objs[h].home = home_of(arena)
            mem.marks.made = mem.marks.made or blocks and (mem.fn.outer or mem.fn.focus)
            sweep()
            out := Target{live = objects(first.live), must = first.must, killer = o.pos if o.code == Grow else 0}
            reborn(first, blocks, ptr(out), arena, (u64(i) << 24) or SITE, Obj{kind = Heap, pos = o.pos, from = "realloc"})
            if empty(out.live):
                out.live = bit(NOWHERE)
            define(o.to, out)
        case Reap:
            thread := target_of(mem.args[o.first])
            touch(thread, mem.fn.names[mem.args[o.first].temp])
            reap(thread)
        case Launch:
            blocks := objects(target_of(mem.args[o.first]).live) and mem.fn.heaps
            if mem.final:
                for t in mem.starting:
                    touched(t, o.pos, mem.runs.running and mem.marks.live, blocks)
            for h in blocks:
                mem.fn.objs[h].thread = true
                retire(h)
                for t in mem.starting:
                    if t.owner >= SLOTS or not blocks[i64(t.owner)]: # its block is its own until wait
                        append(mem.footprints, Footprint{h, o.pos, t})
                        started(h, t)
            mem.runs.running = mem.runs.running or blocks
            mem.starting.len = 0
        case Settle: # main waits for the threads that run alone
            running := mem.runs.running
            for h in running:
                mem.runs.running[h] = not mem.fn.objs[h].alone
            define(o.to, number(ANY))
        case Detach:
            first := target_of(mem.args[o.first])
            if mem.speak and comp.shared:
                warn("detached thread in a shared library may outlive library unload and execute unmapped code; store the handle and wait() for it in an 'export func' before unloading", o.pos, "", 0, false)
            if mem.speak and not mem.fn.settles:
                leaving(first, o.pos) # a thread that runs alone may outlive this function
            for h in objects(first.live) and mem.fn.heaps:
                mem.fn.objs[h].alone = true # the runtime frees its block when it ends
        case Release, Discard:
            given := mem.args[o.first + u32(o.code == Discard)]
            first := target_of(given)
            access(plus(first, ANY, 0, 0), true, 0)
            name := mem.fn.names[given.temp]
            blocks := freeable(first.live)
            why := refusal(first, o.code == Discard)
            if why.len == 0 and not empty(blocks) and first.off != ANY and first.off != 0 and first.stride == 0:
                why = "; pointer is inside a heap block, not at its start"
                blocks = Set{}
            if mem.speak and why.len > 0:
                who := comp.tokens[token_at(o.pos)].text
                refuse(who, name, why, first, false)
            for h in blocks:
                condemn(h, first.must[h], true)
                mem.fn.objs[h].element = mem.fn.objs[h].element or first.element
                mem.fn.objs[h].part = mem.fn.objs[h].part or first.part
                mem.fn.objs[h].loose = mem.fn.objs[h].loose or o.code == Discard
            vanish(blocks and first.must)
            sweep()
        case Taken:
            touch_args(o)
            stash(target_of(mem.args[o.first]), Target{live = bit(STATIC), must = bit(STATIC)}) # in use from now on, like the signature that macOS writes there
            define(o.to, number(ANY))
        case Give:
            touch_args(o)
            channel := target_of(mem.args[o.first])
            stash(channel, Target{live = bit(STATIC), must = bit(STATIC)}) # in use, like a Lock that was taken
            given := target_of(mem.args[o.first + 1])
            outlives := mem.speak and not mem.fn.settles and (channel.slot == 0 or not empty(objects(channel.live)))
            blocks: Set
            sure: Set
            for k in 0..i64(o.size) / 8 + i64(o.size == 0):
                word := given
                if o.size > 0:
                    word = fetch(plus(given, i32(k * 8), 0, 0))
                if outlives:
                    leaving(word, o.pos) # what goes to a channel that is not a local of this function may outlive it
                for h in objects(word.live) and mem.fn.arenas:
                    mem.fn.objs[h].sent = o.pos
                if marked(o.shape, k) and word.off == 0 and word.stride == 0: # a pointer inside a block gives nothing
                    blocks = blocks or word.live
                    sure = sure or word.must
            blocks = freeable(blocks)
            for h in blocks:
                condemn(h, sure[h], true)
            vanish(blocks and sure)
            sweep()
        case Copy, Fill:
            touch_args(o)
            to := target_of(mem.args[o.first])
            from := to
            shape: u32 = 0
            if o.code == Copy:
                from = target_of(mem.args[o.first + 1])
                shape = o.shape
                if mem.speak:
                    copied(from, mem.fn.places[mem.args[o.first + 1].temp], mem.fn.names[mem.args[o.first + 1].temp])
            size := mem.args[o.first + 2]
            nothing: Target
            constant := size.temp == 0 and size.data == 0 and size.n >= 0
            bytes: u32 = FAR
            if constant and size.n < FAR:
                bytes = u32(size.n)
            access(to, true, bytes)
            if o.code == Copy:
                access(from, false, bytes)
            if constant and size.n <= EXACT:
                transfer(to, from, size.n, shape)
            elif constant and shape == 0 and to.off != ANY and to.stride == 0 and sole(to) != NONE: # a long run of numbers changes only the words written so far
                h := mem.fn.heads[sole(to)]
                while h != 0:
                    c := mem.fn.cells[h - 1]
                    if c.member == 0 and c.stride == 0 and c.off >= to.off and i64(c.off) < i64(to.off) + size.n:
                        settle(i64(h) - 1, number(0), not many(c))
                    h = c.next
            elif shape == 0:
                stash(blur(to, nothing), number(0))
            else:
                stash(blur(to, nothing), fetch(blur(from, nothing)))
            define(o.to, to)
        case Absent:
            address := plus(target_of(o.a), 8, 0, 0)
            address.member = o.member
            gone: Set
            for k in 0..i64(o.size) / 8:
                if marked(o.shape, k):
                    gone = gone or fetch(plus(address, i32(k * 8), 0, 0)).must and ((mem.fn.heaps or mem.fn.focus) and mem.marks.live or mem.fn.outer - mem.fn.roots)
            if not empty(gone and mem.fn.outer):
                for x in mem.fn.outer:
                    if mem.fn.objs[x].depth > 0 and gone[mem.fn.objs[x].parent]:
                        gone[x] = true
            vanish(gone)
        case Ended:
            pointed := false
            for k in o.a.n..o.b.n:
                pointed = pointed or ((mem.pointed[k / 64] >> u64(k % 64)) and 1) != 0
            if not pointed:
                continue
            for id in mem.present:
                if mem.ticked[id] == mem.tick:
                    v := cell_value(id)
                    if v.slot != ALL and i64(v.slot) > o.a.n and i64(v.slot) <= o.b.n:
                        t := mem.fn.slots[v.slot - 1]
                        name: &strview
                        if mem.fn.variables[t]:
                            name = mem.fn.names[t]
                        v.dead = v.dead or bit(object((u64(v.slot) << 8) or ENDED, Obj{kind = Slot, name = name, pos = o.pos}))
                        v.killer = o.pos
                        place(i64(id), v)
        case Round:
            walk := u64(o.b.n)
            now := mem.runs.now
            for m in now: # the threads started so far touch the elements of earlier rounds
                if mem.fn.keys[m] >> 24 == walk:
                    mem.runs.now[m] = false
            visited(walk)
            element := target_of(o.a)
            if o.to != 0: # the element in place
                inside := rounded(walk, element, o.shape, mem.fn.names[o.a.temp])
                define(o.to, Target{live = bit(inside), must = bit(inside), dead = element.dead, killer = element.killer})
            elif o.a.temp != 0: # a copy of the element
                for k in 0..i64(o.size) / 8:
                    if marked(o.shape, k):
                        word := plus(element, i32(k * 8), 0, 0)
                        stash(word, focused(fetch(word), walk, 0))
            else: # by index, the element of each list where the rounds before found it
                focus := mem.fn.focus
                for r in focus:
                    x := mem.fn.objs[r]
                    if (mem.fn.keys[r] and 0xff) == ROUND and mem.fn.keys[r] >> 24 == walk and x.parent != NONE:
                        rounded(walk, placed(x), x.shape, x.name)
        case Narrowed: # the walk's element in place holds this member now
            r := sole(target_of(o.a))
            if r != NONE and r < SLOTS and (mem.fn.keys[r] and 0xff) == ROUND:
                k := mem.fn.heads[r]
                while k != 0:
                    c := mem.fn.cells[k - 1]
                    if mem.ticked[k - 1] == mem.tick:
                        v := cell_value(k - 1)
                        v.writer = o.member
                        place(i64(k) - 1, v)
                    k = c.next
        case Walked:
            walk := u64(o.b.n)
            visited(walk)
            focus := mem.fn.focus
            for r in focus: # the lists and arrays whose elements it changed in place, and those that hold these
                if (mem.fn.keys[r] and 0xff) == ROUND and mem.fn.keys[r] >> 24 == walk:
                    p := mem.fn.objs[r].parent
                    while p != NONE:
                        append(mem.walking, p)
                        if p >= SLOTS or (mem.fn.keys[p] and 0xff) != ROUND:
                            break
                        p = mem.fn.objs[p].parent
            for v in focus:
                key := mem.fn.keys[v]
                if (key and 0xff) == VISITED and key >> 24 == walk and (mem.marks.live[v] or mem.marks.killed[v]):
                    h := mem.fn.objs[v].parent
                    freed := mem.marks.freed[v]
                    born := mem.fn.objs[h].born > i64(o.from) and mem.fn.objs[h].born < i64(i) # in the walk, so maybe after the elements it visits
                    all := o.size != 0 and freed and not mem.marks.live[v] and not born # a walk without break freed the element of every round on every path
                    if mem.marks.killed[v] and not all: # some may be freed or moved, and which the lists do not say, so a view from before the walk may point to them
                        for k in kin(h):
                            condemn(k, false, false)
                        sweep()
                    back(v)
                    if all:
                        for k in kin(h):
                            condemn(k, true, true)
                        vanish(kin(h))
            sweep()
            mem.walking.len = 0
        case Parse:
            touch_args(o)
            nothing: Target
            stash(target_of(mem.args[o.first + 1]), blur(target_of(mem.args[o.first]), nothing))
            define(o.to, number(ANY))
        case Extern:
            touch_args(o)
            define(o.to, Target{live = bit(OUTSIDE), must = bit(OUTSIDE)})
        case Stop, Halt:
            mem.seen = false
        case Goto, Fork:
            continue
        case Leave:
            focus := mem.fn.focus
            n := mem.fn.objs.len
            while n > 0 and mem.fn.walks: # a return inside a walk: its elements go back to what they stand for, the inner walks first
                n -= 1
                if focus[n] and (mem.marks.live[n] or mem.marks.killed[n]) and (mem.fn.keys[n] and 0xff) != ROUND:
                    back(n)
            given := target_of(o.a)
            wipe(RETURNED)
            if mem.fn.blob:
                touch(given, mem.fn.names[o.a.temp])
                access(given, false, o.size)
                transfer(Target{live = bit(RETURNED), must = bit(RETURNED)}, given, i64(o.size), o.shape)
                given = number(0)
            if mem.final:
                unseen := mem.fn.heaps - mem.marks.live - reach(given, ByAny)
                mem.marks.freed = mem.marks.freed - unseen
                mem.marks.killed = mem.marks.killed - unseen
                mem.marks.sure = mem.marks.sure - unseen
                mem.marks.gone = mem.marks.gone - unseen
                if mem.exit.seen:
                    mem.ret = unite(mem.ret, given, alive(mem.exit.marks), alive(mem.marks))
                else:
                    mem.ret = given
                out := snapshot()
                joined := merge(mem.exit, out, NONE)
                release(mem.exit)
                release(out)
                mem.exit = joined
            if mem.speak:
                must := reach(given, ByMust)
                may := reach(given, ByLive)
                for h in (mem.fn.heaps and mem.marks.live) - must - mem.fn.arenas:
                    x := mem.fn.objs[h]
                    if (x.key and 0xff) == GLOBAL or x.element and not x.part and (mem.marks.freed[h] or may[h]) or x.home != 0 or x.alone:
                        continue
                    text: &str = heap("memory leak: ")
                    if x.name.len > 0:
                        text += "the memory allocated here for " + x.name
                    elif x.from.len > 0:
                        text += "the memory that " + x.from + " allocates here"
                    else:
                        text += "the memory allocated here"
                    if may[h] or mem.marks.freed[h]:
                        text += " may never be freed"
                    else:
                        text += " is never freed"
                    warn(view(text), x.pos, "it is still not freed when this returns", o.pos, x.strict)
                escape(given, o.pos, true)
                if not mem.fn.settles:
                    outlived(mem.fn.arenas and mem.marks.live, 0, "")
                for id in mem.present:
                    owner := i64(mem.fn.cells[id].owner)
                    if mem.ticked[id] == mem.tick and (owner == RETURNED or owner < SLOTS and (mem.fn.outer[owner] or may[owner])):
                        escape(cell_value(id), o.pos, owner >= SLOTS or not mem.fn.outer[owner]) # what stays in a context or in the caller's memory is not returned
            mem.seen = false

# wait moves the scratch of the thread to the one of this thread, or of the caller when the thread came from it
func reap(thread: Target):
    mem.marks.waited = mem.marks.waited or thread.live and (mem.fn.outer or mem.fn.focus)
    mem.runs.joined = mem.runs.joined or thread.live and mem.fn.outer
    others := reach(Target{live = mem.runs.running and mem.marks.live - thread.live}, FromValue)
    for h in mem.fn.arenas - others: # its scratch, also what it left outside its result, and for it what the others left so
        if mem.fn.objs[h].born == NONE:
            mem.fn.objs[h].born = i64(mem.here)

# memory this reads or writes here
func access(at: Target, wrote: bool, size: u32):
    if not mem.final or not mem.threaded:
        return
    t := Touch{size = size, locks = mem.runs.locks, after = mem.runs.joined, wrote = wrote, atomic = mem.ops[mem.here].atomic}
    running := mem.runs.running and mem.marks.live
    pos := mem.ops[mem.here].pos
    for x in objects(at.live) - mem.pinned - bit(GONE) - bit(RETURNED):
        touched(moved(t, x, at), pos, running, Set{})
    if at.slot == ALL:
        for k in 0..mem.fn.slots.len:
            touched(moved(t, SLOTS + k, at), pos, running, Set{})
    elif at.slot != 0:
        touched(moved(t, SLOTS + i64(at.slot) - 1, at), pos, running, Set{})

# an operation of an Arena changes it, one word at a time, as a thread of each round changes its own element
func worded(arena: Target):
    for k in 0..i64(mem.arena) / 8:
        access(plus(arena, i32(k * 8), 0, 0), true, 8)

# t at the place at in owner
func moved(t: Touch, owner: i64, at: Target) -> Touch:
    out := t
    out.owner = u32(owner)
    out.off = at.off
    out.stride = at.stride
    out.count = at.count
    return out

# a touch here, by this function or by the thread of blocks that it starts: it races with the threads of running, and the callers see it when it is of their memory
func touched(t: Touch, pos: i64, running: Set, blocks: Set):
    owner := i64(t.owner)
    if owner < SLOTS and local(owner):
        return
    if mem.speak:
        for r in running - t.after:
            line := newest(r)
            found := NONE
            for k in 0..mem.footprints.len:
                f := mem.footprints[k]
                if f.block == line and (t.wrote and not t.atomic or f.touch.wrote and not f.touch.atomic) and empty(t.locks and f.touch.locks) and (found == NONE or f.touch.wrote and not mem.footprints[found].touch.wrote) and overlap(t, f.touch, line):
                    found = k # a thread that writes it says more than one that reads it
            if found != NONE:
                race(t, mem.footprints[found], pos, blocks[line])
    summed(t)

# t as the callers see it: of their memory, and of the element of a round, of the memory it stands for
func summed(t: Touch):
    owner := i64(t.owner)
    if owner >= SLOTS:
        return
    if standing(owner):
        at := stood(t)
        for p in objects(at.live):
            summed(moved(t, p, at))
    elif mem.fn.outer[owner] and not contains(mem.touched, t):
        put(mem.touched, t, true)
        append(mem.fn.touches, Footprint{NONE, 0, t})

# memory that no other thread sees, or that the runtime of core keeps in order: such a context, what it holds, or the copy of a context that a new thread starts with
func local(o: i64) -> bool:
    x := mem.fn.objs[o]
    while x.kind == Entry and x.depth > 0:
        x = mem.fn.objs[x.parent]
    return x.kind == Shared and mem.local[i64(x.key >> 8)] or (x.key and 0xff) == COPY

# a and b, b a touch of the thread of line, may touch the same bytes: the element of a round is a part of the memory it stands for, and another element in another round
func overlap(a: Touch, b: Touch, line: i64) -> bool:
    owner := i64(a.owner)
    if a.owner == b.owner and standing(owner):
        marker := mem.index[(mem.fn.keys[owner] >> 24 << 24) or (u64(line) << 8) or NOW]
        return marker is u32 and mem.runs.now[i64(marker)] and meet(a, b)
    if a.owner == b.owner:
        return meet(a, b)
    if nesting(i64(b.owner)) > nesting(owner): # the element of the inner walk goes up first
        return overlap(b, a, line)
    if not standing(owner):
        return false
    at := stood(a)
    for p in objects(at.live):
        if overlap(moved(a, p, at), b, line):
            return true
    return at.slot != 0 and overlap(moved(a, SLOTS + i64(at.slot) - 1, at), b, line)

# the thread of line touches t, and it was started in this round of the walk of the element it touches
func started(line: i64, t: Touch):
    if t.owner < SLOTS and mem.fn.focus[i64(t.owner)]:
        m := object((mem.fn.keys[t.owner] >> 24 << 24) or (u64(line) << 8) or NOW, Obj{kind = Pinned})
        if m != OUTSIDE:
            mem.runs.now[m] = true

# o is the element of a round of a walk, which stands for memory of what the walk walks
func standing(o: i64) -> bool:
    return o < SLOTS and mem.fn.focus[o] and mem.fn.objs[o].parent != NONE

# how many walks o is the element of, one inside the other
func nesting(o: i64) -> i64:
    if not standing(o):
        return 0
    return 1 + nesting(mem.fn.objs[o].parent)

# where t, a touch of the element of a round, is in the memory that element stands for: the place of the element in place, or one of the blocks of its line
func stood(t: Touch) -> Target:
    x := mem.fn.objs[t.owner]
    if (mem.fn.keys[t.owner] and 0xff) == ROUND:
        return plus(placed(x), t.off, t.stride, t.count)
    return Target{live = kin(x.parent), off = t.off, stride = t.stride, count = t.count}

# the bytes of a and of b meet in one block
func meet(a: Touch, b: Touch) -> bool:
    if a.off == ANY or b.off == ANY:
        return true
    if ends(a) <= i64(b.off) or ends(b) <= i64(a.off):
        return false
    if a.stride == 0 and b.stride == 0:
        return true
    if a.stride != 0 and b.stride != 0 and a.stride != b.stride:
        return true
    grid := a
    other := b
    if a.stride == 0:
        grid = b
        other = a
    s := i64(grid.stride)
    at := ((i64(other.off) - i64(grid.off)) % s + s) % s
    return at < i64(grid.size) or at + i64(other.size) > s

func ends(t: Touch) -> i64:
    if t.stride == 0:
        return i64(t.off) + i64(t.size)
    if t.count == 0:
        return FAR
    return i64(t.off) + i64(t.stride) * i64(t.count)

# t here races with f, a touch of a thread that may run at the same time, or of an earlier one of the same parallel when itself
func race(t: Touch, f: Footprint, pos: i64, itself: bool):
    name := spelled(i64(t.owner), t.off, t.size).name
    if name.len == 0:
        name = "this memory"
    theirs := f.touch.locks - t.locks
    lock: &strview = ""
    for k in theirs or t.locks - f.touch.locks:
        lock = spelled(mem.fn.objs[k].parent, mem.fn.objs[k].off, 1).name
        break
    text: &str = heap("")
    if lock.len > 0 and not empty(theirs):
        text += "data race: " + name + " is accessed outside 'with lock(" + lock + ")' while another thread uses that lock; acquire the lock around this access"
    elif lock.len > 0:
        text += "data race: another concurrent thread accesses " + name + " outside 'with lock(" + lock + ")'; acquire the lock in that thread"
    elif itself:
        text += "data race: multiple threads started here write " + name + " concurrently; guard it with Lock[T] or give each thread its own copy and merge after wait()"
    elif f.touch.wrote:
        text += "data race: " + name + " is accessed while a concurrent thread writes it with no synchronization; guard it with Lock[T] or wait() before accessing"
    else:
        text += "data race: " + name + " is modified here while a concurrent thread reads it with no synchronization; guard it with Lock[T], or modify it before 'parallel' or after wait()"
    if itself:
        warn(view(text), pos, "", 0, false)
    else:
        warn(view(text), pos, "the thread starts here", f.at, false)

# the name of the size bytes at off in owner, with the fields down to them, and their type: the name is empty when they have none
func spelled(owner: i64, off: i32, size: u32) -> Item:
    out: Item
    if owner >= SLOTS:
        t := mem.fn.slots[owner - SLOTS]
        if mem.fn.variables[t]:
            out = Item{name = mem.fn.names[t], type = mem.fn.places[t]}
    else:
        x := mem.fn.objs[owner]
        if x.kind == Shared or (mem.fn.keys[owner] and 0xff) == COPY: # a context, or the copy a thread starts with
            given := x.name
            if starts_with(given, "thread "):
                given = given["thread ".len:]
            t := comp.type_ids[given["$ctx.".len:]] ifnull VOID
            if t != VOID:
                out = Item{name = text(comp.types[t].decl), type = t}
        elif x.kind == Entry and x.depth == 0 and x.root > 0:
            p := mem.fn.params[x.root - 1]
            out = Item{name = mem.fn.names[p], type = mem.fn.places[p]}
        elif x.kind == Entry and x.depth > 0:
            up := spelled(x.parent, x.off, 8)
            out.name = up.name
            if up.type != VOID and comp.types[up.type].kind == Ptr:
                out.type = comp.types[up.type].elem
            elif up.type != VOID and comp.types[up.type].kind == Fat:
                out.type = element(up.type)
        else:
            out.name = x.name
    while out.type != VOID and off != ANY and (comp.types[out.type].kind == Struct or comp.types[out.type].kind == Array):
        ty := comp.types[out.type]
        if off == 0 and text(ty.decl) == "Lock" and lockable(Target{}, out.type, true).type != VOID: # a lock, not its first field
            break
        inside := out.type
        if ty.kind == Array and comp.types[ty.elem].size > 0:
            out.type = ty.elem
            off = off % i32(comp.types[ty.elem].size)
        for item in comp.items[ty.first:ty.first + ty.count] if ty.kind == Struct else comp.items[0:0]: # an array counts elements, not fields
            if not item.shared and item.n <= off and i64(off) + i64(size) <= item.n + comp.types[item.type].size:
                path: &str = heap("")
                path += out.name + "." + item.name
                out = Item{name = view(path), type = item.type}
                off -= i32(item.n)
                break
        if out.type == inside:
            break
    return out

# t, a touch of g, as touches of this function at this call while it holds locks
func rebound(g: i64, t: Touch, locks: Set):
    if t.owner >= SLOTS: # its stack
        return
    ob := obj_of(g, i64(t.owner))
    if ob.kind == Entry and ob.depth == 0 and ob.root > 0 and mem.fns[g].copies[ob.root - 1]: # its own copy of an argument
        return
    at := plus(binding(i64(t.owner)), t.off, t.stride, t.count)
    out := t
    out.locks = locks
    for k in t.locks:
        lock := obj_of(g, k)
        if lock.parent < SLOTS:
            b := binding(lock.parent)
            mine := lock.parent == i64(t.owner) and (lock.stride != 0 and t.stride == lock.stride or b.stride != 0 and b.off != ANY and t.off != ANY and t.stride == 0 and i64(b.off) % i64(b.stride) + i64(t.off) + i64(t.size) <= i64(b.stride)) # in the element of the lock, whichever that is
            l := lock_of(plus(b, lock.off, lock.stride, 0), mine)
            if l != NONE:
                out.locks[l] = true
    out.after = Set{}
    for x in t.after:
        out.after = out.after or objects(binding(x).live)
    for x in objects(at.live) - mem.pinned - bit(GONE) - bit(RETURNED):
        append(mem.passed, moved(out, x, at))
    if at.slot != 0 and at.slot != ALL:
        append(mem.passed, moved(out, SLOTS + i64(at.slot) - 1, at))

# the object that stands for the lock that l points to, NONE when it may be in more than one place, unless it guards only its own element
func lock_of(l: Target, element: bool) -> i64:
    owner := sole(l)
    if owner == NONE or l.off == ANY or l.stride != 0 and not element:
        return NONE
    k := object((child(owner, l.off, l.stride) xor FIELD) or HELD, Obj{kind = Pinned, parent = owner, off = l.off, stride = l.stride})
    if k == OUTSIDE:
        return NONE
    return k

# the thread of block is gone, and a new one may take its place
func retire(block: i64):
    kept := 0
    for f in mem.footprints:
        if f.block != block:
            mem.footprints[kept] = f
            kept += 1
    mem.footprints.len = kept

func snapshot() -> State:
    out := State{marks = mem.marks, runs = mem.runs, seen = true}
    ordered := true
    for id in mem.present:
        if mem.ticked[id] == mem.tick:
            ordered = ordered and (out.ids.len == 0 or out.ids[-1] < id)
            append(out.ids, id)
    if not ordered:
        sort(out.ids)
    for id in out.ids:
        if mem.known[id] == 0:
            mem.known[id] = intern(mem.cur[id]) + 1
        append(out.vals, mem.known[id] - 1)
    for t in mem.fn.crossing:
        if mem.interned[t] == 0:
            mem.interned[t] = intern(mem.temps[t]) + 1
        append(out.temps, mem.interned[t] - 1)
    return out

func needed(id: u32, s: i64) -> bool:
    owner := i64(mem.fn.cells[id].owner)
    if owner < SLOTS or s == NONE:
        return true
    k := owner - SLOTS
    return (((mem.fn.alive[s * mem.words + k / 64] or mem.held[k / 64]) >> u64(k % 64)) and 1) != 0

func merge(a: State, b: State, s: i64) -> State:
    out := State{seen = true}
    if not b.seen:
        out.seen = a.seen
        out.marks = a.marks
        out.runs = a.runs
        for k in 0..a.ids.len:
            append(out.ids, a.ids[k])
            append(out.vals, a.vals[k])
        for v in a.temps:
            append(out.temps, v)
        return out
    if not a.seen:
        out.marks = b.marks
        out.runs = b.runs
        for k in 0..b.ids.len:
            if needed(b.ids[k], s):
                append(out.ids, b.ids[k])
                append(out.vals, b.vals[k])
        for v in b.temps:
            append(out.temps, v)
        return out
    x := a.marks
    y := b.marks
    out.marks = Marks{x.live or y.live, x.freed or y.freed, x.killed or y.killed, x.sure and y.sure, x.gone and y.gone, x.used or y.used, x.made or y.made, x.waited or y.waited}
    out.runs = Runs{a.runs.running or b.runs.running, a.runs.now or b.runs.now, a.runs.locks and b.runs.locks, a.runs.joined and b.runs.joined}
    la := alive(x)
    lb := alive(y)
    dying := not (la or lb)
    views: &list[u64] = heap([])
    defer free(views)
    i := 0
    j := 0
    while i < a.ids.len or j < b.ids.len:
        if j == b.ids.len or i < a.ids.len and a.ids[i] < b.ids[j]:
            id := a.ids[i]
            c := mem.fn.cells[id]
            append(out.ids, id)
            append(out.vals, intern(unite(mem.pool[a.vals[i]], missing(b, c), la, lb)))
            if c.member != 0:
                view := mem.pool[out.vals[-1]]
                refer(id, view.live or view.dead)
            alone(views, c, a.vals[i])
            i += 1
        elif i == a.ids.len or b.ids[j] < a.ids[i]:
            id := b.ids[j]
            c := mem.fn.cells[id]
            if needed(id, s):
                append(out.ids, id)
                append(out.vals, intern(unite(missing(a, c), mem.pool[b.vals[j]], la, lb)))
                if c.member != 0:
                    view := mem.pool[out.vals[-1]]
                    refer(id, view.live or view.dead)
                alone(views, c, b.vals[j])
            j += 1
        else:
            id := a.ids[i]
            append(out.ids, id)
            append(out.vals, blend(a.vals[i], b.vals[j], la, lb, dying))
            if a.vals[i] != b.vals[j]:
                wa := mem.pool[a.vals[i]].writer
                wb := mem.pool[b.vals[j]].writer
                if wa != wb and wa != 0 and wb != 0 and mem.fn.cells[id].member == 0:
                    c := mem.fn.cells[id]
                    append(views, (u64(cell_at(i64(c.owner), c.off, c.stride, c.count, wa)) << 32) or u64(a.vals[i]))
                    append(views, (u64(cell_at(i64(c.owner), c.off, c.stride, c.count, wb)) << 32) or u64(b.vals[j]))
            i += 1
            j += 1
    for k in 0..a.temps.len:
        append(out.temps, blend(a.temps[k], b.temps[k], la, lb, dying))
    kept := 0
    for v in views:
        if binary_search(out.ids, u32(v >> 32)) is null:
            views[kept] = v
            kept += 1
            word := mem.pool[v and 0xffff_ffff]
            refer(u32(v >> 32), word.live or word.dead)
    if kept > 0:
        views.len = kept
        for k in 0..out.ids.len:
            append(views, (u64(out.ids[k]) << 32) or u64(out.vals[k]))
        sort(views)
        out.ids.len = 0
        out.vals.len = 0
        for v in views:
            append(out.ids, u32(v >> 32))
            append(out.vals, u32(v and 0xffff_ffff))
    return out

# a word that one path wrote as a member and the other never wrote: read as that member it is what that path wrote
func alone(views: *&list[u64], c: Cell, val: u32):
    w := mem.pool[val].writer
    if w != 0 and c.member == 0 and (c.owner >= SLOTS or not mem.fn.outer[i64(c.owner)]):
        append(views, (u64(cell_at(i64(c.owner), c.off, c.stride, c.count, w)) << 32) or u64(val))

func missing(st: State, c: Cell) -> Target:
    if c.owner < SLOTS and mem.fn.focus[i64(c.owner)]: # a path that never made the element of the round
        return Target{}
    if c.member != 0:
        found := binary_search(st.ids, u32(cell_at(i64(c.owner), c.off, c.stride, c.count, 0)))
        if found is i64:
            return through(mem.pool[st.vals[found]], c.member)
    return initial(i64(c.owner), c.off, c.stride, c.count, c.member)

func blend(x: u32, y: u32, la: Set, lb: Set, dying: Set) -> u32:
    if x == y and empty(mem.pool[x].live and dying):
        return x
    return intern(unite(mem.pool[x], mem.pool[y], la, lb))

func pack(s: Summary) -> State:
    out := State{marks = s.marks, seen = s.seen}
    for k in 0..s.ids.len:
        append(out.ids, s.ids[k])
        append(out.vals, intern(s.aims[k]))
    return out

func intern(v: Target) -> u32:
    found := mem.pooled[v]
    if found is u32:
        return found
    mem.pooled[v] = u32(mem.pool.len)
    append(mem.pool, v)
    return u32(mem.pool.len - 1)

operator hash(v: Target) -> u64:
    h := fold(fold(fold(FNVBASIS, v.live), v.dead), v.must)
    h = (h xor u64(i64(v.off) + 2)) * FNVPRIME
    h = (h xor u64(v.stride)) * FNVPRIME
    h = (h xor u64(v.slot)) * FNVPRIME
    # MurmurHash3 finalizer
    h = (h xor (h >> 33)) * 0xff51_afd7_ed55_8ccd
    h = (h xor (h >> 33)) * 0xc4ce_b9fe_1a85_ec53
    return h xor (h >> 33)

operator hash(t: Touch) -> u64:
    h := fold(FNVBASIS, t.locks)
    h = (h xor u64(t.owner)) * FNVPRIME
    h = (h xor u64(i64(t.off) + 2)) * FNVPRIME
    h = (h xor u64(t.stride)) * FNVPRIME
    h = (h xor u64(t.count)) * FNVPRIME
    h = (h xor u64(t.size)) * FNVPRIME
    h = (h xor u64(t.atomic)) * FNVPRIME
    h = fold((h xor u64(t.wrote)) * FNVPRIME, t.after)
    return h xor (h >> 33)

func fold(h: u64, x: Set) -> u64:
    for w in x.words:
        h = (h xor w) * FNVPRIME
    return h

func release(st: State):
    free(st.ids)
    free(st.vals)
    free(st.temps)

func release(s: Summary):
    free(s.ids)
    free(s.aims)

func target_of(a: Operand) -> Target:
    if a.temp != 0:
        return mem.temps[a.temp]
    if a.data == 1:
        return Target{live = bit(STATIC), must = bit(STATIC)}
    if a.data > 1:
        s := object((u64(a.data - 2) << 8) or SHARED, Obj{kind = Shared, name = mem.globals[a.data - 2], core = mem.core[a.data - 2]})
        return Target{live = bit(s), must = bit(s)}
    if a.n > 0 - FAR and a.n < FAR:
        return number(i32(a.n))
    if a.n >= FAR:
        return number(FAR)
    return number(ANY)

func number(off: i32) -> Target:
    return Target{live = bit(NOWHERE), off = off}

func amount(v: Target) -> Target:
    if plain(v):
        return v
    return number(ANY)

func define(t: u32, v: Target):
    if t == 0:
        return
    mem.temps[t] = v
    mem.temps[t].writer = 0
    mem.interned[t] = 0
    if not mem.fn.cross[t] and mem.fn.last[t] > mem.here and not empty(objects(v.live or v.dead)):
        append(mem.active, t)

# memory that a call gives takes the name of the first variable that holds it
func christen(v: Target, name: &strview):
    for h in objects(v.live) and mem.fn.heaps:
        if mem.fn.objs[h].name.len == 0:
            mem.fn.objs[h].name = name

func pointing(v: Target) -> bool:
    return not empty(objects(v.live)) or not empty(v.dead) or v.slot != 0

func followable(v: Target) -> bool:
    return not empty((v.live or v.dead) - mem.pinned) or v.slot != 0

func plain(v: Target) -> bool:
    return v.live == bit(NOWHERE) and empty(v.dead) and v.slot == 0

func blank(v: Target) -> bool:
    return empty(v.live) and empty(v.dead) and v.slot == 0

func plus(a: Target, off: i32, stride: i32, count: u32) -> Target:
    out := a
    if a.off == ANY or off == ANY or a.stride != 0 and stride != 0 and a.stride != stride:
        out.off = ANY
        out.stride = 0
        out.count = 0
        return out
    out.off = a.off + off
    if stride != 0:
        out.stride = stride
        out.count = 0
        if a.stride == 0:
            out.count = count
    if out.off < 0 or out.off >= FAR or out.stride > EXACT or out.stride != 0 and out.off >= RUN:
        out.off = ANY
        out.stride = 0
        out.count = 0
    return out

func blur(x: Target, y: Target) -> Target:
    out := Target{live = x.live or y.live or bit(NOWHERE), dead = x.dead or y.dead, off = ANY, slot = x.slot, killer = max(x.killer, y.killer)}
    if x.slot == 0:
        out.slot = y.slot
    elif y.slot != 0 and y.slot != x.slot:
        out.slot = ALL
    return out

func unite(a: Target, b: Target, la: Set, lb: Set) -> Target:
    if blank(a):
        return b
    if blank(b):
        return a
    out := a
    out.live = a.live or b.live
    out.dead = a.dead or b.dead
    out.must = (a.must or not la) and (b.must or not lb) and out.live
    out.element = a.element and (b.element or not followable(b)) or b.element and not followable(a)
    out.part = a.part or b.part
    if a.writer != b.writer:
        out.writer = 0
    out.killer = max(a.killer, b.killer)
    if a.member != b.member and not plain(b):
        out.member = 0
    if a.slot == 0:
        out.slot = b.slot
    elif b.slot != 0 and b.slot != a.slot:
        out.slot = ALL
    stride := a.stride
    if stride == 0:
        stride = b.stride
    if stride == 0:
        stride = a.off - b.off
    if stride < 0:
        stride = 0 - stride
    if plain(a):
        out.off = b.off
        out.stride = b.stride
        out.count = b.count
        out.member = b.member
    elif plain(b) or a.off == b.off and a.stride == b.stride and a.count == b.count:
        return out
    elif a.off == ANY or b.off == ANY or a.stride != 0 and b.stride != 0 and a.stride != b.stride or (a.off - b.off) % stride != 0 or stride > EXACT or a.off >= RUN and b.off >= RUN:
        out.off = ANY
        out.stride = 0
        out.count = 0
    else:
        out.stride = stride
        out.count = 0
        if b.off < a.off:
            out.off = b.off
    return out

func fetch(a: Target) -> Target:
    out: Target
    owners := objects(a.live or a.dead)
    count := 0
    exact := a.off != ANY and a.stride == 0
    live := alive(mem.marks)
    for o in owners:
        count += 1
        if o == STATIC or o == OUTSIDE:
            out = unite(out, Target{live = bit(o), must = bit(o)}, live, live)
        elif o != GONE:
            exact = exact and not mem.fn.many[o]
            out = gather(out, o, a.off, a.stride, a.count, a.member, live)
    if a.slot == ALL:
        count += 2
        for s in 0..mem.fn.slots.len:
            out = gather(out, SLOTS + s, a.off, a.stride, a.count, a.member, live)
    elif a.slot != 0:
        count += 1
        out = gather(out, SLOTS + i64(a.slot) - 1, a.off, a.stride, a.count, a.member, live)
    if blank(out):
        return number(0)
    if count > 1 or not exact:
        out.must = Set{}
    if not exact:
        out.element = true
    out.part = out.part or a.part
    return out

func gather(out: Target, owner: i64, off: i32, stride: i32, count: u32, member: u32, live: Set) -> Target:
    word: u32 = 0
    view: u32 = 0
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        if c.off == off and c.stride == stride and c.count == count:
            if c.member == 0:
                word = h
            elif c.member == member:
                view = h
        elif c.member == 0:
            fits := c.off == ANY or off == ANY
            if not fits and c.stride == 0 and stride == 0:
                fits = c.off == off
            elif not fits and c.stride == 0:
                fits = c.off >= off and (c.off - off) % stride == 0
            elif not fits and stride == 0:
                fits = off >= c.off and (off - c.off) % c.stride == 0
            elif not fits:
                fits = c.stride != stride or (c.off - off) % stride == 0
            if fits and c.off != ANY and off != ANY: # the elements of an array end where it ends
                fits = (count == 0 or i64(c.off) < i64(off) + i64(count) * i64(stride)) and (c.count == 0 or i64(off) < i64(c.off) + i64(c.count) * i64(c.stride))
            if fits and mem.ticked[h - 1] != mem.tick and off != ANY: # untouched, a cell that spans more holds what this one does
                fits = c.off != ANY and (c.stride == 0 or c.stride == stride)
            if fits:
                held := current(i64(h) - 1)
                if c.stride != 0 and stride == 0 and off != ANY:
                    for b in held.live and mem.marks.freed: # freed at an index it doesn't know, it may be this one
                        if mem.fn.objs[b].element and not mem.fn.objs[b].taken:
                            held.dead[b] = true
                out = unite(out, held, live, live)
        h = c.next
    if view != 0:
        return unite(out, current(i64(view) - 1), live, live)
    if word == 0 or member != 0 and mem.ticked[word - 1] != mem.tick:
        return unite(out, initial(owner, off, stride, count, member), live, live)
    if member != 0:
        return unite(out, through(cell_value(word - 1), member), live, live)
    return unite(out, current(i64(word) - 1), live, live)

func stash(a: Target, v: Target):
    if a.member != 0:
        v.writer = a.member
    one := sole(a) != NONE
    for o in a.live - mem.pinned:
        settle(cell_at(o, a.off, a.stride, a.count, 0), v, (one or a.must[o]) and not mem.fn.many[o])
    if a.slot == ALL:
        for s in 0..mem.fn.slots.len:
            settle(cell_at(SLOTS + s, a.off, a.stride, a.count, 0), v, false)
    elif a.slot != 0:
        settle(cell_at(SLOTS + i64(a.slot) - 1, a.off, a.stride, a.count, 0), v, one)
    if a.live[OUTSIDE]:
        if mem.speak and mem.fn.stuck.len == 0 and followable(v):
            warn(UNFOLLOWED, mem.ops[mem.here].pos, "", 0, false)
        settle(cell_at(OUTSIDE, ANY, 0, 0, 0), v, false)

func sole(a: Target) -> i64:
    targets := a.live - mem.pinned
    if a.slot == 0 and single(targets):
        for o in targets:
            return o
    if empty(targets) and a.slot != 0 and a.slot != ALL:
        return SLOTS + i64(a.slot) - 1
    return NONE

func settle(id: i64, given: Target, exact: bool):
    c := mem.fn.cells[id]
    v := given
    if mem.rounding and c.owner < SLOTS: # what writes the list a walk is in changes the element of its round too
        focus := mem.fn.focus
        for r in focus:
            p := mem.fn.objs[r].parent
            if (mem.fn.keys[r] and 0xff) == ROUND and mem.marks.live[r] and p >= 0 and p < SLOTS and kin(p)[i64(c.owner)]:
                k := mem.fn.heads[r]
                while k != 0:
                    d := mem.fn.cells[k - 1]
                    if mem.ticked[k - 1] == mem.tick:
                        w := cell_value(k - 1)
                        w.writer = ALL
                        rewrite(i64(k) - 1, w)
                    k = d.next
    if plain(v) and v.off != 0 and v.off != ANY and v.stride == 0: # a pointer that holds a number holds the mark of the heap
        v = Target{live = bit(STATIC), must = bit(STATIC), writer = given.writer}
    elif plain(v):
        v = number(0)
        v.writer = given.writer
    if exact and c.off != ANY and c.stride == 0:
        held := mem.index[(child(i64(c.owner), c.off, 0) xor FIELD) or PLACE]
        if held is u32 and mem.marks.live[i64(held)] and not v.live[i64(held)]: # the block named after this place leaves it, and the name is for the next one
            age(i64(held))
        place(id, v)
    else:
        old := current(id)
        live := alive(mem.marks)
        w := unite(old, v, live, live)
        w.must = Set{}
        if many(c):
            w.must = (old.must or v.must) and w.live
            for h in objects(v.must and old.live) and mem.fn.heaps - mem.fn.many: # one block put in the elements again
                mem.fn.objs[h].twice = true
            if v.element or mem.fn.walks:
                for h in objects(v.live):
                    if v.element or mem.fn.focus[h] and (mem.fn.keys[h] and 0xff) == FOCUS: # the element of a round stored in a list
                        mem.fn.objs[h].element = true
        place(id, w)
    if c.member == 0 and mem.viewed:
        h := mem.fn.heads[c.owner]
        while h != 0:
            d := mem.fn.cells[h - 1]
            if d.member != 0 and d.off == c.off and d.stride == c.stride and d.count == c.count:
                drop(i64(h) - 1)
            h = d.next

func many(c: Cell) -> bool:
    return c.off == ANY or c.stride != 0 or c.owner < SLOTS and mem.fn.many[i64(c.owner)]

func cell_value(id: u32) -> Target:
    if mem.fresh[id] == mem.tick:
        return mem.cur[id]
    return mem.pool[mem.known[id] - 1]

func current(id: i64) -> Target:
    if mem.ticked[id] == mem.tick:
        return cell_value(u32(id))
    c := mem.fn.cells[id]
    if c.member != 0:
        word := cell_at(i64(c.owner), c.off, c.stride, c.count, 0)
        if mem.ticked[word] == mem.tick:
            return through(cell_value(u32(word)), c.member)
    return initial(i64(c.owner), c.off, c.stride, c.count, c.member)

func through(word: Target, member: u32) -> Target:
    if word.writer == 0 or word.writer == member:
        return word
    return Target{}

func place(id: i64, v: Target):
    c := mem.fn.cells[id]
    if plain(v) and v.off == 0 and v.stride == 0 and v.writer == 0 and (c.owner >= SLOTS or not mem.fn.outer[i64(c.owner)]):
        drop(id)
        return
    if v.slot != 0 and v.slot != ALL:
        k := i64(v.slot) - 1
        mem.pointed[k / 64] = mem.pointed[k / 64] or (u64(1) << u64(k % 64))
    fresh := v.live or v.dead
    if mem.ticked[id] == mem.tick:
        old := cell_value(u32(id))
        fresh = fresh - (old.live or old.dead) or v.live - v.dead - (old.live - old.dead)
    elif mem.ticked[id] == (mem.tick xor DROPPED):
        mem.ticked[id] = mem.tick
    else:
        mem.ticked[id] = mem.tick
        append(mem.present, u32(id))
    refer(u32(id), fresh)
    rewrite(id, v)

func rewrite(id: i64, v: Target):
    mem.cur[id] = v
    mem.fresh[id] = mem.tick
    mem.known[id] = 0

func refer(id: u32, blocks: Set):
    for o in objects(blocks):
        append(mem.refs[o], id)

func drop(id: i64):
    if mem.ticked[id] == mem.tick:
        mem.ticked[id] = mem.tick xor DROPPED

# owner holds nothing from here on
func wipe(owner: i64):
    h := mem.fn.heads[owner]
    while h != 0:
        drop(i64(h) - 1)
        h = mem.fn.cells[h - 1].next

func initial(owner: i64, off: i32, stride: i32, count: u32, member: u32) -> Target:
    if owner >= SLOTS or not mem.fn.outer[owner]:
        if owner < SLOTS and mem.fn.focus[owner] and mem.fn.objs[owner].parent != NONE: # one block of its parent, with what that one holds, or the element in place, where it is
            x := mem.fn.objs[owner]
            at := plus(Target{off = x.off, stride = x.stride, count = x.count}, off, stride, count)
            return focused(initial(x.parent, at.off, at.stride, at.count, member), mem.fn.keys[owner] >> 24, x.depth + u32((mem.fn.keys[owner] and 0xff) != ROUND))
        return number(0)
    if member >= MEMBERS:
        return initial(owner, off, stride, count, 0)
    x := mem.fn.objs[owner]
    if x.depth > HOPS:
        return Target{live = bit(owner), must = bit(owner)} # past HOPS pointers a block is all the memory it reaches
    c := object(child(owner, off, stride) or (u64(member) << 50), Obj{kind = Entry, parent = owner, off = off, stride = stride, count = count, member = member, root = x.root, core = x.core, depth = x.depth + 1, many = mem.fn.many[owner] or off == ANY or stride != 0 or x.depth == HOPS})
    if mem.fn.objs[c].count != count:
        mem.fn.objs[c].count = 0
    return Target{live = bit(c), must = bit(c)}

func child(owner: i64, off: i32, stride: i32) -> u64:
    code: u64 = 0
    if off != ANY and stride == 0:
        code = u64(off + 1)
    elif off != ANY:
        code = u64(FAR + 1) + u64(stride) * RUN + u64(off) # past every exact one
    return (u64(owner) << 40) or (code << 8) or FIELD

func cell_at(owner: i64, off: i32, stride: i32, count: u32, member: u32) -> i64:
    if member != 0:
        cell_at(owner, off, stride, count, 0) # a word before its views, settling it drops them
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        if c.off == off and c.stride == stride and c.count == count and c.member == member:
            return i64(h) - 1
        h = c.next
    append(mem.fn.cells, Cell{owner = u32(owner), next = mem.fn.heads[owner], off = off, stride = stride, count = count, member = member})
    mem.fn.heads[owner] = u32(mem.fn.cells.len)
    if member != 0:
        mem.viewed = true
    grow_cells()
    return mem.fn.cells.len - 1

func grow_cells():
    while mem.cur.len < mem.fn.cells.len:
        append(mem.cur, Target{})
        append(mem.fresh, u32(0))
        append(mem.ticked, u32(0))
        append(mem.renamed, u32(0))
        append(mem.known, u32(0))

func object(key: u64, x: Obj) -> i64:
    found := mem.index[key]
    if found is u32:
        return found
    if mem.fn.keys.len == SLOTS:
        mem.fn.stuck = "it has more than " + SLOTS + " blocks of memory to follow"
        return OUTSIDE
    n := mem.fn.objs.len
    y := x
    y.key = key
    append(mem.fn.keys, key)
    mem.index[key] = u32(n)
    append(mem.fn.objs, y)
    if x.kind == Heap:
        mem.fn.heaps = mem.fn.heaps or bit(n)
    if x.kind == Entry or x.kind == Shared:
        mem.fn.outer = mem.fn.outer or bit(n)
    if x.kind == Shared:
        mem.fn.roots = mem.fn.roots or bit(n)
    if x.kind == Focus:
        mem.fn.focus = mem.fn.focus or bit(n)
        mem.fn.walks = true
    if x.many:
        mem.fn.many = mem.fn.many or bit(n)
    if x.depth > HOPS:
        mem.fn.far = mem.fn.far or bit(n)
    if x.arena:
        mem.fn.arenas = mem.fn.arenas or bit(n)
    return n

func reborn(was: Target, blocks: Set, out: *Target, arena: Target, key: u64, given: Obj) -> i64:
    unset := was.live[NOWHERE] or blank(was)
    own := mem.index[key]
    if unset and own is u32 and was.live[i64(own)] and not was.element: # empty or holding the block named after it, the place holds that one again, unless it is one of several places
        mem.marks.live[i64(own)] = true
        out.live[i64(own)] = true
        out.must[i64(own)] = true
        return i64(own)
    if unset and (single(blocks) and not empty(blocks and mem.fn.heaps and was.must) or not empty(blocks) and empty(blocks - mem.fn.focus)): # one block, or the block of the element of a round
        mem.marks.live = mem.marks.live or blocks
    elif unset:
        h := lodge(arena, key, given)
        out.live = out.live or bit(h)
        out.must = out.must or bit(h)
        return h
    return NONE

func birth(key: u64, given: Obj) -> i64:
    r := object(key, given)
    if r == OUTSIDE:
        return r
    if mem.marks.live[r] or mem.marks.freed[r] or mem.marks.killed[r]:
        age(r)
    revive(r)
    return r

# r joins the older blocks of its line, so it stands for a block made later
func age(r: i64):
    x := mem.fn.objs[r]
    x.many = true
    t := object(mem.fn.keys[r] or AGED, x)
    if t != r:
        absorb(r, bit(t), false)
        for k in 0..mem.footprints.len: # what the threads touched of it is of the older blocks now
            if mem.footprints[k].touch.owner == u32(r):
                mem.footprints[k].touch.owner = u32(t)

# r holds a block made now
func revive(r: i64):
    b := bit(r)
    mem.marks.live = mem.marks.live or b
    mem.marks.freed = mem.marks.freed - b
    mem.marks.killed = mem.marks.killed - b
    mem.marks.sure = mem.marks.sure - b
    mem.marks.gone = mem.marks.gone - b

# what points to r points to t from now on, and what r holds and its marks join those of t: the blocks of r are new to t, or already among its blocks when within
func absorb(r: i64, into: Set, within: bool):
    mem.ages += 1
    lone := single(into) and empty(into and mem.fn.many) # one block, which a pointer can be sure of
    sides := bit(r)
    if not within: # within, what points only to into is still as sure
        sides = sides or into
    for o in sides:
        n := mem.refs[o].len
        for k in 0..n:
            id := mem.refs[o][k]
            if mem.ticked[id] == mem.tick and mem.renamed[id] != mem.ages:
                mem.renamed[id] = mem.ages
                rewrite(i64(id), rename(cell_value(id), r, into, within, lone or many(mem.fn.cells[id]))) # or of where the elements of a list point
                if o == r:
                    for t in into:
                        append(mem.refs[t], id)
    pair := sides or into
    kept := 0
    for v in mem.active:
        if mem.fn.last[v] > mem.here:
            mem.temps[v] = rename(mem.temps[v], r, into, within, lone)
            mem.active[kept] = v
            kept += 1
    mem.active.len = kept
    for v in mem.fn.crossing:
        t := mem.temps[v]
        if t.live[r] or t.dead[r] or not within and not empty((t.live or t.dead or t.must) and pair):
            mem.temps[v] = rename(t, r, into, within, lone)
            mem.interned[v] = 0
    bound := mem.bound
    for k in bound:
        mem.binds[k] = rename(mem.binds[k], r, into, within, lone)
    live := alive(mem.marks)
    h := mem.fn.heads[r]
    while h != 0:
        id := i64(h) - 1
        c := mem.fn.cells[id]
        if mem.ticked[id] == mem.tick:
            v := cell_value(u32(id))
            drop(id)
            for t in into:
                at := cell_at(t, c.off, c.stride, c.count, c.member)
                old := current(at)
                w := unite(old, v, live, live)
                w.must = (old.must or v.must) and w.live
                place(at, w)
        h = c.next
    for t in into:
        mem.fn.objs[t].element = mem.fn.objs[t].element or mem.fn.objs[r].element
        mem.fn.objs[t].twice = mem.fn.objs[t].twice or mem.fn.objs[r].twice
        mem.fn.objs[t].part = mem.fn.objs[t].part or mem.fn.objs[r].part
        mem.fn.objs[t].loose = mem.fn.objs[t].loose or mem.fn.objs[r].loose
    m := mem.marks
    mem.marks = Marks{shift(m.live, r, into), shift(m.freed, r, into), shift(m.killed, r, into), m.sure - pair, m.gone - pair, shift(m.used, r, into), shift(m.made, r, into), shift(m.waited, r, into)}
    mem.runs.running = shift(mem.runs.running, r, into)

# the elements of the last round of a walk join the ones it visited
func visited(walk: u64):
    focus := mem.fn.focus
    for f in focus:
        key := mem.fn.keys[f]
        if (key and 0xff) == FOCUS and key >> 24 == walk and (mem.marks.live[f] or mem.marks.killed[f]):
            absorb(f, bit(visits(walk, mem.fn.objs[f].parent)), true)
    for r in focus:
        if (mem.fn.keys[r] and 0xff) == ROUND and mem.fn.keys[r] >> 24 == walk and mem.marks.live[r] and mem.fn.objs[r].parent != NONE: # the element in place goes back to where it is
            mem.marks.live[r] = false
            element := placed(mem.fn.objs[r])
            k := mem.fn.heads[r]
            while k != 0:
                c := mem.fn.cells[k - 1]
                if mem.ticked[k - 1] == mem.tick and c.member == 0:
                    back := cell_value(k - 1)
                    back.must = Set{} # what it held is in an element already, not one more time
                    back.dead = back.dead - (mem.fn.focus - mem.marks.freed) # freed through another element, like one that pop took: this one stays
                    stash(plus(element, c.off, 0, 0), back)
                drop(i64(k) - 1)
                k = c.next
            for id in mem.refs[r]: # a variable that points to the element in place now points to where it is
                if mem.ticked[id] != mem.tick or mem.fn.cells[id].owner < SLOTS:
                    continue
                was := cell_value(id)
                if was.live[r] or was.dead[r]:
                    at := plus(element, was.off, was.stride, was.count)
                    if was.dead[r]:
                        at.dead = at.dead or at.live
                    rest := was
                    rest.live = was.live - bit(r)
                    rest.dead = was.dead - bit(r)
                    rest.must = was.must - bit(r)
                    live := alive(mem.marks)
                    home := unite(rest, at, live, live)
                    home.must = Set{}
                    refer(id, at.live or at.dead)
                    rewrite(i64(id), home)

# the element r of a walk goes back to the blocks of its line, which stay freed when they were, before the walk or in it
func back(r: i64):
    blocks := kin(mem.fn.objs[r].parent)
    gone := empty(blocks and mem.marks.live)
    absorb(r, blocks, true)
    if gone:
        mem.marks.live = mem.marks.live - blocks

# what stands for the blocks of the line of line that a walk visited
func visits(walk: u64, line: i64) -> i64:
    x := mem.fn.objs[line]
    return object((walk << 24) or (u64(line) << 8) or VISITED, Obj{kind = Focus, parent = line, many = true, name = x.name, from = x.from, pos = x.pos, strict = x.strict})

# where the element of a round of a walk is
func placed(x: Obj) -> Target:
    at: Target
    if x.parent >= SLOTS:
        at = Target{slot = u32(x.parent - SLOTS + 1)}
    elif x.parent != NONE:
        at = Target{live = kin(x.parent)}
    return plus(at, x.off, x.stride, x.count)

# the block that stands for the element in place at element in this round of a walk, which goes back there after it: what it holds starts as the element's own
func rounded(walk: u64, element: Target, shape: u32, name: &strview) -> i64:
    parent := NONE
    if element.slot != 0 and element.slot != ALL:
        parent = SLOTS + i64(element.slot) - 1
    for p in objects(element.live):
        parent = newest(p)
    r := object((walk << 24) or (u64(parent + 1) << 8) or ROUND, Obj{kind = Focus, name = name}) # one for each list the walk indexes
    if r == OUTSIDE or mem.marks.live[r]:
        return r
    x := mem.fn.objs[r]
    x.parent = parent
    x.off = element.off
    x.stride = element.stride
    x.count = element.count
    x.shape = shape
    mem.fn.objs[r] = x
    for k in 0..64 * mem.layouts[shape].len:
        if marked(shape, k):
            word := plus(element, i32(k * 8), 0, 0)
            o := sole(word)
            seen: Set # a block that two elements surely hold, one of them put at an index it knows, is in more than one element
            h := mem.fn.heads[o] if o != NONE and word.off != ANY and word.stride != 0 else 0
            while h != 0:
                c := mem.fn.cells[h - 1]
                if mem.ticked[h - 1] == mem.tick and c.member == 0 and (c.off == word.off and c.stride == word.stride or c.stride == 0 and c.off >= word.off and (c.off - word.off) % word.stride == 0 and (word.count == 0 or i64(c.off) < i64(word.off) + i64(word.count) * i64(word.stride))):
                    must := cell_value(h - 1).must and mem.fn.heaps - mem.fn.many
                    for b in must and seen:
                        mem.fn.objs[b].twice = true
                    seen = seen or must
                h = c.next
            place(cell_at(r, i32(k * 8), 0, 0, 0), focused(fetch(word), walk, 0))
    mem.marks.live[r] = true
    mem.rounding = true
    return r

# v as the element of a round of a walk: each block it points to is one of its own, which starts with what the blocks it stands for hold
func focused(v: Target, walk: u64, depth: u32) -> Target:
    if depth > HOPS:
        return v
    out := v
    out.element = false
    for h in freeable(objects(v.live or v.dead)):
        if mem.fn.objs[h].twice:
            continue
        if mem.fn.focus[h] and mem.fn.keys[h] >> 24 == walk: # an element this walk visited is not the one of this round
            out.live[h] = false
            out.dead[h] = false
            out.must[h] = false
            continue
        line := newest(h) # it and the older blocks of its line stand for the one block of the element, whichever it is
        x := mem.fn.objs[line]
        if depth == 0 and (mem.fn.keys[line] and 0xff) == SITE and single(kin(line)) and not mem.fn.many[line]: # one block, which a list or a map on the heap may not hold, and then the walk doesn't visit it
            for id in mem.refs[line]:
                held := mem.fn.cells[id]
                if mem.ticked[id] == mem.tick and held.owner < SLOTS and mem.fn.heaps[i64(held.owner)] and many(held) and cell_value(id).live[line] and not cell_value(id).must[line]:
                    mem.marks.live[visits(walk, line)] = true
        f := object((walk << 24) or (u64(line) << 8) or FOCUS, Obj{kind = Focus, parent = line, depth = depth, name = x.name, from = x.from, pos = x.pos, strict = x.strict})
        if f == OUTSIDE:
            continue
        out = rename(out, h, bit(f), true, true)
        out.must[f] = out.live[f]
        if not mem.marks.live[f]:
            revive(f)
            live := alive(mem.marks)
            for kin in kin(line):
                k := mem.fn.heads[kin]
                while k != 0:
                    c := mem.fn.cells[k - 1]
                    if mem.ticked[k - 1] == mem.tick:
                        at := cell_at(f, c.off, c.stride, c.count, c.member)
                        w := focused(cell_value(k - 1), walk, depth + 1)
                        if mem.ticked[at] == mem.tick: # what the older blocks hold
                            old := cell_value(u32(at))
                            w = unite(old, w, live, live)
                            w.must = (old.must or w.must) and w.live
                        place(at, w)
                    k = c.next
    return out

# the newest block of the line of h, which kin goes back from
func newest(h: i64) -> i64:
    key := mem.fn.keys[h]
    if (key and AGED) != 0:
        return i64(mem.index[key xor AGED] ifnull u32(h))
    return h

# h and the older blocks of its line
func kin(h: i64) -> Set:
    out := bit(h)
    aged := mem.index[mem.fn.keys[h] or AGED]
    if aged is u32:
        out[i64(aged)] = true
    return out

func shift(m: Set, r: i64, into: Set) -> Set:
    if not m[r]:
        return m
    return m - bit(r) or into

# v with r as the blocks of into: when r is among their blocks it stays as sure as it was of r if it keeps, and else it is sure of one only when it was of both, or they were freed
func rename(v: Target, r: i64, into: Set, within: bool, keeps: bool) -> Target:
    pair := bit(r) or into
    if empty((v.live or v.dead or v.must) and pair):
        return v
    out := v
    out.live = shift(v.live, r, into)
    out.dead = shift(v.dead, r, into)
    out.must = v.must - pair
    for t in into:
        sure := (v.must[r] or not mem.marks.live[r]) and (v.must[t] or not mem.marks.live[t])
        if within:
            sure = v.must[t] or v.must[r] and keeps
        out.must[t] = out.live[t] and sure
    return out

func condemn(o: i64, strong: bool, freed: bool):
    b := bit(o)
    mem.condemned = mem.condemned or b
    mem.marks.killed = mem.marks.killed or b
    if freed:
        mem.marks.freed = mem.marks.freed or b
        mem.released = mem.released or b
    if strong:
        mem.strong = mem.strong or b
        mem.marks.sure = mem.marks.sure or b

func sweep():
    if empty(mem.condemned):
        return
    if mem.fn.walks:
        focus := mem.fn.focus
        o := mem.ops[mem.here]
        for f in focus: # a block that the element of a round stands for, or the list it is in, goes and takes it along, but at the end of its walk it keeps what its round did
            p := mem.fn.objs[f].parent
            if p >= 0 and p < SLOTS and not empty(kin(p) and mem.condemned) and not (o.code == Walked and mem.fn.keys[f] >> 24 == u64(o.b.n)):
                mem.condemned[f] = true
    condemned := mem.condemned
    for o in condemned and mem.fn.outer:
        x := mem.fn.objs[o]
        if x.depth > 0:
            id := cell_at(x.parent, x.off, x.stride, x.count, x.member)
            if mem.ticked[id] != mem.tick:
                place(id, initial(x.parent, x.off, x.stride, x.count, x.member))
    strong := mem.strong
    loose: Set
    for o in condemned - strong:
        loose[o] = mem.fn.objs[o].element and not mem.fn.objs[o].twice # one block of several elements is in the others too
    for o in condemned:
        first := 0
        if (mem.swept[o] >> 32) == u64(mem.tick) and not strong[o]:
            first = i64(mem.swept[o] and 0xffff_ffff)
        for k in first..mem.refs[o].len:
            id := mem.refs[o][k]
            c := mem.fn.cells[id]
            owner := i64(c.owner)
            hit := condemned
            if mem.walking.len > 0 and contains(mem.walking, owner if owner >= SLOTS else newest(owner)):
                hit = strong # the lists that a walk walks hold what it changed, and lose only what it surely freed
            elif many(c):
                hit = strong or mem.released - loose # an element freed at an index it knows may be any of a list, at one it doesn't know it stays live there, and so does one moved
            elif owner < SLOTS and mem.fn.heaps[owner]:
                hit = condemned - loose # an element freed through a variable stays live where the heap keeps it, like in a list
            for m in mem.regrown: # a place it may have moved through holds it still, or the new block
                at := m.at
                here := at.live[owner] if owner < SLOTS else at.slot != 0 and at.slot != ALL and owner == SLOTS + i64(at.slot) - 1
                if here and c.off != ANY and c.stride == 0 and (at.off == ANY or at.stride == 0 and at.off == c.off or at.stride != 0 and c.off >= at.off and (c.off - at.off) % at.stride == 0):
                    hit = hit - (m.blocks - strong - mem.released)
            if mem.ticked[id] == mem.tick and not empty(cell_value(id).live and hit):
                rewrite(i64(id), kill(cell_value(id), hit, strong))
        mem.swept[o] = (u64(mem.tick) << 32) or u64(mem.refs[o].len)
    kept := 0
    for t in mem.active:
        if mem.fn.last[t] > mem.here:
            mem.temps[t] = kill(mem.temps[t], condemned, strong)
            mem.active[kept] = t
            kept += 1
    mem.active.len = kept
    for t in mem.fn.crossing:
        mem.temps[t] = kill(mem.temps[t], condemned, strong)
        mem.interned[t] = 0
    mem.condemned = Set{}
    mem.strong = Set{}
    mem.released = Set{}
    mem.regrown.len = 0
    for o in strong and mem.fn.heaps and mem.marks.gone - mem.marks.live: # what a block freed for sure held is gone, and the next block of its line starts empty
        wipe(o)

func vanish(gone: Set):
    mem.marks.live = mem.marks.live - gone
    mem.marks.gone = mem.marks.gone or gone
    mem.marks.sure = mem.marks.sure or gone

func kill(v: Target, condemned: Set, strong: Set) -> Target:
    hit := v.live and condemned
    if empty(hit):
        return v
    gone := hit and strong
    v.dead = v.dead or hit
    v.killer = mem.ops[mem.here].pos
    v.live = v.live - gone
    v.must = v.must - gone
    return v

func touch(a: Target, name: &strview):
    use(a.live or a.dead)
    stale(a, name, false)

func use(x: Set):
    mem.marks.used = mem.marks.used or x and mem.fn.outer
    if mem.fn.walks:
        focus := x and mem.fn.focus
        mem.marks.used = mem.marks.used or focus
        for r in focus: # the element in place is in the memory of its list
            p := mem.fn.objs[r].parent
            if (mem.fn.keys[r] and 0xff) == ROUND and p >= 0 and p < SLOTS:
                use(kin(p))

func stale(a: Target, name: &strview, strict: bool):
    if mem.speak and not empty(a.dead):
        text: &str = heap("")
        for o in a.dead:
            if (mem.fn.objs[o].key and 0xff) == ENDED:
                gone := mem.fn.objs[o].name
                if name.len > 0:
                    text += "dangling pointer: " + name + " points to "
                else:
                    text += "dangling pointer: this uses "
                if gone.len > 0:
                    text += gone + " after its enclosing block ended; allocate on the heap or declare " + gone + " outside the block"
                else:
                    text += "a temporary whose enclosing block ended; allocate on the heap or store it in a variable declared outside the block"
                warn(view(text), mem.ops[mem.here].pos, "", 0, strict)
                return
        if name.len > 0:
            text += "use after free: " + name + " points to memory that may already be freed"
        else:
            text += "use after free: this uses memory that may already be freed"
        warn(view(text), mem.ops[mem.here].pos, "it may be freed here", a.killer, strict)

func freeable(live: Set) -> Set:
    out := live and (mem.fn.heaps - mem.fn.arenas or mem.fn.outer - mem.fn.roots)
    if mem.fn.walks:
        out = out or live and mem.fn.focus
    return out

func refusal(v: Target, kept: bool) -> &strview:
    if not empty(v.dead):
        return "; it may already be freed (possible double free)"
    if offheap(v) or v.live[STATIC] and not kept: # an owner in a constant is empty, so discard gets nothing from static data
        return "; it is not heap-allocated"
    chunks := v.live and mem.fn.arenas
    for h in chunks:
        if not mem.fn.objs[h].pool:
            return "; it is scratch memory released by 'with scratch()'"
    if kept or empty(chunks):
        return ""
    for h in chunks:
        for id in mem.refs[h]:
            c := mem.fn.cells[id]
            if c.off == ANY and c.owner < SLOTS and not mem.fn.objs[c.owner].arena and mem.fn.objs[c.owner].name.len > 0:
                name := mem.fn.objs[c.owner].name
                return "; it belongs to arena " + name + " (release with free(" + name + "))"
    return "; it belongs to an arena (free the arena instead)"

func offheap(v: Target) -> bool:
    return v.slot != 0 or v.live[RETURNED] or not empty(v.live and mem.fn.roots)

func chunk(arena: Target, name: &strview, key: u64, given: Obj) -> i64:
    held := fetch(arena)
    if empty(objects(held.live)):
        o := sole(arena)
        if name.len == 0 and o != NONE and o >= SLOTS:
            name = mem.fn.names[mem.fn.slots[o - SLOTS]]
        elif name.len == 0 and o != NONE:
            name = mem.fn.objs[o].name
        b := birth((key and 0xffff_ffff_ffff_ff00) or BLOCKS, Obj{kind = Heap, born = given.born, pos = given.pos, from = given.from, name = name})
        held = Target{live = bit(b), must = bit(b)}
    blocks := objects(held.live)
    stash(arena, Target{live = blocks, must = held.must and blocks})
    mem.marks.made = mem.marks.made or blocks and (mem.fn.outer or mem.fn.focus)
    given.arena = true
    given.pool = true
    k := birth(key or POOLED, given)
    stash(Target{live = blocks, off = ANY}, Target{live = bit(k), must = bit(k)})
    return k

func lodge(arena: Target, key: u64, given: Obj) -> i64:
    given.home = home_of(arena)
    if followable(arena) and given.home == 0:
        return chunk(arena, "", key, given)
    return birth(key, given)

func arena_of(ob: Obj) -> Target:
    if ob.home == 0:
        return number(0)
    return binding(i64(ob.home) - 1)

func home_of(arena: Target) -> u32:
    entry := sole(arena)
    if entry == NONE or entry >= SLOTS or not mem.fn.outer[entry] or mem.fn.roots[entry]:
        return 0
    return u32(entry) + 1

func refuse(who: &strview, name: &strview, why: &strview, v: Target, strict: bool):
    text: &str = heap("")
    if name.len > 0:
        text += who + " cannot release " + name + why
    else:
        text += who + " cannot release this memory" + why
    warn(view(text), mem.ops[mem.here].pos, "it may be freed here", v.killer, strict)

func immovable(who: &strview, name: &strview, why: &strview, strict: bool):
    text: &str = heap("")
    if name.len > 0:
        text += who + " cannot grow " + name + why
    else:
        text += who + " cannot grow this memory" + why
    warn(view(text), mem.ops[mem.here].pos, "", 0, strict)

func counted(v: Target, name: &strview):
    if followable(v):
        text: &str = heap("")
        text += "-memory cannot track " + (name if name.len > 0 else "a pointer") + " after converting it to an integer; keep it in a pointer type"
        warn(view(text), mem.ops[mem.here].pos, "", 0, false)

func touch_args(o: Op):
    for k in o.first..o.first + o.count:
        touch(target_of(mem.args[k]), mem.fn.names[mem.args[k].temp])

# a store of each word: the words that shape marks hold pointers, the others numbers
func transfer(to: Target, from: Target, size: i64, shape: u32):
    for k in 0..size / 8:
        if marked(shape, k):
            stash(plus(to, i32(k * 8), 0, 0), fetch(plus(from, i32(k * 8), 0, 0)))
        elif to.member != 0:
            stash(plus(to, i32(k * 8), 0, 0), number(0))
    if not mem.viewed or from.off == ANY or from.member != 0:
        return
    owner := sole(from)
    into := sole(to)
    if owner == NONE or into == NONE:
        return
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        k := i64(c.off) - i64(from.off)
        if c.member != 0 and c.stride == from.stride and k >= 0 and k < size and k % 8 == 0 and marked(shape, k / 8) and mem.ticked[h - 1] == mem.tick:
            spot := plus(to, i32(k), 0, 0)
            if spot.off != ANY:
                settle(cell_at(into, spot.off, spot.stride, spot.count, c.member), cell_value(h - 1), into >= SLOTS or not mem.fn.many[into])
        h = c.next

func copied(from: Target, t: i64, name: &strview):
    found := lockable(from, t, false)
    if found.type == VOID:
        return
    kind := text(comp.types[found.type].decl)
    text: &str = heap("")
    text += "copying "
    if found.name.len > 0 and name.len > 0:
        text += "the " + kind + " " + found.name + " in " + name + ","
    elif found.name.len > 0:
        text += "the " + kind + " " + found.name + " in this value,"
    elif name.len > 0:
        text += name + ", " + kind_of(found.type)
    else:
        text += kind_of(found.type)
    switch kind:
    case "Arena":
        text += " that may have given memory: the copy gives out the same blocks"
    case "Lock":
        text += " that may have been taken: the copy is another lock"
    case:
        text += " that may be in use: the copy is another channel"
    text += "; pass or store a pointer instead"
    warn(view(text), mem.ops[mem.here].pos, "", 0, false)

# the first Arena, Lock or Channel of core in a value of type t at from, with its path, that this function used unless any
func lockable(from: Target, t: i64, any: bool) -> Item:
    ty := comp.types[t]
    none: Item
    if ty.decl != 0 and file_of(comp.tokens[comp.nodes[ty.decl].tok].at) == 0 and (text(ty.decl) == "Arena" or text(ty.decl) == "Lock" or text(ty.decl) == "Channel"):
        if any:
            return Item{type = t}
        first := fetch(from) # the blocks of an Arena, the mutex of a Lock and of the Lock a Channel starts with
        if not empty(objects(first.live or first.dead) - mem.fn.outer):
            return Item{type = t}
    elif ty.kind == Struct:
        for item in comp.items[ty.first:ty.first + ty.count]:
            if item.shared:
                continue
            found := lockable(plus(from, i32(item.n), 0, 0), item.type, any)
            if found.type != VOID:
                path: &str = heap("")
                path += item.name
                if found.name.len > 0:
                    path += "." + found.name
                found.name = view(path)
                return found
    elif ty.kind == Array and ty.count > 0:
        return lockable(plus(from, 0, i32(comp.types[ty.elem].size), u32(ty.count)), ty.elem, any)
    return none

func kind_of(t: i64) -> &strview:
    if text(comp.types[t].decl) == "Arena":
        return "an Arena"
    if text(comp.types[t].decl) == "Lock":
        return "a Lock"
    return "a Channel"

func marked(shape: u32, k: i64) -> bool:
    words := mem.layouts[shape]
    return shape == EVERY or k / 64 < words.len and ((words[k / 64] >> u64(k % 64)) and 1) != 0

# the words of t that hold a pointer, or with owners only those that own memory
func layout(t: i64, owners: bool) -> u32:
    key := 2 * t
    if owners:
        key += 1
    found := mem.shaped[key]
    if found is u32:
        return found
    words: &list[u64] = heap([])
    for w in 0..comp.types[t].size / 512 + 1:
        append(words, u64(0))
    lay(ptr(words), t, 0, owners)
    id: u32 = 0
    for w in words:
        if w != 0:
            id = u32(mem.layouts.len)
    if id == 0:
        free(words)
    else:
        append(mem.layouts, words)
    put(mem.shaped, key, id)
    return id

func lay(words: *&list[u64], t: i64, at: i64, owners: bool):
    ty := comp.types[t]
    if ty.kind == Ptr or ty.kind == Thread or ty.kind == Func and not owners or ty.kind == Fat and (not owners or ty.count > 1): # a view has only its len
        words.*[at / 64] = words.*[at / 64] or u64(1) << u64(at % 64)
    if ty.kind == Atomic:
        lay(words, ty.elem, at, owners)
    elif ty.kind == Array and layout(ty.elem, owners) != 0:
        for i in 0..ty.count:
            lay(words, ty.elem, at + i * comp.types[ty.elem].size / 8, owners)
    elif ty.kind == Struct or ty.kind == Fat and not owners:
        for item in comp.items[ty.first:ty.first + ty.count]:
            lay(words, item.type, at + item.n / 8, owners)
    elif ty.kind == Union:
        for item in comp.items[ty.first:ty.first + ty.count]:
            lay(words, item.type, at + 1, owners) # the value is at byte 8
    elif ty.kind == Untagged:
        for item in comp.items[ty.first:ty.first + ty.count]:
            lay(words, item.type, at, owners)

func carry(from: Set, x: i64, into: Set, h: i64, replace: bool) -> Set:
    if replace:
        into = into - bit(h)
    if from[x]:
        into = into or bit(h)
    return into

func obj_of(g: i64, x: i64) -> Obj:
    if g == mem.f:
        return mem.fn.objs[x]
    return mem.fns[g].objs[x]

func binding(x: i64) -> Target:
    if mem.bound[x]:
        return mem.binds[x]
    g := mem.callee
    o := mem.ops[mem.call]
    ob := obj_of(g, x)
    out := Target{dead = bit(GONE)}
    home: Target
    if x <= STATIC:
        out = Target{live = bit(x), must = bit(x)}
    elif ob.kind == Shared:
        s := object(ob.key, ob)
        out = Target{live = bit(s), must = bit(s)}
        t := mem.apart[i64(ob.key >> 8)]
        if o.ghost and t != VOID: # a thread starts with its own, from the defaults or a copy of an inherited one
            c := object((u64(mem.call) << 24) or (u64(x) << 8) or COPY, Obj{kind = Slot, name = ob.name, pos = o.pos})
            wipe(c)
            stamper := mem.ids["$flag.stamp"]
            if declared(comp.types[t].decl) == "inherited":
                if mem.speak:
                    copied(out, t, text(comp.types[t].decl))
                transfer(Target{live = bit(c), must = bit(c)}, out, comp.types[t].size, layout(t, false))
            elif stamper is i64: # the others start with what $flag.stamp writes when the thread enters
                sum := mem.fns[stamper].sum
                for k in 0..sum.ids.len:
                    cell := mem.fns[stamper].cells[sum.ids[k]]
                    if mem.fns[stamper].objs[cell.owner].key == ob.key:
                        place(cell_at(c, cell.off, cell.stride, cell.count, cell.member), sum.aims[k])
            out = Target{live = bit(c), must = bit(c)}
    elif ob.kind == Entry and ob.depth == 0:
        out = number(0)
        if ob.root <= o.count:
            out = target_of(mem.args[i64(o.first) + ob.root - 1])
    elif ob.kind == Entry:
        home = plus(binding(ob.parent), ob.off, ob.stride, ob.count)
        if ob.member != 0:
            home.member = ob.member
        out = fetch(home)
        if ob.depth > HOPS and (mem.fns[g].sum.marks.freed[x] or mem.fns[g].sum.marks.used[x]): # past HOPS pointers a block is also all that it reaches
            must := out.must
            live := alive(mem.marks)
            next := out
            while not blank(next):
                more := fetch(Target{live = objects(next.live or next.dead) - mem.fn.focus, slot = next.slot, off = ANY}) # a focus object stands for blocks of its parent, which this reaches already
                next = Target{live = objects(more.live or more.dead) - objects(out.live or out.dead)}
                if more.slot != 0 and more.slot != out.slot:
                    next.slot = more.slot
                out = unite(out, more, live, live)
            out.must = must
    if ob.kind == Entry and ob.depth <= HOPS and mem.fns[g].sum.marks.made[x]:
        name: &strview
        if ob.depth == 1 and ob.root > 0 and ob.root <= o.count:
            name = named(mem.args[i64(o.first) + ob.root - 1].temp, g, ob.root - 1)
        if name.len == 0 and home.off != ANY and home.stride == 0 and sole(home) != NONE: # a place with no variable of its own, like a field of a context
            name = spelled(sole(home), home.off, 8).name
        key := (u64(mem.call) << 24) or (u64(x) << 8) or SITE
        if home.off != ANY and home.stride == 0 and sole(home) != NONE:
            key = (child(sole(home), home.off, 0) xor FIELD) or PLACE
        h := reborn(out, objects(out.live), ptr(out), arena_of(ob), key, Obj{kind = Heap, pos = o.pos, from = mem.who, name = name})
        if h != NONE:
            mem.fn.objs[h].strict = mem.fn.objs[h].strict or mem.fns[g].strict
        out.live = objects(out.live)
    mem.binds[x] = out
    mem.bound = mem.bound or bit(x)
    return out

# what pop or remove gives back: the block, no longer the element of a walk that visited it
func taken(v: Target) -> Target:
    for f in v.live and mem.fn.focus:
        if mem.fn.objs[f].parent != NONE and (mem.fn.keys[f] and 0xff) == VISITED:
            v.live[f] = false
            v.live = v.live or kin(mem.fn.objs[f].parent)
    for h in objects(v.live) and (mem.fn.heaps or mem.fn.outer):
        mem.fn.objs[h].taken = true
    return v

func translate(v: Target) -> Target:
    if plain(v):
        return v
    out: Target
    live := alive(mem.marks)
    must: Set
    for x in objects(v.live):
        b := plus(binding(x), v.off, v.stride, v.count)
        if v.member != 0:
            b.member = v.member
        if v.must[x]:
            must = must or b.must
        out = unite(out, b, live, live)
    out.must = must and out.live
    for x in v.dead:
        b := binding(x)
        out.dead = out.dead or objects(b.live or b.dead)
        out.killer = max(out.killer, b.killer)
        if not empty(objects(b.live)):
            out.killer = mem.ops[mem.here].pos
    if blank(out):
        out = number(0)
    elif v.live[NOWHERE]:
        out.live = out.live or bit(NOWHERE)
    out.writer = v.writer
    return out

# a pointer into the stack that this function returns, or gives to a thread that may outlive it
func escape(v: Target, pos: i64, returned: bool):
    name: &strview = ""
    if v.slot != 0 and v.slot != ALL:
        name = mem.fn.names[mem.fn.slots[v.slot - 1]]
    copy := false # the copy of an argument that the function takes by value, on its stack too
    for h in v.live:
        o := mem.fn.objs[h]
        if o.kind == Entry and o.depth == 0 and o.root > 0 and mem.fn.copies[o.root - 1]:
            copy = true
            name = mem.fn.names[mem.fn.params[o.root - 1]]
    if v.slot == 0 and not copy:
        return
    if returned:
        warn(STACK, pos, "", 0, false)
        return
    shown := mem.fn.shown
    text: &str = heap("")
    if name.len > 0:
        text += "stack pointer to " + name + " cannot escape " + shown + " because " + name + " lives on its stack"
    else:
        text += "pointer into the stack of " + shown + " cannot escape " + shown
    warn(view(text), pos, "", 0, false)

# temporaries that a thread may still use after this releases them
func outlived(released: Set, at: i64, note: &strview):
    running: Set
    for h in mem.fn.heaps and mem.marks.live:
        running[h] = mem.fn.objs[h].thread and (at != 0 or mem.fn.objs[h].alone)
    if empty(running):
        return
    for h in reach(Target{live = running}, FromValue) and released:
        if not mem.fn.objs[h].pool and mem.fn.objs[h].born != NONE:
            text: &str = heap("")
            text += "thread may still use this temporary after "
            if at != 0:
                text += "its with scratch() releases it: wait for the thread inside it, or give it a &str"
            else:
                text += "the with scratch() of a caller releases it: give the thread a &str"
            warn(view(text), mem.fn.objs[h].pos, note, at, false)
    for h in released:
        if mem.fn.objs[h].sent != 0 and at != 0:
            warn("receiving thread may still use this temporary after 'with scratch()' releases it; wait() for that thread inside the block or send an owned &str", mem.fn.objs[h].sent, note, at, false)

func leaving(v: Target, pos: i64):
    escape(v, pos, false)
    carried := reach(v, FromValue)
    for id in mem.present:
        owner := i64(mem.fn.cells[id].owner)
        if mem.ticked[id] == mem.tick and owner < SLOTS and carried[owner]:
            escape(cell_value(id), pos, false)

func reach(given: Target, how: Reach) -> Set:
    seen := followed(given, how)
    for id in mem.present:
        if mem.ticked[id] == mem.tick:
            owner := i64(mem.fn.cells[id].owner)
            root := owner == RETURNED or owner == OUTSIDE or owner < SLOTS and mem.fn.outer[owner]
            if how == FromGlobals:
                root = owner == OUTSIDE or owner < SLOTS and mem.fn.outer[owner] and mem.fn.objs[owner].root == 0
            elif how == FromValue:
                root = false
            if root:
                seen = seen or followed(cell_value(id), how)
    seen = seen and mem.fn.heaps
    grew := not empty(seen)
    while grew:
        grew = false
        for id in mem.present:
            owner := i64(mem.fn.cells[id].owner)
            if mem.ticked[id] == mem.tick and owner < SLOTS and seen[owner]:
                more := (followed(cell_value(id), how) and mem.fn.heaps) - seen
                if not empty(more):
                    seen = seen or more
                    grew = true
    return seen

func followed(v: Target, how: Reach) -> Set:
    switch how:
    case ByMust:
        return v.must
    case ByAny:
        return v.live or v.dead
    case:
        return v.live

func warn(text: &strview, at: i64, note: &strview, also: i64, strict: bool):
    append(mem.fn.found, Warning{text, at, note, also, strict})

func alive(m: Marks) -> Set:
    return m.live or not (mem.fn.heaps or m.gone)

func objects(x: Set) -> Set:
    x[NOWHERE] = false
    return x

func single(x: Set) -> bool:
    return count(x) == 1

func bit(o: i64) -> Set:
    out: Set
    out[o] = true
    return out

