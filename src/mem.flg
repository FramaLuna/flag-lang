@trust
use bits

ANY = -1
NONE = 0xffff_ffff_ffff_ffff
FULL = 0xffff_ffff_ffff_ffff
ALL = 0xffff_ffff
DROPPED = 1 << 31
AGED = 1 << 63
POOLED = 1 << 62

EXACT = 4096
FAR = EXACT + 1
HOPS = 3
VISITS = 30
ROUNDS = 20

SLOTS = 512
FNVBASIS = 0xcbf2_9ce4_8422_2325
FNVPRIME = 0x100_0000_01b3

NOWHERE = 0
OUTSIDE = 1
STATIC = 2
GONE = 3
RETURNED = 4

PARAM = 1
FIELD = 2
SHARED = 3
SITE = 4
GLOBAL = 5
RECURSIVE = 6
FIXED = 7
PLACE = 8
BLOCKS = 9
MEMBERS = 1 << 14

UNSETTLED = "its memory use does not settle"

type enum Code:
    Alloc, Load, Word, Store, Clear, Blit, Offset, Count, Scale, Mix, Plain, Call, Fresh, Arena, Rewind, Take, Reclaim, Grow, Resize, Release, Discard, Launch, Join, Detach, Give, Taken, Copy, Fill, Absent, Parse, Stop, Extern, Goto, Fork, Leave, Halt

type enum Kind:
    Pinned, Heap, Entry, Shared, Slot

type Operand:
    n: i64
    temp: u32
    data: u32

type Op:
    pos: usize
    mask: u64
    a: Operand
    b: Operand
    to: u32
    first: u32
    count: u32
    callee: u32
    slot: u32
    size: u32
    from: u32
    upto: u32
    member: u32
    code: Code
    blob: bool
    named: bool
    ghost: bool

type Span:
    first: u32
    end: u32
    yes: u32
    no: u32

type Set = Bits[8]

type enum Reach:
    ByLive, ByMust, ByAny, FromGlobals, FromValue

type Target:
    live: Set
    dead: Set
    must: Set
    off: i32
    stride: i32
    count: u32
    slot: u32
    member: u32
    writer: u32
    element: bool

type Cell:
    owner: u32
    next: u32
    off: i32
    stride: i32
    count: u32
    member: u32

type Obj:
    key: u64
    pos: usize
    killed: usize
    freed: usize
    sent: usize
    name: &strview
    from: &strview
    parent: usize
    root: usize
    site: usize
    depth: u32
    off: i32
    stride: i32
    count: u32
    member: u32
    born: usize
    home: u32
    kind: Kind
    many: bool
    strict: bool
    arena: bool
    pool: bool
    loose: bool
    element: bool
    thread: bool
    alone: bool

type Marks:
    live: Set
    freed: Set
    killed: Set
    sure: Set
    gone: Set
    used: Set
    made: Set

type State:
    ids: &list[u32]
    vals: &list[u32]
    temps: &list[u32]
    marks: Marks
    seen: bool

type Summary:
    ids: &list[u32]
    aims: &list[Target]
    marks: Marks
    seen: bool

type Write:
    value: Target
    id: usize
    strong: bool

type Warning:
    text: &strview
    at: usize
    note: &strview
    also: usize
    strict: bool

type Fn:
    name: &strview
    shown: &strview
    params: &list[u32]
    copies: &list[bool]
    spans: &list[Span]
    names: &list[&strview]
    places: &list[usize]
    cross: &list[bool]
    last: &list[u32]
    crossing: &list[u32]
    calls: &list[usize]
    swaps: &list[u32]
    slots: &list[u32]
    alive: &list[u64]
    keys: &list[u64]
    objs: &list[Obj]
    cells: &list[Cell]
    heads: &list[u32]
    found: &list[Warning]
    sum: Summary
    ret: Target
    heaps: Set
    outer: Set
    roots: Set
    many: Set
    arenas: Set
    relevant: Set
    global: Set
    size: usize
    at: usize
    order: usize
    low: usize
    group: usize
    strict: bool
    blob: bool
    settles: bool
    stacked: bool
    dirty: bool
    done: bool
    stuck: &strview
    runs: usize
    node: usize
    inst: usize

context mem:
    pinned: Set
    noheap: Set
    fns: &list[Fn]
    ids: &map[&strview, usize]
    shared: &map[&strview, u32]
    globals: &list[&strview]
    callees: &list[&strview]
    ops: &list[Op]
    args: &list[Operand]
    f: usize
    fn: Fn
    here: u32
    words: usize
    viewed: bool
    temps: &list[Target]
    active: &list[u32]
    cur: &list[Target]
    fresh: &list[u32]
    ticked: &list[u32]
    present: &list[u32]
    known: &list[u32]
    pool: &list[Target]
    pooled: &map[Target, u32]
    refs: &list[&list[u32]]
    swept: &list[u64]
    interned: &list[u32]
    renamed: &list[u32]
    ages: u32
    tick: u32
    marks: Marks
    seen: bool
    ins: &list[State]
    held: &list[u64]
    exit: State
    ret: Target
    final: bool
    speak: bool
    condemned: Set
    strong: Set
    callee: usize
    call: u32
    who: &strview
    binds: &list[Target]
    bound: Set
    writes: &list[Write]
    order: &list[u64]
    warnings: &list[Warning]
    said: &map[&strview, bool]
    index: &map[u64, u32]
    counter: usize
    stack: &list[usize]

operator <(a: Warning, b: Warning) -> bool:
    return a.at < b.at

func check_memory():
    mem.pinned = bit(NOWHERE) or bit(OUTSIDE) or bit(STATIC)
    mem.noheap = bit(STATIC) or bit(RETURNED)
    labels: &map[u32, u32]
    defer free(labels)
    blocks: &list[u32]
    defer free(blocks)
    born: &list[u32]
    defer free(born)
    derived: &list[u32]
    defer free(derived)
    for func in comp.procs:
        clear(labels)
        blocks.len = 0
        f: Fn
        f.name = func.name
        f.shown = func.name[1:]
        f.blob = func.cls >= AGG
        f.node = func.node
        f.inst = func.inst
        if func.node != 0:
            f.shown = text(func.node)
            if comp.tokens[comp.nodes[func.node].tok].kind != Name:
                quoted: &str = "'"
                quoted += text(func.node) + "'"
                f.shown = view(quoted)
        for k in func.temps..func.last + 2:
            append(f.names, "")
        for k in func.params..func.params + func.count:
            p := comp.passes[k]
            t := u32(p.arg.n) + 1 - func.temps
            if p.cls != L and p.cls < AGG or p.number:
                t = 0
            append(f.params, t)
            append(f.copies, p.cls >= AGG)
        for k in func.mentions..func.mentioned:
            f.names[comp.mentions[k].temp + 1 - func.temps] = comp.mentions[k].name
        append(f.spans, Span{first = u32(mem.ops.len)})
        for k in func.code..func.end:
            i := comp.code[k]
            if f.at == 0:
                f.at = i.pos
            if i.op == "@":
                f.spans[-1].end = u32(mem.ops.len)
                blocks[block_of(labels, blocks, u32(i.a.n))] = u32(f.spans.len)
                append(f.spans, Span{first = u32(mem.ops.len)})
                continue
            o := Op{pos = i.pos, mask = FULL, member = i.member, ghost = i.ghost}
            if i.copy:
                o.mask = i.mask
            if i.to != 0:
                o.to = i.to + 1 - func.temps
                o.blob = i.cls >= AGG
            name := i.op
            if name == "call":
                o.code = Call
                o.callee = u32(mem.callees.len)
                callee: &strview
                if i.a.kind == Global:
                    callee = comp.globals[usize(i.a.n)]
                append(mem.callees, callee)
                o.first = u32(mem.args.len)
                for j in i.first..i.first + i.count:
                    if comp.passes[j].cls != 0:
                        append(mem.args, operand(func.temps, comp.passes[j].arg))
                o.count = u32(mem.args.len) - o.first
                if o.blob:
                    o.slot = u32(f.slots.len)
                    append(f.slots, o.to)
            else:
                o.a = operand(func.temps, i.a)
                o.b = operand(func.temps, i.b)
                if starts_with(name, "alloc"):
                    o.code = Alloc
                    o.slot = u32(f.slots.len)
                    append(f.slots, o.to)
                elif name == "loadl" and not i.number:
                    o.code = Load
                elif starts_with(name, "load"):
                    o.code = Word
                elif name == "storel":
                    o.code = Store
                elif starts_with(name, "store"):
                    o.code = Clear
                else:
                    switch name:
                    case "blit":
                        o.code = Blit
                        o.size = u32(i.c.n)
                    case "absent":
                        o.code = Absent
                        o.size = u32(i.c.n)
                    case "add", "copy":
                        o.code = Offset
                        o.count = i.count
                        if i.number:
                            o.code = Count
                    case "mul":
                        o.code = Scale
                    case "sub", "and", "or", "xor", "shl", "shr", "sar", "udiv", "div", "rem", "urem", "neg", "extsw", "extuw", "extsb", "extub", "extsh", "extuh":
                        o.code = Mix
                    case "jmp":
                        o.code = Goto
                        o.a.n = i64(block_of(labels, blocks, u32(i.a.n)))
                    case "jnz":
                        o.code = Fork
                        o.a.n = i64(block_of(labels, blocks, u32(i.b.n)))
                        o.b.n = i64(block_of(labels, blocks, u32(i.c.n)))
                    case "ret":
                        o.code = Leave
                    case "hlt":
                        o.code = Halt
                    case:
                        o.code = Plain
            append(mem.ops, o)
        f.spans[-1].end = u32(mem.ops.len)
        f.size = mem.ops.len - usize(f.spans[0].first)
        born.len = 0
        derived.len = 0
        for t in 0..f.names.len:
            append(born, u32(0))
            append(derived, u32(0))
            append(f.cross, false)
            append(f.last, u32(0))
        for t in f.params:
            born[t] = 1
            f.cross[t] = t != 0
        for s in 0..f.spans.len:
            span := f.spans[s]
            if span.end > span.first:
                last := mem.ops[span.end - 1]
                if last.code == Goto:
                    f.spans[s].yes = blocks[last.a.n] + 1
                elif last.code == Fork:
                    f.spans[s].yes = blocks[last.a.n] + 1
                    f.spans[s].no = blocks[last.b.n] + 1
                elif last.code != Leave and last.code != Halt and s + 1 < f.spans.len:
                    f.spans[s].yes = u32(s + 2)
            elif s + 1 < f.spans.len:
                f.spans[s].yes = u32(s + 2)
            for k in span.first..span.end:
                o := mem.ops[k]
                if o.to != 0:
                    born[o.to] = u32(s + 1)
                if o.code == Alloc or o.code == Call and o.blob:
                    derived[o.to] = o.slot + 1
                elif o.code == Offset and o.b.temp == 0 and o.b.data == 0:
                    derived[o.to] = derived[o.a.temp]
        words := (f.slots.len + 63) / 64
        for k in 0..f.spans.len * words:
            append(f.alive, u64(0))
        for s in 0..f.spans.len:
            for k in f.spans[s].first..f.spans[s].end:
                o := mem.ops[k]
                count: usize = 2
                if o.code == Call:
                    count = 2 + usize(o.count)
                for m in 0..count:
                    t := o.a.temp
                    if m == 1:
                        t = o.b.temp
                    elif m > 1:
                        t = mem.args[usize(o.first) + m - 2].temp
                    if t != 0 and born[t] != u32(s + 1):
                        f.cross[t] = true
                    f.last[t] = u32(k)
                    if derived[t] != 0:
                        d := usize(derived[t] - 1)
                        f.alive[s * words + d / 64] = f.alive[s * words + d / 64] or (u64(1) << u64(d % 64))
        grew := true
        while grew:
            grew = false
            s := f.spans.len
            while s > 0:
                s -= 1
                for side in 0..2:
                    next := f.spans[s].yes
                    if side == 1:
                        next = f.spans[s].no
                    if next != 0:
                        for w in 0..words:
                            x := f.alive[s * words + w] or f.alive[usize(next - 1) * words + w]
                            if x != f.alive[s * words + w]:
                                f.alive[s * words + w] = x
                                grew = true
        for t in 0..f.names.len:
            if f.cross[t] and derived[t] != 0:
                f.cross[t] = false
            if f.cross[t]:
                append(f.crossing, u32(t))
        put(mem.ids, f.name, mem.fns.len)
        append(mem.fns, f)
    exact: &list[bool] # the name is the path the program wrote, not an element of it
    defer free(exact)
    for g in 0..mem.fns.len:
        spans := mem.fns[g].spans
        proc := comp.procs[g]
        places := mem.fns[g].places
        exact.len = 0
        for t in mem.fns[g].names:
            append(places, VOID)
            append(exact, false)
        for m in comp.mentions[proc.mentions:proc.mentioned]:
            t := m.temp + 1 - proc.temps
            exact[t] = true
            places[t] = m.type # what the slot of a variable holds
            if not aggregate(m.type) and not contains(mem.fns[g].slots, t):
                places[t] = pointee(m.type)
        mem.fns[g].places = places
        for k in spans[0].first..spans[-1].end:
            if mem.ops[k].code == Call:
                name := mem.callees[mem.ops[k].callee]
                found := mem.ids[name]
                if found is usize:
                    node := mem.fns[found].node
                    mem.ops[k].named = node != 0 and comp.tokens[token_at(mem.ops[k].pos)].text == text(node)
                    core := node != 0 and file_of(comp.tokens[comp.nodes[node].tok].at) == 0
                    if core and text(node) == "temp" and comp.types[comp.insts[mem.fns[found].inst].ret].kind == Ptr:
                        mem.ops[k].code = Arena
                    elif core and text(node) == "detach":
                        mem.ops[k].code = Detach
                    elif core and text(node) == "launch":
                        mem.ops[k].code = Launch
                    elif core and text(node) == "join":
                        mem.ops[k].code = Join
                    elif core and text(node) == "settle":
                        mem.ops[k].code = Plain
                        mem.fns[g].settles = true
                    elif core and text(node) == "send":
                        inst := comp.insts[mem.fns[found].inst]
                        for b in comp.inst_binds[inst.binds:inst.binds + inst.count]:
                            if b.name == "$T":
                                mem.ops[k].mask = owned(b.type)
                                if aggregate(b.type):
                                    mem.ops[k].size = u32(comp.types[b.type].size)
                        mem.ops[k].code = Give # what the value points to goes to the thread that receives it
                    elif core and text(node) == "close" and comp.passes[comp.procs[found].params].cls >= AGG and comp.types[comp.passes[comp.procs[found].params].cls - AGG].name == "Scratch":
                        mem.ops[k].code = Rewind
                        d := k
                        while d > spans[0].first and mem.ops[d].to != mem.args[mem.ops[k].first].temp:
                            d -= 1
                        mem.ops[k].from = u32(d)
                    elif core and text(node) == "take":
                        mem.ops[k].code = Take
                        mem.ops[k].callee = u32(found + 1)
                    elif core and text(node) == "resize":
                        mem.ops[k].code = Resize
                    elif core and text(node) == "discard":
                        mem.ops[k].code = Discard
                    elif core and text(node) == "reclaim":
                        mem.ops[k].code = Reclaim
                    else:
                        mem.ops[k].callee = u32(found + 1)
                        if not contains(mem.fns[g].calls, found):
                            append(mem.fns[g].calls, found)
                else:
                    code: Code = Extern
                    switch name:
                    case "$malloc", "$calloc", "$realpath":
                        code = Fresh
                    case "$realloc":
                        code = Grow
                    case "$free":
                        code = Release
                    case "$memcpy", "$memmove":
                        code = Copy
                    case "$memset":
                        code = Fill
                    case "$pthread_mutex_lock", "$AcquireSRWLockExclusive":
                        code = Taken
                    case "$strtod":
                        code = Parse
                    case "$exit", "$_exit":
                        code = Stop
                    mem.ops[k].code = code
            o := mem.ops[k]
            if o.code == Store and o.a.temp != 0 and places[o.a.temp] == VOID:
                places[o.a.temp] = pointee(places[o.b.temp]) # a value has the type of the variable it goes to, like a parameter
            heir := o.to
            from := o.a.temp
            if o.code == Blit:
                heir = o.b.temp
            elif o.code == Call and not o.named and o.count > 0:
                from = mem.args[o.first].temp
            elif o.code != Load and o.code != Offset and o.code != Mix:
                heir = 0
            if heir != 0 and mem.fns[g].names[heir].len == 0:
                name := mem.fns[g].names[from]
                place := places[from]
                field := o.code == Offset and o.b.temp == 0 and o.b.data == 0
                off: i64 = 0
                if field:
                    off = o.b.n
                elif o.code == Mix or o.code == Call or o.count != 0 and comp.types[place].kind != Array:
                    place = VOID
                elif o.count != 0:
                    place = comp.types[place].elem # an element of an array, and of a list it stays the element
                exact[heir] = exact[from] and (o.code == Load or o.code == Blit or field)
                while place != VOID and comp.types[place].kind == Struct and (o.code == Load or off > 0):
                    ty := comp.types[place]
                    place = VOID
                    for item in comp.items[ty.first:ty.first + ty.count]:
                        if not item.shared and i64(item.n) <= off and off < i64(item.n + comp.types[item.type].size):
                            if exact[heir]:
                                path: &str
                                path += name + "." + item.name
                                name = view(path)
                            place = item.type
                            off -= i64(item.n)
                            break
                if off != 0:
                    place = VOID
                elif o.code == Load and comp.types[place].kind == Fat:
                    place = element(place)
                elif o.code == Load:
                    place = pointee(place)
                places[heir] = place
                mem.fns[g].names[heir] = name
    closes: &list[usize]
    defer free(closes)
    for k in 0..mem.ops.len:
        if mem.ops[k].code == Rewind:
            append(closes, k)
    for k in closes:
        for j in closes:
            if mem.ops[j].from == mem.ops[k].from and u32(j) > mem.ops[k].upto:
                mem.ops[k].upto = u32(j)
    none: Target
    while mem.binds.len < SLOTS:
        append(mem.binds, none)
    for g in 0..mem.fns.len:
        for t in comp.trusted:
            if t.check and t.from <= mem.fns[g].at and mem.fns[g].at < t.to:
                mem.fns[g].strict = true
    for g in 0..mem.fns.len:
        node := mem.fns[g].node
        start := comp.tokens[comp.nodes[node].tok].at
        end := start
        for n in node..node_end(node):
            if comp.tokens[comp.nodes[n].tok].at > end:
                end = comp.tokens[comp.nodes[n].tok].at
        inner := innermost(start)
        hidden := inner.to != 0 and not inner.check
        for t in comp.trusted:
            hidden = hidden and not (t.check and t.from > start and t.from <= end)
        for c in mem.fns[g].calls:
            hidden = hidden and not mem.fns[c].strict
        if (node != 0 and not hidden or mem.fns[g].strict) and mem.fns[g].order == 0:
            connect(g)
    sort(mem.warnings)
    for w in mem.warnings:
        inner := innermost(w.at)
        hidden := inner.to != 0 and not inner.check
        if hidden and w.strict:
            low := token_at(w.at)
            while comp.tokens[low].kind != Line:
                low -= 1
            hidden = comp.tokens[low].at == inner.from
        if hidden:
            continue
        eprint(WARN, w.text)
        if w.at != 0:
            show(w.at)
        if w.also != 0:
            eprint(NOTE, w.note)
            show(w.also)

# the name of the argument t of a call to g, down to the field at its start that has the type of parameter k
func named(t: u32, g: usize, k: usize) -> &strview:
    name := mem.fn.names[t]
    place := mem.fn.places[t]
    want := mem.fns[g].places[mem.fns[g].params[k]]
    while want != VOID and place != want and place != VOID and comp.types[place].kind == Struct:
        ty := comp.types[place]
        place = VOID
        for item in comp.items[ty.first:ty.first + ty.count]:
            if item.n == 0 and not item.shared and comp.types[item.type].size > 0:
                path: &str
                path += name + "." + item.name
                name = view(path)
                place = item.type
                break
    if place != want:
        return mem.fn.names[t]
    return name

func pointee(t: usize) -> usize:
    if comp.types[t].kind == Ptr:
        return comp.types[t].elem
    return VOID

func innermost(at: usize) -> Trust:
    found: Trust
    for t in comp.trusted:
        if t.from <= at and at < t.to and t.from >= found.from:
            found = t
    return found

func block_of(labels: *&map[u32, u32], blocks: *&list[u32], name: u32) -> u32:
    found := labels[name]
    if found is u32:
        return found
    put(labels, name, u32(blocks.len))
    append(blocks, u32(0))
    return u32(blocks.len - 1)

func operand(first: u32, a: Arg) -> Operand:
    out: Operand
    if a.kind == Temp:
        out.temp = u32(a.n) + 1 - first
    elif a.kind == Global and (starts_with(comp.globals[usize(a.n)], "thread $ctx.") or starts_with(comp.globals[usize(a.n)], "$var.")):
        text := comp.globals[usize(a.n)]
        found := mem.shared[text]
        if found is u32:
            out.data = found + 2
        else:
            out.data = u32(mem.globals.len) + 2
            put(mem.shared, text, u32(mem.globals.len))
            append(mem.globals, text)
    elif a.kind == Global:
        out.data = 1
    elif a.kind == Const:
        out.n = a.n
    return out

func connect(v: usize):
    mem.counter += 1
    mem.fns[v].order = mem.counter
    mem.fns[v].low = mem.counter
    append(mem.stack, v)
    mem.fns[v].stacked = true
    for w in mem.fns[v].calls:
        if mem.fns[w].order == 0:
            connect(w)
            if mem.fns[w].low < mem.fns[v].low:
                mem.fns[v].low = mem.fns[w].low
        elif mem.fns[w].stacked and mem.fns[w].order < mem.fns[v].low:
            mem.fns[v].low = mem.fns[w].order
    if mem.fns[v].low != mem.fns[v].order:
        return
    members: &list[usize]
    defer free(members)
    while true:
        w := trust pop(mem.stack)
        mem.fns[w].stacked = false
        mem.fns[w].group = v + 1
        append(members, w)
        if w == v:
            break
    if members.len > 1 or contains(mem.fns[v].calls, v):
        for f in members:
            mem.fns[f].dirty = true
        budget := members.len * ROUNDS
        while budget > 0:
            picked := members.len
            for k in 0..members.len:
                if mem.fns[members[k]].dirty and (picked == members.len or mem.fns[members[k]].size < mem.fns[members[picked]].size):
                    picked = k
            if picked == members.len:
                break
            f := members[picked]
            mem.fns[f].dirty = false
            budget -= 1
            if analyze(f):
                for m in members:
                    if contains(mem.fns[m].calls, f):
                        mem.fns[m].dirty = true
    settled := true
    for f in members:
        settled = settled and not mem.fns[f].dirty and mem.fns[f].runs > 0
    for f in members:
        if mem.fns[f].dirty:
            mem.fns[f].stuck = UNSETTLED
        if not settled:
            analyze(f)
    for f in members:
        for w in mem.fns[f].found:
            key: &str
            key += w.text + " " + w.at
            if contains(mem.said, view(key)):
                free(key)
            else:
                put(mem.said, view(key), true)
                append(mem.warnings, w)
        free(mem.fns[f].found)

func analyze(f: usize) -> bool:
    mem.f = f
    mem.fn = mem.fns[f]
    mem.fn.runs += 1
    mem.fn.found.len = 0
    mem.words = (mem.fn.slots.len + 63) / 64
    clear(mem.index)
    for k in 0..mem.fn.keys.len:
        mem.index[mem.fn.keys[k]] = u32(k)
    mem.viewed = false
    for c in mem.fn.cells:
        mem.viewed = mem.viewed or c.member != 0
    if mem.fn.objs.len == 0:
        mem.fn.keys = malloc(SLOTS * sizeof(u64))
        mem.fn.keys.cap = SLOTS
        mem.fn.objs = malloc(SLOTS * sizeof(Obj))
        mem.fn.objs.cap = SLOTS
        for k in 0..RETURNED + 1:
            kind: Kind = Pinned
            if k == RETURNED:
                kind = Slot
            object((u64(k) << 8) or FIXED, Obj{kind = kind})
        for k in 0..SLOTS + mem.fn.slots.len:
            append(mem.fn.heads, u32(0))
    blank: Target
    grow_cells()
    mem.pool.len = 0
    clear(mem.pooled)
    while mem.refs.len < SLOTS:
        nothing: &list[u32]
        append(mem.refs, nothing)
        append(mem.swept, u64(0))
    for k in 0..SLOTS:
        mem.refs[k].len = 0
    while mem.temps.len < mem.fn.names.len:
        append(mem.temps, blank)
        append(mem.interned, u32(0))
    for t in 0..mem.fn.names.len:
        mem.temps[t] = blank
        mem.interned[t] = 0
    params := mem.fn.params
    for k in 0..params.len:
        if params[k] != 0:
            e := object((u64(k) << 8) or PARAM, Obj{kind = Entry, root = k + 1, name = mem.fn.names[params[k]]})
            mem.temps[params[k]] = Target{live = bit(e), must = bit(e)}
    spans := mem.fn.spans
    none: State
    queued: &list[bool]
    defer free(queued)
    for b in 0..spans.len:
        append(mem.ins, none)
        append(queued, false)
    mem.ins[0].seen = true
    for t in mem.fn.crossing:
        append(mem.ins[0].temps, intern(mem.temps[t]))
    queued[0] = true
    low: usize = 0
    visits: usize = 0
    while true:
        while low < spans.len and not queued[low]:
            low += 1
        if low == spans.len:
            break
        b := low
        queued[b] = false
        visits += 1
        if visits > spans.len * VISITS + 100:
            mem.fn.stuck = UNSETTLED
            break
        visit(b)
        if mem.seen:
            out := snapshot()
            mem.held.len = 0
            for w in 0..mem.words:
                append(mem.held, u64(0))
            for v in out.vals:
                hold(mem.pool[v].slot)
            for v in out.temps:
                hold(mem.pool[v].slot)
            for side in 0..2:
                s := spans[b].yes
                if side == 1:
                    s = spans[b].no
                if s != 0:
                    old := mem.ins[s - 1]
                    joined := merge(old, out, usize(s - 1))
                    if old.seen and joined == old:
                        release(joined)
                    else:
                        release(old)
                        mem.ins[s - 1] = joined
                        queued[s - 1] = true
                        if usize(s - 1) < low:
                            low = usize(s - 1)
            release(out)
    mem.final = true
    mem.speak = true
    release(mem.exit)
    mem.exit = none
    mem.ret = blank
    for b in 0..spans.len:
        if mem.ins[b].seen:
            visit(b)
    if mem.speak and mem.fn.stuck.len > 0:
        at: usize = 0
        for k in spans[0].first..spans[-1].end:
            if at == 0:
                at = mem.ops[k].pos
        text: &str
        text += "-memory gives up on " + mem.fn.shown + ", " + mem.fn.stuck + ", so its checks are incomplete"
        warn(view(text), at, "", 0, false)
    mem.final = false
    mem.speak = false
    for b in 0..spans.len:
        release(mem.ins[b])
    mem.ins.len = 0
    sum: Summary
    ret: Target
    relevant: Set
    global: Set
    if mem.exit.seen:
        restore(mem.exit)
        escaping := reach(mem.ret, ByLive)
        global = reach(blank, FromGlobals)
        sum.seen = true
        for k in 0..mem.exit.ids.len:
            id := mem.exit.ids[k]
            c := mem.fn.cells[id]
            owner := usize(c.owner)
            if owner >= SLOTS or not (owner == RETURNED or owner == OUTSIDE or mem.fn.outer[owner] or escaping[owner]):
                continue
            v := mem.pool[mem.exit.vals[k]]
            if mem.fn.outer[owner] and v == initial(owner, c.off, c.stride, c.count, c.member) and empty(v.live and (mem.exit.marks.killed or mem.exit.marks.made)):
                continue
            if v.slot != 0:
                v.slot = 0
                v.dead = v.dead or bit(GONE)
            append(sum.ids, id)
            append(sum.aims, v)
            relevant = relevant or v.live or v.dead
        ret = mem.ret
        if ret.slot != 0:
            ret.slot = 0
            ret.dead = ret.dead or bit(GONE)
        relevant = relevant or mem.fn.outer or escaping or ret.live or ret.dead
        m := mem.exit.marks
        sum.marks = Marks{m.live and relevant, m.freed and relevant, m.killed and relevant, m.sure and relevant, m.gone and relevant, m.used and relevant, m.made and relevant}
        global = global and mem.fn.heaps
    old := mem.fns[f]
    changed := true
    if old.done:
        past := pack(old.sum)
        fresh := pack(sum)
        joined := merge(past, fresh, NONE)
        unknown := (mem.fn.heaps or mem.fn.outer) - (old.heaps or old.outer)
        joined.marks.sure = joined.marks.sure or sum.marks.sure and unknown
        joined.marks.gone = joined.marks.gone or sum.marks.gone and unknown
        ret = unite(old.ret, ret, alive(old.sum.marks), alive(sum.marks))
        relevant = relevant or old.relevant
        global = global or old.global
        changed = joined != past or ret != old.ret or relevant != old.relevant or global != old.global
        release(sum)
        sum = Summary{marks = joined.marks, seen = joined.seen}
        for k in 0..joined.ids.len:
            append(sum.ids, joined.ids[k])
            append(sum.aims, mem.pool[joined.vals[k]])
        release(past)
        release(fresh)
        release(joined)
    release(old.sum)
    release(mem.exit)
    mem.exit = none
    mem.fn.swaps.len = 0
    for k in 0..mem.fn.objs.len:
        append(mem.fn.swaps, u32(0))
    for k in 0..sum.ids.len:
        c := mem.fn.cells[sum.ids[k]]
        owner := usize(c.owner)
        if owner < SLOTS and mem.fn.outer[owner] and mem.fn.objs[owner].depth < HOPS:
            was := mem.index[child(owner, c.off, c.stride)]
            if was is u32 and sum.marks.killed[usize(was)]:
                fresh := objects(sum.aims[k].live) and mem.fn.heaps
                if not empty(fresh):
                    sum.marks.made[usize(was)] = true
                    sum.marks.gone[usize(was)] = false
                for x in fresh:
                    if mem.fn.swaps[x] == 0:
                        mem.fn.swaps[x] = was + 1
                        if mem.fn.objs[x].home != 0:
                            mem.fn.objs[was].home = mem.fn.objs[x].home
    mem.fn.sum = sum
    mem.fn.ret = ret
    mem.fn.relevant = relevant
    mem.fn.global = global
    mem.fn.done = true
    mem.fns[f] = mem.fn
    return changed

func hold(slot: u32):
    if slot == ALL:
        for w in 0..mem.words:
            mem.held[w] = FULL
    elif slot != 0:
        k := usize(slot) - 1
        mem.held[k / 64] = mem.held[k / 64] or (u64(1) << u64(k % 64))

func restore(st: State):
    mem.tick += 1
    mem.present.len = 0
    for k in 0..st.ids.len:
        id := st.ids[k]
        mem.ticked[id] = mem.tick
        mem.known[id] = st.vals[k] + 1
        append(mem.present, id)
    for k in 0..st.temps.len:
        mem.temps[mem.fn.crossing[k]] = mem.pool[st.temps[k]]
        mem.interned[mem.fn.crossing[k]] = st.temps[k] + 1
    mem.marks = st.marks

func visit(block: usize):
    restore(mem.ins[block])
    mem.seen = true
    mem.active.len = 0
    span := mem.fn.spans[block]
    for i in span.first..span.end:
        if not mem.seen:
            break
        o := mem.ops[i]
        mem.here = i
        switch o.code:
        case Alloc:
            define(o.to, Target{slot = o.slot + 1})
        case Load, Word:
            address := target_of(o.a)
            touch(address, mem.fn.names[o.a.temp])
            if o.code == Word:
                define(o.to, number(ANY))
            else:
                define(o.to, fetch(address))
        case Store, Clear:
            address := target_of(o.b)
            touch(address, mem.fn.names[o.b.temp])
            if o.code == Store:
                stash(address, target_of(o.a))
            else:
                stash(address, number(0))
        case Blit:
            from := target_of(o.a)
            to := target_of(o.b)
            touch(from, mem.fn.names[o.a.temp])
            touch(to, mem.fn.names[o.b.temp])
            if mem.speak:
                copied(from, mem.fn.places[o.a.temp], mem.fn.names[o.a.temp])
            transfer(to, from, i64(o.size), o.mask)
        case Offset:
            x := target_of(o.a)
            y := target_of(o.b)
            if o.member != 0:
                x.member = o.member
            if pointing(x) and pointing(y):
                define(o.to, blur(x, y))
            elif pointing(y):
                define(o.to, plus(y, amount(x).off, amount(x).stride, o.count))
            elif pointing(x):
                define(o.to, plus(x, amount(y).off, amount(y).stride, o.count))
            else:
                define(o.to, plus(amount(x), amount(y).off, amount(y).stride, 0))
        case Scale:
            x := amount(target_of(o.a))
            y := amount(target_of(o.b))
            if y.off == ANY or y.stride != 0:
                y = x
                x = amount(target_of(o.b))
            n := i64(y.off)
            v := number(ANY)
            if y.off == ANY or y.stride != 0:
                v = number(ANY)
            elif n == 0:
                v = number(0)
            elif x.off != ANY and x.stride == 0 and i64(x.off) * n >= 0 - EXACT and i64(x.off) * n <= EXACT:
                v = number(i32(i64(x.off) * n))
            elif x.off != ANY and x.stride == 0 and i64(x.off) * n > EXACT:
                v = number(FAR)
            elif n > 0 and x.off != ANY and x.stride != 0 and i64(x.stride) * n <= EXACT:
                v = Target{live = bit(NOWHERE), off = i32(i64(x.off) * n), stride = i32(i64(x.stride) * n)}
            elif n > 0 and n <= EXACT:
                v = Target{live = bit(NOWHERE), stride = i32(n)}
            define(o.to, v)
        case Mix:
            define(o.to, blur(target_of(o.a), target_of(o.b)))
        case Count:
            given := target_of(o.a)
            if mem.speak and (not empty((given.live or given.dead) - mem.pinned) or given.slot != 0):
                name := mem.fn.names[o.a.temp]
                text: &str
                if name.len > 0:
                    text += "-memory cannot follow " + name + " once it is stored as an integer, store it with a pointer type"
                else:
                    text += "-memory cannot follow a pointer once it is stored as an integer, store it with a pointer type"
                warn(view(text), o.pos, "", 0, false)
            define(o.to, number(ANY))
        case Plain:
            define(o.to, number(ANY))
        case Call:
            g := usize(o.callee) - 1
            if not mem.fns[g].done:
                define(o.to, number(ANY))
            elif not mem.fns[g].sum.seen:
                mem.seen = false
            else:
                sum := mem.fns[g].sum
                marks := sum.marks
                relevant := mem.fns[g].relevant
                heaps := mem.fns[g].heaps
                outer := mem.fns[g].outer
                mem.callee = g
                mem.call = i
                mem.who = ""
                if o.named:
                    mem.who = mem.fns[g].shown
                mem.bound = Set{}
                inner := mem.fns[g].group == mem.fn.group
                recursive: usize = NONE
                born := usize(i)
                if o.ghost:
                    born = NONE # what a thread makes is in no scratch of this one until wait takes it
                for x in relevant and heaps:
                    if not marks.live[x] and not marks.freed[x] and not marks.killed[x]:
                        continue
                    if x < mem.fns[g].swaps.len and mem.fns[g].swaps[x] != 0:
                        b := binding(usize(mem.fns[g].swaps[x]) - 1)
                        if not empty(objects(b.live)):
                            mem.binds[x] = Target{live = objects(b.live), must = b.must, off = b.off, stride = b.stride}
                            mem.bound = mem.bound or bit(x)
                            continue
                    ob := obj_of(g, x)
                    h: usize = 0
                    replace := true
                    if mem.fns[g].global[x]:
                        h = object((u64(ob.site) << 8) or GLOBAL, Obj{kind = Heap, many = true, site = ob.site, born = born, pos = ob.pos, from = ob.from, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread})
                        replace = false
                    elif inner and recursive != NONE:
                        h = recursive
                        replace = false
                    elif inner:
                        h = birth(RECURSIVE, Obj{kind = Heap, site = ob.site, born = born, pos = o.pos, from = mem.who, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread})
                        recursive = h
                    else:
                        h = lodge(arena_of(ob), (u64(i) << 16) or (u64(x) << 8) or SITE, Obj{kind = Heap, many = mem.fns[g].many[x], site = ob.site, born = born, pos = o.pos, from = mem.who, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread})
                    mem.marks.live = carry(marks.live, x, mem.marks.live, h, replace)
                    mem.marks.freed = carry(marks.freed, x, mem.marks.freed, h, replace)
                    mem.marks.killed = carry(marks.killed, x, mem.marks.killed, h, replace)
                    if marks.freed[x]:
                        mem.fn.objs[h].freed = o.pos
                    if marks.killed[x]:
                        mem.fn.objs[h].killed = o.pos
                    mem.binds[x] = Target{live = bit(h), must = bit(h)}
                    if mem.fns[g].global[x]:
                        mem.binds[x].must = Set{}
                    mem.fn.objs[h].strict = mem.fn.objs[h].strict or mem.fns[g].strict
                    mem.bound = mem.bound or bit(x)
                for x in relevant and outer:
                    binding(x)
                if mem.speak:
                    who := mem.who
                    if who.len == 0:
                        who = "this call"
                    node := mem.fns[g].node
                    mine := o.named and node != 0 and file_of(comp.tokens[comp.nodes[node].tok].at) != 0
                    for k in 0..usize(o.count):
                        if k < mem.fns[g].copies.len and mem.fns[g].copies[k]:
                            given := mem.args[usize(o.first) + k]
                            t := mem.fns[g].places[mem.fns[g].params[k]]
                            found := lockable(Target{}, t, true)
                            if mine and found.type != VOID:
                                text: &str
                                text += who + " takes " + mem.fn.names[given.temp] + " by value, a copy of "
                                if found.name.len == 0:
                                    text += kind_of(found.type)
                                else:
                                    text += "the " + text(comp.types[found.type].decl) + " " + found.name + " in it"
                                text += ": make it take *" + comp.types[t].name
                                warn(view(text), o.pos, "", 0, mem.fns[g].strict)
                            elif found.type != VOID:
                                copied(target_of(given), t, mem.fn.names[given.temp])
                    for x in relevant and outer:
                        b := mem.binds[x]
                        ob := obj_of(g, x)
                        name: &strview
                        if ob.root > 0 and ob.root <= usize(o.count):
                            name = named(mem.args[usize(o.first) + ob.root - 1].temp, g, ob.root - 1)
                        why := refusal(b, ob.loose)
                        if marks.freed[x] and why.len > 0:
                            refuse(who, name, why, b, mem.fns[g].strict)
                        elif marks.used[x]:
                            stale(b, name, mem.fns[g].strict)
                        if marks.killed[x]:
                            for y in relevant and outer:
                                oy := obj_of(g, y)
                                c := mem.binds[y]
                                sibling := ob.depth > 0 and oy.depth > 0 and ob.parent == oy.parent
                                shared := not empty((b.live and c.live) - mem.pinned) or b.slot != 0 and c.slot != 0 and (b.slot == c.slot or b.slot == ALL or c.slot == ALL)
                                if y != x and not sibling and (ob.root > 0 or oy.root > 0) and (marks.used[y] or marks.killed[y]) and shared:
                                    said: &str
                                    said += who + " may free memory that it also reads through another argument"
                                    warn(view(said), o.pos, "", 0, mem.fns[g].strict)
                                    break
                for x in relevant and outer:
                    b := mem.binds[x]
                    ob := obj_of(g, x)
                    passed := b.live and mem.fn.outer
                    if marks.killed[x]:
                        killed := freeable(b.live)
                        if ob.pool:
                            killed = killed or b.live and mem.fn.arenas
                        for h in killed:
                            condemn(h, marks.sure[x] and b.must[h], marks.freed[x])
                            mem.fn.objs[h].element = mem.fn.objs[h].element or marks.freed[x] and b.element
                        for h in passed:
                            mem.fn.objs[h].pool = mem.fn.objs[h].pool or ob.pool
                            mem.fn.objs[h].loose = mem.fn.objs[h].loose or ob.loose
                    if marks.gone[x]:
                        vanish(freeable(b.must))
                    if marks.used[x]:
                        mem.marks.used = mem.marks.used or passed
                    if marks.made[x]:
                        mem.marks.made = mem.marks.made or passed
                        if ob.home != 0:
                            home := home_of(arena_of(ob))
                            for h in passed:
                                mem.fn.objs[h].home = home
                sweep()
                if o.blob:
                    h := mem.fn.heads[SLOTS + usize(o.slot)]
                    while h != 0:
                        drop(usize(h) - 1)
                        h = mem.fn.cells[h - 1].next
                mem.writes.len = 0
                for k in 0..sum.ids.len:
                    c: Cell
                    if g == mem.f:
                        c = mem.fn.cells[sum.ids[k]]
                    else:
                        c = mem.fns[g].cells[sum.ids[k]]
                    x := usize(c.owner)
                    if x == RETURNED and o.blob:
                        append(mem.writes, Write{translate(sum.aims[k]), cell_at(SLOTS + usize(o.slot), c.off, c.stride, c.count, c.member), true})
                    ob := obj_of(g, x)
                    if x != RETURNED and not (ob.kind == Entry and ob.depth == 0 and ob.root > 0 and mem.fns[g].copies[ob.root - 1]):
                        t := binding(x)
                        v := translate(sum.aims[k])
                        p := plus(t, c.off, c.stride, c.count)
                        if v.writer == 0:
                            v.writer = p.member
                        exact := p.off != ANY and p.stride == 0
                        one := sole(t) != NONE
                        for h in t.live - mem.pinned:
                            append(mem.writes, Write{v, cell_at(h, p.off, p.stride, p.count, c.member), (one or t.must[h]) and exact and not mem.fn.many[h]})
                        if t.slot != 0 and t.slot != ALL:
                            append(mem.writes, Write{v, cell_at(SLOTS + usize(t.slot) - 1, p.off, p.stride, p.count, c.member), one and exact})
                        if t.live[OUTSIDE]:
                            append(mem.writes, Write{v, cell_at(OUTSIDE, ANY, 0, 0, 0), false})
                mem.order.len = 0
                for k in 0..mem.writes.len:
                    append(mem.order, (u64(mem.writes[k].id) << 32) or u64(k))
                sort(mem.order)
                live := alive(mem.marks)
                k: usize = 0
                while k < mem.order.len:
                    id := usize(mem.order[k] >> 32)
                    v: Target
                    strong := false
                    while k < mem.order.len and usize(mem.order[k] >> 32) == id:
                        w := usize(mem.order[k] and 0xffff_ffff)
                        v = unite(v, mem.writes[w].value, live, live)
                        strong = strong or mem.writes[w].strong
                        k += 1
                    settle(id, v, strong)
                if o.to != 0 and o.blob:
                    define(o.to, Target{slot = o.slot + 1})
                elif o.to != 0:
                    define(o.to, translate(mem.fns[g].ret))
        case Fresh, Arena:
            touch_args(o)
            from := mem.callees[o.callee]
            h := birth((u64(i) << 16) or SITE, Obj{kind = Heap, site = usize(i), born = usize(i), pos = o.pos, from = from[1:], arena = o.code == Arena})
            define(o.to, Target{live = bit(h), must = bit(h)})
        case Rewind:
            released: Set
            for h in mem.fn.arenas:
                if not mem.fn.objs[h].pool and mem.fn.objs[h].born > usize(o.from) and mem.fn.objs[h].born < usize(o.upto):
                    released[h] = true
            if mem.speak:
                outlived(released, o.pos, "its with scratch() releases it here")
            for h in released:
                condemn(h, true, false)
            vanish(released)
            sweep()
        case Take:
            touch_args(o)
            k := chunk(target_of(mem.args[o.first]), named(mem.args[o.first].temp, usize(o.callee) - 1, 0), (u64(i) << 16) or SITE, Obj{kind = Heap, site = usize(i), born = usize(i), pos = o.pos, from = "arena"})
            define(o.to, Target{live = bit(k), must = bit(k)})
        case Reclaim:
            arena := target_of(mem.args[o.first])
            held := fetch(arena)
            blocks := objects(held.live)
            chunks := objects(fetch(Target{live = blocks, off = ANY}).live) and (mem.fn.arenas or mem.fn.outer - mem.fn.roots)
            for h in chunks:
                mem.fn.objs[h].pool = true
                condemn(h, true, false)
            vanish(chunks)
            if target_of(mem.args[o.first + 1]).off != 0:
                freed := freeable(blocks)
                for h in freed:
                    condemn(h, held.must[h], true)
                vanish(freed and held.must)
                stash(arena, number(0))
            sweep()
        case Grow, Resize:
            touch_args(o)
            arena := number(0)
            if o.code == Resize:
                arena = target_of(mem.args[o.first])
            first := target_of(mem.args[o.first + u32(o.code == Resize)])
            blocks := freeable(first.live)
            for h in blocks:
                condemn(h, first.must[h], false)
            for h in blocks and mem.fn.outer:
                mem.fn.objs[h].home = home_of(arena)
            mem.marks.made = mem.marks.made or blocks and mem.fn.outer
            sweep()
            out := Target{live = objects(first.live), must = first.must}
            reborn(first, blocks, ptr(out), arena, (u64(i) << 16) or SITE, Obj{kind = Heap, site = usize(i), pos = o.pos, from = "realloc"})
            if empty(out.live):
                out.live = bit(NOWHERE)
            define(o.to, out)
        case Join:
            waited := target_of(mem.args[o.first])
            touch(waited, mem.fn.names[mem.args[o.first].temp])
            for h in reach(waited, FromValue) and mem.fn.arenas:
                if mem.fn.objs[h].born == NONE:
                    mem.fn.objs[h].born = usize(i) # wait moves the scratch of the thread to the one of this thread
        case Launch:
            for h in objects(target_of(mem.args[o.first]).live) and mem.fn.heaps:
                mem.fn.objs[h].thread = true
        case Detach:
            first := target_of(mem.args[o.first])
            if mem.speak and not mem.fn.settles:
                leaving(first, o.pos) # a thread that runs alone may outlive this function
            for h in objects(first.live) and mem.fn.heaps:
                mem.fn.objs[h].alone = true # the runtime frees its block when it ends
        case Release, Discard:
            given := mem.args[o.first + u32(o.code == Discard)]
            first := target_of(given)
            name := mem.fn.names[given.temp]
            blocks := freeable(first.live)
            why := refusal(first, o.code == Discard)
            if why.len == 0 and not empty(blocks) and first.off != ANY and first.off != 0 and first.stride == 0:
                why = ", it points inside a heap block, not at its start"
                blocks = Set{}
            if mem.speak and why.len > 0:
                who := comp.tokens[token_at(o.pos)].text
                if who != "wait":
                    who = "free"
                refuse(who, name, why, first, false)
            for h in blocks:
                condemn(h, first.must[h], true)
                mem.fn.objs[h].element = mem.fn.objs[h].element or first.element
                mem.fn.objs[h].loose = mem.fn.objs[h].loose or o.code == Discard
            vanish(blocks and first.must)
            sweep()
        case Taken:
            touch_args(o)
            stash(target_of(mem.args[o.first]), Target{live = bit(STATIC), must = bit(STATIC)}) # in use from now on, like the signature that macOS writes there
            define(o.to, number(ANY))
        case Give:
            touch_args(o)
            channel := target_of(mem.args[o.first])
            given := target_of(mem.args[o.first + 1])
            outlives := mem.speak and not mem.fn.settles and (channel.slot == 0 or not empty(objects(channel.live)))
            blocks: Set
            sure: Set
            for k in 0..i64(o.size) / 8 + i64(o.size == 0):
                word := given
                if o.size > 0:
                    word = fetch(plus(given, i32(k * 8), 0, 0))
                if outlives:
                    leaving(word, o.pos) # what goes to a channel that is not a local of this function may outlive it
                for h in objects(word.live) and mem.fn.arenas:
                    mem.fn.objs[h].sent = o.pos
                if marked(o.mask, k) and word.off == 0 and word.stride == 0: # a pointer inside a block gives nothing
                    blocks = blocks or word.live
                    sure = sure or word.must
            blocks = freeable(blocks)
            for h in blocks:
                condemn(h, sure[h], true)
            vanish(blocks and sure)
            sweep()
        case Copy, Fill:
            touch_args(o)
            to := target_of(mem.args[o.first])
            from := to
            mask: u64 = 0
            if o.code == Copy:
                from = target_of(mem.args[o.first + 1])
                mask = o.mask
                if mem.speak:
                    copied(from, mem.fn.places[mem.args[o.first + 1].temp], mem.fn.names[mem.args[o.first + 1].temp])
            size := mem.args[o.first + 2]
            bytes := size.n
            if bytes > EXACT:
                bytes = EXACT
            nothing: Target
            if size.temp == 0 and size.data == 0 and bytes >= 0:
                transfer(to, from, bytes, mask)
            elif mask == 0:
                stash(blur(to, nothing), number(0))
            else:
                stash(blur(to, nothing), fetch(blur(from, nothing)))
            define(o.to, to)
        case Absent:
            address := plus(target_of(o.a), 8, 0, 0)
            address.member = o.member
            gone: Set
            for k in 0..i64(o.size) / 8:
                if marked(o.mask, k):
                    gone = gone or fetch(plus(address, i32(k * 8), 0, 0)).must and (mem.fn.heaps and mem.marks.live or mem.fn.outer - mem.fn.roots)
            if not empty(gone and mem.fn.outer):
                for x in mem.fn.outer:
                    if mem.fn.objs[x].depth > 0 and gone[mem.fn.objs[x].parent]:
                        gone[x] = true
            vanish(gone)
        case Parse:
            touch_args(o)
            nothing: Target
            stash(target_of(mem.args[o.first + 1]), blur(target_of(mem.args[o.first]), nothing))
            define(o.to, number(ANY))
        case Extern:
            touch_args(o)
            define(o.to, Target{live = bit(OUTSIDE), must = bit(OUTSIDE)})
        case Stop, Halt:
            mem.seen = false
        case Goto, Fork:
            continue
        case Leave:
            given := target_of(o.a)
            wipe := mem.fn.heads[RETURNED]
            while wipe != 0:
                drop(usize(wipe) - 1)
                wipe = mem.fn.cells[wipe - 1].next
            if mem.fn.blob:
                for owner in given.live - mem.pinned:
                    pass_back(owner, given)
                if given.slot != 0 and given.slot != ALL:
                    pass_back(SLOTS + usize(given.slot) - 1, given)
                given = number(0)
            if mem.final:
                unseen := mem.fn.heaps - mem.marks.live - reach(given, ByAny)
                mem.marks.freed = mem.marks.freed - unseen
                mem.marks.killed = mem.marks.killed - unseen
                mem.marks.sure = mem.marks.sure - unseen
                mem.marks.gone = mem.marks.gone - unseen
                if mem.exit.seen:
                    mem.ret = unite(mem.ret, given, alive(mem.exit.marks), alive(mem.marks))
                else:
                    mem.ret = given
                out := snapshot()
                joined := merge(mem.exit, out, NONE)
                release(mem.exit)
                release(out)
                mem.exit = joined
            if mem.speak:
                must := reach(given, ByMust)
                may := reach(given, ByLive)
                for h in (mem.fn.heaps and mem.marks.live) - must - mem.fn.arenas:
                    x := mem.fn.objs[h]
                    if (x.key and 0xff) == GLOBAL or x.element and (mem.marks.freed[h] or may[h]) or x.home != 0 or x.alone:
                        continue
                    text: &str
                    if x.name.len > 0:
                        text += "the memory allocated here for " + x.name
                    elif x.from.len > 0:
                        text += "the memory that " + x.from + " allocates here"
                    else:
                        text += "the memory allocated here"
                    if may[h] or mem.marks.freed[h]:
                        text += " may never be freed"
                    else:
                        text += " is never freed"
                    warn(view(text), x.pos, "it is still not freed when this returns", o.pos, x.strict)
                escape(given, o.pos)
                if not mem.fn.settles:
                    outlived(mem.fn.arenas and mem.marks.live, 0, "")
                for id in mem.present:
                    owner := usize(mem.fn.cells[id].owner)
                    if mem.ticked[id] == mem.tick and (owner == RETURNED or owner < SLOTS and (mem.fn.outer[owner] or may[owner])):
                        escape(cell_value(id), o.pos)
            mem.seen = false

func pass_back(owner: usize, given: Target):
    for views in [false, true]: # settling a word drops its views
        k := mem.fn.heads[owner]
        while k != 0:
            c := mem.fn.cells[k - 1]
            if mem.ticked[k - 1] == mem.tick and (c.member != 0) == views and not (views and given.member != 0):
                v := cell_value(k - 1)
                if given.member != 0:
                    v = gather(Target{}, owner, c.off, c.stride, c.count, given.member, alive(mem.marks))
                if c.off == ANY or given.off == ANY or given.stride != 0 or c.stride != 0:
                    settle(cell_at(RETURNED, ANY, 0, 0, c.member), v, false)
                elif c.off >= given.off:
                    settle(cell_at(RETURNED, c.off - given.off, 0, 0, c.member), v, true)
            k = c.next

func snapshot() -> State:
    out := State{marks = mem.marks, seen = true}
    ordered := true
    for id in mem.present:
        if mem.ticked[id] == mem.tick:
            ordered = ordered and (out.ids.len == 0 or out.ids[-1] < id)
            append(out.ids, id)
    if not ordered:
        sort(out.ids)
    for id in out.ids:
        if mem.known[id] == 0:
            mem.known[id] = intern(mem.cur[id]) + 1
        append(out.vals, mem.known[id] - 1)
    for t in mem.fn.crossing:
        if mem.interned[t] == 0:
            mem.interned[t] = intern(mem.temps[t]) + 1
        append(out.temps, mem.interned[t] - 1)
    return out

func needed(id: u32, s: usize) -> bool:
    owner := usize(mem.fn.cells[id].owner)
    if owner < SLOTS or s == NONE:
        return true
    k := owner - SLOTS
    return (((mem.fn.alive[s * mem.words + k / 64] or mem.held[k / 64]) >> u64(k % 64)) and 1) != 0

func merge(a: State, b: State, s: usize) -> State:
    out := State{seen = true}
    if not b.seen:
        out.seen = a.seen
        out.marks = a.marks
        for k in 0..a.ids.len:
            append(out.ids, a.ids[k])
            append(out.vals, a.vals[k])
        for v in a.temps:
            append(out.temps, v)
        return out
    if not a.seen:
        out.marks = b.marks
        for k in 0..b.ids.len:
            if needed(b.ids[k], s):
                append(out.ids, b.ids[k])
                append(out.vals, b.vals[k])
        for v in b.temps:
            append(out.temps, v)
        return out
    x := a.marks
    y := b.marks
    out.marks = Marks{x.live or y.live, x.freed or y.freed, x.killed or y.killed, x.sure and y.sure, x.gone and y.gone, x.used or y.used, x.made or y.made}
    la := alive(x)
    lb := alive(y)
    dying := complement(la or lb)
    views: &list[u64]
    defer free(views)
    i: usize = 0
    j: usize = 0
    while i < a.ids.len or j < b.ids.len:
        if j == b.ids.len or i < a.ids.len and a.ids[i] < b.ids[j]:
            id := a.ids[i]
            c := mem.fn.cells[id]
            append(out.ids, id)
            append(out.vals, intern(unite(mem.pool[a.vals[i]], missing(b, c), la, lb)))
            if c.member != 0:
                view := mem.pool[out.vals[-1]]
                refer(id, view.live or view.dead)
            i += 1
        elif i == a.ids.len or b.ids[j] < a.ids[i]:
            id := b.ids[j]
            c := mem.fn.cells[id]
            if needed(id, s):
                append(out.ids, id)
                append(out.vals, intern(unite(missing(a, c), mem.pool[b.vals[j]], la, lb)))
                if c.member != 0:
                    view := mem.pool[out.vals[-1]]
                    refer(id, view.live or view.dead)
            j += 1
        else:
            id := a.ids[i]
            append(out.ids, id)
            append(out.vals, blend(a.vals[i], b.vals[j], la, lb, dying))
            if a.vals[i] != b.vals[j]:
                wa := mem.pool[a.vals[i]].writer
                wb := mem.pool[b.vals[j]].writer
                if wa != wb and wa != 0 and wb != 0 and mem.fn.cells[id].member == 0:
                    c := mem.fn.cells[id]
                    append(views, (u64(cell_at(usize(c.owner), c.off, c.stride, c.count, wa)) << 32) or u64(a.vals[i]))
                    append(views, (u64(cell_at(usize(c.owner), c.off, c.stride, c.count, wb)) << 32) or u64(b.vals[j]))
            i += 1
            j += 1
    for k in 0..a.temps.len:
        append(out.temps, blend(a.temps[k], b.temps[k], la, lb, dying))
    kept: usize = 0
    for v in views:
        if binary_search(out.ids, u32(v >> 32)) is null:
            views[kept] = v
            kept += 1
            word := mem.pool[v and 0xffff_ffff]
            refer(u32(v >> 32), word.live or word.dead)
    if kept > 0:
        views.len = kept
        for k in 0..out.ids.len:
            append(views, (u64(out.ids[k]) << 32) or u64(out.vals[k]))
        sort(views)
        out.ids.len = 0
        out.vals.len = 0
        for v in views:
            append(out.ids, u32(v >> 32))
            append(out.vals, u32(v and 0xffff_ffff))
    return out

func missing(st: State, c: Cell) -> Target:
    if c.member != 0:
        found := binary_search(st.ids, u32(cell_at(usize(c.owner), c.off, c.stride, c.count, 0)))
        if found is usize:
            return through(mem.pool[st.vals[found]], c.member)
    return initial(usize(c.owner), c.off, c.stride, c.count, c.member)

func blend(x: u32, y: u32, la: Set, lb: Set, dying: Set) -> u32:
    if x == y and empty(mem.pool[x].live and dying):
        return x
    return intern(unite(mem.pool[x], mem.pool[y], la, lb))

func pack(s: Summary) -> State:
    out := State{marks = s.marks, seen = s.seen}
    for k in 0..s.ids.len:
        append(out.ids, s.ids[k])
        append(out.vals, intern(s.aims[k]))
    return out

func intern(v: Target) -> u32:
    found := mem.pooled[v]
    if found is u32:
        return found
    mem.pooled[v] = u32(mem.pool.len)
    append(mem.pool, v)
    return u32(mem.pool.len - 1)

func hash(v: Target) -> u64:
    h := fold(fold(fold(FNVBASIS, v.live), v.dead), v.must)
    h = (h xor u64(i64(v.off) + 2)) * FNVPRIME
    h = (h xor u64(v.stride)) * FNVPRIME
    h = (h xor u64(v.slot)) * FNVPRIME
    # MurmurHash3 finalizer
    h = (h xor (h >> 33)) * 0xff51_afd7_ed55_8ccd
    h = (h xor (h >> 33)) * 0xc4ce_b9fe_1a85_ec53
    return h xor (h >> 33)

func fold(h: u64, x: Set) -> u64:
    for i in 0..8:
        h = (h xor x.words[i]) * FNVPRIME
    return h

func release(st: State):
    free(st.ids)
    free(st.vals)
    free(st.temps)

func release(s: Summary):
    free(s.ids)
    free(s.aims)

func target_of(a: Operand) -> Target:
    if a.temp != 0:
        return mem.temps[a.temp]
    if a.data == 1:
        return Target{live = bit(STATIC), must = bit(STATIC)}
    if a.data > 1:
        s := object((u64(a.data - 2) << 8) or SHARED, Obj{kind = Shared, name = mem.globals[a.data - 2]})
        return Target{live = bit(s), must = bit(s)}
    if a.n >= 0 - EXACT and a.n <= EXACT:
        return number(i32(a.n))
    if a.n > EXACT:
        return number(FAR)
    return number(ANY)

func number(off: i32) -> Target:
    return Target{live = bit(NOWHERE), off = off}

func amount(v: Target) -> Target:
    if plain(v):
        return v
    return number(ANY)

func define(t: u32, v: Target):
    if t == 0:
        return
    mem.temps[t] = v
    mem.temps[t].writer = 0
    mem.interned[t] = 0
    if not mem.fn.cross[t] and mem.fn.last[t] > mem.here and not empty(objects(v.live or v.dead)):
        append(mem.active, t)

func pointing(v: Target) -> bool:
    return not empty(objects(v.live)) or not empty(v.dead) or v.slot != 0

func plain(v: Target) -> bool:
    return v.live == bit(NOWHERE) and empty(v.dead) and v.slot == 0

func blank(v: Target) -> bool:
    return empty(v.live) and empty(v.dead) and v.slot == 0

func plus(a: Target, off: i32, stride: i32, count: u32) -> Target:
    out := a
    if a.off == ANY or off == ANY or a.stride != 0 and stride != 0 and a.stride != stride:
        out.off = ANY
        out.stride = 0
        out.count = 0
        return out
    out.off = a.off + off
    if stride != 0:
        out.stride = stride
        out.count = 0
        if a.stride == 0:
            out.count = count
    if out.off > EXACT and not plain(a):
        return Target{live = bit(OUTSIDE), must = bit(OUTSIDE)}
    if out.off < 0 or out.off > EXACT or out.stride > EXACT:
        out.off = ANY
        out.stride = 0
        out.count = 0
    return out

func blur(x: Target, y: Target) -> Target:
    out := Target{live = x.live or y.live or bit(NOWHERE), dead = x.dead or y.dead, off = ANY, slot = x.slot}
    if x.slot == 0:
        out.slot = y.slot
    elif y.slot != 0 and y.slot != x.slot:
        out.slot = ALL
    return out

func unite(a: Target, b: Target, la: Set, lb: Set) -> Target:
    if blank(a):
        return b
    if blank(b):
        return a
    out := a
    out.live = a.live or b.live
    out.dead = a.dead or b.dead
    out.must = (a.must or complement(la)) and (b.must or complement(lb)) and out.live
    out.element = a.element and (b.element or plain(b)) or b.element and plain(a)
    if a.writer != b.writer:
        out.writer = 0
    if a.member != b.member and not plain(b):
        out.member = 0
    if a.slot == 0:
        out.slot = b.slot
    elif b.slot != 0 and b.slot != a.slot:
        out.slot = ALL
    stride := a.stride
    if stride == 0:
        stride = b.stride
    if stride == 0:
        stride = a.off - b.off
    if stride < 0:
        stride = 0 - stride
    if plain(a):
        out.off = b.off
        out.stride = b.stride
        out.count = b.count
        out.member = b.member
    elif plain(b) or a.off == b.off and a.stride == b.stride and a.count == b.count:
        return out
    elif a.off == ANY or b.off == ANY or a.stride != 0 and b.stride != 0 and a.stride != b.stride or (a.off - b.off) % stride != 0:
        out.off = ANY
        out.stride = 0
        out.count = 0
    else:
        out.stride = stride
        out.count = 0
        if b.off < a.off:
            out.off = b.off
    return out

func fetch(a: Target) -> Target:
    out: Target
    owners := objects(a.live or a.dead)
    count: usize = 0
    exact := a.off != ANY and a.stride == 0
    live := alive(mem.marks)
    for o in owners:
        count += 1
        if o == STATIC or o == OUTSIDE:
            out = unite(out, Target{live = bit(o), must = bit(o)}, live, live)
        elif o != GONE:
            exact = exact and not mem.fn.many[o]
            out = gather(out, o, a.off, a.stride, a.count, a.member, live)
    if a.slot == ALL:
        count += 2
        for s in 0..mem.fn.slots.len:
            out = gather(out, SLOTS + s, a.off, a.stride, a.count, a.member, live)
    elif a.slot != 0:
        count += 1
        out = gather(out, SLOTS + usize(a.slot) - 1, a.off, a.stride, a.count, a.member, live)
    if blank(out):
        return number(0)
    if count > 1 or not exact:
        out.must = Set{}
    if not exact and not plain(out):
        out.element = true
    return out

func gather(out: Target, owner: usize, off: i32, stride: i32, count: u32, member: u32, live: Set) -> Target:
    word: u32 = 0
    view: u32 = 0
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        if c.off == off and c.stride == stride and c.count == count:
            if c.member == 0:
                word = h
            elif c.member == member:
                view = h
        elif c.member == 0:
            fits := c.off == ANY or off == ANY
            if not fits and c.stride == 0 and stride == 0:
                fits = c.off == off
            elif not fits and c.stride == 0:
                fits = c.off >= off and (c.off - off) % stride == 0
            elif not fits and stride == 0:
                fits = off >= c.off and (off - c.off) % c.stride == 0
            elif not fits:
                fits = c.stride != stride or (c.off - off) % stride == 0
            if fits and c.off != ANY and off != ANY: # the elements of an array end where it ends
                fits = (count == 0 or i64(c.off) < i64(off) + i64(count) * i64(stride)) and (c.count == 0 or i64(off) < i64(c.off) + i64(c.count) * i64(c.stride))
            if fits:
                out = unite(out, current(usize(h) - 1), live, live)
        h = c.next
    if view != 0:
        return unite(out, current(usize(view) - 1), live, live)
    if word == 0 or member != 0 and mem.ticked[word - 1] != mem.tick:
        return unite(out, initial(owner, off, stride, count, member), live, live)
    if member != 0:
        return unite(out, through(cell_value(word - 1), member), live, live)
    return unite(out, current(usize(word) - 1), live, live)

func stash(a: Target, v: Target):
    if a.member != 0:
        v.writer = a.member
    one := sole(a) != NONE
    for o in a.live - mem.pinned:
        settle(cell_at(o, a.off, a.stride, a.count, 0), v, (one or a.must[o]) and not mem.fn.many[o])
    if a.slot == ALL:
        for s in 0..mem.fn.slots.len:
            settle(cell_at(SLOTS + s, a.off, a.stride, a.count, 0), v, false)
    elif a.slot != 0:
        settle(cell_at(SLOTS + usize(a.slot) - 1, a.off, a.stride, a.count, 0), v, one)
    if a.live[OUTSIDE]:
        settle(cell_at(OUTSIDE, ANY, 0, 0, 0), v, false)

func sole(a: Target) -> usize:
    targets := a.live - mem.pinned
    if a.slot == 0 and single(targets):
        for o in targets:
            return o
    if empty(targets) and a.slot != 0 and a.slot != ALL:
        return SLOTS + usize(a.slot) - 1
    return NONE

func settle(id: usize, given: Target, exact: bool):
    c := mem.fn.cells[id]
    v := given
    if plain(v):
        v = number(0)
        v.writer = given.writer
    if exact and c.off != ANY and c.stride == 0:
        place(id, v)
    else:
        old := current(id)
        live := alive(mem.marks)
        w := unite(old, v, live, live)
        w.must = Set{}
        if many(c):
            w.must = (old.must or v.must) and w.live
            if v.element:
                for h in objects(v.live):
                    mem.fn.objs[h].element = true
        place(id, w)
    if c.member == 0 and mem.viewed:
        h := mem.fn.heads[c.owner]
        while h != 0:
            d := mem.fn.cells[h - 1]
            if d.member != 0 and d.off == c.off and d.stride == c.stride and d.count == c.count:
                drop(usize(h) - 1)
            h = d.next

func many(c: Cell) -> bool:
    return c.off == ANY or c.stride != 0 or c.owner < SLOTS and mem.fn.many[usize(c.owner)]

func cell_value(id: u32) -> Target:
    if mem.fresh[id] == mem.tick:
        return mem.cur[id]
    return mem.pool[mem.known[id] - 1]

func current(id: usize) -> Target:
    if mem.ticked[id] == mem.tick:
        return cell_value(u32(id))
    c := mem.fn.cells[id]
    if c.member != 0:
        word := cell_at(usize(c.owner), c.off, c.stride, c.count, 0)
        if mem.ticked[word] == mem.tick:
            return through(cell_value(u32(word)), c.member)
    return initial(usize(c.owner), c.off, c.stride, c.count, c.member)

func through(word: Target, member: u32) -> Target:
    if word.writer == 0 or word.writer == member:
        return word
    return Target{}

func place(id: usize, v: Target):
    c := mem.fn.cells[id]
    if plain(v) and v.off == 0 and v.stride == 0 and (c.owner >= SLOTS or not mem.fn.outer[usize(c.owner)]):
        drop(id)
        return
    fresh := v.live or v.dead
    if mem.ticked[id] == mem.tick:
        old := cell_value(u32(id))
        fresh = fresh - (old.live or old.dead) or v.live - v.dead - (old.live - old.dead)
    elif mem.ticked[id] == (mem.tick xor DROPPED):
        mem.ticked[id] = mem.tick
    else:
        mem.ticked[id] = mem.tick
        append(mem.present, u32(id))
    refer(u32(id), fresh)
    rewrite(id, v)

func rewrite(id: usize, v: Target):
    mem.cur[id] = v
    mem.fresh[id] = mem.tick
    mem.known[id] = 0

func refer(id: u32, blocks: Set):
    for o in objects(blocks):
        append(mem.refs[o], id)

func drop(id: usize):
    if mem.ticked[id] == mem.tick:
        mem.ticked[id] = mem.tick xor DROPPED

func initial(owner: usize, off: i32, stride: i32, count: u32, member: u32) -> Target:
    if owner >= SLOTS or not mem.fn.outer[owner]:
        return number(0)
    if member >= MEMBERS:
        return initial(owner, off, stride, count, 0)
    x := mem.fn.objs[owner]
    c: usize = OUTSIDE
    if x.depth < HOPS:
        c = object(child(owner, off, stride) or (u64(member) << 49), Obj{kind = Entry, parent = owner, off = off, stride = stride, count = count, member = member, root = x.root, depth = x.depth + 1, many = mem.fn.many[owner] or off == ANY or stride != 0})
        if mem.fn.objs[c].count != count:
            mem.fn.objs[c].count = 0
    return Target{live = bit(c), must = bit(c)}

func child(owner: usize, off: i32, stride: i32) -> u64:
    code: u64 = 0
    if off != ANY and stride == 0:
        code = u64(off + 1)
    elif off != ANY:
        code = (u64(stride) << 13) or u64(off)
    return (u64(owner) << 40) or (code << 8) or FIELD

func cell_at(owner: usize, off: i32, stride: i32, count: u32, member: u32) -> usize:
    if member != 0:
        cell_at(owner, off, stride, count, 0) # a word before its views, settling it drops them
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        if c.off == off and c.stride == stride and c.count == count and c.member == member:
            return usize(h) - 1
        h = c.next
    append(mem.fn.cells, Cell{owner = u32(owner), next = mem.fn.heads[owner], off = off, stride = stride, count = count, member = member})
    mem.fn.heads[owner] = u32(mem.fn.cells.len)
    if member != 0:
        mem.viewed = true
    grow_cells()
    return mem.fn.cells.len - 1

func grow_cells():
    while mem.cur.len < mem.fn.cells.len:
        append(mem.cur, Target{})
        append(mem.fresh, u32(0))
        append(mem.ticked, u32(0))
        append(mem.renamed, u32(0))
        append(mem.known, u32(0))

func object(key: u64, x: Obj) -> usize:
    found := mem.index[key]
    if found is u32:
        return usize(found)
    if mem.fn.keys.len == SLOTS:
        mem.fn.stuck = "it has more than " + SLOTS + " blocks of memory to follow"
        return OUTSIDE
    n := mem.fn.objs.len
    y := x
    y.key = key
    append(mem.fn.keys, key)
    mem.index[key] = u32(n)
    append(mem.fn.objs, y)
    if x.kind == Heap:
        mem.fn.heaps = mem.fn.heaps or bit(n)
    if x.kind == Entry or x.kind == Shared:
        mem.fn.outer = mem.fn.outer or bit(n)
    if x.kind == Shared:
        mem.fn.roots = mem.fn.roots or bit(n)
    if x.many:
        mem.fn.many = mem.fn.many or bit(n)
    if x.arena:
        mem.fn.arenas = mem.fn.arenas or bit(n)
    return n

func reborn(was: Target, blocks: Set, out: *Target, arena: Target, key: u64, given: Obj) -> usize:
    unset := was.live[NOWHERE] or blank(was)
    if unset and single(blocks) and not empty(blocks and mem.fn.heaps and was.must):
        mem.marks.live = mem.marks.live or blocks
    elif unset:
        h := lodge(arena, key, given)
        out.live = out.live or bit(h)
        out.must = out.must or bit(h)
        return h
    return NONE

func birth(key: u64, given: Obj) -> usize:
    r := object(key, given)
    if r == OUTSIDE:
        return r
    if mem.marks.live[r] or mem.marks.freed[r] or mem.marks.killed[r]:
        x := mem.fn.objs[r]
        x.many = true
        t := object(mem.fn.keys[r] or AGED, x)
        if t != r:
            lr := mem.marks.live[r]
            lt := mem.marks.live[t]
            mem.ages += 1
            for side in 0..2:
                o := r
                if side == 1:
                    o = t
                n := mem.refs[o].len
                for k in 0..n:
                    id := mem.refs[o][k]
                    if mem.ticked[id] == mem.tick and mem.renamed[id] != mem.ages:
                        mem.renamed[id] = mem.ages
                        rewrite(usize(id), rename(cell_value(id), r, t, lr, lt))
                        if side == 0:
                            append(mem.refs[t], id)
            kept: usize = 0
            for v in mem.active:
                if mem.fn.last[v] > mem.here:
                    mem.temps[v] = rename(mem.temps[v], r, t, lr, lt)
                    mem.active[kept] = v
                    kept += 1
            mem.active.len = kept
            for v in mem.fn.crossing:
                mem.temps[v] = rename(mem.temps[v], r, t, lr, lt)
                mem.interned[v] = 0
            bound := mem.bound
            for k in bound:
                mem.binds[k] = rename(mem.binds[k], r, t, lr, lt)
            live := alive(mem.marks)
            h := mem.fn.heads[r]
            while h != 0:
                id := usize(h) - 1
                c := mem.fn.cells[id]
                if mem.ticked[id] == mem.tick:
                    v := cell_value(u32(id))
                    drop(id)
                    into := cell_at(t, c.off, c.stride, c.count, c.member)
                    old := current(into)
                    w := unite(old, v, live, live)
                    w.must = (old.must or v.must) and w.live
                    place(into, w)
                h = c.next
            m := mem.marks
            pair := bit(r) or bit(t)
            mem.marks = Marks{shift(m.live, r, t), shift(m.freed, r, t), shift(m.killed, r, t), m.sure - pair, m.gone - pair, shift(m.used, r, t), shift(m.made, r, t)}
    b := bit(r)
    mem.marks.live = mem.marks.live or b
    mem.marks.freed = mem.marks.freed - b
    mem.marks.killed = mem.marks.killed - b
    mem.marks.sure = mem.marks.sure - b
    mem.marks.gone = mem.marks.gone - b
    return r

func shift(m: Set, r: usize, t: usize) -> Set:
    if not m[r]:
        return m
    return m - bit(r) or bit(t)

func rename(v: Target, r: usize, t: usize, lr: bool, lt: bool) -> Target:
    pair := bit(r) or bit(t)
    if empty((v.live or v.dead or v.must) and pair):
        return v
    out := v
    mr := v.must[r]
    mt := v.must[t]
    out.live = shift(v.live, r, t)
    out.dead = shift(v.dead, r, t)
    out.must = v.must - pair
    if out.live[t] and (mr or not lr) and (mt or not lt):
        out.must = out.must or bit(t)
    return out

func condemn(o: usize, strong: bool, freed: bool):
    b := bit(o)
    mem.condemned = mem.condemned or b
    mem.marks.killed = mem.marks.killed or b
    if freed:
        mem.marks.freed = mem.marks.freed or b
        mem.fn.objs[o].freed = mem.ops[mem.here].pos
    else:
        mem.fn.objs[o].killed = mem.ops[mem.here].pos
    if strong:
        mem.strong = mem.strong or b
        mem.marks.sure = mem.marks.sure or b

func sweep():
    condemned := mem.condemned
    if empty(condemned):
        return
    for o in condemned and mem.fn.outer:
        x := mem.fn.objs[o]
        if x.depth > 0:
            id := cell_at(x.parent, x.off, x.stride, x.count, x.member)
            if mem.ticked[id] != mem.tick:
                place(id, initial(x.parent, x.off, x.stride, x.count, x.member))
    strong := mem.strong
    loose: Set
    for o in condemned - strong:
        loose[o] = mem.fn.objs[o].element
    for o in condemned:
        first: usize = 0
        if (mem.swept[o] >> 32) == u64(mem.tick) and not strong[o]:
            first = usize(mem.swept[o] and 0xffff_ffff)
        for k in first..mem.refs[o].len:
            id := mem.refs[o][k]
            owner := usize(mem.fn.cells[id].owner)
            hit := condemned
            if many(mem.fn.cells[id]):
                hit = strong
            elif owner < SLOTS and mem.fn.heaps[owner]:
                hit = condemned - loose # an element freed through a variable stays live where the heap keeps it, like in a list
            if mem.ticked[id] == mem.tick and not empty(cell_value(id).live and hit):
                rewrite(usize(id), kill(cell_value(id), hit, strong))
        mem.swept[o] = (u64(mem.tick) << 32) or u64(mem.refs[o].len)
    kept: usize = 0
    for t in mem.active:
        if mem.fn.last[t] > mem.here:
            mem.temps[t] = kill(mem.temps[t], condemned, strong)
            mem.active[kept] = t
            kept += 1
    mem.active.len = kept
    for t in mem.fn.crossing:
        mem.temps[t] = kill(mem.temps[t], condemned, strong)
        mem.interned[t] = 0
    mem.condemned = Set{}
    mem.strong = Set{}

func vanish(gone: Set):
    mem.marks.live = mem.marks.live - gone
    mem.marks.gone = mem.marks.gone or gone
    mem.marks.sure = mem.marks.sure or gone

func kill(v: Target, condemned: Set, strong: Set) -> Target:
    hit := v.live and condemned
    if empty(hit):
        return v
    gone := hit and strong
    v.dead = v.dead or hit
    v.live = v.live - gone
    v.must = v.must - gone
    return v

func touch(a: Target, name: &strview):
    mem.marks.used = mem.marks.used or (a.live or a.dead) and mem.fn.outer
    stale(a, name, false)

func stale(a: Target, name: &strview, strict: bool):
    if mem.speak and not empty(a.dead):
        text: &str
        if name.len > 0:
            text += name + " points to memory that may be freed already"
        else:
            text += "this uses memory that may be freed already"
        warn(view(text), mem.ops[mem.here].pos, "it may be freed here", killed_at(a.dead), strict)

func freeable(live: Set) -> Set:
    return live and (mem.fn.heaps - mem.fn.arenas or mem.fn.outer - mem.fn.roots)

func refusal(v: Target, kept: bool) -> &strview:
    if not empty(v.dead):
        return ", it may be freed already"
    if v.slot != 0 or not empty(v.live and (mem.noheap or mem.fn.roots)):
        return ", it is not on the heap"
    chunks := v.live and mem.fn.arenas
    for h in chunks:
        if not mem.fn.objs[h].pool:
            return ", it is temporary memory: a with scratch() block releases it"
    if kept or empty(chunks):
        return ""
    for h in chunks:
        for id in mem.refs[h]:
            c := mem.fn.cells[id]
            if c.off == ANY and c.owner < SLOTS and not mem.fn.objs[c.owner].arena and mem.fn.objs[c.owner].name.len > 0:
                name := mem.fn.objs[c.owner].name
                return ", it lives in " + name + ", free(" + name + ") releases it"
    return ", it lives in an arena, freeing the arena releases it"

func chunk(arena: Target, name: &strview, key: u64, given: Obj) -> usize:
    held := fetch(arena)
    if empty(objects(held.live)):
        o := sole(arena)
        if name.len == 0 and o != NONE and o >= SLOTS:
            name = mem.fn.names[mem.fn.slots[o - SLOTS]]
        elif name.len == 0 and o != NONE:
            name = mem.fn.objs[o].name
        b := birth((key and 0xffff_ffff_ffff_ff00) or BLOCKS, Obj{kind = Heap, site = given.site, born = given.born, pos = given.pos, from = given.from, name = name})
        held = Target{live = bit(b), must = bit(b)}
    blocks := objects(held.live)
    stash(arena, Target{live = blocks, must = held.must and blocks})
    mem.marks.made = mem.marks.made or blocks and mem.fn.outer
    given.arena = true
    given.pool = true
    k := birth(key or POOLED, given)
    stash(Target{live = blocks, off = ANY}, Target{live = bit(k), must = bit(k)})
    return k

func lodge(arena: Target, key: u64, given: Obj) -> usize:
    given.home = home_of(arena)
    if pointing(arena) and given.home == 0:
        return chunk(arena, "", key, given)
    return birth(key, given)

func arena_of(ob: Obj) -> Target:
    if ob.home == 0:
        return number(0)
    return binding(usize(ob.home) - 1)

func home_of(arena: Target) -> u32:
    entry := sole(arena)
    if entry == NONE or entry >= SLOTS or not mem.fn.outer[entry] or mem.fn.roots[entry]:
        return 0
    return u32(entry) + 1

func refuse(who: &strview, name: &strview, why: &strview, v: Target, strict: bool):
    text: &str
    if name.len > 0:
        text += who + " cannot release " + name + why
    else:
        text += who + " cannot release this memory" + why
    warn(view(text), mem.ops[mem.here].pos, "it may be freed here", killed_at(v.dead), strict)

func touch_args(o: Op):
    for k in o.first..o.first + o.count:
        touch(target_of(mem.args[k]), mem.fn.names[mem.args[k].temp])

func transfer(to: Target, from: Target, size: i64, mask: u64):
    for k in 0..size / 8:
        v := number(0)
        if marked(mask, k):
            v = fetch(plus(from, i32(k * 8), 0, 0))
        stash(plus(to, i32(k * 8), 0, 0), v)
    if not mem.viewed or from.off == ANY or from.member != 0:
        return
    owner := sole(from)
    into := sole(to)
    if owner == NONE or into == NONE:
        return
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        k := i64(c.off) - i64(from.off)
        if c.member != 0 and c.stride == from.stride and k >= 0 and k < size and k % 8 == 0 and marked(mask, k / 8) and mem.ticked[h - 1] == mem.tick:
            spot := plus(to, i32(k), 0, 0)
            if spot.off != ANY:
                settle(cell_at(into, spot.off, spot.stride, spot.count, c.member), cell_value(h - 1), into >= SLOTS or not mem.fn.many[into])
        h = c.next

func owned(t: usize) -> u64:
    ty := comp.types[t]
    if ty.kind == Ptr or ty.kind == Thread or ty.kind == Fat and ty.count > 1: # a view has only its len
        return 1
    mask: u64 = 0
    if ty.kind == Array:
        inner := owned(ty.elem)
        i: usize = 0
        while inner != 0 and i < ty.count and i * comp.types[ty.elem].size < 512:
            mask = mask or words(inner, i * comp.types[ty.elem].size / 8)
            i += 1
    elif ty.kind == Struct or ty.kind == Union or ty.kind == Untagged:
        for item in comp.items[ty.first:ty.first + ty.count]:
            if ty.kind == Struct:
                mask = mask or words(owned(item.type), item.n / 8)
            elif ty.kind == Union:
                mask = mask or words(owned(item.type), 1)
            else:
                mask = mask or owned(item.type)
    return mask

func copied(from: Target, t: usize, name: &strview):
    found := lockable(from, t, false)
    if found.type == VOID:
        return
    kind := text(comp.types[found.type].decl)
    text: &str
    text += "this copies "
    if found.name.len > 0 and name.len > 0:
        text += "the " + kind + " " + found.name + " in " + name + ","
    elif found.name.len > 0:
        text += "the " + kind + " " + found.name + " in this value,"
    elif name.len > 0:
        text += name + ", " + kind_of(found.type)
    else:
        text += kind_of(found.type)
    switch kind:
    case "Arena":
        text += " that may have given memory: the copy gives out the same blocks"
    case "Lock":
        text += " that may have been taken: the copy is another lock"
    case:
        text += " that may be in use: the copy is another channel"
    text += ", use a pointer to it"
    warn(view(text), mem.ops[mem.here].pos, "", 0, false)

# the first Arena, Lock or Channel of core in a value of type t at from, with its path, that this function used unless any
func lockable(from: Target, t: usize, any: bool) -> Item:
    ty := comp.types[t]
    none: Item
    if ty.decl != 0 and file_of(comp.tokens[comp.nodes[ty.decl].tok].at) == 0 and (text(ty.decl) == "Arena" or text(ty.decl) == "Lock" or text(ty.decl) == "Channel"):
        if any:
            return Item{type = t}
        first := fetch(from) # the blocks of an Arena, the mutex of a Lock and of the Lock a Channel starts with
        if not empty(objects(first.live or first.dead) - mem.fn.outer):
            return Item{type = t}
    elif ty.kind == Struct:
        for item in comp.items[ty.first:ty.first + ty.count]:
            if item.shared:
                continue
            found := lockable(plus(from, i32(item.n), 0, 0), item.type, any)
            if found.type != VOID:
                path: &str
                path += item.name
                if found.name.len > 0:
                    path += "." + found.name
                found.name = view(path)
                return found
    elif ty.kind == Array and ty.count > 0:
        return lockable(plus(from, 0, i32(comp.types[ty.elem].size), u32(ty.count)), ty.elem, any)
    return none

func kind_of(t: usize) -> &strview:
    if text(comp.types[t].decl) == "Arena":
        return "an Arena"
    if text(comp.types[t].decl) == "Lock":
        return "a Lock"
    return "a Channel"

func marked(mask: u64, k: i64) -> bool:
    return k < 63 and ((mask >> u64(k)) and 1) != 0 or k >= 63 and (mask >> 63) != 0

func carry(from: Set, x: usize, into: Set, h: usize, replace: bool) -> Set:
    if replace:
        into = into - bit(h)
    if from[x]:
        into = into or bit(h)
    return into

func obj_of(g: usize, x: usize) -> Obj:
    if g == mem.f:
        return mem.fn.objs[x]
    return mem.fns[g].objs[x]

func binding(x: usize) -> Target:
    if mem.bound[x]:
        return mem.binds[x]
    g := mem.callee
    o := mem.ops[mem.call]
    ob := obj_of(g, x)
    out := Target{dead = bit(GONE)}
    home: Target
    if x <= STATIC:
        out = Target{live = bit(x), must = bit(x)}
    elif ob.kind == Shared:
        s := object(ob.key, ob)
        out = Target{live = bit(s), must = bit(s)}
    elif ob.kind == Entry and ob.depth == 0:
        out = number(0)
        if ob.root <= usize(o.count):
            out = target_of(mem.args[usize(o.first) + ob.root - 1])
    elif ob.kind == Entry:
        home = plus(binding(ob.parent), ob.off, ob.stride, ob.count)
        if ob.member != 0:
            home.member = ob.member
        out = fetch(home)
    if ob.kind == Entry and mem.fns[g].sum.marks.made[x]:
        name: &strview
        if ob.root > 0 and ob.root <= usize(o.count):
            name = named(mem.args[usize(o.first) + ob.root - 1].temp, g, ob.root - 1)
        key := (u64(mem.call) << 16) or (u64(x) << 8) or SITE
        if home.off != ANY and home.stride == 0 and sole(home) != NONE:
            key = (child(sole(home), home.off, 0) xor FIELD) or PLACE
        h := reborn(out, objects(out.live), ptr(out), arena_of(ob), key, Obj{kind = Heap, site = usize(mem.call), pos = o.pos, from = mem.who, name = name})
        if h != NONE:
            mem.fn.objs[h].strict = mem.fn.objs[h].strict or mem.fns[g].strict
        out.live = objects(out.live)
    mem.binds[x] = out
    mem.bound = mem.bound or bit(x)
    return out

func translate(v: Target) -> Target:
    out: Target
    live := alive(mem.marks)
    must: Set
    for x in objects(v.live):
        b := plus(binding(x), v.off, v.stride, v.count)
        if v.member != 0:
            b.member = v.member
        if v.must[x]:
            must = must or b.must
        out = unite(out, b, live, live)
    out.must = must and out.live
    for x in v.dead:
        b := binding(x)
        out.dead = out.dead or objects(b.live or b.dead)
    if blank(out):
        out = number(0)
    elif v.live[NOWHERE]:
        out.live = out.live or bit(NOWHERE)
    out.writer = v.writer
    return out

func escape(v: Target, pos: usize):
    if v.slot == 0:
        return
    shown := mem.fn.shown
    text: &str
    if v.slot == ALL:
        text += "a pointer into the stack of " + shown + " cannot leave " + shown
    else:
        name := mem.fn.names[mem.fn.slots[v.slot - 1]]
        if name.len > 0:
            text += "a pointer to " + name + " cannot leave " + shown + ", " + name + " lives on its stack"
        else:
            text += "a pointer into the stack of " + shown + " cannot leave " + shown
    warn(view(text), pos, "", 0, false)

# temporaries that a thread may still use after this releases them
func outlived(released: Set, at: usize, note: &strview):
    running: Set
    for h in mem.fn.heaps and mem.marks.live:
        running[h] = mem.fn.objs[h].thread and (at != 0 or mem.fn.objs[h].alone)
    if empty(running):
        return
    for h in reach(Target{live = running}, FromValue) and released:
        if not mem.fn.objs[h].pool and mem.fn.objs[h].born != NONE:
            text: &str
            text += "a thread may still use this temporary when "
            if at != 0:
                text += "its with scratch() releases it: wait for the thread inside it, or give it a &str"
            else:
                text += "the with scratch() of a caller releases it: give the thread a &str"
            warn(view(text), mem.fn.objs[h].pos, note, at, false)
    for h in released:
        if mem.fn.objs[h].sent != 0 and at != 0:
            warn("the thread that receives this temporary may still use it when its with scratch() releases it: wait for that thread inside it, or send a &str", mem.fn.objs[h].sent, note, at, false)

func leaving(v: Target, pos: usize):
    escape(v, pos)
    carried := reach(v, FromValue)
    for id in mem.present:
        owner := usize(mem.fn.cells[id].owner)
        if mem.ticked[id] == mem.tick and owner < SLOTS and carried[owner]:
            escape(cell_value(id), pos)

func reach(given: Target, how: Reach) -> Set:
    seen := followed(given, how)
    for id in mem.present:
        if mem.ticked[id] == mem.tick:
            owner := usize(mem.fn.cells[id].owner)
            root := owner == RETURNED or owner == OUTSIDE or owner < SLOTS and mem.fn.outer[owner]
            if how == FromGlobals:
                root = owner == OUTSIDE or owner < SLOTS and mem.fn.outer[owner] and mem.fn.objs[owner].root == 0
            elif how == FromValue:
                root = false
            if root:
                seen = seen or followed(cell_value(id), how)
    seen = seen and mem.fn.heaps
    grew := not empty(seen)
    while grew:
        grew = false
        for id in mem.present:
            owner := usize(mem.fn.cells[id].owner)
            if mem.ticked[id] == mem.tick and owner < SLOTS and seen[owner]:
                more := (followed(cell_value(id), how) and mem.fn.heaps) - seen
                if not empty(more):
                    seen = seen or more
                    grew = true
    return seen

func followed(v: Target, how: Reach) -> Set:
    switch how:
    case ByMust:
        return v.must
    case ByAny:
        return v.live or v.dead
    case:
        return v.live

func warn(text: &strview, at: usize, note: &strview, also: usize, strict: bool):
    append(mem.fn.found, Warning{text, at, note, also, strict})

func killed_at(dead: Set) -> usize:
    for o in dead and mem.marks.freed:
        return mem.fn.objs[o].freed
    for o in dead:
        return mem.fn.objs[o].killed
    return 0

func alive(m: Marks) -> Set:
    return m.live or complement(mem.fn.heaps or m.gone)

func objects(x: Set) -> Set:
    x[NOWHERE] = false
    return x

func single(x: Set) -> bool:
    return count(x) == 1

func bit(o: usize) -> Set:
    out: Set
    out[o] = true
    return out
