        case Ended:
            pointed := false
            for k in o.a.n..o.b.n:
                pointed = pointed or ((mem.pointed[k / 64] >> u64(k % 64)) and 1) != 0
            if not pointed:
                continue
            for id in mem.present:
                if mem.ticked[id] == mem.tick:
                    v := cell_value(id)
                    if v.slot != ALL and i64(v.slot) > o.a.n and i64(v.slot) <= o.b.n:
                        t := mem.fn.slots[v.slot - 1]
                        name: &strview
                        if mem.fn.variables[t]:
                            name = mem.fn.names[t]
                        v.dead = v.dead or bit(object((u64(v.slot) << 8) or ENDED, Obj{kind = Slot, name = name, pos = o.pos}))
                        v.killer = o.pos
                        place(i64(id), v)
        case Round:
            walk := u64(o.b.n)
            now := mem.runs.now
            for m in now: # the threads started so far touch the elements of earlier rounds
                if mem.fn.keys[m] >> 24 == walk:
                    mem.runs.now[m] = false
            visited(walk)
            element := target_of(o.a)
            r := mem.index[(walk << 24) or ROUND]
            if o.to != 0: # the element in place
                inside := rounded(walk, element, o.shape, mem.fn.names[o.a.temp])
                define(o.to, Target{live = bit(inside), must = bit(inside), dead = element.dead, killer = element.killer})
            elif o.a.temp != 0: # a copy of the element
                for k in 0..i64(o.size) / 8:
                    if marked(o.shape, k):
                        word := plus(element, i32(k * 8), 0, 0)
                        stash(word, focused(fetch(word), walk, 0))
            elif r is u32 and mem.fn.objs[r].parent != NONE: # by index, where the rounds before found it
                x := mem.fn.objs[r]
                rounded(walk, placed(x), x.shape, x.name)
        case Narrowed: # the walk's element in place holds this member now
            r := sole(target_of(o.a))
            if r != NONE and r < SLOTS and (mem.fn.keys[r] and 0xff) == ROUND:
                k := mem.fn.heads[r]
                while k != 0:
                    c := mem.fn.cells[k - 1]
                    if mem.ticked[k - 1] == mem.tick:
                        v := cell_value(k - 1)
                        v.writer = o.member
                        place(i64(k) - 1, v)
                    k = c.next
        case Walked:
            walk := u64(o.b.n)
            visited(walk)
            focus := mem.fn.focus
            for v in focus:
                key := mem.fn.keys[v]
                if (key and 0xff) == VISITED and key >> 24 == walk and (mem.marks.live[v] or mem.marks.killed[v]):
                    h := mem.fn.objs[v].parent
                    freed := mem.marks.freed[v]
                    all := o.size != 0 and freed and not mem.marks.live[v] # a walk without break freed the element of every round on every path
                    gone := empty(kin(h) and mem.marks.live) # freed before the walk, the rounds don't bring it back
                    absorb(v, kin(h), true)
                    if gone:
                        mem.marks.live = mem.marks.live - kin(h)
                    if all:
                        for k in kin(h):
                            condemn(k, true, true)
                        vanish(kin(h))
                    elif freed: # some may be freed, and which the lists do not say
                        mem.marks.freed = mem.marks.freed or kin(h)
                        mem.marks.killed = mem.marks.killed or kin(h)
            sweep()
        case Parse:
            touch_args(o)
            nothing: Target
            stash(target_of(mem.args[o.first + 1]), blur(target_of(mem.args[o.first]), nothing))
            define(o.to, number(ANY))
        case Extern:
            touch_args(o)
            define(o.to, Target{live = bit(OUTSIDE), must = bit(OUTSIDE)})
        case Stop, Halt:
            mem.seen = false
        case Goto, Fork:
            continue
        case Leave:
            focus := mem.fn.focus
            n := mem.fn.objs.len
            while n > 0 and mem.fn.walks: # a return inside a walk: its elements go back to what they stand for, the inner walks first
                n -= 1
                if focus[n] and (mem.marks.live[n] or mem.marks.killed[n]) and (mem.fn.keys[n] and 0xff) != ROUND:
                    absorb(n, kin(mem.fn.objs[n].parent), true)
            given := target_of(o.a)
            wipe := mem.fn.heads[RETURNED]
            while wipe != 0:
                drop(i64(wipe) - 1)
                wipe = mem.fn.cells[wipe - 1].next
            if mem.fn.blob:
                touch(given, mem.fn.names[o.a.temp])
                access(given, false, o.size)
                transfer(Target{live = bit(RETURNED), must = bit(RETURNED)}, given, i64(o.size), o.shape)
                given = number(0)
            if mem.final:
                unseen := mem.fn.heaps - mem.marks.live - reach(given, ByAny)
                mem.marks.freed = mem.marks.freed - unseen
                mem.marks.killed = mem.marks.killed - unseen
                mem.marks.sure = mem.marks.sure - unseen
                mem.marks.gone = mem.marks.gone - unseen
                if mem.exit.seen:
                    mem.ret = unite(mem.ret, given, alive(mem.exit.marks), alive(mem.marks))
                else:
                    mem.ret = given
                out := snapshot()
                joined := merge(mem.exit, out, NONE)
                release(mem.exit)
                release(out)
                mem.exit = joined
            if mem.speak:
                must := reach(given, ByMust)
                may := reach(given, ByLive)
                for h in (mem.fn.heaps and mem.marks.live) - must - mem.fn.arenas:
                    x := mem.fn.objs[h]
                    if (x.key and 0xff) == GLOBAL or x.element and (mem.marks.freed[h] or may[h]) or x.home != 0 or x.alone:
                        continue
                    text: &str = heap("")
                    if x.name.len > 0:
                        text += "the memory allocated here for " + x.name
                    elif x.from.len > 0:
                        text += "the memory that " + x.from + " allocates here"
                    else:
                        text += "the memory allocated here"
                    if may[h] or mem.marks.freed[h]:
                        text += " may never be freed"
                    else:
                        text += " is never freed"
                    warn(view(text), x.pos, "it is still not freed when this returns", o.pos, x.strict)
                escape(given, o.pos, true)
                if not mem.fn.settles:
                    outlived(mem.fn.arenas and mem.marks.live, 0, "")
                for id in mem.present:
                    owner := i64(mem.fn.cells[id].owner)
                    if mem.ticked[id] == mem.tick and (owner == RETURNED or owner < SLOTS and (mem.fn.outer[owner] or may[owner])):
                        escape(cell_value(id), o.pos, owner >= SLOTS or not mem.fn.outer[owner]) # what stays in a context or in the caller's memory is not returned
            mem.seen = false

# wait moves the scratch of the thread to the one of this thread, or of the caller when the thread came from it
func reap(thread: Target):
    mem.marks.waited = mem.marks.waited or thread.live and (mem.fn.outer or mem.fn.focus)
    mem.runs.joined = mem.runs.joined or thread.live and mem.fn.outer
    for h in reach(thread, FromValue) and mem.fn.arenas:
        if mem.fn.objs[h].born == NONE:
            mem.fn.objs[h].born = i64(mem.here)

# memory this reads or writes here
func access(at: Target, wrote: bool, size: u32):
    if not mem.final or not mem.threaded:
        return
    t := Touch{size = size, locks = mem.runs.locks, after = mem.runs.joined, wrote = wrote}
    running := mem.runs.running and mem.marks.live
    pos := mem.ops[mem.here].pos
    for x in objects(at.live) - mem.pinned - bit(GONE) - bit(RETURNED):
        touched(moved(t, x, at), pos, running, Set{})
    if at.slot == ALL:
        for k in 0..mem.fn.slots.len:
            touched(moved(t, SLOTS + k, at), pos, running, Set{})
    elif at.slot != 0:
        touched(moved(t, SLOTS + i64(at.slot) - 1, at), pos, running, Set{})

# t at the place at in owner
func moved(t: Touch, owner: i64, at: Target) -> Touch:
    out := t
    out.owner = u32(owner)
    out.off = at.off
    out.stride = at.stride
    out.count = at.count
    return out

# a touch here, by this function or by the thread of blocks that it starts: it races with the threads of running, and the callers see it when it is of their memory
func touched(t: Touch, pos: i64, running: Set, blocks: Set):
    owner := i64(t.owner)
    if owner < SLOTS and local(owner):
        return
    if mem.speak:
        for r in running - t.after:
            line := newest(r)
            found := NONE
            for k in 0..mem.footprints.len:
                f := mem.footprints[k]
                if f.block == line and (t.wrote or f.touch.wrote) and empty(t.locks and f.touch.locks) and (found == NONE or f.touch.wrote and not mem.footprints[found].touch.wrote) and overlap(t, f.touch, line):
                    found = k # a thread that writes it says more than one that reads it
            if found != NONE:
                race(t, mem.footprints[found], pos, blocks[line])
    summed(t)

# t as the callers see it: of their memory, and of the element of a round, of the memory it stands for
func summed(t: Touch):
    owner := i64(t.owner)
    if owner >= SLOTS:
        return
    if standing(owner):
        at := stood(t)
        for p in objects(at.live):
            summed(moved(t, p, at))
    elif mem.fn.outer[owner] and not contains(mem.touched, t):
        put(mem.touched, t, true)
        append(mem.fn.touches, Footprint{NONE, 0, t})

# memory that no other thread sees, or that the runtime of core keeps in order: such a context, what it holds, or the copy of a context that a new thread starts with
func local(o: i64) -> bool:
    x := mem.fn.objs[o]
    while x.kind == Entry and x.depth > 0:
        x = mem.fn.objs[x.parent]
    return x.kind == Shared and mem.local[i64(x.key >> 8)] or (x.key and 0xff) == COPY

# a and b, b a touch of the thread of line, may touch the same bytes: the element of a round is a part of the memory it stands for, and another element in another round
func overlap(a: Touch, b: Touch, line: i64) -> bool:
    owner := i64(a.owner)
    if a.owner == b.owner and standing(owner):
        marker := mem.index[(mem.fn.keys[owner] >> 24 << 24) or (u64(line) << 8) or NOW]
        return marker is u32 and mem.runs.now[i64(marker)] and meet(a, b)
    if a.owner == b.owner:
        return meet(a, b)
    if nesting(i64(b.owner)) > nesting(owner): # the element of the inner walk goes up first
        return overlap(b, a, line)
    if not standing(owner):
        return false
    at := stood(a)
    for p in objects(at.live):
        if overlap(moved(a, p, at), b, line):
            return true
    return at.slot != 0 and overlap(moved(a, SLOTS + i64(at.slot) - 1, at), b, line)

# the thread of line touches t, and it was started in this round of the walk of the element it touches
func started(line: i64, t: Touch):
    if t.owner < SLOTS and mem.fn.focus[i64(t.owner)]:
        m := object((mem.fn.keys[t.owner] >> 24 << 24) or (u64(line) << 8) or NOW, Obj{kind = Pinned})
        if m != OUTSIDE:
            mem.runs.now[m] = true

# o is the element of a round of a walk, which stands for memory of what the walk walks
func standing(o: i64) -> bool:
    return o < SLOTS and mem.fn.focus[o] and mem.fn.objs[o].parent != NONE

# how many walks o is the element of, one inside the other
func nesting(o: i64) -> i64:
    if not standing(o):
        return 0
    return 1 + nesting(mem.fn.objs[o].parent)

# where t, a touch of the element of a round, is in the memory that element stands for: the place of the element in place, or one of the blocks of its line
func stood(t: Touch) -> Target:
    x := mem.fn.objs[t.owner]
    if (mem.fn.keys[t.owner] and 0xff) == ROUND:
        return plus(placed(x), t.off, t.stride, t.count)
    return Target{live = kin(x.parent), off = t.off, stride = t.stride, count = t.count}

# the bytes of a and of b meet in one block
func meet(a: Touch, b: Touch) -> bool:
    if a.off == ANY or b.off == ANY:
        return true
    if ends(a) <= i64(b.off) or ends(b) <= i64(a.off):
        return false
    if a.stride == 0 and b.stride == 0:
        return true
    if a.stride != 0 and b.stride != 0 and a.stride != b.stride:
        return true
    grid := a
    other := b
    if a.stride == 0:
        grid = b
        other = a
    s := i64(grid.stride)
    at := ((i64(other.off) - i64(grid.off)) % s + s) % s
    return at < i64(grid.size) or at + i64(other.size) > s

func ends(t: Touch) -> i64:
    if t.stride == 0:
        return i64(t.off) + i64(t.size)
    if t.count == 0:
        return FAR
    return i64(t.off) + i64(t.stride) * i64(t.count)

# t here races with f, a touch of a thread that may run at the same time, or of an earlier one of the same parallel when itself
func race(t: Touch, f: Footprint, pos: i64, itself: bool):
    name := spelled(i64(t.owner), t.off, t.size).name
    if name.len == 0:
        name = "this memory"
    theirs := f.touch.locks - t.locks
    lock: &strview = ""
    for k in theirs or t.locks - f.touch.locks:
        lock = spelled(mem.fn.objs[k].parent, mem.fn.objs[k].off, 1).name
        break
    text: &str = heap("")
    if lock.len > 0 and not empty(theirs):
        text += name + " is touched here outside with lock(" + lock + "), and another thread may hold the lock and use it now: take the lock around it"
    elif lock.len > 0:
        text += name + " is touched outside with lock(" + lock + ") by a thread that may run at the same time as this: take the lock around it in that thread"
    elif itself:
        text += name + " is changed by each thread that this starts, and they may run at the same time: put it in a Lock[T], or give each thread its own and add them after wait"
    elif f.touch.wrote:
        text += name + " is changed by a thread that may run at the same time as this, and nothing orders the two: put it in a Lock[T], or give each thread its own and add them after wait"
    else:
        text += name + " is changed here while a thread that may run at the same time reads it, and nothing orders the two: put it in a Lock[T], or change it before parallel or after wait"
    if itself:
        warn(view(text), pos, "", 0, false)
    else:
        warn(view(text), pos, "the thread starts here", f.at, false)

# the name of the size bytes at off in owner, with the fields down to them, and their type: the name is empty when they have none
func spelled(owner: i64, off: i32, size: u32) -> Item:
    out: Item
    if owner >= SLOTS:
        t := mem.fn.slots[owner - SLOTS]
        if mem.fn.variables[t]:
            out = Item{name = mem.fn.names[t], type = mem.fn.places[t]}
    else:
        x := mem.fn.objs[owner]
        if x.kind == Shared or (mem.fn.keys[owner] and 0xff) == COPY: # a context, or the copy a thread starts with
            given := x.name
            if starts_with(given, "thread "):
                given = given["thread ".len:]
            t := comp.type_ids[given["$ctx.".len:]] ifnull VOID
            if t != VOID:
                out = Item{name = text(comp.types[t].decl), type = t}
        elif x.kind == Entry and x.depth == 0 and x.root > 0:
            p := mem.fn.params[x.root - 1]
            out = Item{name = mem.fn.names[p], type = mem.fn.places[p]}
        elif x.kind == Entry and x.depth > 0:
            up := spelled(x.parent, x.off, 8)
            out.name = up.name
            if up.type != VOID and comp.types[up.type].kind == Ptr:
                out.type = comp.types[up.type].elem
            elif up.type != VOID and comp.types[up.type].kind == Fat:
                out.type = element(up.type)
        else:
            out.name = x.name
    while out.type != VOID and off != ANY and (comp.types[out.type].kind == Struct or comp.types[out.type].kind == Array):
        ty := comp.types[out.type]
        if off == 0 and text(ty.decl) == "Lock" and lockable(Target{}, out.type, true).type != VOID: # a lock, not its first field
            break
        inside := out.type
        if ty.kind == Array and comp.types[ty.elem].size > 0:
            out.type = ty.elem
            off = off % i32(comp.types[ty.elem].size)
        for item in comp.items[ty.first:ty.first + ty.count] if ty.kind == Struct else comp.items[0:0]: # an array counts elements, not fields
            if not item.shared and item.n <= off and i64(off) + i64(size) <= item.n + comp.types[item.type].size:
                path: &str = heap("")
                path += out.name + "." + item.name
                out = Item{name = view(path), type = item.type}
                off -= i32(item.n)
                break
        if out.type == inside:
            break
    return out

# t, a touch of g, as touches of this function at this call while it holds locks
func rebound(g: i64, t: Touch, locks: Set):
    if t.owner >= SLOTS: # its stack
        return
    ob := obj_of(g, i64(t.owner))
    if ob.kind == Entry and ob.depth == 0 and ob.root > 0 and mem.fns[g].copies[ob.root - 1]: # its own copy of an argument
        return
    at := plus(binding(i64(t.owner)), t.off, t.stride, t.count)
    out := t
    out.locks = locks
    for k in t.locks:
        lock := obj_of(g, k)
        if lock.parent < SLOTS:
            l := lock_of(plus(binding(lock.parent), lock.off, 0, 0))
            if l != NONE:
                out.locks[l] = true
    out.after = Set{}
    for x in t.after:
        out.after = out.after or objects(binding(x).live)
    for x in objects(at.live) - mem.pinned - bit(GONE) - bit(RETURNED):
        append(mem.passed, moved(out, x, at))
    if at.slot != 0 and at.slot != ALL:
        append(mem.passed, moved(out, SLOTS + i64(at.slot) - 1, at))

# the object that stands for the lock that l points to, NONE when it may be in more than one place
func lock_of(l: Target) -> i64:
    owner := sole(l)
    if owner == NONE or l.off == ANY or l.stride != 0:
        return NONE
    k := object((u64(owner) << 40) or (u64(l.off) << 8) or HELD, Obj{kind = Pinned, parent = owner, off = l.off})
    if k == OUTSIDE:
        return NONE
    return k

# the thread of block is gone, and a new one may take its place
func retire(block: i64):
    kept := 0
    for f in mem.footprints:
        if f.block != block:
            mem.footprints[kept] = f
            kept += 1
    mem.footprints.len = kept

func snapshot() -> State:
    out := State{marks = mem.marks, runs = mem.runs, seen = true}
    ordered := true
    for id in mem.present:
        if mem.ticked[id] == mem.tick:
            ordered = ordered and (out.ids.len == 0 or out.ids[-1] < id)
            append(out.ids, id)
    if not ordered:
        sort(out.ids)
    for id in out.ids:
        if mem.known[id] == 0:
            mem.known[id] = intern(mem.cur[id]) + 1
        append(out.vals, mem.known[id] - 1)
    for t in mem.fn.crossing:
        if mem.interned[t] == 0:
            mem.interned[t] = intern(mem.temps[t]) + 1
        append(out.temps, mem.interned[t] - 1)
    return out

func needed(id: u32, s: i64) -> bool:
    owner := i64(mem.fn.cells[id].owner)
    if owner < SLOTS or s == NONE:
        return true
    k := owner - SLOTS
    return (((mem.fn.alive[s * mem.words + k / 64] or mem.held[k / 64]) >> u64(k % 64)) and 1) != 0

func merge(a: State, b: State, s: i64) -> State:
    out := State{seen = true}
    if not b.seen:
        out.seen = a.seen
        out.marks = a.marks
        out.runs = a.runs
        for k in 0..a.ids.len:
            append(out.ids, a.ids[k])
            append(out.vals, a.vals[k])
        for v in a.temps:
            append(out.temps, v)
        return out
    if not a.seen:
        out.marks = b.marks
        out.runs = b.runs
        for k in 0..b.ids.len:
            if needed(b.ids[k], s):
                append(out.ids, b.ids[k])
                append(out.vals, b.vals[k])
        for v in b.temps:
            append(out.temps, v)
        return out
    x := a.marks
    y := b.marks
    out.marks = Marks{x.live or y.live, x.freed or y.freed, x.killed or y.killed, x.sure and y.sure, x.gone and y.gone, x.used or y.used, x.made or y.made, x.waited or y.waited}
    out.runs = Runs{a.runs.running or b.runs.running, a.runs.now or b.runs.now, a.runs.locks and b.runs.locks, a.runs.joined and b.runs.joined}
    la := alive(x)
    lb := alive(y)
    dying := not (la or lb)
    views: &list[u64] = heap([])
    defer free(views)
    i := 0
    j := 0
    while i < a.ids.len or j < b.ids.len:
        if j == b.ids.len or i < a.ids.len and a.ids[i] < b.ids[j]:
            id := a.ids[i]
            c := mem.fn.cells[id]
            append(out.ids, id)
            append(out.vals, intern(unite(mem.pool[a.vals[i]], missing(b, c), la, lb)))
            if c.member != 0:
                view := mem.pool[out.vals[-1]]
                refer(id, view.live or view.dead)
            alone(views, c, a.vals[i])
            i += 1
        elif i == a.ids.len or b.ids[j] < a.ids[i]:
            id := b.ids[j]
            c := mem.fn.cells[id]
            if needed(id, s):
                append(out.ids, id)
                append(out.vals, intern(unite(missing(a, c), mem.pool[b.vals[j]], la, lb)))
                if c.member != 0:
                    view := mem.pool[out.vals[-1]]
                    refer(id, view.live or view.dead)
                alone(views, c, b.vals[j])
            j += 1
        else:
            id := a.ids[i]
            append(out.ids, id)
            append(out.vals, blend(a.vals[i], b.vals[j], la, lb, dying))
            if a.vals[i] != b.vals[j]:
                wa := mem.pool[a.vals[i]].writer
                wb := mem.pool[b.vals[j]].writer
                if wa != wb and wa != 0 and wb != 0 and mem.fn.cells[id].member == 0:
                    c := mem.fn.cells[id]
                    append(views, (u64(cell_at(i64(c.owner), c.off, c.stride, c.count, wa)) << 32) or u64(a.vals[i]))
                    append(views, (u64(cell_at(i64(c.owner), c.off, c.stride, c.count, wb)) << 32) or u64(b.vals[j]))
            i += 1
            j += 1
    for k in 0..a.temps.len:
        append(out.temps, blend(a.temps[k], b.temps[k], la, lb, dying))
    kept := 0
    for v in views:
        if binary_search(out.ids, u32(v >> 32)) is null:
            views[kept] = v
            kept += 1
            word := mem.pool[v and 0xffff_ffff]
            refer(u32(v >> 32), word.live or word.dead)
    if kept > 0:
        views.len = kept
        for k in 0..out.ids.len:
            append(views, (u64(out.ids[k]) << 32) or u64(out.vals[k]))
        sort(views)
        out.ids.len = 0
        out.vals.len = 0
        for v in views:
            append(out.ids, u32(v >> 32))
            append(out.vals, u32(v and 0xffff_ffff))
    return out

# a word that one path wrote as a member and the other never wrote: read as that member it is what that path wrote
func alone(views: *&list[u64], c: Cell, val: u32):
    w := mem.pool[val].writer
    if w != 0 and c.member == 0 and (c.owner >= SLOTS or not mem.fn.outer[i64(c.owner)]):
        append(views, (u64(cell_at(i64(c.owner), c.off, c.stride, c.count, w)) << 32) or u64(val))

func missing(st: State, c: Cell) -> Target:
    if c.owner < SLOTS and mem.fn.focus[i64(c.owner)]: # a path that never made the element of the round
        return Target{}
    if c.member != 0:
        found := binary_search(st.ids, u32(cell_at(i64(c.owner), c.off, c.stride, c.count, 0)))
        if found is i64:
            return through(mem.pool[st.vals[found]], c.member)
    return initial(i64(c.owner), c.off, c.stride, c.count, c.member)

func blend(x: u32, y: u32, la: Set, lb: Set, dying: Set) -> u32:
    if x == y and empty(mem.pool[x].live and dying):
        return x
    return intern(unite(mem.pool[x], mem.pool[y], la, lb))

func pack(s: Summary) -> State:
    out := State{marks = s.marks, seen = s.seen}
    for k in 0..s.ids.len:
        append(out.ids, s.ids[k])
        append(out.vals, intern(s.aims[k]))
    return out

func intern(v: Target) -> u32:
    found := mem.pooled[v]
    if found is u32:
        return found
    mem.pooled[v] = u32(mem.pool.len)
    append(mem.pool, v)
    return u32(mem.pool.len - 1)

operator hash(v: Target) -> u64:
    h := fold(fold(fold(FNVBASIS, v.live), v.dead), v.must)
    h = (h xor u64(i64(v.off) + 2)) * FNVPRIME
    h = (h xor u64(v.stride)) * FNVPRIME
    h = (h xor u64(v.slot)) * FNVPRIME
    # MurmurHash3 finalizer
    h = (h xor (h >> 33)) * 0xff51_afd7_ed55_8ccd
    h = (h xor (h >> 33)) * 0xc4ce_b9fe_1a85_ec53
    return h xor (h >> 33)

operator hash(t: Touch) -> u64:
    h := fold(FNVBASIS, t.locks)
    h = (h xor u64(t.owner)) * FNVPRIME
    h = (h xor u64(i64(t.off) + 2)) * FNVPRIME
    h = (h xor u64(t.stride)) * FNVPRIME
    h = (h xor u64(t.count)) * FNVPRIME
    h = (h xor u64(t.size)) * FNVPRIME
    h = fold((h xor u64(t.wrote)) * FNVPRIME, t.after)
    return h xor (h >> 33)

func fold(h: u64, x: Set) -> u64:
    for i in 0..8:
        h = (h xor x.words[i]) * FNVPRIME
    return h

func release(st: State):
    free(st.ids)
    free(st.vals)
    free(st.temps)

func release(s: Summary):
    free(s.ids)
    free(s.aims)

func target_of(a: Operand) -> Target:
    if a.temp != 0:
        return mem.temps[a.temp]
    if a.data == 1:
        return Target{live = bit(STATIC), must = bit(STATIC)}
    if a.data > 1:
        s := object((u64(a.data - 2) << 8) or SHARED, Obj{kind = Shared, name = mem.globals[a.data - 2], core = mem.core[a.data - 2]})
        return Target{live = bit(s), must = bit(s)}
    if a.n > 0 - FAR and a.n < FAR:
        return number(i32(a.n))
    if a.n >= FAR:
        return number(FAR)
    return number(ANY)

func number(off: i32) -> Target:
    return Target{live = bit(NOWHERE), off = off}

func amount(v: Target) -> Target:
    if plain(v):
        return v
    return number(ANY)

func define(t: u32, v: Target):
    if t == 0:
        return
    mem.temps[t] = v
    mem.temps[t].writer = 0
    mem.interned[t] = 0
    if not mem.fn.cross[t] and mem.fn.last[t] > mem.here and not empty(objects(v.live or v.dead)):
        append(mem.active, t)

# memory that a call gives takes the name of the first variable that holds it
func christen(v: Target, name: &strview):
    for h in objects(v.live) and mem.fn.heaps:
        if mem.fn.objs[h].name.len == 0:
            mem.fn.objs[h].name = name

func pointing(v: Target) -> bool:
    return not empty(objects(v.live)) or not empty(v.dead) or v.slot != 0

func followable(v: Target) -> bool:
    return not empty((v.live or v.dead) - mem.pinned) or v.slot != 0

func plain(v: Target) -> bool:
    return v.live == bit(NOWHERE) and empty(v.dead) and v.slot == 0

func blank(v: Target) -> bool:
    return empty(v.live) and empty(v.dead) and v.slot == 0

func plus(a: Target, off: i32, stride: i32, count: u32) -> Target:
    out := a
    if a.off == ANY or off == ANY or a.stride != 0 and stride != 0 and a.stride != stride:
        out.off = ANY
        out.stride = 0
        out.count = 0
        return out
    out.off = a.off + off
    if stride != 0:
        out.stride = stride
        out.count = 0
        if a.stride == 0:
            out.count = count
    if out.off < 0 or out.off >= FAR or out.stride > EXACT or out.stride != 0 and out.off >= RUN:
        out.off = ANY
        out.stride = 0
        out.count = 0
    return out

func blur(x: Target, y: Target) -> Target:
    out := Target{live = x.live or y.live or bit(NOWHERE), dead = x.dead or y.dead, off = ANY, slot = x.slot, killer = max(x.killer, y.killer)}
    if x.slot == 0:
        out.slot = y.slot
    elif y.slot != 0 and y.slot != x.slot:
        out.slot = ALL
    return out

func unite(a: Target, b: Target, la: Set, lb: Set) -> Target:
    if blank(a):
        return b
    if blank(b):
        return a
    out := a
    out.live = a.live or b.live
    out.dead = a.dead or b.dead
    out.must = (a.must or not la) and (b.must or not lb) and out.live
    out.element = a.element and (b.element or not followable(b)) or b.element and not followable(a)
    if a.writer != b.writer:
        out.writer = 0
    out.killer = max(a.killer, b.killer)
    if a.member != b.member and not plain(b):
        out.member = 0
    if a.slot == 0:
        out.slot = b.slot
    elif b.slot != 0 and b.slot != a.slot:
        out.slot = ALL
    stride := a.stride
    if stride == 0:
        stride = b.stride
    if stride == 0:
        stride = a.off - b.off
    if stride < 0:
        stride = 0 - stride
    if plain(a):
        out.off = b.off
        out.stride = b.stride
        out.count = b.count
        out.member = b.member
    elif plain(b) or a.off == b.off and a.stride == b.stride and a.count == b.count:
        return out
    elif a.off == ANY or b.off == ANY or a.stride != 0 and b.stride != 0 and a.stride != b.stride or (a.off - b.off) % stride != 0 or stride > EXACT or a.off >= RUN and b.off >= RUN:
        out.off = ANY
        out.stride = 0
        out.count = 0
    else:
        out.stride = stride
        out.count = 0
        if b.off < a.off:
            out.off = b.off
    return out

func fetch(a: Target) -> Target:
    out: Target
    owners := objects(a.live or a.dead)
    count := 0
    exact := a.off != ANY and a.stride == 0
    live := alive(mem.marks)
    for o in owners:
        count += 1
        if o == STATIC or o == OUTSIDE:
            out = unite(out, Target{live = bit(o), must = bit(o)}, live, live)
        elif o != GONE:
            exact = exact and not mem.fn.many[o]
            out = gather(out, o, a.off, a.stride, a.count, a.member, live)
    if a.slot == ALL:
        count += 2
        for s in 0..mem.fn.slots.len:
            out = gather(out, SLOTS + s, a.off, a.stride, a.count, a.member, live)
    elif a.slot != 0:
        count += 1
        out = gather(out, SLOTS + i64(a.slot) - 1, a.off, a.stride, a.count, a.member, live)
    if blank(out):
        return number(0)
    if count > 1 or not exact:
        out.must = Set{}
    if not exact:
        out.element = true
    return out

func gather(out: Target, owner: i64, off: i32, stride: i32, count: u32, member: u32, live: Set) -> Target:
    word: u32 = 0
    view: u32 = 0
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        if c.off == off and c.stride == stride and c.count == count:
            if c.member == 0:
                word = h
            elif c.member == member:
                view = h
        elif c.member == 0:
            fits := c.off == ANY or off == ANY
            if not fits and c.stride == 0 and stride == 0:
                fits = c.off == off
            elif not fits and c.stride == 0:
                fits = c.off >= off and (c.off - off) % stride == 0
            elif not fits and stride == 0:
                fits = off >= c.off and (off - c.off) % c.stride == 0
            elif not fits:
                fits = c.stride != stride or (c.off - off) % stride == 0
            if fits and c.off != ANY and off != ANY: # the elements of an array end where it ends
                fits = (count == 0 or i64(c.off) < i64(off) + i64(count) * i64(stride)) and (c.count == 0 or i64(off) < i64(c.off) + i64(c.count) * i64(c.stride))
            if fits and mem.ticked[h - 1] != mem.tick and off != ANY: # untouched, a cell that spans more holds what this one does
                fits = c.off != ANY and (c.stride == 0 or c.stride == stride)
            if fits:
                out = unite(out, current(i64(h) - 1), live, live)
        h = c.next
    if view != 0:
        return unite(out, current(i64(view) - 1), live, live)
    if word == 0 or member != 0 and mem.ticked[word - 1] != mem.tick:
        return unite(out, initial(owner, off, stride, count, member), live, live)
    if member != 0:
        return unite(out, through(cell_value(word - 1), member), live, live)
    return unite(out, current(i64(word) - 1), live, live)

func stash(a: Target, v: Target):
    if a.member != 0:
        v.writer = a.member
    one := sole(a) != NONE
    for o in a.live - mem.pinned:
        settle(cell_at(o, a.off, a.stride, a.count, 0), v, (one or a.must[o]) and not mem.fn.many[o])
    if a.slot == ALL:
        for s in 0..mem.fn.slots.len:
            settle(cell_at(SLOTS + s, a.off, a.stride, a.count, 0), v, false)
    elif a.slot != 0:
        settle(cell_at(SLOTS + i64(a.slot) - 1, a.off, a.stride, a.count, 0), v, one)
    if a.live[OUTSIDE]:
        if mem.speak and mem.fn.stuck.len == 0 and followable(v):
            warn(UNFOLLOWED, mem.ops[mem.here].pos, "", 0, false)
        settle(cell_at(OUTSIDE, ANY, 0, 0, 0), v, false)

func sole(a: Target) -> i64:
    targets := a.live - mem.pinned
    if a.slot == 0 and single(targets):
        for o in targets:
            return o
    if empty(targets) and a.slot != 0 and a.slot != ALL:
        return SLOTS + i64(a.slot) - 1
    return NONE

func settle(id: i64, given: Target, exact: bool):
    c := mem.fn.cells[id]
    v := given
    if mem.rounding and c.owner < SLOTS: # what writes the list a walk is in changes the element of its round too
        focus := mem.fn.focus
        for r in focus:
            p := mem.fn.objs[r].parent
            if (mem.fn.keys[r] and 0xff) == ROUND and mem.marks.live[r] and p >= 0 and p < SLOTS and kin(p)[i64(c.owner)]:
                k := mem.fn.heads[r]
                while k != 0:
                    d := mem.fn.cells[k - 1]
                    if mem.ticked[k - 1] == mem.tick:
                        w := cell_value(k - 1)
                        w.writer = ALL
                        rewrite(i64(k) - 1, w)
                    k = d.next
    if plain(v) and v.off != 0 and v.off != ANY and v.stride == 0: # a pointer that holds a number holds the mark of the heap
        v = Target{live = bit(STATIC), must = bit(STATIC), writer = given.writer}
    elif plain(v):
        v = number(0)
        v.writer = given.writer
    if exact and c.off != ANY and c.stride == 0:
        held := mem.index[(child(i64(c.owner), c.off, 0) xor FIELD) or PLACE]
        if held is u32 and mem.marks.live[i64(held)] and not v.live[i64(held)]: # the block named after this place leaves it, and the name is for the next one
            age(i64(held))
        place(id, v)
    else:
        old := current(id)
        live := alive(mem.marks)
        w := unite(old, v, live, live)
        w.must = Set{}
        if many(c):
            w.must = (old.must or v.must) and w.live
            if v.element or mem.fn.walks:
                for h in objects(v.live):
                    if v.element or mem.fn.focus[h] and (mem.fn.keys[h] and 0xff) == FOCUS: # the element of a round stored in a list
                        mem.fn.objs[h].element = true
        place(id, w)
    if c.member == 0 and mem.viewed:
        h := mem.fn.heads[c.owner]
        while h != 0:
            d := mem.fn.cells[h - 1]
            if d.member != 0 and d.off == c.off and d.stride == c.stride and d.count == c.count:
                drop(i64(h) - 1)
            h = d.next

func many(c: Cell) -> bool:
    return c.off == ANY or c.stride != 0 or c.owner < SLOTS and mem.fn.many[i64(c.owner)]

func cell_value(id: u32) -> Target:
    if mem.fresh[id] == mem.tick:
        return mem.cur[id]
    return mem.pool[mem.known[id] - 1]

func current(id: i64) -> Target:
    if mem.ticked[id] == mem.tick:
        return cell_value(u32(id))
    c := mem.fn.cells[id]
    if c.member != 0:
        word := cell_at(i64(c.owner), c.off, c.stride, c.count, 0)
        if mem.ticked[word] == mem.tick:
            return through(cell_value(u32(word)), c.member)
    return initial(i64(c.owner), c.off, c.stride, c.count, c.member)

func through(word: Target, member: u32) -> Target:
    if word.writer == 0 or word.writer == member:
        return word
    return Target{}

func place(id: i64, v: Target):
    c := mem.fn.cells[id]
    if plain(v) and v.off == 0 and v.stride == 0 and v.writer == 0 and (c.owner >= SLOTS or not mem.fn.outer[i64(c.owner)]):
        drop(id)
        return
    if v.slot != 0 and v.slot != ALL:
        k := i64(v.slot) - 1
        mem.pointed[k / 64] = mem.pointed[k / 64] or (u64(1) << u64(k % 64))
    fresh := v.live or v.dead
    if mem.ticked[id] == mem.tick:
        old := cell_value(u32(id))
        fresh = fresh - (old.live or old.dead) or v.live - v.dead - (old.live - old.dead)
    elif mem.ticked[id] == (mem.tick xor DROPPED):
        mem.ticked[id] = mem.tick
    else:
        mem.ticked[id] = mem.tick
        append(mem.present, u32(id))
    refer(u32(id), fresh)
    rewrite(id, v)

func rewrite(id: i64, v: Target):
    mem.cur[id] = v
    mem.fresh[id] = mem.tick
    mem.known[id] = 0

func refer(id: u32, blocks: Set):
    for o in objects(blocks):
        append(mem.refs[o], id)

func drop(id: i64):
    if mem.ticked[id] == mem.tick:
        mem.ticked[id] = mem.tick xor DROPPED

func initial(owner: i64, off: i32, stride: i32, count: u32, member: u32) -> Target:
    if owner >= SLOTS or not mem.fn.outer[owner]:
        if owner < SLOTS and mem.fn.focus[owner] and mem.fn.objs[owner].parent != NONE: # one block of its parent, with what that one holds, or the element in place, where it is
            x := mem.fn.objs[owner]
            at := plus(Target{off = x.off, stride = x.stride, count = x.count}, off, stride, count)
            return focused(initial(x.parent, at.off, at.stride, at.count, member), mem.fn.keys[owner] >> 24, x.depth + u32((mem.fn.keys[owner] and 0xff) != ROUND))
        return number(0)
    if member >= MEMBERS:
        return initial(owner, off, stride, count, 0)
    x := mem.fn.objs[owner]
    if x.depth > HOPS:
        return Target{live = bit(owner), must = bit(owner)} # past HOPS pointers a block is all the memory it reaches
    c := object(child(owner, off, stride) or (u64(member) << 49), Obj{kind = Entry, parent = owner, off = off, stride = stride, count = count, member = member, root = x.root, core = x.core, depth = x.depth + 1, many = mem.fn.many[owner] or off == ANY or stride != 0 or x.depth == HOPS})
    if mem.fn.objs[c].count != count:
        mem.fn.objs[c].count = 0
    return Target{live = bit(c), must = bit(c)}

func child(owner: i64, off: i32, stride: i32) -> u64:
    code: u64 = 0
    if off != ANY and stride == 0:
        code = u64(off + 1)
    elif off != ANY:
        code = u64(FAR + 1) + u64(stride) * RUN + u64(off) # past every exact one
    return (u64(owner) << 40) or (code << 8) or FIELD

func cell_at(owner: i64, off: i32, stride: i32, count: u32, member: u32) -> i64:
    if member != 0:
        cell_at(owner, off, stride, count, 0) # a word before its views, settling it drops them
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        if c.off == off and c.stride == stride and c.count == count and c.member == member:
            return i64(h) - 1
        h = c.next
    append(mem.fn.cells, Cell{owner = u32(owner), next = mem.fn.heads[owner], off = off, stride = stride, count = count, member = member})
    mem.fn.heads[owner] = u32(mem.fn.cells.len)
    if member != 0:
        mem.viewed = true
    grow_cells()
    return mem.fn.cells.len - 1

func grow_cells():
    while mem.cur.len < mem.fn.cells.len:
        append(mem.cur, Target{})
        append(mem.fresh, u32(0))
        append(mem.ticked, u32(0))
        append(mem.renamed, u32(0))
        append(mem.known, u32(0))

func object(key: u64, x: Obj) -> i64:
    found := mem.index[key]
    if found is u32:
        return found
    if mem.fn.keys.len == SLOTS:
        mem.fn.stuck = "it has more than " + SLOTS + " blocks of memory to follow"
        return OUTSIDE
    n := mem.fn.objs.len
    y := x
    y.key = key
    append(mem.fn.keys, key)
    mem.index[key] = u32(n)
    append(mem.fn.objs, y)
    if x.kind == Heap:
        mem.fn.heaps = mem.fn.heaps or bit(n)
    if x.kind == Entry or x.kind == Shared:
        mem.fn.outer = mem.fn.outer or bit(n)
    if x.kind == Shared:
        mem.fn.roots = mem.fn.roots or bit(n)
    if x.kind == Focus:
        mem.fn.focus = mem.fn.focus or bit(n)
        mem.fn.walks = true
    if x.many:
        mem.fn.many = mem.fn.many or bit(n)
    if x.depth > HOPS:
        mem.fn.far = mem.fn.far or bit(n)
    if x.arena:
        mem.fn.arenas = mem.fn.arenas or bit(n)
    return n

func reborn(was: Target, blocks: Set, out: *Target, arena: Target, key: u64, given: Obj) -> i64:
    unset := was.live[NOWHERE] or blank(was)
    own := mem.index[key]
    if unset and own is u32 and was.live[i64(own)]: # empty or holding the block named after it, the place holds that one again
        mem.marks.live[i64(own)] = true
        out.live[i64(own)] = true
        out.must[i64(own)] = true
        return i64(own)
    if unset and single(blocks) and not empty(blocks and mem.fn.heaps and was.must):
        mem.marks.live = mem.marks.live or blocks
    elif unset:
        h := lodge(arena, key, given)
        out.live = out.live or bit(h)
        out.must = out.must or bit(h)
        return h
    return NONE

func birth(key: u64, given: Obj) -> i64:
    r := object(key, given)
    if r == OUTSIDE:
        return r
    if mem.marks.live[r] or mem.marks.freed[r] or mem.marks.killed[r]:
        age(r)
    revive(r)
    return r

# r joins the older blocks of its line, so it stands for a block made later
func age(r: i64):
    x := mem.fn.objs[r]
    x.many = true
    t := object(mem.fn.keys[r] or AGED, x)
    if t != r:
        absorb(r, bit(t), false)
        for k in 0..mem.footprints.len: # what the threads touched of it is of the older blocks now
            if mem.footprints[k].touch.owner == u32(r):
                mem.footprints[k].touch.owner = u32(t)

# r holds a block made now
func revive(r: i64):
    b := bit(r)
    mem.marks.live = mem.marks.live or b
    mem.marks.freed = mem.marks.freed - b
    mem.marks.killed = mem.marks.killed - b
    mem.marks.sure = mem.marks.sure - b
    mem.marks.gone = mem.marks.gone - b

# what points to r points to t from now on, and what r holds and its marks join those of t: the blocks of r are new to t, or already among its blocks when within
func absorb(r: i64, into: Set, within: bool):
    mem.ages += 1
    lone := single(into) and empty(into and mem.fn.many) # one block, which a pointer can be sure of
    sides := bit(r)
    if not within: # within, what points only to into is still as sure
        sides = sides or into
    for o in sides:
        n := mem.refs[o].len
        for k in 0..n:
            id := mem.refs[o][k]
            if mem.ticked[id] == mem.tick and mem.renamed[id] != mem.ages:
                mem.renamed[id] = mem.ages
                rewrite(i64(id), rename(cell_value(id), r, into, within, lone or many(mem.fn.cells[id]))) # or of where the elements of a list point
                if o == r:
                    for t in into:
                        append(mem.refs[t], id)
    pair := sides or into
    kept := 0
    for v in mem.active:
        if mem.fn.last[v] > mem.here:
            mem.temps[v] = rename(mem.temps[v], r, into, within, lone)
            mem.active[kept] = v
            kept += 1
    mem.active.len = kept
    for v in mem.fn.crossing:
        t := mem.temps[v]
        if t.live[r] or t.dead[r] or not within and not empty((t.live or t.dead or t.must) and pair):
            mem.temps[v] = rename(t, r, into, within, lone)
            mem.interned[v] = 0
    bound := mem.bound
    for k in bound:
        mem.binds[k] = rename(mem.binds[k], r, into, within, lone)
    live := alive(mem.marks)
    h := mem.fn.heads[r]
    while h != 0:
        id := i64(h) - 1
        c := mem.fn.cells[id]
        if mem.ticked[id] == mem.tick:
            v := cell_value(u32(id))
            drop(id)
            for t in into:
                at := cell_at(t, c.off, c.stride, c.count, c.member)
                old := current(at)
                w := unite(old, v, live, live)
                w.must = (old.must or v.must) and w.live
                place(at, w)
        h = c.next
    for t in into:
        mem.fn.objs[t].element = mem.fn.objs[t].element or mem.fn.objs[r].element
    m := mem.marks
    mem.marks = Marks{shift(m.live, r, into), shift(m.freed, r, into), shift(m.killed, r, into), m.sure - pair, m.gone - pair, shift(m.used, r, into), shift(m.made, r, into), shift(m.waited, r, into)}
    mem.runs.running = shift(mem.runs.running, r, into)

# the elements of the last round of a walk join the ones it visited
func visited(walk: u64):
    focus := mem.fn.focus
    for f in focus:
        key := mem.fn.keys[f]
        if (key and 0xff) == FOCUS and key >> 24 == walk and (mem.marks.live[f] or mem.marks.killed[f]):
            x := mem.fn.objs[f]
            v := object((key xor FOCUS) or VISITED, Obj{kind = Focus, parent = x.parent, many = true, name = x.name, from = x.from, pos = x.pos, site = x.site, strict = x.strict})
            absorb(f, bit(v), true)
    r := mem.index[(walk << 24) or ROUND]
    if r is u32 and mem.marks.live[i64(r)] and mem.fn.objs[r].parent != NONE: # the element in place goes back to where it is
        mem.marks.live[i64(r)] = false
        element := placed(mem.fn.objs[r])
        k := mem.fn.heads[r]
        while k != 0:
            c := mem.fn.cells[k - 1]
            if mem.ticked[k - 1] == mem.tick and c.member == 0:
                stash(plus(element, c.off, 0, 0), cell_value(k - 1))
            drop(i64(k) - 1)
            k = c.next

# where the element of a round of a walk is
func placed(x: Obj) -> Target:
    at: Target
    if x.parent >= SLOTS:
        at = Target{slot = u32(x.parent - SLOTS + 1)}
    elif x.parent != NONE:
        at = Target{live = kin(x.parent)}
    return plus(at, x.off, x.stride, x.count)

# the block that stands for the element in place at element in this round of a walk, which goes back there after it: what it holds starts as the element's own
func rounded(walk: u64, element: Target, shape: u32, name: &strview) -> i64:
    r := object((walk << 24) or ROUND, Obj{kind = Focus, name = name})
    if r == OUTSIDE or mem.marks.live[r]:
        return r
    x := mem.fn.objs[r]
    x.parent = NONE
    if element.slot != 0 and element.slot != ALL:
        x.parent = SLOTS + i64(element.slot) - 1
    for p in objects(element.live):
        x.parent = newest(p)
    x.off = element.off
    x.stride = element.stride
    x.count = element.count
    x.shape = shape
    mem.fn.objs[r] = x
    for k in 0..64 * mem.layouts[shape].len:
        if marked(shape, k):
            place(cell_at(r, i32(k * 8), 0, 0, 0), focused(fetch(plus(element, i32(k * 8), 0, 0)), walk, 0))
    mem.marks.live[r] = true
    mem.rounding = true
    return r

# v as the element of a round of a walk: each block it points to is one of its own, which starts with what the blocks it stands for hold
func focused(v: Target, walk: u64, depth: u32) -> Target:
    if depth > HOPS:
        return v
    out := v
    out.element = false
    for h in freeable(objects(v.live or v.dead)):
        if mem.fn.focus[h] and mem.fn.keys[h] >> 24 == walk: # an element this walk visited is not the one of this round
            out.live[h] = false
            out.dead[h] = false
            out.must[h] = false
            continue
        line := newest(h) # it and the older blocks of its line stand for the one block of the element, whichever it is
        x := mem.fn.objs[line]
        f := object((walk << 24) or (u64(line) << 8) or FOCUS, Obj{kind = Focus, parent = line, depth = depth, name = x.name, from = x.from, pos = x.pos, site = x.site, strict = x.strict})
        if f == OUTSIDE:
            continue
        out = rename(out, h, bit(f), true, true)
        out.must[f] = out.live[f]
        if not mem.marks.live[f]:
            revive(f)
            live := alive(mem.marks)
            for kin in kin(line):
                k := mem.fn.heads[kin]
                while k != 0:
                    c := mem.fn.cells[k - 1]
                    if mem.ticked[k - 1] == mem.tick:
                        at := cell_at(f, c.off, c.stride, c.count, c.member)
                        w := focused(cell_value(k - 1), walk, depth + 1)
                        if mem.ticked[at] == mem.tick: # what the older blocks hold
                            old := cell_value(u32(at))
                            w = unite(old, w, live, live)
                            w.must = (old.must or w.must) and w.live
                        place(at, w)
                    k = c.next
    return out

# the newest block of the line of h, which kin goes back from
func newest(h: i64) -> i64:
    key := mem.fn.keys[h]
    if (key and AGED) != 0:
        return i64(mem.index[key xor AGED] ifnull u32(h))
    return h

# h and the older blocks of its line
func kin(h: i64) -> Set:
    out := bit(h)
    aged := mem.index[mem.fn.keys[h] or AGED]
    if aged is u32:
        out[i64(aged)] = true
    return out

func shift(m: Set, r: i64, into: Set) -> Set:
    if not m[r]:
        return m
    return m - bit(r) or into

# v with r as the blocks of into: when r is among their blocks it stays as sure as it was of r if it keeps, and else it is sure of one only when it was of both, or they were freed
func rename(v: Target, r: i64, into: Set, within: bool, keeps: bool) -> Target:
    pair := bit(r) or into
    if empty((v.live or v.dead or v.must) and pair):
        return v
    out := v
    out.live = shift(v.live, r, into)
    out.dead = shift(v.dead, r, into)
    out.must = v.must - pair
    for t in into:
        sure := (v.must[r] or not mem.marks.live[r]) and (v.must[t] or not mem.marks.live[t])
        if within:
            sure = v.must[t] or v.must[r] and keeps
        out.must[t] = out.live[t] and sure
    return out

func condemn(o: i64, strong: bool, freed: bool):
    b := bit(o)
    mem.condemned = mem.condemned or b
    mem.marks.killed = mem.marks.killed or b
    if freed:
        mem.marks.freed = mem.marks.freed or b
        mem.released = mem.released or b
    if strong:
        mem.strong = mem.strong or b
        mem.marks.sure = mem.marks.sure or b

func sweep():
    if empty(mem.condemned):
        return
    if mem.fn.walks:
        focus := mem.fn.focus
        for f in focus: # a block that the element of a round stands for, or the list it is in, goes and takes it along
            p := mem.fn.objs[f].parent
            if p >= 0 and p < SLOTS and not empty(kin(p) and mem.condemned):
                mem.condemned[f] = true
    condemned := mem.condemned
    for o in condemned and mem.fn.outer:
        x := mem.fn.objs[o]
        if x.depth > 0:
            id := cell_at(x.parent, x.off, x.stride, x.count, x.member)
            if mem.ticked[id] != mem.tick:
                place(id, initial(x.parent, x.off, x.stride, x.count, x.member))
    strong := mem.strong
    loose: Set
    for o in condemned - strong:
        loose[o] = mem.fn.objs[o].element
    for o in condemned:
        first := 0
        if (mem.swept[o] >> 32) == u64(mem.tick) and not strong[o]:
            first = i64(mem.swept[o] and 0xffff_ffff)
        for k in first..mem.refs[o].len:
            id := mem.refs[o][k]
            owner := i64(mem.fn.cells[id].owner)
            hit := condemned
            if many(mem.fn.cells[id]):
                hit = strong or mem.released - loose # an element freed at an index it knows may be any of a list, at one it doesn't know it stays live there, and so does one moved
            elif owner < SLOTS and mem.fn.heaps[owner]:
                hit = condemned - loose # an element freed through a variable stays live where the heap keeps it, like in a list
            if mem.ticked[id] == mem.tick and not empty(cell_value(id).live and hit):
                rewrite(i64(id), kill(cell_value(id), hit, strong))
        mem.swept[o] = (u64(mem.tick) << 32) or u64(mem.refs[o].len)
    kept := 0
    for t in mem.active:
        if mem.fn.last[t] > mem.here:
            mem.temps[t] = kill(mem.temps[t], condemned, strong)
            mem.active[kept] = t
            kept += 1
    mem.active.len = kept
    for t in mem.fn.crossing:
        mem.temps[t] = kill(mem.temps[t], condemned, strong)
        mem.interned[t] = 0
    mem.condemned = Set{}
    mem.strong = Set{}
    mem.released = Set{}

func vanish(gone: Set):
    mem.marks.live = mem.marks.live - gone
    mem.marks.gone = mem.marks.gone or gone
    mem.marks.sure = mem.marks.sure or gone

func kill(v: Target, condemned: Set, strong: Set) -> Target:
    hit := v.live and condemned
    if empty(hit):
        return v
    gone := hit and strong
    v.dead = v.dead or hit
    v.killer = mem.ops[mem.here].pos
    v.live = v.live - gone
    v.must = v.must - gone
    return v

func touch(a: Target, name: &strview):
    use(a.live or a.dead)
    stale(a, name, false)

func use(x: Set):
    mem.marks.used = mem.marks.used or x and mem.fn.outer
    if mem.fn.walks:
        focus := x and mem.fn.focus
        mem.marks.used = mem.marks.used or focus
        for r in focus: # the element in place is in the memory of its list
            p := mem.fn.objs[r].parent
            if (mem.fn.keys[r] and 0xff) == ROUND and p >= 0 and p < SLOTS:
                use(kin(p))

func stale(a: Target, name: &strview, strict: bool):
    if mem.speak and not empty(a.dead):
        text: &str = heap("")
        for o in a.dead:
            if (mem.fn.objs[o].key and 0xff) == ENDED:
                gone := mem.fn.objs[o].name
                if name.len > 0:
                    text += name + " points to "
                else:
                    text += "this uses "
                if gone.len > 0:
                    text += gone + ", whose block has ended: copy it to the heap, or declare " + gone + " before the block"
                else:
                    text += "a temporary whose block has ended: copy it to the heap, or keep it in a variable declared before the block"
                warn(view(text), mem.ops[mem.here].pos, "", 0, strict)
                return
        if name.len > 0:
            text += name + " points to memory that may be freed already"
        else:
            text += "this uses memory that may be freed already"
        warn(view(text), mem.ops[mem.here].pos, "it may be freed here", a.killer, strict)

func freeable(live: Set) -> Set:
    out := live and (mem.fn.heaps - mem.fn.arenas or mem.fn.outer - mem.fn.roots)
    if mem.fn.walks:
        out = out or live and mem.fn.focus
    return out

func refusal(v: Target, kept: bool) -> &strview:
    if not empty(v.dead):
        return ", it may be freed already"
    if offheap(v) or v.live[STATIC] and not kept: # an owner in a constant is empty, so discard gets nothing from static data
        return ", it is not on the heap"
    chunks := v.live and mem.fn.arenas
    for h in chunks:
        if not mem.fn.objs[h].pool:
            return ", it is temporary memory: a with scratch() block releases it"
    if kept or empty(chunks):
        return ""
    for h in chunks:
        for id in mem.refs[h]:
            c := mem.fn.cells[id]
            if c.off == ANY and c.owner < SLOTS and not mem.fn.objs[c.owner].arena and mem.fn.objs[c.owner].name.len > 0:
                name := mem.fn.objs[c.owner].name
                return ", it lives in " + name + ", free(" + name + ") releases it"
    return ", it lives in an arena, freeing the arena releases it"

func offheap(v: Target) -> bool:
    return v.slot != 0 or v.live[RETURNED] or not empty(v.live and mem.fn.roots)

func chunk(arena: Target, name: &strview, key: u64, given: Obj) -> i64:
    held := fetch(arena)
    if empty(objects(held.live)):
        o := sole(arena)
        if name.len == 0 and o != NONE and o >= SLOTS:
            name = mem.fn.names[mem.fn.slots[o - SLOTS]]
        elif name.len == 0 and o != NONE:
            name = mem.fn.objs[o].name
        b := birth((key and 0xffff_ffff_ffff_ff00) or BLOCKS, Obj{kind = Heap, site = given.site, born = given.born, pos = given.pos, from = given.from, name = name})
        held = Target{live = bit(b), must = bit(b)}
    blocks := objects(held.live)
    stash(arena, Target{live = blocks, must = held.must and blocks})
    mem.marks.made = mem.marks.made or blocks and (mem.fn.outer or mem.fn.focus)
    given.arena = true
    given.pool = true
    k := birth(key or POOLED, given)
    stash(Target{live = blocks, off = ANY}, Target{live = bit(k), must = bit(k)})
    return k

func lodge(arena: Target, key: u64, given: Obj) -> i64:
    given.home = home_of(arena)
    if followable(arena) and given.home == 0:
        return chunk(arena, "", key, given)
    return birth(key, given)

func arena_of(ob: Obj) -> Target:
    if ob.home == 0:
        return number(0)
    return binding(i64(ob.home) - 1)

func home_of(arena: Target) -> u32:
    entry := sole(arena)
    if entry == NONE or entry >= SLOTS or not mem.fn.outer[entry] or mem.fn.roots[entry]:
        return 0
    return u32(entry) + 1

func refuse(who: &strview, name: &strview, why: &strview, v: Target, strict: bool):
    text: &str = heap("")
    if name.len > 0:
        text += who + " cannot release " + name + why
    else:
        text += who + " cannot release this memory" + why
    warn(view(text), mem.ops[mem.here].pos, "it may be freed here", v.killer, strict)

func immovable(who: &strview, name: &strview, why: &strview, strict: bool):
    text: &str = heap("")
    if name.len > 0:
        text += who + " cannot grow " + name + why
    else:
        text += who + " cannot grow this memory" + why
    warn(view(text), mem.ops[mem.here].pos, "", 0, strict)

func touch_args(o: Op):
    for k in o.first..o.first + o.count:
        touch(target_of(mem.args[k]), mem.fn.names[mem.args[k].temp])

func transfer(to: Target, from: Target, size: i64, shape: u32):
    for k in 0..size / 8:
        v := number(0)
        if marked(shape, k):
            v = fetch(plus(from, i32(k * 8), 0, 0))
        stash(plus(to, i32(k * 8), 0, 0), v)
    if not mem.viewed or from.off == ANY or from.member != 0:
        return
    owner := sole(from)
    into := sole(to)
    if owner == NONE or into == NONE:
        return
    h := mem.fn.heads[owner]
    while h != 0:
        c := mem.fn.cells[h - 1]
        k := i64(c.off) - i64(from.off)
        if c.member != 0 and c.stride == from.stride and k >= 0 and k < size and k % 8 == 0 and marked(shape, k / 8) and mem.ticked[h - 1] == mem.tick:
            spot := plus(to, i32(k), 0, 0)
            if spot.off != ANY:
                settle(cell_at(into, spot.off, spot.stride, spot.count, c.member), cell_value(h - 1), into >= SLOTS or not mem.fn.many[into])
        h = c.next

func copied(from: Target, t: i64, name: &strview):
    found := lockable(from, t, false)
    if found.type == VOID:
        return
    kind := text(comp.types[found.type].decl)
    text: &str = heap("")
    text += "this copies "
    if found.name.len > 0 and name.len > 0:
        text += "the " + kind + " " + found.name + " in " + name + ","
    elif found.name.len > 0:
        text += "the " + kind + " " + found.name + " in this value,"
    elif name.len > 0:
        text += name + ", " + kind_of(found.type)
    else:
        text += kind_of(found.type)
    switch kind:
    case "Arena":
        text += " that may have given memory: the copy gives out the same blocks"
    case "Lock":
        text += " that may have been taken: the copy is another lock"
    case:
        text += " that may be in use: the copy is another channel"
    text += ", use a pointer to it"
    warn(view(text), mem.ops[mem.here].pos, "", 0, false)

# the first Arena, Lock or Channel of core in a value of type t at from, with its path, that this function used unless any
func lockable(from: Target, t: i64, any: bool) -> Item:
    ty := comp.types[t]
    none: Item
    if ty.decl != 0 and file_of(comp.tokens[comp.nodes[ty.decl].tok].at) == 0 and (text(ty.decl) == "Arena" or text(ty.decl) == "Lock" or text(ty.decl) == "Channel"):
        if any:
            return Item{type = t}
        first := fetch(from) # the blocks of an Arena, the mutex of a Lock and of the Lock a Channel starts with
        if not empty(objects(first.live or first.dead) - mem.fn.outer):
            return Item{type = t}
    elif ty.kind == Struct:
        for item in comp.items[ty.first:ty.first + ty.count]:
            if item.shared:
                continue
            found := lockable(plus(from, i32(item.n), 0, 0), item.type, any)
            if found.type != VOID:
                path: &str = heap("")
                path += item.name
                if found.name.len > 0:
                    path += "." + found.name
                found.name = view(path)
                return found
    elif ty.kind == Array and ty.count > 0:
        return lockable(plus(from, 0, i32(comp.types[ty.elem].size), u32(ty.count)), ty.elem, any)
    return none

func kind_of(t: i64) -> &strview:
    if text(comp.types[t].decl) == "Arena":
        return "an Arena"
    if text(comp.types[t].decl) == "Lock":
        return "a Lock"
    return "a Channel"

func marked(shape: u32, k: i64) -> bool:
    words := mem.layouts[shape]
    return shape == EVERY or k / 64 < words.len and ((words[k / 64] >> u64(k % 64)) and 1) != 0

# the words of t that hold a pointer, or with owners only those that own memory
func layout(t: i64, owners: bool) -> u32:
    key := 2 * t
    if owners:
        key += 1
    found := mem.shaped[key]
    if found is u32:
        return found
    words: &list[u64] = heap([])
    for w in 0..comp.types[t].size / 512 + 1:
        append(words, u64(0))
    lay(ptr(words), t, 0, owners)
    id: u32 = 0
    for w in words:
        if w != 0:
            id = u32(mem.layouts.len)
    if id == 0:
        free(words)
    else:
        append(mem.layouts, words)
    put(mem.shaped, key, id)
    return id

func lay(words: *&list[u64], t: i64, at: i64, owners: bool):
    ty := comp.types[t]
    if ty.kind == Ptr or ty.kind == Thread or ty.kind == Func and not owners or ty.kind == Fat and (not owners or ty.count > 1): # a view has only its len
        words.*[at / 64] = words.*[at / 64] or u64(1) << u64(at % 64)
    if ty.kind == Atomic:
        lay(words, ty.elem, at, owners)
    elif ty.kind == Array and layout(ty.elem, owners) != 0:
        for i in 0..ty.count:
            lay(words, ty.elem, at + i * comp.types[ty.elem].size / 8, owners)
    elif ty.kind == Struct or ty.kind == Fat and not owners:
        for item in comp.items[ty.first:ty.first + ty.count]:
            lay(words, item.type, at + item.n / 8, owners)
    elif ty.kind == Union:
        for item in comp.items[ty.first:ty.first + ty.count]:
            lay(words, item.type, at + 1, owners) # the value is at byte 8
    elif ty.kind == Untagged:
        for item in comp.items[ty.first:ty.first + ty.count]:
            lay(words, item.type, at, owners)

func carry(from: Set, x: i64, into: Set, h: i64, replace: bool) -> Set:
    if replace:
        into = into - bit(h)
    if from[x]:
        into = into or bit(h)
    return into

func obj_of(g: i64, x: i64) -> Obj:
    if g == mem.f:
        return mem.fn.objs[x]
    return mem.fns[g].objs[x]

func binding(x: i64) -> Target:
    if mem.bound[x]:
        return mem.binds[x]
    g := mem.callee
    o := mem.ops[mem.call]
    ob := obj_of(g, x)
    out := Target{dead = bit(GONE)}
    home: Target
    if x <= STATIC:
        out = Target{live = bit(x), must = bit(x)}
    elif ob.kind == Shared:
        s := object(ob.key, ob)
        out = Target{live = bit(s), must = bit(s)}
        t := mem.apart[i64(ob.key >> 8)]
        if o.ghost and t != VOID: # a thread starts with its own, from the defaults or a copy of an inherited one
            c := object((u64(mem.call) << 16) or (u64(x) << 8) or COPY, Obj{kind = Slot, name = ob.name, pos = o.pos})
            h := mem.fn.heads[c]
            while h != 0:
                drop(i64(h) - 1)
                h = mem.fn.cells[h - 1].next
            stamper := mem.ids["$flag.stamp"]
            if declared(comp.types[t].decl) == "inherited":
                transfer(Target{live = bit(c), must = bit(c)}, out, comp.types[t].size, layout(t, false))
            elif stamper is i64: # the others start with what $flag.stamp writes when the thread enters
                sum := mem.fns[stamper].sum
                for k in 0..sum.ids.len:
                    cell := mem.fns[stamper].cells[sum.ids[k]]
                    if mem.fns[stamper].objs[cell.owner].key == ob.key:
                        place(cell_at(c, cell.off, cell.stride, cell.count, cell.member), sum.aims[k])
            out = Target{live = bit(c), must = bit(c)}
    elif ob.kind == Entry and ob.depth == 0:
        out = number(0)
        if ob.root <= o.count:
            out = target_of(mem.args[i64(o.first) + ob.root - 1])
    elif ob.kind == Entry:
        home = plus(binding(ob.parent), ob.off, ob.stride, ob.count)
        if ob.member != 0:
            home.member = ob.member
        out = fetch(home)
        if ob.depth > HOPS and (mem.fns[g].sum.marks.freed[x] or mem.fns[g].sum.marks.used[x]): # past HOPS pointers a block is also all that it reaches
            must := out.must
            live := alive(mem.marks)
            next := out
            while not blank(next):
                more := fetch(Target{live = objects(next.live or next.dead) - mem.fn.focus, slot = next.slot, off = ANY}) # a focus object stands for blocks of its parent, which this reaches already
                next = Target{live = objects(more.live or more.dead) - objects(out.live or out.dead)}
                if more.slot != 0 and more.slot != out.slot:
                    next.slot = more.slot
                out = unite(out, more, live, live)
            out.must = must
    if ob.kind == Entry and ob.depth <= HOPS and mem.fns[g].sum.marks.made[x]:
        name: &strview
        if ob.root > 0 and ob.root <= o.count:
            name = named(mem.args[i64(o.first) + ob.root - 1].temp, g, ob.root - 1)
        if name.len == 0 and home.off != ANY and home.stride == 0 and sole(home) != NONE: # a place with no variable of its own, like a field of a context
            name = spelled(sole(home), home.off, 8).name
        key := (u64(mem.call) << 16) or (u64(x) << 8) or SITE
        if home.off != ANY and home.stride == 0 and sole(home) != NONE:
            key = (child(sole(home), home.off, 0) xor FIELD) or PLACE
        h := reborn(out, objects(out.live), ptr(out), arena_of(ob), key, Obj{kind = Heap, site = i64(mem.call), pos = o.pos, from = mem.who, name = name})
        if h != NONE:
            mem.fn.objs[h].strict = mem.fn.objs[h].strict or mem.fns[g].strict
        out.live = objects(out.live)
    mem.binds[x] = out
    mem.bound = mem.bound or bit(x)
    return out

func translate(v: Target) -> Target:
    if plain(v):
        return v
    out: Target
    live := alive(mem.marks)
    must: Set
    for x in objects(v.live):
        b := plus(binding(x), v.off, v.stride, v.count)
        if v.member != 0:
            b.member = v.member
        if v.must[x]:
            must = must or b.must
        out = unite(out, b, live, live)
    out.must = must and out.live
    for x in v.dead:
        b := binding(x)
        out.dead = out.dead or objects(b.live or b.dead)
        out.killer = max(out.killer, b.killer)
        if not empty(objects(b.live)):
            out.killer = mem.ops[mem.here].pos
    if blank(out):
        out = number(0)
    elif v.live[NOWHERE]:
        out.live = out.live or bit(NOWHERE)
    out.writer = v.writer
    return out

# a pointer into the stack that this function returns, or gives to a thread that may outlive it
func escape(v: Target, pos: i64, returned: bool):
    if v.slot == 0:
        return
    if returned:
        warn(STACK, pos, "", 0, false)
        return
    shown := mem.fn.shown
    text: &str = heap("")
    if v.slot == ALL:
        text += "a pointer into the stack of " + shown + " cannot leave " + shown
    else:
        name := mem.fn.names[mem.fn.slots[v.slot - 1]]
        if name.len > 0:
            text += "a pointer to " + name + " cannot leave " + shown + ", " + name + " lives on its stack"
        else:
            text += "a pointer into the stack of " + shown + " cannot leave " + shown
    warn(view(text), pos, "", 0, false)

# temporaries that a thread may still use after this releases them
func outlived(released: Set, at: i64, note: &strview):
    running: Set
    for h in mem.fn.heaps and mem.marks.live:
        running[h] = mem.fn.objs[h].thread and (at != 0 or mem.fn.objs[h].alone)
    if empty(running):
        return
    for h in reach(Target{live = running}, FromValue) and released:
        if not mem.fn.objs[h].pool and mem.fn.objs[h].born != NONE:
            text: &str = heap("")
            text += "a thread may still use this temporary when "
            if at != 0:
                text += "its with scratch() releases it: wait for the thread inside it, or give it a &str"
            else:
                text += "the with scratch() of a caller releases it: give the thread a &str"
            warn(view(text), mem.fn.objs[h].pos, note, at, false)
    for h in released:
        if mem.fn.objs[h].sent != 0 and at != 0:
            warn("the thread that receives this temporary may still use it when its with scratch() releases it: wait for that thread inside it, or send a &str", mem.fn.objs[h].sent, note, at, false)

func leaving(v: Target, pos: i64):
    escape(v, pos, false)
    carried := reach(v, FromValue)
    for id in mem.present:
        owner := i64(mem.fn.cells[id].owner)
        if mem.ticked[id] == mem.tick and owner < SLOTS and carried[owner]:
            escape(cell_value(id), pos, false)

func reach(given: Target, how: Reach) -> Set:
    seen := followed(given, how)
    for id in mem.present:
        if mem.ticked[id] == mem.tick:
            owner := i64(mem.fn.cells[id].owner)
            root := owner == RETURNED or owner == OUTSIDE or owner < SLOTS and mem.fn.outer[owner]
            if how == FromGlobals:
                root = owner == OUTSIDE or owner < SLOTS and mem.fn.outer[owner] and mem.fn.objs[owner].root == 0
            elif how == FromValue:
                root = false
            if root:
                seen = seen or followed(cell_value(id), how)
    seen = seen and mem.fn.heaps
    grew := not empty(seen)
    while grew:
        grew = false
        for id in mem.present:
            owner := i64(mem.fn.cells[id].owner)
            if mem.ticked[id] == mem.tick and owner < SLOTS and seen[owner]:
                more := (followed(cell_value(id), how) and mem.fn.heaps) - seen
                if not empty(more):
                    seen = seen or more
                    grew = true
    return seen

func followed(v: Target, how: Reach) -> Set:
    switch how:
    case ByMust:
        return v.must
    case ByAny:
        return v.live or v.dead
    case:
        return v.live

func warn(text: &strview, at: i64, note: &strview, also: i64, strict: bool):
    append(mem.fn.found, Warning{text, at, note, also, strict})

func alive(m: Marks) -> Set:
    return m.live or not (mem.fn.heaps or m.gone)

func objects(x: Set) -> Set:
    x[NOWHERE] = false
    return x

func single(x: Set) -> bool:
    return count(x) == 1

func bit(o: i64) -> Set:
    out: Set
    out[o] = true
    return out

