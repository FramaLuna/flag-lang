                                    given := emptied(mem.fns[g].places[mem.fns[g].params[arena.root - 1]])
                                    if given.len > 0:
                                        homeless = ", it may have no memory to grow in: give it " + given
                        far := ob.depth > HOPS # it stands for all that it reaches, some of it off the heap
                        if marks.freed[x] and why.len > 0 and not far:
                            refuse(who, name, why, b, mem.fns[g].strict)
                        elif marks.killed[x] and offheap(b) and not far:
                            immovable(who, name, ", it is not on the heap", mem.fns[g].strict)
                        elif homeless.len > 0:
                            immovable(who, name, homeless, mem.fns[g].strict)
                        elif marks.used[x]:
