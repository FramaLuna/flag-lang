@trust
use bits

ANY = -1
NONE = -1
FULL = 0xffff_ffff_ffff_ffff
EVERY = 1 # the layout where any word may hold a pointer, after 0 where none does
ALL = 0xffff_ffff
DROPPED = 1 << 31
AGED = 1 << 63
POOLED = 1 << 62

EXACT = 4096
FAR = 1 << 30
RUN = 1 << 18
HOPS = 3
VISITS = 30
ROUNDS = 20

SLOTS = 512
FNVBASIS = 0xcbf2_9ce4_8422_2325
FNVPRIME = 0x100_0000_01b3

NOWHERE = 0
OUTSIDE = 1
STATIC = 2
GONE = 3
RETURNED = 4

PARAM = 1
FIELD = 2
SHARED = 3
SITE = 4
GLOBAL = 5
RECURSIVE = 6
FIXED = 7
PLACE = 8
BLOCKS = 9
COPY = 10
ENDED = 11
FOCUS = 12
VISITED = 13
ROUND = 14
HELD = 15
NOW = 16
MEMBERS = 1 << 14

UNSETTLED = "its memory use does not settle"
UNFOLLOWED = "-memory cannot follow a pointer once it is stored in memory that C gave"

type enum Code:
    Alloc, Load, Word, Store, Clear, Blit, Offset, Count, Scale, Mix, Plain, Call, Locks, Unlocks, Fresh, Arena, Rewind, Take, Reclaim, Grow, Resize, Release, Discard, Launch, Reap, Detach, Settle, Give, Taken, Copy, Fill, Absent, Ended, Round, Walked, Narrowed, Parse, Stop, Extern, Goto, Fork, Leave, Halt

type enum Kind:
    Pinned, Heap, Entry, Shared, Slot, Focus

type Operand:
    n: i64
    temp: u32
    data: u32

type Op:
    pos: i64
    shape: u32 # the layout of what it copies
    a: Operand
    b: Operand
    to: u32
    first: u32
    count: u32
    callee: u32
    slot: u32
    size: u32
    from: u32
    upto: u32
    member: u32
    code: Code
    blob: bool
    named: bool
    ghost: bool
    atomic: bool

type Span:
    first: u32
    end: u32
    yes: u32
    no: u32

type Set = Bits[8]

type enum Reach:
    ByLive, ByMust, ByAny, FromGlobals, FromValue

type Target:
    live: Set
    dead: Set
    must: Set
    off: i32
    stride: i32
    count: u32
    slot: u32
    member: u32
    writer: u32
    killer: i64
    element: bool

type Cell:
    owner: u32
    next: u32
    off: i32
    stride: i32
    count: u32
    member: u32

type Obj:
    key: u64
    pos: i64
    sent: i64
    name: &strview = ""
    from: &strview = ""
    parent: i64
    root: i64
    site: i64
    depth: u32
    off: i32
    stride: i32
    count: u32
    member: u32
    born: i64
    home: u32
    kind: Kind
    many: bool
    strict: bool
    arena: bool
    pool: bool
    loose: bool
    element: bool
    thread: bool
    alone: bool
    core: bool # in a context of core
    shape: u32 # the layout of the element of a round

type Marks:
    live: Set
    freed: Set
    killed: Set
    sure: Set
    gone: Set
    used: Set
    made: Set
    waited: Set

# the threads at a point: the blocks of the ones that may run, the walks in whose round each was started, an object for each pair, the locks taken, each an object of its own, and the threads of the callers waited on every path
type Runs:
    running: Set
    now: Set
    locks: Set
    joined: Set

# memory that a function reads or writes, that another thread may use at the same time
type Touch:
    owner: u32
    off: i32
    stride: i32
    count: u32
    size: u32
    locks: Set
    after: Set # the threads waited before it
    wrote: bool

# what a thread touches, by the block that stands for it, or the function itself with block NONE
type Footprint:
    block: i64
    at: i64
    touch: Touch

type State:
    ids: &list[u32] = heap([])
    vals: &list[u32] = heap([])
    temps: &list[u32] = heap([])
    marks: Marks
    runs: Runs
    seen: bool

type Summary:
    ids: &list[u32] = heap([])
    aims: &list[Target] = heap([])
    marks: Marks
    seen: bool

type Write:
    value: Target
    id: i64
    strong: bool

type Warning:
    text: &strview
    at: i64
    note: &strview
    also: i64
    strict: bool

type Fn:
    name: &strview = ""
    shown: &strview = ""
    params: &list[u32] = heap([])
    copies: &list[bool] = heap([])
    spans: &list[Span] = heap([])
    names: &list[&strview] = heap([])
    variables: &list[bool] = heap([]) # a temp that is a variable keeps its name, a slot of temporaries takes the name of what it holds
    places: &list[i64] = heap([])
    cross: &list[bool] = heap([])
    last: &list[u32] = heap([])
    crossing: &list[u32] = heap([])
    calls: &list[i64] = heap([])
    swaps: &list[u32] = heap([])
    slots: &list[u32] = heap([])
    alive: &list[u64] = heap([])
    keys: &list[u64] = heap([])
    objs: &list[Obj] = heap([])
    cells: &list[Cell] = heap([])
    heads: &list[u32] = heap([])
    found: &list[Warning] = heap([])
    touches: &list[Footprint] = heap([]) # of the memory its callers see, and of the threads it leaves running
    sum: Summary
    ret: Target
    heaps: Set
    outer: Set
    roots: Set
    many: Set
    far: Set
    focus: Set # the element of a round of a walk, and the ones it visited
    walks: bool # it has one of those
    arenas: Set
    relevant: Set
    global: Set
    size: i64
    at: i64
    order: i64
    low: i64
    group: i64
    strict: bool
    blob: bool
    settles: bool
    stacked: bool
    dirty: bool
    done: bool
    deep: bool # it changes memory past HOPS pointers, which its callers don't follow
    guarded: bool # of core, it copies a view of the memory it grows before it reads it, as the += of text does
    stuck: &strview = ""
    stuck_in: i64
    runs: i64
    node: i64
    inst: i64

context mem:
    pinned: Set
    fns: &list[Fn] = heap([])
    ids: &map[&strview, i64] = heap({})
    shared: &map[&strview, u32] = heap({})
    globals: &list[&strview] = heap([])
    apart: &list[i64] = heap([]) # per global, the type of a context of the program that a thread of parallel starts with its own of
    local: &list[bool] = heap([]) # per global, a context that no other thread sees, or that the runtime of core keeps in order
    core: &list[bool] = heap([]) # per global, a context of core
    layouts: &list[&list[u64]] = heap([]) # a bit for each word that holds a pointer
    shaped: &map[i64, u32] = heap({}) # the layout of a type, and of the owners in it
    threaded: bool # the program starts threads
    footprints: &list[Footprint] = heap([]) # of the threads this function starts, and of those that its calls leave running
    starting: &list[Touch] = heap([]) # what the thread that the next launch starts touches
    passed: &list[Touch] = heap([])
    touched: &map[Touch, bool] = heap({})
    callees: &list[&strview] = heap([])
    ops: &list[Op] = heap([])
    args: &list[Operand] = heap([])
    f: i64
    fn: Fn
    here: u32
    words: i64
    viewed: bool
    temps: &list[Target] = heap([])
    active: &list[u32] = heap([])
    cur: &list[Target] = heap([])
    fresh: &list[u32] = heap([])
    ticked: &list[u32] = heap([])
    present: &list[u32] = heap([])
    known: &list[u32] = heap([])
    pool: &list[Target] = heap([])
    pooled: &map[Target, u32] = heap({})
    refs: &list[&list[u32]] = heap([])
    swept: &list[u64] = heap([])
    interned: &list[u32] = heap([])
    renamed: &list[u32] = heap([])
    ages: u32
    tick: u32
    marks: Marks
    runs: Runs
    seen: bool
    ins: &list[State] = heap([])
    held: &list[u64] = heap([])
    pointed: &list[u64] = heap([]) # the slots that a cell holds a pointer into, by bit
    rounding: bool # this function has the element of a round in place
    exit: State
    ret: Target
    final: bool
    speak: bool
    condemned: Set
    strong: Set
    released: Set # what a free condemned, not a move
    callee: i64
    call: u32
    who: &strview = ""
    binds: &list[Target] = heap([])
    bound: Set
    writes: &list[Write] = heap([])
    order: &list[u64] = heap([])
    warnings: &list[Warning] = heap([])
    said: &map[&strview, bool] = heap({})
    index: &map[u64, u32] = heap({})
    counter: i64
    stack: &list[i64] = heap([])

operator <(a: Warning, b: Warning) -> bool:
    return a.at < b.at

func check_memory():
    mem.pinned = bit(NOWHERE) or bit(OUTSIDE) or bit(STATIC)
    append(mem.layouts, heap([]))
    append(mem.layouts, heap([FULL]))
    labels: &map[u32, u32] = heap({})
    defer free(labels)
    blocks: &list[u32] = heap([])
    defer free(blocks)
    born: &list[u32] = heap([])
    defer free(born)
    derived: &list[u32] = heap([])
    defer free(derived)
    aims: &list[&strview] = heap([])
    defer free(aims)
    for func in comp.procs:
        clear(labels)
        blocks.len = 0
        f: Fn
        f.name = func.name
        f.shown = func.name[1:]
        f.blob = func.cls >= AGG
        f.node = func.node
        f.inst = func.inst
        if func.node != 0:
            f.shown = text(func.node)
            if comp.tokens[comp.nodes[func.node].tok].kind != Name:
                quoted: &str = heap("'")
                quoted += text(func.node) + "'"
                f.shown = view(quoted)
        for k in func.temps..func.last + 2:
            append(f.names, "")
            append(f.variables, false)
        for k in func.params..func.params + func.count:
            p := comp.passes[k]
            t := u32(p.arg.n) + 1 - func.temps
            if p.cls != L and p.cls < AGG or p.number:
                t = 0
            append(f.params, t)
            append(f.copies, p.cls >= AGG)
        for k in func.mentions..func.mentioned:
            f.names[comp.mentions[k].temp + 1 - func.temps] = comp.mentions[k].name
            f.variables[comp.mentions[k].temp + 1 - func.temps] = true
        append(f.spans, Span{first = u32(mem.ops.len)})
        for k in func.code..func.end:
            i := comp.code[k]
            if f.at == 0:
                f.at = i.pos
            if i.op == "@":
                begin(f.spans, blocks, block_of(labels, blocks, u32(i.a.n)))
                continue
            o := Op{pos = i.pos, shape = EVERY, member = i.member, ghost = i.ghost}
            if i.copy:
                o.shape = layout(i.shape, false)
            if i.to != 0:
                o.to = i.to + 1 - func.temps
                o.blob = i.cls >= AGG
            name := i.op
            if name == "call":
                o.code = Call
                o.first = u32(mem.args.len)
                for j in i.first..i.first + i.count:
                    if comp.passes[j].cls != 0:
                        append(mem.args, operand(func.temps, comp.passes[j].arg))
                o.count = u32(mem.args.len) - o.first
                if o.blob:
                    o.slot = u32(f.slots.len)
                    append(f.slots, o.to)
                if i.a.kind == Global:
                    o.callee = u32(mem.callees.len)
                    append(mem.callees, comp.globals[i.a.n])
                    append(mem.ops, o)
                    continue
                aims.len = 0
                if i.c.n != VOID and not comp.types[i.c.n].foreign: # without closures a function value is one of the functions taken as its type, each a path
                    for p in comp.procs:
                        if comp.insts[p.inst].taken_as == i.c.n:
                            append(aims, p.name)
                if aims.len == 0:
                    append(aims, "")
                join := u32(blocks.len)
                if aims.len > 1:
                    append(blocks, u32(0))
                for n, aim in aims:
                    if n + 1 < aims.len:
                        append(mem.ops, Op{pos = i.pos, code = Fork, a = Operand{n = i64(blocks.len)}, b = Operand{n = i64(blocks.len) + 1}})
                        append(blocks, u32(0))
                        append(blocks, u32(0))
                        begin(f.spans, blocks, u32(blocks.len) - 2)
                    o.callee = u32(mem.callees.len)
                    append(mem.callees, aim)
                    append(mem.ops, o)
                    if n + 1 < aims.len:
                        append(mem.ops, Op{pos = i.pos, code = Goto, a = Operand{n = i64(join)}})
                        begin(f.spans, blocks, u32(blocks.len) - 1)
                if aims.len > 1:
                    begin(f.spans, blocks, join)
                continue
            o.a = operand(func.temps, i.a)
            o.b = operand(func.temps, i.b)
            if starts_with(name, "alloc"):
                o.code = Alloc
                o.slot = u32(f.slots.len)
                append(f.slots, o.to)
            elif starts_with(name, "load") or starts_with(name, "store"):
                o.code = Clear
                if name == "loadl" and not i.number:
                    o.code = Load
                elif starts_with(name, "load"):
                    o.code = Word
                elif name == "storel" and not i.number:
                    o.code = Store
                switch items(name)[name.len - 1]:
                case 'l', 'd':
                    o.size = 8
                case 'w', 's':
                    o.size = 4
                case 'h':
                    o.size = 2
                case:
                    o.size = 1
            else:
                switch name:
                case "blit":
                    o.code = Blit
                    o.size = u32(i.c.n)
                case "absent":
                    o.code = Absent
                    o.size = u32(i.c.n)
                case "add", "copy":
                    o.code = Offset
                    o.count = i.count
                    o.from = i.first # the walk whose element of the round this is
                    if i.number:
                        o.code = Count
                case "mul":
                    o.code = Scale
                case "sub", "and", "or", "xor", "shl", "shr", "sar", "udiv", "div", "rem", "urem", "neg", "extsw", "extuw", "extsb", "extub", "extsh", "extuh":
                    o.code = Mix
                    if i.number:
                        o.code = Plain
                case "jmp":
                    o.code = Goto
                    o.a.n = i64(block_of(labels, blocks, u32(i.a.n)))
                case "jnz":
                    o.code = Fork
                    o.a.n = i64(block_of(labels, blocks, u32(i.b.n)))
                    o.b.n = i64(block_of(labels, blocks, u32(i.c.n)))
                case "ret":
                    o.code = Leave
                    if f.blob: # the value goes back like a blit into the caller's place
                        t := i64(func.cls) - AGG
                        if func.cls >= CAGG:
                            t = i64(func.cls) - CAGG
                        o.size = u32(comp.types[t].size)
                        o.shape = layout(t, false)
                case "hlt":
                    o.code = Halt
                case "ended":
                    o.code = Ended
                case "round":
                    o.code = Round
                    o.size = u32(i.c.n)
                case "walked":
                    o.code = Walked
                    o.size = u32(i.c.n)
                case "narrowed":
                    o.code = Narrowed
                case "aload", "aadd", "aswap", "acas": # each reads the word at a, then swap writes b there and acas c, as if it always did
                    o.code = Word
                    o.atomic = true
                    if i.cls == L and not i.number:
                        o.code = Load
                    if o.code == Load and name != "aload":
                        append(mem.ops, o)
                        o = Op{pos = i.pos, shape = EVERY, code = Store, a = operand(func.temps, i.b), b = o.a, atomic = true}
                        if name == "acas":
                            o.a = operand(func.temps, i.c)
                case "astorel", "astorew":
                    o.code = Clear
                    o.atomic = true
                    if name == "astorel" and not i.number:
                        o.code = Store
                case:
                    o.code = Plain
            append(mem.ops, o)
        f.spans[-1].end = u32(mem.ops.len)
        f.size = mem.ops.len - f.spans[0].first
        born.len = 0
        derived.len = 0
        for t in 0..f.names.len:
            append(born, u32(0))
            append(derived, u32(0))
            append(f.cross, false)
            append(f.last, u32(0))
        for t in f.params:
            born[t] = 1
            f.cross[t] = t != 0
        for s in 0..f.spans.len:
            span := f.spans[s]
            if span.end > span.first:
                last := mem.ops[span.end - 1]
                if last.code == Goto:
                    f.spans[s].yes = blocks[last.a.n] + 1
                elif last.code == Fork:
                    f.spans[s].yes = blocks[last.a.n] + 1
                    f.spans[s].no = blocks[last.b.n] + 1
                elif last.code != Leave and last.code != Halt and s + 1 < f.spans.len:
                    f.spans[s].yes = u32(s + 2)
            elif s + 1 < f.spans.len:
                f.spans[s].yes = u32(s + 2)
            for k in span.first..span.end:
                o := mem.ops[k]
                if o.to != 0:
                    born[o.to] = u32(s + 1)
                if o.code == Alloc or o.code == Call and o.blob:
                    derived[o.to] = o.slot + 1
                elif o.code == Offset and o.b.temp == 0 and o.b.data == 0:
                    derived[o.to] = derived[o.a.temp]
        words := (f.slots.len + 63) / 64
        for k in 0..f.spans.len * words:
            append(f.alive, u64(0))
        for s in 0..f.spans.len:
            for k in f.spans[s].first..f.spans[s].end:
                o := mem.ops[k]
                count := 2
                if o.code == Call:
                    count = 2 + i64(o.count)
                for m in 0..count:
                    t := o.a.temp
                    if m == 1:
                        t = o.b.temp
                    elif m > 1:
                        t = mem.args[o.first + m - 2].temp
                    if t != 0 and born[t] != u32(s + 1):
                        f.cross[t] = true
                    f.last[t] = u32(k)
                    if derived[t] != 0:
                        d := i64(derived[t] - 1)
                        f.alive[s * words + d / 64] = f.alive[s * words + d / 64] or (u64(1) << u64(d % 64))
        grew := true
        while grew:
            grew = false
            s := f.spans.len
            while s > 0:
                s -= 1
                for side in 0..2:
                    next := f.spans[s].yes
                    if side == 1:
                        next = f.spans[s].no
                    if next != 0:
                        for w in 0..words:
                            x := f.alive[s * words + w] or f.alive[(next - 1) * words + w]
                            if x != f.alive[s * words + w]:
                                f.alive[s * words + w] = x
                                grew = true
        for t in 0..f.names.len:
            if f.cross[t] and derived[t] != 0:
                f.cross[t] = false
            if f.cross[t]:
                append(f.crossing, u32(t))
        put(mem.ids, f.name, mem.fns.len)
        append(mem.fns, f)
    exact: &list[bool] = heap([]) # the name is the path the program wrote, not an element of it
    defer free(exact)
    for g in 0..mem.fns.len:
        spans := mem.fns[g].spans
        proc := comp.procs[g]
        places := mem.fns[g].places
        exact.len = 0
        for t in mem.fns[g].names:
            append(places, VOID)
            append(exact, false)
        for m in comp.mentions[proc.mentions:proc.mentioned]:
            t := m.temp + 1 - proc.temps
            exact[t] = true
            places[t] = m.type # what the slot of a variable holds
            if not aggregate(m.type) and not contains(mem.fns[g].slots, t):
                places[t] = pointee(m.type)
        mem.fns[g].places = places
        decl := mem.fns[g].node
        if decl != 0 and file_of(comp.tokens[comp.nodes[decl].tok].at) == 0 and (text(decl) == "+=" or text(decl) == "=" or text(decl) == "append") and params(decl) > 1:
            view := kid(decl, 1) + 1 # the type of the second parameter, a &strview or a &listview
            mem.fns[g].guarded = comp.nodes[view].kind == TUnary and text(view) == "&" and (text(view + 1) == "strview" or text(view + 1) == "listview")
        for k in spans[0].first..spans[-1].end:
            if mem.ops[k].code == Call:
                name := mem.callees[mem.ops[k].callee]
                found := mem.ids[name]
                if found is i64:
                    node := mem.fns[found].node
                    called := token_at(mem.ops[k].pos)
                    mem.ops[k].named = node != 0 and comp.tokens[called].text == text(node) and comp.tokens[called + 1].text == "(" # a for or a with calls the operator of its word without naming it
                    core := node != 0 and file_of(comp.tokens[comp.nodes[node].tok].at) == 0
                    closed: &strview = "" # the type that a with of core closes
                    if core and text(node) == "with" and comp.passes[comp.procs[found].params].cls >= AGG:
                        closed = comp.types[comp.passes[comp.procs[found].params].cls - AGG].name
                    if core and text(node) == "tmp" and comp.types[comp.insts[mem.fns[found].inst].ret].kind == Ptr:
                        mem.ops[k].code = Arena
                    elif core and text(node) == "detach":
                        mem.ops[k].code = Detach
                    elif core and text(node) == "launch":
                        mem.ops[k].code = Launch
                        mem.threaded = true
                    elif core and text(node) == "reap":
                        mem.ops[k].code = Reap
                    elif core and text(node) == "settle":
                        mem.ops[k].code = Settle
                        mem.fns[g].settles = true
                    elif core and text(node) == "send":
                        inst := comp.insts[mem.fns[found].inst]
                        for b in comp.inst_binds[inst.binds:inst.binds + inst.count]:
                            if b.name == "$T":
                                mem.ops[k].shape = layout(b.type, true)
                                if aggregate(b.type):
                                    mem.ops[k].size = u32(comp.types[b.type].size)
                        mem.ops[k].code = Give # what the value points to goes to the thread that receives it
                    elif closed == "Scratch":
                        mem.ops[k].code = Rewind
                        d := k
                        while d > spans[0].first and mem.ops[d].to != mem.args[mem.ops[k].first].temp:
                            d -= 1
                        mem.ops[k].from = u32(d)
                    elif core and text(node) == "take":
                        mem.ops[k].code = Take
                        mem.ops[k].callee = u32(found + 1)
                    elif core and text(node) == "resize":
                        mem.ops[k].code = Resize
                    elif core and text(node) == "discard":
                        mem.ops[k].code = Discard
                    elif core and text(node) == "reclaim":
                        mem.ops[k].code = Reclaim
                    else:
                        if core and (text(node) == "lock" or text(node) == "try_lock"): # a try_lock that fails holds nothing, and core touches nothing of the lock then
                            mem.ops[k].code = Locks
                        elif closed == "Locked":
                            mem.ops[k].code = Unlocks
                        mem.ops[k].callee = u32(found + 1)
                        if not contains(mem.fns[g].calls, found):
                            append(mem.fns[g].calls, found)
                else:
                    code: Code = Extern
                    switch name:
                    case "$malloc", "$calloc", "$realpath":
                        code = Fresh
                    case "$realloc":
                        code = Grow
                    case "$free":
                        code = Release
                    case "$memcpy", "$memmove":
                        code = Copy
                    case "$memset":
                        code = Fill
                    case "$pthread_mutex_lock", "$AcquireSRWLockExclusive":
                        code = Taken
                    case "$strtod":
                        code = Parse
                    case "$exit", "$_exit":
                        code = Stop
                    mem.ops[k].code = code
            o := mem.ops[k]
            if o.code == Store and o.a.temp != 0 and places[o.a.temp] == VOID:
                places[o.a.temp] = pointee(places[o.b.temp]) # a value has the type of the variable it goes to, like a parameter
                if contains(mem.fns[g].params, o.a.temp) and mem.fns[g].variables[o.b.temp]:
                    mem.fns[g].names[o.a.temp] = mem.fns[g].names[o.b.temp]
            heir := o.to
            from := o.a.temp
            if o.code == Blit:
                heir = o.b.temp
            elif o.code == Call and not o.named and o.count > 0:
                from = mem.args[o.first].temp
            elif o.code != Load and o.code != Offset and o.code != Mix:
                heir = 0
            if heir != 0 and (mem.fns[g].names[heir].len == 0 or o.code == Blit and not mem.fns[g].variables[heir]):
                name := mem.fns[g].names[from]
                place := places[from]
                field := o.code == Offset and o.b.temp == 0 and o.b.data == 0
                off := 0
                if field:
                    off = o.b.n
                elif o.code == Mix or o.code == Call or o.count != 0 and comp.types[place].kind != Array:
                    place = VOID
                elif o.count != 0:
                    place = comp.types[place].elem # an element of an array, and of a list it stays the element
                exact[heir] = exact[from] and (o.code == Load or o.code == Blit or field)
                while place != VOID and comp.types[place].kind == Struct and (o.code == Load or off > 0):
                    ty := comp.types[place]
                    place = VOID
                    for item in comp.items[ty.first:ty.first + ty.count]:
                        if not item.shared and item.n <= off and off < item.n + comp.types[item.type].size:
                            if exact[heir]:
                                path: &str = heap("")
                                path += name + "." + item.name
                                name = view(path)
                            place = item.type
                            off -= item.n
                            break
                if off != 0:
                    place = VOID
                elif o.code == Load and comp.types[place].kind == Fat:
                    place = element(place)
                elif o.code == Load:
                    place = pointee(place)
                places[heir] = place
                mem.fns[g].names[heir] = name
    closes: &list[i64] = heap([])
    defer free(closes)
    for k in 0..mem.ops.len:
        if mem.ops[k].code == Rewind:
            append(closes, k)
    for k in closes:
        for j in closes:
            if mem.ops[j].from == mem.ops[k].from and u32(j) > mem.ops[k].upto:
                mem.ops[k].upto = u32(j)
    none: Target
    while mem.binds.len < SLOTS:
        append(mem.binds, none)
    for g in 0..mem.fns.len:
        for t in comp.trusted:
            if t.check and t.from <= mem.fns[g].at and mem.fns[g].at < t.to:
                mem.fns[g].strict = true
    for g in 0..mem.fns.len:
        node := mem.fns[g].node
        start := comp.tokens[comp.nodes[node].tok].at
        end := start
        for n in node..node_end(node):
            if comp.tokens[comp.nodes[n].tok].at > end:
                end = comp.tokens[comp.nodes[n].tok].at
        inner := innermost(start)
        hidden := inner.to != 0 and not inner.check
        for t in comp.trusted:
            hidden = hidden and not (t.check and t.from > start and t.from <= end)
        for c in mem.fns[g].calls:
            hidden = hidden and not mem.fns[c].strict
        if (node != 0 and not hidden or mem.fns[g].strict) and mem.fns[g].order == 0:
            connect(g)
    sort(mem.warnings)
    for w in mem.warnings:
        inner := innermost(w.at)
        hidden := inner.to != 0 and not inner.check
        if hidden and w.strict:
            low := token_at(w.at)
            while comp.tokens[low].kind != Line:
                low -= 1
            hidden = comp.tokens[low].at == inner.from
        if hidden:
            continue
        eprint(comp.warn, w.text)
        if w.at != 0:
            show(w.at)
        if w.also != 0:
            eprint(comp.note, w.note)
            show(w.also)

# the name of the argument t of a call to g, down to the field at its start that has the type of parameter k
func named(t: u32, g: i64, k: i64) -> &strview:
    name := mem.fn.names[t]
    place := mem.fn.places[t]
    want := mem.fns[g].places[mem.fns[g].params[k]]
    while want != VOID and place != want and place != VOID and comp.types[place].kind == Struct:
        ty := comp.types[place]
        place = VOID
        for item in comp.items[ty.first:ty.first + ty.count]:
            if item.n == 0 and not item.shared and comp.types[item.type].size > 0:
                path: &str = heap("")
                path += name + "." + item.name
                name = view(path)
                place = item.type
                break
    if place != want:
        return mem.fn.names[t]
    return name

func pointee(t: i64) -> i64:
    if comp.types[t].kind == Ptr:
        return comp.types[t].elem
    return VOID

func innermost(at: i64) -> Trust:
    found: Trust
    for t in comp.trusted:
        if t.from <= at and at < t.to and t.from >= found.from:
            found = t
    return found

func block_of(labels: *&map[u32, u32], blocks: *&list[u32], name: u32) -> u32:
    found := labels[name]
    if found is u32:
        return found
    put(labels, name, u32(blocks.len))
    append(blocks, u32(0))
    return u32(blocks.len - 1)

func begin(spans: *&list[Span], blocks: *&list[u32], block: u32):
    spans[-1].end = u32(mem.ops.len)
    blocks[block] = u32(spans.len)
    append(spans, Span{first = u32(mem.ops.len)})

func operand(first: u32, a: Arg) -> Operand:
    out: Operand
    if a.kind == Temp:
        out.temp = u32(a.n) + 1 - first
    elif a.kind == Global and (starts_with(comp.globals[a.n], "thread $ctx.") or starts_with(comp.globals[a.n], "$ctx.")):
        text := comp.globals[a.n]
        found := mem.shared[text]
        if found is u32:
            out.data = found + 2
        else:
            out.data = u32(mem.globals.len) + 2
            put(mem.shared, text, u32(mem.globals.len))
            append(mem.globals, text)
            t := comp.type_ids[text[trust find(text, "$ctx.") + "$ctx.".len:]] ifnull VOID
            core := t != VOID and file_of(comp.tokens[comp.nodes[comp.types[t].decl].tok].at) == 0
            mine := t != VOID and starts_with(text, "thread ") and declared(comp.types[t].decl) != "inherited"
            append(mem.local, core or mine)
            append(mem.core, core)
            if core or not starts_with(text, "thread "):
                t = VOID
            append(mem.apart, t)
    elif a.kind == Global:
        out.data = 1
    elif a.kind == Const:
        out.n = a.n
    return out

func connect(v: i64):
    mem.counter += 1
    mem.fns[v].order = mem.counter
    mem.fns[v].low = mem.counter
    append(mem.stack, v)
    mem.fns[v].stacked = true
    for w in mem.fns[v].calls:
        if mem.fns[w].order == 0:
            connect(w)
            if mem.fns[w].low < mem.fns[v].low:
                mem.fns[v].low = mem.fns[w].low
        elif mem.fns[w].stacked and mem.fns[w].order < mem.fns[v].low:
            mem.fns[v].low = mem.fns[w].order
    if mem.fns[v].low != mem.fns[v].order:
        return
    members: &list[i64] = heap([])
    defer free(members)
    while true:
        w := trust pop(mem.stack)
        mem.fns[w].stacked = false
        mem.fns[w].group = v + 1
        append(members, w)
        if w == v:
            break
    if members.len > 1 or contains(mem.fns[v].calls, v):
        for f in members:
            mem.fns[f].dirty = true
        budget := members.len * ROUNDS
        while budget > 0:
            picked := members.len
            for k in 0..members.len:
                if mem.fns[members[k]].dirty and (picked == members.len or mem.fns[members[k]].size < mem.fns[members[picked]].size):
                    picked = k
            if picked == members.len:
                break
            f := members[picked]
            mem.fns[f].dirty = false
            budget -= 1
            if analyze(f):
                for m in members:
                    if contains(mem.fns[m].calls, f):
                        mem.fns[m].dirty = true
    settled := true
    for f in members:
        settled = settled and not mem.fns[f].dirty and mem.fns[f].runs > 0
    for f in members:
        if mem.fns[f].dirty:
            mem.fns[f].stuck = UNSETTLED
        if not settled:
            analyze(f)
    for f in members:
        if mem.fns[f].stuck_in != 0:
            for m in members:
                mem.fns[m].stuck_in = mem.fns[f].stuck_in
            break
    for f in members:
        for w in mem.fns[f].found:
            key: &str = heap("")
            key += w.text + " " + w.at
            if contains(mem.said, view(key)):
                free(key)
            else:
                put(mem.said, view(key), true)
                append(mem.warnings, w)
        free(mem.fns[f].found)

func analyze(f: i64) -> bool:
    mem.f = f
    mem.fn = mem.fns[f]
    mem.fn.runs += 1
    mem.fn.found.len = 0
    mem.fn.touches = heap([])
    clear(mem.touched)
    mem.footprints.len = 0
    mem.starting.len = 0
    mem.words = (mem.fn.slots.len + 63) / 64
    mem.rounding = false
    mem.pointed.len = 0
    for w in 0..mem.words:
        append(mem.pointed, u64(0))
    clear(mem.index)
    for k in 0..mem.fn.keys.len:
        mem.index[mem.fn.keys[k]] = u32(k)
    mem.viewed = false
    for c in mem.fn.cells:
        mem.viewed = mem.viewed or c.member != 0
    if mem.fn.objs.len == 0:
        mem.fn.keys = malloc(SLOTS * @sizeof(u64))
        mem.fn.keys.cap = SLOTS
        mem.fn.objs = malloc(SLOTS * @sizeof(Obj))
        mem.fn.objs.cap = SLOTS
        for k in 0..=RETURNED:
            kind: Kind = Pinned
            if k == RETURNED:
                kind = Slot
            object((u64(k) << 8) or FIXED, Obj{kind = kind})
        for k in 0..SLOTS + mem.fn.slots.len:
            append(mem.fn.heads, u32(0))
    blank: Target
    grow_cells()
    mem.pool.len = 0
    clear(mem.pooled)
    while mem.refs.len < SLOTS:
        nothing: &list[u32] = heap([])
        append(mem.refs, nothing)
        append(mem.swept, u64(0))
    for k in 0..SLOTS:
        mem.refs[k].len = 0
    while mem.temps.len < mem.fn.names.len:
        append(mem.temps, blank)
        append(mem.interned, u32(0))
    for t in 0..mem.fn.names.len:
        mem.temps[t] = blank
        mem.interned[t] = 0
    params := mem.fn.params
    for k in 0..params.len:
        if params[k] != 0:
            e := object((u64(k) << 8) or PARAM, Obj{kind = Entry, root = k + 1, name = mem.fn.names[params[k]]})
            mem.temps[params[k]] = Target{live = bit(e), must = bit(e)}
    spans := mem.fn.spans
    none: State
    queued: &list[bool] = heap([])
    defer free(queued)
    for b in 0..spans.len:
        append(mem.ins, none)
        append(queued, false)
    mem.ins[0].seen = true
    for t in mem.fn.crossing:
        append(mem.ins[0].temps, intern(mem.temps[t]))
    queued[0] = true
    low := 0
    visits := 0
    while true:
        while low < spans.len and not queued[low]:
            low += 1
        if low == spans.len:
            break
        b := low
        queued[b] = false
        visits += 1
        if visits > spans.len * VISITS + 100:
            mem.fn.stuck = UNSETTLED
            break
        visit(b)
        if mem.seen:
            out := snapshot()
            mem.held.len = 0
            for w in 0..mem.words:
                append(mem.held, u64(0))
            for v in out.vals:
                hold(mem.pool[v].slot)
            for v in out.temps:
                hold(mem.pool[v].slot)
            for side in 0..2:
                s := spans[b].yes
                if side == 1:
                    s = spans[b].no
                if s != 0:
                    old := mem.ins[s - 1]
                    joined := merge(old, out, s - 1)
                    if old.seen and joined == old:
                        release(joined)
                    else:
                        release(old)
                        mem.ins[s - 1] = joined
                        queued[s - 1] = true
                        if s - 1 < low:
                            low = s - 1
            release(out)
    mem.final = true
    mem.speak = true
    release(mem.exit)
    mem.exit = none
    mem.ret = blank
    for b in 0..spans.len:
        if mem.ins[b].seen:
            visit(b)
    if mem.speak and mem.fn.stuck.len > 0:
        at := 0
        if mem.fn.node != 0:
            at = comp.tokens[comp.nodes[mem.fn.node].tok].at
        for k in spans[0].first..spans[-1].end:
            if at == 0:
                at = mem.ops[k].pos
        text: &str = heap("")
        text += "-memory gives up on " + mem.fn.shown + ", " + mem.fn.stuck + ", so its checks are incomplete"
        warn(view(text), at, "", 0, false)
        mem.fn.stuck_in = mem.f + 1
    mem.final = false
    mem.speak = false
    for b in 0..spans.len:
        release(mem.ins[b])
    mem.ins.len = 0
    sum: Summary
    ret: Target
    relevant: Set
    global: Set
    mem.fn.deep = false
    if mem.exit.seen:
        restore(mem.exit)
        escaping := reach(mem.ret, ByLive)
        global = reach(blank, FromGlobals)
        sum.seen = true
        for k in 0..mem.exit.ids.len:
            id := mem.exit.ids[k]
            c := mem.fn.cells[id]
            owner := i64(c.owner)
            if owner >= SLOTS or not (owner == RETURNED or owner == OUTSIDE or mem.fn.outer[owner] or escaping[owner]):
                continue
            v := mem.pool[mem.exit.vals[k]]
            if mem.fn.outer[owner] and v == initial(owner, c.off, c.stride, c.count, c.member) and empty(v.live and (mem.exit.marks.killed or mem.exit.marks.made)):
                continue
            if mem.fn.far[owner]:
                mem.fn.deep = mem.fn.deep or not mem.fn.objs[owner].core and (v.slot != 0 or not empty(objects(v.live or v.dead) - bit(owner))) # it is all that it reaches, itself included
                continue
            if v.slot != 0:
                v.slot = 0
                v.dead = v.dead or bit(GONE)
            append(sum.ids, id)
            append(sum.aims, v)
            relevant = relevant or v.live or v.dead
        ret = mem.ret
        if ret.slot != 0:
            ret.slot = 0
            ret.dead = ret.dead or bit(GONE)
        relevant = relevant or mem.fn.outer or escaping or ret.live or ret.dead
        m := mem.exit.marks # past HOPS pointers a block tells its callers only what it frees, and they say that they don't follow the rest
        for x in (m.made or m.killed - m.freed) and relevant and mem.fn.far:
            mem.fn.deep = mem.fn.deep or not mem.fn.objs[x].core
        running := mem.exit.runs.running and m.live
        for h in running:
            if mem.fn.objs[h].alone or relevant[h]: # a thread that runs alone, or that the callers get, runs on in them
                relevant[h] = true
                for p in mem.footprints:
                    if p.block == newest(h):
                        append(mem.fn.touches, Footprint{h, p.at, p.touch})
        sum.marks = Marks{m.live and relevant, m.freed and relevant, m.killed and relevant - (mem.fn.far - m.freed), m.sure and relevant, m.gone and relevant, m.used and relevant, m.made and relevant - mem.fn.far, m.waited and relevant}
        global = global and mem.fn.heaps
    old := mem.fns[f]
    changed := true
    if old.done:
        past := pack(old.sum)
        fresh := pack(sum)
        joined := merge(past, fresh, NONE)
        unknown := (mem.fn.heaps or mem.fn.outer) - (old.heaps or old.outer)
        joined.marks.sure = joined.marks.sure or sum.marks.sure and unknown
        joined.marks.gone = joined.marks.gone or sum.marks.gone and unknown
        ret = unite(old.ret, ret, alive(old.sum.marks), alive(sum.marks))
        relevant = relevant or old.relevant
        global = global or old.global
        changed = joined != past or ret != old.ret or relevant != old.relevant or global != old.global or mem.fn.touches.len != old.touches.len
        release(sum)
        sum = Summary{marks = joined.marks, seen = joined.seen}
        for k in 0..joined.ids.len:
            append(sum.ids, joined.ids[k])
            append(sum.aims, mem.pool[joined.vals[k]])
        release(past)
        release(fresh)
        release(joined)
    release(old.sum)
    release(mem.exit)
    mem.exit = none
    mem.fn.swaps.len = 0
    for k in 0..mem.fn.objs.len:
        append(mem.fn.swaps, u32(0))
    for k in 0..sum.ids.len:
        c := mem.fn.cells[sum.ids[k]]
        owner := i64(c.owner)
        if owner < SLOTS and mem.fn.outer[owner] and mem.fn.objs[owner].depth < HOPS:
            was := mem.index[child(owner, c.off, c.stride)]
            if was is u32 and sum.marks.killed[i64(was)]:
                fresh := objects(sum.aims[k].live) and mem.fn.heaps
                if not empty(fresh):
                    sum.marks.made[i64(was)] = true
                    sum.marks.gone[i64(was)] = false
                for x in fresh:
                    if mem.fn.swaps[x] == 0:
                        mem.fn.swaps[x] = was + 1
                        if mem.fn.objs[x].home != 0:
                            mem.fn.objs[was].home = mem.fn.objs[x].home
    mem.fn.sum = sum
    mem.fn.ret = ret
    mem.fn.relevant = relevant
    mem.fn.global = global
    mem.fn.done = true
    mem.fns[f] = mem.fn
    free(old.touches)
    return changed

func hold(slot: u32):
    if slot == ALL:
        for w in 0..mem.words:
            mem.held[w] = FULL
    elif slot != 0:
        k := i64(slot) - 1
        mem.held[k / 64] = mem.held[k / 64] or (u64(1) << u64(k % 64))

func restore(st: State):
    mem.tick += 1
    mem.present.len = 0
    for k in 0..st.ids.len:
        id := st.ids[k]
        mem.ticked[id] = mem.tick
        mem.known[id] = st.vals[k] + 1
        append(mem.present, id)
    for k in 0..st.temps.len:
        mem.temps[mem.fn.crossing[k]] = mem.pool[st.temps[k]]
        mem.interned[mem.fn.crossing[k]] = st.temps[k] + 1
    mem.marks = st.marks
    mem.runs = st.runs

func visit(block: i64):
    restore(mem.ins[block])
    mem.seen = true
    mem.active.len = 0
    span := mem.fn.spans[block]
    for i in span.first..span.end:
        if not mem.seen:
            break
        o := mem.ops[i]
        mem.here = i
        switch o.code:
        case Alloc:
            define(o.to, Target{slot = o.slot + 1})
        case Load, Word:
            address := target_of(o.a)
            touch(address, mem.fn.names[o.a.temp])
            if not o.atomic:
                access(address, false, o.size)
            r := sole(address)
            if mem.speak and address.member != 0 and r != NONE and r < SLOTS and (mem.fn.keys[r] and 0xff) == ROUND:
                written := fetch(Target{live = address.live, off = address.off}).writer
                if written != 0 and written != address.member:
                    text: &str = heap("")
                    text += mem.fn.names[o.a.temp] + " may not be " + comp.types[address.member].name + " now, the list it is in changed it after it was narrowed: test it again with is"
                    warn(view(text), o.pos, "", 0, false)
            if o.code == Word:
                define(o.to, number(ANY))
            else:
                define(o.to, fetch(address))
        case Store, Clear:
            address := target_of(o.b)
            touch(address, mem.fn.names[o.b.temp])
            if not o.atomic:
                access(address, true, o.size)
            if o.code == Store and mem.fn.names[o.a.temp].len == 0 and mem.fn.variables[o.b.temp] and (comp.types[mem.fn.places[o.b.temp]].kind == Ptr or comp.types[mem.fn.places[o.b.temp]].kind == Thread):
                christen(target_of(o.a), mem.fn.names[o.b.temp])
            elif o.code == Store and mem.fn.names[o.a.temp].len == 0 and sole(address) != NONE and address.off != ANY and address.stride == 0: # a field, like c.last = heap(...)
                christen(target_of(o.a), spelled(sole(address), address.off, 8).name)
            if o.code == Store:
                stash(address, target_of(o.a))
            else:
                stash(address, number(0))
        case Blit:
            from := target_of(o.a)
            to := target_of(o.b)
            touch(from, mem.fn.names[o.a.temp])
            touch(to, mem.fn.names[o.b.temp])
            access(from, false, o.size)
            access(to, true, o.size)
            if mem.speak:
                copied(from, mem.fn.places[o.a.temp], mem.fn.names[o.a.temp])
            if not mem.fn.variables[o.b.temp]:
                mem.fn.names[o.b.temp] = mem.fn.names[o.a.temp]
            elif mem.fn.names[o.a.temp].len == 0 and comp.types[mem.fn.places[o.b.temp]].kind == Fat:
                christen(fetch(from), mem.fn.names[o.b.temp])
            transfer(to, from, i64(o.size), o.shape)
        case Offset:
            x := target_of(o.a)
            y := target_of(o.b)
            if o.member != 0:
                x.member = o.member
            out := plus(amount(x), amount(y).off, amount(y).stride, 0)
            if pointing(x) and pointing(y):
                out = blur(x, y)
            elif pointing(y):
                out = plus(y, amount(x).off, amount(x).stride, o.count)
            elif pointing(x):
                out = plus(x, amount(y).off, amount(y).stride, o.count)
            if o.from != 0: # x[i] with the i that counts a walk is the element of its round, when x is what the round walks
                r := rounded(u64(o.from), out, o.shape, mem.fn.names[o.a.temp])
                at := placed(mem.fn.objs[r])
                if r != OUTSIDE and out.off == at.off and out.stride == at.stride and out.count == at.count and (not empty(objects(out.live) and at.live) or out.slot != 0 and out.slot == at.slot):
                    out = Target{live = bit(r), must = bit(r), dead = out.dead, killer = out.killer}
            define(o.to, out)
        case Scale:
            x := amount(target_of(o.a))
            y := amount(target_of(o.b))
            if y.off == ANY or y.stride != 0:
                y = x
                x = amount(target_of(o.b))
            n := i64(y.off)
            v := number(ANY)
            if y.off == ANY or y.stride != 0:
                v = number(ANY)
            elif n == 0:
                v = number(0)
            elif x.off != ANY and x.stride == 0 and i64(x.off) * n > 0 - FAR and i64(x.off) * n < FAR:
                v = number(i32(i64(x.off) * n))
            elif x.off != ANY and x.stride == 0 and i64(x.off) * n >= FAR:
                v = number(FAR)
            elif n > 0 and x.off != ANY and x.stride != 0 and i64(x.stride) * n <= EXACT:
                v = Target{live = bit(NOWHERE), off = i32(i64(x.off) * n), stride = i32(i64(x.stride) * n)}
            elif n > 0 and n <= EXACT:
                v = Target{live = bit(NOWHERE), stride = i32(n)}
            define(o.to, v)
        case Mix:
            define(o.to, blur(target_of(o.a), target_of(o.b)))
        case Count:
            given := target_of(o.a)
            if mem.speak and followable(given):
                name := mem.fn.names[o.a.temp]
                text: &str = heap("")
                if name.len > 0:
                    text += "-memory cannot follow " + name + " once it is stored as an integer, store it with a pointer type"
                else:
                    text += "-memory cannot follow a pointer once it is stored as an integer, store it with a pointer type"
                warn(view(text), o.pos, "", 0, false)
            define(o.to, number(ANY))
        case Plain:
            define(o.to, number(ANY))
        case Call, Locks, Unlocks:
            g := i64(o.callee) - 1
            if not mem.fns[g].done:
                define(o.to, number(ANY))
            elif not mem.fns[g].sum.seen:
                mem.seen = false
            else:
                sum := mem.fns[g].sum
                marks := sum.marks
                relevant := mem.fns[g].relevant
                heaps := mem.fns[g].heaps
                outer := mem.fns[g].outer
                mem.callee = g
                mem.call = i
                mem.who = ""
                if o.named:
                    mem.who = mem.fns[g].shown
                mem.bound = Set{}
                inner := mem.fns[g].group == mem.fn.group
                stuck := mem.fns[g].stuck_in
                if stuck != 0:
                    mem.fn.stuck_in = stuck
                if stuck != 0 and mem.speak and not inner:
                    text: &str = heap("")
                    text += "-memory gives up on " + mem.fns[stuck - 1].shown + ", " + mem.fns[stuck - 1].stuck + ", so this call is not checked"
                    warn(view(text), o.pos, "", 0, false)
                if mem.fns[g].deep and mem.speak and not inner:
                    text: &str = heap("")
                    text += "-memory gives up on " + mem.fns[g].shown + ", it changes memory more than three pointers away from its parameters, so this call is not checked"
                    warn(view(text), o.pos, "", 0, mem.fns[g].strict)
                running := mem.runs.running and mem.marks.live # the threads that run while it does
                left: Set # the threads it leaves running
                for f in mem.fns[g].touches:
                    if f.block != NONE:
                        left[f.block] = true
                recursive := NONE
                born := i64(i)
                if o.ghost:
                    born = NONE # what a thread makes is in no scratch of this one until wait takes it
                for x in relevant and heaps:
                    if not marks.live[x] and not marks.freed[x] and not marks.killed[x]:
                        continue
                    if x < mem.fns[g].swaps.len and mem.fns[g].swaps[x] != 0:
                        b := binding(i64(mem.fns[g].swaps[x]) - 1)
                        if not empty(objects(b.live)):
                            mem.binds[x] = Target{live = objects(b.live), must = b.must, off = b.off, stride = b.stride}
                            mem.bound = mem.bound or bit(x)
                            continue
                    ob := obj_of(g, x)
                    h := 0
                    replace := true
                    if mem.fns[g].global[x]:
                        h = object((u64(ob.site) << 8) or GLOBAL, Obj{kind = Heap, many = true, site = ob.site, born = born, pos = ob.pos, from = ob.from, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread, alone = ob.alone})
                        replace = false
                    elif inner and recursive != NONE:
                        h = recursive
                        replace = false
                    elif inner:
                        h = birth(RECURSIVE, Obj{kind = Heap, site = ob.site, born = born, pos = o.pos, from = mem.who, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread, alone = ob.alone})
                        recursive = h
                    else:
                        h = lodge(arena_of(ob), (u64(i) << 16) or (u64(x) << 8) or SITE, Obj{kind = Heap, many = mem.fns[g].many[x], site = ob.site, born = born, pos = o.pos, from = mem.who, sent = ob.sent, arena = ob.arena, pool = ob.pool, thread = ob.thread, alone = ob.alone})
                    mem.marks.live = carry(marks.live, x, mem.marks.live, h, replace)
                    mem.marks.freed = carry(marks.freed, x, mem.marks.freed, h, replace)
                    mem.marks.killed = carry(marks.killed, x, mem.marks.killed, h, replace)
                    mem.runs.running = carry(left, x, mem.runs.running, h, replace)
                    mem.binds[x] = Target{live = bit(h), must = bit(h)}
                    if mem.fns[g].global[x]:
                        mem.binds[x].must = Set{}
                    mem.fn.objs[h].strict = mem.fn.objs[h].strict or mem.fns[g].strict
                    mem.bound = mem.bound or bit(x)
                for x in relevant and outer:
                    binding(x)
                again := false # the lock was taken already, so its with lets go of nothing
                if o.code == Locks:
                    k := lock_of(target_of(mem.args[o.first]))
                    again = k != NONE and mem.runs.locks[k]
                    if k != NONE:
                        mem.runs.locks[k] = true
                if mem.threaded and (mem.final or o.ghost) and o.code == Call: # taking a lock and letting it go touch only the lock
                    mem.passed.len = 0
                    locks := mem.runs.locks
                    if o.ghost: # a thread holds none of the locks of the one that starts it
                        locks = Set{}
                    for f in mem.fns[g].touches:
                        if f.block == NONE:
