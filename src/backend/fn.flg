type Ref = u32 # the kind of what it names, above bit 29, and its number

type Operation:
    name: &strview
    argcls: array[i8, 10] # of the arguments 0 and 1 by the class of the instruction
    canfold: bool
    hasid: bool # has a value that changes nothing as its argument 1
    idval: bool # that value, 0 or 1
    commutes: bool
    assoc: bool
    idemp: bool
    cmpeqwl: bool # an eq or ne of words or longs
    cmplgtewl: bool # an lt, gt, le or ge of words or longs
    eqval: bool # what it gives for two equal arguments
    pinned: bool # gcm leaves it in its block
    nmem: i8 # amd64: how many arguments may be in memory
    zflag: bool # amd64: sets the zero flag by its result
    lflag: bool # amd64: leaves the flags

