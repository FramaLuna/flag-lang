    Operation{"flagiule", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagiult", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfeq", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfge", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfgt", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfle", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagflt", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfne", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfo", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfuo", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"xselieq", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseline", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselisge", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselisgt", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselisle", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselislt", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseliuge", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseliugt", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseliule", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseliult", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfeq", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfge", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfgt", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfle", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselflt", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfne", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfo", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfuo", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false}
]

type Instr:
    op: i32
    cls: i32
    to: Ref
    arg: array[Ref, 2]

type Jmp:
    type: i32
    arg: Ref

type BSet: # a set of temps, by increasing index w its words t that are not zero, and always the first one, of registers
    t: &list[u64] = heap([])
    w: &list[u32] = heap([])

type Phi:
    to: Ref
    cls: i32
    visit: i32
    arg: &list[Ref] = heap([])
    blk: &list[i64] = heap([])
    link: i64

type Blk:
    phi: i64
    ins: &list[Instr] = heap([])
    jmp: Jmp
    s1: i64
    s2: i64
    link: i64
    id: i64
    visit: i64
    idom: i64
    dom: i64
    dlink: i64
    dpre: i64
    dend: i64
    fron: &list[i64] = heap([])
    depth: i64
    odom: i64 # the closest dominator in fewer loops
    pred: &list[i64] = heap([])
    live_in: BSet
    live_out: BSet
    gen: BSet
    nlive: array[i64, 2]
    loop: i32

type Usage:
    type: i32
    bid: u32
    at: i64 # the instruction, its block << 32 or its place, or the phi

type Region: # where a temp points
    type: i32
    base: i32
    offset: i64
    symtype: i32
    sym: i32
    sz: i32 # of a slot, its bytes, or -1 past NBit
    m: u64 # of a slot, the bytes stored to
    slot: i32 # the temp whose region is the slot, 0 for none

type Tmp:
    def: i64 # the instruction that defines it: its block << 32 or its place, 0 for none
    uses: &list[Usage] = heap([])
    listed: bool # filluse gave it a list of uses, which adduse extends
    ndef: i32
    nuse: i32
    bid: u32 # its block, 0xffff_ffff for none
    cost: u32
    slot: i32
    pad: Ref # the slot that a call that returns an aggregate writes
    cls: i32
    hintr: i32 # the register it would like, -1 for none
    hintw: i32 # the loop depth of the hint
    hintm: u64 # registers to avoid
    phi: i32
    alias: Region
    width: i32
    visit: i32
    gcmbid: u32

type Con:
    type: i32
    symtype: i32
    sym: i32
    bits: i64

type Addr: # amd64 addressing
    offset: Con
    base: Ref
    index: Ref
    scale: i64

type Member:
    type: i32
    len: i64 # or the index in asm.typ of FTyp

type Typ:
    isdark: bool
    isunion: bool
    align: i64
    size: i64
    nunion: i64
    fields: &list[Member] = heap([]) # those of each union, each ended by FEnd

type Version: # the name a temp has in the blocks a block dominates
    r: Ref
    b: i64
    up: i64

type Machine:
    apple: bool
    windows: bool
    gpr0: i64 # the first general purpose register
    ngpr: i64
    fpr0: i64 # the first float register
    nfpr: i64
    rglob: u64 # registers always live, as the stack pointers
    rsave: array[i64, 43] # caller-save, then -1
    nrsave: array[i64, 2]
    retregs: func(Ref, *array[i64, 2]) -> u64
    argregs: func(Ref, *array[i64, 2]) -> u64
    memargs: bool # an instruction takes as many arguments in memory as optab says
    abi0: func()
    abi1: func()
    isel: func()
    emitfn: func()
    emitfin: func()
    asloc: &strview # how a label the assembler keeps to itself starts
    assym: &strview # how a symbol starts
    cansel: bool
    halfsave: bool # a call keeps only the low half of a v register

context fn:
    blks: &list[Blk] = heap([]) # by handle, 0 is none
    nblks: i64
    phis: &list[Phi] = heap([]) # by handle, 0 is none
    nphis: i64
    tmp: &list[Tmp] = heap([])
    ntmp: i64
    con: &list[Con] = heap([])
    conh: &list[i64] = heap([]) # the place of each constant, by a hash of it
    mem: &list[Addr] = heap([])
    versions: &list[Version] = heap([]) # 0 is none
    unused: i64 # the first version given back, 0 for none
    start: i64
    rpo: &list[i64] = heap([])
    nblk: i64
    retty: i64 # the aggregate it returns, -1 for none
    retr: Ref
    reg: u64
    slot: i64
    dynalloc: bool
    leaf: bool
    name: &strview = ""
    export: bool
    dbgmark: &list[i64] = heap([])
    out: &list[Instr] = heap([]) # what emit made, the last one runs first
    base: i64 # the first temp of the proc being lowered
    temps: &list[Ref] = heap([]) # the tmp of each of its temps
    label0: i64 # the label before its first
    labels: &list[i64] = heap([]) # the block of each of its labels
    last: i64 # the block it defined last
    con01: array[Ref, 2] # the constants 0 and 1
    gvntbl: &list[Instr] = heap([]) # the instructions gvn met, by a hash of them
    ilog: &list[Insert] = heap([]) # what loadopt inserts
    inum: i64
    thrsym: &list[i64] = heap([]) # the thread data each function reads, and the temps that hold their addresses
    thrtmp: &list[Ref] = heap([])
    thrins: &list[Instr] = heap([])

context asm:
    machine: Machine = AMD64_SYSV
    text: &str = heap("")
    typ: &list[Typ] = heap([])
    typs: &list[i64] = heap([]) # the typ of each type of the program as :t, or -1
    ctyps: &list[i64] = heap([]) # and as :c
    syms: &list[&strview] = heap([])
    sym_ids: &map[&strview, i64] = heap({})
    globals: &list[Con] = heap([]) # the constant each global of comp names
    stash: &list[u64] = heap([]) # the bits of the floats that the code reads from memory
    stash_size: &list[i64] = heap([])
    files: &list[&strview] = heap([])
    curfile: i64
    blocks: i64 # the labels the functions before took
    ops: &map[&strview, i64] = heap({}) # each instruction by its name
    lane: i64 # of the next vset, given by a vlane

func rtype(r: Ref) -> i64:
    if r == R:
        return -1
    return i64(r >> 29)

func rval(r: Ref) -> i64:
    return i64(r and 0x1fff_ffff)

func rsval(r: Ref) -> i64:
    return (rval(r) xor 0x1000_0000) - 0x1000_0000

func ref(type: i64, val: i64) -> Ref:
    return u32(type << 29 or val and 0x1fff_ffff)

func isreg(r: Ref) -> bool:
    return r != R and r < Tmp0

func isstore(o: i64) -> bool:
    return o >= Ostoreb and o <= Ostorev

func isvec(o: i64) -> bool:
    return o >= Ovaddb and o <= Ovitos

func isload(o: i64) -> bool:
    return o >= Oloadsb and o <= Oload

func isalloc(o: i64) -> bool:
    return o >= Oalloc4 and o <= Oalloc16

func isext(o: i64) -> bool:
    return o >= Oextsb and o <= Oextuw

func ispar(o: i64) -> bool:
    return o >= Opar and o <= Opare

func isarg(o: i64) -> bool:
    return o >= Oarg and o <= Oargv

func isret(j: i64) -> bool:
    return j >= Jretw and j <= Jret0

func isparbh(o: i64) -> bool:
    return o >= Oparsb and o <= Oparuh

func isargbh(o: i64) -> bool:
    return o >= Oargsb and o <= Oarguh

func isxsel(o: i64) -> bool:
    return o >= Oxsel and o <= Oxsel1

func isatomic(o: i64) -> bool:
    return o >= Oaload and o <= Oaswap or o >= Oacas0 and o <= Oacas1

func kwide(k: i64) -> i64:
    return k and 1

func kbase(k: i64) -> i64:
    if k == Kv:
        return 1
    return k >> 1

func argcls(i: Instr, n: i64) -> i64:
    return optab[i.op].argcls[n * 5 + i64(i.cls)]

# an instruction, where it is
func at(b: i64, k: i64) -> i64:
    return b << 32 or k

func instr(at: i64) -> *Instr:
    return ptr(fn.blks[at >> 32].ins[at and 0xffff_ffff])

func iscmp(op: i64, pk: *i64, pc: *i64) -> bool:
    if Ocmpw <= op and op <= Ocmpw1:
        pc.* = op - Ocmpw
        pk.* = Kw
    elif Ocmpl <= op and op <= Ocmpl1:
        pc.* = op - Ocmpl
        pk.* = Kl
    elif Ocmps <= op and op <= Ocmps1:
        pc.* = NCmpI + op - Ocmps
        pk.* = Ks
    elif Ocmpd <= op and op <= Ocmpd1:
        pc.* = NCmpI + op - Ocmpd
        pk.* = Kd
    else:
        return false
    return true

func emit(op: i64, k: i64, to: Ref, a0: Ref, a1: Ref):
    append(fn.out, Instr{op = i32(op), cls = i32(k), to = to, arg = [a0, a1]})

func emiti(i: Instr):
    append(fn.out, i)

# the instructions of b become what emit made
func idup(b: i64):
    ins := ptr(fn.blks[b].ins)
    ins.len = 0
    for k in reverse 0..fn.out.len:
        append(ins, fn.out[k])
    fn.out.len = 0

func addins(ins: *&list[Instr], i: Instr):
    if i.op != Onop:
        append(ins, i)

func cmpop(c: i64) -> i64: # the comparison with its arguments swapped
    return [Cieq, Cine, Cisle, Cislt, Cisge, Cisgt, Ciule, Ciult, Ciuge, Ciugt, NCmpI + Cfeq, NCmpI + Cfle, NCmpI + Cflt, NCmpI + Cfge, NCmpI + Cfgt, NCmpI + Cfne, NCmpI + Cfo, NCmpI + Cfuo][c]

# merges the class k into pk, and says whether they clash
func clsmerge(pk: *i32, k: i64) -> bool:
    k1 := i64(pk.*)
    if k1 == Kx:
        pk.* = i32(k)
        return false
    if k1 == Kw and k == Kl or k1 == Kl and k == Kw:
        pk.* = Kw
        return false
    return k1 != k

func phicls(t: i64) -> i64:
    t1 := i64(fn.tmp[t].phi)
    if t1 == 0:
        return t
    t1 = phicls(t1)
    fn.tmp[t].phi = i32(t1)
    return t1

func phiargn(p: i64, b: i64) -> i64:
    if p != 0:
        for n, from in fn.phis[p].blk:
            if from == b:
                return n
    return -1

func phiarg(p: i64, b: i64) -> Ref:
    return fn.phis[p].arg[phiargn(p, b)]

func newphi(to: Ref, cls: i64) -> i64:
    fn.nphis += 1
    if fn.nphis == fn.phis.len:
        append(fn.phis, Phi{})
    p := ptr(fn.phis[fn.nphis])
    p.arg.len = 0
    p.blk.len = 0
    p.* = Phi{to = to, cls = i32(cls), arg = p.arg, blk = p.blk}
    return fn.nphis

func newtmp(k: i64) -> Ref:
    t := fn.ntmp
    fn.ntmp += 1
    if t == fn.tmp.len:
        append(fn.tmp, Tmp{})
    p := ptr(fn.tmp[t])
    p.uses.len = 0
    p.* = Tmp{uses = p.uses, cls = i32(k), slot = -1, nuse = 1, ndef = 1}
    return u32(t)

func chuse(r: Ref, du: i64):
    if rtype(r) == RTmp:
        fn.tmp[r].nuse += i32(du)

func conslot(c: Con) -> i64:
    h := u64(c.type) + 3 * u64(c.symtype) + 7 * u64(c.sym) + 11 * u64(c.bits)
    h = (h xor h >> 29) * 0x9e37_79b9_7f4a_7c15
    mask := fn.conh.len - 1
    s := i64(h >> 32) and mask
    while true:
        k := fn.conh[s]
        if k == 0:
            return s
        o := fn.con[k]
        if c.type == o.type and c.symtype == o.symtype and c.sym == o.sym and c.bits == o.bits:
            return s
        s = (s + 1) and mask

# constants are found through a hash of their index, rebuilt as it fills
func newcon(c: Con) -> Ref:
    if fn.conh.len < 2 * fn.con.len:
        size := 64
        while size < 4 * fn.con.len:
            size *= 2
        fn.conh.len = 0
        for k in 0..size:
            append(fn.conh, 0)
        for i in 1..fn.con.len:
            fn.conh[conslot(fn.con[i])] = i
    s := conslot(c)
    if fn.conh[s] == 0:
        fn.conh[s] = fn.con.len
        append(fn.con, c)
    return ref(RCon, fn.conh[s])

func getcon(val: i64) -> Ref:
    return newcon(Con{type = CBits, bits = val})

func addcon(c0: *Con, c1: Con, m: i64) -> bool:
    if m != 1 and c1.type == CAddr:
        return false
    if c0.type == CUndef:
        c0.* = c1
        c0.bits *= m
    else:
        if c1.type == CAddr:
            if c0.type == CAddr:
                return false
            c0.type = CAddr
            c0.symtype = c1.symtype
            c0.sym = c1.sym
        c0.bits += c1.bits * m
    return true

func isconbits(r: Ref, v: *i64) -> bool:
    if rtype(r) == RCon and fn.con[rval(r)].type == CBits:
        v.* = fn.con[rval(r)].bits
        return true
    return false

func intern(name: &strview) -> i64:
    found := asm.sym_ids[name]
    if found is i64:
        return found
    kept: &strview = heap(name) # the map keeps the view, not the bytes
    put(asm.sym_ids, kept, asm.syms.len)
    append(asm.syms, kept)
    return asm.syms.len - 1

# the stack a function takes stays aligned to 16
func salloc(rt: Ref, rs: Ref):
    fn.dynalloc = true
    if rtype(rs) == RCon:
        sz := fn.con[rval(rs)].bits
        if sz < 0 or sz >= 2147483647 - 15:
            panic("invalid alloc size " + sz)
        sz = (sz + 15) and -16
        emit(Osalloc, Kl, rt, getcon(sz), R)
    else:
        r0 := newtmp(Kl)
        r1 := newtmp(Kl)
        emit(Osalloc, Kl, rt, r0, R)
        emit(Oand, Kl, r0, r1, getcon(-16))
        emit(Oadd, Kl, r1, rs, getcon(15))
        if fn.tmp[rs].slot != -1:
            panic("unlikely alloc argument in " + fn.name)

func bsinit(s: *BSet):
    s.t.len = 0
    s.w.len = 0
    append(s.t, 0)
    append(s.w, 0)

func popcnt(b: u64) -> i64:
    b = (b and 0x5555_5555_5555_5555) + (b >> 1 and 0x5555_5555_5555_5555)
    b = (b and 0x3333_3333_3333_3333) + (b >> 2 and 0x3333_3333_3333_3333)
    b = (b and 0x0f0f_0f0f_0f0f_0f0f) + (b >> 4 and 0x0f0f_0f0f_0f0f_0f0f)
    b += b >> 8
    b += b >> 16
    b += b >> 32
    return i64(b and 0xff)

DEBRUIJN: array[u8, 64] = [0, 1, 2, 53, 3, 7, 54, 27, 4, 38, 41, 8, 34, 55, 48, 28, 62, 5, 39, 46, 44, 42, 22, 9, 24, 35, 59, 56, 49, 18, 29, 11, 63, 52, 6, 26, 37, 40, 33, 47, 61, 45, 43, 21, 23, 58, 17, 10, 51, 25, 36, 32, 60, 20, 57, 16, 50, 31, 19, 15, 30, 14, 13, 12]

# the first word with an index of w or more
func bsfind(s: *BSet, w: u32) -> i64:
    if i64(w) < s.t.len and s.w[w] == w:
        return i64(w) # no word missing up to w
    lo := 0
    hi := s.t.len
    while lo < hi:
        m := (lo + hi) / 2
        if s.w[m] < w:
            lo = m + 1
        else:
            hi = m
    return lo

func bsword(s: *BSet, w: u32) -> u64:
    n := bsfind(s, w)
    if n < s.t.len and s.w[n] == w:
        return s.t[n]
    return 0

func bshas(s: *BSet, e: i64) -> bool:
    return (bsword(s, u32(e / NBit)) and u64(1) << (e % NBit)) != 0

func bscount(s: *BSet) -> i64:
    n := 0
    for w in s.t:
        n += popcnt(w)
    return n

func bsset(s: *BSet, e: i64):
    w := u32(e / NBit)
    n := bsfind(s, w)
    if n == s.t.len or s.w[n] != w:
        insert(s.t, n, 0)
        insert(s.w, n, w)
    s.t[n] = s.t[n] or u64(1) << (e % NBit)

func bsclr(s: *BSet, e: i64):
    w := u32(e / NBit)
    n := bsfind(s, w)
    if n == s.t.len or s.w[n] != w:
        return
    s.t[n] = s.t[n] and not (u64(1) << (e % NBit))
    if n != 0 and s.t[n] == 0:
        _ = remove(s.t, n)
        _ = remove(s.w, n)

func bscopy(a: *BSet, b: *BSet):
    a.t = b.t[:]
    a.w = b.w[:]

func bsunion(a: *BSet, b: *BSet):
    n := a.t.len
    i := 0
    for j in 0..b.t.len:
        while i < a.t.len and a.w[i] < b.w[j]:
            i += 1
        if i == a.t.len or a.w[i] != b.w[j]:
            n += 1
    i = a.t.len
    while a.t.len < n:
        append(a.t, 0)
        append(a.w, 0)
    j := b.t.len
    while j > 0: # merge from the end, in place
        n -= 1
        if i > 0 and a.w[i - 1] >= b.w[j - 1]:
            i -= 1
            a.w[n] = a.w[i]
            a.t[n] = a.t[i]
            if a.w[n] == b.w[j - 1]:
                j -= 1
                a.t[n] = a.t[n] or b.t[j]
        else:
            j -= 1
            a.w[n] = b.w[j]
            a.t[n] = b.t[j]

func bsinter(a: *BSet, b: *BSet):
    n := 0
    for i in 0..a.t.len:
        a.t[n] = a.t[i] and bsword(b, a.w[i])
        a.w[n] = a.w[i]
        if n == 0 or a.t[n] != 0:
            n += 1
    a.t.len = n
    a.w.len = n

func bszero(s: *BSet):
    s.t.len = 1
    s.w.len = 1
    s.t[0] = 0

# the first element of s at or past e, or -1
func bsiter(s: *BSet, e: i64) -> i64:
    w := u32(e / NBit)
    t := bsfind(s, w)
    if t >= s.t.len:
        return -1
    b := s.t[t]
    if s.w[t] == w:
        b = b and not ((u64(1) << (e % NBit)) - 1)
    while b == 0:
        t += 1
        if t >= s.t.len:
            return -1
        b = s.t[t]
    return NBit * i64(s.w[t]) + i64(DEBRUIJN[((b and 0 - b) * 0x022f_dd63_cc95_386d) >> 58]) # the lowest bit set

func newblk() -> i64:
    fn.nblks += 1
    if fn.nblks == fn.blks.len:
        append(fn.blks, Blk{})
    b := ptr(fn.blks[fn.nblks])
    b.ins.len = 0
    b.fron.len = 0
    b.pred.len = 0
    b.* = Blk{ins = b.ins, fron = b.fron, pred = b.pred, live_in = b.live_in, live_out = b.live_out, gen = b.gen}
    return fn.nblks

func fillpreds():
    b := fn.start
    while b != 0:
        fn.blks[b].pred.len = 0
        b = fn.blks[b].link
    b = fn.start
    while b != 0:
        s1 := fn.blks[b].s1
        s2 := fn.blks[b].s2
        if s1 != 0:
            append(fn.blks[s1].pred, b)
        if s2 != 0 and s2 != s1:
            append(fn.blks[s2].pred, b)
        b = fn.blks[b].link

func porec(b: i64):
    if b == 0 or fn.blks[b].id != -1:
        return
    fn.blks[b].id = 0 # a mark
    s1 := fn.blks[b].s1
    s2 := fn.blks[b].s2
    if s1 != 0 and s2 != 0 and fn.blks[s1].loop > fn.blks[s2].loop:
        s1 = fn.blks[b].s2
        s2 = fn.blks[b].s1
    porec(s1)
    porec(s2)
    fn.blks[b].id = fn.nblk
    fn.nblk += 1

func fillcfg():
    b := fn.start
    while b != 0:
        fn.blks[b].id = -1
        b = fn.blks[b].link
    fn.nblk = 0
    porec(fn.start)
    fn.rpo.len = 0
    for n in 0..fn.nblk:
        append(fn.rpo, 0)
    marks: &list[Instr] = heap([])
    defer free(marks)
    prev := 0
    b = fn.start
    while b != 0:
        next := fn.blks[b].link
        if fn.blks[b].id != -1:
            fn.blks[b].id = fn.nblk - fn.blks[b].id - 1
            fn.rpo[fn.blks[b].id] = b
            prev = b
            b = next
            continue
        if prev == 0:
            fn.start = next
        else:
            fn.blks[prev].link = next
        # the marks of a dead block go to the start of the block after it, so with -debug they keep their place
        marks.len = 0
        for i in fn.blks[b].ins:
            if i.op == Odbgmark:
                addins(marks, i)
        if marks.len > 0 and next != 0:
            for i in fn.blks[next].ins:
                addins(marks, i)
            fn.blks[next].ins = marks[:]
        b = next
    fillpreds()
    # the phis keep the arguments of the predecessors that remain
    b = fn.start
    while b != 0:
        p := fn.blks[b].phi
        while p != 0:
            ph := ptr(fn.phis[p])
            n0 := 0
            for n in 0..ph.arg.len:
                bp := ph.blk[n]
                if fn.blks[bp].id != -1 and (fn.blks[bp].s1 == b or fn.blks[bp].s2 == b):
                    ph.blk[n0] = bp
                    ph.arg[n0] = ph.arg[n]
                    n0 += 1
            ph.blk.len = n0
            ph.arg.len = n0
            p = ph.link
        b = fn.blks[b].link

func domnum(b: i64, n: i64) -> i64:
    fn.blks[b].dpre = n
    n += 1
    d := fn.blks[b].dom
    while d != 0:
        n = domnum(d, n)
        d = fn.blks[d].dlink
    fn.blks[b].dend = n
    return n

func filldom():
    b := fn.start
    while b != 0:
        fn.blks[b].idom = 0
        fn.blks[b].dom = 0
        fn.blks[b].dlink = 0
        b = fn.blks[b].link
    changed := true
    while changed:
        changed = false
        for n in 1..fn.nblk:
            b = fn.rpo[n]
            d := 0
            pred := fn.blks[b].pred
            for p in reverse 0..pred.len:
                if fn.blks[pred[p]].idom == 0 and pred[p] != fn.start:
                    continue
                # the nearest common dominator, as Cooper, Harvey and Kennedy find it
                b2 := pred[p]
                if d == 0:
                    d = b2
                while d != b2:
                    if fn.blks[d].id < fn.blks[b2].id:
                        bt := d
                        d = b2
                        b2 = bt
                    while fn.blks[d].id > fn.blks[b2].id:
                        d = fn.blks[d].idom
            if d != fn.blks[b].idom:
                changed = true
                fn.blks[b].idom = d
    b = fn.start
    while b != 0:
        d := fn.blks[b].idom
        if d != 0:
            fn.blks[b].dlink = fn.blks[d].dom
            fn.blks[d].dom = b
        b = fn.blks[b].link
    _ = domnum(fn.start, 0)

func sdom(b1: i64, b2: i64) -> bool:
    return fn.blks[b1].dpre < fn.blks[b2].dpre and fn.blks[b2].dpre < fn.blks[b1].dend

func dom(b1: i64, b2: i64) -> bool:
    return b1 == b2 or sdom(b1, b2)

func loopmark(hd: i64, b: i64, f: func(i64, i64)):
    if fn.blks[b].id < fn.blks[hd].id or fn.blks[b].visit == fn.blks[hd].id:
        return
    fn.blks[b].visit = fn.blks[hd].id
    f(hd, b)
    for p in 0..fn.blks[b].pred.len:
        loopmark(hd, fn.blks[b].pred[p], f)

func loopiter(f: func(i64, i64)):
    b := fn.start
    while b != 0:
        fn.blks[b].visit = -1
        b = fn.blks[b].link
    for n in 0..fn.nblk:
        b = fn.rpo[n]
        for p in 0..fn.blks[b].pred.len:
            pred := fn.blks[b].pred[p]
            if fn.blks[pred].id >= n:
                loopmark(b, pred, f)

func multloop(hd: i64, b: i64):
    fn.blks[b].loop *= 10

func fillloop():
    b := fn.start
    while b != 0:
        fn.blks[b].loop = 1
        b = fn.blks[b].link
    loopiter(multloop)

func uffind(b: i64, uf: &list[i64]) -> i64:
    id := fn.blks[b].id
    if uf[id] != 0:
        uf[id] = uffind(uf[id], uf)
        return uf[id]
    return b

# a block that only jumps on is skipped
func simpljmp():
    ret := newblk()
    fn.blks[ret].id = fn.nblk
    fn.nblk += 1
    fn.blks[ret].jmp.type = Jret0
    uf: &list[i64] = heap([]) # union-find
    defer free(uf)
    for n in 0..fn.nblk:
        append(uf, 0)
    b := fn.start
    while b != 0:
        p := ptr(fn.blks[b])
        if p.jmp.type == Jret0:
            p.jmp.type = Jjmp
            p.s1 = ret
        if p.ins.len == 0 and p.jmp.type == Jjmp:
            p.s1 = uffind(p.s1, uf)
            if p.s1 != b:
                uf[p.id] = p.s1
        b = p.link
    last := 0
    b = fn.start
    while b != 0:
        p := ptr(fn.blks[b])
        if p.s1 != 0:
            p.s1 = uffind(p.s1, uf)
        if p.s2 != 0:
            p.s2 = uffind(p.s2, uf)
        if p.s1 != 0 and p.s1 == p.s2:
            p.jmp.type = Jjmp
            p.s2 = 0
        last = b
        b = p.link
    fn.blks[last].link = ret

func reachrec(b: i64, to: i64) -> bool:
    if b == to:
        return true
    if b == 0 or fn.blks[b].visit != 0:
        return false
    fn.blks[b].visit = 1
    return reachrec(fn.blks[b].s1, to) or reachrec(fn.blks[b].s2, to)

func unvisit(b: i64):
    if b != 0 and fn.blks[b].visit != 0:
        fn.blks[b].visit = 0
        unvisit(fn.blks[b].s1)
        unvisit(fn.blks[b].s2)

type Exit: # a block's jump, as simplcfg moves it
    type: i32
    arg: Ref
    s1: i64
    s2: i64

func simplcfg():
    b := fn.start
    while b != 0:
        if fn.blks[b].pred.len == 1:
            bb := fn.blks[b].pred[0]
            p := fn.blks[b].phi
            while p != 0:
                addins(ptr(fn.blks[bb].ins), Instr{op = Ocopy, cls = fn.phis[p].cls, to = fn.phis[p].to, arg = [phiarg(p, bb), R]})
                p = fn.phis[p].link
            fn.blks[b].phi = 0
        b = fn.blks[b].link
    jmp: &list[Exit] = heap([])
    defer free(jmp)
    empty: &list[bool] = heap([])
    defer free(empty)
    for n in 0..fn.nblk:
        append(jmp, Exit{})
        append(empty, false)
    b = fn.start
    while b != 0:
        p := ptr(fn.blks[b])
        jmp[p.id] = Exit{p.jmp.type, p.jmp.arg, p.s1, p.s2}
        empty[p.id] = p.phi == 0
        for i in p.ins:
            if i.op != Onop and i.op != Odbgloc:
                empty[p.id] = false
                break
        b = p.link
    done := false
    while not done:
        done = true
        b = fn.start
        while b != 0:
            id := fn.blks[b].id
            if id != -1:
                j := jmp[id]
                # with -debug a block stays where it is, so a scope stays one range of code
                if j.type == Jjmp and fn.blks[j.s1].pred.len == 1 and not comp.debug:
                    s := j.s1
                    for i in fn.blks[s].ins:
                        addins(ptr(fn.blks[b].ins), i)
                    empty[id] = empty[id] and empty[fn.blks[s].id]
                    jj := jmp[fn.blks[s].id]
                    for bb in [jj.s1, jj.s2]:
                        if bb != 0:
                            p := fn.blks[bb].phi
                            while p != 0:
                                fn.phis[p].blk[phiargn(p, s)] = b
                                p = fn.phis[p].link
                    fn.blks[s].id = -1
                    jmp[id] = jj
                    done = false
                elif j.type == Jjnz and empty[fn.blks[j.s1].id] and empty[fn.blks[j.s2].id]:
                    a := jmp[fn.blks[j.s1].id]
                    c := jmp[fn.blks[j.s2].id]
                    if a.type == c.type and a.arg == c.arg and a.s1 == c.s1 and a.s2 == c.s2 and (a.s1 == 0 or fn.blks[a.s1].phi == 0) and (a.s2 == 0 or fn.blks[a.s2].phi == 0):
                        jmp[id] = a
                        done = false
            b = fn.blks[b].link
    b = fn.start
    while b != 0:
        p := ptr(fn.blks[b])
        if p.id != -1:
            j := jmp[p.id]
            p.jmp.type = j.type
            p.jmp.arg = j.arg
            p.s1 = j.s1
            p.s2 = j.s2
        b = p.link
    fillcfg()

func adduse(t: i64, type: i64, b: i64, at: i64):
    p := ptr(fn.tmp[t])
    if not p.listed:
        return
    if i64(p.nuse) < p.uses.len:
        p.uses.len = i64(p.nuse)
    append(p.uses, Usage{i32(type), u32(fn.blks[b].id), at})
    p.nuse += 1

# the uses, widths, phi classes and classes of the temps; the visits stay
func filluse():
    for t in Tmp0..fn.ntmp:
        p := ptr(fn.tmp[t])
        p.def = 0
        p.bid = 0xffff_ffff
        p.ndef = 0
        p.nuse = 0
        p.cls = 0
        p.phi = 0
        p.width = WFull
        p.listed = true
        p.uses.len = 0
    b := fn.start
    while b != 0:
        p := fn.blks[b].phi
        while p != 0:
            ph := fn.phis[p]
            tp := i64(ph.to)
            fn.tmp[tp].bid = u32(fn.blks[b].id)
            fn.tmp[tp].ndef += 1
            fn.tmp[tp].cls = ph.cls
            tp = phicls(tp)
            for a in ph.arg:
                if rtype(a) == RTmp:
                    adduse(i64(a), UPhi, b, p)
                    t := phicls(i64(a))
                    if t != tp:
                        fn.tmp[t].phi = i32(tp)
            p = ph.link
        ins := fn.blks[b].ins
        for k in 0..ins.len:
            i := ins[k]
            if i.to != R:
                w := WFull
                if isparbh(i.op):
                    w = Wsb + i64(i.op) - Oparsb
                if isload(i.op) and i.op != Oload:
                    w = Wsb + i64(i.op) - Oloadsb
                if isext(i.op):
                    w = Wsb + i64(i.op) - Oextsb
                x := 0
                if iscmp(i.op, ptr(x), ptr(x)):
                    w = Wub
                if (w == Wsw or w == Wuw) and i.cls == Kw:
                    w = WFull
                t := ptr(fn.tmp[i.to])
                t.width = i32(w)
                t.def = at(b, k)
                t.bid = u32(fn.blks[b].id)
                t.ndef += 1
                t.cls = i.cls
            for m in 0..2:
                if rtype(i.arg[m]) == RTmp:
                    adduse(i64(i.arg[m]), UIns, b, at(b, k))
        if rtype(fn.blks[b].jmp.arg) == RTmp:
            adduse(i64(fn.blks[b].jmp.arg), UJmp, b, 0)
        b = fn.blks[b].link

func refindex(t: i64) -> Ref:
    return newtmp(fn.tmp[t].cls)

func nfree(n: i64):
    fn.versions[n].up = fn.unused
    fn.unused = n

func rendef(r: Ref, b: i64, stk: &list[i64]) -> Ref:
    t := i64(r)
    if r == R or fn.tmp[t].visit == 0:
        return r
    r1 := refindex(t)
    fn.tmp[r1].visit = i32(t)
    n := fn.unused
    if n != 0:
        fn.unused = fn.versions[n].up
    else:
        n = fn.versions.len
        append(fn.versions, Version{})
    fn.versions[n] = Version{r1, b, stk[t]}
    stk[t] = n
    return r1

func getstk(t: i64, b: i64, stk: &list[i64]) -> Ref:
    n := stk[t]
    while n != 0 and not dom(fn.versions[n].b, b):
        n1 := n
        n = fn.versions[n].up
        nfree(n1)
    stk[t] = n
    if n == 0:
        return UNDEF
    return fn.versions[n].r

func renblk(b: i64, stk: &list[i64]):
    p := fn.blks[b].phi
    while p != 0:
        fn.phis[p].to = rendef(fn.phis[p].to, b, stk)
        p = fn.phis[p].link
    for k in 0..fn.blks[b].ins.len:
        for m in 0..2:
            a := fn.blks[b].ins[k].arg[m]
            if rtype(a) == RTmp and fn.tmp[a].visit != 0:
                fn.blks[b].ins[k].arg[m] = getstk(i64(a), b, stk)
        fn.blks[b].ins[k].to = rendef(fn.blks[b].ins[k].to, b, stk)
    a := fn.blks[b].jmp.arg
    if rtype(a) == RTmp and fn.tmp[a].visit != 0:
        fn.blks[b].jmp.arg = getstk(i64(a), b, stk)
    s1 := fn.blks[b].s1
    s2 := fn.blks[b].s2
    if s2 == s1:
        s2 = 0
    for s in [s1, s2]:
        if s == 0:
            break
        p = fn.blks[s].phi
        while p != 0:
            t := i64(fn.tmp[fn.phis[p].to].visit)
            if t != 0:
                r := getstk(t, b, stk)
                append(fn.phis[p].arg, r)
                append(fn.phis[p].blk, b)
            p = fn.phis[p].link
    s := fn.blks[b].dom
    while s != 0:
        renblk(s, stk)
        s = fn.blks[s].dlink

func ssa():
    nt := fn.ntmp
    filldom()
    # the dominance frontier
    b := fn.start
    while b != 0:
        fn.blks[b].fron.len = 0
        b = fn.blks[b].link
    b = fn.start
    while b != 0:
        for s in [fn.blks[b].s1, fn.blks[b].s2]:
            if s != 0:
                a := b
                while not sdom(a, s) and not contains(fn.blks[a].fron, s):
                    append(fn.blks[a].fron, s)
                    a = fn.blks[a].idom
        b = fn.blks[b].link
    filllive()
    u: BSet
    defs: BSet
    bsinit(ptr(u))
    bsinit(ptr(defs))
    # the definitions of each temporary and their blocks, so it is not searched for in the others
    d0: &list[i64] = heap([])
    nd: &list[i64] = heap([])
    n := 0
    for t in 0..nt:
        append(d0, n)
        append(nd, 0)
        if t >= Tmp0:
            n += i64(fn.tmp[t].ndef)
    di: &list[i64] = heap([])
    db: &list[i64] = heap([])
    for k in 0..n:
        append(di, 0)
        append(db, 0)
    b = fn.start
    while b != 0:
        fn.blks[b].visit = 0
        ins := fn.blks[b].ins
        for k in 0..ins.len:
            t := i64(ins[k].to)
            if rtype(ins[k].to) == RTmp and t >= Tmp0:
                di[d0[t] + nd[t]] = at(b, k)
                db[d0[t] + nd[t]] = b
                nd[t] += 1
        b = fn.blks[b].link
    of: &list[i64] = heap([])
    stack: &list[i64] = heap([])
    for t in Tmp0..nt:
        fn.tmp[t].visit = 0
        if fn.tmp[t].phi != 0:
            continue
        if fn.tmp[t].ndef == 1:
            ok := true
            defb := fn.rpo[fn.tmp[t].bid]
            for use in fn.tmp[t].uses[:fn.tmp[t].nuse]:
                ok = ok and dom(defb, fn.rpo[use.bid])
            if ok:
                continue
        bszero(ptr(u))
        k: i32 = Kx
        stack.len = 0
        for d in d0[t]..d0[t] + nd[t]:
            b = db[d]
            i := instr(di[d])
            if not bshas(ptr(fn.blks[b].live_out), t):
                # dead at the end of its block, it gets a name of its own, given below to the uses that follow it there
                i.to = refindex(t)
                while of.len <= i64(i.to) - nt:
                    append(of, 0)
                of[i64(i.to) - nt] = t
                continue
            if not bshas(ptr(u), fn.blks[b].id):
                bsset(ptr(u), fn.blks[b].id)
                append(stack, b)
            if clsmerge(ptr(k), i64(i.cls)):
                panic("invalid input")
        bscopy(ptr(defs), ptr(u))
        while stack.len > 0:
            fn.tmp[t].visit = i32(t)
            b = trust pop(stack)
            bsclr(ptr(u), fn.blks[b].id)
            for a in fn.blks[b].fron:
                if fn.blks[a].visit == t:
                    continue
                fn.blks[a].visit = t
                if bshas(ptr(fn.blks[a].live_in), t):
                    p := newphi(u32(t), i64(k))
                    fn.phis[p].link = fn.blks[a].phi
                    fn.blks[a].phi = p
                    if not bshas(ptr(defs), fn.blks[a].id) and not bshas(ptr(u), fn.blks[a].id):
                        bsset(ptr(u), fn.blks[a].id)
                        append(stack, a)
    # name[t] holds in the block at[t]
    name: &list[Ref] = heap([])
    within: &list[i64] = heap([])
    for t in 0..nt:
        append(name, R)
        append(within, 0)
    b = fn.start
    while b != 0:
        ins := ptr(fn.blks[b].ins)
        for k in 0..ins.len:
            for m in 0..2:
                t := i64(ins[k].arg[m])
                if rtype(ins[k].arg[m]) == RTmp and t < nt and within[t] == b:
                    ins[k].arg[m] = name[t]
            if rtype(ins[k].to) == RTmp and i64(ins[k].to) >= nt:
                t := of[i64(ins[k].to) - nt]
                name[t] = ins[k].to
                within[t] = b
        t := i64(fn.blks[b].jmp.arg)
        if rtype(fn.blks[b].jmp.arg) == RTmp and t < nt and within[t] == b:
            fn.blks[b].jmp.arg = name[t]
        b = fn.blks[b].link
    free(name)
    free(within)
    free(of)
    free(stack)
    free(di)
    free(db)
    free(nd)
    free(d0)
    free(u.t)
    free(u.w)
    free(defs.t)
    free(defs.w)
    stk: &list[i64] = heap([]) # the versions of each temp, the innermost first
    defer free(stk)
    for t in 0..nt:
        append(stk, 0)
    renblk(fn.start, stk)
    for t in reverse 0..nt:
        while stk[t] != 0:
            v := stk[t]
            stk[t] = fn.versions[v].up
            nfree(v)

func phicheck(p: i64, b: i64, t: Ref) -> bool:
    for n in 0..fn.phis[p].arg.len:
        if fn.phis[p].arg[n] == t:
            b1 := fn.phis[p].blk[n]
            if b1 != b and not sdom(b, b1):
                return true
    return false

func ssacheck():
    for t in Tmp0..fn.ntmp:
        if fn.tmp[t].ndef > 1:
            panic("an ssa temporary of " + fn.name + " is defined more than once")
        if fn.tmp[t].nuse > 0 and fn.tmp[t].ndef == 0:
            panic("an ssa temporary of " + fn.name + " is used undefined")
    b := fn.start
    while b != 0:
        p := fn.blks[b].phi
        while p != 0:
            r := fn.phis[p].to
            for u in fn.tmp[r].uses[:fn.tmp[r].nuse]:
                bu := fn.rpo[u.bid]
                if u.type == UPhi and phicheck(u.at, b, r) or u.type != UPhi and bu != b and not sdom(b, bu):
                    panic("a temporary of " + fn.name + " violates the ssa invariant")
            p = fn.phis[p].link
        for k in 0..fn.blks[b].ins.len:
            r := fn.blks[b].ins[k].to
            if rtype(r) != RTmp:
                continue
            for u in fn.tmp[r].uses[:fn.tmp[r].nuse]:
                bu := fn.rpo[u.bid]
                bad := false
                if u.type == UPhi:
                    bad = phicheck(u.at, b, r)
                elif bu == b:
                    bad = u.type == UIns and u.at <= at(b, k)
                else:
                    bad = not sdom(b, bu)
                if bad:
                    panic("a temporary of " + fn.name + " violates the ssa invariant")
        b = fn.blks[b].link

# a proc of comp lowered to the function in fn

func begin(name: &strview, export: bool):
    if fn.blks.len == 0:
        append(fn.blks, Blk{})
        append(fn.phis, Phi{})
        append(fn.versions, Version{})
    fn.nblks = 0
    fn.nphis = 0
    fn.ntmp = 0
    fn.con.len = 0
    append(fn.con, Con{type = CBits, bits = 0xdead_dead}) # UNDEF
    append(fn.con, Con{type = CBits})
    fn.conh.len = 0
    fn.mem.len = 0
    fn.start = 0
    fn.rpo.len = 0
    fn.nblk = 0
    fn.retty = -1
    fn.retr = R
    fn.reg = 0
    fn.slot = 0
    fn.dynalloc = false
    fn.leaf = true
    fn.name = name
    fn.export = export
    fn.dbgmark.len = 0
    fn.out.len = 0
    m := ptr(asm.machine)
    for k in 0..Tmp0:
        _ = newtmp(Kd if m.fpr0 <= k and k < m.fpr0 + m.nfpr else Kl)

# the classes of the parser: those of values, then those that only pass
Ksb = 5
Kub = 6
Ksh = 7
Kuh = 8
Kc = 9
K0 = 10

# the class of a value, a parameter or an argument of class c of comp, and its aggregate type, or -1
func parsecls(c: u32) -> (i64, i64):
    if c >= CAGG:
        return Kc, asm.ctyps[c - CAGG]
    if c >= AGG:
        return Kc, asm.typs[c - AGG]
    switch c:
    case W:
        return Kw, -1
    case L:
        return Kl, -1
    case S:
        return Ks, -1
    case D:
        return Kd, -1
    case V:
        return Kv, -1
    case SB:
        return Ksb, -1
    case UB:
        return Kub, -1
    case SH:
        return Ksh, -1
    return Kuh, -1

func tmpref(n: i64) -> Ref:
    k := n - fn.base
    if fn.temps[k] == R:
        fn.temps[k] = newtmp(Kx)
    return fn.temps[k]

func parseref(a: Arg) -> Ref:
    switch a.kind:
    case Temp:
        return tmpref(a.n)
    case Global:
        return newcon(asm.globals[a.n])
    case Single: # the bits of the f32, which the arg holds as an f64
        return getcon(i64(f32(a.n as f64) as u32))
    case:
        return getcon(a.n)

func findblk(label: i64) -> i64:
    k := label - fn.label0
    if fn.labels[k] == 0:
        fn.labels[k] = newblk()
    return fn.labels[k]

func closeblk(type: i64, arg: Ref, s1: i64, s2: i64):
    b := ptr(fn.blks[fn.last])
    b.jmp = Jmp{i32(type), arg}
    b.s1 = s1
    b.s2 = s2

func lower(p: Proc, dropped: &list[bool], moved: &list[i64]):
    # a label right after a jump that only jumps on: the jumps to it land where it jumps, and both are dropped
    ended := false
    for k in p.code..p.end:
        i := comp.code[k]
        next := kept(dropped, k + 1, p.end)
        if i.op == "@" and ended and next < p.end and comp.code[next].op == "jmp" and landing(moved, comp.code[next].a.n) != i.a.n:
            moved[i.a.n] = comp.code[next].a.n
            dropped[k] = true
            dropped[next] = true
        if not dropped[k]:
            ended = i.op == "jmp" or i.op == "jnz" or i.op == "ret" or i.op == "hlt"
    begin(p.name[1:], p.export)
    fn.base = i64(p.temps)
    fn.temps.len = 0
    for t in p.temps..=p.last:
        append(fn.temps, R)
    fn.label0 = i64(p.labels)
    fn.labels.len = 0
    append(fn.labels, 0)
    for i in comp.code[p.code:p.end]:
        if i.op == "@":
            while fn.labels.len <= i.a.n - i64(p.labels):
                append(fn.labels, 0)
    rcls, retty := parsecls(p.cls)
    if p.cls == 0:
        rcls = K0
    fn.retty = retty
    pars: &list[Instr] = heap([])
    defer free(pars)
    for given in comp.passes[p.params:p.params + p.count]:
        kc, ty := parsecls(given.cls)
        to := parseref(given.arg)
        if kc == Kc:
            append(pars, Instr{op = Oparc, cls = Kl, to = to, arg = [ref(RType, ty), R]})
        elif kc >= Ksb:
            append(pars, Instr{op = i32(Oparsb + kc - Ksb), cls = Kw, to = to})
        else:
            append(pars, Instr{op = Opar, cls = i32(kc), to = to})
    fn.start = newblk()
    fn.last = fn.start
    append(fn.blks[fn.start].ins, pars[:])
    shown := 0
    line := 0
    slotted := not comp.debug
    for k in p.code..p.end:
        i := comp.code[k]
        if not slotted and not starts_with(i.op, "alloc"):
            slotted = true # the allocs are first, and the emitter says where each one went
            for m in p.mentions..p.mentioned:
                slot := comp.mentions[m].pointer
                if slot == 0:
                    slot = comp.mentions[m].temp
                append(fn.blks[fn.last].ins, Instr{op = Odbgslot, cls = Kw, arg = [tmpref(i64(slot)), ref(RInt, m)]})
            # the prologue takes this line, so a debugger stops after it with the parameters in place
            shown = declared_at(p)
            line = line_of(shown)
            append(fn.blks[fn.last].ins, Instr{op = Odbgloc, cls = Kw, arg = [ref(RInt, line), ref(RInt, shown - line_start(shown) + 1)]})
        next := kept(dropped, k + 1, p.end)
        if dropped[k] or i.op == "jmp" and next < p.end and comp.code[next].op == "@" and comp.code[next].a.n == landing(moved, i.a.n):
            continue
        if i.pos != 0 and i.pos != shown and i.op != "@" and not starts_with(i.op, "alloc"):
            shown = i.pos
            if line_of(i.pos) != line:
                line = line_of(i.pos)
                append(fn.blks[fn.last].ins, Instr{op = Odbgloc, cls = Kw, arg = [ref(RInt, line), ref(RInt, i.pos - line_start(i.pos) + 1)]})
        switch i.op:
        case "@":
            to := findblk(i.a.n)
            if fn.blks[fn.last].jmp.type == Jxxx:
                closeblk(Jjmp, R, to, 0)
            fn.blks[fn.last].link = to
            fn.last = to
            if comp.debug:
                shown = 0 # a block starts a row of the line table, so a debugger stops where a jump lands
                line = 0
        case "jmp":
            closeblk(Jjmp, R, findblk(landing(moved, i.a.n)), 0)
        case "jnz":
            r := parseref(i.a)
            closeblk(Jjnz, r, findblk(landing(moved, i.b.n)), findblk(landing(moved, i.c.n)))
        case "ret":
            if i.a.kind == Empty or rcls == K0:
                closeblk(Jret0, R, 0, 0)
            else:
                closeblk(Jretw + rcls - i64(rcls >= Ksb), parseref(i.a), 0, 0)
        case "hlt":
            closeblk(Jhlt, R, 0, 0)
        case "call":
            b := ptr(fn.blks[fn.last])
            to: Ref = R
            kc := Kw
            ty := -1
            if i.to != 0:
                to = tmpref(i64(i.to))
                kc, ty = parsecls(i.cls)
            fn.leaf = false
            callee := parseref(i.a)
            for given in comp.passes[i.first:i.first + i.count]:
                if given.cls == 0:
                    append(b.ins, Instr{op = Oargv})
                    continue
                c, ty2 := parsecls(given.cls)
                r := parseref(given.arg)
                if c == Kc:
                    append(b.ins, Instr{op = Oargc, cls = Kl, arg = [ref(RType, ty2), r]})
                elif c >= Ksb:
                    append(b.ins, Instr{op = i32(Oargsb + c - Ksb), cls = Kw, arg = [r, R]})
                else:
                    append(b.ins, Instr{op = Oarg, cls = i32(c), arg = [r, R]})
            kind: Ref = R
            if kc == Kc:
                kc = Kl
                kind = ref(RType, ty)
            if kc >= Ksb:
                kc = Kw
            append(b.ins, Instr{op = Ocall, cls = i32(kc), to = to, arg = [callee, kind]})
        case "blit":
            a0 := parseref(i.a)
            a1 := parseref(i.b)
            _ = parseref(i.c)
            append(fn.blks[fn.last].ins, Instr{op = Oblit0, arg = [a0, a1]})
            append(fn.blks[fn.last].ins, Instr{op = Oblit1, arg = [ref(RInt, i.c.n), R]})
        case "acas":
            to := tmpref(i64(i.to))
            kc, _ := parsecls(i.cls)
            a0 := parseref(i.a)
            a1 := parseref(i.b)
            a2 := parseref(i.c)
            append(fn.blks[fn.last].ins, Instr{op = Oacas0, cls = i32(kc), arg = [a1, R]})
            append(fn.blks[fn.last].ins, Instr{op = Oacas1, cls = i32(kc), to = to, arg = [a0, a2]})
        case "dbgmark":
            append(fn.dbgmark, i.a.n)
            append(fn.blks[fn.last].ins, Instr{op = Odbgmark, cls = Kw, arg = [ref(RInt, fn.dbgmark.len - 1), R]})
        case:
            to: Ref = R
            kc := Kw
            if i.to != 0:
                to = tmpref(i64(i.to))
                kc, _ = parsecls(i.cls)
            a0: Ref = R
            a1: Ref = R
            if i.a.kind != Empty:
                a0 = parseref(i.a)
            if i.b.kind != Empty:
                a1 = parseref(i.b)
            append(fn.blks[fn.last].ins, Instr{op = i32(opcode(i.op)), cls = i32(kc), to = to, arg = [a0, a1]})
    typecheck()

func kept(dropped: &list[bool], k: i64, end: i64) -> i64:
    while k < end and dropped[k]:
        k += 1
    return k

func landing(moved: &list[i64], to: i64) -> i64:
    while moved[to] != 0:
        to = moved[to]
    return to

# a function the compiler makes itself, that returns what it reads from frame, or the address of data
func special(name: &strview, export: bool, data: &strview):
    begin(name, export)
    fn.start = newblk()
    b := ptr(fn.blks[fn.start])
    if data.len > 0:
        b.jmp = Jmp{Jretl, newcon(Con{type = CAddr, sym = i32(intern(data))})}
    else:
        f := newtmp(Kx)
        c := newtmp(Kx)
        append(b.ins, Instr{op = Oframe, cls = Kl, to = f})
        append(b.ins, Instr{op = Oload, cls = Kl, to = c, arg = [f, R]})
        b.jmp = Jmp{Jretl, c}
    typecheck()

func opcode(name: &strview) -> i64:
    if asm.ops.len == 0:
        for o in 1..NPubOp:
            put(asm.ops, optab[o].name, o)
        put(asm.ops, "loadw", Oloadsw)
        for alias in ["loadl", "loads", "loadd", "loadv"]:
            put(asm.ops, alias, Oload)
    found := asm.ops[name]
    if found is i64:
        return found
    panic("no instruction " + name)

# the classes of the temps, by those of the instructions that define them
func typecheck():
    fillpreds()
    b := fn.start
    while b != 0:
        for i in fn.blks[b].ins:
            if i.to != R and clsmerge(ptr(fn.tmp[i.to].cls), i64(i.cls)):
                panic("a temporary of " + fn.name + " is assigned with multiple types")
        b = fn.blks[b].link
    fn.nblk = fn.nblks
