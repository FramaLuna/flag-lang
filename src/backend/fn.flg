    Operation{"xselflt", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfne", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfo", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselfuo", [-2, -2, 2, 3, -2, -2, -2, 2, 3, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false}
]

type Instr:
    op: i32
    cls: i32
    to: Ref
    arg: array[Ref, 2]

type Exit:
    type: i32
    arg: Ref

type Bitset: # a set of temps, by increasing index w its words t that are not zero, and always the first one, of registers
    t: &list[u64] = heap([])
    w: &list[u32] = heap([])

type Phi:
    to: Ref
    cls: i32
    visit: i32
    arg: &list[Ref] = heap([])
    blocks: &list[i64] = heap([])
    next: i64

type BasicBlock:
    phi: i64
    ins: &list[Instr] = heap([])
    exit: Exit
    yes: i64
    no: i64
    targets: &list[i64] = heap([]) # of a jump table, the blocks it goes to, each once
    table: &list[i64] = heap([]) # of a jump table, for each index the place in targets it goes to
    next: i64
    id: i64
    visit: i64
    dominator: i64
    dominated: i64
    sibling: i64
    dom_from: i64
    dom_to: i64
    frontier: &list[i64] = heap([])
    depth: i64
    odom: i64 # the closest dominator in fewer loops
    preds: &list[i64] = heap([])
    live_in: Bitset
    live_out: Bitset
    gen: Bitset
    nlive: array[i64, 2]
    loop: i32

type Usage:
    type: i32
    block: u32
    at: i64 # the instruction, its block << 32 or its place, or the phi

type Region: # where a temp points
    type: i32
    base: i32
    offset: i64
    access: i32
    symbol: i32
    sz: i32 # of a slot, its bytes, or -1 past NBit
    m: u64 # of a slot, the bytes stored to
    slot: i32 # the temp whose region is the slot, 0 for none

type Temporary:
    def: i64 # the instruction that defines it: its block << 32 or its place, 0 for none
    uses: &list[Usage] = heap([])
    listed: bool # filluse gave it a list of uses, which adduse extends
    defs: i32
    used: i32
    block: u32 # its block, 0xffff_ffff for none
    cost: u32
    slot: i32
    pad: Ref # the slot that a call that returns an aggregate writes
    cls: i32
    hint: i32 # the register it would like, -1 for none
    hint_depth: i32 # the loop depth of the hint
    avoid: u64 # registers to avoid
    phi: i32
    alias: Region
    width: i32
    visit: i32
    gcmbid: u32

type Immediate:
    type: i32
    access: i32
    symbol: i32
    bits: i64

type Addr: # amd64 addressing
    offset: Immediate
    base: Ref
    index: Ref
    scale: i64

type Member:
    type: i32
    len: i64 # or the index in asm.typ of FTyp

type Layout:
    opaque: bool
    is_union: bool
    align: i64
    size: i64
    members: i64
    fields: &list[Member] = heap([]) # those of each union, each ended by FEnd

type Version: # the name a temp has in the blocks a block dominates
    r: Ref
    b: i64
    up: i64

type Machine:
    apple: bool
    windows: bool
    first_int: i64 # the first general purpose register
    ints: i64
    first_float: i64 # the first float register
    floats: i64
    always_live: u64 # registers always live, as the stack pointers
    caller_saved: array[i64, 43] # caller-save, then -1
    caller_saved_count: array[i64, 2]
    return_regs: func(Ref, *array[i64, 2]) -> u64
    arg_regs: func(Ref, *array[i64, 2]) -> u64
    memory_args: bool # an instruction takes as many arguments in memory as optab says
    abi0: func()
    abi1: func()
    isel: func()
    emit_function: func()
    emit_end: func()
    local_prefix: &strview # how a label the assembler keeps to itself starts
    symbol_prefix: &strview # how a symbol starts
    selects: bool
    half_saved: bool # a call keeps only the low half of a v register

context fn:
    blocks: &list[BasicBlock] = heap([]) # by handle, 0 is none
    block_count: i64
    phis: &list[Phi] = heap([]) # by handle, 0 is none
    phi_count: i64
    temps: &list[Temporary] = heap([])
    temp_count: i64
    constants: &list[Immediate] = heap([])
    constant_hash: &list[i64] = heap([]) # the place of each constant, by a hash of it
    addresses: &list[Addr] = heap([])
    versions: &list[Version] = heap([]) # 0 is none
    free_version: i64 # the first version given back, 0 for none
    start: i64
    order: &list[i64] = heap([])
    ordered: i64
    retty: i64 # the aggregate it returns, -1 for none
    retr: Ref
    reg: u64
    slot: i64
    dynamic_alloc: bool
    leaf: bool
    name: &strview = ""
    export: bool
    marks: &list[i64] = heap([])
    out: &list[Instr] = heap([]) # what emit made, the last one runs first
    first_temp: i64 # the first temp of the proc being lowered
    temp_of: &list[Ref] = heap([]) # the tmp of each of its temps
    first_label: i64 # the label before its first
    block_of: &list[i64] = heap([]) # the block of each of its labels
    last: i64 # the block it defined last
    con01: array[Ref, 2] # the constants 0 and 1
    gvntbl: &list[Instr] = heap([]) # the instructions gvn met, by a hash of them
    ilog: &list[Insert] = heap([]) # what loadopt inserts
    inum: i64
    thrsym: &list[i64] = heap([]) # the thread data each function reads, and the temps that hold their addresses
    thrtmp: &list[Ref] = heap([])
    thrins: &list[Instr] = heap([])

context asm:
    machine: Machine = AMD64_SYSV
    text: &str = heap("")
    layouts: &list[Layout] = heap([])
    layout_of: &list[i64] = heap([]) # the typ of each type of the program as :t, or -1
    c_layout_of: &list[i64] = heap([]) # and as :c
    symbols: &list[&strview] = heap([])
    symbol_ids: &map[&strview, i64] = heap({})
    globals: &list[Immediate] = heap([]) # the constant each global of comp names
    float_bits: &list[u64] = heap([]) # the bits of the floats that the code reads from memory
    float_sizes: &list[i64] = heap([])
    files: &list[&strview] = heap([])
    file: i64
    blocks: i64 # the labels the functions before took
    lane: i64 # of the next vset, given by a vlane

func ref_kind(r: Ref) -> i64:
    if r == EMPTY:
        return -1
    return i64(r >> 29)

func ref_value(r: Ref) -> i64:
    return i64(r and 0x1fff_ffff)

func ref_signed(r: Ref) -> i64:
    return (ref_value(r) xor 0x1000_0000) - 0x1000_0000

func ref(type: i64, val: i64) -> Ref:
    return u32(type << 29 or val and 0x1fff_ffff)

func is_register(r: Ref) -> bool:
    return r != EMPTY and r < FIRST_TEMP

func is_store(o: i64) -> bool:
    return o >= Ostorei8 and o <= Ostorevector

func is_vector(o: i64) -> bool:
    return o >= Ovaddi8 and o <= Ovi32tof32

func is_load(o: i64) -> bool:
    return o >= Oloadi8 and o <= Oload

func is_alloc(o: i64) -> bool:
    return o >= Oalloc4 and o <= Oalloc16

func is_extend(o: i64) -> bool:
    return o >= Oexti8 and o <= Oextu32

func is_param(o: i64) -> bool:
    return o >= Oparam and o <= Oparamenv

func is_arg(o: i64) -> bool:
    return o >= Oarg and o <= Oargvariadic

func is_return(j: i64) -> bool:
    return j >= Jreturni32 and j <= Jreturn

func is_narrow_param(o: i64) -> bool:
    return o >= Oparami8 and o <= Oparamu16

func is_narrow_arg(o: i64) -> bool:
    return o >= Oargi8 and o <= Oargu16

func is_cmov(o: i64) -> bool:
    return o >= Oamd64cmoveqi and o <= Oamd64cmovunorderedf

func is_atomic(o: i64) -> bool:
    return o >= Oatomicload and o <= Oatomicswap or o >= Oatomicexpected and o <= Oatomiccompareswap

func wide(k: i64) -> i64:
    return k and 1

func bank(k: i64) -> i64:
    if k == Vector:
        return 1
    return k >> 1

func arg_class(i: Instr, n: i64) -> i64:
    return OPERATIONS[i.op].arg_class[n * 5 + i64(i.cls)]

# an instruction, where it is
func at(b: i64, k: i64) -> i64:
    return b << 32 or k

func instr_at(at: i64) -> *Instr:
    return ptr(fn.blocks[at >> 32].ins[at and 0xffff_ffff])

func is_compare(op: i64, pk: *i64, pc: *i64) -> bool:
    if Oeqi32 <= op and op <= Oltu32:
        pc.* = op - Oeqi32
        pk.* = Int32
    elif Oeqi64 <= op and op <= Oltu64:
        pc.* = op - Oeqi64
        pk.* = Int64
    elif Oeqf32 <= op and op <= Ounorderedf32:
        pc.* = INT_CONDITIONS + op - Oeqf32
        pk.* = Float32
    elif Oeqf64 <= op and op <= Ounorderedf64:
        pc.* = INT_CONDITIONS + op - Oeqf64
        pk.* = Float64
    else:
        return false
    return true

func emit(op: i64, k: i64, to: Ref, a0: Ref, a1: Ref):
    append(fn.out, Instr{op = i32(op), cls = i32(k), to = to, arg = [a0, a1]})

func emit(i: Instr):
    append(fn.out, i)

# the instructions of b become what emit made
func take_emitted(b: i64):
    ins := ptr(fn.blocks[b].ins)
    ins.len = 0
    for k in reverse 0..fn.out.len:
        append(ins, fn.out[k])
    fn.out.len = 0

func add_instr(ins: *&list[Instr], i: Instr):
    if i.op != Onop:
        append(ins, i)

func swapped(c: i64) -> i64: # the comparison with its arguments swapped
    return [Eqi, Nei, Lei, Lti, Gei, Gti, Leu, Ltu, Geu, Gtu, INT_CONDITIONS + Eqf, INT_CONDITIONS + Lef, INT_CONDITIONS + Ltf, INT_CONDITIONS + Gef, INT_CONDITIONS + Gtf, INT_CONDITIONS + Nef, INT_CONDITIONS + Orderedf, INT_CONDITIONS + Unorderedf][c]

# merges the class k into pk, and says whether they clash
func merge_class(pk: *i32, k: i64) -> bool:
    k1 := i64(pk.*)
    if k1 == Unknown:
        pk.* = i32(k)
        return false
    if k1 == Int32 and k == Int64 or k1 == Int64 and k == Int32:
        pk.* = Int32
        return false
    return k1 != k

func phi_class(t: i64) -> i64:
    t1 := i64(fn.temps[t].phi)
    if t1 == 0:
        return t
    t1 = phi_class(t1)
    fn.temps[t].phi = i32(t1)
    return t1

func phi_arg_index(p: i64, b: i64) -> i64:
    if p != 0:
        for n, from in fn.phis[p].blocks:
            if from == b:
                return n
    return -1

func phi_arg(p: i64, b: i64) -> Ref:
    return fn.phis[p].arg[phi_arg_index(p, b)]

func new_phi(to: Ref, cls: i64) -> i64:
    fn.phi_count += 1
    if fn.phi_count == fn.phis.len:
        append(fn.phis, Phi{})
    p := ptr(fn.phis[fn.phi_count])
    p.arg.len = 0
    p.blocks.len = 0
    p.* = Phi{to = to, cls = i32(cls), arg = p.arg, blocks = p.blocks}
    return fn.phi_count

func new_temp(k: i64) -> Ref:
    t := fn.temp_count
    fn.temp_count += 1
    if t == fn.temps.len:
        append(fn.temps, Temporary{})
    p := ptr(fn.temps[t])
    p.uses.len = 0
    p.* = Temporary{uses = p.uses, cls = i32(k), slot = -1, used = 1, defs = 1}
    return u32(t)

func add_uses(r: Ref, du: i64):
    if ref_kind(r) == RefTemp:
        fn.temps[r].used += i32(du)

func constant_place(c: Immediate) -> i64:
    h := u64(c.type) + 3 * u64(c.access) + 7 * u64(c.symbol) + 11 * u64(c.bits)
    h = (h xor h >> 29) * 0x9e37_79b9_7f4a_7c15
    mask := fn.constant_hash.len - 1
    s := i64(h >> 32) and mask
    while true:
        k := fn.constant_hash[s]
        if k == 0:
            return s
        o := fn.constants[k]
        if c.type == o.type and c.access == o.access and c.symbol == o.symbol and c.bits == o.bits:
            return s
        s = (s + 1) and mask

# constants are found through a hash of their index, rebuilt as it fills
func intern(c: Immediate) -> Ref:
    if fn.constant_hash.len < 2 * fn.constants.len:
        size := 64
        while size < 4 * fn.constants.len:
            size *= 2
        fn.constant_hash.len = 0
        for k in 0..size:
            append(fn.constant_hash, 0)
        for i in 1..fn.constants.len:
            fn.constant_hash[constant_place(fn.constants[i])] = i
    s := constant_place(c)
    if fn.constant_hash[s] == 0:
        fn.constant_hash[s] = fn.constants.len
        append(fn.constants, c)
    return ref(RefConstant, fn.constant_hash[s])

func intern(val: i64) -> Ref:
    return intern(Immediate{type = Numeric, bits = val})

func add_constant(c0: *Immediate, c1: Immediate, m: i64) -> bool:
    if m != 1 and c1.type == Addressed:
        return false
    if c0.type == Unset:
        c0.* = c1
        c0.bits *= m
    else:
        if c1.type == Addressed:
            if c0.type == Addressed:
                return false
            c0.type = Addressed
            c0.access = c1.access
            c0.symbol = c1.symbol
        c0.bits += c1.bits * m
    return true

func bits_of(r: Ref, v: *i64) -> bool:
    if ref_kind(r) == RefConstant and fn.constants[ref_value(r)].type == Numeric:
        v.* = fn.constants[ref_value(r)].bits
        return true
    return false

func intern(name: &strview) -> i64:
    found := asm.symbol_ids[name]
    if found is i64:
        return found
    kept: &strview = heap(name) # the map keeps the view, not the bytes
    put(asm.symbol_ids, kept, asm.symbols.len)
    append(asm.symbols, kept)
    return asm.symbols.len - 1

# the stack a function takes stays aligned to 16
func stack_alloc(rt: Ref, rs: Ref):
    fn.dynamic_alloc = true
    if ref_kind(rs) == RefConstant:
        sz := fn.constants[ref_value(rs)].bits
        if sz < 0 or sz >= 2147483647 - 15:
            panic("invalid alloc size " + sz)
        sz = (sz + 15) and -16
        emit(Ostackalloc, Int64, rt, intern(sz), EMPTY)
    else:
        r0 := new_temp(Int64)
        r1 := new_temp(Int64)
        emit(Ostackalloc, Int64, rt, r0, EMPTY)
        emit(Oand, Int64, r0, r1, intern(-16))
        emit(Oadd, Int64, r1, rs, intern(15))
        if fn.temps[rs].slot != -1:
            panic("unlikely alloc argument in " + fn.name)

func clear(s: *Bitset):
    s.t.len = 0
    s.w.len = 0
    append(s.t, 0)
    append(s.w, 0)

func popcount(b: u64) -> i64:
    b = (b and 0x5555_5555_5555_5555) + (b >> 1 and 0x5555_5555_5555_5555)
    b = (b and 0x3333_3333_3333_3333) + (b >> 2 and 0x3333_3333_3333_3333)
    b = (b and 0x0f0f_0f0f_0f0f_0f0f) + (b >> 4 and 0x0f0f_0f0f_0f0f_0f0f)
    b += b >> 8
    b += b >> 16
    b += b >> 32
    return i64(b and 0xff)

DEBRUIJN: array[u8, 64] = [0, 1, 2, 53, 3, 7, 54, 27, 4, 38, 41, 8, 34, 55, 48, 28, 62, 5, 39, 46, 44, 42, 22, 9, 24, 35, 59, 56, 49, 18, 29, 11, 63, 52, 6, 26, 37, 40, 33, 47, 61, 45, 43, 21, 23, 58, 17, 10, 51, 25, 36, 32, 60, 20, 57, 16, 50, 31, 19, 15, 30, 14, 13, 12]

# the first word with an index of w or more
func word_index(s: *Bitset, w: u32) -> i64:
    if i64(w) < s.t.len and s.w[w] == w:
        return i64(w) # no word missing up to w
    lo := 0
    hi := s.t.len
    while lo < hi:
        m := (lo + hi) / 2
        if s.w[m] < w:
            lo = m + 1
        else:
            hi = m
    return lo

func word_of(s: *Bitset, w: u32) -> u64:
    n := word_index(s, w)
    if n < s.t.len and s.w[n] == w:
        return s.t[n]
    return 0

func has(s: *Bitset, e: i64) -> bool:
    return (word_of(s, u32(e / BITS)) and u64(1) << (e % BITS)) != 0

func count(s: *Bitset) -> i64:
    n := 0
    for w in s.t:
        n += popcount(w)
    return n

func include(s: *Bitset, e: i64):
    w := u32(e / BITS)
    n := word_index(s, w)
    if n == s.t.len or s.w[n] != w:
        insert(s.t, n, 0)
        insert(s.w, n, w)
    s.t[n] = s.t[n] or u64(1) << (e % BITS)

func exclude(s: *Bitset, e: i64):
    w := u32(e / BITS)
    n := word_index(s, w)
    if n == s.t.len or s.w[n] != w:
        return
    s.t[n] = s.t[n] and not (u64(1) << (e % BITS))
    if n != 0 and s.t[n] == 0:
        _ = remove(s.t, n)
        _ = remove(s.w, n)

func copy_set(a: *Bitset, b: *Bitset):
    a.t = b.t[:]
    a.w = b.w[:]

func include_all(a: *Bitset, b: *Bitset):
    n := a.t.len
    i := 0
    for j in 0..b.t.len:
        while i < a.t.len and a.w[i] < b.w[j]:
            i += 1
        if i == a.t.len or a.w[i] != b.w[j]:
            n += 1
    i = a.t.len
    while a.t.len < n:
        append(a.t, 0)
        append(a.w, 0)
    j := b.t.len
    while j > 0: # merge from the end, in place
        n -= 1
        if i > 0 and a.w[i - 1] >= b.w[j - 1]:
            i -= 1
            a.w[n] = a.w[i]
            a.t[n] = a.t[i]
            if a.w[n] == b.w[j - 1]:
                j -= 1
                a.t[n] = a.t[n] or b.t[j]
        else:
            j -= 1
            a.w[n] = b.w[j]
            a.t[n] = b.t[j]

func intersect(a: *Bitset, b: *Bitset):
    n := 0
    for i in 0..a.t.len:
        a.t[n] = a.t[i] and word_of(b, a.w[i])
        a.w[n] = a.w[i]
        if n == 0 or a.t[n] != 0:
            n += 1
    a.t.len = n
    a.w.len = n

# the first element of s at or past e, or -1
func next_in(s: *Bitset, e: i64) -> i64:
    w := u32(e / BITS)
    t := word_index(s, w)
    if t >= s.t.len:
        return -1
    b := s.t[t]
    if s.w[t] == w:
        b = b and not ((u64(1) << (e % BITS)) - 1)
    while b == 0:
        t += 1
        if t >= s.t.len:
            return -1
        b = s.t[t]
    return BITS * i64(s.w[t]) + i64(DEBRUIJN[((b and 0 - b) * 0x022f_dd63_cc95_386d) >> 58]) # the lowest bit set

func new_block() -> i64:
    fn.block_count += 1
    if fn.block_count == fn.blocks.len:
        append(fn.blocks, BasicBlock{})
    b := ptr(fn.blocks[fn.block_count])
    b.ins.len = 0
    b.frontier.len = 0
    b.preds.len = 0
    b.targets.len = 0
    b.table.len = 0
    b.* = BasicBlock{ins = b.ins, frontier = b.frontier, preds = b.preds, targets = b.targets, table = b.table, live_in = b.live_in, live_out = b.live_out, gen = b.gen}
    return fn.block_count

# the blocks b jumps to: the targets of its jump table, or s1 and s2 once, which pair holds for the view
func successors(b: i64, pair: *array[i64, 2]) -> &listview[i64]:
    p := ptr(fn.blocks[b])
    if p.exit.type == Jtable:
        return p.targets
    pair[0] = p.yes
    pair[1] = p.no
    s: &listview[i64]
    s = ptr(pair[0])
    s.len = i64(p.yes != 0) + i64(p.no != 0 and p.no != p.yes)
    return s

func fill_preds():
    b := fn.start
    while b != 0:
        fn.blocks[b].preds.len = 0
        b = fn.blocks[b].next
    b = fn.start
    while b != 0:
        pair: array[i64, 2]
        for s in successors(b, ptr(pair)):
            pred := ptr(fn.blocks[s].preds)
            if pred.len == 0 or pred[-1] != b: # simpljmp can send two targets to one block
                append(pred, b)
        b = fn.blocks[b].next

func post_order(b: i64):
    if b == 0 or fn.blocks[b].id != -1:
        return
    fn.blocks[b].id = 0 # a mark
    s1 := fn.blocks[b].yes
    s2 := fn.blocks[b].no
    if s1 != 0 and s2 != 0 and fn.blocks[s1].loop > fn.blocks[s2].loop:
        s1 = fn.blocks[b].no
        s2 = fn.blocks[b].yes
    post_order(s1)
    post_order(s2)
    for s in reverse fn.blocks[b].targets: # the first one comes first after b
        post_order(s)
    fn.blocks[b].id = fn.ordered
    fn.ordered += 1

func order_blocks():
    b := fn.start
    while b != 0:
        fn.blocks[b].id = -1
        b = fn.blocks[b].next
    fn.ordered = 0
    post_order(fn.start)
    fn.order.len = 0
    for n in 0..fn.ordered:
        append(fn.order, 0)
    marks: &list[Instr] = heap([])
    defer free(marks)
    prev := 0
    b = fn.start
    while b != 0:
        next := fn.blocks[b].next
        if fn.blocks[b].id != -1:
            fn.blocks[b].id = fn.ordered - fn.blocks[b].id - 1
            fn.order[fn.blocks[b].id] = b
            prev = b
            b = next
            continue
        if prev == 0:
            fn.start = next
        else:
            fn.blocks[prev].next = next
        # the marks of a dead block go to the start of the block after it, so with -debug they keep their place
        marks.len = 0
        for i in fn.blocks[b].ins:
            if i.op == Odebugmark:
                add_instr(marks, i)
        if marks.len > 0 and next != 0:
            for i in fn.blocks[next].ins:
                add_instr(marks, i)
            fn.blocks[next].ins = marks[:]
        b = next
    fill_preds()
    # the phis keep the arguments of the predecessors that remain
    b = fn.start
    while b != 0:
        p := fn.blocks[b].phi
        while p != 0:
            ph := ptr(fn.phis[p])
            n0 := 0
            for n in 0..ph.arg.len:
                bp := ph.blocks[n]
                if fn.blocks[bp].id != -1 and (fn.blocks[bp].yes == b or fn.blocks[bp].no == b or contains(fn.blocks[bp].targets, b)):
                    ph.blocks[n0] = bp
                    ph.arg[n0] = ph.arg[n]
                    n0 += 1
            ph.blocks.len = n0
            ph.arg.len = n0
            p = ph.next
        b = fn.blocks[b].next

func number_dominated(b: i64, n: i64) -> i64:
    fn.blocks[b].dom_from = n
    n += 1
    d := fn.blocks[b].dominated
    while d != 0:
        n = number_dominated(d, n)
        d = fn.blocks[d].sibling
    fn.blocks[b].dom_to = n
    return n

func fill_dominators():
    b := fn.start
    while b != 0:
        fn.blocks[b].dominator = 0
        fn.blocks[b].dominated = 0
        fn.blocks[b].sibling = 0
        b = fn.blocks[b].next
    changed := true
    while changed:
        changed = false
        for n in 1..fn.ordered:
            b = fn.order[n]
            d := 0
            pred := fn.blocks[b].preds
            for p in reverse 0..pred.len:
                if fn.blocks[pred[p]].dominator == 0 and pred[p] != fn.start:
                    continue
                # the nearest common dominator, as Cooper, Harvey and Kennedy find it
                b2 := pred[p]
                if d == 0:
                    d = b2
                while d != b2:
                    if fn.blocks[d].id < fn.blocks[b2].id:
                        bt := d
                        d = b2
                        b2 = bt
                    while fn.blocks[d].id > fn.blocks[b2].id:
                        d = fn.blocks[d].dominator
            if d != fn.blocks[b].dominator:
                changed = true
                fn.blocks[b].dominator = d
    b = fn.start
    while b != 0:
        d := fn.blocks[b].dominator
        if d != 0:
            fn.blocks[b].sibling = fn.blocks[d].dominated
            fn.blocks[d].dominated = b
        b = fn.blocks[b].next
    _ = number_dominated(fn.start, 0)

func strictly_dominates(b1: i64, b2: i64) -> bool:
    return fn.blocks[b1].dom_from < fn.blocks[b2].dom_from and fn.blocks[b2].dom_from < fn.blocks[b1].dom_to

func dominates(b1: i64, b2: i64) -> bool:
    return b1 == b2 or strictly_dominates(b1, b2)

func mark_loop(hd: i64, b: i64, f: func(i64, i64)):
    if fn.blocks[b].id < fn.blocks[hd].id or fn.blocks[b].visit == fn.blocks[hd].id:
        return
    fn.blocks[b].visit = fn.blocks[hd].id
    f(hd, b)
    for p in 0..fn.blocks[b].preds.len:
        mark_loop(hd, fn.blocks[b].preds[p], f)

func each_loop(f: func(i64, i64)):
    b := fn.start
    while b != 0:
        fn.blocks[b].visit = -1
        b = fn.blocks[b].next
    for n in 0..fn.ordered:
        b = fn.order[n]
        for p in 0..fn.blocks[b].preds.len:
            pred := fn.blocks[b].preds[p]
            if fn.blocks[pred].id >= n:
                mark_loop(b, pred, f)

func weigh_loop(hd: i64, b: i64):
    fn.blocks[b].loop *= 10

func fill_loops():
    b := fn.start
    while b != 0:
        fn.blocks[b].loop = 1
        b = fn.blocks[b].next
    each_loop(weigh_loop)

func find_root(b: i64, uf: &list[i64]) -> i64:
    id := fn.blocks[b].id
    if uf[id] != 0:
        uf[id] = find_root(uf[id], uf)
        return uf[id]
    return b

# a block that only jumps on is skipped
func skip_jumps():
    ret := new_block()
    fn.blocks[ret].id = fn.ordered
    fn.ordered += 1
    fn.blocks[ret].exit.type = Jreturn
    uf: &list[i64] = heap([]) # union-find
    defer free(uf)
    for n in 0..fn.ordered:
        append(uf, 0)
    b := fn.start
    while b != 0:
        p := ptr(fn.blocks[b])
        if p.exit.type == Jreturn:
            p.exit.type = Jjump
            p.yes = ret
        if p.ins.len == 0 and p.exit.type == Jjump:
            p.yes = find_root(p.yes, uf)
            if p.yes != b:
                uf[p.id] = p.yes
        b = p.next
    last := 0
    b = fn.start
    while b != 0:
        p := ptr(fn.blocks[b])
        if p.yes != 0:
            p.yes = find_root(p.yes, uf)
        if p.no != 0:
            p.no = find_root(p.no, uf)
        if p.yes != 0 and p.yes == p.no:
            p.exit.type = Jjump
            p.no = 0
        for k in 0..p.targets.len:
            p.targets[k] = find_root(p.targets[k], uf)
        last = b
        b = p.next
    fn.blocks[last].next = ret

func leads_to(b: i64, to: i64) -> bool:
    if b == to:
        return true
    if b == 0 or fn.blocks[b].visit != 0:
        return false
    fn.blocks[b].visit = 1
    pair: array[i64, 2]
    for s in successors(b, ptr(pair)):
        if leads_to(s, to):
            return true
    return false

func unvisit(b: i64):
    if b != 0 and fn.blocks[b].visit != 0:
        fn.blocks[b].visit = 0
        pair: array[i64, 2]
        for s in successors(b, ptr(pair)):
            unvisit(s)

type Route: # a block's jump, as simplcfg moves it
    type: i32
    arg: Ref
    yes: i64
    no: i64

func simplify_flow():
    b := fn.start
    while b != 0:
        if fn.blocks[b].preds.len == 1:
            bb := fn.blocks[b].preds[0]
            p := fn.blocks[b].phi
            while p != 0:
                add_instr(ptr(fn.blocks[bb].ins), Instr{op = Ocopy, cls = fn.phis[p].cls, to = fn.phis[p].to, arg = [phi_arg(p, bb), EMPTY]})
                p = fn.phis[p].next
            fn.blocks[b].phi = 0
        b = fn.blocks[b].next
    jmp: &list[Route] = heap([])
    defer free(jmp)
    empty: &list[bool] = heap([])
    defer free(empty)
    for n in 0..fn.ordered:
        append(jmp, Route{})
        append(empty, false)
    b = fn.start
    while b != 0:
        p := ptr(fn.blocks[b])
        jmp[p.id] = Route{p.exit.type, p.exit.arg, p.yes, p.no}
        empty[p.id] = p.phi == 0 and p.exit.type != Jtable
        for i in p.ins:
            if i.op != Onop and i.op != Odebugline:
                empty[p.id] = false
                break
        b = p.next
    done := false
    while not done:
        done = true
        b = fn.start
        while b != 0:
            id := fn.blocks[b].id
            if id != -1:
                j := jmp[id]
                # with -debug a block stays where it is, so a scope stays one range of code; a jump table stays in the
                # block that holds its targets
                if j.type == Jjump and fn.blocks[j.yes].preds.len == 1 and not comp.debug and jmp[fn.blocks[j.yes].id].type != Jtable:
                    s := j.yes
                    for k in 0..fn.blocks[s].ins.len:
                        add_instr(ptr(fn.blocks[b].ins), fn.blocks[s].ins[k])
                    empty[id] = empty[id] and empty[fn.blocks[s].id]
                    jj := jmp[fn.blocks[s].id]
                    for bb in [jj.yes, jj.no]:
                        if bb != 0:
                            p := fn.blocks[bb].phi
                            while p != 0:
                                fn.phis[p].blocks[phi_arg_index(p, s)] = b
                                p = fn.phis[p].next
                    fn.blocks[s].id = -1
                    jmp[id] = jj
                    done = false
                elif j.type == Jbranch and empty[fn.blocks[j.yes].id] and empty[fn.blocks[j.no].id]:
                    a := jmp[fn.blocks[j.yes].id]
                    c := jmp[fn.blocks[j.no].id]
                    if a.type == c.type and a.arg == c.arg and a.yes == c.yes and a.no == c.no and (a.yes == 0 or fn.blocks[a.yes].phi == 0) and (a.no == 0 or fn.blocks[a.no].phi == 0):
                        jmp[id] = a
                        done = false
            b = fn.blocks[b].next
    b = fn.start
    while b != 0:
        p := ptr(fn.blocks[b])
        if p.id != -1:
            j := jmp[p.id]
            p.exit.type = j.type
            p.exit.arg = j.arg
            p.yes = j.yes
            p.no = j.no
        b = p.next
    order_blocks()

func add_use(t: i64, type: i64, b: i64, at: i64):
    p := ptr(fn.temps[t])
    if not p.listed:
        return
    if i64(p.used) < p.uses.len:
        p.uses.len = i64(p.used)
    append(p.uses, Usage{i32(type), u32(fn.blocks[b].id), at})
    p.used += 1

# the uses, widths, phi classes and classes of the temps; the visits stay
func fill_uses():
    for t in FIRST_TEMP..fn.temp_count:
        p := ptr(fn.temps[t])
        p.def = 0
        p.block = 0xffff_ffff
        p.defs = 0
        p.used = 0
        p.cls = 0
        p.phi = 0
        p.width = FullWidth
        p.listed = true
        p.uses.len = 0
    b := fn.start
    while b != 0:
        p := fn.blocks[b].phi
        while p != 0:
            ph := fn.phis[p]
            tp := i64(ph.to)
            fn.temps[tp].block = u32(fn.blocks[b].id)
            fn.temps[tp].defs += 1
            fn.temps[tp].cls = ph.cls
            tp = phi_class(tp)
            for a in ph.arg:
                if ref_kind(a) == RefTemp:
                    add_use(i64(a), ByPhi, b, p)
                    t := phi_class(i64(a))
                    if t != tp:
                        fn.temps[t].phi = i32(tp)
            p = ph.next
        ins := fn.blocks[b].ins
        for k in 0..ins.len:
            i := ins[k]
            if i.to != EMPTY:
                w := FullWidth
                if is_narrow_param(i.op):
                    w = FromI8 + i64(i.op) - Oparami8
                if is_load(i.op) and i.op != Oload:
                    w = FromI8 + i64(i.op) - Oloadi8
                if is_extend(i.op):
                    w = FromI8 + i64(i.op) - Oexti8
                x := 0
                if is_compare(i.op, ptr(x), ptr(x)):
                    w = FromU8
                if (w == FromI32 or w == FromU32) and i.cls == Int32:
                    w = FullWidth
                t := ptr(fn.temps[i.to])
                t.width = i32(w)
                t.def = at(b, k)
                t.block = u32(fn.blocks[b].id)
                t.defs += 1
                t.cls = i.cls
            for m in 0..2:
                if ref_kind(i.arg[m]) == RefTemp:
                    add_use(i64(i.arg[m]), ByInstr, b, at(b, k))
        if ref_kind(fn.blocks[b].exit.arg) == RefTemp:
            add_use(i64(fn.blocks[b].exit.arg), ByExit, b, 0)
        b = fn.blocks[b].next

func new_version(t: i64) -> Ref:
    return new_temp(fn.temps[t].cls)

func free_version(n: i64):
    fn.versions[n].up = fn.free_version
    fn.free_version = n

func rename_def(r: Ref, b: i64, stk: &list[i64]) -> Ref:
    t := i64(r)
    if r == EMPTY or fn.temps[t].visit == 0:
        return r
    r1 := new_version(t)
    fn.temps[r1].visit = i32(t)
    n := fn.free_version
    if n != 0:
        fn.free_version = fn.versions[n].up
    else:
        n = fn.versions.len
        append(fn.versions, Version{})
    fn.versions[n] = Version{r1, b, stk[t]}
    stk[t] = n
    return r1

func version_in(t: i64, b: i64, stk: &list[i64]) -> Ref:
    n := stk[t]
    while n != 0 and not dominates(fn.versions[n].b, b):
        n1 := n
        n = fn.versions[n].up
        free_version(n1)
    stk[t] = n
    if n == 0:
        return UNDEF
    return fn.versions[n].r

func rename_block(b: i64, stk: &list[i64]):
    p := fn.blocks[b].phi
    while p != 0:
        fn.phis[p].to = rename_def(fn.phis[p].to, b, stk)
        p = fn.phis[p].next
    for k in 0..fn.blocks[b].ins.len:
        for m in 0..2:
            a := fn.blocks[b].ins[k].arg[m]
            if ref_kind(a) == RefTemp and fn.temps[a].visit != 0:
                fn.blocks[b].ins[k].arg[m] = version_in(i64(a), b, stk)
        fn.blocks[b].ins[k].to = rename_def(fn.blocks[b].ins[k].to, b, stk)
    a := fn.blocks[b].exit.arg
    if ref_kind(a) == RefTemp and fn.temps[a].visit != 0:
        fn.blocks[b].exit.arg = version_in(i64(a), b, stk)
    pair: array[i64, 2]
    for s in successors(b, ptr(pair)):
        p = fn.blocks[s].phi
        while p != 0:
            t := i64(fn.temps[fn.phis[p].to].visit)
            if t != 0:
                r := version_in(t, b, stk)
                append(fn.phis[p].arg, r)
                append(fn.phis[p].blocks, b)
            p = fn.phis[p].next
    s := fn.blocks[b].dominated
    while s != 0:
        rename_block(s, stk)
        s = fn.blocks[s].sibling

func ssa():
    nt := fn.temp_count
    fill_dominators()
    # the dominance frontier
    b := fn.start
    while b != 0:
        fn.blocks[b].frontier.len = 0
        b = fn.blocks[b].next
    b = fn.start
    while b != 0:
        pair: array[i64, 2]
        for s in successors(b, ptr(pair)):
            a := b
            while not strictly_dominates(a, s) and not contains(fn.blocks[a].frontier, s):
                append(fn.blocks[a].frontier, s)
                a = fn.blocks[a].dominator
        b = fn.blocks[b].next
    filllive()
    u: Bitset
    defs: Bitset
    clear(ptr(u))
    clear(ptr(defs))
    # the definitions of each temporary and their blocks, so it is not searched for in the others
    d0: &list[i64] = heap([])
    nd: &list[i64] = heap([])
    n := 0
    for t in 0..nt:
        append(d0, n)
        append(nd, 0)
        if t >= FIRST_TEMP:
            n += i64(fn.temps[t].defs)
    di: &list[i64] = heap([])
    db: &list[i64] = heap([])
    for k in 0..n:
        append(di, 0)
        append(db, 0)
    b = fn.start
    while b != 0:
        fn.blocks[b].visit = 0
        ins := fn.blocks[b].ins
        for k in 0..ins.len:
            t := i64(ins[k].to)
            if ref_kind(ins[k].to) == RefTemp and t >= FIRST_TEMP:
                di[d0[t] + nd[t]] = at(b, k)
                db[d0[t] + nd[t]] = b
                nd[t] += 1
        b = fn.blocks[b].next
    of: &list[i64] = heap([])
    stack: &list[i64] = heap([])
    for t in FIRST_TEMP..nt:
        fn.temps[t].visit = 0
        if fn.temps[t].phi != 0:
            continue
        if fn.temps[t].defs == 1:
            ok := true
            defb := fn.order[fn.temps[t].block]
            for use in fn.temps[t].uses[:fn.temps[t].used]:
                ok = ok and dominates(defb, fn.order[use.block])
            if ok:
                continue
        clear(ptr(u))
        k: i32 = Unknown
        stack.len = 0
        for d in d0[t]..d0[t] + nd[t]:
            b = db[d]
            i := instr_at(di[d])
            if not has(ptr(fn.blocks[b].live_out), t):
                # dead at the end of its block, it gets a name of its own, given below to the uses that follow it there
                i.to = new_version(t)
                while of.len <= i64(i.to) - nt:
                    append(of, 0)
                of[i64(i.to) - nt] = t
                continue
            if not has(ptr(u), fn.blocks[b].id):
                include(ptr(u), fn.blocks[b].id)
                append(stack, b)
            if merge_class(ptr(k), i64(i.cls)):
                panic("invalid input")
        copy_set(ptr(defs), ptr(u))
        while stack.len > 0:
            fn.temps[t].visit = i32(t)
            b = trust pop(stack)
            exclude(ptr(u), fn.blocks[b].id)
            for a in fn.blocks[b].frontier:
                if fn.blocks[a].visit == t:
                    continue
                fn.blocks[a].visit = t
                if has(ptr(fn.blocks[a].live_in), t):
                    p := new_phi(u32(t), i64(k))
                    fn.phis[p].next = fn.blocks[a].phi
                    fn.blocks[a].phi = p
                    if not has(ptr(defs), fn.blocks[a].id) and not has(ptr(u), fn.blocks[a].id):
                        include(ptr(u), fn.blocks[a].id)
                        append(stack, a)
    # name[t] holds in the block at[t]
    name: &list[Ref] = heap([])
    within: &list[i64] = heap([])
    for t in 0..nt:
        append(name, EMPTY)
        append(within, 0)
    b = fn.start
    while b != 0:
        ins := ptr(fn.blocks[b].ins)
        for k in 0..ins.len:
            for m in 0..2:
                t := i64(ins[k].arg[m])
                if ref_kind(ins[k].arg[m]) == RefTemp and t < nt and within[t] == b:
                    ins[k].arg[m] = name[t]
            if ref_kind(ins[k].to) == RefTemp and i64(ins[k].to) >= nt:
                t := of[i64(ins[k].to) - nt]
                name[t] = ins[k].to
                within[t] = b
        t := i64(fn.blocks[b].exit.arg)
        if ref_kind(fn.blocks[b].exit.arg) == RefTemp and t < nt and within[t] == b:
            fn.blocks[b].exit.arg = name[t]
        b = fn.blocks[b].next
    free(name)
    free(within)
    free(of)
    free(stack)
    free(di)
    free(db)
    free(nd)
    free(d0)
    free(u.t)
    free(u.w)
    free(defs.t)
    free(defs.w)
    stk: &list[i64] = heap([]) # the versions of each temp, the innermost first
    defer free(stk)
    for t in 0..nt:
        append(stk, 0)
    rename_block(fn.start, stk)
    for t in reverse 0..nt:
        while stk[t] != 0:
            v := stk[t]
            stk[t] = fn.versions[v].up
            free_version(v)

func phi_misplaced(p: i64, b: i64, t: Ref) -> bool:
    for n in 0..fn.phis[p].arg.len:
        if fn.phis[p].arg[n] == t:
            b1 := fn.phis[p].blocks[n]
            if b1 != b and not strictly_dominates(b, b1):
                return true
    return false

func check_ssa():
    for t in FIRST_TEMP..fn.temp_count:
        if fn.temps[t].defs > 1:
            panic("an ssa temporary of " + fn.name + " is defined more than once")
        if fn.temps[t].used > 0 and fn.temps[t].defs == 0:
            panic("an ssa temporary of " + fn.name + " is used undefined")
    b := fn.start
    while b != 0:
        p := fn.blocks[b].phi
        while p != 0:
            r := fn.phis[p].to
            for u in fn.temps[r].uses[:fn.temps[r].used]:
                bu := fn.order[u.block]
                if u.type == ByPhi and phi_misplaced(u.at, b, r) or u.type != ByPhi and bu != b and not strictly_dominates(b, bu):
                    panic("a temporary of " + fn.name + " violates the ssa invariant")
            p = fn.phis[p].next
        for k in 0..fn.blocks[b].ins.len:
            r := fn.blocks[b].ins[k].to
            if ref_kind(r) != RefTemp:
                continue
            for u in fn.temps[r].uses[:fn.temps[r].used]:
                bu := fn.order[u.block]
                bad := false
                if u.type == ByPhi:
                    bad = phi_misplaced(u.at, b, r)
                elif bu == b:
                    bad = u.type == ByInstr and u.at <= at(b, k)
                else:
                    bad = not strictly_dominates(b, bu)
                if bad:
                    panic("a temporary of " + fn.name + " violates the ssa invariant")
        b = fn.blocks[b].next

# a proc of comp lowered to the function in fn

func start_function(name: &strview, export: bool):
    if fn.blocks.len == 0:
        append(fn.blocks, BasicBlock{})
        append(fn.phis, Phi{})
        append(fn.versions, Version{})
    fn.block_count = 0
    fn.phi_count = 0
    fn.temp_count = 0
    fn.constants.len = 0
    append(fn.constants, Immediate{type = Numeric, bits = 0xdead_dead}) # UNDEF
    append(fn.constants, Immediate{type = Numeric})
    fn.constant_hash.len = 0
    fn.addresses.len = 0
    fn.start = 0
    fn.order.len = 0
    fn.ordered = 0
    fn.retty = -1
    fn.retr = EMPTY
    fn.reg = 0
    fn.slot = 0
    fn.dynamic_alloc = false
    fn.leaf = true
    fn.name = name
    fn.export = export
    fn.marks.len = 0
    fn.out.len = 0
    m := ptr(asm.machine)
    for k in 0..FIRST_TEMP:
        _ = new_temp(Float64 if m.first_float <= k and k < m.first_float + m.floats else Int64)

# the classes past those of values: those that only pass, a type, and nothing
Int8 = 5
Uint8 = 6
Int16 = 7
Uint16 = 8
Aggregate = 9
Nothing = 10

# the class of a value, a parameter or an argument of class c of comp, and its aggregate type, or -1
func class_of(c: i64) -> (i64, i64):
    if c >= CAGG:
        return Aggregate, asm.c_layout_of[c - CAGG]
    if c >= AGG:
        return Aggregate, asm.layout_of[c - AGG]
    return c, -1

# the temp of comp's temp n, or R for none
func temp_ref(n: i64) -> Ref:
    if n == 0:
        return EMPTY
    k := n - fn.first_temp
    if fn.temp_of[k] == EMPTY:
        fn.temp_of[k] = new_temp(Unknown)
    return fn.temp_of[k]

func ref_of(a: Arg) -> Ref:
    switch a.kind:
    case Empty:
        return EMPTY
    case Temp:
        return temp_ref(a.n)
    case Global:
        return intern(asm.globals[a.n])
    case Single: # the bits of the f32, which the arg holds as an f64
        return intern(i64(f32(a.n as f64) as u32))
    case:
        return intern(a.n)

func label_block(label: i64) -> i64:
    k := label - fn.first_label
    while fn.block_of.len <= k:
        append(fn.block_of, 0)
    if fn.block_of[k] == 0:
        fn.block_of[k] = new_block()
    return fn.block_of[k]

func close_block(type: i64, arg: Ref, s1: i64, s2: i64):
    b := ptr(fn.blocks[fn.last])
    b.exit = Exit{i32(type), arg}
    b.yes = s1
    b.no = s2

func lower(p: Proc):
    start_function(p.name[1:], p.export)
    fn.first_temp = i64(p.temps)
    fn.temp_of.len = 0
    for t in p.temps..=p.last:
        append(fn.temp_of, EMPTY)
    fn.first_label = i64(p.labels)
    fn.block_of.len = 0
    rcls, retty := class_of(p.cls)
    fn.retty = retty
    pars: &list[Instr] = heap([])
    defer free(pars)
    for given in comp.passes[p.params:p.params + p.count]:
        kc, ty := class_of(given.cls)
        to := ref_of(given.arg)
        if kc == Aggregate:
            append(pars, Instr{op = Oparamaggregate, cls = Int64, to = to, arg = [ref(RefType, ty), EMPTY]})
        elif kc >= Int8:
            append(pars, Instr{op = i32(Oparami8 + kc - Int8), cls = Int32, to = to})
        else:
            append(pars, Instr{op = Oparam, cls = i32(kc), to = to})
    fn.start = new_block()
    fn.last = fn.start
    append(fn.blocks[fn.start].ins, pars[:])
    shown := 0
    line := 0
    slotted := not comp.debug
    for i in comp.code[p.code:p.end]:
        ins := ptr(fn.blocks[fn.last].ins)
        if not slotted and not is_alloc(i.op):
            slotted = true # the allocs are first, and the emitter says where each one went
            for m in p.mentions..p.mentioned:
                slot := comp.mentions[m].pointer
                if slot == 0:
                    slot = comp.mentions[m].temp
                append(ins, Instr{op = Odebugslot, cls = Int32, arg = [temp_ref(i64(slot)), ref(RefInt, m)]})
            # the prologue takes this line, so a debugger stops after it with the parameters in place
            shown = declared_at(p)
            line = line_of(shown)
            append(ins, Instr{op = Odebugline, cls = Int32, arg = [ref(RefInt, line), ref(RefInt, shown - line_start(shown) + 1)]})
        if i.pos != 0 and i.pos != shown and i.op != Olabel and not is_alloc(i.op):
            shown = i.pos
            if line_of(i.pos) != line:
                line = line_of(i.pos)
                append(ins, Instr{op = Odebugline, cls = Int32, arg = [ref(RefInt, line), ref(RefInt, i.pos - line_start(i.pos) + 1)]})
        switch i.op:
        case Olabel:
            to := label_block(i.a.n)
            if fn.blocks[fn.last].exit.type == Jnone:
                close_block(Jjump, EMPTY, to, 0)
            fn.blocks[fn.last].next = to
            fn.last = to
            if comp.debug:
                shown = 0 # a block starts a row of the line table, so a debugger stops where a jump lands
                line = 0
        case Ojump:
            close_block(Jjump, EMPTY, label_block(i.a.n), 0)
        case Obranch:
            r := ref_of(i.a)
            close_block(Jbranch, r, label_block(i.b.n), label_block(i.c.n))
        case Otable:
            close_block(Jtable, ref_of(i.a), 0, 0)
            places: &map[i64, i64] = heap({}) # of each target, its place in targets
            for given in comp.passes[i.first:i.first + i.count]:
                s := label_block(given.arg.n)
                if not contains(places, s):
                    put(places, s, fn.blocks[fn.last].targets.len)
                    append(fn.blocks[fn.last].targets, s)
                append(fn.blocks[fn.last].table, trust places[s])
            free(places)
        case Oreturn:
            if i.a.kind == Empty or rcls == Nothing:
                close_block(Jreturn, EMPTY, 0, 0)
            else:
                close_block(Jreturni32 + rcls - i64(rcls >= Int8), ref_of(i.a), 0, 0)
        case Ohalt:
            close_block(Jhalt, EMPTY, 0, 0)
        case Ocall:
            to := temp_ref(i64(i.to))
            kc, ty := class_of(i.cls)
            fn.leaf = false
            callee := ref_of(i.a)
            for given in comp.passes[i.first:i.first + i.count]:
                if given.cls == Nothing:
                    append(ins, Instr{op = Oargvariadic})
                    continue
                c, ty2 := class_of(given.cls)
                r := ref_of(given.arg)
                if c == Aggregate:
                    append(ins, Instr{op = Oargaggregate, cls = Int64, arg = [ref(RefType, ty2), r]})
                elif c >= Int8:
                    append(ins, Instr{op = i32(Oargi8 + c - Int8), cls = Int32, arg = [r, EMPTY]})
                else:
                    append(ins, Instr{op = Oarg, cls = i32(c), arg = [r, EMPTY]})
            kind: Ref = EMPTY
            if kc == Aggregate:
                kc = Int64
                kind = ref(RefType, ty)
            if kc >= Int8:
                kc = Int32
            append(ins, Instr{op = Ocall, cls = i32(kc), to = to, arg = [callee, kind]})
        case Oblit:
            a0 := ref_of(i.a)
            append(ins, Instr{op = Oblit, arg = [a0, ref_of(i.b)]})
            append(ins, Instr{op = Oblitsize, arg = [ref(RefInt, i.c.n), EMPTY]})
        case Oatomicexpected:
            to := temp_ref(i64(i.to))
            a0 := ref_of(i.a)
            a1 := ref_of(i.b)
            a2 := ref_of(i.c)
            append(ins, Instr{op = Oatomicexpected, cls = i32(i.cls), arg = [a1, EMPTY]})
            append(ins, Instr{op = Oatomiccompareswap, cls = i32(i.cls), to = to, arg = [a0, a2]})
        case Odebugmark:
            append(fn.marks, i.a.n)
            append(ins, Instr{op = Odebugmark, cls = Int32, arg = [ref(RefInt, fn.marks.len - 1), EMPTY]})
        case:
            to := temp_ref(i64(i.to))
            a0 := ref_of(i.a)
            append(ins, Instr{op = i32(i.op), cls = i32(i.cls), to = to, arg = [a0, ref_of(i.b)]})
    check_classes()

# a function the compiler makes itself, that returns what it reads from frame, or the address of data
func special(name: &strview, export: bool, data: &strview):
    start_function(name, export)
    fn.start = new_block()
    b := ptr(fn.blocks[fn.start])
    if data.len > 0:
        b.exit = Exit{Jreturni64, intern(Immediate{type = Addressed, symbol = i32(intern(data))})}
    else:
        f := new_temp(Unknown)
        c := new_temp(Unknown)
        append(b.ins, Instr{op = Oframe, cls = Int64, to = f})
        append(b.ins, Instr{op = Oload, cls = Int64, to = c, arg = [f, EMPTY]})
        b.exit = Exit{Jreturni64, c}
    check_classes()

# the classes of the temps, by those of the instructions that define them
func check_classes():
    fill_preds()
    b := fn.start
    while b != 0:
        for i in fn.blocks[b].ins:
            if i.to != EMPTY and merge_class(ptr(fn.temps[i.to].cls), i64(i.cls)):
                panic("a temporary of " + fn.name + " is assigned with multiple types")
        b = fn.blocks[b].next
    fn.ordered = fn.block_count
