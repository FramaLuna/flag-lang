    Operation{"flagiugt", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagiule", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagiult", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfeq", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfge", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfgt", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfle", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagflt", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfne", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfo", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"flagfuo", [-1, -1, -2, -2, -2, -1, -1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, true},
    Operation{"xselieq", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseline", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselisge", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselisgt", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselisle", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xselislt", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseliuge", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseliugt", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
    Operation{"xseliule", [0, 1, -2, -2, -2, 0, 1, -2, -2, -2], false, false, false, false, false, false, false, false, false, false, 0, false, false},
