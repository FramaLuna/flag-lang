type Ref = u32 # the kind of what it names, above bit 29, and its number

type Operation:
    name: &strview
    arg_class: array[i8, 10] # of the arguments 0 and 1 by the class of the instruction
    folds: bool
    has_identity: bool # has a value that changes nothing as its argument 1
    identity: bool # that value, 0 or 1
    commutes: bool
    associative: bool
    idempotent: bool
    int_equality: bool # an eq or ne of words or longs
    int_order: bool # an lt, gt, le or ge of words or longs
    equal_result: bool # what it gives for two equal arguments
    pinned: bool # gcm leaves it in its block
    memory_args: i8 # amd64: how many arguments may be in memory
    sets_zero: bool # amd64: sets the zero flag by its result
    keeps_flags: bool # amd64: leaves the flags

