# the condition of each comparison, and of its negation
ARM64_CONDITIONS: array[&strview, 36] = ["eq", "ne", "ne", "eq", "ge", "lt", "gt", "le", "le", "gt", "lt", "ge", "cs", "cc", "hi", "ls", "ls", "hi", "cc", "cs", "eq", "ne", "ge", "lt", "gt", "le", "ls", "hi", "mi", "pl", "ne", "eq", "vc", "vs", "vs", "vc"]

# the name of the register r as of class k
func arm64_emit_reg(r: i64, k: i64):
    assert r < FIRST_TEMP or r == V31, "a temp of " + fn.name + " has no register"
    if r == XSP:
        out("sp")
        return
    n := r - X0
    c: u8 = 'w' if k == Int32 else 'x'
    if r > X30:
        n = 31 if r == V31 else r - V0
        c = 'd'
        if k == Float32:
            c = 's'
        elif k == Vector:
            c = 'v'
        elif k == Vector + 1:
            c = 'q'
    add_byte(asm.text, c)
    asm.text += n

# the offset of a slot from x29: the parameters on the stack are above the frame
func arm64_slot_offset(r: Ref) -> i64:
    s := ref_signed(r)
    if s == -1:
        return 16 + arm64.frame
    if s < 0:
        return 16 + arm64.frame - (s + 2)
    return 16 + arm64.padding + 4 * s

# the instruction i as fmt says: the first space is a tab, %= %0 %1 are the result and the arguments, %M before them
# their memory, %? the scratch, and W L S D Q V before them name their register as of that class
func arm64_emit_format(fmt: &strview, i: *Instr):
    s := items(fmt)
    out("\t")
    tabbed := false
    x := 0
    while x < s.len:
        c := s[x]
        x += 1
        if c != '%':
            if c == ' ' and not tabbed:
                c = '\t'
                tabbed = true
            add_byte(asm.text, c)
            continue
        k := i64(i.cls)
        while true:
            c = s[x]
            x += 1
            switch c:
            case 'W':
                k = Int32
            case 'L':
                k = Int64
            case 'S':
                k = Float32
            case 'D':
                k = Float64
            case 'Q':
                k = Vector + 1 # a vector register named whole, for ldr and str
            case 'V':
                k = Vector
            case:
                break
        if c == '?':
            arm64_emit_reg(X17 if bank(k) == 0 else V31, k)
            continue
        memory := c == 'M'
        if memory:
            c = s[x]
            x += 1
        r := i.to if c == '=' else i.arg[c - '0']
        if memory and ref_kind(r) == RefSlot:
            out("[x29, ")
            asm.text += arm64_slot_offset(r)
            out("]")
        elif memory:
            out("[")
            arm64_emit_reg(i64(r), Int64)
            out("]")
        elif ref_kind(r) == RefInt:
            asm.text += ref_signed(r)
        elif ref_kind(r) == RefConstant:
            n := u64(fn.constants[ref_value(r)].bits)
            out("#")
            if n >> 24 == 0 and (n and 0xfff000) != 0:
                asm.text += n >> 12
                out(", lsl #12")
            else:
                asm.text += n
        else:
            arm64_emit_reg(i64(r), k)
    out("\n")

# whether a slot is past the reach of the offset of a load or store of sz bytes
func arm64_far(r: Ref, sz: i64) -> bool:
    return ref_kind(r) == RefSlot and arm64_slot_offset(r) > sz * 4095

func arm64_emit_instr(i: Instr):
    m := ptr(asm.machine)
    switch i.op:
    case Onop:
        return
    case Ocopy:
        if i.to == i.arg[0]:
            return
        if ref_kind(i.to) == RefSlot:
            r := i.to
            if not is_register(i.arg[0]):
                i.to = X17 if bank(i.cls) == 0 else V31 # a float goes through a float register
                arm64_emit_instr(i)
                i.arg[0] = i.to
            i.op = i32(Ostorei32 + i64(i.cls))
            i.cls = Int32
            i.arg[1] = r
            arm64_emit_instr(i)
            return
        switch ref_kind(i.arg[0]):
        case RefSlot:
            i.op = Oload
            arm64_emit_instr(i)
            return
        case RefConstant:
            c := fn.constants[ref_value(i.arg[0])]
            if c.type == Addressed:
                form: &strview = ""
                switch c.access:
                case Direct:
                    form = "\tadrp\tR, S@pageO\n\tadd\tR, R, S@pageoffO\n" if m.apple else "\tadrp\tR, SO\n\tadd\tR, R, #:lo12:SO\n"
                case ThroughGot:
                    form = "\tadrp\tR, S@gotpage\n\tldr\tR, [R, S@gotpageoff]\n" if m.apple else "\tadrp\tR, :got:S\n\tldr\tR, [R, #:got_lo12:S]\n"
                case:
                    if m.apple:
                        form = "\tadrp\tR, S@tlvppage\n\tldr\tR, [R, S@tlvppageoff]\n"
                    elif c.access == ThreadThroughGot:
                        # initial-exec: the offset from the thread pointer is in the GOT, x18 is free out of Apple
                        form = "\tadrp\tR, :gottprel:S\n\tldr\tR, [R, #:gottprel_lo12:S]\n\tmrs\tx18, tpidr_el0\n\tadd\tR, R, x18\n"
                    else:
                        form = "\tmrs\tR, tpidr_el0\n\tadd\tR, R, #:tprel_hi12:SO, lsl #12\n\tadd\tR, R, #:tprel_lo12_nc:SO\n"
                sym := asm.symbols[c.symbol] # R in form is the register, S the symbol and O its offset
                offset := c.bits
                below := 0 # the linker of Apple takes no negative offset on a page, so it is subtracted after
                if m.apple and offset < 0:
                    below = -offset
                    offset = 0
                assert below < 1 << 24, "an address " + below + " bytes below a symbol does not fit two subtractions in " + fn.name
                for b in items(form):
                    switch b:
                    case 'R':
                        arm64_emit_reg(i64(i.to), Int64)
                    case 'S':
                        if items(sym)[0] != '"':
                            out(m.symbol_prefix)
                        out(sym)
                    case 'O':
                        if offset != 0:
                            out("+")
                            asm.text += offset
                    case:
                        add_byte(asm.text, b)
                for shift in [12, 0]:
                    part := (below >> shift) and 4095
                    if part != 0:
                        out("\tsub\t")
                        arm64_emit_reg(i64(i.to), Int64)
                        out(", ")
                        arm64_emit_reg(i64(i.to), Int64)
                        out(", #")
                        asm.text += part
                        if shift != 0:
                            out(", lsl #12")
                        out("\n")
                return
            n := c.bits
            if wide(i.cls) == 0:
                n = n << 32 >> 32
            # mov takes a negative of 16 bits, or a bitmask immediate: a rotated run of ones repeated in 2, 4, 8, 16, 32 or
            # 64 bits; movk puts the other pieces of 16 bits
            x := u64(n)
            if i.cls == Int32:
                x = (x and 0xffff_ffff) or x << 32
            if (x and 1) != 0:
                x = not x
            y := x
            w := 4
            while w < 64:
                mask := (u64(1) << w) - 1
                if (x and mask) * (0xffff_ffff_ffff_ffff / mask) == x:
                    y = x and mask
                    break
                w *= 2
            out("\tmov\t")
            arm64_emit_reg(i64(i.to), i64(i.cls))
            out(", #")
            if (n or 0xffff) == -1 or x == 0xaaaa_aaaa_aaaa_aaaa or x != 0 and (y and (y + (y and 0 - y))) == 0:
                asm.text += n
                out("\n")
                return
            asm.text += n and 0xffff
            out("\n")
            sh := 16
            n = n >> 16
            while n != 0 and sh != 64 and (wide(i.cls) != 0 or sh != 32):
                out("\tmovk\t")
                arm64_emit_reg(i64(i.to), i64(i.cls))
                out(", #")
                asm.text += hex(n and 0xffff)
                out(", lsl #")
                asm.text += sh
                out("\n")
                sh += 16
                n = n >> 16
            return
    case Oaddr:
        r := i64(i.to)
        s := arm64_slot_offset(i.arg[0])
        if s <= 4095:
            out("\tadd\t")
            arm64_emit_reg(r, Int64)
            out(", x29, #")
            asm.text += s
            out("\n")
            return
        # the offset goes in the register first, in pieces of 16 bits
        out("\tmov\t")
        arm64_emit_reg(r, Int64)
        out(", #")
        asm.text += s and 0xffff if s > 65535 else s
        out("\n")
        if s > 65535:
            out("\tmovk\t")
            arm64_emit_reg(r, Int64)
            out(", #")
            asm.text += s >> 16
            out(", lsl #16\n")
        out("\tadd\t")
        arm64_emit_reg(r, Int64)
        out(", x29, ")
        arm64_emit_reg(r, Int64)
        out("\n")
        return
    case Ocall:
        if ref_kind(i.arg[0]) == RefConstant:
            sym := asm.symbols[fn.constants[ref_value(i.arg[0])].symbol]
            out("\tbl\t")
            if items(sym)[0] != '"':
                out(m.symbol_prefix)
            out(sym + "\n")
            return
    case Ostackalloc:
        arm64_emit_format("sub sp, sp, %0", ptr(i))
        if i.to != EMPTY:
            arm64_emit_format("mov %=, sp", ptr(i))
        return
    case Odebugline:
        emit_line(ref_value(i.arg[0]), ref_value(i.arg[1]))
        return
    case Odebugslot:
        emit_slot(i.arg[1], arm64_slot_offset(i.arg[0]))
        return
    case Odebugmark:
        emit_mark(i.arg[0])
        return
    case Oframe:
        arm64_emit_format("mov %=, x29", ptr(i))
        return
    case Ovlane:
        asm.lane = ref_signed(i.arg[0])
        return
    case Oatomicadd, Oatomicswap, Oatomiccompareswap:
        # x0 holds the value given and then the one memory had, x17 what memory has; Apple has the atomics of ARMv8.1,
        # and elsewhere it is a loop of exclusive loads and stores, through x18
        i.to = X0
        if not m.apple:
            switch i.op:
            case Oatomicadd:
                arm64_emit_format("1:\n\tldaxr %?, %M0\n\tadd\t%?, %?, %=\n\tstlxr\tw18, %?, %M0\n\tcbnz\tw18, 1b\n\tsub\t%=, %?, %=", ptr(i))
            case Oatomicswap:
                arm64_emit_format("1:\n\tldaxr %?, %M0\n\tstlxr\tw18, %=, %M0\n\tcbnz\tw18, 1b\n\tmov\t%=, %?", ptr(i))
            case:
                arm64_emit_format("1:\n\tldaxr %?, %M0\n\tcmp\t%?, %=\n\tb.ne\t2f\n\tstlxr\tw18, %1, %M0\n\tcbnz\tw18, 1b\n2:\n\tmov\t%=, %?", ptr(i))
        elif i.op == Oatomicadd:
            arm64_emit_format("ldaddal %=, %?, %M0\n\tmov\t%=, %?", ptr(i))
        elif i.op == Oatomicswap:
            arm64_emit_format("swpal %=, %?, %M0\n\tmov\t%=, %?", ptr(i))
        else:
            arm64_emit_format("casal %=, %1, %M0", ptr(i))
        return
    case Ovseti8, Ovseti16, Ovseti32, Ovseti64, Ovsetf32, Ovsetf64:
        # v31 holds a float to put that is also the result
        if i.to == i.arg[1] and i.to != i.arg[0]:
            arm64_emit_format("mov v31.16b, %1.16b", ptr(i))
            i.arg[1] = V31
        if i.to != i.arg[0]:
            arm64_emit_format("mov %=.16b, %0.16b", ptr(i))
        i.arg[0] = ref(RefInt, asm.lane)
    case:
        if is_load(i.op) and arm64_far(i.arg[0], load_size(i)):
            arm64_emit_instr(Instr{op = Oaddr, cls = Int64, to = X17, arg = [i.arg[0], EMPTY]})
            i.arg[0] = X17
        if is_store(i.op) and arm64_far(i.arg[1], store_size(i)):
            t: Ref = X18
            if m.apple: # x18 belongs to the system, x17 takes the address and a value in it moves to v31
                t = X17
                if i.arg[0] == X17:
                    wide := i.op == Ostorei64 or i.op == Ostoref64
                    out("\tfmov\t" + ("d" if wide else "s") + "31, " + ("x" if wide else "w") + "17\n")
                    i.arg[0] = V31
                    i.op = Ostoref64 if wide else Ostoref32
            arm64_emit_instr(Instr{op = Oaddr, cls = Int64, to = t, arg = [i.arg[1], EMPTY]})
            i.arg[1] = t
        if is_vector(i.op):
            arm64_emit_format(ARM64_VECTORS[i.op - Ovaddi8], ptr(i))
            return
        if i.op >= Oflageqi and i.op <= Oflagunorderedf:
            arm64_emit_format("cset %=, " + ARM64_CONDITIONS[2 * (i.op - Oflageqi)], ptr(i))
            return
    arm64_emit_format(format(ARM64_FORMS[:], i), ptr(i))

#   Stack-frame layout:
#
#   +=============+
#   | callee-save |  ^
#   |  registers  |  |
#   +-------------+  |
#   |    ...      |  |
#   | spill slots |  |
#   |    ...      |  | arm64.frame
#   +-------------+  |
#   |    ...      |  |
#   |   locals    |  |
#   |    ...      |  |
#   +-------------+  |
#   |   padding   |  v
#   +-------------+
#   |  saved x29  |
#   |  saved x30  |
#   +=============+ <- x29
func arm64_emit_function():
    m := ptr(asm.machine)
    emit_function_symbol(4 if m.apple else 16)
    out("\thint\t#34\n")
    o := 0
    for r in ARM64_CALLEE_SAVED:
        o += i64(fn.used_regs >> r and 1)
    f := (fn.slots + 3) and -4
    arm64.padding = 4 * (f - fn.slots)
    arm64.frame = 4 * f + 8 * (o + (o and 1))
    frame := arm64.frame
    if frame + 16 <= 512:
        out("\tstp\tx29, x30, [sp, -")
        asm.text += frame + 16
        out("]!\n")
    elif not probing(frame):
        out("\tsub\tsp, sp, #")
        asm.text += frame
        out("\n\tstp\tx29, x30, [sp, -16]!\n")
    else:
        if frame >= 4096: # the stp touches the last page
            out("\tmov\tx16, #")
            asm.text += frame / 4096 and 0xffff
            out("\n")
            if frame / 4096 > 0xffff:
                out("\tmovk\tx16, #")
                asm.text += frame / 4096 >> 16
                out(", lsl #16\n")
            out("1:\n\tsub\tsp, sp, #4096\n\tstr\txzr, [sp]\n\tsubs\tx16, x16, #1\n\tb.ne\t1b\n")
        if frame % 4096 != 0:
            out("\tsub\tsp, sp, #")
            asm.text += frame % 4096
            out("\n")
        out("\tstp\tx29, x30, [sp, -16]!\n")
    out("\tmov\tx29, sp\n")
    o = frame + 16
    if comp.debug:
        out("\t.cfi_def_cfa x29, ")
        asm.text += o
        out("\n\t.cfi_offset x29, -")
        asm.text += o
        out("\n\t.cfi_offset x30, -")
        asm.text += o - 8
        out("\n")
    s := (frame - arm64.padding) / 4
    for r in ARM64_CALLEE_SAVED:
        if (fn.used_regs and reg_bit(r)) != 0:
            s -= 2
            arm64_emit_instr(Instr{op = Ostoref64 if r >= V0 else Ostorei64, arg = [u32(r), ref(RefSlot, s)]})
            if comp.debug:
                out("\t.cfi_offset ")
                arm64_emit_reg(r, Unknown)
                out(", ")
                asm.text += arm64_slot_offset(ref(RefSlot, s)) - o
                out("\n")
    lbl := false
    b := fn.start
    while b != 0:
        if lbl or fn.blocks[b].preds.len > 1:
            out(m.local_prefix)
            asm.text += asm.blocks + fn.blocks[b].id
            out(":\n")
        for i in fn.blocks[b].ins:
            arm64_emit_instr(i)
        p := ptr(fn.blocks[b])
        lbl = true
        j := i64(p.exit.type)
        if j == Jhalt:
            out("\tudf\t#0\n")
        elif j == Jtable:
            if ref_kind(p.exit.arg) == RefSlot:
                arm64_emit_instr(Instr{op = Oload, cls = Int64, to = X17, arg = [p.exit.arg, EMPTY]})
                p.exit.arg = X17
            out("\tbr\t")
            arm64_emit_reg(i64(p.exit.arg), Int64)
            out("\n")
        elif j == Jreturn:
            s = (frame - arm64.padding) / 4
            for r in ARM64_CALLEE_SAVED:
                if (fn.used_regs and reg_bit(r)) != 0:
                    s -= 2
                    arm64_emit_instr(Instr{op = Oload, cls = Float64 if r >= V0 else Int64, to = u32(r), arg = [ref(RefSlot, s), EMPTY]})
            if fn.dynamic_alloc:
                out("\tmov sp, x29\n")
            if comp.debug:
                out("\t.cfi_remember_state\n")
            if o <= 504:
                out("\tldp\tx29, x30, [sp], ")
                asm.text += o
            elif o - 16 <= 4095:
                out("\tldp\tx29, x30, [sp], 16\n\tadd\tsp, sp, #")
                asm.text += o - 16
            elif o - 16 <= 65535:
                out("\tldp\tx29, x30, [sp], 16\n\tmov\tx16, #")
                asm.text += o - 16
                out("\n\tadd\tsp, sp, x16")
            else:
                out("\tldp\tx29, x30, [sp], 16\n\tmov\tx16, #")
                asm.text += (o - 16) and 0xffff
                out("\n\tmovk\tx16, #")
                asm.text += (o - 16) >> 16
                out(", lsl #16\n\tadd\tsp, sp, x16")
            out("\n")
            if comp.debug:
                out("\t.cfi_def_cfa sp, 0\n\t.cfi_restore x29\n\t.cfi_restore x30\n")
            out("\tret\n")
            if comp.debug:
                out("\t.cfi_restore_state\n")
        else:
            if j != Jjump:
                c := j - Jflag
                if c < 0 or c > CONDITIONS:
                    panic("unhandled jump kind " + j + " in " + fn.name)
                n := 1
                if p.next == p.no:
                    s2 := p.yes
                    p.yes = p.no
                    p.no = s2
                    n = 0
                out("\tb" + ARM64_CONDITIONS[2 * c + n] + "\t" + m.local_prefix)
                asm.text += asm.blocks + fn.blocks[p.no].id
                out("\n")
            if p.yes != p.next:
                out("\tb\t" + m.local_prefix)
                asm.text += asm.blocks + fn.blocks[p.yes].id
                out("\n")
            else:
                lbl = false
        b = p.next
    emit_function_end(m.local_prefix)
