# the vector instructions from Ovaddb on; fmin and fmax answer NaN, Flag answers the first argument
ARM64_VECS: array[&strview, 56] = [
    "add %=.16b, %0.16b, %1.16b", "add %=.8h, %0.8h, %1.8h", "add %=.4s, %0.4s, %1.4s", "add %=.2d, %0.2d, %1.2d",
    "fadd %=.4s, %0.4s, %1.4s", "fadd %=.2d, %0.2d, %1.2d",
    "sub %=.16b, %0.16b, %1.16b", "sub %=.8h, %0.8h, %1.8h", "sub %=.4s, %0.4s, %1.4s", "sub %=.2d, %0.2d, %1.2d",
    "fsub %=.4s, %0.4s, %1.4s", "fsub %=.2d, %0.2d, %1.2d",
    "mul %=.8h, %0.8h, %1.8h", "mul %=.4s, %0.4s, %1.4s", "fmul %=.4s, %0.4s, %1.4s", "fmul %=.2d, %0.2d, %1.2d",
    "fdiv %=.4s, %0.4s, %1.4s", "fdiv %=.2d, %0.2d, %1.2d",
    "and %=.16b, %0.16b, %1.16b", "orr %=.16b, %0.16b, %1.16b", "eor %=.16b, %0.16b, %1.16b",
    "dup v31.8h, %W1\n\tushl\t%=.8h, %0.8h, v31.8h", "dup v31.4s, %W1\n\tushl\t%=.4s, %0.4s, v31.4s",
    "dup v31.2d, %L1\n\tushl\t%=.2d, %0.2d, v31.2d",
    "neg %W?, %W1\n\tdup\tv31.8h, %W?\n\tushl\t%=.8h, %0.8h, v31.8h",
    "neg %W?, %W1\n\tdup\tv31.4s, %W?\n\tushl\t%=.4s, %0.4s, v31.4s",
    "neg %L?, %L1\n\tdup\tv31.2d, %L?\n\tushl\t%=.2d, %0.2d, v31.2d",
    "neg %W?, %W1\n\tdup\tv31.8h, %W?\n\tsshl\t%=.8h, %0.8h, v31.8h",
    "neg %W?, %W1\n\tdup\tv31.4s, %W?\n\tsshl\t%=.4s, %0.4s, v31.4s",
    "cmeq %=.16b, %0.16b, %1.16b", "cmeq %=.8h, %0.8h, %1.8h", "cmeq %=.4s, %0.4s, %1.4s", "cmeq %=.2d, %0.2d, %1.2d",
    "fcmeq %=.4s, %0.4s, %1.4s", "fcmeq %=.2d, %0.2d, %1.2d",
    "cmgt %=.16b, %0.16b, %1.16b", "cmgt %=.8h, %0.8h, %1.8h", "cmgt %=.4s, %0.4s, %1.4s", "cmgt %=.2d, %0.2d, %1.2d",
    "fcmgt %=.4s, %1.4s, %0.4s", "fcmgt %=.2d, %1.2d, %0.2d", "fcmge %=.4s, %1.4s, %0.4s", "fcmge %=.2d, %1.2d, %0.2d",
    "fcmgt v31.4s, %0.4s, %1.4s\n\tbsl\tv31.16b, %1.16b, %0.16b\n\tmov\t%=.16b, v31.16b",
    "fcmgt v31.2d, %0.2d, %1.2d\n\tbsl\tv31.16b, %1.16b, %0.16b\n\tmov\t%=.16b, v31.16b",
    "fcmgt v31.4s, %1.4s, %0.4s\n\tbsl\tv31.16b, %1.16b, %0.16b\n\tmov\t%=.16b, v31.16b",
    "fcmgt v31.2d, %1.2d, %0.2d\n\tbsl\tv31.16b, %1.16b, %0.16b\n\tmov\t%=.16b, v31.16b",
    "fsqrt %=.4s, %0.4s", "fsqrt %=.2d, %0.2d",
    "dup %=.16b, %W0", "dup %=.8h, %W0", "dup %=.4s, %W0", "dup %=.2d, %L0", "dup %=.4s, %0.s[0]", "dup %=.2d, %0.d[0]",
    "scvtf %=.4s, %0.4s"
]

# the condition of each comparison, and of its negation
ARM64_CONDS: array[&strview, 36] = ["eq", "ne", "ne", "eq", "ge", "lt", "gt", "le", "le", "gt", "lt", "ge", "cs", "cc", "hi", "ls", "ls", "hi", "cc", "cs", "eq", "ne", "ge", "lt", "gt", "le", "ls", "hi", "mi", "pl", "ne", "eq", "vc", "vs", "vs", "vc"]

# the name of the register r as of class k
func arm64_reg(r: i64, k: i64):
    if r == XSP:
        out("sp")
        return
    n := r - X0
    c: u8 = 'w' if k == Kw else 'x'
    if r > X30:
        n = 31 if r == V31 else r - V0
        c = 'd'
        if k == Ks:
            c = 's'
        elif k == Kv:
            c = 'v'
        elif k == Kv + 1:
            c = 'q'
    add_byte(asm.text, c)
    asm.text += n

# the offset of a slot from x29: the parameters on the stack are above the frame
func arm64_slot(r: Ref) -> i64:
    s := rsval(r)
    if s == -1:
        return 16 + arm64.frame
    if s < 0:
        return 16 + arm64.frame - (s + 2)
    return 16 + arm64.padding + 4 * s

# the instruction i as fmt says: the first space is a tab, %= %0 %1 are the result and the arguments, %M before them
# their memory, %? the scratch, and W L S D Q V before them name their register as of that class
func arm64_emitf(fmt: &strview, i: *Instr):
    s := items(fmt)
    out("\t")
    tabbed := false
    x := 0
    while x < s.len:
        c := s[x]
        x += 1
        if c != '%':
            if c == ' ' and not tabbed:
                c = '\t'
                tabbed = true
            add_byte(asm.text, c)
            continue
        k := i64(i.cls)
        while true:
            c = s[x]
            x += 1
            switch c:
            case 'W':
                k = Kw
            case 'L':
                k = Kl
            case 'S':
                k = Ks
            case 'D':
                k = Kd
            case 'Q':
                k = Kv + 1 # a v register named whole, for ldr and str
            case 'V':
                k = Kv
            case:
                break
        if c == '?':
            arm64_reg(X17 if kbase(k) == 0 else V31, k)
            continue
        memory := c == 'M'
        if memory:
            c = s[x]
            x += 1
        r := i.to if c == '=' else i.arg[c - '0']
        if memory and rtype(r) == RSlot:
            out("[x29, ")
            asm.text += arm64_slot(r)
            out("]")
        elif memory:
            out("[")
            arm64_reg(i64(r), Kl)
            out("]")
        elif rtype(r) == RInt:
            asm.text += rsval(r)
        elif rtype(r) == RCon:
            n := u64(fn.con[rval(r)].bits)
            out("#")
            if n >> 24 == 0 and (n and 0xfff000) != 0:
                asm.text += n >> 12
                out(", lsl #12")
            else:
                asm.text += n
        else:
            arm64_reg(i64(r), k)
    out("\n")

# whether a slot is past the reach of the offset of a load or store of sz bytes
func arm64_far(r: Ref, sz: i64) -> bool:
    return rtype(r) == RSlot and arm64_slot(r) > sz * 4095

func arm64_emitins(i: Instr):
    m := ptr(asm.machine)
    switch i.op:
    case Onop:
        return
    case Ocopy:
        if i.to == i.arg[0]:
            return
        if rtype(i.to) == RSlot:
            r := i.to
            if not isreg(i.arg[0]):
                i.to = X17 if kbase(i.cls) == 0 else V31 # a float goes through a float register
                arm64_emitins(i)
                i.arg[0] = i.to
            i.op = i32(Ostorew + i64(i.cls))
            i.cls = Kw
            i.arg[1] = r
            arm64_emitins(i)
            return
        switch rtype(i.arg[0]):
        case RSlot:
            i.op = Oload
            arm64_emitins(i)
            return
        case RCon:
            c := fn.con[rval(i.arg[0])]
            if c.type == CAddr:
                form: &strview = ""
                switch c.symtype:
                case SGlo:
                    form = "\tadrp\tR, S@pageO\n\tadd\tR, R, S@pageoffO\n" if m.apple else "\tadrp\tR, SO\n\tadd\tR, R, #:lo12:SO\n"
                case SExt:
                    form = "\tadrp\tR, S@gotpage\n\tldr\tR, [R, S@gotpageoff]\n" if m.apple else "\tadrp\tR, :got:S\n\tldr\tR, [R, #:got_lo12:S]\n"
                case:
                    if m.apple:
                        form = "\tadrp\tR, S@tlvppage\n\tldr\tR, [R, S@tlvppageoff]\n"
                    elif c.symtype == SExtThr:
                        # initial-exec: the offset from the thread pointer is in the GOT, x18 is free out of Apple
                        form = "\tadrp\tR, :gottprel:S\n\tldr\tR, [R, #:gottprel_lo12:S]\n\tmrs\tx18, tpidr_el0\n\tadd\tR, R, x18\n"
                    else:
                        form = "\tmrs\tR, tpidr_el0\n\tadd\tR, R, #:tprel_hi12:SO, lsl #12\n\tadd\tR, R, #:tprel_lo12_nc:SO\n"
                sym := asm.syms[c.sym] # R in form is the register, S the symbol and O its offset
                for b in items(form):
                    switch b:
                    case 'R':
                        arm64_reg(i64(i.to), Kl)
                    case 'S':
                        if items(sym)[0] != '"':
                            out(m.assym)
                        out(sym)
                    case 'O':
                        if c.bits != 0:
                            out("+")
                            asm.text += c.bits
                    case:
                        add_byte(asm.text, b)
                return
            n := c.bits
            if kwide(i.cls) == 0:
                n = n << 32 >> 32
            # mov takes a negative of 16 bits, or a bitmask immediate: a rotated run of ones repeated in 2, 4, 8, 16, 32 or
            # 64 bits; movk puts the other pieces of 16 bits
            x := u64(n)
            if i.cls == Kw:
                x = (x and 0xffff_ffff) or x << 32
            if (x and 1) != 0:
                x = not x
            y := x
            w := 4
            while w < 64:
                mask := (u64(1) << w) - 1
                if (x and mask) * (0xffff_ffff_ffff_ffff / mask) == x:
                    y = x and mask
                    break
                w *= 2
            out("\tmov\t")
            arm64_reg(i64(i.to), i64(i.cls))
            out(", #")
            if (n or 0xffff) == -1 or x == 0xaaaa_aaaa_aaaa_aaaa or x != 0 and (y and (y + (y and 0 - y))) == 0:
                asm.text += n
                out("\n")
                return
            asm.text += n and 0xffff
            out("\n")
            sh := 16
            n = n >> 16
            while n != 0 and sh != 64 and (kwide(i.cls) != 0 or sh != 32):
                out("\tmovk\t")
                arm64_reg(i64(i.to), i64(i.cls))
                out(", #")
                asm.text += hex(n and 0xffff)
                out(", lsl #")
                asm.text += sh
                out("\n")
                sh += 16
                n = n >> 16
            return
    case Oaddr:
        r := i64(i.to)
        s := arm64_slot(i.arg[0])
        if s <= 4095:
            out("\tadd\t")
            arm64_reg(r, Kl)
            out(", x29, #")
            asm.text += s
            out("\n")
            return
        # the offset goes in the register first, in pieces of 16 bits
        out("\tmov\t")
        arm64_reg(r, Kl)
        out(", #")
        asm.text += s and 0xffff if s > 65535 else s
        out("\n")
        if s > 65535:
            out("\tmovk\t")
            arm64_reg(r, Kl)
            out(", #")
            asm.text += s >> 16
            out(", lsl #16\n")
        out("\tadd\t")
        arm64_reg(r, Kl)
        out(", x29, ")
        arm64_reg(r, Kl)
        out("\n")
        return
    case Ocall:
        if rtype(i.arg[0]) == RCon:
            sym := asm.syms[fn.con[rval(i.arg[0])].sym]
            out("\tbl\t")
            if items(sym)[0] != '"':
                out(m.assym)
            out(sym + "\n")
            return
    case Osalloc:
        arm64_emitf("sub sp, sp, %0", ptr(i))
        if i.to != R:
            arm64_emitf("mov %=, sp", ptr(i))
        return
    case Odbgloc:
        emitdbgloc(rval(i.arg[0]), rval(i.arg[1]))
        return
    case Odbgslot:
        emitdbgslot(i.arg[1], arm64_slot(i.arg[0]))
        return
    case Odbgmark:
        emitdbgmark(i.arg[0])
        return
    case Oframe:
        arm64_emitf("mov %=, x29", ptr(i))
        return
    case Ovlane:
        asm.lane = rsval(i.arg[0])
        return
    case Oaadd, Oaswap, Oacas1:
        # x0 holds the value given and then the one memory had, x17 what memory has; Apple has the atomics of ARMv8.1,
        # and elsewhere it is a loop of exclusive loads and stores, through x18
        i.to = X0
        if not m.apple:
            switch i.op:
            case Oaadd:
                arm64_emitf("1:\n\tldaxr %?, %M0\n\tadd\t%?, %?, %=\n\tstlxr\tw18, %?, %M0\n\tcbnz\tw18, 1b\n\tsub\t%=, %?, %=", ptr(i))
            case Oaswap:
                arm64_emitf("1:\n\tldaxr %?, %M0\n\tstlxr\tw18, %=, %M0\n\tcbnz\tw18, 1b\n\tmov\t%=, %?", ptr(i))
            case:
                arm64_emitf("1:\n\tldaxr %?, %M0\n\tcmp\t%?, %=\n\tb.ne\t2f\n\tstlxr\tw18, %1, %M0\n\tcbnz\tw18, 1b\n2:\n\tmov\t%=, %?", ptr(i))
        elif i.op == Oaadd:
            arm64_emitf("ldaddal %=, %?, %M0\n\tmov\t%=, %?", ptr(i))
        elif i.op == Oaswap:
            arm64_emitf("swpal %=, %?, %M0\n\tmov\t%=, %?", ptr(i))
        else:
            arm64_emitf("casal %=, %1, %M0", ptr(i))
        return
    case Ovsetb, Ovseth, Ovsetw, Ovsetl, Ovsets, Ovsetd:
        # v31 holds a float to put that is also the result
        if i.to == i.arg[1] and i.to != i.arg[0]:
            arm64_emitf("mov v31.16b, %1.16b", ptr(i))
            i.arg[1] = V31
        if i.to != i.arg[0]:
            arm64_emitf("mov %=.16b, %0.16b", ptr(i))
        i.arg[0] = ref(RInt, asm.lane)
    case:
        if isload(i.op) and arm64_far(i.arg[0], loadsz(i)):
            arm64_emitins(Instr{op = Oaddr, cls = Kl, to = X17, arg = [i.arg[0], R]})
            i.arg[0] = X17
        if isstore(i.op) and arm64_far(i.arg[1], storesz(i)):
            t: Ref = X18
            if m.apple: # x18 belongs to the system, x17 takes the address and a value in it moves to v31
                t = X17
                if i.arg[0] == X17:
                    wide := i.op == Ostorel or i.op == Ostored
                    out("\tfmov\t" + ("d" if wide else "s") + "31, " + ("x" if wide else "w") + "17\n")
                    i.arg[0] = V31
                    i.op = Ostored if wide else Ostores
            arm64_emitins(Instr{op = Oaddr, cls = Kl, to = t, arg = [i.arg[1], R]})
            i.arg[1] = t
        if isvec(i.op):
            arm64_emitf(ARM64_VECS[i.op - Ovaddb], ptr(i))
            return
        if i.op >= Oflag and i.op <= Oflag1:
            arm64_emitf("cset %=, " + ARM64_CONDS[2 * (i.op - Oflag)], ptr(i))
            return
    arm64_emitf(format(ARM64_OMAP[:], i), ptr(i))

#   Stack-frame layout:
#
#   +=============+
#   | callee-save |  ^
#   |  registers  |  |
#   +-------------+  |
#   |    ...      |  |
#   | spill slots |  |
#   |    ...      |  | arm64.frame
#   +-------------+  |
#   |    ...      |  |
#   |   locals    |  |
#   |    ...      |  |
#   +-------------+  |
#   |   padding   |  v
#   +-------------+
#   |  saved x29  |
#   |  saved x30  |
#   +=============+ <- x29
func arm64_emitfn():
    m := ptr(asm.machine)
    emitfnlnk(4 if m.apple else 16)
    out("\thint\t#34\n")
    o := 0
    for r in ARM64_RCLOB:
        o += i64(fn.reg >> r and 1)
    f := (fn.slot + 3) and -4
    arm64.padding = 4 * (f - fn.slot)
    arm64.frame = 4 * f + 8 * (o + (o and 1))
    frame := arm64.frame
    if frame + 16 <= 512:
        out("\tstp\tx29, x30, [sp, -")
        asm.text += frame + 16
        out("]!\n")
    elif not probing(frame):
        out("\tsub\tsp, sp, #")
        asm.text += frame
        out("\n\tstp\tx29, x30, [sp, -16]!\n")
    else:
        if frame >= 4096: # the stp touches the last page
            out("\tmov\tx16, #")
            asm.text += frame / 4096 and 0xffff
            out("\n")
            if frame / 4096 > 0xffff:
                out("\tmovk\tx16, #")
                asm.text += frame / 4096 >> 16
                out(", lsl #16\n")
            out("1:\n\tsub\tsp, sp, #4096\n\tstr\txzr, [sp]\n\tsubs\tx16, x16, #1\n\tb.ne\t1b\n")
        if frame % 4096 != 0:
            out("\tsub\tsp, sp, #")
            asm.text += frame % 4096
            out("\n")
        out("\tstp\tx29, x30, [sp, -16]!\n")
    out("\tmov\tx29, sp\n")
    o = frame + 16
    if comp.debug:
        out("\t.cfi_def_cfa x29, ")
        asm.text += o
        out("\n\t.cfi_offset x29, -")
        asm.text += o
        out("\n\t.cfi_offset x30, -")
        asm.text += o - 8
        out("\n")
    s := (frame - arm64.padding) / 4
    for r in ARM64_RCLOB:
        if (fn.reg and regbit(r)) != 0:
            s -= 2
            arm64_emitins(Instr{op = Ostored if r >= V0 else Ostorel, arg = [u32(r), ref(RSlot, s)]})
            if comp.debug:
                out("\t.cfi_offset ")
                arm64_reg(r, Kx)
                out(", ")
                asm.text += arm64_slot(ref(RSlot, s)) - o
                out("\n")
    lbl := false
    b := fn.start
    while b != 0:
        if lbl or fn.blks[b].pred.len > 1:
            out(m.asloc)
            asm.text += asm.blocks + fn.blks[b].id
            out(":\n")
        for i in fn.blks[b].ins:
            arm64_emitins(i)
        p := ptr(fn.blks[b])
        lbl = true
        j := i64(p.jmp.type)
        if j == Jhlt:
            out("\tudf\t#0\n")
        elif j == Jret0:
            s = (frame - arm64.padding) / 4
            for r in ARM64_RCLOB:
                if (fn.reg and regbit(r)) != 0:
                    s -= 2
                    arm64_emitins(Instr{op = Oload, cls = Kd if r >= V0 else Kl, to = u32(r), arg = [ref(RSlot, s), R]})
            if fn.dynalloc:
                out("\tmov sp, x29\n")
            if comp.debug:
                out("\t.cfi_remember_state\n")
            if o <= 504:
                out("\tldp\tx29, x30, [sp], ")
                asm.text += o
            elif o - 16 <= 4095:
                out("\tldp\tx29, x30, [sp], 16\n\tadd\tsp, sp, #")
                asm.text += o - 16
            elif o - 16 <= 65535:
                out("\tldp\tx29, x30, [sp], 16\n\tmov\tx16, #")
                asm.text += o - 16
                out("\n\tadd\tsp, sp, x16")
            else:
                out("\tldp\tx29, x30, [sp], 16\n\tmov\tx16, #")
                asm.text += (o - 16) and 0xffff
                out("\n\tmovk\tx16, #")
                asm.text += (o - 16) >> 16
                out(", lsl #16\n\tadd\tsp, sp, x16")
            out("\n")
            if comp.debug:
                out("\t.cfi_def_cfa sp, 0\n\t.cfi_restore x29\n\t.cfi_restore x30\n")
            out("\tret\n")
            if comp.debug:
                out("\t.cfi_restore_state\n")
        else:
            if j != Jjmp:
                c := j - Jjf
                if c < 0 or c > NCmp:
                    panic("unhandled jump " + j)
                n := 1
                if p.link == p.s2:
                    s2 := p.s1
                    p.s1 = p.s2
                    p.s2 = s2
                    n = 0
                out("\tb" + ARM64_CONDS[2 * c + n] + "\t" + m.asloc)
                asm.text += asm.blocks + fn.blks[p.s2].id
                out("\n")
            if p.s1 != p.link:
                out("\tb\t" + m.asloc)
                asm.text += asm.blocks + fn.blks[p.s1].id
                out("\n")
            else:
                lbl = false
        b = p.link
    emitfnend()
