@trust

type RMap: # the register of each temp in registers at a point
    t: array[i32, 64]
    r: array[i32, 64]
    w: array[i32, 64] # wait list, for unmatched hints
    b: BSet
    n: i64

type Move:
    src: Ref
    dst: Ref
    cls: i64

context regs:
    u: BSet
    v: BSet
    w: BSet
    fst: BSet # temps to prioritize in registers
    masks: array[BSet, 2] # by class
    b2: BSet
    pmset: BSet
    tarr: &list[i64] = heap([])
    locs: i64 # stack size used by locals
    slot4: i64 # next slot of 4 bytes
    slot8: i64 # ditto, 8 bytes
    regu: u64 # registers used
    moves: &list[Move] = heap([]) # the parallel move being made
    status: &list[i64] = heap([])
    loop: i64
    beg: &list[RMap] = heap([])
    end: &list[RMap] = heap([])
    cur: RMap
    blk: &list[i64] = heap([])
    rl: array[i64, 64]
    at: i64 # where in fn.out the instruction is that rega gives registers
    seen: &list[i64] = heap([]) # of each temp, the place where spill() saw it last before the one it has reached
    floor: i64 # the place of the first instruction of the block of spill(): seen below it is not in the block
    before: &list[i64] = heap([]) # of each temp the block touches, in order: the place, the temp, where it was seen before
    scratch: i64 # 16-byte stack slot used to break parallel-move cycles touching stack slots

func liveon(v: *BSet, b: i64, s: i64):
    bscopy(v, ptr(fn.blks[s].live_in))
    p := fn.blks[s].phi
    while p != 0:
        if rtype(fn.phis[p].to) == RTmp:
            bsclr(v, i64(fn.phis[p].to))
        p = fn.phis[p].link
    p = fn.blks[s].phi
    while p != 0:
        ph := fn.phis[p]
        for a in 0..ph.arg.len:
            if ph.blk[a] == b and rtype(ph.arg[a]) == RTmp:
                bsset(v, i64(ph.arg[a]))
                bsset(ptr(fn.blks[b].gen), i64(ph.arg[a]))
        p = ph.link

func bset(r: Ref, b: i64, nlv: *array[i64, 2]):
    if rtype(r) != RTmp:
        return
    bsset(ptr(fn.blks[b].gen), i64(r))
    if not bshas(ptr(fn.blks[b].live_in), i64(r)):
        nlv[kbase(fn.tmp[r].cls)] += 1
        bsset(ptr(fn.blks[b].live_in), i64(r))

func filllive():
    m := ptr(asm.machine)
    v := ptr(regs.v)
    bsinit(v)
    b := fn.start
    while b != 0:
        bsinit(ptr(fn.blks[b].live_in))
        bsinit(ptr(fn.blks[b].live_out))
        bsinit(ptr(fn.blks[b].gen))
        b = fn.blks[b].link
    changed := true
    while changed:
        changed = false
        for n in reverse 0..fn.nblk:
            b = fn.rpo[n]
            p := ptr(fn.blks[b])
            size := bscount(ptr(p.live_out))
            pair: array[i64, 2]
            for s in succs(b, ptr(pair)):
                liveon(v, b, s)
                bsunion(ptr(p.live_out), v)
            changed = changed or bscount(ptr(p.live_out)) != size
            nlv: array[i64, 2]
            p.live_out.t[0] = p.live_out.t[0] or m.rglob
            bscopy(ptr(p.live_in), ptr(p.live_out))
            t := bsiter(ptr(p.live_in), 0)
            while t >= 0:
                nlv[kbase(fn.tmp[t].cls)] += 1
                t = bsiter(ptr(p.live_in), t + 1)
            if rtype(p.jmp.arg) == RCall:
                p.live_in.t[0] = p.live_in.t[0] or m.retregs(p.jmp.arg, ptr(nlv))
            else:
                bset(p.jmp.arg, b, ptr(nlv))
            p.nlive = nlv
            for k in reverse 0..p.ins.len:
                i := p.ins[k]
                if i.op == Ocall and rtype(i.arg[1]) == RCall:
                    c: array[i64, 2]
                    p.live_in.t[0] = p.live_in.t[0] and not m.retregs(i.arg[1], ptr(c))
                    for j in 0..2:
                        nlv[j] -= c[j]
                        # the callee uses the caller-save registers, they are live in the middle of the call
                        nlv[j] += m.nrsave[j]
                        if nlv[j] > p.nlive[j]:
                            p.nlive[j] = nlv[j]
                    p.live_in.t[0] = p.live_in.t[0] or m.argregs(i.arg[1], ptr(c))
                    for j in 0..2:
                        nlv[j] -= m.nrsave[j]
                        nlv[j] += c[j]
                if i.to != R:
                    t = i64(i.to)
                    if bshas(ptr(p.live_in), t):
                        nlv[kbase(fn.tmp[t].cls)] -= 1
                    bsset(ptr(p.gen), t)
                    bsclr(ptr(p.live_in), t)
                for j in 0..2:
                    if rtype(i.arg[j]) == RMem:
                        a := fn.mem[rval(i.arg[j])]
                        bset(a.base, b, ptr(nlv))
                        bset(a.index, b, ptr(nlv))
                    else:
                        bset(i.arg[j], b, ptr(nlv))
                for j in 0..2:
                    if nlv[j] > p.nlive[j]:
                        p.nlive[j] = nlv[j]

# aggregate looping information at loop headers
func aggreg(hd: i64, b: i64):
    bsunion(ptr(fn.blks[hd].gen), ptr(fn.blks[b].gen))
    for k in 0..2:
        if fn.blks[b].nlive[k] > fn.blks[hd].nlive[k]:
            fn.blks[hd].nlive[k] = fn.blks[b].nlive[k]

func tmpuse(r: Ref, use: bool, loop: i32):
    if rtype(r) == RMem:
        a := fn.mem[rval(r)]
        tmpuse(a.base, true, loop)
        tmpuse(a.index, true, loop)
    elif rtype(r) == RTmp and r >= Tmp0:
        t := ptr(fn.tmp[r])
        t.nuse += i32(use)
        t.ndef += i32(not use)
        t.cost += u32(loop)

# the spill costs of the temps, and their uses
func fillcost():
    loopiter(aggreg)
    for t in 0..fn.ntmp:
        fn.tmp[t].cost = 0xffff_ffff if t < Tmp0 else 0
        fn.tmp[t].nuse = 0
        fn.tmp[t].ndef = 0
    b := fn.start
    while b != 0:
        p := fn.blks[b].phi
        while p != 0:
            ph := fn.phis[p]
            tmpuse(ph.to, false, 0)
            for a in 0..ph.arg.len:
                n := fn.blks[ph.blk[a]].loop
                fn.tmp[ph.to].cost += u32(n)
                tmpuse(ph.arg[a], true, n)
            p = ph.link
        n := fn.blks[b].loop
        for i in fn.blks[b].ins:
            tmpuse(i.to, false, n)
            tmpuse(i.arg[0], true, n)
            tmpuse(i.arg[1], true, n)
        tmpuse(fn.blks[b].jmp.arg, true, n)
        b = fn.blks[b].link

# which of two temps stays in a register: a register, then the one wanted again sooner going back, which is to say the
# one seen nearer to this place in the block, then the costlier
func tcmp0(a: i64, b: i64) -> bool:
    if (a < Tmp0) != (b < Tmp0):
        return a < Tmp0
    sa := max(regs.seen[a], regs.floor - 1)
    sb := max(regs.seen[b], regs.floor - 1)
    if sa != sb:
        return sa > sb
    return fn.tmp[a].cost > fn.tmp[b].cost

func tcmp1(a: i64, b: i64) -> bool:
    fa := bshas(ptr(regs.fst), a)
    fb := bshas(ptr(regs.fst), b)
    if fa != fb:
        return fa
    return tcmp0(a, b)

# the instruction at place at touches r, which is seen there
func touch(at: i64, r: Ref):
    if rtype(r) == RTmp:
        append(regs.before, ptr([at, i64(r), regs.seen[r]]))
        regs.seen[r] = at

# going back past instruction k of the block, the temps it touched were seen last where they were seen before
func untouch(k: i64):
    at := regs.floor + k
    before := ptr(regs.before)
    while before.len > 0 and before[-3] == at:
        regs.seen[before[-2]] = before[-1]
        before.len -= 3

func slot(t: i64) -> Ref:
    s := i64(fn.tmp[t].slot)
    if s == -1:
        # a slot of 4 fills the one hole of 8, at slot4; slot4 <= slot8
        cls := fn.tmp[t].cls
        if cls == Kv: # aligned to 16, a gap below it is lost
            s = (regs.slot8 + 3) and -4
            if regs.slot4 == regs.slot8 and s == regs.slot8:
                regs.slot4 = s + 4
            regs.slot8 = s + 4
        elif kwide(cls) != 0:
            s = regs.slot8
            if regs.slot4 == regs.slot8:
                regs.slot4 += 2
            regs.slot8 += 2
        else:
            s = regs.slot4
            if regs.slot4 == regs.slot8:
                regs.slot8 += 2
                regs.slot4 += 1
            else:
                regs.slot4 = regs.slot8
        s += regs.locs
        fn.tmp[t].slot = i32(s)
    return ref(RSlot, s)

# b keeps at most k temps: those in f first, when given, then those with the largest spill cost
func limit(b: *BSet, k: i64, f: *BSet?):
    nt := bscount(b)
    if nt <= k:
        return
    tarr := ptr(regs.tarr)
    tarr.len = 0
    t := bsiter(b, 0)
    while t >= 0:
        bsclr(b, t)
        append(tarr, t)
        t = bsiter(b, t + 1)
    if nt > 1:
        if f is null:
            sort(tarr.*, tcmp0)
        else:
            regs.fst = f.*
            sort(tarr.*, tcmp1)
    i := 0
    while i < k and i < nt:
        bsset(b, tarr[i])
        i += 1
    while i < nt:
        _ = slot(tarr[i])
        i += 1

# b keeps the temps that fit in the registers, as limit() chooses, when k1 gprs and k2 fprs are in use
func limit2(b1: *BSet, k1: i64, k2: i64, f: *BSet?):
    b2 := ptr(regs.b2)
    bscopy(b2, b1)
    bsinter(b1, ptr(regs.masks[0]))
    bsinter(b2, ptr(regs.masks[1]))
    limit(b1, asm.machine.ngpr - k1, f)
    limit(b2, asm.machine.nfpr - k2, f)
    bsunion(b1, b2)

func sethints(u: *BSet, r: u64):
    t := bsiter(u, Tmp0)
    while t >= 0:
        p := phicls(t)
        fn.tmp[p].hintm = fn.tmp[p].hintm or r
        t = bsiter(u, t + 1)

# reloads temporaries in u that are not in v from their slots
func reloads(u: *BSet, v: *BSet):
    t := bsiter(u, Tmp0)
    while t >= 0:
        if not bshas(v, t):
            s := slot(t)
            emit(Oload, fn.tmp[t].cls, u32(t), s, R)
        t = bsiter(u, t + 1)

func spillstore(r: Ref, s: i64):
    if s != -1:
        emit(Ostorew + i64(fn.tmp[r].cls), 0, R, r, ref(RSlot, s))

func regcpy(i: Instr) -> bool:
    return i.op == Ocopy and isreg(i.arg[0])

func merge(u: *BSet, bu: i64, v: *BSet, bv: i64):
    if fn.blks[bu].loop <= fn.blks[bv].loop:
        bsunion(u, v)
    else:
        t := bsiter(v, 0)
        while t >= 0:
            if fn.tmp[t].slot == -1:
                bsset(u, t)
            t = bsiter(v, t + 1)

# the temps that do not fit in registers go to slots; the live sets of a block become the temps in registers at its ends
func spill():
    m := ptr(asm.machine)
    u := ptr(regs.u)
    v := ptr(regs.v)
    w := ptr(regs.w)
    bsinit(u)
    bsinit(v)
    bsinit(w)
    bsinit(ptr(regs.masks[0]))
    bsinit(ptr(regs.masks[1]))
    bsinit(ptr(regs.b2))
    bsinit(ptr(regs.pmset))
    regs.locs = fn.slot
    regs.slot4 = 0
    regs.slot8 = 0
    for t in 0..fn.ntmp:
        k := 0
        if t >= m.fpr0 and t < m.fpr0 + m.nfpr:
            k = 1
        if t >= Tmp0:
            k = kbase(fn.tmp[t].cls)
        bsset(ptr(regs.masks[k]), t)
    while regs.seen.len < fn.ntmp:
        append(regs.seen, -1)
    for n in reverse 0..fn.nblk:
        b := fn.rpo[n]
        # 0. where each temp was seen last, at the end of the block and before each instruction
        span := fn.blks[b].ins.len
        regs.before.len = 0
        for k in 0..span:
            i := fn.blks[b].ins[k]
            touch(regs.floor + k, i.to)
            for x in 0..2:
                if rtype(i.arg[x]) == RMem:
                    touch(regs.floor + k, fn.mem[rval(i.arg[x])].base)
                    touch(regs.floor + k, fn.mem[rval(i.arg[x])].index)
                else:
                    touch(regs.floor + k, i.arg[x])
        # 1. find temporaries in registers at the end of the block (put them in v)
        pair: array[i64, 2]
        succ := succs(b, ptr(pair))
        hd := 0
        for s in succ:
            if fn.blks[s].id <= fn.blks[b].id and (hd == 0 or fn.blks[s].id >= fn.blks[hd].id):
                hd = s
        if hd != 0: # back-edge
            bszero(v)
            fn.blks[hd].gen.t[0] = fn.blks[hd].gen.t[0] or m.rglob # don't spill registers
            for k in 0..2:
                nr := m.ngpr if k == 0 else m.nfpr
                bscopy(u, ptr(fn.blks[b].live_out))
                bsinter(u, ptr(regs.masks[k]))
                bscopy(w, u)
                bsinter(u, ptr(fn.blks[hd].gen))
                t := bsiter(u, 0) # w keeps what u does not
                while t >= 0:
                    bsclr(w, t)
                    t = bsiter(u, t + 1)
                if bscount(u) < nr:
                    j := bscount(w) # live through
                    l := fn.blks[hd].nlive[k]
                    limit(w, nr - (l - j), null)
                    bsunion(u, w)
                else:
                    limit(u, nr, null)
                bsunion(v, u)
        elif succ.len > 0: # avoid reloading temporaries in the middle of loops
            bszero(v)
            liveon(w, b, succ[0])
            merge(v, b, w, succ[0])
            for s in succ[1:]:
                liveon(u, b, s)
                merge(v, b, u, s)
                bsinter(w, u)
            limit2(v, 0, 0, w)
        else:
            bscopy(v, ptr(fn.blks[b].live_out))
            if rtype(fn.blks[b].jmp.arg) == RCall:
                c: array[i64, 2]
                v.t[0] = v.t[0] or m.retregs(fn.blks[b].jmp.arg, ptr(c))
        if rtype(fn.blks[b].jmp.arg) == RTmp:
            t := i64(fn.blks[b].jmp.arg)
            bsset(v, t)
            limit2(v, 0, 0, null)
            if not bshas(v, t):
                fn.blks[b].jmp.arg = slot(t)
        t := bsiter(ptr(fn.blks[b].live_out), Tmp0)
        while t >= 0:
            if not bshas(v, t):
                _ = slot(t)
            t = bsiter(ptr(fn.blks[b].live_out), t + 1)
        bscopy(ptr(fn.blks[b].live_out), v)
        # 2. process the block instructions
        fn.out.len = 0
        k := fn.blks[b].ins.len
        while k > 0:
            k -= 1
            i := fn.blks[b].ins[k]
            if regcpy(i): # with the copies from registers before it, one large instruction
                ins := fn.blks[b].ins
                last := k
                while true:
                    to := ins[k].to
                    if to != R and bshas(v, i64(to)):
                        bsclr(v, i64(to))
                        spillstore(to, i64(fn.tmp[to].slot))
                    bsset(v, i64(ins[k].arg[0]))
                    if k == 0 or not regcpy(ins[k - 1]):
                        break
                    k -= 1
                pm := ptr(regs.pmset)
                bscopy(pm, v)
                r: u64 = 0
                if k != 0 and ins[k - 1].op == Ocall:
                    c: array[i64, 2]
                    v.t[0] = v.t[0] and not m.retregs(ins[k - 1].arg[1], ptr(c))
                    if m.halfsave: # the callee keeps only half of a v register
                        t = bsiter(v, Tmp0)
                        while t >= 0:
                            if fn.tmp[t].cls == Kv:
                                bsclr(v, t)
                            t = bsiter(v, t + 1)
                    limit2(v, m.nrsave[0], m.nrsave[1], null)
                    for x in m.rsave:
                        if x >= 0:
                            r = r or u64(1) << x
                    v.t[0] = v.t[0] or m.argregs(ins[k - 1].arg[1], ptr(c))
                else:
                    limit2(v, 0, 0, null)
                    r = v.t[0]
                for x in reverse k..last + 1:
                    untouch(x)
                sethints(v, r)
                reloads(pm, v)
                for x in reverse k..last + 1:
                    emiti(ins[x])
                continue
            bszero(w)
            if i.to != R:
                t = i64(i.to)
                if bshas(v, t):
                    bsclr(v, t)
                else: # the result needs a register
                    bsset(v, t)
                    bsset(w, t)
            j := i64(optab[i.op].nmem) if m.memargs else 0
            for x in 0..2:
                if rtype(i.arg[x]) == RMem:
                    j -= 1
            lvarg: array[bool, 2]
            for x in 0..2:
                switch rtype(i.arg[x]):
                case RMem:
                    a := fn.mem[rval(i.arg[x])]
                    if rtype(a.base) == RTmp:
                        bsset(v, i64(a.base))
                        bsset(w, i64(a.base))
                    if rtype(a.index) == RTmp:
                        bsset(v, i64(a.index))
                        bsset(w, i64(a.index))
                case RTmp:
                    t = i64(i.arg[x])
                    lvarg[x] = bshas(v, t)
                    bsset(v, t)
                    if j <= 0:
                        bsset(w, t)
                    j -= 1
            bscopy(u, v)
            limit2(v, 0, 0, w)
            untouch(k)
            for x in 0..2:
                if rtype(i.arg[x]) == RTmp:
                    t = i64(i.arg[x])
                    if not bshas(v, t):
                        # do not reload if the argument is dead
                        if not lvarg[x]:
                            bsclr(u, t)
                        i.arg[x] = slot(t)
            reloads(u, v)
            if i.to != R:
                t = i64(i.to)
                spillstore(i.to, i64(fn.tmp[t].slot))
                if t >= Tmp0: # in case i.to was a dead temporary
                    bsclr(v, t)
            emiti(i)
            r := v.t[0] # Tmp0 is NBit
            if r != 0:
                sethints(v, r)
        p := fn.blks[b].phi
        while p != 0:
            t = i64(fn.phis[p].to)
            if bshas(v, t):
                bsclr(v, t)
                spillstore(fn.phis[p].to, i64(fn.tmp[t].slot))
            elif bshas(ptr(fn.blks[b].live_in), t): # only if the phi is live
                fn.phis[p].to = slot(t)
            p = fn.phis[p].link
        bscopy(ptr(fn.blks[b].live_in), v)
        idup(b)
        regs.floor += span # the places count on through the blocks of every function
    # align the locals to a 16 byte boundary
    regs.slot8 += regs.slot8 and 3
    fn.slot += regs.slot8

func hint(t: i64) -> i64:
    return i64(fn.tmp[phicls(t)].hintr)

func sethint(t: i64, r: i64):
    p := ptr(fn.tmp[phicls(t)])
    if p.hintr == -1 or i64(p.hintw) > regs.loop:
        p.hintr = i32(r)
        p.hintw = i32(regs.loop)
        fn.tmp[t].visit = -1

func rcopy(ma: *RMap, mb: *RMap):
    ma.t = mb.t
    ma.r = mb.r
    ma.w = mb.w
    bscopy(ptr(ma.b), ptr(mb.b))
    ma.n = mb.n

func rfind(m: *RMap, t: i64) -> i64:
    for i in 0..m.n:
        if m.t[i] == t:
            return i64(m.r[i])
    return -1

func rref(m: *RMap, t: i64) -> Ref:
    r := rfind(m, t)
    if r == -1:
        return ref(RSlot, i64(fn.tmp[t].slot))
    return u32(r)

func radd(m: *RMap, t: i64, r: i64):
    bsset(ptr(m.b), t)
    bsset(ptr(m.b), r)
    m.t[m.n] = i32(t)
    m.r[m.n] = i32(r)
    m.n += 1
    regs.regu = regs.regu or u64(1) << r

func ralloctry(m: *RMap, t: i64, trying: bool) -> Ref:
    if t < Tmp0:
        return u32(t)
    if bshas(ptr(m.b), t):
        return u32(rfind(m, t))
    r := i64(fn.tmp[t].visit)
    if r == -1 or bshas(ptr(m.b), r):
        r = hint(t)
    if r == -1 or bshas(ptr(m.b), r):
        if trying:
            return R
        avoid := fn.tmp[phicls(t)].hintm or m.b.t[0]
        r0 := asm.machine.gpr0
        r1 := r0 + asm.machine.ngpr
        if kbase(fn.tmp[t].cls) != 0:
            r0 = asm.machine.fpr0
            r1 = r0 + asm.machine.nfpr
        r = r0
        while r < r1 and (avoid and u64(1) << r) != 0:
            r += 1
        if r == r1:
            r = r0
            while r < r1 and bshas(ptr(m.b), r):
                r += 1
            if r == r1:
                panic("no more regs")
    radd(m, t, r)
    sethint(t, r)
    fn.tmp[t].visit = i32(r)
    h := hint(t)
    if h != -1 and h != r:
        m.w[h] = i32(t)
    return u32(r)

func ralloc(m: *RMap, t: i64) -> Ref:
    return ralloctry(m, t, false)

func rfree(m: *RMap, t: i64) -> i64:
    if not bshas(ptr(m.b), t):
        return -1
    i := 0
    while m.t[i] != t:
        i += 1
    r := i64(m.r[i])
    bsclr(ptr(m.b), t)
    bsclr(ptr(m.b), r)
    m.n -= 1
    for j in i..m.n:
        m.t[j] = m.t[j + 1]
        m.r[j] = m.r[j + 1]
    return r

func pmadd(src: Ref, dst: Ref, k: i64):
    append(regs.moves, Move{src, dst, k})

ToMove = 0
Moving = 1
Moved = 2

func swap(a: Ref, b: Ref, k: i64):
    if isreg(a) and isreg(b):
        emit(Oswap, k, R, a, b)
        return
    if regs.scratch == -1:
        fn.slot = (fn.slot + 3) and -4
        regs.scratch = fn.slot
        fn.slot += 4
    tmp := ref(RSlot, regs.scratch)
    emit(Ocopy, k, b, tmp, R) # fn.out is reversed by idup()
    emit(Ocopy, k, a, b, R)
    emit(Ocopy, k, tmp, a, R)

func pmrec(i: i64, k: *i64) -> i64:
    pm := regs.moves
    if pm[i].src == pm[i].dst:
        regs.status[i] = Moved
        return -1
    if k.* == Kv or pm[i].cls == Kv:
        k.* = Kv
    else:
        k.* = k.* or pm[i].cls
    j := 0
    while j < pm.len and pm[j].dst != pm[i].src:
        j += 1
    c := -1
    st := Moved if j == pm.len else regs.status[j]
    if st == Moving:
        c = j # start of cycle
        swap(pm[i].src, pm[i].dst, k.*)
    elif st == ToMove:
        regs.status[i] = Moving
        c = pmrec(j, k)
        if c == i:
            c = -1 # end of cycle
        elif c != -1:
            swap(pm[i].src, pm[i].dst, k.*)
        else:
            emit(Ocopy, pm[i].cls, pm[i].dst, pm[i].src, R)
    else:
        emit(Ocopy, pm[i].cls, pm[i].dst, pm[i].src, R)
    regs.status[i] = Moved
    return c

func pmgen():
    regs.status.len = 0
    for i in 0..regs.moves.len:
        append(regs.status, ToMove)
    for i in 0..regs.moves.len:
        if regs.status[i] == ToMove:
            k := regs.moves[i].cls
            _ = pmrec(i, ptr(k))

func move(r: i64, to: Ref, m: *RMap):
    if to != R:
        _ = rfree(m, i64(to))
    if bshas(ptr(m.b), r):
        # r is used and not by to
        n := 0
        while m.r[n] != r:
            n += 1
        t := i64(m.t[n])
        _ = rfree(m, t)
        bsset(ptr(m.b), r)
        _ = ralloc(m, t)
        bsclr(ptr(m.b), r)
    t := r if to == R else i64(to)
    radd(m, t, r)

# the places of the refs an instruction reads, as rega gives them registers: 0 and 1 are its arguments, 2 + 2 * m and
# 3 + 2 * m the base and the index of the address m
func refat(x: i64) -> Ref:
    if x < 2:
        return fn.out[regs.at].arg[x]
    a := fn.mem[(x - 2) / 2]
    return a.base if x % 2 == 0 else a.index

func setref(x: i64, r: Ref):
    if x < 2:
        fn.out[regs.at].arg[x] = r
    elif x % 2 == 0:
        fn.mem[(x - 2) / 2].base = r
    else:
        fn.mem[(x - 2) / 2].index = r

func insert(x: i64, ra: *array[i64, 4], p: i64):
    ra[p] = x
    i := p
    # the hinted ones first
    while i > 0 and hint(i64(refat(x))) != -1:
        i -= 1
        ra[i + 1] = ra[i]
        ra[i] = x

# peel loop nests from inside out
func carve(a: i64, b: i64) -> bool:
    if fn.blks[a].loop == fn.blks[b].loop:
        return fn.blks[a].id > fn.blks[b].id
    return fn.blks[a].loop > fn.blks[b].loop

func rega():
    mc := ptr(asm.machine)
    # 1. setup
    regs.regu = 0
    for maps in [ptr(regs.beg), ptr(regs.end)]:
        while maps.len < fn.nblk:
            append(maps, RMap{})
        for k in 0..fn.nblk:
            bsinit(ptr(maps[k].b))
    bsinit(ptr(regs.cur.b))
    regs.loop = 2147483647
    regs.scratch = -1
    for t in 0..fn.ntmp:
        fn.tmp[t].hintr = i32(t) if t < Tmp0 else -1
        fn.tmp[t].hintw = i32(regs.loop)
        fn.tmp[t].visit = -1
    blk := ptr(regs.blk)
    blk.len = 0
    linked := fn.start
    while linked != 0:
        append(blk, linked)
        linked = fn.blks[linked].link
    sort(blk.*, carve)
    for i in fn.blks[fn.start].ins:
        if i.op != Ocopy or not isreg(i.arg[0]):
            break
        sethint(i64(i.to), i64(i.arg[0]))
    # 2. assign registers
    cur := ptr(regs.cur)
    for b in blk.*:
        n := fn.blks[b].id
        regs.loop = i64(fn.blks[b].loop)
        cur.n = 0
        bszero(ptr(cur.b))
        for j in 0..64:
            cur.w[j] = 0
        rl := ptr(regs.rl) # the temps live at the end, the allocated first, then the hinted, then the costlier
        count := 0
        t := bsiter(ptr(fn.blks[b].live_out), Tmp0)
        while t >= 0:
            j := count
            count += 1
            rl[j] = t
            while j > 0:
                v1 := fn.tmp[t].visit
                v2 := fn.tmp[rl[j - 1]].visit
                first := v1 != -1
                if (v1 xor v2) >= 0:
                    h1 := hint(t)
                    first = h1 != -1
                    if (h1 xor hint(rl[j - 1])) >= 0:
                        first = i32(fn.tmp[t].cost - fn.tmp[rl[j - 1]].cost) > 0
                if not first:
                    break
                j -= 1
                rl[j + 1] = rl[j]
                rl[j] = t
            t = bsiter(ptr(fn.blks[b].live_out), t + 1)
        t = bsiter(ptr(fn.blks[b].live_out), 0)
        while t >= 0 and t < Tmp0:
            radd(cur, t, t)
            t = bsiter(ptr(fn.blks[b].live_out), t + 1)
        for j in 0..count:
            _ = ralloctry(cur, rl[j], true)
        for j in 0..count:
            _ = ralloc(cur, rl[j])
        rcopy(ptr(regs.end[n]), cur)
        if rtype(fn.blks[b].jmp.arg) == RTmp:
            fn.blks[b].jmp.arg = ralloc(cur, i64(fn.blks[b].jmp.arg))
        fn.out.len = 0
        k := fn.blks[b].ins.len
        while k > 0:
            k -= 1
            emiti(fn.blks[b].ins[k])
            regs.at = fn.out.len - 1
            i := fn.out[regs.at]
            rf := -1
            dropped := false
            switch i.op:
            case Ocall:
                c: array[i64, 2]
                rs := mc.argregs(i.arg[1], ptr(c)) or mc.rglob
                for r in mc.rsave:
                    if r >= 0 and (u64(1) << r and rs) == 0:
                        _ = rfree(cur, r)
            case:
                if regcpy(i): # with the copies from registers before it, one large parallel move
                    fn.out.len -= 1
                    ins := fn.blks[b].ins
                    last := k
                    t0 := cur.t
                    r0 := cur.r
                    n0 := cur.n
                    while true:
                        move(i64(ins[k].arg[0]), ins[k].to, cur)
                        if k == 0 or not regcpy(ins[k - 1]):
                            break
                        k -= 1
                    if k != 0 and ins[k - 1].op == Ocall:
                        c: array[i64, 2]
                        rs := mc.retregs(ins[k - 1].arg[1], ptr(c)) or mc.rglob
                        for r in mc.rsave:
                            if r >= 0 and (u64(1) << r and rs) == 0:
                                move(r, R, cur)
                    regs.moves.len = 0
                    for x in 0..cur.n:
                        t = i64(cur.t[x])
                        r := -1
                        for y in 0..n0:
                            if t0[y] == t:
                                r = i64(r0[y])
                                break
                        if r != -1:
                            pmadd(u32(cur.r[x]), u32(r), i64(fn.tmp[t].cls))
                        elif fn.tmp[t].slot != -1:
                            pmadd(u32(cur.r[x]), ref(RSlot, i64(fn.tmp[t].slot)), i64(fn.tmp[t].cls))
                    for x in k..last + 1:
                        if ins[x].to != R:
                            _ = rfree(cur, i64(ins[x].to))
                        r := i64(ins[x].arg[0])
                        if rfind(cur, r) == -1:
                            radd(cur, r, r)
                    pmgen()
                    continue
                if i.op == Ocopy and isreg(i.to) and rtype(i.arg[0]) == RTmp:
                    sethint(i64(i.arg[0]), i64(i.to))
                if i.to != R and not (i.to < Tmp0 and (u64(1) << i.to and mc.rglob) != 0):
                    rf = rfree(cur, i64(i.to))
                    if rf == -1:
                        fn.out.len -= 1
                        dropped = true
                    else:
                        fn.out[fn.out.len - 1].to = u32(rf)
            if dropped:
                continue
            ra: array[i64, 4]
            nr := 0
            for x in 0..2:
                switch rtype(i.arg[x]):
                case RMem:
                    a := fn.mem[rval(i.arg[x])]
                    if rtype(a.base) == RTmp:
                        insert(2 + 2 * rval(i.arg[x]), ptr(ra), nr)
                        nr += 1
                    if rtype(a.index) == RTmp:
                        insert(3 + 2 * rval(i.arg[x]), ptr(ra), nr)
                        nr += 1
                case RTmp:
                    insert(x, ptr(ra), nr)
                    nr += 1
            for x in 0..nr:
                setref(ra[x], ralloc(cur, i64(refat(ra[x]))))
            last := fn.out[fn.out.len - 1]
            if last.op == Ocopy and last.to == last.arg[0]:
                fn.out.len -= 1
            # a hinted temp moves to rf when rf is free
            if rf != -1:
                t = i64(cur.w[rf])
                if t != 0 and not bshas(ptr(cur.b), rf) and hint(t) == rf:
                    rt := rfree(cur, t)
                    if rt != -1:
                        fn.tmp[t].visit = -1
                        _ = ralloc(cur, t)
                        emit(Ocopy, fn.tmp[t].cls, u32(rt), u32(rf), R)
                        cur.w[rf] = 0
                        for x in 0..nr:
                            if refat(ra[x]) == u32(rt):
                                setref(ra[x], u32(rf))
        idup(b)
        bscopy(ptr(fn.blks[b].live_in), ptr(cur.b))
        p := fn.blks[b].phi
        while p != 0:
            if rtype(fn.phis[p].to) == RTmp:
                bsclr(ptr(fn.blks[b].live_in), i64(fn.phis[p].to))
            p = fn.phis[p].link
        rcopy(ptr(regs.beg[n]), cur)
    # 3. emit copies shared by multiple edges to the same block
    s := fn.start
    while s != 0:
        if fn.blks[s].pred.len <= 1:
            s = fn.blks[s].link
            continue
        m := ptr(regs.beg[fn.blks[s].id])
        # rl maps a register live at the start of s to the one all its predecessors use, or -1
        rl := ptr(regs.rl)
        for j in 0..64:
            rl[j] = 0
        # the register of a phi in a predecessor is that of its argument from there
        p := fn.blks[s].phi
        while p != 0:
            ph := fn.phis[p]
            r := -1
            if rtype(ph.to) == RTmp:
                r = rfind(m, i64(ph.to))
            if r != -1:
                for u in 0..ph.arg.len:
                    src := ph.arg[u]
                    if rtype(src) != RTmp:
                        continue
                    x := rfind(ptr(regs.end[fn.blks[ph.blk[u]].id]), i64(src))
                    if x == -1: # spilled
                        continue
                    rl[r] = x if rl[r] == 0 or rl[r] == x else -1
                if rl[r] == 0:
                    rl[r] = -1
            p = ph.link
        # the temps that are not phis
        for j in 0..m.n:
            t := i64(m.t[j])
            r := i64(m.r[j])
            if rl[r] != 0 or t < Tmp0:
                continue
            for bp in fn.blks[s].pred:
                x := rfind(ptr(regs.end[fn.blks[bp].id]), t)
                if x == -1: # spilled
                    continue
                rl[r] = x if rl[r] == 0 or rl[r] == x else -1
            if rl[r] == 0:
                rl[r] = -1
        regs.moves.len = 0
        for j in 0..m.n:
            t := i64(m.t[j])
            r := i64(m.r[j])
            x := rl[r]
            if x > 0 and not bshas(ptr(m.b), x):
                pmadd(u32(x), u32(r), i64(fn.tmp[t].cls))
                m.r[j] = i32(x)
                bsset(ptr(m.b), x)
        fn.out.len = 0
        pmgen()
        if fn.out.len > 0:
            ins := ptr(fn.blks[s].ins)
            moved: &list[Instr] = heap([])
            for k in reverse 0..fn.out.len:
                append(moved, fn.out[k])
            append(moved, ins.*[:])
            ins.* = moved[:]
            free(moved)
        s = fn.blks[s].link
    # 4. emit remaining copies in new blocks
    blist := 0
    b := fn.start
    while true:
        for which in 0..2 + fn.blks[b].targets.len: # s1, s2, then the targets of a jump table
            s = fn.blks[b].s1 if which == 0 else fn.blks[b].s2 if which == 1 else fn.blks[b].targets[which - 2]
            if s == 0:
                continue
            regs.moves.len = 0
            p := fn.blks[s].phi
            while p != 0:
                ph := fn.phis[p]
                dst := ph.to
                if rtype(dst) == RTmp:
                    r := rfind(ptr(regs.beg[fn.blks[s].id]), i64(dst))
                    if r == -1:
                        p = ph.link
                        continue
                    dst = u32(r)
                u := 0
                while ph.blk[u] != b:
                    u += 1
                src := ph.arg[u]
                if rtype(src) == RTmp:
                    src = rref(ptr(regs.end[fn.blks[b].id]), i64(src))
                pmadd(src, dst, i64(ph.cls))
                p = ph.link
            t := bsiter(ptr(fn.blks[s].live_in), Tmp0)
            while t >= 0:
                src := rref(ptr(regs.end[fn.blks[b].id]), t)
                dst := rref(ptr(regs.beg[fn.blks[s].id]), t)
                pmadd(src, dst, i64(fn.tmp[t].cls))
                t = bsiter(ptr(fn.blks[s].live_in), t + 1)
            fn.out.len = 0
            pmgen()
            if fn.out.len == 0:
                continue
            b1 := newblk()
            fn.blks[b1].loop = (fn.blks[b].loop + fn.blks[s].loop) / 2
            fn.blks[b1].link = blist
            blist = b1
            fn.nblk += 1
            idup(b1)
            for i in fn.blks[s].ins: # the moves take the line of s, which they enter, or a debugger stepping there skips it
                if i.op == Odbgloc:
                    insert(fn.blks[b1].ins, 0, i)
                    break
            fn.blks[b1].jmp.type = Jjmp
            fn.blks[b1].s1 = s
            if which == 0:
                fn.blks[b].s1 = b1
            elif which == 1:
                fn.blks[b].s2 = b1
            else:
                fn.blks[b].targets[which - 2] = b1
        if fn.blks[b].link == 0:
            fn.blks[b].link = blist
            break
        b = fn.blks[b].link
    b = fn.start
    while b != 0:
        fn.blks[b].phi = 0
        b = fn.blks[b].link
    fn.reg = regs.regu
