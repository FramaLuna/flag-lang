# the condition of each comparison, and of its negation
AMD64_CONDITIONS: array[&strview, 36] = ["z", "nz", "nz", "z", "ge", "l", "g", "le", "le", "g", "l", "ge", "ae", "b", "a", "be", "be", "a", "b", "ae", "", "", "ae", "b", "a", "be", "?", "?", "?", "?", "", "", "np", "p", "p", "np"]

REGISTER_NAMES: array[&strview, 68] = ["", "", "", "", "rax", "eax", "ax", "al", "rcx", "ecx", "cx", "cl", "rdx", "edx", "dx", "dl", "rsi", "esi", "si", "sil", "rdi", "edi", "di", "dil", "r8", "r8d", "r8w", "r8b", "r9", "r9d", "r9w", "r9b", "r10", "r10d", "r10w", "r10b", "r11", "r11d", "r11w", "r11b", "rbx", "ebx", "bx", "bl", "r12", "r12d", "r12w", "r12b", "r13", "r13d", "r13w", "r13b", "r14", "r14d", "r14w", "r14b", "r15", "r15d", "r15w", "r15b", "rbp", "ebp", "bp", "bpl", "rsp", "esp", "sp", "spl"]
XMM_NAMES: array[&strview, 16] = ["xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15"]

func reg_name(reg: i64, sz: i64) -> &strview:
    if reg >= XMM0:
        return XMM_NAMES[reg - XMM0]
    return REGISTER_NAMES[4 * reg + sz]

func slot_offset(r: Ref) -> i64:
    s := ref_signed(r)
    assert s <= fn.slots, "a slot of " + fn.name + " lies past its frame"
    if s < 0:
        return 4 * (0 - s)
    return -4 * (fn.slots - s) - amd64.saved

func emit_immediate(c: Immediate):
    if c.type == Addressed:
        l := asm.symbols[c.symbol]
        p := asm.machine.symbol_prefix
        if l[0] == '"':
            p = ""
        if c.access == ThreadData:
            assert not asm.machine.apple and not asm.machine.windows, "thread data of " + fn.name + " is read through fs"
            out("%fs:")
            out(p)
            out(l)
            out("@tpoff")
        else:
            assert (c.access and ThreadData) == 0, "thread data of " + fn.name + " is read as a plain symbol"
            out(p)
            out(l)
        if c.bits != 0:
            if c.bits > 0:
                out("+")
            asm.text += c.bits
    else:
        asm.text += c.bits

func arg_of(c: u8, i: *Instr) -> Ref:
    switch c:
    case '0':
        return i.arg[0]
    case '1':
        return i.arg[1]
    return i.to

func emit_copy(r1: Ref, r2: Ref, k: i64):
    emit_instr(Instr{op = Ocopy, cls = i32(k), to = r1, arg = [r2, EMPTY]})

func emit_address(r: Ref):
    m := ptr(fn.addresses[ref_value(r)])
    if ref_kind(m.base) == RefSlot:
        _ = add_constant(ptr(m.offset), Immediate{type = Numeric, bits = slot_offset(m.base)}, 1)
        m.base = RBP
    if m.offset.type != Unset:
        emit_immediate(m.offset)
    out("(")
    if m.base != EMPTY:
        out("%")
        out(reg_name(i64(m.base), Width64))
    elif m.offset.type == Addressed:
        out("%rip")
    if m.index != EMPTY:
        out(", %")
        out(reg_name(i64(m.index), Width64))
        out(", ")
        asm.text += m.scale
    out(")")

func emit_format(fmt: &strview, i: *Instr):
    s := items(fmt)
    k := 0
    if s[0] == '+' or s[0] == '-':
        if s[0] == '+' and i.arg[1] == i.to:
            r := i.arg[0]
            i.arg[0] = i.arg[1]
            i.arg[1] = r
        assert i.arg[1] != i.to or i.arg[0] == i.to, "an instruction of " + fn.name + " has no 2-address form"
        emit_copy(i.to, i.arg[0], i64(i.cls))
        k = 1
    out("\t")
    while k < s.len:
        c := s[k]
        k += 1
        if c != '%':
            add_byte(asm.text, c)
            continue
        c = s[k]
        k += 1
        sz := Width64
        switch c:
        case '%':
            out("%")
            continue
        case 'k':
            out(["l", "q", "ss", "sd"][i.cls])
            continue
        case '0', '1', '=':
            sz = Width64 if wide(i.cls) != 0 else Width32
            k -= 1
        case 'D', 'S', 'L':
            sz = Width64
        case 'W':
            sz = Width32
        case 'H':
            sz = Width16
        case 'B':
            sz = Width8
        case 'M':
            r := arg_of(s[k], i)
            k += 1
            switch ref_kind(r):
            case RefAddress:
                emit_address(r)
            case RefSlot:
                asm.text += slot_offset(r)
                out("(%rbp)")
            case RefConstant:
                cn := fn.constants[ref_value(r)]
                emit_immediate(cn)
                if cn.type == Addressed and cn.access != ThreadData:
                    out("(%rip)")
            case RefTemp:
                assert is_register(r), "a temp of " + fn.name + " has no register"
                out("(%")
                out(reg_name(i64(r), Width64))
                out(")")
            continue
        r := arg_of(s[k], i)
        k += 1
        switch ref_kind(r):
        case RefTemp:
            assert is_register(r), "a temp of " + fn.name + " has no register"
            out("%")
            out(reg_name(i64(r), sz))
        case RefSlot:
            asm.text += slot_offset(r)
            out("(%rbp)")
        case RefAddress:
            emit_address(r)
        case RefInt:
            out("$")
            asm.text += ref_signed(r)
        case RefConstant:
            cn := fn.constants[ref_value(r)]
            if cn.type == Numeric:
                switch sz:
                case Width32:
                    cn.bits = cn.bits << 32 >> 32
                case Width16:
                    cn.bits = cn.bits << 48 >> 48
                case Width8:
                    cn.bits = cn.bits << 56 >> 56
            out("$")
            emit_immediate(cn)
    out("\n")

# the vector instructions from Ovaddi8 on, and their lanes: c is commutative, n is not, r is not with its arguments
# the other way around, u has one argument, s shifts, b and f splat an int and a float
VECTOR_FORMS: &strview = "ccccccnnnnnnccccnncccssssssssccccccnnnnnnnnrrrruubbbbffu"
VECTOR_NAMES: array[&strview, 56] = [
    "paddb", "paddw", "paddd", "paddq", "addps", "addpd",
    "psubb", "psubw", "psubd", "psubq", "subps", "subpd",
    "pmullw", "pmulld", "mulps", "mulpd",
    "divps", "divpd",
    "andps", "orps", "xorps",
    "psllw", "pslld", "psllq", "psrlw", "psrld", "psrlq", "psraw", "psrad",
    "pcmpeqb", "pcmpeqw", "pcmpeqd", "pcmpeqq", "cmpeqps", "cmpeqpd",
    "pcmpgtb", "pcmpgtw", "pcmpgtd", "pcmpgtq", "cmpltps", "cmpltpd", "cmpleps", "cmplepd",
    "minps", "minpd", "maxps", "maxpd",
    "sqrtps", "sqrtpd",
    "movd %W0, %=\n\tpunpcklbw %=, %=\n\tpshuflw $0, %=, %=\n\tpshufd $0, %=, %=",
    "movd %W0, %=\n\tpshuflw $0, %=, %=\n\tpshufd $0, %=, %=",
    "movd %W0, %=\n\tpshufd $0, %=, %=",
    "movq %L0, %=\n\tpunpcklqdq %=, %=",
    "movaps %0, %=\n\tshufps $0, %=, %=",
    "movaps %0, %=\n\tunpcklpd %=, %=",
    "cvtdq2ps",
]

func emit_table(i: Instr):
    emit_format(format(AMD64_FORMS[:], i), ptr(i))

func emit_instr(i: Instr):
    m := ptr(asm.machine)
    switch i.op:
    case Onop:
        pass # inserted by some passes
    case Omul:
        # the 3-address form when it can
        if ref_kind(i.arg[1]) == RefConstant:
            r := i.arg[0]
            i.arg[0] = i.arg[1]
            i.arg[1] = r
        if bank(i.cls) == 0 and ref_kind(i.arg[0]) == RefConstant and ref_kind(i.arg[1]) == RefTemp: # only available for ints
            emit_format("imul%k %0, %1, %=", ptr(i))
        else:
            emit_table(i)
    case Osub:
        # a subtraction into its second argument negates it and adds
        if i.to == i.arg[1] and i.arg[0] != i.to:
            emit_instr(Instr{op = Oneg, cls = i.cls, to = i.to, arg = [i.to, EMPTY]})
            emit_format("add%k %0, %=", ptr(i))
        else:
            emit_table(i)
    case Oi32tof, Oi64tof, Oextf32, Otruncf64:
        # these keep the old upper bits too
        if i.to != i.arg[0]:
            emit_format("xorps %=, %=", ptr(i))
        emit_table(i)
    case Oneg:
        emit_copy(i.to, i.arg[0], i64(i.cls))
        if bank(i.cls) == 0:
            emit_format("neg%k %=", ptr(i))
        else:
            n := float_constant(u64(0x8000_0000) if i.cls == Float32 else 0x8000_0000_0000_0000, 16)
            out("\txorp" + "xxsd"[i.cls:i.cls + 1] + " " + m.local_prefix + "fp" + n + "(%rip), %" + reg_name(i64(i.to), Width64) + "\n")
    case Odiv:
        # xmm15 holds a divisor that is also the result, which emit_format cannot make 2-address
        if i.to == i.arg[1]:
            i.arg[1] = XMM15
            emit_copy(i.arg[1], i.to, i64(i.cls))
            emit_copy(i.to, i.arg[0], i64(i.cls))
            i.arg[0] = i.to
        emit_table(i)
    case Ocopy:
        # big constants as in https://c9x.me/notes/2015-09-19.html
        if i.to == EMPTY or i.arg[0] == EMPTY or i.to == i.arg[0]:
            return
        t0 := ref_kind(i.arg[0])
        # movss between registers keeps the old upper bits, so it waits for them
        if bank(i.cls) != 0 and is_register(i.to) and is_register(i.arg[0]):
            emit_format("movaps %0, %=", ptr(i))
            return
        if i.cls == Vector:
            if is_register(i.to):
                emit_format("movups %M0, %=", ptr(i))
            elif is_register(i.arg[0]):
                emit_format("movups %0, %M=", ptr(i))
            else:
                emit_format("movups %M0, %%xmm15", ptr(i))
                emit_format("movups %%xmm15, %M=", ptr(i))
            return
        if i.cls == Int64 and t0 == RefConstant and fn.constants[ref_value(i.arg[0])].type == Numeric:
            val := fn.constants[ref_value(i.arg[0])].bits
            if is_register(i.to) and val >= 0 and val <= 0xffff_ffff:
                emit_format("movl %W0, %W=", ptr(i))
                return
            if ref_kind(i.to) == RefSlot and (val < -2147483648 or val > 2147483647):
                emit_format("movl %0&0xffffffff, %=", ptr(i))
                emit_format("movl %0>>32, 4+%=", ptr(i))
                return
        if is_register(i.to) and t0 == RefConstant and fn.constants[ref_value(i.arg[0])].type == Addressed:
            emit_format("lea%k %M0, %=", ptr(i))
            return
        if ref_kind(i.to) == RefSlot and (t0 == RefSlot or t0 == RefAddress):
            i.cls = Float64 if wide(i.cls) != 0 else Float32
            i.arg[1] = XMM15
            emit_format("mov%k %0, %1", ptr(i))
            emit_format("mov%k %1, %=", ptr(i))
            return
        # the assembler makes a movq a movabsq when it must
        emit_format("mov%k %0, %=", ptr(i))
    case Oaddr:
        if ref_kind(i.arg[0]) != RefConstant:
            emit_table(i)
            return
        c := fn.constants[ref_value(i.arg[0])]
        sym := asm.symbols[c.symbol]
        p := m.symbol_prefix
        if sym[0] == '"':
            p = ""
        to := reg_name(i64(i.to), Width64)
        if m.apple and (c.access and ThreadData) != 0:
            out("\tmovq " + p + sym + "@tlvp(%rip), %" + to + "\n")
            return
        if m.windows and c.access == ThreadData:
            # the block of this thread is entry _tls_index of the table at gs:88, one more register is borrowed on the
            # stack and the flags are kept; the offset is a difference of rip addresses, GNU ld relocates SECREL in code
            # when the image moves
            br := reg_name(RCX if i64(i.to) == RAX else RAX, Width64)
            out("\tpushq %" + br + "\n\tmovl _tls_index(%rip), %" + reg_name(RCX if i64(i.to) == RAX else RAX, Width32) + "\n")
            out("\tmovq %gs:88, %" + to + "\n\tmovq (%" + to + ",%" + br + ",8), %" + to + "\n")
            out("\tleaq " + p + sym + "(%rip), %" + br + "\n\tleaq (%" + to + ",%" + br + "), %" + to + "\n")
            out("\tleaq _tls_start(%rip), %" + br + "\n\tnotq %" + br + "\n\tleaq 1(%" + to + ",%" + br + "), %" + to + "\n")
            out("\tpopq %" + br + "\n")
            if c.bits != 0:
                out("\tleaq ")
                asm.text += c.bits
                out("(%" + to + "), %" + to + "\n")
            return
        if m.windows and c.access != Direct:
            panic("extern unsupported on amd64_win")
        switch c.access:
        case ThreadData:
            # derive the symbol address from the TCB address at offset 0 of %fs
            emit_format("movq %%fs:0, %L=", ptr(i))
            out("\tleaq " + p + sym + "@tpoff")
            if c.bits > 0:
                out("+")
            if c.bits != 0:
                asm.text += c.bits
            out("(%" + to + "), %" + to + "\n")
        case ThreadThroughGot:
            assert c.bits == 0, "an address of " + fn.name + " read from the GOT loses its offset"
            # initial-exec TLS: load offset from GOT, add to thread-base register
            emit_format("movq %%fs:0, %L=", ptr(i))
            out("\taddq " + p + sym + "@gottpoff(%rip), %" + to + "\n")
        case ThroughGot:
            assert c.bits == 0, "an address of " + fn.name + " read from the GOT loses its offset"
            # load address from the GOT
            out("\tmovq " + p + sym + "@gotpcrel(%rip), %" + to + "\n")
        case:
            emit_table(i)
    case Ocall:
        if ref_kind(i.arg[0]) == RefConstant:
            c := fn.constants[ref_value(i.arg[0])]
            out("\tcallq ")
            emit_immediate(c)
            if c.type == Addressed and (c.access and ThroughGot) != 0 and not m.apple:
                out("@plt")
            out("\n")
        else:
            emit_format("callq *%L0", ptr(i))
    case Ostackalloc:
        emit_format("subq %L0, %%rsp", ptr(i))
        if i.to != EMPTY:
            emit_copy(i.to, RSP, Int64)
    case Oswap:
        if bank(i.cls) == 0:
            emit_table(i)
            return
        # floats swap through xmm15
        emit_copy(XMM15, i.arg[0], i64(i.cls))
        emit_copy(i.arg[0], i.arg[1], i64(i.cls))
        emit_copy(i.arg[1], XMM15, i64(i.cls))
    case Odebugline:
        emit_line(ref_value(i.arg[0]), ref_value(i.arg[1]))
    case Odebugslot:
        emit_slot(i.arg[1], slot_offset(i.arg[0]))
    case Odebugmark:
        emit_mark(i.arg[0])
    case Oframe:
        emit_copy(i.to, RBP, Int64)
    case Ovget:
        if i.cls == Float64: # pshufd takes the words 2n and 2n + 1
            i.arg[1] = ref(RefInt, 10 * ref_signed(i.arg[1]) + 4)
        emit_table(i)
    case Ovlane:
        asm.lane = ref_signed(i.arg[0])
    case Ovseti8, Ovseti16, Ovseti32, Ovseti64, Ovsetf32, Ovsetf64:
        # xmm15 holds a float to put that is also the result
        if i.to == i.arg[1] and i.to != i.arg[0]:
            emit_copy(XMM15, i.arg[1], Vector)
            i.arg[1] = XMM15
        emit_copy(i.to, i.arg[0], Vector)
        i.arg[0] = ref(RefInt, asm.lane << 4 if i.op == Ovsetf32 else asm.lane)
        if i.op != Ovsetf64:
            emit_table(i)
        elif asm.lane != 0:
            emit_format("unpcklpd %1, %=", ptr(i))
        else:
            emit_format("movsd %1, %=", ptr(i))
    case:
        if is_cmov(i.op):
            c := i64(i.op) - Oamd64cmoveqi
            if i.to == i.arg[1]:
                emit_format("cmov" + AMD64_CONDITIONS[2 * c] + " %0, %=", ptr(i))
            else:
                if i.to != i.arg[0]:
                    emit_format("mov %0, %=", ptr(i))
                emit_format("cmov" + AMD64_CONDITIONS[2 * c + 1] + " %1, %=", ptr(i))
        elif is_vector(i.op): # xmm15 is the scratch, it holds an argument that is also the result, or a shift amount
            form := VECTOR_FORMS[i.op - Ovaddi8]
            n := VECTOR_NAMES[i.op - Ovaddi8]
            switch form:
            case 'b':
                emit_format(n, ptr(i))
                return
            case 'f':
                if i.to == i.arg[0]:
                    emit_format(n[(trust find(n, "\n")) + 2:], ptr(i))
                else:
                    emit_format(n, ptr(i))
                return
            case 'u':
                out("\t" + n + " %" + reg_name(i64(i.arg[0]), Width64) + ", %" + reg_name(i64(i.to), Width64) + "\n")
                return
            case 'r':
                r := i.arg[0]
                i.arg[0] = i.arg[1]
                i.arg[1] = r
            case 's':
                if ref_kind(i.arg[1]) == RefTemp:
                    out("\tmovd %" + reg_name(i64(i.arg[1]), Width32) + ", %xmm15\n")
                    i.arg[1] = XMM15
            if i.to == i.arg[1] and i.to != i.arg[0]:
                if form == 'c':
                    r := i.arg[0]
                    i.arg[0] = i.arg[1]
                    i.arg[1] = r
                else:
                    emit_copy(XMM15, i.arg[1], Vector)
                    i.arg[1] = XMM15
            emit_copy(i.to, i.arg[0], Vector)
            out("\t" + n + " ")
            if ref_kind(i.arg[1]) == RefConstant:
                out("$")
                asm.text += fn.constants[ref_value(i.arg[1])].bits
            else:
                out("%" + reg_name(i64(i.arg[1]), Width64))
            out(", %" + reg_name(i64(i.to), Width64) + "\n")
        else:
            emit_table(i)

# every function keeps a frame pointer, so the runtime can walk the calls when the program fails
func start_frame():
    out("\tpushq %rbp\n")
    if asm.machine.windows:
        out("\t.seh_pushreg %rbp\n")
    if comp.debug:
        out("\t.cfi_def_cfa_offset 16\n\t.cfi_offset %rbp, -16\n")
    out("\tmovq %rsp, %rbp\n")
    if comp.debug:
        out("\t.cfi_def_cfa_register %rbp\n")

# lower rsp by the frame, a page at a time when probing
func lower_frame():
    n := amd64.frame
    if not probing(n):
        if n != 0:
            out("\tsubq $")
            asm.text += n
            out(", %rsp\n")
        return
    if n >= 4096:
        out("\tmovl $")
        asm.text += n / 4096
        out(", %r11d\n1:\n\tsubq $4096, %rsp\n\torq $0, (%rsp)\n\tsubl $1, %r11d\n\tjnz 1b\n")
    if n % 4096 != 0:
        out("\tsubq $")
        asm.text += n % 4096
        out(", %rsp\n\torq $0, (%rsp)\n")

# the blocks and their jumps; windows jumps with the flags of floats the other way around
func emit_blocks(keep: func(bool)):
    lbl := false
    b := fn.start
    while b != 0:
        p := ptr(fn.blocks[b])
        if lbl or p.preds.len > 1:
            if not asm.machine.windows:
                back := false
                for q in p.preds:
                    back = back or fn.blocks[q].id >= p.id
                if back:
                    out(".p2align 4\n")
            out(asm.machine.local_prefix + "bb")
            asm.text += asm.blocks + p.id
            out(":\n")
        for k in 0..fn.blocks[b].ins.len:
            emit_instr(fn.blocks[b].ins[k])
        p = ptr(fn.blocks[b])
        lbl = true
        j := i64(p.exit.type)
        if j == Jhalt:
            out("\tud2\n")
        elif j == Jtable:
            jump := Instr{arg = [p.exit.arg, EMPTY]}
            emit_format("jmp *%L0", ptr(jump))
        elif j == Jreturn:
            keep(true)
            if comp.debug:
                out("\t.cfi_remember_state\n")
            out("\tleave\n")
            if comp.debug:
                out("\t.cfi_def_cfa %rsp, 8\n")
            out("\tret\n")
            if comp.debug:
                out("\t.cfi_restore_state\n")
        else:
            if j != Jjump:
                c := j - Jflag
                if c < 0 or c > CONDITIONS:
                    panic("unhandled jump " + j)
                n := 1
                if p.next == p.no or asm.machine.windows and c >= INT_CONDITIONS:
                    s := p.yes
                    p.yes = p.no
                    p.no = s
                    n = 0
                out("\tj" + AMD64_CONDITIONS[2 * c + n] + " " + asm.machine.local_prefix + "bb")
                asm.text += asm.blocks + fn.blocks[p.no].id
                out("\n")
            if p.yes != p.next:
                out("\tjmp " + asm.machine.local_prefix + "bb")
                asm.text += asm.blocks + fn.blocks[p.yes].id
                out("\n")
            else:
                lbl = false
        b = p.next
    emit_function_end(asm.machine.local_prefix + "bb")

func sysv_saved(restore: bool):
    if not restore:
        return
    if fn.dynamic_alloc:
        out("\tmovq %rbp, %rsp\n\tsubq $")
        asm.text += amd64.frame + amd64.pushed * 8
        out(", %rsp\n")
    for r in reverse SYSV_CALLEE_SAVED:
        if (fn.used_regs and reg_bit(r)) != 0:
            out("\tpopq %" + reg_name(r, Width64) + "\n")

func sysv_emit_function():
    emit_function_symbol(16)
    out("\tendbr64\n")
    start_frame()
    o: u64 = 0
    if not fn.leaf:
        for r in SYSV_CALLEE_SAVED:
            o = o xor fn.used_regs >> r
        o = o and 1
    amd64.saved = 0
    amd64.pushed = 0
    amd64.frame = 4 * ((fn.slots + 3) and -4) + 8 * i64(o)
    lower_frame()
    for r in SYSV_CALLEE_SAVED:
        if (fn.used_regs and reg_bit(r)) != 0:
            out("\tpushq %" + reg_name(r, Width64) + "\n")
            amd64.pushed += 1
            if comp.debug:
                out("\t.cfi_offset %" + reg_name(r, Width64) + ", -")
                asm.text += 16 + amd64.frame + 8 * amd64.pushed
                out("\n")
    emit_blocks(sysv_saved)

# the registers that Windows has the callee keep are saved right below rbp, so the unwinder finds them from rbp wherever
# rsp is; xmm15 is the scratch of emit_instr
func win_saved(restore: bool):
    o := 0
    for r in WIN_CALLEE_SAVED:
        if (fn.used_regs and reg_bit(r)) == 0:
            continue
        n := reg_name(r, Width64)
        mov: &strview = "movaps" if r >= XMM0 else "movq"
        if restore:
            out("\t" + mov + " ")
            asm.text += o - amd64.saved
            out("(%rbp), %" + n + "\n")
        else:
            out("\t" + mov + " %" + n + ", ")
            asm.text += o
            out("(%rsp)\n\t.seh_save" + ("xmm" if r >= XMM0 else "reg") + " %" + n + ", ")
            asm.text += o
            out("\n")
            if comp.debug:
                out("\t.cfi_offset %" + n + ", -")
                asm.text += 16 + amd64.saved - o
                out("\n")
        o += 16 if r >= XMM0 else 8

func win_emit_function():
    emit_function_symbol(16)
    # the unwind information of Windows, that its debuggers read to find the end of the prologue and the caller
    out("\t.seh_proc " + fn.name + "\n\tendbr64\n")
    start_frame()
    b := fn.start
    while b != 0:
        for i in fn.blocks[b].ins:
            if i.op == Odiv and i.to == i.arg[1] or i.op == Oswap and bank(i.cls) != 0 or is_vector(i.op) or i.cls == Vector or i.op == Ocopy and ref_kind(i.to) == RefSlot and (ref_kind(i.arg[0]) == RefSlot or ref_kind(i.arg[0]) == RefAddress):
                fn.used_regs = fn.used_regs or reg_bit(XMM15)
        b = fn.blocks[b].next
    amd64.saved = 0
    for r in WIN_CALLEE_SAVED:
        if (fn.used_regs and reg_bit(r)) != 0:
            amd64.saved += 16 if r >= XMM0 else 8
    amd64.saved = (amd64.saved + 15) and -16
    amd64.frame = 4 * ((fn.slots + 3) and -4)
    if amd64.saved != 0:
        out("\tsubq $")
        asm.text += amd64.saved
        out(", %rsp\n\t.seh_stackalloc ")
        asm.text += amd64.saved
        out("\n")
    out("\t.seh_setframe %rbp, ")
    asm.text += amd64.saved
    out("\n")
    win_saved(false)
    out("\t.seh_endprologue\n")
    lower_frame()
    emit_blocks(win_saved)
    out("\t.seh_endproc\n")
