# the condition of each comparison, and of its negation
CONDS: array[&strview, 36] = ["z", "nz", "nz", "z", "ge", "l", "g", "le", "le", "g", "l", "ge", "ae", "b", "a", "be", "be", "a", "b", "ae", "", "", "ae", "b", "a", "be", "?", "?", "?", "?", "", "", "np", "p", "p", "np"]

RNAMES: array[&strview, 68] = ["", "", "", "", "rax", "eax", "ax", "al", "rcx", "ecx", "cx", "cl", "rdx", "edx", "dx", "dl", "rsi", "esi", "si", "sil", "rdi", "edi", "di", "dil", "r8", "r8d", "r8w", "r8b", "r9", "r9d", "r9w", "r9b", "r10", "r10d", "r10w", "r10b", "r11", "r11d", "r11w", "r11b", "rbx", "ebx", "bx", "bl", "r12", "r12d", "r12w", "r12b", "r13", "r13d", "r13w", "r13b", "r14", "r14d", "r14w", "r14b", "r15", "r15d", "r15w", "r15b", "rbp", "ebp", "bp", "bpl", "rsp", "esp", "sp", "spl"]
XMMS: array[&strview, 16] = ["xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15"]

func regtoa(reg: i64, sz: i64) -> &strview:
    if reg >= XMM0:
        return XMMS[reg - XMM0]
    return RNAMES[4 * reg + sz]

func slotoff(r: Ref) -> i64:
    s := rsval(r)
    assert s <= fn.slot, "a slot of " + fn.name + " lies past its frame"
    if s < 0:
        return 4 * (0 - s)
    return -4 * (fn.slot - s) - amd64.save

func emitcon(c: Con):
    if c.type == CAddr:
        l := asm.syms[c.sym]
        p := asm.machine.assym
        if l[0] == '"':
            p = ""
        if c.symtype == SThr:
            assert not asm.machine.apple and not asm.machine.windows, "thread data of " + fn.name + " is read through fs"
            out("%fs:")
            out(p)
            out(l)
            out("@tpoff")
        else:
            assert (c.symtype and SThr) == 0, "thread data of " + fn.name + " is read as a plain symbol"
            out(p)
            out(l)
        if c.bits != 0:
            if c.bits > 0:
                out("+")
            asm.text += c.bits
    else:
        asm.text += c.bits

func getarg(c: u8, i: *Instr) -> Ref:
    switch c:
    case '0':
        return i.arg[0]
    case '1':
        return i.arg[1]
    return i.to

func emitcopy(r1: Ref, r2: Ref, k: i64):
    emitins(Instr{op = Ocopy, cls = i32(k), to = r1, arg = [r2, R]})

func emitmem(r: Ref):
    m := ptr(fn.mem[rval(r)])
    if rtype(m.base) == RSlot:
        _ = addcon(ptr(m.offset), Con{type = CBits, bits = slotoff(m.base)}, 1)
        m.base = RBP
    if m.offset.type != CUndef:
        emitcon(m.offset)
    out("(")
    if m.base != R:
        out("%")
        out(regtoa(i64(m.base), SLong))
    elif m.offset.type == CAddr:
        out("%rip")
    if m.index != R:
        out(", %")
        out(regtoa(i64(m.index), SLong))
        out(", ")
        asm.text += m.scale
    out(")")

func emitf(fmt: &strview, i: *Instr):
    s := items(fmt)
    k := 0
    if s[0] == '+' or s[0] == '-':
        if s[0] == '+' and i.arg[1] == i.to:
            r := i.arg[0]
            i.arg[0] = i.arg[1]
            i.arg[1] = r
        assert i.arg[1] != i.to or i.arg[0] == i.to, "an instruction of " + fn.name + " has no 2-address form"
        emitcopy(i.to, i.arg[0], i64(i.cls))
        k = 1
    out("\t")
    while k < s.len:
        c := s[k]
        k += 1
        if c != '%':
            add_byte(asm.text, c)
            continue
        c = s[k]
        k += 1
        sz := SLong
        switch c:
        case '%':
            out("%")
            continue
        case 'k':
            out(["l", "q", "ss", "sd"][i.cls])
            continue
        case '0', '1', '=':
            sz = SLong if kwide(i.cls) != 0 else SWord
            k -= 1
        case 'D', 'S', 'L':
            sz = SLong
        case 'W':
            sz = SWord
        case 'H':
            sz = SShort
        case 'B':
            sz = SByte
        case 'M':
            r := getarg(s[k], i)
            k += 1
            switch rtype(r):
            case RMem:
                emitmem(r)
            case RSlot:
                asm.text += slotoff(r)
                out("(%rbp)")
            case RCon:
                cn := fn.con[rval(r)]
                emitcon(cn)
                if cn.type == CAddr and cn.symtype != SThr:
                    out("(%rip)")
            case RTmp:
                assert isreg(r), "a temp of " + fn.name + " has no register"
                out("(%")
                out(regtoa(i64(r), SLong))
                out(")")
            continue
        r := getarg(s[k], i)
        k += 1
        switch rtype(r):
        case RTmp:
            assert isreg(r), "a temp of " + fn.name + " has no register"
            out("%")
            out(regtoa(i64(r), sz))
        case RSlot:
            asm.text += slotoff(r)
            out("(%rbp)")
        case RMem:
            emitmem(r)
        case RInt:
            out("$")
            asm.text += rsval(r)
        case RCon:
            cn := fn.con[rval(r)]
            if cn.type == CBits:
                switch sz:
                case SWord:
                    cn.bits = cn.bits << 32 >> 32
                case SShort:
                    cn.bits = cn.bits << 48 >> 48
                case SByte:
                    cn.bits = cn.bits << 56 >> 56
            out("$")
            emitcon(cn)
    out("\n")

# the vector instructions from Ovaddb on, and their lanes: c is commutative, n is not, r is not with its arguments
# the other way around, u has one argument, s shifts, b and f splat an int and a float
VFORMS: &strview = "ccccccnnnnnnccccnncccssssssssccccccnnnnnnnnrrrruubbbbffu"
VNAMES: array[&strview, 56] = [
    "paddb", "paddw", "paddd", "paddq", "addps", "addpd",
    "psubb", "psubw", "psubd", "psubq", "subps", "subpd",
    "pmullw", "pmulld", "mulps", "mulpd",
    "divps", "divpd",
    "andps", "orps", "xorps",
    "psllw", "pslld", "psllq", "psrlw", "psrld", "psrlq", "psraw", "psrad",
    "pcmpeqb", "pcmpeqw", "pcmpeqd", "pcmpeqq", "cmpeqps", "cmpeqpd",
    "pcmpgtb", "pcmpgtw", "pcmpgtd", "pcmpgtq", "cmpltps", "cmpltpd", "cmpleps", "cmplepd",
    "minps", "minpd", "maxps", "maxpd",
    "sqrtps", "sqrtpd",
    "movd %W0, %=\n\tpunpcklbw %=, %=\n\tpshuflw $0, %=, %=\n\tpshufd $0, %=, %=",
    "movd %W0, %=\n\tpshuflw $0, %=, %=\n\tpshufd $0, %=, %=",
    "movd %W0, %=\n\tpshufd $0, %=, %=",
    "movq %L0, %=\n\tpunpcklqdq %=, %=",
    "movaps %0, %=\n\tshufps $0, %=, %=",
    "movaps %0, %=\n\tunpcklpd %=, %=",
    "cvtdq2ps",
]

# most instructions are just pulled out of the table OMAP, some special cases are detailed in emitins
func emittable(i: Instr):
    emitf(format(OMAP[:], i), ptr(i))

func emitins(i: Instr):
    m := ptr(asm.machine)
    switch i.op:
    case Onop:
        pass # inserted by some passes
    case Omul:
        # the 3-address form when it can
        if rtype(i.arg[1]) == RCon:
            r := i.arg[0]
            i.arg[0] = i.arg[1]
            i.arg[1] = r
        if kbase(i.cls) == 0 and rtype(i.arg[0]) == RCon and rtype(i.arg[1]) == RTmp: # only available for ints
            emitf("imul%k %0, %1, %=", ptr(i))
        else:
            emittable(i)
    case Osub:
        # a subtraction into its second argument negates it and adds
        if i.to == i.arg[1] and i.arg[0] != i.to:
            emitins(Instr{op = Oneg, cls = i.cls, to = i.to, arg = [i.to, R]})
            emitf("add%k %0, %=", ptr(i))
        else:
            emittable(i)
    case Oswtof, Osltof, Oexts, Otruncd:
        # these keep the old upper bits too
        if i.to != i.arg[0]:
            emitf("xorps %=, %=", ptr(i))
        emittable(i)
    case Oneg:
        emitcopy(i.to, i.arg[0], i64(i.cls))
        if kbase(i.cls) == 0:
            emitf("neg%k %=", ptr(i))
        else:
            n := stashbits(u64(0x8000_0000) if i.cls == Ks else 0x8000_0000_0000_0000, 16)
            out("\txorp" + "xxsd"[i.cls:i.cls + 1] + " " + m.asloc + "fp" + n + "(%rip), %" + regtoa(i64(i.to), SLong) + "\n")
    case Odiv:
        # xmm15 holds a divisor that is also the result, which emitf cannot make 2-address
        if i.to == i.arg[1]:
            i.arg[1] = XMM15
            emitcopy(i.arg[1], i.to, i64(i.cls))
            emitcopy(i.to, i.arg[0], i64(i.cls))
            i.arg[0] = i.to
        emittable(i)
    case Ocopy:
        # big constants as in https://c9x.me/notes/2015-09-19.html
        if i.to == R or i.arg[0] == R or i.to == i.arg[0]:
            return
        t0 := rtype(i.arg[0])
        # movss between registers keeps the old upper bits, so it waits for them
        if kbase(i.cls) != 0 and isreg(i.to) and isreg(i.arg[0]):
            emitf("movaps %0, %=", ptr(i))
            return
        if i.cls == Kv:
            if isreg(i.to):
                emitf("movups %M0, %=", ptr(i))
            elif isreg(i.arg[0]):
                emitf("movups %0, %M=", ptr(i))
            else:
                emitf("movups %M0, %%xmm15", ptr(i))
                emitf("movups %%xmm15, %M=", ptr(i))
            return
        if i.cls == Kl and t0 == RCon and fn.con[rval(i.arg[0])].type == CBits:
            val := fn.con[rval(i.arg[0])].bits
            if isreg(i.to) and val >= 0 and val <= 0xffff_ffff:
                emitf("movl %W0, %W=", ptr(i))
                return
            if rtype(i.to) == RSlot and (val < -2147483648 or val > 2147483647):
                emitf("movl %0&0xffffffff, %=", ptr(i))
                emitf("movl %0>>32, 4+%=", ptr(i))
                return
        if isreg(i.to) and t0 == RCon and fn.con[rval(i.arg[0])].type == CAddr:
            emitf("lea%k %M0, %=", ptr(i))
            return
        if rtype(i.to) == RSlot and (t0 == RSlot or t0 == RMem):
            i.cls = Kd if kwide(i.cls) != 0 else Ks
            i.arg[1] = XMM15
            emitf("mov%k %0, %1", ptr(i))
            emitf("mov%k %1, %=", ptr(i))
            return
        # the assembler makes a movq a movabsq when it must
        emitf("mov%k %0, %=", ptr(i))
    case Oaddr:
        if rtype(i.arg[0]) != RCon:
            emittable(i)
            return
        c := fn.con[rval(i.arg[0])]
        sym := asm.syms[c.sym]
        p := m.assym
        if sym[0] == '"':
            p = ""
        to := regtoa(i64(i.to), SLong)
        if m.apple and (c.symtype and SThr) != 0:
            out("\tmovq " + p + sym + "@tlvp(%rip), %" + to + "\n")
            return
        if m.windows and c.symtype == SThr:
            # the block of this thread is entry _tls_index of the table at gs:88, one more register is borrowed on the
            # stack and the flags are kept; the offset is a difference of rip addresses, GNU ld relocates SECREL in code
            # when the image moves
            br := regtoa(RCX if i64(i.to) == RAX else RAX, SLong)
            out("\tpushq %" + br + "\n\tmovl _tls_index(%rip), %" + regtoa(RCX if i64(i.to) == RAX else RAX, SWord) + "\n")
            out("\tmovq %gs:88, %" + to + "\n\tmovq (%" + to + ",%" + br + ",8), %" + to + "\n")
            out("\tleaq " + p + sym + "(%rip), %" + br + "\n\tleaq (%" + to + ",%" + br + "), %" + to + "\n")
            out("\tleaq _tls_start(%rip), %" + br + "\n\tnotq %" + br + "\n\tleaq 1(%" + to + ",%" + br + "), %" + to + "\n")
            out("\tpopq %" + br + "\n")
            if c.bits != 0:
                out("\tleaq ")
                asm.text += c.bits
                out("(%" + to + "), %" + to + "\n")
            return
        if m.windows and c.symtype != SGlo:
            panic("extern unsupported on amd64_win")
        switch c.symtype:
        case SThr:
            # derive the symbol address from the TCB address at offset 0 of %fs
            emitf("movq %%fs:0, %L=", ptr(i))
            out("\tleaq " + p + sym + "@tpoff")
            if c.bits > 0:
                out("+")
            if c.bits != 0:
                asm.text += c.bits
            out("(%" + to + "), %" + to + "\n")
        case SExtThr:
            assert c.bits == 0, "an address of " + fn.name + " read from the GOT loses its offset"
            # initial-exec TLS: load offset from GOT, add to thread-base register
            emitf("movq %%fs:0, %L=", ptr(i))
            out("\taddq " + p + sym + "@gottpoff(%rip), %" + to + "\n")
        case SExt:
            assert c.bits == 0, "an address of " + fn.name + " read from the GOT loses its offset"
            # load address from the GOT
            out("\tmovq " + p + sym + "@gotpcrel(%rip), %" + to + "\n")
        case:
            emittable(i)
    case Ocall:
        if rtype(i.arg[0]) == RCon:
            c := fn.con[rval(i.arg[0])]
            out("\tcallq ")
            emitcon(c)
            if c.type == CAddr and (c.symtype and SExt) != 0 and not m.apple:
                out("@plt")
            out("\n")
        else:
            emitf("callq *%L0", ptr(i))
    case Osalloc:
        emitf("subq %L0, %%rsp", ptr(i))
        if i.to != R:
            emitcopy(i.to, RSP, Kl)
    case Oswap:
        if kbase(i.cls) == 0:
            emittable(i)
            return
        # floats swap through xmm15
        emitcopy(XMM15, i.arg[0], i64(i.cls))
        emitcopy(i.arg[0], i.arg[1], i64(i.cls))
        emitcopy(i.arg[1], XMM15, i64(i.cls))
    case Odbgloc:
        emitdbgloc(rval(i.arg[0]), rval(i.arg[1]))
    case Odbgslot:
        emitdbgslot(i.arg[1], slotoff(i.arg[0]))
    case Odbgmark:
        emitdbgmark(i.arg[0])
    case Oframe:
        emitcopy(i.to, RBP, Kl)
    case Ovget:
        if i.cls == Kd: # pshufd takes the words 2n and 2n + 1
            i.arg[1] = ref(RInt, 10 * rsval(i.arg[1]) + 4)
        emittable(i)
    case Ovlane:
        asm.lane = rsval(i.arg[0])
    case Ovsetb, Ovseth, Ovsetw, Ovsetl, Ovsets, Ovsetd:
        # xmm15 holds a float to put that is also the result
        if i.to == i.arg[1] and i.to != i.arg[0]:
            emitcopy(XMM15, i.arg[1], Kv)
            i.arg[1] = XMM15
        emitcopy(i.to, i.arg[0], Kv)
        i.arg[0] = ref(RInt, asm.lane << 4 if i.op == Ovsets else asm.lane)
        if i.op != Ovsetd:
            emittable(i)
        elif asm.lane != 0:
            emitf("unpcklpd %1, %=", ptr(i))
        else:
            emitf("movsd %1, %=", ptr(i))
    case:
        if isxsel(i.op):
            c := i64(i.op) - Oxsel
            if i.to == i.arg[1]:
                emitf("cmov" + CONDS[2 * c] + " %0, %=", ptr(i))
            else:
                if i.to != i.arg[0]:
                    emitf("mov %0, %=", ptr(i))
                emitf("cmov" + CONDS[2 * c + 1] + " %1, %=", ptr(i))
        elif isvec(i.op): # xmm15 is the scratch, it holds an argument that is also the result, or a shift amount
            form := VFORMS[i.op - Ovaddb]
            n := VNAMES[i.op - Ovaddb]
            switch form:
            case 'b':
                emitf(n, ptr(i))
                return
            case 'f':
                if i.to == i.arg[0]:
                    emitf(n[(trust find(n, "\n")) + 2:], ptr(i))
                else:
                    emitf(n, ptr(i))
                return
            case 'u':
                out("\t" + n + " %" + regtoa(i64(i.arg[0]), SLong) + ", %" + regtoa(i64(i.to), SLong) + "\n")
                return
            case 'r':
                r := i.arg[0]
                i.arg[0] = i.arg[1]
                i.arg[1] = r
            case 's':
                if rtype(i.arg[1]) == RTmp:
                    out("\tmovd %" + regtoa(i64(i.arg[1]), SWord) + ", %xmm15\n")
                    i.arg[1] = XMM15
            if i.to == i.arg[1] and i.to != i.arg[0]:
                if form == 'c':
                    r := i.arg[0]
                    i.arg[0] = i.arg[1]
                    i.arg[1] = r
                else:
                    emitcopy(XMM15, i.arg[1], Kv)
                    i.arg[1] = XMM15
            emitcopy(i.to, i.arg[0], Kv)
            out("\t" + n + " ")
            if rtype(i.arg[1]) == RCon:
                out("$")
                asm.text += fn.con[rval(i.arg[1])].bits
            else:
                out("%" + regtoa(i64(i.arg[1]), SLong))
            out(", %" + regtoa(i64(i.to), SLong) + "\n")
        else:
            emittable(i)

# every function keeps a frame pointer, so the runtime can walk the calls when the program fails
func framestart():
    out("\tpushq %rbp\n")
    if asm.machine.windows:
        out("\t.seh_pushreg %rbp\n")
    if comp.debug:
        out("\t.cfi_def_cfa_offset 16\n\t.cfi_offset %rbp, -16\n")
    out("\tmovq %rsp, %rbp\n")
    if comp.debug:
        out("\t.cfi_def_cfa_register %rbp\n")

# lower rsp by the frame, a page at a time when probing
func lower_frame():
    n := amd64.fsz
    if not probing(n):
        if n != 0:
            out("\tsubq $")
            asm.text += n
            out(", %rsp\n")
        return
    if n >= 4096:
        out("\tmovl $")
        asm.text += n / 4096
        out(", %r11d\n1:\n\tsubq $4096, %rsp\n\torq $0, (%rsp)\n\tsubl $1, %r11d\n\tjnz 1b\n")
    if n % 4096 != 0:
        out("\tsubq $")
        asm.text += n % 4096
        out(", %rsp\n\torq $0, (%rsp)\n")

# the blocks and their jumps; windows jumps with the flags of floats the other way around
func emitblocks(keep: func(bool)):
    lbl := false
    b := fn.start
    while b != 0:
        p := ptr(fn.blks[b])
        if lbl or p.pred.len > 1:
            if not asm.machine.windows:
                back := false
                for q in p.pred:
                    back = back or fn.blks[q].id >= p.id
                if back:
                    out(".p2align 4\n")
            out(asm.machine.asloc + "bb")
            asm.text += asm.blocks + p.id
            out(":\n")
        for k in 0..fn.blks[b].ins.len:
            emitins(fn.blks[b].ins[k])
        p = ptr(fn.blks[b])
        lbl = true
        j := i64(p.jmp.type)
        if j == Jhlt:
            out("\tud2\n")
        elif j == Jjt:
            jump := Instr{arg = [p.jmp.arg, R]}
            emitf("jmp *%L0", ptr(jump))
        elif j == Jret0:
            keep(true)
            if comp.debug:
                out("\t.cfi_remember_state\n")
            out("\tleave\n")
            if comp.debug:
                out("\t.cfi_def_cfa %rsp, 8\n")
            out("\tret\n")
            if comp.debug:
                out("\t.cfi_restore_state\n")
        else:
            if j != Jjmp:
                c := j - Jjf
                if c < 0 or c > NCmp:
                    panic("unhandled jump " + j)
                n := 1
                if p.link == p.s2 or asm.machine.windows and c >= NCmpI:
                    s := p.s1
                    p.s1 = p.s2
                    p.s2 = s
                    n = 0
                out("\tj" + CONDS[2 * c + n] + " " + asm.machine.asloc + "bb")
                asm.text += asm.blocks + fn.blks[p.s2].id
                out("\n")
            if p.s1 != p.link:
                out("\tjmp " + asm.machine.asloc + "bb")
                asm.text += asm.blocks + fn.blks[p.s1].id
                out("\n")
            else:
                lbl = false
        b = p.link
    emitfnend(asm.machine.asloc + "bb")

func sysv_keep(restore: bool):
    if not restore:
        return
    if fn.dynalloc:
        out("\tmovq %rbp, %rsp\n\tsubq $")
        asm.text += amd64.fsz + amd64.nclob * 8
        out(", %rsp\n")
    for r in reverse SYSV_RCLOB:
        if (fn.reg and regbit(r)) != 0:
            out("\tpopq %" + regtoa(r, SLong) + "\n")

func sysv_emitfn():
    emitfnlnk(16)
    out("\tendbr64\n")
    framestart()
    o: u64 = 0
    if not fn.leaf:
        for r in SYSV_RCLOB:
            o = o xor fn.reg >> r
        o = o and 1
    amd64.save = 0
    amd64.nclob = 0
    amd64.fsz = 4 * ((fn.slot + 3) and -4) + 8 * i64(o)
    lower_frame()
    for r in SYSV_RCLOB:
        if (fn.reg and regbit(r)) != 0:
            out("\tpushq %" + regtoa(r, SLong) + "\n")
            amd64.nclob += 1
            if comp.debug:
                out("\t.cfi_offset %" + regtoa(r, SLong) + ", -")
                asm.text += 16 + amd64.fsz + 8 * amd64.nclob
                out("\n")
    emitblocks(sysv_keep)

# the registers that Windows has the callee keep are saved right below rbp, so the unwinder finds them from rbp wherever
# rsp is; xmm15 is the scratch of emitins()
func win_keep(restore: bool):
    o := 0
    for r in WIN_RCLOB:
        if (fn.reg and regbit(r)) == 0:
            continue
        n := regtoa(r, SLong)
        mov: &strview = "movaps" if r >= XMM0 else "movq"
        if restore:
            out("\t" + mov + " ")
            asm.text += o - amd64.save
            out("(%rbp), %" + n + "\n")
        else:
            out("\t" + mov + " %" + n + ", ")
            asm.text += o
            out("(%rsp)\n\t.seh_save" + ("xmm" if r >= XMM0 else "reg") + " %" + n + ", ")
            asm.text += o
            out("\n")
            if comp.debug:
                out("\t.cfi_offset %" + n + ", -")
                asm.text += 16 + amd64.save - o
                out("\n")
        o += 16 if r >= XMM0 else 8

func win_emitfn():
    emitfnlnk(16)
    # the unwind information of Windows, that its debuggers read to find the end of the prologue and the caller
    out("\t.seh_proc " + fn.name + "\n\tendbr64\n")
    framestart()
    b := fn.start
    while b != 0:
        for i in fn.blks[b].ins:
            if i.op == Odiv and i.to == i.arg[1] or i.op == Oswap and kbase(i.cls) != 0 or isvec(i.op) or i.cls == Kv or i.op == Ocopy and rtype(i.to) == RSlot and (rtype(i.arg[0]) == RSlot or rtype(i.arg[0]) == RMem):
                fn.reg = fn.reg or regbit(XMM15)
        b = fn.blks[b].link
    amd64.save = 0
    for r in WIN_RCLOB:
        if (fn.reg and regbit(r)) != 0:
            amd64.save += 16 if r >= XMM0 else 8
    amd64.save = (amd64.save + 15) and -16
    amd64.fsz = 4 * ((fn.slot + 3) and -4)
    if amd64.save != 0:
        out("\tsubq $")
        asm.text += amd64.save
        out(", %rsp\n\t.seh_stackalloc ")
        asm.text += amd64.save
        out("\n")
    out("\t.seh_setframe %rbp, ")
    asm.text += amd64.save
    out("\n")
    win_keep(false)
    out("\t.seh_endprologue\n")
    lower_frame()
    emitblocks(win_keep)
    out("\t.seh_endproc\n")
