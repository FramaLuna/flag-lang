    Form{Oflagfle, Ki, "set? %B=\n\tmovzb%k %B=, %="},
    Form{Oflagflt, Ki, "set? %B=\n\tmovzb%k %B=, %="},
    Form{Oflagfgt, Ki, "seta %B=\n\tmovzb%k %B=, %="},
    Form{Oflagfge, Ki, "setae %B=\n\tmovzb%k %B=, %="},
