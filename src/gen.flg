@trust
use fs

UNKNOWN = "a constant with a type holds a value the compiler knows, made of literals and constants, and this one is computed when the program runs: without the type it is computed where it is read"
KNOWN = "a default value is one the compiler knows, made of literals and constants, or the empty heap([]), heap(\"\") or heap({})"
ENTRY = "main is where the program starts, the main of C, so nothing in the program can call it or take it as a value"
VIEW = "&strview is a view that only reads: change the text through the &str that owns it"
STACK = "cannot return a pointer to the stack as it will be cleared at return"
ATOMIC = " is not a value, it starts at 0 and changes with set, add, swap or compare_swap"

func gen_program(check: bool, testing: bool) -> Fail?:
    comp.entry = NONE # a type checks its defaults when it is made, and they can call functions before main is found
    comp.settler = NONE
    for k in 1..comp.syms.len:
        if comp.nodes[comp.syms[k].node].kind == Void:
            try make_type(k, [], false, comp.tokens[comp.nodes[comp.syms[k].node].tok].at)
    for e in 0..comp.nodes.len:
        if comp.nodes[e].kind == Extern:
            lib := text(e)[1:text(e).len - 1]
            at := comp.tokens[comp.nodes[e].tok].at
            if starts_with(lib, ":"):
                return fail("extern names the file without ':': extern \"" + lib[1:] + "\"", at)
            if ends_with(lib, ".framework") and comp.system != "macos":
                return fail(lib + " is a framework of macOS, give its block a where @macos()", at)
            if lib != "c" and not contains(comp.libs, lib):
                append(comp.libs, lib)
    for k in 1..comp.syms.len:
        d := comp.syms[k].node
        kind := comp.nodes[d].kind
        if (kind == Struct or kind == Fat or kind == Context or kind == Alias) and not generic(d):
            t := try make_type(k, [], kind == Fat, comp.tokens[comp.nodes[d].tok].at)
            ty := comp.types[t]
            if kind == Context: # nothing runs when a thread starts, so a field that starts without a value never gets one
                for f in comp.items[ty.first:ty.first + ty.count]:
                    if bare(t, f) and emptied(f.type).len > 0:
                        return fail(text(d) + "." + f.name + " starts without a value, and a context gets only the defaults of its fields: " + f.name + ": " + comp.types[f.type].name + " = " + emptied(f.type), at_of(field_node(t, f.name)))
                    if bare(t, f):
                        return fail(text(d) + "." + f.name + " starts without a value, and a context gets only the defaults of its fields", at_of(field_node(t, f.name)))
                    inside := unfed(f.type)
                    if f.default == 0 and inside.name.len > 0:
                        given: &str = heap("")
                        if not contains(inside.name, "."):
                            given += ": " + f.name + ": " + comp.types[f.type].name + " = {" + inside.name + " = " + emptied(inside.type) + "}"
                        return fail(text(d) + "." + f.name + "." + inside.name + " starts without memory, and a context gets only the defaults of its fields" + given, at_of(field_node(t, f.name)))
            if kind == Context and declared(d) == "shared": # one for all the threads, in the data with what it starts with
                held: &str = heap("")
                body := comp.body.len
                slots := comp.slots.len
                try image(t, 0, held)
                drop(body, slots, 0)
                zeros(held, room(t) - comp.types[t].size)
                comp.data += "data $ctx." + comp.types[t].name + " = align " + data_align(t) + " { " + held + "}\n"
            elif kind == Context:
                comp.data += "thread data $ctx." + comp.types[t].name + " = align " + data_align(t) + " { z " + room(t) + " }\n"
                comp.stamping = comp.stamping or comp.types[t].stamped
    s := first_sym("main")
    while s != 0 and (comp.nodes[comp.syms[s].node].kind != Func or params(comp.syms[s].node) != 0 or comp.syms[s].module.len > 0 or comp.shared):
        s = comp.syms[s].next
    if testing:
        s = first_sym("run_test")
        while not comp.syms[s].library:
            s = comp.syms[s].next
    if s == 0 and not check and not comp.shared:
        eprint(comp.err, "this program has no func main() to start from")
        return Fail
    if s != 0:
        comp.entry = try instantiate(comp.syms[s].node, 0)
        comp.insts[comp.entry].name = "$main"
        comp.insts[comp.entry].export = true
        for n in comp.nodes:
            if n.kind == Unary and comp.tokens[n.tok].text == "parallel":
                comp.settler = comp.entry
    if s != 0 and comp.insts[comp.entry].ret != VOID and not integer(comp.insts[comp.entry].ret):
        return fail("main cannot return " + comp.types[comp.insts[comp.entry].ret].name + ", it returns nothing or an integer, the exit code", comp.tokens[comp.nodes[comp.syms[s].node].tok].at)
    for k in 1..comp.syms.len:
        test := comp.syms[k]
        f := test.node
        if testing and starts_with(test.name, "test_") and comp.nodes[f].kind == Func and body(f) != 0 and not test.library and params(f) == 0 and not generic(f) and try result(f) == VOID and try holds_where(f):
            comp.insts[try instantiate(f, 0)].taken_as = func_of([], VOID, false) # the run of a Test
            append(comp.tests, k)
    if testing and comp.tests.len == 0 and not check:
        eprint(comp.err, "these files have no test, a test is a func test_name() with no parameters and no result")
        return Fail
    for k in 1..comp.syms.len:
        if comp.syms[k].export:
            f := comp.syms[k].node
            at := comp.tokens[comp.nodes[f].tok].at
            others := first_sym(comp.syms[k].name) # a function of the library gives way, but not its symbol of C
            while others != 0 and (others == k or comp.nodes[comp.syms[others].node].kind != Func or comp.syms[others].library):
                others = comp.syms[others].next
            if comp.syms[k].name == "main":
                return fail("main is the entry point of the program, it cannot be exported", at)
            if generic(f):
                return fail("an export function cannot be generic, other languages need one fixed signature", at)
            for held in comp.syms:
                if held.library and held.node != f and comp.nodes[held.node].kind == Func and (body(held.node) == 0 or held.export) and linked(held.node) == comp.syms[k].name:
                    return fail(comp.syms[k].name + " is a symbol of C that the library uses already, an export function needs a name of its own", at)
            if others != 0 and not comp.syms[k].library: # one of yours with the name of an export of core gives way
                return fail("an export function cannot be overloaded, its name is the symbol other languages call", at)
            if try holds_where(f):
                try instantiate(f, 0)
    for k in 1..comp.syms.len:
        d := comp.syms[k].node
        if comp.nodes[d].kind == Var and comp.types[try resolve(d + 1)].kind != Ptr:
            return fail(text(d) + " is a variable of C, and an extern block declares it by its address: " + text(d) + ": *" + code_of(d + 1), at_of(d))
        if comp.nodes[d].kind == Constant and kids(d) == 2: # checked like a local declaration, also when nothing reads it, and the code is dropped
            t := try resolve(d + 1)
            given := kid(d, 1)
            held: &str = heap("")
            body := comp.body.len
            slots := comp.slots.len
            try assign(alloc(t), t, try value(given, t), at_of(given))
            unknown := try image(t, given, held)
            if unknown != 0:
                return fail(UNKNOWN, at_of(unknown))
            drop(body, slots, 0)
    comp.data += "data $flag.argc = { w 0 }\ndata $flag.argv = { l 0 }\n"
    if comp.stamping:
        comp.data += "thread data $flag.entered = { w 0 }\n"
    comp.at = 0
    comp.live = true
    stamper := open_proc("$flag.stamp", 0, 0, true) # what the contexts of a thread start with, when it enters
    for k in 1..comp.syms.len:
        d := comp.syms[k].node
        if comp.nodes[d].kind == Context and declared(d) != "shared":
            t := trust make_type(k, [], false, 0)
            try stamp(t, global("thread $ctx." + comp.types[t].name), 0)
    if comp.stamping:
        add(Ins{op = "storew", a = int_arg(1), b = global("thread $flag.entered")})
    terminate("ret", Arg{})
    close_proc(stamper, 0, 0)
    for held in comp.syms: # before a call that uses a default value reads it
        f := held.node
        for p in 0..params(f):
            c := kid(f, p)
            if comp.nodes[f].kind == Func and kids(c) == 2:
                given := node_end(c + 1)
                for i in given..node_end(given):
                    for j in p..params(f):
                        if comp.nodes[i].kind == Name and comp.nodes[i].module.len == 0 and text(i) == text(kid(f, j)): # a later parameter, also with the name of a function
                            return fail("the default of " + text(c) + " cannot read " + text(i) + ", a default value reads only the parameters before it", at_of(i))
    done := try gen_from(0)
    reached := comp.types.len
    funcs := comp.procs.len
    code := comp.code.len
    passes := comp.passes.len
    mentions := comp.mentions.len
    scopes := comp.scopes.len
    data := comp.data.len
    assembly := comp.assembly.len
    for k in 1..comp.syms.len:
        f := comp.syms[k].node
        checked := comp.nodes[f].kind == Func and not generic(f) and try holds_where(f) # a function for another system is checked when you build for it
        if checked and body(f) != 0:
            try instantiate(f, 0)
        elif checked:
            c := f + 1
            while c < node_end(f) and comp.nodes[c].kind != Literal and comp.nodes[c].kind != Where:
                if comp.nodes[c].kind != Var:
                    try passing(try result_type(c), true, comp.tokens[comp.nodes[c].tok].at)
                elif text(c) != "..":
                    try passing(try resolve(c + 1), true, comp.tokens[comp.nodes[c].tok].at)
                c = node_end(c)
        last := 0
        if checked:
            for p in 0..params(f):
                if kids(kid(f, p)) == 2:
                    last = p + 1
        if last > 0: # each default value is checked here, with the parameters before it as variables, and the code is dropped
            body := comp.body.len
            slots := comp.slots.len
            aside := set_aside(0)
            for p in 0..last:
                c := kid(f, p)
                t := try resolve(c + 1)
                if kids(c) == 2:
                    given := node_end(c + 1)
                    try hand(try gen(given, t), t, false, at_of(given))
                append(comp.vars, Local{text(c), t, alloc(t), 0, comp.nodes[c].tok, 0, "", 0, true, false})
            put_back(0, aside)
            drop(body, slots, 0)
        name := text(f)
        if comp.nodes[f].kind == Func and params(f) > 0 and (name == "[]" or name == "for" or name == "reverse" or name == "wait"):
            saved := open_frame()
            for i in kid(f, 0)..kid(f, params(f)):
                t := comp.tokens[comp.nodes[i].tok]
                if t.kind == Generic and bound(t.text) == 0:
                    placeholder := Item{name = t.text, type = U8, n = 1}
                    if starts_with(t.text, "$$"):
                        placeholder.type = VOID
                    append(comp.binds, placeholder)
            first := try resolve(kid(f, 0) + 1)
            target := first
            if comp.types[first].kind == Ptr:
                target = comp.types[first].elem
            owned := sequence(first) or textual(first) or comp.types[target].kind == Array
            if name == "wait":
                owned = comp.types[target].kind == Thread and file_of(comp.tokens[comp.nodes[f].tok].at) != 0
            if name == "[]":
                owned = false
                if params(f) > 1 and (sequence(target) or textual(target) or comp.types[target].kind == Array):
                    second := try resolve(kid(f, 1) + 1)
                    for t in I8..=U64:
                        owned = owned or accepts(second, Value{type = t}) >= 0
            close_frame(saved)
            shown := comp.types[target].name
            shown = shown[:find(shown, "[") ifnull shown.len]
            if owned and name == "wait":
                return fail("wait of " + shown + " belongs to the language, it cannot be declared again", comp.tokens[comp.nodes[f].tok].at)
            if owned and name == "[]":
                return fail("x[i] with an integer on " + shown + " belongs to the language, operator [] cannot be declared for it", comp.tokens[comp.nodes[f].tok].at)
            if owned:
                return fail("for over " + shown + " belongs to the language, operator " + name + " cannot be declared for it", comp.tokens[comp.nodes[f].tok].at)
    try gen_from(done)
    ids: &map[&strview, i64] = heap({})
    for k in 0..comp.procs.len:
        put(ids, comp.procs[k].name, k)
    calls: &list[&list[i64]] = heap([])
    for p in comp.procs:
        callees: &list[i64] = heap([])
        for i in comp.code[p.code:p.end]:
            g := callee(i, ids)
            if g < comp.procs.len:
                append(callees, g)
        append(calls, callees)
    visits: &list[i64] = heap([])
    lows: &list[i64] = heap([])
    stacked: &list[bool] = heap([])
    for p in comp.procs:
        append(visits, 0)
        append(lows, 0)
        append(stacked, false)
    stack: &list[i64] = heap([])
    path: &list[i64] = heap([])
    edges: &list[i64] = heap([])
    order: &list[i64] = heap([])
    for root in 0..comp.procs.len:
        if visits[root] == 0:
            append(path, root)
            append(edges, 0)
        while path.len > 0:
            v := path[-1]
            if visits[v] == 0:
                visits[v] = order.len + stack.len + 1
                lows[v] = visits[v]
                append(stack, v)
                stacked[v] = true
            if edges[-1] < calls[v].len:
                w := calls[v][edges[-1]]
                edges[-1] += 1
                if visits[w] == 0:
                    append(path, w)
                    append(edges, 0)
                elif stacked[w] and visits[w] < lows[v]:
                    lows[v] = visits[w]
                continue
            path.len -= 1
            edges.len -= 1
            if path.len > 0 and lows[v] < lows[path[-1]]:
                lows[path[-1]] = lows[v]
            if lows[v] == visits[v]:
                first := order.len
                while stacked[v]:
                    w := trust pop(stack)
                    stacked[w] = false
                    append(order, w)
                cycle := order.len - first > 1 or contains(calls[v], v)
                for m in order[first:]:
                    comp.procs[m].recursive = cycle
                    f := comp.procs[m].node
                    if cycle and declared(f) == "inline":
                        shown := text(f)
                        if comp.tokens[comp.nodes[f].tok - 1].text == "operator":
                            shown = "operator " + shown
                        for c in order[first:]:
                            for i in comp.code[comp.procs[c].code:comp.procs[c].end]:
                                if i.op == "call" and i.a.kind == Global and comp.globals[i.a.n] == comp.procs[m].name:
                                    failed := fail(shown + " is inline and recursive, inlining it would never end: declare it without inline", comp.tokens[comp.nodes[f].tok].at)
                                    note("this call leads back to " + shown, i.pos)
                                    return failed
    procs: &list[Proc] = heap([])
    for k in order:
        if k < funcs:
            append(procs, comp.procs[k])
    comp.procs = procs
    comp.code.len = code
    comp.passes.len = passes
    comp.mentions.len = mentions
    comp.scopes.len = scopes
    comp.data.len = data
    comp.assembly.len = assembly
    clear(comp.stored)
    comp.reached = reached
    if check:
        return null
    if testing:
        table: &str = heap("")
        for n, k in comp.tests:
            comp.data += "data $flag.test." + n + " = { b \"" + test_name(k) + "\", b 0 }\n"
            table += ", l $flag.test." + n + ", l " + comp.insts[try instantiate(comp.syms[k].node, 0)].name
        comp.data += "data $flag.tests = { l " + comp.tests.len + table + " }\nfunction l $flag_tests() {\n@start\n\tret $flag.tests\n}\n"
    return null

func test_name(s: i64) -> &strview:
    if comp.syms[s].module.len == 0:
        return comp.syms[s].name
    return comp.syms[s].module + "." + comp.syms[s].name

func gen_from(from: i64) -> i64|Fail:
    pending: &list[i64] = heap([])
    defer free(pending)
    known := from
    while known < comp.insts.len or pending.len > 0:
        for k in reverse known..comp.insts.len:
            append(pending, k)
        known = comp.insts.len
        i := trust pop(pending)
        inst := comp.insts[i]
        f := inst.node
        if f != 0 and body(f) == 0:
            continue
        comp.blame = 0
        if inst.count > 0:
            comp.blame = inst.at
        comp.vars.len = 0
        comp.given.len = 0
        comp.defers.len = 0
        comp.loops.len = 0
        comp.scope = 0
        comp.live = true
        comp.inst = i
        saved := open_frame()
        for k in 0..inst.count:
            append(comp.binds, comp.inst_binds[inst.binds + k])
        comp.ret = inst.ret
        comp.at = inst.at
        if f != 0:
            comp.at = comp.tokens[comp.nodes[f].tok].at
        made := open_proc(inst.name, f, i, inst.export)
        if f == 0 and inst.ret == VOID:
            shape := comp.types[comp.binds[-1].type]
            block := temp()
            append(comp.passes, Pass{L, block, false, VOID})
            add(Ins{op = "call", a = global("$flag.stamp"), first = u32(comp.passes.len)})
            args: &list[Value] = heap([])
            try invoke("guard_stack", args, 0)
            start := HEAD + align_up(comp.types[shape.ret].size, 8)
            passes: &list[Pass] = heap([])
            used := start + 8
            for k in 0..shape.count:
                p := comp.items[shape.first + k].type
                if comp.types[p].kind == Fat or big(p):
                    append(passes, Pass{L, offset(block, used), false, VOID})
                elif aggregate(p):
                    append(passes, Pass{cls(p), offset(block, used), false, VOID})
                else:
                    x := load(Value{type = p, at = offset(block, used), mem = true}).at
                    append(passes, Pass{cls(p), x, is_number(x), VOID})
                used += room(p)
            for t in inherited():
                blit(offset(block, used), global("thread $ctx." + comp.types[t].name), t)
                used += room(t)
            store(shape.ret, try emit(op1(L, "loadl", offset(block, start)), passes, shape.ret, false, inst.at, comp.binds[-1].type), offset(block, HEAD))
            append(args, Value{type = pointer(BYTES), at = block})
            append(args, truth(holds_pointer(shape.ret)))
            try invoke("finished", args, 0)
            terminate("ret", int_arg(0))
            close_proc(made, L, 1)
            close_frame(saved)
            continue
        if f == 0:
            t := comp.binds[-1].type
            ty := comp.types[t]
            sides: &list[Value] = heap([])
            for k in 0..1 + i64(inst.ret == BOOL):
                p := temp()
                how := cls(t)
                if aggregate(t):
                    how = L
                append(comp.passes, Pass{how, p, false, VOID})
                append(sides, Value{type = t, at = p, mem = aggregate(t)})
            a := sides[0]
            if inst.ret == BOOL:
                b := sides[1]
                l_differ := label()
                if ty.kind == Union:
                    l_same := label()
                    branch(op(W, "ceqw", tag(a), tag(b)), l_same, l_differ)
                    open_block(l_same)
                    for m in members(t):
                        l_arm := label()
                        l_next := label()
                        branch(op(W, "ceqw", tag(a), tag_of(m)), l_arm, l_next)
                        open_block(l_arm)
                        if holds_lanes(m):
                            return fail(ty.name + " holds a simd, whose == answers each lane: test the member with is and compare its lanes", inst.at)
                        same := binary("==", Value{type = m, at = payload(a.at, m), mem = true}, Value{type = m, at = payload(b.at, m), mem = true}, inst.at)
                        if same is Fail:
                            note(ty.name + " has no == of its own, so == compares the member it holds, and this is " + comp.types[m].name, inst.at)
                            return Fail
                        terminate("ret", load(same).at)
                        open_block(l_next)
                    terminate("hlt", Arg{})
                else:
                    for k in 0..ty.count:
                        field := comp.items[ty.first + k]
                        if not field.shared:
                            if holds_lanes(field.type):
                                failed := fail(ty.name + " has a simd field, whose == answers each lane: declare == for " + ty.name, inst.at)
                                note("the simd field is " + field.name, field_at(t, field.name, inst.at))
                                return failed
                            same := binary("==", Value{type = field.type, at = offset(a.at, field.n), mem = true}, Value{type = field.type, at = offset(b.at, field.n), mem = true}, inst.at)
                            if same is Fail:
                                note(ty.name + " has no == of its own, so == compares its fields, and this is field " + field.name, field_at(t, field.name, inst.at))
                                return Fail
                            l_next := label()
                            branch(load(same).at, l_next, l_differ)
                            open_block(l_next)
                    terminate("ret", int_arg(1))
                open_block(l_differ)
                terminate("ret", int_arg(0))
            else:
                h := alloc(U64)
                add(Ins{op = "storel", a = int_arg(0), b = h, number = true})
                if ty.kind == Bool:
                    try mix(h, Value{type = U64, at = op1(L, "extuw", a.at)}, inst.at)
                elif ty.kind == Ptr or ty.kind == Func:
                    try mix(h, Value{type = U64, at = a.at}, inst.at)
                elif ty.kind == Struct:
                    for k in 0..ty.count:
                        field := comp.items[ty.first + k]
                        if not field.shared and mix(h, Value{type = field.type, at = offset(a.at, field.n), mem = true}, inst.at) is Fail:
                            note(ty.name + " has no hash of its own, so hash mixes the hashes of its fields, and this is field " + field.name, field_at(t, field.name, inst.at))
                            return Fail
                elif ty.kind == Union:
                    try mix(h, Value{type = U64, at = op1(L, "extuw", tag(a))}, inst.at)
                    l_done := label()
                    for m in members(t):
                        if comp.types[m].size > 0:
                            l_arm := label()
                            l_next := label()
                            branch(op(W, "ceqw", tag(a), tag_of(m)), l_arm, l_next)
                            open_block(l_arm)
                            if mix(h, Value{type = m, at = payload(a.at, m), mem = true}, inst.at) is Fail:
                                note(ty.name + " has no hash of its own, so hash mixes the tag and the member it holds, and this is " + comp.types[m].name, inst.at)
                                return Fail
                            jump(l_done)
                            open_block(l_next)
                    jump(l_done)
                    open_block(l_done)
                elif ty.kind == Array:
                    index := alloc(I64)
                    add(Ins{op = "storel", a = int_arg(0), b = index, number = true})
                    l_head := label()
                    l_body := label()
                    l_done := label()
                    jump(l_head)
                    open_block(l_head)
                    k := op1(L, "loadl", index)
                    branch(op(W, "cultl", k, int_arg(i64(ty.count))), l_body, l_done)
                    open_block(l_body)
                    try mix(h, Value{type = ty.elem, at = op(L, "add", a.at, times(k, comp.types[ty.elem].size)), mem = true}, inst.at)
                    add(Ins{op = "storel", a = op(L, "add", k, int_arg(1)), b = index, number = true})
                    jump(l_head)
                    open_block(l_done)
                terminate("ret", op1(L, "loadl", h))
            close_proc(made, cls(inst.ret), sides.len)
            close_frame(saved)
            continue
        for k in 0..params(f):
            c := kid(f, k)
            try untaken(comp.nodes[c].tok)
            t := try resolve(c + 1)
            if gathers(c): # ..items: T is a &listview[T]
                t = try fat_type("listview", t, comp.at)
            if comp.types[t].kind == Bytes:
                return fail("parameter " + text(c) + " needs a size, bytes is a run of unknown length: take a *bytes", comp.tokens[comp.nodes[c].tok].at)
            if comp.types[t].kind == Atomic:
                return fail("parameter " + text(c) + " cannot be " + comp.types[t].name + ", which is not a value: take *" + comp.types[t].name, comp.tokens[comp.nodes[c].tok].at)
            if comp.types[t].kind == Given: # it takes nothing at run time
                append(comp.vars, Local{text(c), t, Arg{}, 0, comp.nodes[c].tok, 0, "", 0, true, false})
                continue
            p := temp()
            comp.numbers[p.n - 1] = integer(t) and comp.types[t].size == 8
            how := cls(t)
            if inst.export:
                how = try passing(t, true, comp.at)
            elif comp.types[t].kind == Fat or big(t):
                how = L
            append(comp.passes, Pass{how, p, comp.numbers[p.n - 1], t if aggregate(t) and comp.types[t].kind != Fat else VOID})
            append(comp.vars, Local{text(c), t, p, 0, comp.nodes[c].tok, 0, "", 0, true, false})
        comp.dest = Arg{}
        if big(inst.ret) and not inst.export:
            comp.dest = temp()
            append(comp.passes, Pass{L, comp.dest, false, VOID})
        taken := comp.passes.len - made.params
        passed := made.params
        for given in comp.vars:
            if comp.types[given.type].kind != Given:
                if comp.passes[passed].cls < AGG:
                    at := given.addr
                    given.addr = alloc(given.type)
                    store(given.type, Value{type = given.type, at = at}, given.addr)
                mention(given.name, given.addr, given.type, given.tok)
                passed += 1
        if i == comp.entry: # it is the main of C, and starts the program
            taken = 2
            argc := temp()
            argv := temp()
            append(comp.passes, Pass{W, argc, true, VOID})
            append(comp.passes, Pass{L, argv, false, VOID})
            add(Ins{op = "storew", a = argc, b = global("$flag.argc")})
            add(Ins{op = "storel", a = argv, b = global("$flag.argv")})
            vectored := false
            for n in comp.nodes:
                vectored = vectored or n.kind == TName and n.module.len == 0 and comp.tokens[n.tok].text == "simd" and not comp.files[file_of(comp.tokens[n.tok].at)].library
            if vectored and comp.machine == "x86_64":
                need := int_arg(0x98_0200) # SSSE3, SSE4.1, SSE4.2 and POPCNT, the x86-64-v2 that the lanes use
                l_old := label()
                l_new := label()
                branch(op(W, "ceqw", op(W, "and", op1(W, "cpuid", int_arg(1)), need), need), l_new, l_old)
                open_block(l_old)
                message := text_data("flag: this program needs an x86-64-v2 processor (SSE4.2)\n")
                first := comp.passes.len
                append(comp.passes, Pass{W, int_arg(2), true, VOID})
                append(comp.passes, Pass{L, op1(L, "loadl", message), false, VOID})
                append(comp.passes, Pass{L, op1(L, "loadl", offset(message, 8)), true, VOID})
                add(Ins{op = "call", a = global("$write"), first = u32(first), count = 3})
                append(comp.passes, Pass{W, int_arg(132), true, VOID})
                add(Ins{op = "call", a = global("$exit"), first = u32(first + 3), count = 1})
                terminate("hlt", Arg{})
                open_block(l_new)
            add(Ins{op = "call", a = global("$flag.stamp"), first = u32(comp.passes.len)})
            add(Ins{op = "call", a = global("$flag_start"), first = u32(comp.passes.len)})
            if comp.system == "windows":
                for fd in 0..3:
                    modes := comp.passes.len
                    append(comp.passes, Pass{W, int_arg(i64(fd)), true, VOID})
                    append(comp.passes, Pass{W, int_arg(32768), true, VOID})
                    add(Ins{op = "call", a = global("$_setmode"), first = u32(modes), count = 2})
        elif inst.export and comp.stamping: # C may call it from a thread that never ran code of this program or library, also core at the exit of such a thread
            l_enter := label()
            l_body := label()
            branch(op1(W, "loadw", global("thread $flag.entered")), l_body, l_enter)
            open_block(l_enter)
            add(Ins{op = "call", a = global("$flag.stamp"), first = u32(comp.passes.len)})
            jump(l_body)
            open_block(l_body)
        name := text(f)
        first := VOID
        second := VOID
        if params(f) > 0:
            first = comp.vars[0].type
        if params(f) > 1:
            second = comp.vars[1].type
        target := first
        if comp.types[first].kind == Ptr:
            target = comp.types[first].elem
        if name == "hash" and inst.ret != U64:
            return fail("operator hash gives the hash that a map uses, so it returns u64, this one returns " + comp.types[inst.ret].name, comp.at)
        if name == "[]=" and params(f) == 2 and comp.types[inst.ret].kind != Ptr:
            return fail("operator []= with two parameters gives the place of x[i], so it returns a pointer, this one returns " + comp.types[inst.ret].name, comp.at)
        if params(f) > 1 and (comp.tokens[comp.nodes[f].tok].kind == Symbol and name[:1] != "[" or name == "and" or name == "or" or name == "xor"):
            if name == "=" and inst.ret != target:
                return fail("operator = returns the " + comp.types[target].name + " it makes, this one returns " + comp.types[inst.ret].name, comp.at)
            if name == "+=" and comp.types[first].name != "*&str":
                return fail("operator += appends to text only, its first parameter is *&str: for another type declare operator +, which a += b uses", comp.at)
            if (name == "==" or name == "<") and inst.ret != BOOL:
                return fail("operator " + name + " answers a comparison, so it returns bool, this one returns " + comp.types[inst.ret].name, comp.at)
            if name != "=" and name != "+=" and numeric(first) and numeric(second) and first != second:
                return fail("operator " + name + " between " + comp.types[first].name + " and " + comp.types[second].name + " can never run, the language handles every pair of numbers", comp.at)
            if name != "=" and name != "+=" and first == second and native(name, comp.types[target].kind).len > 0 and native(name, comp.types[first].kind).len > 0:
                return fail("operator " + name + " between two " + comp.types[first].name + " belongs to the language, it cannot be declared again", comp.at)
            if (name == "+" or name == "-") and first != target and target == BYTES and (integer(second) or name == "-" and second == first):
                return fail("operator " + name + " between " + comp.types[first].name + " and " + comp.types[second].name + " belongs to the language, it cannot be declared again", comp.at)
            right := second
            if comp.types[second].kind == Ptr:
                right = comp.types[second].elem
            if name != "=" and name != "+=" and (comp.types[target].kind == Simd or comp.types[right].kind == Simd) and (comp.types[target].kind == Simd or numeric(target) or target == BOOL) and (comp.types[right].kind == Simd or numeric(right) or right == BOOL):
                return fail("operator " + name + " between " + comp.types[target].name + " and " + comp.types[right].name + " works on the lanes, it belongs to the language and cannot be declared", comp.at)
        if name == "not" and (target == BOOL or integer(target) or comp.types[target].kind == Simd):
            return fail("operator not on " + comp.types[target].name + " belongs to the language, it cannot be declared again", comp.at)
        try statements(body(f))
        if comp.live:
            comp.at = comp.tokens[comp.nodes[f].tok].at
            if comp.ret == NEVER:
                return fail("this function returns never, and a path reaches its end: end each path with a call that never returns, like exit", comp.at)
            if comp.ret != VOID:
                return fail("not every path of this function returns a value", comp.at)
            done := Arg{}
            if comp.inst == comp.entry:
                done = try ending(Value{type = I32, at = int_arg(0)}, comp.at)
            terminate("ret", done)
        try forget(0)
        back: u32 = 0
        if inst.ret != VOID and inst.export:
            back = try passing(inst.ret, true, comp.at)
        elif inst.ret != VOID and comp.dest.kind == Empty:
            back = cls(inst.ret)
        if i == comp.entry and inst.ret == VOID: # C reads an exit code from it
            back = W
            for k in 0..comp.body.len:
                if comp.body[k].op == "ret" and comp.body[k].a.kind == Empty:
                    comp.body[k].a = int_arg(0)
        close_proc(made, back, taken)
        close_frame(saved)
    comp.blame = 0
    return known

func site(at: i64) -> i64:
    if comp.blame != 0 and comp.insts[comp.inst].library:
        return comp.blame
    return at

func made(inst: i64) -> &str:
    i := comp.insts[inst]
    return bindings(comp.inst_binds[i.binds:i.binds + i.count])

func bindings(binds: &listview[Item]) -> &str:
    given: &str = heap("")
    for b in binds:
        if given.len > 0:
            given += ", "
        given += b.name + " = " + brief(arg_name(b))
    return given

func counted(n: i64, one: &strview, many: &strview) -> &strview:
    if n == 1:
        return "1 " + one
    return "" + n + " " + many

func brief(name: &strview) -> &strview:
    if name.len > 100:
        return name[:100] + "..."
    return name

func open_proc(name: &strview, node: i64, inst: i64, export: bool) -> Proc:
    return Proc{name = name, file = file_of(comp.at), params = comp.passes.len, temps = comp.temps + 1, labels = comp.labels, mentions = comp.mentions.len, scopes = comp.scopes.len, node = node, inst = inst, export = export}

func proc_name(f: Proc) -> &str:
    inst := comp.insts[f.inst]
    name: &str = heap("")
    if f.node == 0 and inst.ret == BOOL:
        name += "operator == of " + comp.types[comp.inst_binds[inst.binds].type].name
    elif f.node == 0 and inst.ret == U64:
        name += "hash of " + comp.types[comp.inst_binds[inst.binds].type].name
    elif f.node == 0:
        name += "start of a thread that runs " + comp.types[comp.inst_binds[inst.binds].type].name
    else:
        if comp.tokens[comp.nodes[f.node].tok].kind != Name or reserved(text(f.node)):
            name += "operator "
        name += text(f.node)
    return name

func declared_at(f: Proc) -> i64:
    if f.node == 0:
        return comp.insts[f.inst].at
    return comp.tokens[comp.nodes[f.node].tok].at

func close_proc(made: Proc, cls: u32, count: i64):
    made.cls = cls
    made.count = count
    made.code = comp.code.len
    for i in comp.slots:
        append(comp.code, i)
    for i in comp.body:
        append(comp.code, i)
    made.end = comp.code.len
    made.last = comp.temps
    made.mentioned = comp.mentions.len
    made.scoped = comp.scopes.len
    append(comp.procs, made)
    comp.slots.len = 0
    comp.spare.len = 0
    comp.held.len = 0
    comp.body.len = 0

func takes_types(f: i64) -> bool:
    for k in 0..params(f):
        c := kid(f, k)
        if comp.nodes[c].size > 1 and text(c + 1) == "type":
            return true
    return false

func params(f: i64) -> i64:
    count := 0
    c := f + 1
    while c < node_end(f) and comp.nodes[c].kind == Var:
        count += 1
        c = node_end(c)
    return count

# the parameter ..items: T, which gathers the extra arguments of a call
func gathers(c: i64) -> bool:
    return comp.tokens[comp.nodes[c].tok - 1].text.len == 2 # the .. before it, where the others have ( or ,

# a function that takes extra arguments, with the ... of C or with ..items: T
func variadic(f: i64) -> bool:
    count := params(f)
    last := kid(f, count - 1)
    return count > 0 and (text(last) == ".." or gathers(last))

# the word before func, operator or context, like inline, noinline or shared
func declared(f: i64) -> &strview:
    if f == 0:
        return ""
    return comp.tokens[comp.nodes[f].tok - 2].text

func result(f: i64) -> i64|Fail:
    c := kid(f, params(f))
    if c == node_end(f) or comp.nodes[c].kind == Literal or comp.nodes[c].kind == Where or comp.nodes[c].kind == Block:
        return VOID
    return result_type(c)

func instantiate(f: i64, at: i64) -> i64|Fail:
    key: &str = heap("")
    key += f
    for i in comp.frame..comp.binds.len: # with its name, the calls may bind them in another order
        key += "|" + comp.binds[i].name + "=" + arg_name(comp.binds[i])
    id := comp.inst_ids[view(key)]
    if id is i64:
        return id
    depth := 0
    if comp.binds.len > comp.frame and comp.insts.len > 0: # a default of a type is made before any function
        depth = comp.insts[comp.inst].depth + 1
    comp.spelled += key.len
    if comp.insts.len > 100000 or depth > DEEP or comp.spelled > LONG:
        return fail("instancing " + text(f) + " never ends, each call builds a bigger type than the last", comp.tokens[comp.nodes[f].tok].at)
    ret := result(f)
    if ret is Fail:
        if site(at) == at and at != 0 and comp.binds.len > comp.frame:
            note("the " + text(f) + " that fails was made for this call, with " + bindings(comp.binds[comp.frame:]), at)
        return Fail
    export := false
    s := first_sym(text(f))
    while s != 0:
        export = export or comp.syms[s].node == f and comp.syms[s].export
        s = comp.syms[s].next
    name: &str = heap("$")
    if body(f) == 0 or export:
        name += linked(f)
    else:
        if comp.tokens[comp.nodes[f].tok].kind == Name:
            name += text(f)
        else:
            name += "op"
        name += "." + comp.insts.len
    library := comp.files[file_of(comp.tokens[comp.nodes[f].tok].at)].library
    append(comp.insts, Inst{f, view(name), comp.inst_binds.len, comp.binds.len - comp.frame, ret, site(at), export, library, depth, VOID})
    for i in comp.frame..comp.binds.len:
        append(comp.inst_binds, comp.binds[i])
    put(comp.inst_ids, view(key), comp.insts.len - 1)
    return comp.insts.len - 1

# split by kind: QBE gives each call that returns a struct its own stack slot
func gen(n: i64, want: i64) -> Value|Fail:
    node := comp.nodes[n]
    tok := comp.tokens[node.tok]
    none: Value
    try deeper(tok.at)
    defer comp.depth -= 1
    switch node.kind:
    case Block:
        try statements(n)
        return none
    case Var:
        try untaken(node.tok)
        t := VOID
        c := n + 1
        if comp.tokens[node.tok + 1].text == ":":
            t = try resolve(c)
            c = node_end(c)
        v := none
        if c < node_end(n):
            v = try value(c, t)
        ty := comp.types[v.type]
        if t == VOID and (v.type == EMPTYARRAY or v.type == EMPTYMAP or ty.kind == Fat and type_params(ty.decl) > 0 and comp.items[ty.args].type == NEVER): # heap([]) is a &list[never]
            example: &strview = ": &list[i32]"
            if v.type == EMPTYARRAY: # a bare [] holds no memory, and a list that grows takes it from heap
                example = ": &list[i32] = heap([])"
            if v.type == EMPTYMAP:
                example = ": &map[&strview, i32] = heap({})"
            elif ty.kind == Fat and text(ty.decl) == "map":
                example = ": &map[&strview, i32]"
            return fail(tok.text + " cannot take its type from an empty literal, write the type: " + tok.text + example, tok.at)
        if t == VOID:
            t = v.type
        if comp.types[t].kind == Bytes:
            return fail("variable " + tok.text + " needs a size, bytes is a run of unknown length", tok.at)
        slot := alloc(t, true)
        mention(tok.text, slot, t, node.tok)
        if c == node_end(n) or v.type != t:
            try zero(t, slot)
        if c < node_end(n):
            try assign(slot, t, v, at_of(c))
        append(comp.vars, Local{tok.text, t, slot, comp.loops.len, node.tok, 0, "", node.tok if must_read(t) else 0, c < node_end(n) or not comp.types[t].hollow, false})
        if noted(tok.at):
            mark(node.tok, described(tok.text, t))
        return none
    case Assign:
        left := n + 1
        right := node_end(left)
        if node_end(right) < node_end(n): # several places, a, b = c, d or lo, hi := f(): after the right side each one gets its value in order, as if alone
            source := kid(n, kids(n) - 1)
            commas := comp.nodes[source].kind == Fill and text(source) == ","
            places := kids(n) - 1
            values: &list[Value] = heap([])
            if commas:
                turns := comp.turns.len
                c := source + 1
                p := left
                while c < node_end(source):
                    typed := VOID # the type its place declares, so the value reads as it would alone
                    if tok.text == "=" and p < source:
                        typed = try place_type(p)
                    try read_in_turn(values, c, typed)
                    c = node_end(c)
                    p = node_end(p)
                in_turn(values, turns)
            else:
                whole := try value(source, VOID)
                ty := comp.types[whole.type]
                if ty.kind == Union and fails(whole.type):
                    return fail(ty.name + " cannot come apart, only a tuple does: handle the error first with try, iferror or trust", at_of(source))
                if ty.kind == Union and contains(members(whole.type), NULL):
                    return fail(ty.name + " cannot come apart, only a tuple does: handle the null first with ifnull or trust", at_of(source))
                if not tuple(whole.type):
                    return fail(ty.name + " cannot come apart, only a tuple does", at_of(source))
                for item in comp.items[ty.first:ty.first + ty.count]:
                    append(values, Value{type = item.type, at = offset(whole.at, item.n), mem = true, place = whole.place})
                if values.len != places and tok.text == ":=":
                    return fail("" + places + " names expect " + places + " values but " + ty.name + " holds " + values.len, at_of(source))
                if values.len != places:
                    return fail("" + places + " places expect " + places + " values but " + ty.name + " holds " + values.len, at_of(source))
            if values.len != places and tok.text == ":=":
                return fail("" + places + " names expect " + places + " values but got " + values.len, at_of(source))
            if values.len != places:
                return fail("" + places + " places expect " + places + " values but got " + values.len, at_of(source))
            if tok.text == "=":
                for i in 0..places: # every value is read before a place gets one
                    values[i] = now(values[i])
            c := left
            for i in 0..places:
                if comp.nodes[c].kind != Name or text(c) != "_": # each place is born as its own declaration or assignment, after a hidden local that holds its value, or a literal again
                    made := comp.nodes.len
                    hidden := comp.vars.len
                    again := commas and values[i].lit
                    if tok.text == ":=":
                        append(comp.nodes, Node{Var, comp.nodes[c].tok, 0, ""})
                    else:
                        append(comp.nodes, Node{Assign, node.tok, 0, ""})
                        for j in c..node_end(c):
                            append(comp.nodes, comp.nodes[j])
                    if again:
                        for j in kid(source, i)..node_end(kid(source, i)):
                            append(comp.nodes, comp.nodes[j])
                    else:
                        v := values[i]
                        if not v.mem:
                            slot := alloc(v.type)
                            store(v.type, v, slot)
                            v = Value{type = v.type, at = slot, mem = true}
                        append(comp.vars, Local{tok.text, v.type, v.at, comp.loops.len, node.tok, 0, "", 0, true, false})
                        append(comp.nodes, Node{Name, node.tok, 1, ""})
                    comp.nodes[made].size = comp.nodes.len - made
                    try gen(made, VOID)
                    comp.nodes.len = made
                    if not again:
                        remove(comp.vars, hidden)
                c = node_end(c)
            return none
        lk := comp.nodes[left].kind
        if lk == Name and text(left) == "_":
            try value(right, VOID)
            return none
        comp.target = left
        if lk == Index:
            return indexed(left, n)
        first := comp.body.len
        spot := none
        if lk == Name or lk == Field or lk == Unary and text(left) == ".*":
            spot = try gen(left, VOID)
        head := left
        while comp.nodes[head].kind == Field:
            head += 1
        if not spot.place and local_of(head) != 0 and comp.vars[local_of(head) - 1].fixed.len > 0:
            return fail(comp.vars[local_of(head) - 1].fixed, at_of(head))
        if not spot.place and comp.nodes[head].kind == Name and local_of(head) == 0:
            s := try named(text(head), comp.nodes[head].module, at_of(head))
            if s != 0 and comp.nodes[comp.syms[s].node].kind == Constant:
                return fail(text(head) + " is a constant, it cannot be assigned: keep what changes in a context, or in a shared context for all the threads", at_of(head))
            if s != 0 and comp.nodes[comp.syms[s].node].kind == Var:
                return fail(text(head) + " is the address of a variable of C, it cannot be assigned: write the variable through it, " + text(head) + ".* = ...", at_of(head))
        if not spot.place:
            return fail("this cannot be assigned, only a variable, a field of one, an element or what a pointer points to can", at_of(left))
        try update(spot, n, first)
        return none
    case Return:
        if comp.ret == NEVER:
            return fail("this function returns never, so it cannot return", tok.at)
        if node.size == 1:
            if comp.ret != VOID:
                return fail("return expects a value, this function returns " + comp.types[comp.ret].name, tok.at)
            try unwind(0, 0)
            done := Arg{}
            if comp.inst == comp.entry:
                done = try ending(Value{type = I32, at = int_arg(0)}, tok.at)
            terminate("ret", done)
            return none
        if comp.ret == VOID:
            return fail("this function returns nothing, return expects no value", tok.at)
        v := try value(n + 1, comp.ret)
        if stacked(n + 1) != 0:
            return fail(STACK, at_of(n + 1))
        try leave(v, at_of(n + 1))
        return none
    case If:
        before := comp.vars.len
        given := comp.given.len
        ends: &list[Local] = heap([])
        lives := 0
        l_end := label()
        part := n
        while part < node_end(n) and comp.nodes[part].kind == If:
            cond := part + 1
            yes := node_end(cond)
            comp.at = comp.tokens[comp.nodes[part].tok].at # its if or elif, at_of would walk the rest of the chain
            c := try condition(cond)
            l_yes := label()
            l_no := label()
            branch(c.at, l_yes, l_no)
            open_block(l_yes)
            narrowed := comp.vars.len
            try narrow(cond, true)
            try statements(yes)
            regive(given, before, false)
            if try keep(before, narrowed, ends):
                lives += 1
                jump(l_end)
            open_block(l_no)
            try narrow(cond, false)
            part = node_end(yes)
        if part < node_end(n):
            try statements(part)
        regive(given, before, true)
        if try keep(before, before, ends):
            lives += 1
            jump(l_end)
        if lives > 0:
            open_block(l_end)
            try join(ends, lives, tok.at)
        return none
    case While:
        cond := n + 1
        l_head := label()
        l_body := label()
        l_exit := label()
        jump(l_head)
        open_block(l_head)
        append(comp.loops, Loop{l_exit, l_head, comp.defers.len, comp.slots.len, 0, 0, false})
        c := try condition(cond)
        forever := c.lit and c.n == 1
        if not forever:
            branch(c.at, l_body, l_exit)
        open_block(l_body)
        before := comp.vars.len
        try narrow(cond, true)
        try statements(node_end(cond))
        jump(l_head)
        broke := comp.loops[-1].broke
        comp.loops.len -= 1
        try forget(before)
        if not forever or broke:
            open_block(l_exit)
        return none
    case For:
        try iterate(n)
        return none
    case Switch:
        try cases(n)
        return none
    case Jump:
        depth: u64 = 1
        if node.size > 1:
            depth = try int_value(text(n + 1), comp.tokens[comp.nodes[n + 1].tok].at)
        if comp.loops.len == 0:
            return fail(tok.text + " goes inside a loop", tok.at)
        if depth == 0:
            return fail(tok.text + " 0 names no loop, the innermost loop is 1", tok.at)
        if depth > comp.loops.len:
            return fail(tok.text + " " + depth + " reaches past the loops open here, it can count up to " + comp.loops.len, tok.at)
        k := comp.loops.len - i64(depth)
        l := comp.loops[k]
        try unwind(l.defers, k + 1)
        if l.slots < comp.slots.len:
            add(ended(l.slots))
        if tok.text == "break":
            comp.loops[k].broke = true
            jump(l.exit)
        else:
            jump(l.again)
        return none
    case Assert:
        cond := n + 1
        o := text(cond)
        sign := comp.nodes[cond].tok
        first := node.tok + 1
        last := first
        while unclosed(first, last) > 0 or comp.tokens[last + 1].text != "," and comp.tokens[last + 1].kind != Line:
            last += 1
        sides: &list[Value] = heap([])
        c: Value
        switch o:
        case "==", "!=", "<", ">", "<=", ">=":
            append(sides, try value(cond + 1, VOID))
            append(sides, try value(node_end(cond + 1), VOID))
            c = try condition_of(try binary(o, sides[0], sides[1], comp.tokens[sign].at), cond)
        case "is":
            append(sides, try value(cond + 1, VOID))
            c = try is_test(sides[0], cond)
        case:
            c = try condition(cond)
        l_fail := label()
        l_ok := label()
        branch(c.at, l_ok, l_fail)
        open_block(l_fail)
        line := try in_heap(try fat_type("str", VOID, tok.at))
        if kids(n) == 2:
            try put_text(line, try value(node_end(cond), VOID), at_of(node_end(cond)))
        elif o == "is":
            wanted := members(try resolve(node_end(cond + 1)))
            l_done := label()
            for m in members(sides[0].type):
                if not contains(wanted, m):
                    l_arm := label()
                    l_next := label()
                    branch(op(W, "ceqw", tag(sides[0]), tag_of(m)), l_arm, l_next)
                    open_block(l_arm)
                    try put_words(line, spelled(first, sign - 1) + " is " + comp.types[m].name + ", not " + spelled(sign + 1, last), tok.at)
                    if comp.types[m].kind != Void:
                        try put_words(line, ": ", tok.at)
                        try put_text(line, Value{type = m, at = payload(sides[0].at, m), mem = true}, tok.at)
                    jump(l_done)
                    open_block(l_next)
            terminate("hlt", Arg{})
            open_block(l_done)
        elif spelled(first, last) == "false":
            try put_words(line, "assertion failed", tok.at)
        else:
            try put_words(line, spelled(first, last) + " is false", tok.at)
            joiner: &strview = ", "
            for k, side in sides:
                if not side.lit and comp.types[side.type].kind != Void:
                    shown := spelled(first, sign - 1)
                    if k == 1:
                        shown = spelled(sign + 1, last)
                    try put_words(line, joiner + shown + " is ", tok.at)
                    try put_text(line, side, tok.at)
                    joiner = " and "
        args: &list[Value] = heap([])
        append(args, line)
        append(args, try place_of(tok.at))
        try runtime("panic", args, tok.at)
        open_block(l_ok)
        try narrow(cond, true)
        return none
    case Defer:
        last := node.tok
        for i in n + 1..node_end(n):
            if comp.nodes[i].tok > last:
                last = comp.nodes[i].tok
            if comp.nodes[i - 1].kind != Assign:
                reads(i)
        for t in comp.tokens[node.tok + 1:last + 1]:
            if t.kind == Name and (t.text == "return" or t.text == "break" or t.text == "continue" or t.text == "try"):
                return fail("a deferred statement runs on the way out, it cannot hold " + t.text, t.at)
        append(comp.defers, Deferred{n + 1, comp.vars.len, none})
        return none
    case Where:
        if try holds(n + 1):
            before := comp.vars.len
            ends: &list[Local] = heap([])
            try statements(node_end(n + 1))
            if try keep(before, before, ends):
                try join(ends, 1, tok.at)
        return none
    case With:
        subject := try value(n + 1, VOID)
        if not subject.mem:
            slot := alloc(subject.type)
            store(subject.type, subject, slot)
            subject = Value{type = subject.type, at = slot, mem = true}
        defers := comp.defers.len
        before := comp.vars.len
        ends: &list[Local] = heap([])
        append(comp.defers, Deferred{n, before, subject})
        try statements(node_end(n + 1))
        if comp.live:
            try run_defers(defers)
        comp.defers.len = defers
        if try keep(before, before, ends):
            try join(ends, 1, tok.at)
        return none
    case Name:
        if tok.kind == Generic:
            b := bound(tok.text)
            if b == 0 or comp.binds[b - 1].type != VOID:
                return fail(tok.text + " is not a number bound here, a $$name gets its value from a parameter", tok.at)
            return literal(false, u64(comp.binds[b - 1].n))
        if node.module.len == 0:
            if tok.text == "true" or tok.text == "false":
                return truth(tok.text == "true")
            if tok.text == "inf":
                return float_literal(u64(0x7ff0_0000_0000_0000) as f64)
            if tok.text == "nan":
                return float_literal(u64(0x7ff8_0000_0000_0000) as f64)
            if tok.text == "null" or tok.text == "IterationEnd":
                return Value{type = trust comp.type_ids[tok.text]}
            found := lookup(tok.text)
            if found != 0 and comp.types[comp.vars[found - 1].type].kind == Given:
                return fail(tok.text + " is the type the call gives, not a value: write " + comp.tokens[comp.vars[found - 1].tok + 3].text, tok.at) # its declaration is kind: type $T
            if found != 0 and not comp.vars[found - 1].given and not (comp.target == n and text(n - 1) == "="):
                t := comp.vars[found - 1].type
                if emptied(t).len > 0:
                    return fail(tok.text + " is used before it gets a value, and " + comp.types[t].name + " starts without one: " + tok.text + ": " + comp.types[t].name + " = " + emptied(t), tok.at)
                return fail(tok.text + " is used before it gets a value, and " + comp.types[t].name + " starts without one", tok.at)
            if found != 0:
                return held(found, tok.at)
        s := try named(tok.text, node.module, tok.at)
        if s == 0:
            wanted := func_in(want)
            typed: &list[Value] = heap([])
            order: &list[i64] = heap([])
            for k in 0..comp.types[wanted].count:
                append(typed, Value{type = comp.items[comp.types[wanted].first + k].type})
                append(order, k)
            found := 0
            seen := false
            extra := false
            given := false
            untyped := false
            tied := false
            s = first_sym(tok.text)
            while s != 0:
                f := comp.syms[s].node
                if callable(s, node.module, typed, tok.at):
                    seen = true
                    fits := false
                    given = given or takes_types(f)
                    if variadic(f):
                        extra = true
                    elif wanted == VOID and generic(f):
                        untyped = true
                    elif wanted == VOID or params(f) == order.len:
                        saved := open_frame()
                        fits = try bind(f, order, typed) is &list[i64]
                        k := 0
                        while fits and k < order.len:
                            fits = try resolve(kid(f, k) + 1) == typed[k].type
                            k += 1
                        close_frame(saved)
                    if fits and (found == 0 or near(s, tok.at) < near(found, tok.at)):
                        found = s
                        tied = false
                    elif fits and near(s, tok.at) == near(found, tok.at):
                        tied = true
                s = comp.syms[s].next
            if seen:
                if found == 0 and extra:
                    return fail(tok.text + " can have more arguments after its parameters, and a function type cannot say that: wrap it in a func that calls it", tok.at)
                if found == 0 and given:
                    return fail(tok.text + " has a type parameter, and a function value cannot give it a type: wrap it in a func that calls it", tok.at)
                if found == 0 and untyped:
                    return fail(tok.text + " is generic and nothing here gives it its types: give it to a variable that says its function type first", tok.at)
                if found == 0:
                    return fail("no overload of " + tok.text + " is " + comp.types[wanted].name + ", a function value is the overload with exactly those parameters", tok.at)
                if tied and wanted == VOID:
                    return fail(tok.text + " names several functions and nothing here says which: give it to a variable that says its function type first", tok.at)
                if tied:
                    return fail("ambiguous function value " + tok.text + ", several overloads have the parameters of " + comp.types[wanted].name, tok.at)
                f := comp.syms[found].node
                taken: &list[i64] = heap([])
                id := try instantiate_for(f, order, typed, ptr(taken), tok.at)
                if id == comp.entry:
                    return fail(ENTRY, tok.at)
                made := func_of(taken, comp.insts[id].ret, body(f) == 0 or comp.insts[id].export)
                comp.insts[id].taken_as = made
                if wanted != VOID and comp.types[made].foreign and not comp.types[wanted].foreign:
                    return fail(tok.text + " is a C function, so its value is " + comp.types[made].name + " and this place expects " + comp.types[wanted].name, tok.at)
                if wanted != VOID and comp.types[wanted].foreign and not comp.types[made].foreign:
                    return fail(tok.text + " is a function of Flag, and this place expects " + comp.types[wanted].name + ", which holds a C function: declare it export func", tok.at)
                if wanted != VOID and made != wanted:
                    return fail(tok.text + " is " + comp.types[made].name + " and this place expects " + comp.types[wanted].name, tok.at)
                if noted(tok.at):
                    mark(comp.nodes[f].tok)
                if body(f) == 0 and comp.system != "windows":
                    return Value{type = made, at = global("extern " + comp.insts[id].name)} # the address of a function of another library comes from the GOT
                return Value{type = made, at = global(comp.insts[id].name)}
            try hidden(tok.text, true, tok.at)
            try hidden(tok.text, false, tok.at)
            id := comp.type_ids[tok.text]
            if node.module.len == 0 and id is i64 and id <= BYTES:
                return fail(tok.text + " is a type, so its name alone is not a value", tok.at)
            if reserved(tok.text):
                return fail("'" + tok.text + "' is a keyword of the language, it is not a value", tok.at)
            if comp.choosing:
                return fail("a where reads types, numbers and constants that the compiler knows, and " + tok.text + " is not one", tok.at)
            if comp.tokens[node.tok + 1].text == "." and comp.tokens[node.tok + 3].text == "(":
                return fail("no variable named " + tok.text + " is visible here, and " + tok.text + " is not a module this file uses", tok.at)
            return fail("no variable, constant or type named " + tok.text + " is visible here", tok.at)
        d := comp.syms[s].node
        if noted(tok.at):
            mark(comp.nodes[d].tok)
        k := comp.nodes[d].kind
        if k == Constant:
            return constant(s, want, tok.at)
        if k == Var: # the address of a variable of C, from a slot of data that the loader fills, which a library takes too
            symbol := text(d)
            if kids(d) == 2:
                symbol = text(kid(d, 1))[1:text(kid(d, 1)).len - 1]
            slot: &str = heap("$flag.c.")
            slot += symbol
            if comp.stored[view(slot)] is null:
                put(comp.stored, view(slot), 0)
                comp.data += read_only(true) + "data " + slot + " = { l $" + symbol + " }\n"
            return Value{type = try resolve(d + 1), at = op1(L, "loadl", global(view(slot)))}
        if k == Void:
            return Value{type = try make_type(s, [], false, tok.at)}
        if k != Context:
            return fail(tok.text + " is a type that carries data, so its name alone is not a value", tok.at)
        t := try make_type(s, [], false, tok.at)
        if declared(d) == "shared":
            return Value{type = t, at = global("$ctx." + comp.types[t].name), mem = true, place = true}
        return Value{type = t, at = global("thread $ctx." + comp.types[t].name), mem = true, place = true}
    case Literal:
        if tok.kind == Int:
            return literal(false, try int_value(tok.text, tok.at))
        if tok.kind == Float:
            x := strtod(cstr(replace(tok.text, "_", "")), 0 as *bytes)
            if x - x != 0.0:
                return fail(tok.text + " does not fit in f64, the largest f64 is 1.7976931348623157e+308: write inf for infinity", tok.at)
            return float_literal(x)
        return Value{type = try fat_type("strview", VOID, tok.at), at = text_data(unquoted(tok.text)), mem = true, lit = true}
    case Named:
        return value(n + 1, want)
    case Call:
        return called(n, want, false)
    case Brace, Fill:
        t := struct_in(want)
        c := n + 1
        if node.kind == Brace:
            t = try resolve(n + 1)
            c = node_end(n + 1)
        ty := comp.types[t]
        if node.kind == Fill and ty.kind != Struct and ty.kind != Array: # no struct to take, so alone its values make a tuple of their own types
            if want != VOID and tok.text == ",":
                return fail("return expects one value, this function returns " + ty.name, tok.at)
            if want != VOID:
                return fail("a {...} without a type needs a place that gives it one: p: Point = {1, 2}", tok.at)
            if comp.nodes[c].kind == Named:
                return fail("a {...} that names its fields needs a place that gives it a type: p: Point = {x = 1, y = 2}", tok.at)
            if kids(n) == 1:
                return fail("a {...} of one value needs a place that gives it a type, a tuple holds two or more: w: Wrapper = {1}", tok.at)
            parts: &list[Value] = heap([])
            types: &list[i64] = heap([])
            turns := comp.turns.len
            while c < node_end(n):
                if comp.nodes[c].kind == Named:
                    return fail("a literal names every field it fills or none, the two forms do not mix", at_of(c))
                try read_in_turn(parts, c, VOID)
                append(types, parts[-1].type)
                c = node_end(c)
            in_turn(parts, turns)
            made := try fresh(try tuple_of(types, tok.at))
            for i, part in parts:
                try assign(offset(made.at, comp.items[comp.types[made.type].first + i].n), part.type, part, tok.at)
            return made
        if ty.kind != Struct and ty.kind != Array and (c < node_end(n) or ty.kind == Bytes):
            return fail(ty.name + "{...} builds a struct or an array, " + ty.name + " is neither", tok.at)
        slot := alloc(t)
        try zero(t, slot)
        named := c < node_end(n) and comp.nodes[c].kind == Named
        if named and ty.kind == Array:
            return fail(ty.name + " fills its elements in order, they have no names", at_of(c))
        filled: &list[Item] = heap([])
        given := 0
        k := c
        while k < node_end(n):
            given += 1
            k = node_end(k)
        if not named and c < node_end(n):
            for i in 0..ty.count:
                if ty.kind == Array:
                    append(filled, Item{type = ty.elem, n = i * comp.types[ty.elem].size})
                elif not comp.items[ty.first + i].shared:
                    append(filled, comp.items[ty.first + i])
            if given != filled.len and ty.kind == Array:
                return fail(ty.name + " holds " + counted(filled.len, "element", "elements") + " but this literal gives " + counted(given, "value", "values"), tok.at)
            if given != filled.len and tuple(t):
                return fail(ty.name + " holds " + counted(filled.len, "value", "values") + " but this literal gives " + counted(given, "value", "values"), tok.at)
            if given != filled.len:
                return fail(ty.name + " has " + counted(filled.len, "field", "fields") + " but this literal gives " + counted(given, "value", "values"), tok.at)
        word: &list[Value] = heap([])
        defer free(word)
        known := true
        joined: u64 = 0
        last := 0
        i := 0
        while c < node_end(n):
            if (comp.nodes[c].kind == Named) != named:
                return fail("a literal names every field it fills or none, the two forms do not mix", at_of(c))
            if named:
                f := 0
                while f < ty.count and comp.items[ty.first + f].name != text(c):
                    f += 1
                if f == ty.count:
                    return fail(ty.name + " has no field " + text(c), at_of(c))
                field := comp.items[ty.first + f]
                for g in filled:
                    if g.name == field.name:
                        return fail("field " + field.name + " is filled twice", at_of(c))
                    if field.n < g.n + comp.types[g.type].size and g.n < field.n + comp.types[field.type].size:
                        return fail("field " + field.name + " cannot be filled, " + g.name + " already fills the storage they share", at_of(c))
                append(filled, field)
            f := filled[i]
            size := comp.types[f.type].size
            v := try value(c, f.type)
            at := f.n / 8 * 8
            if not named and at >= last and packs(f, at):
                w := try convert(v, f.type, Arg{}, at_of(c))
                read := load(w)
                if comp.types[v.type].size == 0:
                    read = Value{type = I32, at = tag_of(v.type)}
                elif comp.types[f.type].kind == Union:
                    read = Value{type = I32, at = tag(w)}
                bits := read.at
                if bits.kind == Single:
                    bits = int_arg(i64(f32(bits.n as f64) as u32))
                known = known and bits.kind == Const
                if known:
                    joined = joined or (u64(bits.n) and (u64(1) << u64(8 * size)) - 1) << u64(8 * (f.n - at))
                append(word, read)
                if i + 1 == filled.len or not packs(filled[i + 1], at):
                    if known:
                        store(U64, Value{type = U64, at = int_arg(i64(joined))}, offset(slot, at)) # the whole word, so a copy of it reads one store
                    else:
                        for j, x in word:
                            store(x.type, x, offset(slot, filled[i + 1 - word.len + j].n))
                    word.len = 0
                    known = true
                    joined = 0
            else:
                try assign(offset(slot, f.n), f.type, v, at_of(c))
                last = f.n + size
            i += 1
            c = node_end(c)
        try missing(t, filled, tok.at)
        return Value{type = t, at = slot, mem = true}
    case Field:
        base := try value(n + 1, VOID)
        t := base.type
        addr := base.at
        copy: i64 = 0
        if comp.types[t].kind == Ptr:
            addr = load(base).at
            t = comp.types[t].elem
            base.place = true
        elif base.element != 0:
            copy = -1 # a field of a copy, which a call cannot put back
        if comp.types[t].kind == Struct or comp.types[t].kind == Fat:
            for i in 0..comp.types[t].count:
                f := comp.items[comp.types[t].first + i]
                if f.name == tok.text:
                    if noted(tok.at) and not tuple(t):
                        mark(comp.nodes[field_node(t, f.name)].tok, described(f.name, f.type))
                    return Value{type = f.type, at = offset(addr, f.n), mem = true, place = base.place, lit = base.lit and aggregate(f.type), element = copy}
        if comp.types[t].kind == Array and tok.text == "len":
            return literal(false, u64(comp.types[t].count))
        if comp.tokens[node.tok + 1].text == "(":
            return fail(comp.types[t].name + " has no field " + tok.text + " to call, a function is called with the value as an argument: " + tok.text + "(...)", tok.at)
        how: &strview
        for m in members(t):
            member := comp.types[m]
            for i in 0..member.count:
                if m != t and (member.kind == Struct or member.kind == Fat) and comp.items[member.first + i].name == tok.text:
                    how = ", narrow it with is or case first"
                    if local_of(n + 1) == 0:
                        how = ", and is and case narrow only variables: copy it to one first"
        chain := n
        while comp.nodes[chain - 1].kind == Field or comp.nodes[chain - 1].kind == Index or text(chain - 1) == ".*" or text(chain - 1) == "(":
            chain -= 1
        o := text(chain - 1)
        if how.len > 0 and comp.nodes[chain - 1].kind == Unary and (o == "try" or o == "trust"):
            operand := comp.nodes[chain - 1].tok + 1
            return fail(o + " applies to the whole of " + excerpt(operand, node.tok) + ", and " + comp.types[t].name + " has no field " + tok.text + ": write (" + o + " " + excerpt(operand, node.tok - 2) + ")." + tok.text, tok.at)
        return fail(comp.types[t].name + " has no field " + tok.text + how, tok.at)
    case Index:
        return indexed(n, 0)
    case Binary, Unary:
        return operation(n, want)
    case Choice:
        return choice(n, want)
    case TName, TUnary, TUnion, TFunc, TTuple:
        if tok.text == "||":
            return fail("'||' is not an operator, write: or", tok.at)
        if tok.text == "&" and lookup(text(n + 1)) != 0:
            return fail("'&' is not an operator, write: ptr(" + text(n + 1) + ")", tok.at)
        if tok.text == "*" and lookup(text(n + 1)) != 0:
            return fail("'*' does not go before a value, write: " + text(n + 1) + ".*", tok.at)
        if node.kind == TTuple:
            close := node.tok
            while unclosed(node.tok, close) > 0:
                close += 1
            inside := excerpt(node.tok + 1, close - 1)
            return fail("(" + inside + ") is the type of a tuple, and a tuple value is written with braces: {" + inside + "}", tok.at)
        return fail(comp.types[try resolve(n)].name + " is a type, not a value", at_of(n))
    case:
        return collection(n, want)

func collection(n: i64, want: i64) -> Value|Fail:
    node := comp.nodes[n]
    tok := comp.tokens[node.tok]
    fitting: &list[i64] = heap([])
    for m in members(want):
        k := comp.types[m].kind
        if node.kind == Items and (k == Array or k == Simd or sequence(m) and not owner(m)) or node.kind == Pairs and k == Struct:
            append(fitting, m)
    t := want
    if fitting.len == 1:
        t = fitting[0]
    hint := comp.types[t]
    fixed := hint.kind == Struct and not tuple(t) and text(hint.decl) == "fixmap"
    if node.size == 1 and (hint.kind == Struct or hint.kind == Array):
        try missing(t, [], tok.at)
        return fresh(t)
    if node.size == 1 and node.kind == Items:
        return Value{type = EMPTYARRAY}
    if node.size == 1:
        return Value{type = EMPTYMAP}
    if node.kind == Items and hint.kind == Simd:
        if kids(n) != hint.count:
            return fail(hint.name + " holds " + counted(hint.count, "lane", "lanes") + " but this literal gives " + counted(kids(n), "value", "values"), tok.at)
        slot := alloc(t)
        c := n + 1
        for i in 0..hint.count:
            try set_lane(slot, t, i, try value(c, lane_value(t)), at_of(c))
            c = node_end(c)
        return Value{type = t, at = slot, mem = true}
    want_key := VOID
    want_value := VOID
    if node.kind == Items and hint.kind == Array and hint.count == kids(n):
        want_value = hint.elem
    if node.kind == Items and sequence(t) and not owner(t):
        want_value = element(t)
    if fixed:
        want_key = comp.items[hint.args].type
        want_value = comp.items[hint.args + 1].type
    parts: &list[Value] = heap([]) # in the order written, each key before its value
    turns := comp.turns.len
    c := n + 1
    while c < node_end(n):
        wanted := want_value
        if node.kind == Pairs and parts.len % 2 == 0:
            wanted = want_key
        try read_in_turn(parts, c, wanted)
        c = node_end(c)
    in_turn(parts, turns)
    keys: &list[Value] = heap([])
    values: &list[Value] = heap([])
    for i, v in parts:
        if node.kind == Pairs and i % 2 == 0:
            append(keys, v)
        else:
            append(values, v)
    if want_value == VOID:
        want_value = try common(values, tok.at)
    if node.kind == Items:
        whole := try fresh(try array_of(want_value, values.len, tok.at))
        for i in 0..values.len:
            try assign(offset(whole.at, i * comp.types[want_value].size), want_value, values[i], tok.at)
        return whole
    if fixed and keys.len > comp.items[hint.args + 2].n:
        return fail(hint.name + " holds " + counted(comp.items[hint.args + 2].n, "entry", "entries") + " but this literal gives " + keys.len, tok.at)
    if hint.kind != Struct: # alone, the pairs make a fixmap that holds just them
        args: &list[Item] = heap([])
        append(args, Item{type = try common(keys, tok.at)})
        append(args, Item{type = want_value})
        append(args, Item{type = VOID, n = keys.len})
        t = try core_type("fixmap", args, tok.at)
    made := try fresh(t)
    for i in 0..keys.len:
        pair: &list[Value] = heap([])
        append(pair, made)
        append(pair, keys[i])
        append(pair, values[i])
        try invoke("[]=", pair, tok.at)
    return made

# a literal of t that gives only the fields filled leaves none without a value
func missing(t: i64, filled: &listview[Item], at: i64) -> Fail?:
    ty := comp.types[t]
    if ty.hollow and ty.kind == Array and filled.len == 0:
        return fail(ty.name + " expects every element, " + comp.types[ty.elem].name + " starts without a value", at)
    if ty.hollow and ty.kind == Struct:
        for f in comp.items[ty.first:ty.first + ty.count]:
            given := false
            for g in filled:
                given = given or g.n == f.n
            if not given and bare(t, f):
                return fail(ty.name + " expects a value for " + f.name + ", " + comp.types[f.type].name + " starts without one: give it in the literal, or give the field a default", at)
    return null

# a value of t as it is born: zeros, tags and default values
func fresh(t: i64) -> Value|Fail:
    made := Value{type = t, at = alloc(t), mem = true}
    try zero(t, made.at)
    return made

func iterate(n: i64) -> Fail?:
    node := comp.nodes[n]
    tok := comp.tokens[node.tok]
    try untaken(node.tok)
    subject := n + 1
    counter := 0
    if kids(n) == 3:
        counter = subject
        subject = node_end(subject)
        try untaken(comp.nodes[counter].tok)
    backward := comp.nodes[subject].kind == Unary and text(subject) == "reverse"
    if backward:
        subject += 1
    inclusive := comp.nodes[subject].kind == Binary and text(subject) == "..="
    range := inclusive or comp.nodes[subject].kind == Binary and text(subject) == ".."
    if range and counter != 0:
        return fail("a for over a range cannot count, the number it gives is already the index", comp.tokens[comp.nodes[counter].tok].at)
    before := comp.vars.len
    open_scope()
    l_head := label()
    l_body := label()
    l_step := label()
    l_exit := label()
    slot := Arg{}
    stop := Arg{}
    t := VOID
    at := at_of(subject)
    start := literal(false, 0)
    end: Value
    walked: Value
    elem := VOID
    addr := Arg{}
    limit: u64 = 0
    every := false # a walk that visits every element, for -memory: of an array, a list or what next gives
    rounds := false
    opened := 0
    if range:
        start = try value(subject + 1, VOID)
        end = try value(node_end(subject + 1), VOID)
        for side in [start, end]:
            if not integer(side.type):
                return fail("a range expects integers at both ends, this one is " + comp.types[side.type].name, at)
        t = start.type
        if start.lit or not end.lit and widens(start.type, end.type):
            t = end.type
        if not end.lit and end.type != t and not widens(end.type, t):
            return fail("a range cannot mix " + comp.types[start.type].name + " and " + comp.types[end.type].name + ", neither holds every value of the other: convert one end with " + comp.types[start.type].name + "(...) or " + comp.types[end.type].name + "(...)", at)
        if start.lit and not start.neg and end.lit and not end.neg:
            limit = end.n + u64(inclusive)
    else:
        walked = try value(subject, VOID)
        pointee := comp.types[walked.type].elem
        if comp.types[walked.type].kind == Ptr and (comp.types[pointee].kind == Array or sequence(pointee) or textual(pointee)):
            walked = Value{type = pointee, at = load(walked).at, mem = true, place = true}
        seq := walked.type
        addr = walked.at
        t = field_of(try fat_type("strview", VOID, tok.at), "len").type # a for counts in the type of a length
        every = comp.types[seq].kind == Array or owner(seq)
        if comp.types[seq].kind == Array:
            elem = comp.types[seq].elem
            end = literal(false, u64(comp.types[seq].count))
        elif sequence(seq):
            elem = element(seq)
            field := field_of(seq, "len")
            end = load(Value{type = field.type, at = offset(addr, field.n), mem = true})
            addr = op1(L, "loadl", addr)
    round := comp.slots.len # the slots of a round, after those of the subject, which lives as long as the loop
    if range or elem != VOID:
        low := load(try convert(start, t, Arg{}, at)).at
        high := load(try convert(end, t, Arg{}, at)).at
        last := high
        runs := cmp_name("csle", t)
        if not inclusive:
            last = op(cls(t), "sub", high, int_arg(1))
            runs = cmp_name("cslt", t)
        from := low
        stop = last
        if backward:
            from = last
            stop = low
        slot = alloc(t)
        store(t, Value{type = t, at = from}, slot)
        branch(op(W, runs, low, high), l_body, l_exit)
        open_block(l_body)
        opened = comp.body.len
        current := load(Value{type = t, at = slot, mem = true}).at
        if range:
            mention(tok.text, slot, t, node.tok)
            append(comp.vars, Local{tok.text, t, slot, comp.loops.len, node.tok, limit, counting(tok.text), 0, true, false})
        else:
            count: u32 = 0
            if comp.types[walked.type].kind == Array and comp.types[walked.type].count <= 0xffff_ffff:
                count = u32(comp.types[walked.type].count) # -memory keeps the elements of an array apart from what follows it
            place := add(Ins{op = "add", cls = L, to = u32(temp().n), a = addr, b = times(current, comp.types[elem].size), count = count})
            rounds = round(place, elem, l_body, true)
            mention(tok.text, place, elem, node.tok)
            fixed: &strview
            if not walked.place:
                fixed = view(heap(tok.text + " belongs to a value that is not a variable, assigning it would only change a copy"))
            append(comp.vars, Local{tok.text, elem, place, comp.loops.len, node.tok, 0, fixed, 0, true, true})
        if counter != 0:
            count := alloc(t)
            store(t, Value{type = t, at = current}, count)
            mention(text(counter), count, t, comp.nodes[counter].tok)
            append(comp.vars, Local{text(counter), t, count, comp.loops.len, comp.nodes[counter].tok, 0, counting(text(counter)), 0, true, false})
        counted := 0
        if range or counter != 0:
            counted = comp.vars.len
        append(comp.loops, Loop{l_exit, l_step, comp.defers.len, round, counted, l_body, false})
    else:
        if backward and counter != 0:
            return fail("reverse over " + comp.types[walked.type].name + " has no index to give " + text(counter) + ", only an array, a list or a listview knows the index of each element: count in a variable", comp.tokens[comp.nodes[counter].tok].at)
        chars := textual(walked.type)
        walker := walked
        if chars:
            addr = op1(L, "loadl", walked.at)
            field := field_of(walked.type, "len")
            end = load(Value{type = field.type, at = offset(walked.at, field.n), mem = true})
            slot = alloc(t)
            if backward:
                store(t, end, slot)
            else:
                store(t, Value{type = t, at = int_arg(0)}, slot)
        else:
            if comp.types[walked.type].kind == Simd:
                return fail("for does not walk the lanes of a simd, convert it to an array: for x in array[" + comp.types[lane_value(walked.type)].name + ", " + comp.types[walked.type].count + "](v)", at)
            args: &list[Value] = heap([])
            append(args, walked)
            walk: &strview = "for"
            if backward:
                walk = "reverse"
            walker = try invoke(walk, args, at)
            slot = alloc(walker.type)
            store(walker.type, walker, slot)
        count := Arg{}
        if counter != 0:
            count = alloc(t)
            store(t, Value{type = t, at = int_arg(-1)}, count)
        jump(l_head)
        open_block(l_head)
        if counter != 0:
            store(t, Value{type = t, at = op(L, "add", load(Value{type = t, at = count, mem = true}).at, int_arg(1))}, count)
            mention(text(counter), count, t, comp.nodes[counter].tok)
            append(comp.vars, Local{text(counter), t, count, comp.loops.len, comp.nodes[counter].tok, 0, counting(text(counter)), 0, true, false})
        item := VOID
        place := Arg{}
        if chars:
            i := load(Value{type = t, at = slot, mem = true}).at
            if backward:
                branch(op(W, "cultl", int_arg(0), i), l_body, l_exit)
            else:
                branch(op(W, "cultl", i, end.at), l_body, l_exit)
            open_block(l_body)
            item = try fat_type("strview", VOID, tok.at)
            here := op(L, "add", addr, i)
            near := here
            if backward:
                near = op(L, "sub", here, int_arg(1))
            sized := alloc(t)
            l_one := label()
            l_wide := label()
            l_piece := label()
            branch(op(W, "cultw", op1(W, "loadub", near), int_arg(0x80)), l_one, l_wide)
            open_block(l_one)
            store(t, Value{type = t, at = int_arg(1)}, sized)
            jump(l_piece)
            open_block(l_wide)
            trail := Arg{}
            lead := here
            if backward:
                trail = continued(near, -1, int_arg(3), op(L, "sub", i, int_arg(1)))
                lead = op(L, "sub", near, trail)
            first := op1(W, "loadub", lead)
            w := int_arg(1)
            for edge in [0xc2, 0xe0, 0xf0]:
                w = op(W, "add", w, op(W, "cugew", first, int_arg(i64(edge))))
            w = op1(L, "extuw", op(W, "sub", w, op(W, "mul", op(W, "cugew", first, int_arg(0xf5)), int_arg(3))))
            if not backward:
                trail = continued(op(L, "add", here, int_arg(1)), 1, op(L, "sub", w, int_arg(1)), op(L, "sub", op(L, "sub", end.at, i), int_arg(1)))
            second := op1(W, "loadub", op(L, "add", lead, op1(L, "extuw", op(W, "cnel", trail, int_arg(0)))))
            # the second byte goes from 80 to bf, E0 and F0 raise the floor, ED and F4 lower the top
            low := op(W, "add", int_arg(0x80), op(W, "add", op(W, "mul", op(W, "ceqw", first, int_arg(0xe0)), int_arg(0x20)), op(W, "mul", op(W, "ceqw", first, int_arg(0xf0)), int_arg(0x10))))
            high := op(W, "sub", int_arg(0xbf), op(W, "add", op(W, "mul", op(W, "ceqw", first, int_arg(0xed)), int_arg(0x20)), op(W, "mul", op(W, "ceqw", first, int_arg(0xf4)), int_arg(0x30))))
            inside := op(W, "and", op(W, "cugew", second, low), op(W, "culew", second, high))
            whole := op1(L, "extuw", op(W, "and", op(W, "ceql", w, op(L, "add", trail, int_arg(1))), inside))
            store(t, Value{type = t, at = op(L, "add", int_arg(1), op(L, "mul", whole, trail))}, sized)
            jump(l_piece)
            open_block(l_piece)
            size := load(Value{type = t, at = sized, mem = true}).at
            next := op(L, "add", i, size)
            if backward:
                next = op(L, "sub", i, size)
                here = op(L, "add", addr, next)
            store(t, Value{type = t, at = next}, slot)
            place = alloc(item, true)
            add(Ins{op = "storel", a = here, b = place})
            field := field_of(item, "len")
            store(field.type, Value{type = field.type, at = size}, offset(place, field.n))
        else:
            args: &list[Value] = heap([])
            append(args, Value{type = pointer(walker.type), at = slot})
            got := try invoke("operator next", args, tok.at)
            rest: &list[i64] = heap([])
            for m in members(got.type):
                if m != ITERATIONEND:
                    append(rest, m)
            if comp.types[got.type].kind != Union or rest.len == members(got.type).len:
                return fail("operator next over " + comp.types[walker.type].name + " expects to return an element or IterationEnd, it returns " + comp.types[got.type].name, tok.at)
            item = try union_of(rest, Union, tok.at)
            branch(op(W, "ceqw", tag(got), tag_of(ITERATIONEND)), l_exit, l_body)
            open_block(l_body)
            place = payload(got.at, item)
            if starts_with(comp.types[walked.type].name, "&map["): # its elements stay in it, where those of a Channel leave
                every = true
                rounds = round(place, item, l_body, false)
        named := code_of(subject)
        fixed := tok.text + " is a copy that next gives, assigning it does not change " + named + ": copy it to a variable to change it"
        if chars:
            fixed = tok.text + " is a piece of the text, not a place in it: build the new text in a &str"
        elif field_of(item, "key").type != VOID and starts_with(comp.types[walked.type].name, "&map["):
            fixed = tok.text + " is a copy that next gives, assigning it does not change " + named + ": write " + named + "[" + tok.text + ".key] = v"
        mention(tok.text, place, item, node.tok)
        append(comp.vars, Local{tok.text, item, place, comp.loops.len, node.tok, 0, view(heap(fixed)), 0, true, false})
        append(comp.loops, Loop{l_exit, l_head, comp.defers.len, round, 0, 0, false})
    try statements(node_end(subject))
    if range: # a walk by index when the body reads x[i], for -memory
        ends := node_end(subject + 1)
        whole := not inclusive and comp.nodes[ends].kind == Field and text(ends) == "len" # 0..x.len, or 0..n over an array of n
        for i in comp.body[opened:]:
            if i.op == "add" and i.first == l_body:
                rounds = true
                whole = whole or i.count != 0 and end.lit and u64(i.count) == end.n + u64(inclusive)
        every = start.lit and start.n == 0 and whole
        if rounds:
            insert(comp.body, opened, Ins{op = "round", b = int_arg(i64(l_body)), pos = comp.at, ghost = true})
    comp.at = tok.at
    if range or elem != VOID:
        jump(l_step)
        open_block(l_step)
        current := load(Value{type = t, at = slot, mem = true}).at
        step: &strview = "add"
        if backward:
            step = "sub"
        store(t, Value{type = t, at = op(cls(t), step, current, int_arg(1))}, slot)
        branch(op(W, cmp_name("cne", t), current, stop), l_body, l_exit)
    else:
        jump(l_head)
    close_scope(round)
    every = every and not comp.loops[-1].broke
    comp.loops.len -= 1
    try forget(before)
    open_block(l_exit)
    if rounds:
        add(Ins{op = "walked", b = int_arg(i64(l_body)), c = int_arg(i64(every)), ghost = true})
    return null

# for -memory, the element of t at place is one of its own in this round of the walk l_body, when it holds a pointer or it is in place, inside
func round(place: Arg, t: i64, l_body: u32, inside: bool) -> bool:
    if not holds_pointer(t) and not inside:
        return false
    to: u32 = 0
    if inside:
        to = u32(place.n)
    add(Ins{op = "round", to = to, a = place, b = int_arg(i64(l_body)), c = int_arg(comp.types[t].size), shape = t, copy = true, ghost = true})
    return true

func counting(name: &strview) -> &strview:
    return view(heap(name + " counts this loop, so it cannot be assigned: copy it to a variable to change it"))

func cases(n: i64) -> Fail?:
    tok := comp.tokens[comp.nodes[n].tok]
    subject := try value(n + 1, VOID)
    if not aggregate(subject.type):
        subject = load(subject)
    whole := comp.types[subject.type]
    union := whole.kind == Union
    all := members(subject.type)
    defer free(all)
    left := members(subject.type)
    owner: &list[u32] = heap([]) # over a union, the body of each member a case names
    defer free(owner)
    for m in all:
        append(owner, u32(0))
    bodies := comp.body.len
    l_end := label()
    fallback := 0
    l_fallback: u32 = 0
    before := comp.vars.len
    given := comp.given.len
    ends: &list[Local] = heap([])
    lives := 0
    truths := 0
    c := node_end(n + 1)
    while c < node_end(n):
        at := comp.tokens[comp.nodes[c].tok].at
        comp.at = at
        comp.pos = comp.nodes[c].tok + 1
        if fallback != 0 and peek(":"):
            return fail("a switch has one default case, this is a second one", at)
        if fallback != 0:
            return fail("the default case goes last in a switch", comp.tokens[comp.nodes[fallback].tok].at)
        l_body := label()
        l_next := label()
        handled: &list[i64] = heap([])
        last := peek(":")
        if last:
            if union and left.len == 0:
                return fail("this default case never runs, the cases above handle every type of " + whole.name, at)
            fallback = c
            l_fallback = l_body
            handled = left
            if not union:
                jump(l_body)
        while not last:
            first := here()
            l := comp.nodes.len
            if union:
                local := first.kind == Name and lookup(first.text) != 0
                typed := not local and (first.kind == Name or first.kind == Generic or peek("*") or peek("&") or peek("("))
                if typed:
                    try type_expr()
                else:
                    try expr(1)
                last = not peek(",")
                if local:
                    return fail(first.text + " is a variable, and a case over " + whole.name + " names one of its types: compare the values with == in an if", first.at)
                if not typed or last and not peek(":"):
                    return fail("a case over " + whole.name + " names one of its types, and this is a value: name the type and compare the value inside its case", first.at)
                for m in members(try resolve(l)):
                    if not contains(all, m):
                        return fail(whole.name + " can never be " + comp.types[m].name + ", so this case never runs", first.at)
                    if not contains(left, m):
                        return fail("this switch already handles " + comp.types[m].name + " above, each type goes in one case", first.at)
                    append(handled, m)
                    remove(left, trust find(left, m))
            else:
                typed := peek("*") or peek("&")
                if not typed:
                    try expr(1)
                    head := l
                    while comp.nodes[head].kind == Field or comp.nodes[head].kind == Index:
                        head += 1
                    typed = comp.nodes[head].kind == Name and local_of(head) == 0 and (comp.type_ids[text(head)] is i64 or try find_type(text(head), comp.nodes[head].module, first.at) != 0)
                if typed:
                    return fail("a case names a type only in a switch over a tagged union, and " + whole.name + " is not one", first.at)
                last = not peek(",")
                if last and not peek(":"):
                    return expect(":")
                eq: Value
                if comp.nodes[l].kind == Binary and (text(l) == ".." or text(l) == "..="):
                    below: &strview = "<"
                    if text(l) == "..=":
                        below = "<="
                    low := try binary(">=", subject, try value(l + 1, VOID), first.at)
                    high := try binary(below, subject, try value(node_end(l + 1), VOID), first.at)
                    eq = Value{type = BOOL, at = op(W, "and", load(low).at, load(high).at)}
                else:
                    label := try value(l, subject.type)
                    if label.lit and subject.type == BOOL:
                        truths = truths or i64(1) << label.n
                    eq = try binary("==", subject, label, first.at)
                if eq.type != BOOL:
                    return fail("a case label compares with ==, and == over these answers " + comp.types[eq.type].name, first.at)
                l_more := l_next
                if not last:
                    l_more = label()
                branch(load(eq).at, l_body, l_more)
                if not last:
                    open_block(l_more)
            comp.nodes.len = l
            comp.pos += 1
        if union and fallback != c:
            for m in handled:
                k := trust find(all, m)
                owner[k] = l_body
        open_block(l_body)
        if union and local_of(n + 1) != 0:
            try confine(n + 1, handled, at_of(c))
        try statements(c + 1)
        regive(given, before, false)
        if try keep(before, before, ends):
            lives += 1
            jump(l_end)
        if not union:
            open_block(l_next)
        c = node_end(c)
    if union and fallback == 0 and left.len > 0:
        return fail("this switch never handles " + comp.types[try union_of(left, Union, tok.at)].name + " and has no default case", tok.at)
    regive(given, before, true)
    if union:
        middle := comp.body.len
        comp.at = tok.at
        named: &list[u64] = heap([]) # the tag of each member a case names, with its place in all below it
        defer free(named)
        for k in 0..all.len:
            if owner[k] != 0:
                append(named, u64(tag_of(all[k]).n) << 32 or u64(k))
        sort(named)
        current := tag(subject)
        ranges: &list[i64] = heap([])
        defer free(ranges)
        heads: &list[u32] = heap([])
        defer free(heads)
        low := 0
        high := named.len
        while true:
            if high - low > 8: # a short run is tested in order: one mispredicted jump, where each halving costs half of one
                half := (low + high) / 2
                l_low := label()
                l_high := label()
                branch(op(W, "cultw", current, int_arg(i64(named[half] >> 32))), l_low, l_high)
                append(ranges, half)
                append(ranges, high)
                append(heads, l_high)
                high = half
                open_block(l_low)
                continue
            for x in named[low:high]:
                k := i64(x and 0xffff_ffff)
                l_other := label()
                branch(op(W, "ceqw", current, int_arg(i64(x >> 32))), owner[k], l_other)
                open_block(l_other)
            if fallback != 0:
                jump(l_fallback)
            else:
                terminate("hlt", Arg{})
            if heads.len == 0:
                break
            open_block(trust pop(heads))
            high = trust pop(ranges)
            low = trust pop(ranges)
        postpone(bodies, middle) # the search goes before the bodies
    elif fallback != 0 or truths == 3:
        terminate("hlt", Arg{})
    else:
        lives += 1
        jump(l_end)
    if lives > 0:
        open_block(l_end)
        try join(ends, lives, tok.at)
    return null

func called(n: i64, want: i64, threaded: bool) -> Value|Fail:
    node := comp.nodes[n]
    tok := comp.tokens[node.tok]
    none: Value
    callee := none
    first := n + 1
    typed := node.size > 1 and comp.nodes[n + 1].kind == TName and comp.nodes[n + 1].tok == node.tok # simd[f32, 4](x), not make(T)
    if tok.text == "(" and comp.nodes[n + 1].kind == Index and comp.nodes[n + 2].kind == Name and lookup(text(n + 2)) == 0: # Box[i64](x), where no comma says that Box[i64] is a type
        typed = try find_type(text(n + 2), comp.nodes[n + 2].module, tok.at) != 0
    if typed:
        first = node_end(n + 1)
    elif tok.text == "(":
        callee = try value(n + 1, VOID)
        first = node_end(n + 1)
    elif node.module.len == 0 and lookup(tok.text) != 0:
        if func_in(comp.vars[lookup(tok.text) - 1].type) != VOID:
            callee = held(lookup(tok.text), tok.at)
    else:
        s := try named(tok.text, node.module, tok.at)
        if s != 0 and comp.nodes[comp.syms[s].node].kind == Constant:
            f := first_sym(tok.text)
            while f != 0 and not (comp.nodes[comp.syms[f].node].kind == Func and visible(f, node.module, tok.at)):
                f = comp.syms[f].next
            if f == 0:
                callee = try constant(s, VOID, tok.at)
    if callee.type != VOID:
        shape := comp.types[callee.type]
        count := kids(n) - i64(tok.text == "(")
        if shape.kind != Func:
            hint: &strview
            if func_in(callee.type) != VOID and callee.place:
                hint = ": copy it to a variable and narrow that with is first"
            if func_in(callee.type) != VOID and callee.place and lookup(tok.text) != 0:
                hint = ": narrow it with is first"
            return fail("only a function value can be called, this is " + shape.name + hint, tok.at)
        if count != shape.count:
            return fail("this " + shape.name + " expects " + counted(shape.count, "argument", "arguments") + " but got " + count, tok.at)
        code := load(callee).at
        if code.kind != Global:
            try panic_if(op(W, "ceql", code, int_arg(0)), "call of an empty function value", tok.at)
        given: &list[Value] = heap([])
        turns := comp.turns.len
        taken: &list[i64] = heap([])
        c := first
        while c < node_end(n):
            if comp.nodes[c].kind == Named:
                return fail("a function value has no parameter names, pass the arguments in order", at_of(c))
            to := comp.items[shape.first + given.len].type
            try read_in_turn(given, c, to)
            v := given[-1]
            if accepts(to, v) < 0 and not points_to(to, v.type):
                return fail("this " + shape.name + " expects " + comp.types[to].name + " here but got " + comp.types[v.type].name, at_of(c))
            append(taken, to)
            c = node_end(c)
        in_turn(given, turns, taken)
        passes: &list[Pass] = heap([])
        c = first
        for k, v in given:
            append(passes, try hand(v, taken[k], shape.foreign, at_of(c)))
            c = node_end(c)
        if threaded and shape.foreign:
            return fail("parallel cannot run " + shape.name + ", it is called the way C calls: wrap the call in a func", tok.at)
        if threaded:
            return spawn(code, passes, callee.type, none, tok.at)
        return emit(code, passes, shape.ret, shape.foreign, tok.at, callee.type)
    name := tok.text
    target := VOID
    values: &list[Value] = heap([])
    names: &list[&strview] = heap([])
    declared := false
    types_given := false
    f := first_sym(name)
    while f != 0:
        if callable(f, node.module, values, tok.at):
            declared = true
            types_given = types_given or takes_types(comp.syms[f].node)
        f = comp.syms[f].next
    if typed:
        target = try spelled_type(n + 1)
    else:
        if node.module.len == 0:
            id := comp.type_ids[name]
            if id is i64 and id <= BYTES:
                target = id
        if not declared and node.module.len == 0 and (name == "sizeof" or name == "offset_of" or name == "can_assign"):
            close := node.tok + 1
            while unclosed(node.tok + 1, close) > 0:
                close += 1
            return fail(name + " is a builtin of the compiler, write @" + excerpt(node.tok, close), tok.at)
        s := try find_type(name, node.module, tok.at)
        if s != 0 and not declared and (comp.nodes[comp.syms[s].node].kind == Alias or comp.nodes[comp.syms[s].node].kind == Struct) and not generic(comp.syms[s].node):
            target = try make_type(s, [], false, tok.at)
    conversion := kids(n) == 1 + i64(typed) and target != VOID
    if typed and not conversion:
        return fail(comp.types[target].name + "(...) converts one value", tok.at)
    if conversion or tok.kind == Builtin or node.module.len == 0 and (name == "ptr" or name == "print" or name == "eprint"):
        if threaded:
            return fail("parallel runs a function in a new thread, and " + name + " is not one: wrap it in a func", tok.at)
        c := n + 1
        while c < node_end(n):
            if comp.nodes[c].kind == Named:
                return fail(name + " is a builtin, its arguments cannot be named", at_of(c))
            c = node_end(c)
        if name == "@can_assign" and kids(n) != 2:
            return fail("@can_assign expects two types: @can_assign(&strview, $T)", tok.at)
        if name == "@can_assign":
            return truth(try assignable(try spelled_type(n + 1), try spelled_type(node_end(n + 1)), tok.at))
        if conversion:
            to := comp.types[target]
            wanted := target
            if numeric(target) or to.kind == Simd and comp.nodes[first].kind != Items:
                wanted = VOID # a number converts after, and each lane on its own
            given := try value(first, wanted)
            from := comp.types[given.type]
            many := from.kind == Simd or from.kind == Array
            native := numeric(given.type) or given.type == BOOL or many and to.kind == Simd # what converts as numbers, and not with an operator =
            if numeric(target) and native:
                return convert_number(given, target, tok.at)
            if numeric(target) and not try assignable(target, given.type, tok.at):
                return fail(to.name + "() converts numbers, " + from.name + " is not one, and no operator = makes " + to.name + " from it", tok.at)
            if to.kind == Simd and not native and not try assignable(target, given.type, tok.at):
                return fail(to.name + "() converts numbers, arrays and simd, " + from.name + " is none of them, and no operator = makes " + to.name + " from it", tok.at)
            if to.kind == Simd and native or from.kind == Simd and to.kind == Array:
                if many and from.count != to.count:
                    amount := counted(to.count, "lane", "lanes")
                    if to.kind == Array:
                        amount = counted(to.count, "element", "elements")
                    return fail(to.name + " has " + amount + " and " + from.name + " has " + from.count, tok.at)
                if lane_value(target) == BOOL and given.type != BOOL and lane_value(given.type) != BOOL:
                    return fail(to.name + "() does not convert, a mask comes from a comparison: v != 0", tok.at)
                return lanes("convert", ptr([given]), target, tok.at)
            if target == BOOL and given.type != BOOL:
                return fail("bool() does not convert, a number becomes a bool with a comparison: x != 0", tok.at)
            slot := alloc(target)
            try zero(target, slot)
            try assign(slot, target, given, at_of(first))
            return Value{type = target, at = slot, mem = true}
        if name == "print" or name == "eprint":
            file: &strview = "stdout"
            if name == "eprint":
                file = "stderr"
            to := try constant(try named(file, "", 0), VOID, tok.at) # the one core sees
            parts: &list[Value] = heap([])
            c = n + 1
            while c < node_end(n):
                v := load(try value(c, VOID))
                if v.mem and aggregate(v.type) and not v.lit:
                    slot := alloc(v.type)
                    store(v.type, v, slot)
                    v = Value{type = v.type, at = slot, mem = true}
                append(parts, v)
                c = node_end(c)
            line := Value{type = try fat_type("str", VOID, tok.at), at = load(try runtime("line", values, tok.at)).at, mem = true, place = true}
            append(values, to)
            field := field_of(line.type, "len")
            append(values, load(Value{type = field.type, at = offset(line.at, field.n), mem = true}))
            c = n + 1
            for part in parts:
                try put_text(line, part, at_of(c))
                c = node_end(c)
            try put_words(line, "\n", tok.at)
            try runtime("print_line", values, tok.at) # one line at a time, so two threads never mix theirs
            return none
        built := platform(name)
        if tok.kind == Builtin and name != "@argc" and name != "@argv" and name != "@here" and name != "@embed" and name != "@compile_error" and name != "@sizeof" and name != "@offset_of" and built is null:
            switch name:
            case "@get", "@set", "@add", "@swap", "@compare_swap", "@any", "@all", "@sum", "@min", "@max", "@abs", "@sqrt", "@select":
                close := node.tok + 1
                while unclosed(node.tok + 1, close) > 0:
                    close += 1
                return fail(name + " is not a builtin, it runs with the program and goes without @: " + excerpt(node.tok, close)[1:], tok.at)
            return fail("there is no builtin named " + name, tok.at)
        if name == "@compile_error":
            if kids(n) != 1 or comp.tokens[comp.nodes[n + 1].tok].kind != Str:
                return fail("@compile_error expects its message as text: @compile_error(\"this size is not supported\")", tok.at)
            i := comp.insts[comp.inst]
            if i.at != 0:
                return fail(unquoted(text(n + 1)), i.at)
            if i.export or i.taken_as != VOID: # main, an export or a test, which no call of Flag makes
                return fail(unquoted(text(n + 1)), tok.at)
            return none
        if name == "@embed":
            if kids(n) != 1 or comp.tokens[comp.nodes[n + 1].tok].kind != Str:
                return fail("@embed expects the path of the file as text, from the folder of this file: @embed(\"shader.spv\")", tok.at)
            file := view(comp.files[file_of(tok.at)].path)
            path := join_path(file[:file.len - base_name(file).len], unquoted(text(n + 1)))
            key: &str = heap("@")
            key += path
            id := comp.stored[view(key)] ifnull i64(comp.globals.len)
            if id == i64(comp.globals.len):
                size := file_size(path)
                if size is FsError:
                    return fail("" + size + ", and @embed reads the file when it compiles, with its path from the folder of this file", at_of(n + 1))
                pair: &str = heap("$flag.embed.")
                pair += id
                global(view(pair))
                put(comp.stored, view(key), id)
                label: &str = heap("flag.file.")
                label += id
                comp.data += read_only(true) + "data " + pair + " = { l $" + label + ", l " + size + " }\n"
                if comp.system == "linux":
                    comp.assembly += ".section .rodata\n"
                elif comp.system == "windows":
                    comp.assembly += ".section .rdata,\"dr\"\n"
                else:
                    comp.assembly += ".section __TEXT,__const\n"
                    label = "_" + label
                comp.assembly += ".p2align 3\n" + label + ":\n.incbin \"" + replace(replace(path, "\\", "\\\\"), "\"", "\\\"") + "\"\n.byte 0\n"
            return Value{type = try fat_type("strview", VOID, tok.at), at = Arg{Global, id}, mem = true, lit = true}
        if name == "@offset_of":
            if kids(n) != 2 or comp.nodes[kid(n, 1)].kind != Name:
                return fail("@offset_of expects a type and the name of one of its fields: @offset_of(Point, y)", tok.at)
            ty := comp.types[try spelled_type(n + 1)]
            for i in 0..ty.count:
                if (ty.kind == Struct or ty.kind == Fat) and comp.items[ty.first + i].name == text(kid(n, 1)):
                    return literal(false, u64(comp.items[ty.first + i].n))
            return fail(ty.name + " has no field " + text(kid(n, 1)), at_of(kid(n, 1)))
        one := name == "@sizeof" or name == "ptr"
        if not one and kids(n) != 0:
            return fail(name + " expects no arguments", tok.at)
        if one and kids(n) != 1:
            return fail(name + " expects one argument", tok.at)
        if built is bool:
            return truth(built)
        if name == "@here":
            site := tok.at
            if comp.site != 0:
                site = comp.site
            return place_of(site)
        if name == "@sizeof":
            return literal(false, u64(comp.types[try spelled_type(n + 1)].size))
        if name == "ptr":
            a := n + 1
            found := first_sym(text(a))
            if comp.nodes[a].kind == Name and lookup(text(a)) == 0 and try named(text(a), comp.nodes[a].module, tok.at) == 0:
                exported := found # the export of that name, beside functions of yours that give way
                while exported != 0 and not (comp.nodes[comp.syms[exported].node].kind == Func and visible(exported, comp.nodes[a].module, tok.at) and comp.syms[exported].export):
                    exported = comp.syms[exported].next
                while found != 0 and not (comp.nodes[comp.syms[found].node].kind == Func and visible(found, comp.nodes[a].module, tok.at)):
                    found = comp.syms[found].next
                if exported != 0:
                    found = exported
                if found != 0 and not comp.syms[found].export:
                    return fail("ptr of a function needs an export func, the address is for C: in Flag the name alone is the value, f := " + text(a), tok.at)
                if found != 0:
                    return Value{type = pointer(BYTES), at = global("$" + text(a))}
            pointee := want
            if comp.types[want].kind == Ptr:
                pointee = comp.types[want].elem
            assigned := comp.target
            comp.target = a # x[i] of a map gives its place, like the left of an assignment
            v := try value(a, pointee)
            comp.target = assigned
            return address(v)
        if name == "@argc":
            return Value{type = I32, at = op1(W, "loadw", global("$flag.argc"))}
        return Value{type = pointer(BYTES), at = op1(L, "loadl", global("$flag.argv"))}
    if empty_owner(n) and not threaded: # the compiler knows the empty owners, and writes them without the call
        k := comp.nodes[n + 1].kind
        wanted := comp.types[want].name
        if k == Items and starts_with(wanted, "&list[") or k == Pairs and starts_with(wanted, "&map[") or k == Literal and wanted == "&str":
            return in_heap(want) # the place gives it its type, so nothing converts it
        if k == Items:
            return in_heap(try fat_type("list", NEVER, tok.at))
        if k == Pairs:
            return in_heap(try core_type("map", ptr([Item{type = NEVER}, Item{type = NEVER}]), tok.at))
        return in_heap(try fat_type("str", VOID, tok.at))
    turns := comp.turns.len
    c := n + 1
    while c < node_end(n):
        label: &strview
        if names.len > 0 and names[-1] == "..":
            return fail("the view after .. is every extra argument of " + name + ", nothing goes after it", at_of(c))
        if comp.nodes[c].kind == Named:
            label = text(c)
            for other in names:
                if other == label:
                    return fail(name + " names " + label + " twice", at_of(c))
        elif comp.nodes[c].kind == Unary and text(c) == "..":
            label = ".."
        elif names.len > 0 and names[-1].len > 0:
            return fail(name + " expects every argument after a named one to be named too", at_of(c))
        append(names, label)
        arg := c + i64(label.len > 0)
        k := comp.nodes[arg].kind
        names_type := k == TName or k == TUnary or k == TUnion or k == TFunc or k == TTuple
        head := arg
        if k == Index:
            head += 1
        while comp.nodes[head].kind == Field:
            head += 1
        if comp.nodes[head].kind == Name and local_of(head) == 0: # Point, m.Point, Box[i32] or Car.motor, read as a value
            s := try find_type(text(head), comp.nodes[head].module, at_of(head))
            if s != 0:
                k = comp.nodes[comp.syms[s].node].kind
                names_type = k != Void and k != Context # those are values too, a void type is its one value
            else:
                id := comp.type_ids[text(head)]
                names_type = comp.nodes[head].module.len == 0 and (id is i64 and id > NULL and id <= BYTES or text(head) == "Thread")
        if names_type and types_given:
            append(values, Value{type = given_of(try spelled_type(arg))})
        else:
            passed := comp.passed
            comp.passed = arg
            try read_in_turn(values, arg, VOID)
            comp.passed = passed
        c = node_end(c)
    if name == "free" and node.module.len == 0 and values.len == 1:
        x := stacked(n + 1)
        chosen := comp.syms[try choose(name, "", values, names, tok.at)].node
        if x != 0 and chosen != 0 and (body(chosen) == 0 or comp.tokens[comp.nodes[kid(chosen, 0) + 2].tok].kind == Generic): # the free of C, or the one of core that gives it the pointer
            return fail("free cannot release " + code_of(x) + ", it is not on the heap", at_of(x))
    made := call(name, node.module, values, names, turns, tok.at, threaded)
    comp.turns.len = turns
    return made

# whether the program is built for the system or the processor that a builtin like @linux names, null for any other name
func platform(name: &strview) -> bool?:
    switch name:
    case "@linux", "@macos", "@windows", "@x86_64", "@arm64", "@riscv64":
        return name[1:] == comp.system or name[1:] == comp.machine
    return null

func operation(n: i64, want: i64) -> Value|Fail:
    node := comp.nodes[n]
    tok := comp.tokens[node.tok]
    none: Value
    if node.kind == Unary:
        o := tok.text
        if o == "parallel":
            return called(n + 1, VOID, true)
        if o == "..":
            return fail(".. goes before the last argument of a call to a func with ..items: T, where it gives the elements of a view as the extra arguments", tok.at)
        v := try value(n + 1, VOID)
        t := comp.types[v.type]
        if o == ".*":
            if t.kind == Fat:
                return Value{type = BYTES, at = op1(L, "loadl", v.at), mem = true, place = true}
            if t.kind != Ptr:
                return fail("only a pointer reads with .*, this is " + t.name, tok.at)
            if comp.target == n and (v.type == CSTR or v.type == WSTR): # assigned, or given to ptr
                return fail(code_of(n) + " cannot be written, " + t.name + " may point to a literal, which is read only: write through " + code_of(n + 1) + " as " + comp.types[pointer(t.elem)].name, tok.at)
            return Value{type = t.elem, at = load(v).at, mem = true, place = true}
        if o == "-" and v.lit and integer(v.type):
            if not v.neg and v.n > 1 << 63:
                return fail("-" + v.n + " does not fit in i64, the smallest i64 is -9223372036854775808", tok.at)
            return literal(not v.neg, v.n)
        if o == "-" and v.lit and t.kind == Float:
            return float_literal(-real(v))
        lane := comp.types[v.type]
        if t.kind == Simd:
            lane = comp.types[t.elem]
        if o == "-":
            if lane.kind != Int and lane.kind != Float:
                return fail("- expects a signed number or a float on its right, this is " + t.name, tok.at)
            if t.kind == Simd:
                return lanes("neg", ptr([v]), v.type, tok.at)
            x := load(v).at
            if x.kind == Const: # a typed constant stays one the compiler knows, wrapped at its width
                bits := i64(64 - 8 * t.size)
                return Value{type = v.type, at = int_arg((0 - x.n) << bits >> bits)}
            return Value{type = v.type, at = extend(v.type, op1(cls(v.type), "neg", x))}
        if o == "not":
            if t.kind == Simd and lane.kind != Float:
                return lanes("not", ptr([v]), v.type, tok.at)
            if t.kind == Simd:
                return fail("not works on lanes of integers and masks, and " + t.name + " holds floats: reinterpret it as bits with as simd[u" + 8 * lane.size + ", " + t.count + "]", tok.at)
            if v.type == BOOL and v.lit:
                return truth(v.n == 0)
            if v.type == BOOL:
                return Value{type = BOOL, at = op(W, "xor", load(v).at, int_arg(1))}
            if v.lit and integer(v.type) and v.neg:
                return literal(false, v.n - 1)
            if v.lit and integer(v.type):
                bits := literal(true, v.n + 1)
                bits.flipped = true
                return bits
            if integer(v.type):
                return Value{type = v.type, at = extend(v.type, op(cls(v.type), "xor", load(v).at, int_arg(-1)))}
            operand: &list[Value] = heap([])
            append(operand, v)
            if not try offers("not", operand, tok.at):
                return fail("not expects bool, an integer or a type with operator not on its right, this is " + t.name, tok.at)
            return invoke("not", operand, tok.at)
        if t.kind != Union:
            return fail(o + " expects a union on its right, " + t.name + " has nothing to remove", tok.at)
        removed: &list[i64] = heap([])
        rest: &list[i64] = heap([])
        for m in members(v.type):
            if comp.types[m].error:
                append(removed, m)
        for m in members(v.type):
            if o == "trust" and removed.len == 0 and m == NULL:
                append(removed, m)
            elif not contains(removed, m):
                append(rest, m)
        if removed.len == 0 and o == "try" and contains(members(v.type), NULL):
            return fail(t.name + " never fails, there is no error to try for: pass the null up with ifnull return null", tok.at)
        if removed.len == 0 and o == "try":
            return fail(t.name + " never fails, there is no error to try for", tok.at)
        if removed.len == 0:
            return fail(t.name + " holds no error and no null, there is nothing to trust away", tok.at)
        if rest.len == 0:
            return fail(t.name + " is nothing but errors, there is no value left", tok.at)
        kept := try union_of(rest, Union, tok.at)
        if o == "try":
            for e in removed:
                if comp.ret == VOID:
                    return fail("try passes " + comp.types[e].name + " up but this function returns nothing", tok.at)
                if not contains(members(comp.ret), e):
                    return fail("try passes " + comp.types[e].name + " up but this function returns " + comp.types[comp.ret].name, tok.at)
            failed := try union_of(removed, Union, tok.at)
            l_fail := label()
            l_ok := label()
            branch(tag_test(v, removed), l_fail, l_ok)
            open_block(l_fail)
            absent(v.at, v.type, removed)
            try leave(Value{type = failed, at = payload(v.at, failed), mem = true}, tok.at)
            open_block(l_ok)
            absent(v.at, v.type, rest)
        return Value{type = kept, at = payload(v.at, kept), mem = true, place = v.place, lit = v.lit and aggregate(kept)}
    o := tok.text
    left := n + 1
    right := node_end(left)
    if o == "is":
        return is_test(try value(left, VOID), n)
    if o == "as":
        v := try value(left, VOID)
        to := try resolve(right)
        dest := comp.types[to]
        if v.lit and integer(v.type): # the integer of the size of to, signed when it fits
            width := I8
            while width < I64 and comp.types[width].size < dest.size:
                width += 1
            if comp.types[width].size == dest.size:
                if not fits(v, width):
                    width += U8 - I8
                v = try convert(v, width, Arg{}, tok.at)
        from := comp.types[v.type]
        if untagged_member(to, v.type) or untagged_member(v.type, to):
            return convert(v, to, Arg{}, tok.at)
        if from.kind == Union and within(to, v.type):
            return Value{type = to, at = payload(v.at, to), mem = true, place = v.place, lit = v.lit and aggregate(to)}
        if from.kind == Union or dest.kind == Union:
            return fail("cannot reinterpret " + from.name + " as " + dest.name + ", a union is read only as one of its members or as a narrower union", tok.at)
        if from.size != dest.size:
            return fail("cannot reinterpret " + from.name + " as " + dest.name + ", they do not have the same byte size", tok.at)
        if aggregate(v.type):
            return Value{type = to, at = v.at, mem = true, place = v.place, lit = v.lit and aggregate(to)}
        if aggregate(to):
            slot := alloc(to)
            store(v.type, v, slot)
            return Value{type = to, at = slot, mem = true}
        x := load(v).at
        if (from.kind == Float) != (dest.kind == Float):
            return Value{type = to, at = op1(cls(to), "cast", x)}
        return Value{type = to, at = extend(to, x)}
    if o == ".." or o == "..=":
        return fail("a range goes in a for header or a case label, nothing else reads it", tok.at)
    if o == "+":
        return concat(n, none, comp.body.len)
    if o == "iferror" or o == "ifnull":
        chain: &list[i64] = heap([])
        c := n
        while comp.nodes[c].kind == Binary and (text(c) == "iferror" or text(c) == "ifnull"):
            append(chain, c)
            c += 1
        v := try value(c, want)
        for k in reverse chain:
            o = text(k)
            at := comp.tokens[comp.nodes[k].tok].at
            right = node_end(k + 1)
            if comp.types[v.type].kind != Union:
                return fail(o + " expects a union on its left, " + comp.types[v.type].name + " has nothing to replace", at)
            removed: &list[i64] = heap([])
            rest: &list[i64] = heap([])
            for m in members(v.type):
                if o == "iferror" and comp.types[m].error or o == "ifnull" and m == NULL:
                    append(removed, m)
                else:
                    append(rest, m)
            if removed.len == 0 and o == "iferror":
                return fail(comp.types[v.type].name + " never fails, there is no error for iferror to replace", at)
            if removed.len == 0:
                return fail(comp.types[v.type].name + " is never null, there is nothing for ifnull to replace", at)
            kept := try union_of(rest, Union, at)
            l_bad := label()
            l_good := label()
            l_done := label()
            branch(tag_test(v, removed), l_bad, l_good)
            open_block(l_bad)
            absent(v.at, v.type, removed)
            here := comp.at
            comp.at = at_of(right)
            other := try gen(right, kept)
            comp.at = here
            reads(right)
            if not comp.live:
                open_block(l_good)
                absent(v.at, v.type, rest)
                v = Value{type = kept, at = payload(v.at, kept), mem = true}
                continue
            if other.type == VOID and k != n:
                return fail("a function that returns nothing is a statement, not a value", at_of(right))
            if other.type == VOID:
                jump(l_good)
                open_block(l_good)
                return none
            result := try either(Value{type = kept}, other, at)
            slot := alloc(result)
            try zero(result, slot)
            try assign(slot, result, other, at_of(right))
            jump(l_done)
            open_block(l_good)
            absent(v.at, v.type, rest)
            try assign(slot, result, Value{type = kept, at = payload(v.at, kept), mem = true}, at)
            jump(l_done)
            open_block(l_done)
            v = Value{type = result, at = slot, mem = true}
        return v
    chain: &list[i64] = heap([])
    c := n
    while comp.nodes[c].kind == Binary:
        switch text(c):
        case "is", "as", "..", "..=", "+", "iferror", "ifnull":
            break
        case:
            append(chain, c)
            c += 1
    l := try value(c, VOID)
    i := chain.len
    while i > 0:
        i -= 1
        k := chain[i]
        o = text(k)
        if (o == "and" or o == "or") and l.type == BOOL and l.lit:
            if (l.n == 1) == (o == "and"): # a left side the compiler knows leaves the right one, or decides alone, like a if c else b
                l = try condition(node_end(k + 1))
        elif (o == "and" or o == "or") and l.type == BOOL:
            slot := alloc(BOOL)
            l_done := label()
            add(Ins{op = "storew", a = int_arg(i64(o == "or")), b = slot})
            before := comp.vars.len
            known := k + 1
            while true:
                l_right := label()
                if o == "and":
                    branch(load(l).at, l_right, l_done)
                else:
                    branch(load(l).at, l_done, l_right)
                open_block(l_right)
                try narrow(known, o == "and")
                known = node_end(k + 1)
                l = try gen(known, VOID)
                if comp.types[l.type].kind == Simd:
                    return fail("bool " + o + " " + comp.types[l.type].name + " stops at the bool when it decides, like a condition: write the mask first, m " + o + " b, so both sides run on every lane", at_of(known))
                l = try condition_of(l, known)
                if i == 0 or text(chain[i - 1]) != o:
                    break
                i -= 1
                k = chain[i]
            comp.vars.len = before
            add(Ins{op = "storew", a = l.at, b = slot})
            jump(l_done)
            open_block(l_done)
            l = Value{type = BOOL, at = op1(W, "loadw", slot)}
        else:
            right = node_end(k + 1)
            middle := comp.body.len
            calling := comp.calls
            r := try value(right, VOID)
            if comp.calls != calling:
                l = ahead(l, middle, comp.body.len)
            word := comp.nodes[k].tok
            sign := comp.nodes[right].tok
            if (o == "and" or o == "or" or o == "xor") and integer(l.type) and r.type == BOOL and comp.nodes[right].kind == Binary and unclosed(word + 1, sign - 1) == 0:
                switch text(right):
                case "==", "!=", "<", ">", "<=", ">=":
                    first := word
                    last := word
                    for j in k..node_end(k):
                        if comp.nodes[j].tok < first:
                            first = comp.nodes[j].tok
                        if comp.nodes[j].tok > last:
                            last = comp.nodes[j].tok
                    first += unclosed(first, word - 1) # the brackets around its left side
                    while unclosed(sign + 1, last) > 0 or unclosed(last + 1, last + 1) > 0: # f() has no node for its brackets
                        last += 1
                    return fail(o + " is looser than " + text(right) + ", so it mixes the bits of " + comp.types[l.type].name + " with a bool: write (" + excerpt(first, sign - 1) + ") " + excerpt(sign, last), comp.tokens[word].at)
            l = try binary(o, l, r, comp.tokens[word].at)
    return l

# the code from token first to token last, without the brackets around it that it leaves open
func spelled(first: i64, last: i64) -> &strview:
    while unclosed(first, last) > 0:
        first += 1
    while unclosed(first, last) < 0:
        last -= 1
    return excerpt(first, last)

func is_test(v: Value, n: i64) -> Value|Fail:
    left := n + 1
    at := comp.tokens[comp.nodes[n].tok].at
    wanted := try resolve(node_end(left))
    if comp.types[v.type].kind == Untagged:
        return fail(comp.types[v.type].name + " has no tag for is to test, read it with as", at)
    if comp.types[v.type].kind != Union:
        if local_of(left) != 0:
            if comp.types[comp.vars[declaration(text(left))].type].kind == Union:
                return fail(text(left) + " is already " + comp.types[v.type].name + " here, it was narrowed above and there is nothing left to test", at)
        return fail("is expects a union on its left, " + comp.types[v.type].name + " is a plain type", at)
    tags: &list[i64] = heap([])
    asked := members(wanted)
    for m in members(v.type):
        if contains(asked, m):
            append(tags, m)
    if tags.len == 0:
        return fail(comp.types[v.type].name + " can never be " + comp.types[wanted].name + ", so this is always false", at)
    if tags.len == members(v.type).len:
        return fail(comp.types[v.type].name + " is always " + comp.types[wanted].name + ", so this is always true", at)
    return Value{type = BOOL, at = tag_test(v, tags)}

func choice(n: i64, want: i64) -> Value|Fail:
    at := comp.tokens[comp.nodes[n].tok].at
    cond := node_end(n + 1)
    c := try condition(cond)
    if c.lit: # the compiler knows c, so the side it chose is all there is, like a where
        return value(n + 1 if c.n == 1 else node_end(cond), want)
    l_sides := array[u32, 2]{label(), label()}
    l_ends := array[u32, 2]{label(), label()}
    branch(c.at, l_sides[0], l_sides[1])
    sides: &list[Value] = heap([])
    for k, side in [n + 1, node_end(cond)]:
        open_block(l_sides[k])
        before := comp.vars.len
        try narrow(cond, k == 0)
        v := try gen(side, want)
        comp.vars.len = before
        if v.type == VOID:
            return fail("a function that returns nothing is a statement, not a value", at_of(side))
        reads(side)
        append(sides, v)
        jump(l_ends[k])
    a := sides[0]
    b := sides[1]
    if a.type == NEVER and b.type == NEVER:
        return a
    result := want
    if want == VOID:
        result = try either(a, b, at)
    slot := alloc(result)
    l_done := label()
    for k, side in [n + 1, node_end(cond)]:
        if sides[k].type != NEVER:
            open_block(l_ends[k])
            try zero(result, slot)
            try assign(slot, result, sides[k], at_of(side))
            jump(l_done)
    open_block(l_done)
    return Value{type = result, at = slot, mem = true}

# the type of a value that is a or b: the one that takes the other, or a union of both
func either(a: Value, b: Value, at: i64) -> i64|Fail:
    if a.type == NEVER or a.lit and b.type != NEVER and accepts(b.type, a) >= 0:
        return b.type
    if b.type == NEVER or accepts(a.type, b) >= 0:
        return a.type
    if accepts(b.type, a) >= 0:
        return b.type
    if try assignable(a.type, b.type, at):
        return a.type
    return union_of(ptr([a.type, b.type]), Union, at)

# each lane of to is the scalar o of the same lane of args, where a number stands in every lane
func lanes(o: &strview, args: &listview[Value], to: i64, at: i64) -> Value|Fail:
    slot := alloc(to)
    from := to
    in_register := comp.types[to].kind == Simd
    for a in args:
        k := comp.types[a.type].kind
        in_register = in_register and k != Array
        if k == Simd and from == to and o != "select":
            from = a.type
    raw := lane_type(from)
    ty := comp.types[raw]
    float := ty.kind == Float
    fits := false
    switch o:
    case "+", "-", "and", "or", "xor", "==", "!=", "<", "<=", ">", ">=", "not", "neg", "select", "min", "max":
        fits = true
    case "*", "abs":
        fits = float or ty.size == 2 or ty.size == 4
    case "/", "sqrt":
        fits = float
    case "<<":
        fits = ty.size > 1
    case ">>":
        fits = ty.size > 1 and (ty.kind == Uint or ty.size < 8)
    case "convert":
        fits = from == to or comp.types[from].elem == I32 and lane_type(to) == F32
    if vectors() and in_register and fits:
        scalars: &list[Arg] = heap([]) # what each argument that is not a simd gives every register: a number in each lane, or the amount of a shift
        for a in args:
            if comp.types[a.type].kind == Simd:
                append(scalars, Arg{})
            elif o == "<<" or o == ">>":
                amount := load(a).at
                most := i64(8 * comp.types[a.type].size) - 1 # as the scalar shift, which counts in 32 bits or 64
                if most < 31:
                    most = 31
                if amount.kind == Const:
                    amount = int_arg(amount.n and most)
                else:
                    amount = op(cls(a.type), "and", amount, int_arg(most))
                if cls(a.type) == L and amount.kind != Const:
                    amount = op1(W, "copy", amount)
                append(scalars, amount)
            else:
                x := a
                if o == "convert":
                    x = try convert_number(a, lane_value(to), at)
                b := load(x).at
                if raw != x.type:
                    b = mask_bits(b, raw)
                append(scalars, splat(raw, b))
        s := letter(raw)
        int_lane := I32
        if ty.size == 8:
            int_lane = I64
        sign := int_arg(i64(1) << i64(8 * ty.size - 1))
        for half in 0..comp.types[to].size / 16: # a simd of 32 bytes is two registers of 16
            parts: &list[Arg] = heap([])
            for k, a in args:
                if scalars[k].kind == Empty:
                    append(parts, op1(V, "loadv", offset(a.at, 16 * half)))
                else:
                    append(parts, scalars[k])
            x := parts[0]
            y := x
            if parts.len > 1:
                y = parts[1]
            picks_other := Arg{}
            other := y
            flip := false
            switch o:
            case "+":
                x = op(V, "vadd" + s, x, y)
            case "-":
                x = op(V, "vsub" + s, x, y)
            case "*":
                x = op(V, "vmul" + s, x, y)
            case "/":
                x = op(V, "vdiv" + s, x, y)
            case "and", "or", "xor":
                x = op(V, "v" + o, x, y)
            case "<<":
                x = op(V, "vshl" + s, x, y)
            case ">>":
                if ty.kind == Int:
                    x = op(V, "vsar" + s, x, y)
                else:
                    x = op(V, "vshr" + s, x, y)
            case "==", "!=":
                x = op(V, "vceq" + s, x, y)
                flip = o == "!="
            case "<":
                x = greater(y, x, raw)
            case ">":
                x = greater(x, y, raw)
            case "<=", ">=":
                if o == ">=":
                    other = x
                    x = y
                    y = other
                if float:
                    x = op(V, "vcle" + s, x, y)
                else:
                    x = greater(x, y, raw)
                    flip = true
            case "neg":
                if float:
                    x = op(V, "vxor", x, splat(int_lane, sign))
                else:
                    x = op(V, "vsub" + s, splat(raw, int_arg(0)), x)
            case "not":
                flip = true
            case "select":
                picks_other = x
                other = y
                x = parts[2]
            case "min":
                if float:
                    x = op(V, "vmin" + s, x, y)
                else:
                    picks_other = greater(x, y, raw)
            case "max":
                if float:
                    x = op(V, "vmax" + s, x, y)
                else:
                    picks_other = greater(y, x, raw)
            case "abs":
                if float:
                    x = op(V, "vand", x, splat(int_lane, int_arg(sign.n - 1)))
                else:
                    negative := op(V, "vsar" + s, x, int_arg(i64(8 * ty.size) - 1))
                    x = op(V, "vsub" + s, op(V, "vxor", x, negative), negative)
            case "sqrt":
                x = op1(V, "vsqrt" + s, x)
            case "convert":
                if raw != lane_type(to):
                    x = op1(V, "vitos", x)
            if picks_other.kind != Empty:
                x = op(V, "vxor", x, op(V, "vand", op(V, "vxor", other, x), picks_other))
            if flip:
                x = op(V, "vxor", x, splat(I32, int_arg(-1)))
            add(Ins{op = "storev", a = x, b = offset(slot, 16 * half)})
        return Value{type = to, at = slot, mem = true}
    given: &list[Value] = heap([])
    for a in args:
        k := comp.types[a.type].kind
        if k == Simd or k == Array:
            append(given, a)
        else:
            append(given, load(a))
    for i in 0..comp.types[to].count:
        parts: &list[Value] = heap([])
        for a in given:
            append(parts, lane(a, i))
        x := parts[0]
        t := comp.types[x.type]
        picks_other := Arg{}
        other := x
        switch o:
        case "neg":
            x = Value{type = x.type, at = extend(x.type, op1(cls(x.type), "neg", load(x).at))}
        case "not":
            ones := int_arg(-1)
            if x.type == BOOL:
                ones = int_arg(1)
            x = Value{type = x.type, at = extend(x.type, op(cls(x.type), "xor", load(x).at, ones))}
        case "select":
            picks_other = load(x).at
            other = parts[1]
            x = parts[2]
        case "min":
            picks_other = load(try binary("<", parts[1], x, at)).at
            other = parts[1]
        case "max":
            picks_other = load(try binary("<", x, parts[1], at)).at
            other = parts[1]
        case "abs":
            if t.kind == Float:
                how: u32 = L
                magnitude := int_arg(0x7fff_ffff_ffff_ffff)
                if t.size == 4:
                    how = W
                    magnitude = int_arg(0x7fff_ffff)
                x = Value{type = x.type, at = op1(cls(x.type), "cast", op(how, "and", op1(how, "cast", load(x).at), magnitude))}
            else:
                picks_other = load(try binary("<", x, literal(false, 0), at)).at
                other = try binary("-", literal(false, 0), x, at)
        case "sqrt":
            wide := load(x).at
            if t.size == 4:
                wide = op1(D, "exts", wide)
            if not contains(comp.libs, "m"):
                append(comp.libs, "m")
            passes: &list[Pass] = heap([])
            append(passes, Pass{D, wide, false, VOID})
            x = try emit(global("$sqrt"), passes, F64, true, at)
            if t.size == 4:
                x = Value{type = F32, at = op1(S, "truncd", x.at)}
        case "convert":
            x = try convert_number(x, lane_value(to), at)
        case:
            x = try binary(o, x, parts[1], at)
        try set_lane(slot, to, i, x, at)
        if picks_other.kind != Empty:
            l_take := label()
            l_done := label()
            branch(picks_other, l_take, l_done)
            open_block(l_take)
            try set_lane(slot, to, i, other, at)
            jump(l_done)
            open_block(l_done)
    return Value{type = to, at = slot, mem = true}

# amd64 and arm64 hold the lanes of a simd in one register, rv64 has none and does each lane
func vectors() -> bool:
    return comp.machine != "riscv64"

func letter(lane: i64) -> &strview:
    size := comp.types[lane].size
    if comp.types[lane].kind == Float and size == 4:
        return "s"
    if comp.types[lane].kind == Float:
        return "d"
    if size == 1:
        return "b"
    if size == 2:
        return "h"
    if size == 4:
        return "w"
    return "l"

func splat(lane: i64, x: Arg) -> Arg:
    return op1(V, "vsplat" + letter(lane), x)

# all ones in the lanes where x is greater than y
func greater(x: Arg, y: Arg, lane: i64) -> Arg:
    ty := comp.types[lane]
    if ty.kind == Float:
        return op(V, "vclt" + letter(lane), y, x)
    if ty.kind == Uint:
        bias := splat(lane, int_arg(i64(1) << i64(8 * ty.size - 1))) # the order of signed numbers
        x = op(V, "vxor", x, bias)
        y = op(V, "vxor", y, bias)
    return op(V, "vcgt" + letter(lane), x, y)

# lane i of a simd or an array, a mask gives it as a bool, a number is the same in every lane
func holds_lanes(t: i64) -> bool:
    ty := comp.types[t]
    return ty.kind == Simd or ty.kind == Array and holds_lanes(ty.elem)

func lane(v: Value, i: i64) -> Value:
    k := comp.types[v.type].kind
    if k != Simd and k != Array:
        return v
    raw := lane_type(v.type)
    x := Value{type = raw, at = offset(v.at, i * comp.types[raw].size), mem = true, place = v.place}
    if raw != comp.types[v.type].elem:
        return Value{type = BOOL, at = op(W, cmp_name("cne", raw), load(x).at, int_arg(0))}
    return x

# a bool as a lane of a mask, that keeps true as all ones
func mask_bits(b: Arg, raw: i64) -> Arg:
    if cls(raw) == L:
        return op1(L, "neg", op1(L, "extuw", b))
    return op1(cls(raw), "neg", b)

func set_lane(slot: Arg, t: i64, i: i64, x: Value, at: i64) -> Fail?:
    v := try convert(x, lane_value(t), Arg{}, at)
    raw := lane_type(t)
    if raw != v.type:
        v = Value{type = raw, at = mask_bits(load(v).at, raw)}
    store(raw, v, offset(slot, i * comp.types[raw].size))
    return null

func indexed(n: i64, assignment: i64) -> Value|Fail:
    tok := comp.tokens[comp.nodes[n].tok]
    none: Value
    if assignment != 0 and kids(n) == 3: # values[i:i + 4] = v puts the lanes of a simd there
        first := comp.body.len
        slice := try indexed(n, 0)
        middle := comp.body.len
        v: Value
        if text(assignment) == "=":
            v = ahead(try value(node_end(n), VOID), first, middle)
        if comp.types[v.type].kind != Simd or not sequence(slice.type):
            return fail("a slice is a view, it cannot be assigned: assign its elements one by one", tok.at)
        lanes := comp.types[v.type]
        if lanes.elem != element(slice.type):
            return fail(lanes.name + " goes into a slice of its lanes, and this one holds " + comp.types[element(slice.type)].name, tok.at)
        field := field_of(slice.type, "len")
        length := load(Value{type = field.type, at = offset(slice.at, field.n), mem = true})
        l_bad := label()
        l_good := label()
        branch(op(W, cmp_name("cne", field.type), length.at, int_arg(lanes.count)), l_bad, l_good)
        open_block(l_bad)
        args: &list[Value] = heap([])
        append(args, try in_heap(try fat_type("str", VOID, tok.at)))
        try put_words(args[0], "a simd of " + lanes.count + " lanes goes into a slice of " + lanes.count + ", this one has ", tok.at)
        try put_text(args[0], length, tok.at)
        append(args, try place_of(tok.at))
        try runtime("panic", args, tok.at)
        open_block(l_good)
        blit(v.at, op1(L, "loadl", slice.at), v.type)
        return none
    passing := comp.passed == n
    first := comp.body.len
    base := try value(n + 1, VOID)
    if comp.types[base.type].kind == Ptr and comp.types[comp.types[base.type].elem].kind == Fat:
        base = Value{type = comp.types[base.type].elem, at = load(base).at, mem = true, place = true}
    index := literal(false, 0)
    if comp.nodes[kid(n, 1)].kind != Block:
        index = try value(kid(n, 1), VOID)
    t := base.type
    addr := base.at
    if comp.types[t].kind == Ptr and (comp.types[comp.types[t].elem].kind == Array or comp.types[comp.types[t].elem].kind == Simd):
        addr = load(base).at
        t = comp.types[t].elem
        base.place = true
    spot := none
    array := comp.types[t].kind == Array
    ty := comp.types[t]
    if ty.kind == Simd:
        if kids(n) == 3 or not index.lit or not integer(index.type):
            return fail("a lane of a simd is chosen with a constant, for a variable one convert it to an array", at_of(kid(n, 1)))
        if index.neg or index.n >= ty.count:
            sign: &strview
            if index.neg:
                sign = "-"
            return fail(ty.name + " has " + counted(ty.count, "lane", "lanes") + ", there is no lane " + sign + index.n, at_of(kid(n, 1)))
        spot = lane(Value{type = t, at = addr, mem = true, place = base.place}, i64(index.n))
        if lane_value(t) == BOOL and passing:
            append(comp.elements, Value{type = t, at = addr, mem = true})
            append(comp.elements, index)
            spot.element = comp.elements.len # a lane of a mask is made from its bits, a call that takes it by pointer would change a copy
    elif (array or (sequence(t) or textual(t)) and integer(index.type)) and kids(n) == 2:
        if not integer(index.type):
            return fail("an array index expects an integer, this one is " + comp.types[index.type].name, at_of(kid(n, 1)))
        elem := comp.types[t].elem
        length := literal(false, u64(comp.types[t].count))
        if not array:
            elem = element(t)
            field := field_of(t, "len")
            length = load(Value{type = field.type, at = offset(addr, field.n), mem = true})
            addr = op1(L, "loadl", addr)
        wide := U64
        if comp.types[index.type].kind == Int:
            wide = I64
        raw := load(try convert_number(index, wide, tok.at)).at
        i := raw
        back := from_end(index)
        if back:
            i = op(L, "add", length.at, raw)
        limit: u64 = 0
        if local_of(kid(n, 1)) != 0:
            limit = comp.vars[local_of(kid(n, 1)) - 1].limit
        known := array and limit != 0 and limit <= comp.types[t].count
        if array and index.at.kind == Const:
            place := index.at.n + i64(back) * i64(comp.types[t].count)
            known = place >= 0 and place < i64(comp.types[t].count)
        if not known:
            l_out := label()
            l_in := label()
            branch(op(W, "cultl", i, length.at), l_in, l_out)
            open_block(l_out)
            bounds: &list[Value] = heap([])
            append(bounds, Value{type = wide, at = raw})
            append(bounds, length)
            append(bounds, try place_of(tok.at))
            try runtime("out_of_bounds", bounds, tok.at)
            open_block(l_in)
        scaled := times(i, comp.types[elem].size)
        count: u32 = 0
        if array and comp.types[t].count <= 0xffff_ffff:
            count = u32(comp.types[t].count) # -memory keeps the elements of an array apart from what follows it
        walk: u32 = 0 # x[i] of a list or an array, with the i that counts a walk, is its element of the round, for -memory
        if local_of(kid(n, 1)) != 0 and (array or owner(t)):
            for l in comp.loops:
                if l.counter == local_of(kid(n, 1)):
                    walk = l.walk
        spot = Value{type = elem, at = add(Ins{op = "add", cls = L, to = u32(temp().n), a = addr, b = scaled, count = count, first = walk, shape = elem, copy = walk != 0}), mem = true, place = base.place or not array, lit = base.lit and aggregate(elem)}
        if ty.name == "&strview" and assignment != 0:
            return fail(VIEW, at_of(n + 1))
        if ty.name == "&strview" and passing:
            append(comp.elements, base)
            append(comp.elements, index)
            spot.element = comp.elements.len # a call that takes it by pointer would write the text
    else:
        args: &list[Value] = heap([])
        if array:
            whole := address(Value{type = t, at = addr, mem = true, place = base.place, lit = base.lit})
            if kids(n) == 3:
                whole = try convert(whole, try fat_type("listview", comp.types[t].elem, tok.at), Arg{}, tok.at)
            append(args, whole)
        else:
            append(args, base)
        if kids(n) == 3:
            ends := [index, none]
            if comp.nodes[kid(n, 2)].kind != Block:
                ends[1] = try value(kid(n, 2), VOID)
            own := not array and not sequence(t) and not textual(t) # a type of yours, its slice gets a negative end as written
            if ends[1].type == VOID or not own and (from_end(ends[0]) or from_end(ends[1])):
                length := literal(false, u64(comp.types[t].count))
                if not array:
                    holder := t
                    place := addr
                    if comp.types[holder].kind == Ptr:
                        place = load(base).at
                        holder = comp.types[holder].elem
                    field := field_of(holder, "len")
                    if field.type == VOID:
                        return fail("this slice has no end, so it ends at the len of " + comp.types[holder].name + ", and it has no field len: write the end", tok.at)
                    length = load(Value{type = field.type, at = offset(place, field.n), mem = true})
                if ends[1].type == VOID:
                    ends[1] = length
                signed := false
                for k, e in ends:
                    if not own and from_end(e):
                        wide := load(try convert_number(length, I64, tok.at)).at
                        counted := op(L, "add", wide, e.at)
                        ends[k] = Value{type = I64, at = op(L, "sub", counted, op(L, "and", wide, op(L, "sar", counted, int_arg(63))))} # before the start it stays as written, for the message
                    signed = signed or comp.types[ends[k].type].kind == Int and (not ends[k].lit or ends[k].neg)
                for k, e in ends:
                    if signed and integer(e.type) and not e.lit:
                        ends[k] = try convert_number(e, I64, tok.at)
            append(args, ends[:])
            return invoke("[:]", args, tok.at)
        append(args, index)
        read := try returned("[]", args, tok.at)
        under := comp.target
        while under < n and (comp.nodes[under].kind == Field or comp.nodes[under].kind == Index):
            under += 1
        placing := assignment == 0 and under == n
        if placing and comp.nodes[comp.target - 1].kind != Assign and read != VOID: # ptr(x[i]) points at the element when operator []=(x, i) gives its place, and else at a copy
            placing = comp.types[try returned("[]=", args, tok.at)].kind == Ptr
        if (assignment != 0 or placing) and read != VOID and comp.types[read].kind != Ptr:
            kept := try present(read, tok.at)
            place := try returned("[]=", args, tok.at)
            if assignment != 0 and text(assignment) == "=": # the value first, then the place that operator []=(x, i) gives, or operator []=(x, i, v)
                middle := comp.body.len
                if points_to(place, kept) or points_to(place, read):
                    target := comp.types[place].elem
                    v := ahead(try value(node_end(n), target), first, middle)
                    try assign(load(try invoke("[]=", args, tok.at)).at, target, v, at_of(node_end(n)))
                    return none
                append(args, ahead(try value(node_end(n), read), first, middle))
                return invoke("[]=", args, tok.at)
            if points_to(place, kept):
                spot = Value{type = kept, at = load(try invoke("[]=", args, tok.at)).at, mem = true, place = true}
            elif placing:
                return fail(comp.types[t].name + " gives a copy of its element and has no operator []=(x, i) that gives its place, so assigning a field of it would only change the copy: change a copy of the element and put it back", tok.at)
            else:
                spot = try filled(try invoke("[]", args, tok.at), kept)
                try update(spot, assignment, first)
                if points_to(place, read): # a place that holds what x[i] gives, null too, takes the new value
                    try assign(load(try invoke("[]=", args, tok.at)).at, read, spot, tok.at)
                    return none
                append(args, spot)
                return invoke("[]=", args, tok.at)
        else:
            p := try invoke("[]", args, tok.at)
            if comp.types[p.type].kind != Ptr and passing:
                key := load(args[1])
                if key.mem:
                    key = Value{type = key.type, at = alloc(key.type), mem = true}
                    store(key.type, load(args[1]), key.at)
                append(comp.elements, args[0])
                append(comp.elements, key)
                p.element = comp.elements.len # a call that takes it by pointer puts it back in x[i]
            elif comp.types[p.type].kind != Ptr:
                p.element = -1 # a field of it is of a copy that a call cannot put back
            if comp.types[p.type].kind != Ptr:
                return p
            spot = Value{type = comp.types[p.type].elem, at = load(p).at, mem = true, place = true}
    if assignment == 0:
        return spot
    mask := ty.kind == Simd and lane_value(t) == BOOL
    if not spot.place and not (mask and base.place):
        return fail("this element belongs to a value that is not a variable, assigning it would only change a copy", at_of(n + 1))
    if mask:
        middle := comp.body.len
        b := ahead(try value(node_end(n), BOOL), first, middle)
        if text(assignment) != "=":
            b = try binary(text(assignment)[:1], spot, b, comp.tokens[comp.nodes[assignment].tok].at)
        try set_lane(addr, t, i64(index.n), b, at_of(node_end(n)))
    else:
        try update(spot, assignment, first)
    return none

func present(t: i64, at: i64) -> i64|Fail:
    rest: &list[i64] = heap([])
    for m in members(t):
        if m != NULL:
            append(rest, m)
    return union_of(rest, Union, at)

func filled(v: Value, kept: i64) -> Value|Fail:
    spot := Value{type = kept, at = alloc(kept), mem = true, place = true}
    try zero(kept, spot.at)
    if not contains(members(v.type), NULL):
        store(kept, v, spot.at)
        return spot
    l_some := label()
    l_done := label()
    branch(op(W, "cnew", tag(v), tag_of(NULL)), l_some, l_done)
    open_block(l_some)
    store(kept, Value{type = kept, at = payload(v.at, kept), mem = true}, spot.at)
    jump(l_done)
    open_block(l_done)
    return spot

func update(spot: Value, n: i64, first: i64) -> Fail?:
    o := text(n)
    left := n + 1
    right := node_end(left)
    middle := comp.body.len
    sign := comp.tokens[comp.nodes[n].tok].at
    if comp.types[spot.type].kind == Atomic:
        return fail(comp.types[spot.type].name + ATOMIC, sign)
    if o == "+=" and comp.types[spot.type].name == "&str":
        try concat(right, spot, first)
        return null
    if o == "+=" and comp.types[spot.type].name == "&strview":
        line := try in_heap(try fat_type("str", VOID, sign))
        try put_text(line, load(spot), sign)
        try concat(right, line, first)
        args: &list[Value] = heap([])
        append(args, line)
        joined := try invoke("tmp", args, sign)
        try invoke("free", args, sign)
        return assign(spot.at, spot.type, joined, sign)
    at := at_of(right)
    wanted := VOID
    if o == "=":
        wanted = spot.type
    v := ahead(try value(right, wanted), first, middle)
    if o != "=":
        at = sign
        v = try binary(o[:1], load(spot), v, at)
    place := spot
    given := true
    d := 0
    if local_of(left) != 0:
        d = declaration(text(left))
        decl := comp.vars[d]
        given = decl.given
        outside := decl
        for l in comp.vars:
            if l.name == decl.name and l.depth < comp.loops.len and (comp.loops.len > comp.leaving or l.depth < comp.staying):
                outside = l
        if accepts(outside.type, v) < 0 and accepts(decl.type, v) >= 0:
            return fail(decl.name + " cannot take " + comp.types[v.type].name + " inside this loop, it was narrowed to " + comp.types[outside.type].name + " outside the loop and the loop reads it that way every round", sign)
        if accepts(spot.type, v) < 0 and accepts(outside.type, v) >= 0:
            append(comp.vars, Local{decl.name, outside.type, outside.addr, comp.loops.len, decl.tok, 0, outside.fixed, 0, true, outside.inside})
            place = Value{type = outside.type, at = outside.addr}
    try assign(place.at, place.type, v, at, given)
    if not given:
        comp.vars[d].given = true
        append(comp.given, d)
    return null

# the code from first to middle goes after the code that follows it
func postpone(first: i64, middle: i64):
    last := comp.body.len
    if middle == last:
        return
    for i in first..middle:
        append(comp.body, comp.body[i])
    for i in middle..comp.body.len:
        comp.body[first + i - middle] = comp.body[i]
    comp.body.len = last

# v, read before the code from first to middle, which goes after it: when that code calls something, v keeps what it read
func ahead(v: Value, first: i64, middle: i64) -> Value:
    if calls(first, middle):
        v = now(v)
    postpone(first, middle)
    return v

# the value of n as the next of values: when its code calls something, the values before it keep what they read from where that code starts, which in_turn does
func read_in_turn(values: *&list[Value], n: i64, want: i64) -> Fail?:
    start := comp.body.len
    calling := comp.calls
    append(values, try value(n, want))
    if comp.calls != calling and values.len > 1:
        append(comp.turns, values.len - 1)
        append(comp.turns, start)
    return null

# each value read before code that calls something, the turns from turns on, keeps what it read, ahead of that code, unless it goes where a pointer to it goes
func in_turn(values: &listview[Value], turns: i64, to: &listview[i64] = []):
    t := comp.turns.len
    while t > turns:
        t -= 2
        first := 0
        if t > turns:
            first = comp.turns[t - 2]
        end := comp.body.len
        for i in first..comp.turns[t]:
            if not (i < to.len and points_to(to[i], values[i].type)):
                values[i] = now(values[i])
        postpone(comp.turns[t + 1], end)
    comp.turns.len = turns

func calls(first: i64, last: i64) -> bool:
    for i in first..last:
        if comp.body[i].op == "call" and not comp.body[i].copy and (i + 1 == comp.body.len or comp.body[i + 1].op != "hlt"): # a copy of memory is a call, and a call before hlt is a panic
            return true
    return false

# v as it reads now, for code after it that may change what it read: a scalar is loaded, and a variable, a field, an element or what a pointer points to, of more, is copied
func now(v: Value) -> Value:
    if not v.mem or not v.place:
        return v
    read := Value{type = v.type, element = v.element}
    if aggregate(v.type):
        read.at = alloc(v.type)
        read.mem = true
        store(v.type, v, read.at)
    else:
        read.at = load(v).at
    return read

func value(n: i64, want: i64) -> Value|Fail:
    v := try gen(n, want)
    if v.type == VOID:
        return fail("a function that returns nothing is a statement, not a value", at_of(n))
    if v.type == NEVER:
        return fail("a function that never returns is a statement, not a value", at_of(n))
    if comp.types[v.type].kind == Atomic and comp.passed != n and comp.target != n: # a call or ptr takes it where it is
        return fail(code_of(n) + " is " + comp.types[v.type].name + ", which is not a value: read it with get(" + code_of(n) + ")", at_of(n))
    reads(n)
    return v

# the code of n as it is written, with the brackets it opens closed
func code_of(n: i64) -> &strview:
    first := comp.nodes[n].tok
    last := first
    for k in n..node_end(n):
        first = min(first, comp.nodes[k].tok)
        last = max(last, comp.nodes[k].tok)
    while unclosed(first, last) > 0:
        last += 1
    return excerpt(first, last)

func reads(n: i64):
    if local_of(n) != 0:
        comp.vars[declaration(text(n))].unread = 0

# the type that argument n names, read again as a type when the parser read a value: Box[i32], Car.motor
func spelled_type(n: i64) -> i64|Fail:
    k := comp.nodes[n].kind
    if k == TName or k == TUnary or k == TUnion or k == TFunc or k == TTuple:
        return resolve(n)
    first := comp.nodes[n].tok
    for i in n..node_end(n):
        tok := comp.nodes[i].tok - 2 * i64(comp.nodes[i].module.len > 0) # m.Point starts at m
        if tok < first:
            first = tok
    saved := comp.pos
    comp.pos = first
    start := comp.nodes.len
    try type_expr()
    if not peek(",") and not peek(")") and not peek("("): # an argument of a builtin, or the type of T(x)
        try unexpected("',' or ')' goes here")
    comp.pos = saved
    t := try resolve(start)
    comp.nodes.len = start
    return t

func put_text(place: Value, v: Value, at: i64) -> Fail?:
    if comp.types[v.type].kind == Func:
        return put_text(place, Value{type = pointer(BYTES), at = load(v).at}, at)
    t := comp.types[v.type]
    if t.kind == Atomic: # in a struct, what it holds now
        one: &list[Value] = heap([])
        append(one, v)
        return put_text(place, try invoke("get", one, at), at)
    if t.name == "&str": # text goes as text, a += of a union that holds &str would take it back
        return put_text(place, try convert(v, try fat_type("strview", VOID, at), Arg{}, at), at)
    declared := false # an operator += of yours that writes it
    s := first_sym("+=")
    while t.kind == Untagged and s != 0:
        f := comp.syms[s].node
        declared = declared or callable(s, "", [], at) and params(f) == 2 and not generic(kid(f, 1)) and try resolve(kid(f, 1) + 1) == v.type
        s = comp.syms[s].next
    if t.kind == Untagged and not declared:
        return fail(t.name + " has no tag that says which member it holds, so it cannot be written: convert it to the member you mean, like " + comp.types[comp.items[t.first].type].name + "(...)", at)
    if v.type == EMPTYARRAY or v.type == EMPTYMAP: # an empty literal, as it is written
        return put_words(place, "[]" if v.type == EMPTYARRAY else "{}", at)
    if t.kind == Simd:
        try put_words(place, "[", at)
        for i in 0..t.count:
            if i > 0:
                try put_words(place, ", ", at)
            try put_text(place, lane(v, i), at)
        return put_words(place, "]", at)
    args: &list[Value] = heap([])
    append(args, place)
    append(args, v)
    if try offers("+=", args, at) or t.kind != Union and t.kind != Void and t.kind != Struct and t.kind != Array:
        try invoke("+=", args, at)
        return null
    if tuple(v.type):
        try put_words(place, "(", at)
        for i in 0..t.count:
            if i > 0:
                try put_words(place, ", ", at)
            f := comp.items[t.first + i]
            try put_text(place, Value{type = f.type, at = offset(v.at, f.n), mem = true}, at)
        return put_words(place, ")", at)
    shown := t.name
    home := comp.files[file_of(comp.tokens[comp.nodes[t.decl].tok].at)].module
    if shown.len > home.len and starts_with(shown, home) and items(shown)[home.len] == '.':
        shown = shown[home.len + 1:]
    if t.kind == Void:
        return put_words(place, shown, at)
    if t.kind == Union:
        current := tag(v)
        l_done := label()
        for m in members(v.type):
            l_arm := label()
            l_next := label()
            branch(op(W, "ceqw", current, tag_of(m)), l_arm, l_next)
            open_block(l_arm)
            try put_text(place, Value{type = m, at = payload(v.at, m), mem = true}, at)
            jump(l_done)
            open_block(l_next)
        terminate("hlt", Arg{})
        open_block(l_done)
        return null
    if t.kind == Struct:
        try put_words(place, shown, at)
        try put_words(place, "{", at)
        first := true
        for i in 0..t.count:
            f := comp.items[t.first + i]
            if not f.shared:
                if not first:
                    try put_words(place, ", ", at)
                first = false
                try put_words(place, f.name, at)
                try put_words(place, " = ", at)
                try put_text(place, Value{type = f.type, at = offset(v.at, f.n), mem = true}, at)
        return put_words(place, "}", at)
    index := alloc(I64)
    try zero(I64, index)
    l_head := label()
    l_body := label()
    l_comma := label()
    l_item := label()
    l_done := label()
    try put_words(place, "[", at)
    jump(l_head)
    open_block(l_head)
    i := load(Value{type = I64, at = index, mem = true}).at
    branch(op(W, "cultl", i, int_arg(i64(t.count))), l_body, l_done)
    open_block(l_body)
    branch(op(W, "ceql", i, int_arg(0)), l_item, l_comma)
    open_block(l_comma)
    try put_words(place, ", ", at)
    jump(l_item)
    open_block(l_item)
    try put_text(place, Value{type = t.elem, at = op(L, "add", v.at, times(i, comp.types[t.elem].size)), mem = true}, at)
    store(I64, Value{type = I64, at = op(L, "add", i, int_arg(1))}, index)
    jump(l_head)
    open_block(l_done)
    return put_words(place, "]", at)

func mix(h: Arg, part: Value, at: i64) -> Fail?:
    one: &list[Value] = heap([])
    append(one, part)
    x := load(try convert_number(try invoke("hash", one, at), U64, at)).at
    add(Ins{op = "storel", a = op(L, "mul", op(L, "xor", op1(L, "loadl", h), x), int_arg(FNVPRIME)), b = h, number = true})
    return null

# where field name of t is declared, or at for a tuple, which has no declaration
func field_at(t: i64, name: &strview, at: i64) -> i64:
    if tuple(t):
        return at
    return comp.tokens[comp.nodes[field_node(t, name)].tok].at

func field_node(t: i64, name: &strview) -> i64:
    c := comp.types[t].decl + 1
    while text(c) != name or comp.nodes[c].kind != Field:
        c = node_end(c)
    return c

# an empty owner of type t that has no block yet, with the heap for its memory
func in_heap(t: i64) -> Value|Fail:
    made := try fresh(t)
    add(Ins{op = "storel", a = int_arg(HEAP), b = offset(made.at, field_of(t, "arena").n)})
    return made

func put_words(place: Value, words: &strview, at: i64) -> Fail?:
    return put_text(place, Value{type = try fat_type("strview", VOID, at), at = text_data(words), mem = true}, at)

func concat(n: i64, into: Value, first: i64) -> Value|Fail:
    parts: &list[i64] = heap([])
    signs: &list[i64] = heap([]) # the place of the + before each part after the first
    c := n
    while comp.nodes[c].kind == Binary and text(c) == "+":
        insert(parts, 0, node_end(c + 1))
        insert(signs, 0, comp.tokens[comp.nodes[c].tok].at)
        c += 1
    insert(parts, 0, c)
    at := comp.tokens[comp.nodes[n].tok].at
    middle := comp.body.len
    v := try value(parts[0], VOID)
    head: Value
    k := 1
    while not textual(v.type) and k < parts.len:
        inner := comp.body.len
        calling := comp.calls
        w := try value(parts[k], VOID)
        if comp.calls != calling:
            v = ahead(v, inner, comp.body.len)
        k += 1
        if textual(w.type):
            head = v
            v = w
        else:
            v = try binary("+", v, w, signs[k - 2])
    if not textual(v.type) and into.type == VOID:
        return v
    line := v
    joined := k < parts.len or head.type != VOID
    if joined:
        line = try in_heap(try fat_type("str", VOID, at))
        if head.type != VOID:
            try put_text(line, head, at)
        try put_text(line, v, at)
        for i in k..parts.len:
            try put_text(line, try value(parts[i], VOID), at_of(parts[i]))
    line = ahead(line, first, middle)
    args: &list[Value] = heap([])
    append(args, line)
    out: Value
    if into.type == VOID:
        out = try invoke("tmp", args, at)
    else:
        try put_text(into, line, at)
    if joined:
        try invoke("free", args, at)
    return out

func common(values: &list[Value], at: i64) -> i64|Fail:
    parts: &list[i64] = heap([])
    for round in 0..3:
        for v in values:
            fits := false
            for p in parts:
                fits = fits or v.lit and accepts(p, v) >= 0
            if turn(v) == round and not fits and not contains(parts, v.type):
                append(parts, v.type)
    for v in values:
        if v.type == EMPTYARRAY or v.type == EMPTYMAP:
            return fail("an empty literal inside a literal has no type to take, write the type of the whole literal: z: array[&listview[i32], 2] = [[], []]", at)
    kept: &list[i64] = heap([])
    for p in parts:
        taken := false
        for q in parts:
            taken = taken or q != p and accepts(q, Value{type = p}) >= 0
        if not taken:
            append(kept, p)
    return union_of(kept, Union, at)

func textual(t: i64) -> bool:
    return comp.types[t].name == "&str" or comp.types[t].name == "&strview"

func sequence(t: i64) -> bool:
    return comp.types[t].kind == Fat and (starts_with(comp.types[t].name, "&list[") or starts_with(comp.types[t].name, "&listview["))

# the field of a struct or a fat pointer with that name, an Item of type VOID when it has none
func field_of(t: i64, name: &strview) -> Item:
    ty := comp.types[t]
    if ty.kind == Struct or ty.kind == Fat:
        for i in 0..ty.count:
            if comp.items[ty.first + i].name == name:
                return comp.items[ty.first + i]
    return Item{}

# a negative index that the compiler knows, which counts from the end
func from_end(v: Value) -> bool:
    return comp.types[v.type].kind == Int and v.at.kind == Const and v.at.n < 0

func at_of(n: i64) -> i64:
    first := comp.nodes[n].tok
    for i in n..node_end(n):
        if comp.nodes[i].tok < first:
            first = comp.nodes[i].tok
    return comp.tokens[first].at

func condition(n: i64) -> Value|Fail:
    return condition_of(try gen(n, VOID), n)

func condition_of(c: Value, n: i64) -> Value|Fail:
    if c.type != BOOL:
        hint: &strview
        if comp.types[c.type].kind == Simd:
            hint = ", ask about its lanes with any(...) or all(...)"
        return fail("a condition must be bool, this one is " + comp.types[c.type].name + hint, at_of(n))
    return load(c)

func narrow(cond: i64, matching: bool) -> Fail?:
    parts: &list[i64] = heap([])
    defer free(parts)
    append(parts, cond)
    while parts.len > 0:
        c := trust pop(parts)
        o := text(c)
        subject := c + 1
        if comp.nodes[c].kind == Binary and (o == "and" and matching or o == "or" and not matching):
            append(parts, node_end(subject))
            append(parts, subject)
        elif comp.nodes[c].kind == Unary and o == "not":
            try narrow(subject, not matching)
        elif comp.nodes[c].kind == Binary and (o == "is" or o == "==" or o == "!="):
            other := node_end(subject)
            at := comp.tokens[comp.nodes[c].tok].at
            if local_of(subject) == 0: # null == x
                other = subject
                subject = node_end(subject)
            local := local_of(subject)
            typed := o == "is" or comp.nodes[other].kind == Name and local_of(other) == 0 and (comp.type_ids[text(other)] is i64 or try find_type(text(other), comp.nodes[other].module, at) != 0)
            if local != 0 and typed:
                current := comp.vars[local - 1].type
                wanted := members(try resolve(other))
                if o == "is" or comp.types[current].kind == Union and comp.types[wanted[0]].kind == Void:
                    kept: &list[i64] = heap([])
                    for m in members(current):
                        if contains(wanted, m) == (matching == (o != "!=")):
                            append(kept, m)
                    try confine(subject, kept, at)
    return null

func confine(subject: i64, kept: &list[i64], at: i64) -> Fail?:
    current := comp.vars[local_of(subject) - 1]
    t := try union_of(kept, Union, at)
    whole := comp.vars[declaration(current.name)]
    absent(whole.addr, whole.type, kept)
    if whole.inside and comp.types[t].kind != Union: # for -memory, what the walk changes in the element from now on it changes under t
        add(Ins{op = "narrowed", a = whole.addr, member = u32(t), ghost = true})
    append(comp.vars, Local{current.name, t, payload(whole.addr, t), comp.loops.len, current.tok, 0, current.fixed, 0, true, current.inside})
    return null

func keep(before: i64, back: i64, ends: *&list[Local]) -> bool|Fail:
    for i in before..comp.vars.len:
        v := comp.vars[i]
        latest := true
        for j in i + 1..comp.vars.len:
            latest = latest and comp.vars[j].name != v.name
        if retypes(i, before) and latest and comp.live:
            append(ends, v)
    try forget(back)
    return comp.live

func forget(before: i64) -> Fail?:
    for i in before..comp.vars.len:
        if comp.vars[i].unread != 0 and threads(comp.vars[i].type):
            return fail(comp.vars[i].name + " keeps a thread and nothing reads it: wait for it, or start it with parallel f(x) alone on its line to let it run on its own", comp.tokens[comp.vars[i].unread].at)
        if comp.vars[i].unread != 0:
            return fail(comp.vars[i].name + " can hold an error and nothing reads it: test it with is, pass it up with try or drop it with _ =", comp.tokens[comp.vars[i].unread].at)
    comp.vars.len = before
    return null

func func_in(t: i64) -> i64:
    found := VOID
    for m in members(t):
        if comp.types[m].kind == Func and found != VOID:
            return VOID
        if comp.types[m].kind == Func:
            found = m
    return found

func struct_in(t: i64) -> i64:
    for errors in [false, true]: # an error is written with its name, so the other struct comes first
        found := t
        for m in members(t):
            if comp.types[m].kind == Struct and comp.types[m].error == errors and found != t:
                return t
            if comp.types[m].kind == Struct and comp.types[m].error == errors:
                found = m
        if found != t:
            return found
    return t

func must_read(t: i64) -> bool:
    return fails(t) or threads(t)

func threads(t: i64) -> bool:
    for m in members(t):
        if comp.types[m].kind == Thread:
            return true
    return false

func fails(t: i64) -> bool:
    for m in members(t):
        if comp.types[m].error:
            return true
    return false

func join(ends: &list[Local], lives: i64, at: i64) -> Fail?:
    for i in 0..ends.len:
        e := ends[i]
        first := true
        for j in 0..i:
            first = first and ends[j].name != e.name
        if first:
            parts: &list[i64] = heap([])
            for other in ends:
                if other.name == e.name:
                    append(parts, other.type)
            current := comp.vars[lookup(e.name) - 1]
            if parts.len < lives:
                append(parts, current.type)
            merged := try union_of(parts, Union, at)
            if merged != current.type:
                append(comp.vars, Local{e.name, merged, payload(comp.vars[declaration(e.name)].addr, merged), comp.loops.len, e.tok, 0, e.fixed, 0, true, e.inside})
    return null

# the locals declared before an if or a switch that its branches gave a value: without it for the next branch, and with it after the last
func regive(since: i64, before: i64, given: bool):
    for k in comp.given[since:]:
        if k < before:
            comp.vars[k].given = given

# the type that the declarations give the place n, or VOID: a variable or a context, a field, what a pointer points to, an element of an array, a list or a map
func place_type(n: i64) -> i64|Fail:
    k := comp.nodes[n].kind
    if k == Name and local_of(n) != 0:
        return comp.vars[local_of(n) - 1].type
    if k == Name:
        s := try named(text(n), comp.nodes[n].module, at_of(n))
        if s != 0 and comp.nodes[comp.syms[s].node].kind == Context:
            return make_type(s, [], false, at_of(n))
        return VOID
    if k != Field and not (k == Index and kids(n) == 2) and not (k == Unary and text(n) == ".*"):
        return VOID
    t := try place_type(n + 1)
    if comp.types[t].kind == Ptr:
        t = comp.types[t].elem
    ty := comp.types[t]
    if k == Field:
        return field_of(t, text(n)).type
    if k == Unary or ty.kind == Array or ty.kind == Simd:
        return t if k == Unary else ty.elem
    if ty.kind == Fat and (text(ty.decl) == "list" or text(ty.decl) == "listview"):
        return element(t)
    if ty.decl != 0 and (ty.kind == Fat and text(ty.decl) == "map" or ty.kind == Struct and text(ty.decl) == "fixmap"):
        return comp.items[ty.args + 1].type
    return VOID

# the empty value of t for a message, heap([]) for a list or "" for a text view, or nothing when it has none
# an owner inside the struct t that starts without memory, by its path, as a field of a type parameter does
func unfed(t: i64) -> Item:
    ty := comp.types[t]
    if ty.kind == Struct:
        for f in comp.items[ty.first:ty.first + ty.count]:
            if f.default == 0 and not f.shared and starts_with(emptied(f.type), "heap("):
                return f
            inside := unfed(f.type)
            if f.default == 0 and not f.shared and inside.name.len > 0:
                path: &str = heap("")
                path += f.name + "." + inside.name
                return Item{name = view(path), type = inside.type}
    return Item{}

func emptied(t: i64) -> &strview:
    name := comp.types[t].name
    if name == "&str":
        return "heap(\"\")"
    if name == "&strview":
        return "\"\""
    if starts_with(name, "&list["):
        return "heap([])"
    if starts_with(name, "&listview["):
        return "[]"
    if starts_with(name, "&map["):
        return "heap({})"
    return ""

func constant(s: i64, want: i64, at: i64) -> Value|Fail:
    d := comp.syms[s].node
    if contains(comp.resolving, d):
        return fail(comp.syms[s].name + " refers to itself, a constant cannot be computed from itself", at)
    inner := false
    for r in comp.resolving:
        inner = inner or comp.nodes[r].kind == Constant
    given := d + 1
    t := want
    if kids(d) == 2: # a constant with a type
        t = try resolve(d + 1)
        given = node_end(d + 1)
    first := comp.body.len
    slots := comp.slots.len
    held := comp.held.len
    append(comp.resolving, d)
    aside := set_aside(0) # the value sees the constants it names, not the variables where it is read
    v := value(given, t)
    if v is Value and kids(d) == 2:
        v = convert(v, t, Arg{}, at_of(given))
    put_back(0, aside)
    comp.resolving.len -= 1
    if v is Fail:
        note(comp.syms[s].name + " is read here", at)
        return Fail
    v.place = false
    if inner or not aggregate(v.type) or v.at.kind != Temp:
        return v
    end := comp.body.len
    data: &str = heap("")
    data += "align " + data_align(v.type) + " { "
    if try image(v.type, given, data) != 0:
        comp.body.len = end
        return v
    zeros(data, room(v.type) - comp.types[v.type].size)
    data += "}"
    drop(first, slots, held)
    id := comp.stored[view(data)] ifnull i64(comp.globals.len)
    if id == i64(comp.globals.len):
        name: &str = heap("$flag.const.")
        name += id
        global(view(name))
        put(comp.stored, view(data), id)
        comp.data += read_only(true) + "data " + name + " = " + data + "\n"
    return Value{type = v.type, at = Arg{Global, id}, mem = true, lit = true}

# drops the code made since body, slots and held had these lengths, and a spare slot it took is spare again
func drop(body: i64, slots: i64, held: i64):
    for k in comp.held[held:]:
        if k < slots:
            append(comp.spare, k)
    comp.held.len = held
    comp.slots.len = slots
    comp.body.len = body

# heap([]), heap({}) or heap(""): an empty owner, the mark of the heap without a block, which the compiler writes itself
func empty_owner(n: i64) -> bool:
    if comp.nodes[n].kind != Call or comp.nodes[n].size != 2:
        return false
    given := comp.nodes[n + 1].kind
    return (given == Items or given == Pairs or given == Literal and text(n + 1) == "\"\"") and text(n) == "heap" and comp.nodes[n].module.len == 0

func image(t: i64, n: i64, out: *&str) -> i64|Fail: # the node of a part that is computed, or 0
    while n != 0 and comp.nodes[n].kind == Name:
        s := try named(text(n), comp.nodes[n].module, at_of(n))
        d := comp.syms[s].node
        if s == 0 or comp.nodes[d].kind != Constant or kids(d) == 2 and try resolve(d + 1) != t: # a constant of another type is read as a value
            break
        n = kid(d, kids(d) - 1) # its value, after its type when it has one
    ty := comp.types[t]
    if n != 0 and empty_owner(n) and field_of(t, "arena").type != VOID: # the heap mark, without a block
        arena := field_of(t, "arena").n
        zeros(out, arena)
        out.* += "l " + HEAP + ", "
        zeros(out, ty.size - arena - 8)
        return 0
    if n != 0 and empty_owner(n):
        n = 0
    if n == 0 and not ty.stamped:
        zeros(out, ty.size)
        return 0
    kind: NodeKind = Var # no node, the value is zero
    if n != 0:
        kind = comp.nodes[n].kind
    quoted := kind == Literal and comp.tokens[comp.nodes[n].tok].kind == Str
    if ty.kind == Union:
        member := ty.start
        if kind == Brace:
            member = try resolve(n + 1)
        elif kind == Fill:
            member = struct_in(t)
        elif quoted:
            member = try fat_type("strview", VOID, at_of(n))
        elif n != 0:
            v := try value(n, t)
            member = v.type
            if not contains(members(t), member):
                member = try member_for(t, v, at_of(n))
        if not contains(members(t), member):
            return n
        out.* += "w " + comp.types[member].tag + ", "
        if ty.size > 4:
            zeros(out, past_tag(member) - 4)
            unknown := try image(member, n, out)
            if unknown != 0:
                return unknown
            zeros(out, ty.size - past_tag(member) - comp.types[member].size)
        return 0
    if (ty.kind == Struct or ty.kind == Fat) and (n == 0 or kind == Brace or kind == Fill):
        given: &list[i64] = heap([])
        defer free(given)
        for i in 0..ty.count:
            append(given, 0)
        c := n + 1
        if kind == Brace:
            c = node_end(n + 1)
        next := 0
        while n != 0 and c < node_end(n):
            if comp.nodes[c].kind == Named:
                f := 0
                while comp.items[ty.first + f].name != text(c):
                    f += 1
                given[f] = c + 1
            else:
                while comp.items[ty.first + next].shared:
                    next += 1
                given[next] = c
                next += 1
            c = node_end(c)
        offset := 0
        for i in 0..ty.count:
            field := comp.items[ty.first + i]
            if not field.shared:
                filler := i
                for j in 0..ty.count:
                    if given[j] != 0 and comp.items[ty.first + j].n == field.n:
                        filler = j
                inner := comp.items[ty.first + filler].type
                zeros(out, field.n - offset)
                unknown := 0
                if given[filler] == 0 and field.default != 0:
                    saved := frame_of(t) # the default reads what the declaration of t sees, not the variables where t is born
                    aside := set_aside(0)
                    unknown = try image(inner, field.default, out)
                    put_back(0, aside)
                    close_frame(saved)
                else:
                    unknown = try image(inner, given[filler], out)
                if unknown != 0:
                    return unknown
                zeros(out, comp.types[field.type].size - comp.types[inner].size)
                offset = field.n + comp.types[field.type].size
        zeros(out, ty.size - offset)
        return 0
    if (ty.kind == Array or ty.kind == Simd) and (n == 0 or kind == Items or kind == Brace):
        c := n + 1
        if kind == Brace:
            c = node_end(n + 1)
        raw := lane_type(t)
        for i in 0..ty.count:
            element := 0
            if n != 0:
                element = c
                c = node_end(c)
            if raw != ty.elem and element != 0: # a mask keeps true as all ones
                v := try value(element, BOOL)
                if not v.lit:
                    return element
                for k in 0..comp.types[raw].size:
                    out.* += "b " + 255 * v.n + ", "
                continue
            unknown := try image(raw, element, out)
            if unknown != 0:
                return unknown
        return 0
    if kind == Items and node_end(n) == n + 1 and ty.kind == Fat and field_of(t, "arena").type == VOID: # the empty view
        zeros(out, ty.size)
        return 0
    if quoted and ty.name == "&strview":
        id := comp.globals[text_data(unquoted(text(n))).n][9:]
        out.* += "l $flag.str." + id + ", l " + comp.texts[trust parse_int(id)] + ", "
        return 0
    if ty.size == 0:
        return 0
    v := try convert(try value(n, t), t, Arg{}, at_of(n))
    known := v.at.kind == Const or v.at.kind == Single or v.at.kind == Double or v.at.kind == Global and not v.mem and not starts_with(comp.globals[v.at.n], "thread ")
    if aggregate(t) or not known:
        return n
    letter: &strview = "l"
    if v.at.kind == Single:
        letter = "s"
    elif v.at.kind == Double:
        letter = "d"
    elif ty.size == 1:
        letter = "b"
    elif ty.size == 2:
        letter = "h"
    elif ty.size == 4:
        letter = "w"
    out.* += letter + " "
    put_arg(out, v.at, 0)
    out.* += ", "
    return 0

func zeros(out: *&str, count: i64):
    if count > 0:
        out.* += "z " + count + ", "

func truth(b: bool) -> Value:
    if b:
        return Value{type = BOOL, at = int_arg(1), lit = true, n = 1}
    return Value{type = BOOL, at = int_arg(0), lit = true}

func literal(neg: bool, n: u64) -> Value:
    x := i64(n)
    if neg:
        x = 0 - x
    v := Value{type = I64, at = int_arg(x), lit = true, neg = neg and n != 0, n = n}
    if not fits(v, I64):
        v.type = U64
    return v

func float_literal(x: f64) -> Value:
    return Value{type = F64, at = Arg{Double, x as i64}, lit = true}

func real(v: Value) -> f64:
    if comp.types[v.type].kind == Float:
        return v.at.n as f64
    if v.neg:
        return -f64(v.n)
    return f64(v.n)

func integer(t: i64) -> bool:
    return comp.types[t].kind == Int or comp.types[t].kind == Uint

func numeric(t: i64) -> bool:
    return integer(t) or comp.types[t].kind == Float

func tag(v: Value) -> Arg:
    return op1(W, "loadw", v.at)

func tag_of(member: i64) -> Arg:
    return int_arg(i64(comp.types[member].tag))

# writes what t starts with after its zeros
func stamp(t: i64, addr: Arg, at: i64) -> Fail?:
    ty := comp.types[t]
    if not ty.stamped:
        return null
    if ty.kind == Union:
        set_tag(t, ty.start, offset(addr, at))
        return stamp(ty.start, addr, at + past_tag(ty.start))
    if ty.kind == Struct or ty.kind == Fat:
        for field in comp.items[ty.first:ty.first + ty.count]:
            if field.default != 0:
                if contains(comp.resolving, field.default):
                    return fail("the default of " + field.name + " cannot make " + ty.name + ", which starts with that default", at_of(field.default))
                saved := frame_of(t) # the default reads what the declaration of t sees, not the variables where t is born
                aside := set_aside(0)
                append(comp.resolving, field.default)
                v := try value(field.default, field.type)
                comp.resolving.len -= 1
                put_back(0, aside)
                close_frame(saved)
                if owner(field.type) and v.type != field.type and emptied(field.type).len > 0:
                    return fail("a default value is one the compiler knows, and an owner that holds something is made when the program runs: " + field.name + " starts with " + emptied(field.type) + ", and gets the rest where its value is made", at_of(field.default))
                try assign(offset(addr, at + field.n), field.type, v, at_of(field.default))
            elif not field.shared:
                try stamp(field.type, addr, at + field.n)
    elif ty.kind == Array:
        slot := alloc(I64)
        l_head := label()
        l_body := label()
        l_done := label()
        add(Ins{op = "storel", a = int_arg(0), b = slot, number = true})
        jump(l_head)
        open_block(l_head)
        i := op1(L, "loadl", slot)
        branch(op(W, "cultl", i, int_arg(i64(ty.count))), l_body, l_done)
        open_block(l_body)
        try stamp(ty.elem, op(L, "add", offset(addr, at), op(L, "mul", i, int_arg(i64(comp.types[ty.elem].size)))), 0)
        add(Ins{op = "storel", a = op(L, "add", i, int_arg(1)), b = slot, number = true})
        jump(l_head)
        open_block(l_done)
    return null

func packs(f: Item, at: i64) -> bool:
    size := comp.types[f.type].size
    return size < 8 and f.n + size <= at + 8 and (numeric(f.type) or f.type == BOOL or comp.types[f.type].kind == Union)

func set_tag(t: i64, member: i64, addr: Arg):
    name: &strview = "storew"
    if comp.types[t].size > 4:
        name = "storel" # the whole word, so a copy of it reads one store
    add(Ins{op = name, a = tag_of(member), b = addr, number = true})

func tag_test(v: Value, tags: &list[i64]) -> Arg:
    current := tag(v)
    result := Arg{}
    for m in tags:
        test := op(W, "ceqw", current, tag_of(m))
        if result.kind == Empty:
            result = test
        else:
            result = op(W, "or", result, test)
    return result

func leave(v: Value, at: i64) -> Fail?:
    result := Arg{}
    if comp.dest.kind != Empty:
        try assign(comp.dest, comp.ret, v, at)
    else:
        back := try convert(v, comp.ret, Arg{}, at)
        result = load(back).at
        if aggregate(comp.ret) and comp.defers.len > 0:
            result = alloc(comp.ret)
            store(comp.ret, back, result)
    try unwind(0, 0)
    if comp.inst == comp.entry:
        result = try ending(Value{type = comp.ret, at = result}, at)
    terminate("ret", result)
    return null

# the exit code that main gives C, from ending of core, which turns an end with 0 into 1 when the standard output failed
func ending(code: Value, at: i64) -> Arg|Fail:
    given: &list[Value] = heap([])
    append(given, try convert_number(code, I32, at))
    return load(try convert_number(try runtime("ending", given, at), code.type, at)).at

func unwind(from: i64, staying: i64) -> Fail?:
    at := comp.at # what follows the defers is of the statement that leaves
    if staying == 0:
        try settle()
    kept := comp.vars.len
    comp.leaving = comp.loops.len
    comp.staying = staying
    try run_defers(from)
    comp.leaving = 0
    comp.staying = 0
    comp.vars.len = kept
    comp.at = at
    return null

# main waits for the threads that run alone before its deferred statements, so they can use all it keeps
func settle() -> Fail?:
    if comp.inst == comp.settler:
        nothing: &list[Value] = heap([])
        try invoke("settle", nothing, 0)
    return null

func run_defers(from: i64) -> Fail?:
    i := comp.defers.len
    while i > from:
        i -= 1
        d := comp.defers[i]
        aside := set_aside(d.visible)
        stays := comp.vars.len
        if d.subject.type != VOID:
            at := comp.tokens[comp.nodes[d.node].tok].at
            closing: &list[Value] = heap([])
            append(closing, d.subject)
            closed := try invoke("with", closing, at)
            if fails(closed.type):
                return fail("operator with of " + comp.types[d.subject.type].name + " can fail, and with would drop the error: close it with a call of yours and handle what it gives", at)
        else:
            try statement(d.node, "this deferred statement drops an error and a defer cannot pass it up: drop it on purpose with defer _ = ..., or run it without defer and handle the error")
        if comp.nodes[d.node].kind == Assign and local_of(d.node + 1) != 0:
            kept := declaration(text(d.node + 1))
            comp.vars[kept].unread = comp.nodes[d.node + 1].tok if must_read(comp.vars[kept].type) else 0
        for k in stays..comp.vars.len:
            append(aside, comp.vars[k])
        put_back(d.visible, aside)
    return null

func continued(first: Arg, step: i64, most: Arg, left: Arg) -> Arg:
    count := alloc(I64)
    store(I64, Value{type = I64, at = int_arg(0)}, count)
    l_scan := label()
    l_byte := label()
    l_next := label()
    l_done := label()
    jump(l_scan)
    open_block(l_scan)
    k := load(Value{type = I64, at = count, mem = true}).at
    branch(op(W, "and", op(W, "cultl", k, most), op(W, "cultl", k, left)), l_byte, l_done)
    open_block(l_byte)
    b := op1(W, "loadub", op(L, "add", first, op(L, "mul", k, int_arg(step))))
    branch(op(W, "ceqw", op(W, "and", b, int_arg(0xc0)), int_arg(0x80)), l_next, l_done)
    open_block(l_next)
    store(I64, Value{type = I64, at = op(L, "add", k, int_arg(1))}, count)
    jump(l_scan)
    open_block(l_done)
    return load(Value{type = I64, at = count, mem = true}).at

func statements(n: i64) -> Fail?:
    defers := comp.defers.len
    outer := comp.scope
    first := comp.slots.len
    open_scope()
    c := n + 1
    while c < node_end(n):
        if not comp.live and (comp.nodes[c].kind != Where or try holds(c + 1)):
            return fail("this code can never run, the block already left", at_of(c))
        comp.at = at_of(c)
        try statement(c, "this statement drops an error: test it with is, pass it up with try or drop it with _ =")
        c = node_end(c)
    if comp.live and outer == 0:
        try settle()
    if comp.live:
        try run_defers(defers)
    comp.defers.len = defers
    close_scope(first)
    return null

func open_scope():
    append(comp.scopes, comp.scope)
    comp.scope = comp.scopes.len
    append(comp.spare, -1) # the spare slots of the outer blocks wait past it: a block takes only the slots it made, so its end is theirs
    if comp.debug:
        append(comp.body, Ins{op = "dbgmark", a = int_arg(i64(2 * comp.scope))})

# the slots from first on are the variables and temporaries of the block, and its end is theirs, but in the block of a function, which its return ends
func close_scope(first: i64):
    outer := comp.scopes[comp.scope - 1]
    if comp.debug:
        inside(Ins{op = "dbgmark", a = int_arg(i64(2 * comp.scope + 1))})
    if outer != 0 and first < comp.slots.len:
        inside(ended(first))
    comp.scope = outer
    for i in reverse 0..comp.spare.len:
        if comp.spare[i] < 0:
            remove(comp.spare, i)
            break

# i at the end of the block, before the jump that left it when one did
func inside(i: Ins):
    if comp.live:
        append(comp.body, i)
    else:
        insert(comp.body, comp.body.len - 1, i)

# for -memory, the slots from first on end here, and a pointer kept to what they hold goes bad
func ended(first: i64) -> Ins:
    return Ins{op = "ended", a = int_arg(first), b = int_arg(comp.slots.len), pos = comp.at, ghost = true}

func statement(n: i64, dropped: &strview) -> Fail?:
    start := comp.held.len
    v := try gen(n, VOID)
    while comp.held.len > start:
        append(comp.spare, trust pop(comp.held))
    o := text(n)
    if comp.nodes[n].kind == Unary and o == "parallel":
        if fails(comp.types[v.type].elem):
            return fail("this thread runs alone and nothing would see an error of " + comp.types[comp.types[v.type].elem].name + ", which its function gives: keep the thread and wait for it, t := parallel f(x)", at_of(n))
        args: &list[Value] = heap([])
        append(args, Value{type = pointer(BYTES), at = v.at})
        try runtime("detach", args, at_of(n))
        return null
    if v.type != VOID and comp.nodes[n].kind != Call and comp.nodes[n].kind != Assign and o != "try" and o != "trust":
        hint: &strview
        if o == "==":
            hint = ", an assignment is written with one ="
        return fail("this statement makes a value and never uses it" + hint, at_of(n))
    if fails(v.type) and comp.nodes[n].kind == Assign:
        return fail("this assignment calls operator []=, which gives " + comp.types[v.type].name + ", and an assignment cannot pass on an error: call put and handle what it gives, try put(x, i, v)", at_of(n))
    if fails(v.type):
        return fail(dropped, at_of(n))
    return null

func set_aside(visible: i64) -> &list[Local]:
    aside: &list[Local] = heap([])
    stays := visible
    for i in visible..comp.vars.len:
        append(aside, comp.vars[i])
        if retypes(i, visible):
            comp.vars[stays] = comp.vars[i]
            stays += 1
    comp.vars.len = stays
    return aside

func retypes(i: i64, before: i64) -> bool:
    for j in 0..before:
        if comp.vars[j].name == comp.vars[i].name:
            return true
    return false

func put_back(visible: i64, aside: &list[Local]):
    comp.vars.len = visible
    for l in aside:
        append(comp.vars, l)
    free(aside)

func declaration(name: &strview) -> i64:
    d := 0
    while comp.vars[d].name != name:
        d += 1
    return d

func held(found: i64, at: i64) -> Value:
    local := comp.vars[found - 1]
    if noted(at) and comp.tokens[local.tok].kind == Name: # the value of a, b := f() waits in a local named :=
        mark(local.tok, described(local.name, local.type))
    return Value{type = local.type, at = local.addr, mem = true, place = local.fixed.len == 0}

# what n, ptr(x) or ptr(x) as T, points to when that lives in the stack of this function, or 0: a variable, a parameter, a field or an element held in one, or a temporary
func stacked(n: i64) -> i64:
    if comp.nodes[n].kind == Binary and text(n) == "as":
        n += 1
    if comp.nodes[n].kind != Call or text(n) != "ptr" or comp.nodes[n].module.len > 0 or kids(n) != 1:
        return 0
    k := comp.nodes[n + 1].kind
    o := text(n + 1)
    if (k == Unary or k == Binary) and (o == ".*" or o == "try" or o == "trust" or o == "as"):
        return 0
    if k != Name and k != Field and k != Index:
        return n + 1
    chain: &list[i64] = heap([])
    x := n + 1
    while comp.nodes[x].kind == Field or comp.nodes[x].kind == Index and kids(x) == 2:
        append(chain, x)
        x += 1
    if local_of(x) == 0 or comp.vars[local_of(x) - 1].inside:
        return 0
    t := comp.vars[local_of(x) - 1].type
    for c in reverse chain:
        ty := comp.types[t]
        if comp.nodes[c].kind == Index and ty.kind == Array:
            t = ty.elem
        elif comp.nodes[c].kind == Field and (ty.kind == Struct or ty.kind == Fat):
            t = field_of(t, text(c)).type
        else:
            return 0
    return n + 1

func local_of(n: i64) -> i64:
    if comp.nodes[n].kind != Name or comp.nodes[n].module.len > 0:
        return 0
    return lookup(text(n))

func untaken(tok: i64) -> Fail?:
    t := comp.tokens[tok]
    if lookup(t.text) != 0:
        return fail("variable " + t.text + " is already declared and still in scope", t.at)
    library := comp.files[file_of(t.at)].library # the library does not see the names of the program
    s := first_sym(t.text)
    while s != 0:
        d := comp.syms[s].node
        k := comp.nodes[d].kind
        if visible(s, "", t.at) and (comp.syms[s].library or not library) and (k == Constant or k == Context or k == Var):
            if k != Context:
                _ = fail(t.text + " is a constant, a variable cannot take its name", t.at)
            else:
                _ = fail(t.text + " is a context, a variable cannot take its name", t.at)
            note(t.text + " is declared here", comp.tokens[comp.nodes[d].tok].at)
            return Fail
        s = comp.syms[s].next
    return null

func lookup(name: &strview) -> i64:
    i := comp.vars.len
    while i > 0:
        i -= 1
        if comp.vars[i].name == name:
            return i + 1
    return 0

func aggregate(t: i64) -> bool:
    k := comp.types[t].kind
    return k == Struct or k == Fat or k == Union or k == Untagged or k == Array or k == Simd or k == Atomic

func big(t: i64) -> bool:
    return aggregate(t) and comp.types[t].size > 128

func payload(addr: Arg, t: i64) -> Arg:
    if comp.types[t].kind == Union or comp.types[t].size == 0:
        return addr
    return add(Ins{op = "add", cls = L, to = u32(temp().n), a = addr, b = int_arg(i64(past_tag(t))), member = u32(t)})

func absent(addr: Arg, t: i64, here: &list[i64]):
    for m in members(t):
        if not contains(here, m) and holds_pointer(m):
            add(Ins{op = "absent", a = addr, c = int_arg(i64(comp.types[m].size)), shape = m, copy = true, ghost = true, member = u32(m)})

func times(count: Arg, size: i64) -> Arg:
    if size == 1:
        return count
    return op(L, "mul", count, int_arg(i64(size)))

func offset(addr: Arg, n: i64) -> Arg:
    if n == 0:
        return addr
    return op(L, "add", addr, int_arg(i64(n)))

func cls(t: i64) -> u32:
    ty := comp.types[t]
    if aggregate(t):
        return AGG + u32(t)
    if ty.kind == Float and ty.size == 4:
        return S
    if ty.kind == Float:
        return D
    if ty.size == 8:
        return L
    return W

func cmp_name(base: &strview, t: i64) -> &strview:
    ty := comp.types[t]
    out: &str = heap("")
    if ty.kind == Float and base.len == 4:
        out = "c"
        out += base[2:4]
    elif (ty.kind == Uint or ty.kind == Ptr) and base.len == 4:
        out = "cu"
        out += base[2:4]
    else:
        out = base
    if cls(t) == S:
        out += "s"
    elif cls(t) == D:
        out += "d"
    elif cls(t) == L:
        out += "l"
    else:
        out += "w"
    return view(out)

func extend(t: i64, x: Arg) -> Arg:
    ty := comp.types[t]
    if ty.size == 1 and ty.kind == Int:
        return op1(W, "extsb", x)
    if ty.size == 1:
        return op1(W, "extub", x)
    if ty.size == 2 and ty.kind == Int:
        return op1(W, "extsh", x)
    if ty.size == 2:
        return op1(W, "extuh", x)
    return x

func load(v: Value) -> Value:
    ty := comp.types[v.type]
    if ty.size == 0:
        return Value{type = v.type, at = int_arg(0)}
    if not v.mem or aggregate(v.type):
        return v
    name: &strview = "loadl"
    if ty.kind == Float and ty.size == 4:
        name = "loads"
    elif ty.kind == Float:
        name = "loadd"
    elif ty.size == 1 and ty.kind == Int:
        name = "loadsb"
    elif ty.size == 1:
        name = "loadub"
    elif ty.size == 2 and ty.kind == Int:
        name = "loadsh"
    elif ty.size == 2:
        name = "loaduh"
    elif ty.size == 4:
        name = "loadw"
    elif integer(v.type):
        return Value{type = v.type, at = add(Ins{op = "loadl", cls = L, to = u32(temp().n), a = v.at, number = true})}
    return Value{type = v.type, at = op1(cls(v.type), name, v.at)}

func store(t: i64, v: Value, addr: Arg):
    ty := comp.types[t]
    if ty.size == 0:
        return
    if aggregate(t):
        blit(v.at, addr, t)
        return
    x := load(v).at
    if ty.size == 8 and integer(t) and not is_number(x):
        x = add(Ins{op = "copy", cls = L, to = u32(temp().n), a = x, number = true})
    name: &strview = "storel"
    if ty.kind == Float and ty.size == 4:
        name = "stores"
    elif ty.kind == Float:
        name = "stored"
    elif ty.size == 1:
        name = "storeb"
    elif ty.size == 2:
        name = "storeh"
    elif ty.size == 4:
        name = "storew"
    add(Ins{op = name, a = x, b = addr, number = integer(t)})

func blit(from: Arg, to: Arg, t: i64):
    if from.kind == to.kind and from.n == to.n:
        return
    if comp.types[t].kind == Simd and vectors():
        for half in 0..comp.types[t].size / 16:
            add(Ins{op = "storev", a = op1(V, "loadv", offset(from, 16 * half)), b = offset(to, 16 * half)}) # a slot only loaded and stored whole becomes a register
        return
    size := i64(comp.types[t].size)
    if not big(t):
        add(Ins{op = "blit", a = from, b = to, c = int_arg(size), shape = t, copy = true})
        return
    first := comp.passes.len
    append(comp.passes, Pass{L, to, false, VOID})
    append(comp.passes, Pass{L, from, false, VOID})
    append(comp.passes, Pass{L, int_arg(size), true, VOID})
    add(Ins{op = "call", cls = L, to = u32(temp().n), a = global("$memcpy"), first = u32(first), count = 3, shape = t, copy = true})

func holds_pointer(t: i64) -> bool:
    ty := comp.types[t]
    if ty.kind == Ptr or ty.kind == Func or ty.kind == Thread or ty.kind == Fat:
        return true
    if ty.kind == Array or ty.kind == Atomic:
        return holds_pointer(ty.elem)
    if ty.kind == Struct or ty.kind == Union or ty.kind == Untagged:
        for item in comp.items[ty.first:ty.first + ty.count]:
            if holds_pointer(item.type):
                return true
    return false

func zero(t: i64, addr: Arg) -> Fail?:
    if comp.types[t].kind == Simd and vectors():
        for half in 0..comp.types[t].size / 16:
            add(Ins{op = "storev", a = splat(I32, int_arg(0)), b = offset(addr, 16 * half)})
        return null
    size := room(t)
    if size > 64:
        first := comp.passes.len
        append(comp.passes, Pass{L, addr, false, VOID})
        append(comp.passes, Pass{W, int_arg(0), true, VOID})
        append(comp.passes, Pass{L, int_arg(i64(size)), true, VOID})
        add(Ins{op = "call", cls = L, to = u32(temp().n), a = global("$memset"), first = u32(first), count = 3})
    else:
        for at in 0..size / 8:
            add(Ins{op = "storel", a = int_arg(0), b = offset(addr, at * 8)})
    return stamp(t, addr, 0)

func address(v: Value) -> Value:
    at := v.at
    if not v.place and (v.lit or not aggregate(v.type)):
        at = alloc(v.type)
        store(v.type, v, at)
    if not v.place and aggregate(v.type):
        comp.held.len = 0 # a pointer to a temporary keeps every slot held now
    return Value{type = pointer(v.type), at = at}

func alloc(t: i64, variable: bool = false) -> Arg:
    size := i64(room(t))
    name := alloc_op(t)
    if size > 8 and comp.types[t].kind != Union and not variable: # small slots live in registers, unions are copied whole, a variable names its slot
        for i in reverse 0..comp.spare.len:
            s := comp.spare[i]
            if s < 0:
                break
            if comp.slots[s].a.n == size and comp.slots[s].op == name:
                remove(comp.spare, i)
                append(comp.held, s)
                return Arg{Temp, i64(comp.slots[s].to)}
        append(comp.held, comp.slots.len)
    slot := temp()
    append(comp.slots, Ins{op = name, cls = L, to = u32(slot.n), a = int_arg(size)})
    return slot

func alloc_op(t: i64) -> &strview:
    if comp.types[t].align > 8:
        return "alloc16"
    return "alloc8"

func data_align(t: i64) -> i64:
    if comp.types[t].align > 8:
        return comp.types[t].align
    return 8

func room(t: i64) -> i64:
    size := align_up(comp.types[t].size, 8)
    if size == 0:
        return 8
    return size

func text_data(text: &strview) -> Arg:
    key: &str = heap("\"")
    key += text
    found := comp.stored[view(key)]
    if found is i64:
        return Arg{Global, found}
    id := comp.texts.len
    comp.data += read_only(false) + "data $flag.str." + id + " = { "
    length := text_bytes(comp.data, text)
    comp.data += "b 0 }\n" + read_only(true) + "data $flag.sv." + id + " = { l $flag.str." + id + ", l " + length + " }\n" # the data of the compiler is in flag., a function is name.number
    append(comp.texts, length)
    name: &str = heap("$flag.sv.")
    name += id
    made := global(view(name))
    put(comp.stored, view(key), made.n)
    return made

# the section of the data that the program only reads, where a write stops it: on macOS __TEXT takes no address that the loader fixes, so what holds one stays in data
func read_only(addresses: bool) -> &strview:
    if comp.system == "linux":
        return "section \".data.rel.ro\" "
    if comp.system == "windows":
        return "section \".rdata\" \"dr\" "
    if addresses:
        return ""
    return "section \"__TEXT,__const\" "

func text_bytes(into: *&str, text: &strview) -> i64:
    quoted := false
    for b in items(text):
        if b >= ' ' and b <= '~' and b != '"' and b != '\\':
            if not quoted:
                into.* += "b \""
                quoted = true
            add_byte(into, b)
        else:
            if quoted:
                into.* += "\", "
                quoted = false
            into.* += "b " + i64(b) + ", "
    if quoted:
        into.* += "\", "
    return text.len

# the text of a literal, without its quotes, with its escapes made bytes and the \r\n of the file made \n
func unquoted(literal: &strview) -> &strview:
    out: &str = heap("")
    defer free(out)
    bytes := items(literal)
    i := 1
    while i < literal.len - 1:
        b := bytes[i]
        if b == '\\':
            i += 1
            b = escaped(literal, i)
            if bytes[i] == 'x':
                i += 2
        elif b == '\r' and bytes[i + 1] == '\n':
            b = '\n'
            i += 1
        add_byte(out, b)
        i += 1
    return tmp(out)
