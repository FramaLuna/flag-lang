@trust
W = 1
L = 2
S = 3
D = 4
SB = 5
UB = 6
SH = 7
UH = 8
AGG = 16
CAGG = 1 << 30
SMALL = 45
LARGE = 500

func temp() -> Arg:
    comp.temps += 1
    append(comp.numbers, false)
    return Arg{Temp, i64(comp.temps)}

func label() -> u32:
    comp.labels += 1
    return comp.labels

func int_arg(n: i64) -> Arg:
    return Arg{Const, n}

func global(name: &strview) -> Arg:
    found := comp.global_ids[name]
    if found is usize:
        return Arg{Global, i64(found)}
    put(comp.global_ids, name, comp.globals.len)
    append(comp.globals, name)
    return Arg{Global, i64(comp.globals.len - 1)}

func is_number(a: Arg) -> bool:
    return a.kind != Temp or comp.numbers[usize(a.n) - 1]

func add(i: Ins) -> Arg:
    i.pos = comp.at
    append(comp.body, i)
    if i.to == 0:
        return Arg{}
    comp.numbers[i.to - 1] = i.number
    return Arg{Temp, i64(i.to)}

func op(cls: u32, name: &strview, a: Arg, b: Arg) -> Arg:
    return add(Ins{op = name, cls = cls, to = u32(temp().n), a = a, b = b})

func op1(cls: u32, name: &strview, a: Arg) -> Arg:
    return add(Ins{op = name, cls = cls, to = u32(temp().n), a = a})

func terminate(name: &strview, a: Arg):
    add(Ins{op = name, a = a})
    comp.live = false

func jump(l: u32):
    if comp.live:
        add(Ins{op = "jmp", a = int_arg(i64(l))})
    comp.live = false

func branch(c: Arg, yes: u32, no: u32):
    add(Ins{op = "jnz", a = c, b = int_arg(i64(yes)), c = int_arg(i64(no))})
    comp.live = false

func open_block(l: u32):
    add(Ins{op = "@", a = int_arg(i64(l))})
    comp.live = true

func mention(name: &strview, a: Arg):
    if a.kind != Temp:
        return
    append(comp.mentions, Mention{u32(a.n), name})
    for k in reverse 0..comp.held.len:
        if comp.slots[comp.held[k]].to == u32(a.n):
            remove(comp.held, k) # the slot of a variable is never given back
            return

func listing(optimize: bool) -> &str:
    ids: &map[&strview, usize]
    defer free(ids)
    sizes: &list[usize]
    defer free(sizes)
    for f in 0..comp.procs.len:
        p := comp.procs[f]
        if optimize and p.name != "$main": # the start of the program, main is never inlined
            large := size(p) > LARGE
            top := p.labels
            for i in comp.code[p.code:p.end]:
                if i.op == "@" and u32(i.a.n) > top:
                    top = u32(i.a.n)
            first := p.temps
            p.temps = comp.temps + 1
            names := fresh(first, p.last)
            hop := i64(comp.labels) - i64(p.labels)
            comp.labels += top - p.labels
            p.labels = u32(i64(p.labels) + hop)
            params := comp.passes.len
            for k in p.params..p.params + p.count:
                given := comp.passes[k]
                given.arg = named(given.arg, names, first)
                append(comp.passes, given)
            p.params = params
            slots: &list[Ins]
            body: &list[Ins]
            pool: &list[Ins]
            for k in p.code..p.end:
                i := renamed(comp.code[k], names, first, hop)
                g := callee(i, ids)
                if g < f and (sizes[g] <= SMALL and not large or declared_inline(comp.procs[g].node)) and not comp.procs[g].recursive and not comp.procs[g].export:
                    q := comp.procs[g]
                    inner := fresh(q.temps, q.last)
                    taken: &list[usize]
                    for j in 0..q.count:
                        want := comp.passes[q.params + j]
                        given := comp.passes[usize(i.first) + j]
                        at := usize(want.arg.n) - usize(q.temps)
                        inner[at] = given.arg
                        if want.cls >= AGG:
                            t := usize(want.cls - AGG)
                            inner[at] = pooled(i64(room(t)), pool, taken)
                            append(body, Ins{op = "blit", a = given.arg, b = inner[at], c = int_arg(i64(comp.types[t].size)), pos = i.pos})
                    if i.cls >= AGG:
                        append(slots, Ins{op = "alloc8", cls = L, to = i.to, a = int_arg(i64(room(usize(i.cls - AGG))))})
                    comp.labels += 1
                    after := comp.labels
                    jumped := false
                    for j in q.code..q.end:
                        c := comp.code[j]
                        if c.op == "alloc8":
                            inner[c.to - q.temps] = pooled(c.a.n, pool, taken)
                            continue
                        c = renamed(c, inner, q.temps, i64(after) - i64(q.labels))
                        if q.file != p.file:
                            c.pos = i.pos
                        if c.op == "@" and u32(c.a.n) > comp.labels:
                            comp.labels = u32(c.a.n)
                        if c.op != "ret":
                            append(body, c)
                            continue
                        if i.cls >= AGG:
                            append(body, Ins{op = "blit", a = c.a, b = Arg{Temp, i64(i.to)}, c = int_arg(i64(comp.types[usize(i.cls - AGG)].size)), pos = c.pos})
                        elif i.to != 0:
                            append(body, Ins{op = "copy", cls = i.cls, to = i.to, a = c.a, pos = c.pos})
                        if j + 1 < q.end:
                            append(body, Ins{op = "jmp", a = int_arg(i64(after)), pos = c.pos})
                            jumped = true
                    if jumped or comp.code[q.end - 1].op != "ret":
                        append(body, Ins{op = "@", a = int_arg(i64(after))})
                    free(inner)
                    free(taken)
                elif i.op == "alloc8":
                    append(slots, i)
                else:
                    append(body, i)
            p.code = comp.code.len
            append(comp.code, slots[:])
            append(comp.code, pool[:])
            append(comp.code, body[:])
            free(names)
            free(slots)
            free(pool)
            free(body)
            p.end = comp.code.len
            p.last = comp.temps
            comp.procs[f] = p
        put(ids, p.name, f)
        append(sizes, size(p))
    live: &list[bool]
    defer free(live)
    work: &list[usize]
    defer free(work)
    for f in 0..comp.procs.len:
        p := comp.procs[f]
        append(live, p.export or comp.insts[p.inst].valued)
        if live[f]:
            append(work, f)
    while work.len > 0:
        p := comp.procs[trust pop(work)]
        for i in comp.code[p.code:p.end]:
            g := callee(i, ids)
            if g < comp.procs.len and not live[g]:
                live[g] = true
                append(work, g)
    out: &str
    moved: &list[i64]
    for l in 0..comp.labels + 1:
        append(moved, 0)
    dropped: &list[bool]
    for i in comp.code:
        append(dropped, i.ghost)
    for t in 0..comp.reached:
        if aggregate(t):
            out += "type :t" + t + " = align " + comp.types[t].align + " { " + comp.types[t].size + " }\n"
    out += comp.c_defs
    out += comp.data
    for index, f in comp.procs:
        if not live[index]:
            continue
        out += "dbgfile \"" + replace(replace(view(comp.files[f.file].path), "\\", "\\\\"), "\"", "\\\"") + "\"\n"
        if f.export:
            out += "export "
        out += "function "
        if f.cls != 0:
            put_cls(out, f.cls)
            out += " "
        out += f.name + "("
        for k in f.params..f.params + f.count:
            if k > f.params:
                out += ", "
            put_cls(out, comp.passes[k].cls)
            out += " "
            put_arg(out, comp.passes[k].arg, f.temps)
        out += ") {\n@start\n"
        ended := false
        for k in f.code..f.end:
            i := comp.code[k]
            next := kept(dropped, k + 1, f.end)
            if i.op == "@" and ended and next < f.end and comp.code[next].op == "jmp" and landing(moved, comp.code[next].a.n) != i.a.n:
                moved[i.a.n] = comp.code[next].a.n
                dropped[k] = true
                dropped[next] = true
            if not dropped[k]:
                ended = i.op == "jmp" or i.op == "jnz" or i.op == "ret" or i.op == "hlt"
        shown: usize = 0
        line: usize = 0
        for k in f.code..f.end:
            i := comp.code[k]
            next := kept(dropped, k + 1, f.end)
            if dropped[k] or i.op == "jmp" and next < f.end and comp.code[next].op == "@" and comp.code[next].a.n == landing(moved, i.a.n):
                continue
            if i.pos != 0 and i.pos != shown and i.op != "@" and i.op != "alloc8":
                shown = i.pos
                if line_of(i.pos) != line:
                    line = line_of(i.pos)
                    out += "\tdbgloc " + line + ", " + (i.pos - line_start(i.pos) + 1) + "\n"
            if i.op == "@":
                out += "@L" + (i.a.n - i64(f.labels)) + "\n"
                continue
            out += "\t"
            if i.op == "jmp":
                out += "jmp @L" + (landing(moved, i.a.n) - i64(f.labels)) + "\n"
                continue
            if i.op == "jnz":
                out += "jnz "
                put_arg(out, i.a, f.temps)
                out += ", @L" + (landing(moved, i.b.n) - i64(f.labels)) + ", @L" + (landing(moved, i.c.n) - i64(f.labels)) + "\n"
                continue
            if i.to != 0:
                out += "%t" + (i.to - f.temps) + " ="
                put_cls(out, i.cls)
                out += " "
            out += i.op
            if i.op == "call":
                out += " "
                put_arg(out, i.a, f.temps)
                out += "("
                for j in i.first..i.first + i.count:
                    if j > i.first:
                        out += ", "
                    p := comp.passes[j]
                    if p.cls == 0:
                        out += "..."
                    else:
                        put_cls(out, p.cls)
                        out += " "
                        put_arg(out, p.arg, f.temps)
                out += ")\n"
                continue
            if i.a.kind != Empty:
                out += " "
                put_arg(out, i.a, f.temps)
            if i.b.kind != Empty:
                out += ", "
                put_arg(out, i.b, f.temps)
            if i.c.kind != Empty:
                out += ", "
                put_arg(out, i.c, f.temps)
            out += "\n"
        out += "}\n"
    return out

func callee(i: Ins, ids: &map[&strview, usize]) -> usize:
    if i.op != "call" or i.a.kind != Global or i.ghost:
        return comp.procs.len
    return ids[comp.globals[usize(i.a.n)]] ifnull comp.procs.len

func pooled(size: i64, pool: *&list[Ins], taken: *&list[usize]) -> Arg:
    k: usize = 0
    while k < pool.len and (pool[k].a.n != size or contains(taken.*, k)):
        k += 1
    if k == pool.len:
        comp.temps += 1
        append(pool, Ins{op = "alloc8", cls = L, to = comp.temps, a = int_arg(size)})
    append(taken, k)
    return Arg{Temp, i64(pool[k].to)}

func size(p: Proc) -> usize:
    count: usize = 0
    for i in comp.code[p.code:p.end]:
        count += usize(i.op != "alloc8" and i.op != "absent")
    return count

func fresh(first: u32, last: u32) -> &list[Arg]:
    names: &list[Arg]
    for k in first..last + 1:
        comp.temps += 1
        append(names, Arg{Temp, i64(comp.temps)})
    return names

func named(a: Arg, names: &list[Arg], first: u32) -> Arg:
    if a.kind != Temp:
        return a
    return names[usize(a.n) - usize(first)]

func renamed(i: Ins, names: &list[Arg], first: u32, labels: i64) -> Ins:
    if i.to != 0:
        i.to = u32(names[i.to - first].n)
    if i.op == "@" or i.op == "jmp":
        i.a.n += labels
    if i.op == "jnz":
        i.b.n += labels
        i.c.n += labels
    i.a = named(i.a, names, first)
    i.b = named(i.b, names, first)
    i.c = named(i.c, names, first)
    if i.op == "call":
        from := comp.passes.len
        for k in i.first..i.first + i.count:
            given := comp.passes[k]
            given.arg = named(given.arg, names, first)
            append(comp.passes, given)
        i.first = u32(from)
    return i

func kept(dropped: &list[bool], k: usize, end: usize) -> usize:
    while k < end and dropped[k]:
        k += 1
    return k

func landing(moved: &list[i64], to: i64) -> i64:
    while moved[to] != 0:
        to = moved[to]
    return to

func put_cls(out: *&str, c: u32):
    if c >= CAGG:
        out.* += ":c" + (c - CAGG)
        return
    if c >= AGG:
        out.* += ":t" + (c - AGG)
        return
    switch c:
    case W:
        out.* += "w"
    case L:
        out.* += "l"
    case S:
        out.* += "s"
    case D:
        out.* += "d"
    case SB:
        out.* += "sb"
    case UB:
        out.* += "ub"
    case SH:
        out.* += "sh"
    case:
        out.* += "uh"

func put_arg(out: *&str, a: Arg, first: u32):
    switch a.kind:
    case Temp:
        out.* += "%t" + (a.n - i64(first))
    case Const:
        out.* += a.n
    case Global:
        out.* += comp.globals[usize(a.n)]
    case Single, Double:
        if a.kind == Single:
            out.* += "s_"
        else:
            out.* += "d_"
        buf: array[u8, 40]
        printed: &strview
        printed = ptr(buf) as *bytes
        printed.len = usize(snprintf(ptr(buf) as *u8, 40, "%.17g", a.n as f64))
        out.* += printed
    case:
        return
