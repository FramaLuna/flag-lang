@trust
# comp.code holds the instructions of the backend, with blit and atomicexpected taking the three arguments of their
# pair, and these: a label starts a block, the five after it end one, and the marks after those only -memory reads
Olabel = OPS
Ojump = OPS + 1
Obranch = OPS + 2
Otable = OPS + 3
Oreturn = OPS + 4
Ohalt = OPS + 5
Oabsent = OPS + 6
Oended = OPS + 7
Oround = OPS + 8
Owalked = OPS + 9
Onarrowed = OPS + 10
Ocounted = OPS + 11
Oreused = OPS + 12
Opart = OPS + 13

AGG = 16 # the classes past those of the backend name a type: an aggregate of the program from AGG, and one of C from CAGG
CAGG = 1 << 30
SMALL = 35
CUT = 48 # bytes of a slot that chop cuts into registers
LARGE = 500
ROOMY = 4096 # bytes of slots, a page: a function with more is not inlined on its own, every caller's frame would take them
SNUG = 32 # the same into a recursive caller, each level of the recursion takes them: about what the call takes

func temp() -> Arg:
    comp.temps += 1
    append(comp.numbers, false)
    return Arg{Temp, i64(comp.temps)}

func label() -> u32:
    comp.labels += 1
    return comp.labels

func int_arg(n: i64) -> Arg:
    return Arg{Const, n}

func global(name: &strview) -> Arg:
    found := comp.global_ids[name]
    if found is i64:
        return Arg{Global, i64(found)}
    put(comp.global_ids, name, comp.globals.len)
    append(comp.globals, name)
    return Arg{Global, i64(comp.globals.len - 1)}

func is_number(a: Arg) -> bool:
    return a.kind != Temp or comp.numbers[a.n - 1]

func add(i: Ins) -> Arg:
    i.pos = comp.at
    append(comp.body, i)
    if i.to == 0:
        return Arg{}
    comp.numbers[i.to - 1] = i.number
    return Arg{Temp, i64(i.to)}

func op(cls: i64, o: i64, a: Arg, b: Arg) -> Arg:
    if (a.kind == Const or a.kind == Single or a.kind == Double) and (b.kind == Empty or b.kind == a.kind):
        known := computed(cls, o, a, b)
        if known.kind != Empty:
            return known
    return add(Ins{op = o, cls = cls, to = u32(temp().n), a = a, b = b})

func op1(cls: i64, o: i64, a: Arg) -> Arg:
    return op(cls, o, a, Arg{})

# the number that the backend would compute for an instruction on numbers the compiler knows, as it folds one, or nothing for one it leaves to the program
func computed(cls: i64, o: i64, left: Arg, right: Arg) -> Arg:
    float := left.kind != Const
    f := left.n as f64
    g := right.n as f64
    a := left.n
    b := right.n
    if cls == Float32 or cls == Float64:
        word := cls == Float32
        if float == (o >= Oi32tof and o <= Ocast): # only those take an integer
            return Arg{}
        r := 0.0
        switch o:
        case Oadd:
            r = f64(f32(f) + f32(g)) if word else f + g
        case Osub:
            r = f64(f32(f) - f32(g)) if word else f - g
        case Omul:
            r = f64(f32(f) * f32(g)) if word else f * g
        case Odiv:
            r = f64(f32(f) / f32(g)) if word else f / g
        case Oneg:
            r = -f
        case Oextf32, Otruncf64:
            r = f64(f32(f)) if word else f
        case Oi32tof, Oi64tof:
            if o == Oi32tof:
                a = a << 32 >> 32
            r = f64(f32(a)) if word else f64(a)
        case Ou32tof, Ou64tof:
            if o == Ou32tof:
                a = a and 0xffff_ffff
            r = f64(f32(u64(a))) if word else f64(u64(a))
        case Ocast:
            r = f64(u32(a) as f32) if word else a as f64
            if word and r != r: # an f32 holds as an f64, where a nan doesn't keep its bits
                return Arg{}
        case:
            return Arg{}
        return Arg{Single if word else Double, r as i64}
    if cls != Int32 and cls != Int64:
        return Arg{}
    k := cls
    c := 0
    _ = is_compare(o, ptr(k), ptr(c)) # a comparison works on the class it names
    word := k == Int32
    r := 0
    if float:
        switch o:
        case Oeqf32, Oeqf64:
            r = i64(f == g)
        case Onef32, Onef64:
            r = i64(f != g)
        case Oltf32, Oltf64:
            r = i64(f < g)
        case Olef32, Olef64:
            r = i64(f <= g)
        case Ogtf32, Ogtf64:
            r = i64(f > g)
        case Ogef32, Ogef64:
            r = i64(f >= g)
        case Of64toi, Of32toi:
            if not (f > (-2147483649.0 if word else -9223372036854777856.0) and f < (2147483648.0 if word else 9223372036854775808.0)): # out of its range each processor gives its own
                return Arg{}
            r = i64(f)
        case Of64tou, Of32tou:
            if not (f > -1.0 and f < (4294967296.0 if word else 18446744073709551616.0)):
                return Arg{}
            r = u64(f) as i64
        case Ocast:
            r = i64(f32(f) as u32) if word else a
        case:
            return Arg{}
        return int_arg(r << 32 >> 32 if word else r)
    if word:
        a = a << 32 >> 32
        b = b << 32 >> 32
    mask: u64 = 0xffff_ffff if word else 0xffff_ffff_ffff_ffff
    x := u64(a) and mask
    y := u64(b) and mask
    shift := b and (31 if word else 63)
    switch o:
    case Oadd:
        r = a + b
    case Osub:
        r = a - b
    case Omul:
        r = a * b
    case Oand:
        r = a and b
    case Oor:
        r = a or b
    case Oxor:
        r = a xor b
    case Oneg:
        r = 0 - a
    case Ocopy:
        r = a
    case Oshl:
        r = a << shift
    case Osar:
        r = a >> shift
    case Oshr:
        r = i64(x >> shift)
    case Odiv, Orem, Oudiv, Ourem:
        if b == 0:
            return Arg{}
        switch o:
        case Odiv:
            r = a / b
        case Orem:
            r = a % b
        case Oudiv:
            r = i64(x / y)
        case:
            r = i64(x % y)
    case Oeqi32, Oeqi64:
        r = i64(a == b)
    case Onei32, Onei64:
        r = i64(a != b)
    case Olti32, Olti64:
        r = i64(a < b)
    case Olei32, Olei64:
        r = i64(a <= b)
    case Ogti32, Ogti64:
        r = i64(a > b)
    case Ogei32, Ogei64:
        r = i64(a >= b)
    case Oltu32, Oltu64:
        r = i64(x < y)
    case Oleu32, Oleu64:
        r = i64(x <= y)
    case Ogtu32, Ogtu64:
        r = i64(x > y)
    case Ogeu32, Ogeu64:
        r = i64(x >= y)
    case Oexti8:
        r = a << 56 >> 56
    case Oextu8:
        r = a and 0xff
    case Oexti16:
        r = a << 48 >> 48
    case Oextu16:
        r = a and 0xffff
    case Oexti32:
        r = a << 32 >> 32
    case Oextu32:
        r = a and 0xffff_ffff
    case:
        return Arg{}
    return int_arg(r << 32 >> 32 if cls == Int32 else r)

func terminate(o: i64, a: Arg):
    add(Ins{op = o, a = a})
    comp.live = false

func jump(l: u32):
    if comp.live:
        add(Ins{op = Ojump, a = int_arg(i64(l))})
    comp.live = false

func branch(c: Arg, yes: u32, no: u32):
    add(Ins{op = Obranch, a = c, b = int_arg(i64(yes)), c = int_arg(i64(no))})
    comp.live = false

func open_block(l: u32):
    add(Ins{op = Olabel, a = int_arg(i64(l))})
    comp.live = true

func mention(name: &strview, a: Arg, type: i64, tok: i64):
    if a.kind != Temp:
        return
    pointer := Arg{}
    own := false
    for s in comp.slots:
        own = own or s.to == u32(a.n)
    if comp.debug and not own:
        pointer = alloc(U64) # a debugger reads the variable through it
        add(Ins{op = Ostorei64, a = a, b = pointer})
    append(comp.mentions, Mention{u32(a.n), name, type, tok, comp.scope, u32(pointer.n)})
    for k in reverse 0..comp.held.len:
        if comp.slots[comp.held[k]].to == u32(a.n):
            remove(comp.held, k) # the slot of a variable is never given back
            return

# inlines the small functions into their callers, keeps the functions that main, an export or a function value reaches,
# and threads their jumps
func shrink():
    ids: &map[&strview, i64] = heap({})
    defer free(ids)
    sizes: &list[i64] = heap([])
    defer free(sizes)
    rooms: &list[i64] = heap([])
    defer free(rooms)
    framed: &list[bool] = heap([])
    defer free(framed)
    for f in 0..comp.procs.len:
        p := comp.procs[f]
        if not comp.debug:
            large := p.end - p.code > LARGE
            top := p.labels
            for i in comp.code[p.code:p.end]:
                if i.op == Olabel and u32(i.a.n) > top:
                    top = u32(i.a.n)
            first := p.temps
            p.temps = comp.temps + 1
            names := fresh(first, p.last)
            hop := i64(comp.labels) - i64(p.labels)
            comp.labels += top - p.labels
            p.labels = u32(i64(p.labels) + hop)
            params := comp.passes.len
            for k in p.params..p.params + p.count:
                given := comp.passes[k]
                given.arg = named(given.arg, names, first)
                append(comp.passes, given)
            p.params = params
            slots: &list[Ins] = heap([])
            body: &list[Ins] = heap([])
            pool: &list[Ins] = heap([])
            for k in p.code..p.end:
                i := renamed(comp.code[k], names, first, hop)
                g := callee(i, ids)
                if g < f and (sizes[g] <= SMALL and not large and rooms[g] <= ROOMY and (rooms[g] <= SNUG or not p.recursive) or declared(comp.procs[g].node) == "inline") and not comp.procs[g].recursive and not framed[g] and not comp.procs[g].export:
                    q := comp.procs[g]
                    inner := fresh(q.temps, q.last)
                    taken: &list[i64] = heap([])
                    for j in 0..q.count:
                        want := comp.passes[q.params + j]
                        given := comp.passes[i.first + j]
                        at := want.arg.n - i64(q.temps)
                        inner[at] = given.arg
                        if want.cls >= AGG:
                            t := want.cls - AGG
                            inner[at] = pooled(Ins{op = alloc_op(t), a = int_arg(i64(room(t)))}, g, pool, taken)
                            append(body, Ins{op = Oblit, a = given.arg, b = inner[at], c = int_arg(i64(comp.types[t].size)), pos = i.pos})
                    if i.cls >= AGG:
                        append(slots, Ins{op = alloc_op(i.cls - AGG), cls = Int64, to = i.to, a = int_arg(room(i.cls - AGG))})
                    comp.labels += 1
                    after := comp.labels
                    jumped := false
                    for j in q.code..q.end:
                        c := comp.code[j]
                        if is_alloc(c.op):
                            inner[c.to - q.temps] = pooled(c, g, pool, taken)
                            continue
                        c = renamed(c, inner, q.temps, i64(after) - i64(q.labels))
                        if q.file != p.file:
                            c.pos = i.pos
                        if c.op == Olabel and u32(c.a.n) > comp.labels:
                            comp.labels = u32(c.a.n)
                        if c.op != Oreturn:
                            append(body, c)
                            continue
                        if i.cls >= AGG:
                            append(body, Ins{op = Oblit, a = c.a, b = Arg{Temp, i64(i.to)}, c = int_arg(comp.types[i.cls - AGG].size), pos = c.pos})
                        elif i.to != 0:
                            append(body, Ins{op = Ocopy, cls = i.cls, to = i.to, a = c.a, pos = c.pos})
                        if j + 1 < q.end:
                            append(body, Ins{op = Ojump, a = int_arg(i64(after)), pos = c.pos})
                            jumped = true
                    if jumped or comp.code[q.end - 1].op != Oreturn:
                        append(body, Ins{op = Olabel, a = int_arg(i64(after))})
                    free(inner)
                    free(taken)
                elif is_alloc(i.op):
                    append(slots, i)
                else:
                    append(body, i)
            p.code = comp.code.len
            append(comp.code, slots[:])
            append(comp.code, pool[:])
            append(comp.code, body[:])
            free(names)
            free(slots)
            free(pool)
            free(body)
            p.end = comp.code.len
            p.last = comp.temps
            comp.procs[f] = p
        put(ids, p.name, f)
        cut: &list[bool] = heap([]) # the temps that hold the address of a slot chop cuts into registers: what goes through them doesn't stay
        for t in p.temps..=p.last:
            append(cut, false)
        for k in p.params..p.params + p.count:
            given := comp.passes[k]
            if given.cls >= AGG and given.cls < CAGG and comp.types[given.cls - AGG].size <= CUT:
                cut[given.arg.n - i64(p.temps)] = true
        stays := 0
        room := 0
        frame := declared(p.node) == "noinline"
        for i in comp.code[p.code:p.end]:
            if is_alloc(i.op):
                room += i.a.n
                cut[i.to - p.temps] = i.a.n <= CUT
            elif i.op == Oadd and cut_at(cut, i.a, p.temps) and i.b.kind == Const:
                cut[i.to - p.temps] = true
            elif not (i.ghost or is_load(i.op) and cut_at(cut, i.a, p.temps) or is_store(i.op) and cut_at(cut, i.b, p.temps) or i.op == Oblit and cut_at(cut, i.a, p.temps) and cut_at(cut, i.b, p.temps)):
                stays += 1
            frame = frame or i.op == Ocall and i.a.kind == Global and comp.globals[i.a.n] == "$flag_frame" # it reads the frame of its caller, panic for the chain
        free(cut)
        append(sizes, stays)
        append(rooms, room)
        append(framed, frame)
    # the backend reads no ghost, nor a label after the end of a block that only jumps on: the jumps to it land where it
    # jumps
    moved: &list[i64] = heap([]) # where a jump to each label goes on to, or 0
    defer free(moved)
    for l in 0..=comp.labels:
        append(moved, 0)
    for f in 0..comp.procs.len:
        p := comp.procs[f]
        kept := p.code
        for i in comp.code[p.code:p.end]:
            if i.ghost:
                continue
            if i.op == Ojump and kept > p.code + 1 and comp.code[kept - 1].op == Olabel and comp.code[kept - 2].op >= Ojump and comp.code[kept - 2].op <= Ohalt and landing(moved, i.a.n) != comp.code[kept - 1].a.n:
                kept -= 1
                moved[comp.code[kept].a.n] = i.a.n
                continue
            comp.code[kept] = i
            kept += 1
        p.end = p.code
        for k in p.code..kept:
            i := comp.code[k]
            if i.op == Ojump:
                i.a.n = landing(moved, i.a.n)
            elif i.op == Obranch:
                i.b.n = landing(moved, i.b.n)
                i.c.n = landing(moved, i.c.n)
            elif i.op == Otable:
                for j in i.first..i.first + i.count:
                    comp.passes[j].arg.n = landing(moved, comp.passes[j].arg.n)
            if not (i.op == Ojump and k + 1 < kept and comp.code[k + 1].op == Olabel and comp.code[k + 1].a.n == i.a.n): # it would only fall through
                comp.code[p.end] = i
                p.end += 1
        comp.procs[f] = p
    live: &list[bool] = heap([])
    defer free(live)
    work: &list[i64] = heap([])
    defer free(work)
    for f in 0..comp.procs.len:
        p := comp.procs[f]
        append(live, exported(p) or comp.insts[p.inst].taken_as != VOID)
        if live[f]:
            append(work, f)
    used: &list[Arg] = heap([])
    defer free(used)
    while work.len > 0:
        p := comp.procs[trust pop(work)]
        for i in comp.code[p.code:p.end]:
            for a in operands(i, used): # where a function it calls or takes by address is
                g := comp.procs.len
                if a.kind == Global:
                    g = ids[comp.globals[a.n]] ifnull g
                if g < comp.procs.len and not live[g]:
                    live[g] = true
                    append(work, g)
    written: &list[Proc] = heap([])
    for index, f in comp.procs:
        if live[index]:
            append(written, f)
    comp.procs = written

func landing(moved: &list[i64], to: i64) -> i64:
    while moved[to] != 0:
        to = moved[to]
    return to

# what the outside calls: main and the exports of the program, those of the library are reached from the code that gives them to C by address
func exported(p: Proc) -> bool:
    return p.node != 0 and (p.inst == comp.entry or p.export and not comp.insts[p.inst].library)

# what an instruction reads, into used: a, b, c and the arguments of a call
func operands(i: Ins, used: *&list[Arg]) -> &listview[Arg]:
    clear(used)
    append(used, ptr([i.a, i.b, i.c]))
    if i.op == Ocall:
        for given in comp.passes[i.first:i.first + i.count]:
            append(used, given.arg)
    return used.*

func callee(i: Ins, ids: &map[&strview, i64]) -> i64:
    if i.op != Ocall or i.a.kind != Global or i.ghost:
        return comp.procs.len
    return ids[comp.globals[i.a.n]] ifnull comp.procs.len

# the inlined bodies of one function share their slots: those of another may give their address to a call, and the backend would keep the shared slot whole
func pooled(slot: Ins, callee: i64, pool: *&list[Ins], taken: *&list[i64]) -> Arg:
    k := 0
    while k < pool.len and (pool[k].a.n != slot.a.n or pool[k].op != slot.op or pool[k].first != u32(callee) or contains(taken.*, k)):
        k += 1
    if k == pool.len:
        comp.temps += 1
        append(pool, Ins{op = slot.op, cls = Int64, to = comp.temps, a = slot.a, first = u32(callee)})
    append(taken, k)
    return Arg{Temp, i64(pool[k].to)}

func cut_at(cut: &list[bool], a: Arg, first: u32) -> bool:
    return a.kind == Temp and cut[a.n - i64(first)]

func fresh(first: u32, last: u32) -> &list[Arg]:
    names: &list[Arg] = heap([])
    for k in first..=last:
        comp.temps += 1
        append(names, Arg{Temp, i64(comp.temps)})
    return names

func named(a: Arg, names: &list[Arg], first: u32) -> Arg:
    if a.kind != Temp:
        return a
    return names[a.n - i64(first)]

func renamed(i: Ins, names: &list[Arg], first: u32, labels: i64) -> Ins:
    if i.to != 0:
        i.to = u32(names[i.to - first].n)
    if i.op == Olabel or i.op == Ojump:
        i.a.n += labels
    if i.op == Obranch:
        i.b.n += labels
        i.c.n += labels
    i.a = named(i.a, names, first)
    i.b = named(i.b, names, first)
    i.c = named(i.c, names, first)
    if i.op == Ocall or i.op == Otable: # the arguments of a call, or the labels of a jump table
        from := comp.passes.len
        for k in i.first..i.first + i.count:
            given := comp.passes[k]
            if i.op == Otable:
                given.arg.n += labels
            given.arg = named(given.arg, names, first)
            append(comp.passes, given)
        i.first = u32(from)
    return i
