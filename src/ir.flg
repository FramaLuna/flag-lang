@trust
W = 1
L = 2
S = 3
D = 4
SB = 5
UB = 6
SH = 7
UH = 8
V = 9
AGG = 16
CAGG = 1 << 30
SMALL = 35
CUT = 48 # bytes of a slot that QBE cuts into registers
LARGE = 500
ROOMY = 4096 # bytes of slots, a page: a function with more is not inlined on its own, every caller's frame would take them
SNUG = 32 # the same into a recursive caller, each level of the recursion takes them: about what the call takes

func temp() -> Arg:
    comp.temps += 1
    append(comp.numbers, false)
    return Arg{Temp, i64(comp.temps)}

func label() -> u32:
    comp.labels += 1
    return comp.labels

func int_arg(n: i64) -> Arg:
    return Arg{Const, n}

func global(name: &strview) -> Arg:
    found := comp.global_ids[name]
    if found is i64:
        return Arg{Global, i64(found)}
    put(comp.global_ids, name, comp.globals.len)
    append(comp.globals, name)
    return Arg{Global, i64(comp.globals.len - 1)}

func is_number(a: Arg) -> bool:
    return a.kind != Temp or comp.numbers[a.n - 1]

func add(i: Ins) -> Arg:
    i.pos = comp.at
    append(comp.body, i)
    if i.to == 0:
        return Arg{}
    comp.numbers[i.to - 1] = i.number
    return Arg{Temp, i64(i.to)}

func op(cls: u32, name: &strview, a: Arg, b: Arg) -> Arg:
    if (a.kind == Const or a.kind == Single or a.kind == Double) and (b.kind == Empty or b.kind == a.kind):
        known := computed(cls, name, a, b)
        if known.kind != Empty:
            return known
    return add(Ins{op = name, cls = cls, to = u32(temp().n), a = a, b = b})

func op1(cls: u32, name: &strview, a: Arg) -> Arg:
    return op(cls, name, a, Arg{})

# the number that QBE would compute for an instruction on numbers the compiler knows, as it folds one, or nothing for one it leaves to the program
func computed(cls: u32, name: &strview, left: Arg, right: Arg) -> Arg:
    float := left.kind != Const
    f := left.n as f64
    g := right.n as f64
    a := left.n
    b := right.n
    if cls == S or cls == D:
        word := cls == S
        if float == (ends_with(name, "tof") or name == "cast"): # only those take an integer
            return Arg{}
        r := 0.0
        switch name:
        case "add":
            r = f64(f32(f) + f32(g)) if word else f + g
        case "sub":
            r = f64(f32(f) - f32(g)) if word else f - g
        case "mul":
            r = f64(f32(f) * f32(g)) if word else f * g
        case "div":
            r = f64(f32(f) / f32(g)) if word else f / g
        case "neg":
            r = -f
        case "exts", "truncd":
            r = f64(f32(f)) if word else f
        case "swtof", "sltof":
            if name == "swtof":
                a = a << 32 >> 32
            r = f64(f32(a)) if word else f64(a)
        case "uwtof", "ultof":
            if name == "uwtof":
                a = a and 0xffff_ffff
            r = f64(f32(u64(a))) if word else f64(u64(a))
        case "cast":
            r = f64(u32(a) as f32) if word else a as f64
            if word and r != r: # an f32 holds as an f64, where a nan doesn't keep its bits
                return Arg{}
        case:
            return Arg{}
        return Arg{Single if word else Double, r as i64}
    if cls != W and cls != L:
        return Arg{}
    o := name
    word := cls == W
    if starts_with(name, "c") and (ends_with(name, "w") or ends_with(name, "l") or float and name != "cast"): # a comparison names the class of what it compares
        o = name[:name.len - 1]
        word = ends_with(name, "w")
    r := 0
    if float:
        switch o:
        case "ceq":
            r = i64(f == g)
        case "cne":
            r = i64(f != g)
        case "clt":
            r = i64(f < g)
        case "cle":
            r = i64(f <= g)
        case "cgt":
            r = i64(f > g)
        case "cge":
            r = i64(f >= g)
        case "dtosi", "stosi":
            if not (f > (-2147483649.0 if cls == W else -9223372036854777856.0) and f < (2147483648.0 if cls == W else 9223372036854775808.0)): # out of its range each processor gives its own
                return Arg{}
            r = i64(f)
        case "dtoui", "stoui":
            if not (f > -1.0 and f < (4294967296.0 if cls == W else 18446744073709551616.0)):
                return Arg{}
            r = u64(f) as i64
        case "cast":
            r = i64(f32(f) as u32) if cls == W else a
        case:
            return Arg{}
        return int_arg(r << 32 >> 32 if cls == W else r)
    if word:
        a = a << 32 >> 32
        b = b << 32 >> 32
    mask: u64 = 0xffff_ffff if word else 0xffff_ffff_ffff_ffff
    x := u64(a) and mask
    y := u64(b) and mask
    shift := b and (31 if word else 63)
    switch o:
    case "add":
        r = a + b
    case "sub":
        r = a - b
    case "mul":
        r = a * b
    case "and":
        r = a and b
    case "or":
        r = a or b
    case "xor":
        r = a xor b
    case "neg":
        r = 0 - a
    case "copy":
        r = a
    case "shl":
        r = a << shift
    case "sar":
        r = a >> shift
    case "shr":
        r = i64(x >> shift)
    case "div", "rem", "udiv", "urem":
        if b == 0:
            return Arg{}
        switch o:
        case "div":
            r = a / b
        case "rem":
            r = a % b
        case "udiv":
            r = i64(x / y)
        case:
            r = i64(x % y)
    case "ceq":
        r = i64(a == b)
    case "cne":
        r = i64(a != b)
    case "cslt":
        r = i64(a < b)
    case "csle":
        r = i64(a <= b)
    case "csgt":
        r = i64(a > b)
    case "csge":
        r = i64(a >= b)
    case "cult":
        r = i64(x < y)
    case "cule":
        r = i64(x <= y)
    case "cugt":
        r = i64(x > y)
    case "cuge":
        r = i64(x >= y)
    case "extsb":
        r = a << 56 >> 56
    case "extub":
        r = a and 0xff
    case "extsh":
        r = a << 48 >> 48
    case "extuh":
        r = a and 0xffff
    case "extsw":
        r = a << 32 >> 32
    case "extuw":
        r = a and 0xffff_ffff
    case:
        return Arg{}
    return int_arg(r << 32 >> 32 if cls == W else r)

func terminate(name: &strview, a: Arg):
    add(Ins{op = name, a = a})
    comp.live = false

func jump(l: u32):
    if comp.live:
        add(Ins{op = "jmp", a = int_arg(i64(l))})
    comp.live = false

func branch(c: Arg, yes: u32, no: u32):
    add(Ins{op = "jnz", a = c, b = int_arg(i64(yes)), c = int_arg(i64(no))})
    comp.live = false

func open_block(l: u32):
    add(Ins{op = "@", a = int_arg(i64(l))})
    comp.live = true

func mention(name: &strview, a: Arg, type: i64, tok: i64):
    if a.kind != Temp:
        return
    pointer := Arg{}
    own := false
    for s in comp.slots:
        own = own or s.to == u32(a.n)
    if comp.debug and not own:
        pointer = alloc(U64) # a debugger reads the variable through it
        add(Ins{op = "storel", a = a, b = pointer})
    append(comp.mentions, Mention{u32(a.n), name, type, tok, comp.scope, u32(pointer.n)})
    for k in reverse 0..comp.held.len:
        if comp.slots[comp.held[k]].to == u32(a.n):
            remove(comp.held, k) # the slot of a variable is never given back
            return

# inlines the small functions into their callers, and keeps the functions that main, an export or a function value reaches
func shrink():
    ids: &map[&strview, i64] = heap({})
    defer free(ids)
    sizes: &list[i64] = heap([])
    defer free(sizes)
    rooms: &list[i64] = heap([])
    defer free(rooms)
    framed: &list[bool] = heap([])
    defer free(framed)
    for f in 0..comp.procs.len:
        p := comp.procs[f]
        if not comp.debug:
            large := p.end - p.code > LARGE
            top := p.labels
            for i in comp.code[p.code:p.end]:
                if i.op == "@" and u32(i.a.n) > top:
                    top = u32(i.a.n)
            first := p.temps
            p.temps = comp.temps + 1
            names := fresh(first, p.last)
            hop := i64(comp.labels) - i64(p.labels)
            comp.labels += top - p.labels
            p.labels = u32(i64(p.labels) + hop)
            params := comp.passes.len
            for k in p.params..p.params + p.count:
                given := comp.passes[k]
                given.arg = named(given.arg, names, first)
                append(comp.passes, given)
            p.params = params
            slots: &list[Ins] = heap([])
            body: &list[Ins] = heap([])
            pool: &list[Ins] = heap([])
            for k in p.code..p.end:
                i := renamed(comp.code[k], names, first, hop)
                g := callee(i, ids)
                if g < f and (sizes[g] <= SMALL and not large and rooms[g] <= ROOMY and (rooms[g] <= SNUG or not p.recursive) or declared(comp.procs[g].node) == "inline") and not comp.procs[g].recursive and not framed[g] and not comp.procs[g].export:
                    q := comp.procs[g]
                    inner := fresh(q.temps, q.last)
                    taken: &list[i64] = heap([])
                    for j in 0..q.count:
                        want := comp.passes[q.params + j]
                        given := comp.passes[i.first + j]
                        at := want.arg.n - i64(q.temps)
                        inner[at] = given.arg
                        if want.cls >= AGG:
                            t := i64(want.cls - AGG)
                            inner[at] = pooled(Ins{op = alloc_op(t), a = int_arg(i64(room(t)))}, g, pool, taken)
                            append(body, Ins{op = "blit", a = given.arg, b = inner[at], c = int_arg(i64(comp.types[t].size)), pos = i.pos})
                    if i.cls >= AGG:
                        append(slots, Ins{op = alloc_op(i.cls - AGG), cls = L, to = i.to, a = int_arg(room(i.cls - AGG))})
                    comp.labels += 1
                    after := comp.labels
                    jumped := false
                    for j in q.code..q.end:
                        c := comp.code[j]
                        if starts_with(c.op, "alloc"):
                            inner[c.to - q.temps] = pooled(c, g, pool, taken)
                            continue
                        c = renamed(c, inner, q.temps, i64(after) - i64(q.labels))
                        if q.file != p.file:
                            c.pos = i.pos
                        if c.op == "@" and u32(c.a.n) > comp.labels:
                            comp.labels = u32(c.a.n)
                        if c.op != "ret":
                            append(body, c)
                            continue
                        if i.cls >= AGG:
                            append(body, Ins{op = "blit", a = c.a, b = Arg{Temp, i64(i.to)}, c = int_arg(comp.types[i64(i.cls - AGG)].size), pos = c.pos})
                        elif i.to != 0:
                            append(body, Ins{op = "copy", cls = i.cls, to = i.to, a = c.a, pos = c.pos})
                        if j + 1 < q.end:
                            append(body, Ins{op = "jmp", a = int_arg(i64(after)), pos = c.pos})
                            jumped = true
                    if jumped or comp.code[q.end - 1].op != "ret":
                        append(body, Ins{op = "@", a = int_arg(i64(after))})
                    free(inner)
                    free(taken)
                elif starts_with(i.op, "alloc"):
                    append(slots, i)
                else:
                    append(body, i)
            p.code = comp.code.len
            append(comp.code, slots[:])
            append(comp.code, pool[:])
            append(comp.code, body[:])
            free(names)
            free(slots)
            free(pool)
            free(body)
            p.end = comp.code.len
            p.last = comp.temps
            comp.procs[f] = p
        put(ids, p.name, f)
        cut: &list[bool] = heap([]) # the temps that hold the address of a slot QBE cuts into registers: what goes through them doesn't stay
        for t in p.temps..=p.last:
            append(cut, false)
        for k in p.params..p.params + p.count:
            given := comp.passes[k]
            if given.cls >= AGG and given.cls < CAGG and comp.types[given.cls - AGG].size <= CUT:
                cut[given.arg.n - i64(p.temps)] = true
        stays := 0
        room := 0
        frame := declared(p.node) == "noinline"
        for i in comp.code[p.code:p.end]:
            if starts_with(i.op, "alloc"):
                room += i.a.n
                cut[i.to - p.temps] = i.a.n <= CUT
            elif i.op == "add" and cut_at(cut, i.a, p.temps) and i.b.kind == Const:
                cut[i.to - p.temps] = true
            elif not (i.ghost or starts_with(i.op, "load") and cut_at(cut, i.a, p.temps) or starts_with(i.op, "store") and cut_at(cut, i.b, p.temps) or i.op == "blit" and cut_at(cut, i.a, p.temps) and cut_at(cut, i.b, p.temps)):
                stays += 1
            frame = frame or i.op == "call" and i.a.kind == Global and comp.globals[i.a.n] == "$flag_frame" # it reads the frame of its caller, panic for the chain
        free(cut)
        append(sizes, stays)
        append(rooms, room)
        append(framed, frame)
    live: &list[bool] = heap([])
    defer free(live)
    work: &list[i64] = heap([])
    defer free(work)
    for f in 0..comp.procs.len:
        p := comp.procs[f]
        append(live, exported(p) or comp.insts[p.inst].taken_as != VOID)
        if live[f]:
            append(work, f)
    used: &list[Arg] = heap([])
    defer free(used)
    while work.len > 0:
        p := comp.procs[trust pop(work)]
        for i in comp.code[p.code:p.end]:
            for a in operands(i, used): # where a function it calls or takes by address is
                g := comp.procs.len
                if a.kind == Global:
                    g = ids[comp.globals[a.n]] ifnull g
                if g < comp.procs.len and not live[g]:
                    live[g] = true
                    append(work, g)
    written: &list[Proc] = heap([])
    for index, f in comp.procs:
        if live[index]:
            append(written, f)
    comp.procs = written

# what the outside calls: main and the exports of the program, those of the library are reached from the code that gives them to C by address
func exported(p: Proc) -> bool:
    return p.node != 0 and (p.inst == comp.entry or p.export and not comp.insts[p.inst].library)

# what an instruction reads, into used: a, b, c and the arguments of a call, and nothing of a ghost
func operands(i: Ins, used: *&list[Arg]) -> &listview[Arg]:
    clear(used)
    if not i.ghost:
        append(used, ptr([i.a, i.b, i.c]))
    if not i.ghost and i.op == "call":
        for given in comp.passes[i.first:i.first + i.count]:
            append(used, given.arg)
    return used.*

func callee(i: Ins, ids: &map[&strview, i64]) -> i64:
    if i.op != "call" or i.a.kind != Global or i.ghost:
        return comp.procs.len
    return ids[comp.globals[i.a.n]] ifnull comp.procs.len

# the inlined bodies of one function share their slots: those of another may give their address to a call, and QBE would keep the shared slot whole
func pooled(slot: Ins, callee: i64, pool: *&list[Ins], taken: *&list[i64]) -> Arg:
    k := 0
    while k < pool.len and (pool[k].a.n != slot.a.n or pool[k].op != slot.op or pool[k].first != u32(callee) or contains(taken.*, k)):
        k += 1
    if k == pool.len:
        comp.temps += 1
        append(pool, Ins{op = slot.op, cls = L, to = comp.temps, a = slot.a, first = u32(callee)})
    append(taken, k)
    return Arg{Temp, i64(pool[k].to)}

func cut_at(cut: &list[bool], a: Arg, first: u32) -> bool:
    return a.kind == Temp and cut[a.n - i64(first)]

func fresh(first: u32, last: u32) -> &list[Arg]:
    names: &list[Arg] = heap([])
    for k in first..=last:
        comp.temps += 1
        append(names, Arg{Temp, i64(comp.temps)})
    return names

func named(a: Arg, names: &list[Arg], first: u32) -> Arg:
    if a.kind != Temp:
        return a
    return names[a.n - i64(first)]

func renamed(i: Ins, names: &list[Arg], first: u32, labels: i64) -> Ins:
    if i.to != 0:
        i.to = u32(names[i.to - first].n)
    if i.op == "@" or i.op == "jmp":
        i.a.n += labels
    if i.op == "jnz":
        i.b.n += labels
        i.c.n += labels
    i.a = named(i.a, names, first)
    i.b = named(i.b, names, first)
    i.c = named(i.c, names, first)
    if i.op == "call" or i.op == "jt": # the arguments of a call, or the labels of a jump table
        from := comp.passes.len
        for k in i.first..i.first + i.count:
            given := comp.passes[k]
            if i.op == "jt":
                given.arg.n += labels
            given.arg = named(given.arg, names, first)
            append(comp.passes, given)
        i.first = u32(from)
    return i
