@trust
func lex(file: usize) -> Fail?:
    code := comp.files[file].code
    base := comp.files[file].start
    bytes := items(code)
    nothing: &strview
    opens: &list[usize]
    defer free(opens)
    scopes: &list[usize]
    defer free(scopes)
    limits: &list[usize]
    defer free(limits)
    head: usize = 0
    width: usize = 0
    at: usize = 0
    line: usize = 1
    newline := true
    while true:
        if newline:
            newline = false
            start := at
            while at < code.len and (bytes[at] == ' ' or bytes[at] == '\t'):
                at += 1
            if opens.len == 0 and at < code.len and bytes[at] != '\n' and bytes[at] != '\r' and bytes[at] != '#':
                while limits.len > 0 and at - start < limits[-1]:
                    comp.trusted[trust pop(scopes)].to = base + at
                    limits.len -= 1
                head = base + at
                width = at - start
                append(comp.tokens, Token{Line, code[start:at], base + at, line})
        if at >= code.len:
            break
        b := bytes[at]
        start := at
        if b == '\n':
            newline = true
            line += 1
            at += 1
        elif b == ' ' or b == '\t':
            at += 1
        elif b == '\r':
            at += 1
            if at >= code.len or bytes[at] != '\n':
                return fail("this \\r is not followed by \\n, a line ends with \\n or with \\r\\n", base + start)
        elif b == '#':
            while at < code.len and bytes[at] != '\n':
                at += 1
        elif is_letter(b):
            while at < code.len and (is_letter(bytes[at]) or is_digit(bytes[at])):
                at += 1
            append(comp.tokens, Token{Name, code[start:at], base + start, line})
        elif b == '@' or b == '$':
            at += 1
            if b == '$' and at < code.len and bytes[at] == '$':
                at += 1
            if at >= code.len or not is_letter(bytes[at]):
                return fail("'" + code[start:at] + "' expects a name after it", base + start)
            while at < code.len and (is_letter(bytes[at]) or is_digit(bytes[at])):
                at += 1
            rest := at
            while rest < code.len and (bytes[rest] == ' ' or bytes[rest] == '\t' or bytes[rest] == '\r'):
                rest += 1
            marker := code[start:at] == "@trust" or code[start:at] == "@check"
            if marker and (opens.len > 0 or rest < code.len and bytes[rest] != '\n' and bytes[rest] != '#'):
                what: &strview = " goes at the end of a line or on a line of its own"
                if opens.len > 0:
                    what = " marks whole lines, it goes after the last bracket closes and not inside"
                return fail(code[start:at] + what, base + start)
            if marker:
                limit := width + 1
                if comp.tokens[-1].kind == Line:
                    comp.tokens.len -= 1
                    limit = width
                append(scopes, comp.trusted.len)
                append(limits, limit)
                append(comp.trusted, Trust{head, 0, code[start:at] == "@check"})
            elif b == '@':
                append(comp.tokens, Token{Builtin, code[start:at], base + start, line})
            else:
                append(comp.tokens, Token{Generic, code[start:at], base + start, line})
        elif is_digit(b):
            kind: TokenKind = Int
            if b == '0' and at + 1 < code.len and (bytes[at + 1] == 'x' or bytes[at + 1] == 'b'):
                hex := bytes[at + 1] == 'x'
                at += 2
                while at < code.len and (is_letter(bytes[at]) or is_digit(bytes[at])):
                    c := bytes[at]
                    if c == '_' and at > start + 2 and bytes[at - 1] != '_' and at + 1 < code.len and (is_letter(bytes[at + 1]) or is_digit(bytes[at + 1])):
                        at += 1
                        continue
                    if hex and not is_hex(c):
                        return fail("invalid character '" + code[at:at + 1] + "' in the hexadecimal number " + code[start:at + 1], base + at)
                    if not hex and c != '0' and c != '1':
                        return fail("invalid character '" + code[at:at + 1] + "' in the binary number " + code[start:at + 1], base + at)
                    at += 1
                if at == start + 2:
                    return fail("'" + code[start:at] + "' expects digits after it", base + start)
            else:
                exponent := false
                while at < code.len:
                    c := bytes[at]
                    if is_digit(c) or c == '_' and is_digit(bytes[at - 1]) and at + 1 < code.len and is_digit(bytes[at + 1]):
                        at += 1
                    elif c == '.' and kind == Int and at + 1 < code.len and is_digit(bytes[at + 1]):
                        kind = Float
                        at += 1
                    elif (c == 'e' or c == 'E') and not exponent:
                        exponent = true
                        kind = Float
                        at += 1
                        if at < code.len and (bytes[at] == '+' or bytes[at] == '-'):
                            at += 1
                        if at >= code.len or not is_digit(bytes[at]):
                            return fail("the exponent of " + code[start:at] + " expects digits after it", base + at)
                    elif is_letter(c) or c == '.' and at + 1 < code.len and is_digit(bytes[at + 1]):
                        return fail("invalid character '" + code[at:at + 1] + "' in the number " + code[start:at + 1], base + at)
                    else:
                        break
            append(comp.tokens, Token{kind, code[start:at], base + start, line})
        elif b == '\'':
            at += 1
            if at < code.len and bytes[at] == '\\':
                at = try escape_end(code, at, base)
            if at + 1 < code.len and bytes[at] < ' ' and bytes[at + 1] == '\'':
                return fail("a character literal cannot hold the raw byte " + printable(code, at) + ", write it as an escape: '" + printable(code, at) + "'", base + start)
            if at + 1 >= code.len or bytes[at] < ' ' or bytes[at] > '~' or bytes[at + 1] != '\'':
                return fail("a character literal holds one ASCII character: 'a'", base + start)
            at += 2
            append(comp.tokens, Token{Int, code[start:at], base + start, line})
        elif b == '"':
            at += 1
            while at < code.len and bytes[at] != '"' and bytes[at] != '\n':
                if bytes[at] == '\\':
                    at = try escape_end(code, at, base)
                at += 1
            if at >= code.len or bytes[at] != '"':
                return fail("this text literal never closes, it expects a '\"' before the end of the line", base + start)
            at += 1
            append(comp.tokens, Token{Str, code[start:at], base + start, line})
        else:
            pair := code[start:start + 1]
            if at + 1 < code.len:
                pair = code[start:start + 2]
            switch pair:
            case "==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "%=", "->", ":=", "..", ".*", "<<", ">>", "||":
                at += 2
            case "<+":
                return fail("'<+' is gone, append to a &str with +=: s += x", base + start)
            case "&&":
                return fail("'&&' is not an operator, write: and", base + start)
            case:
                one := code[start:start + 1]
                switch one:
                case "+", "-", "*", "/", "%", "=", "<", ">", "&", "|", "?", ":", ".", ",", "(", ")", "{", "}", "[", "]":
                    at += 1
                case "!":
                    return fail("'!' is not an operator, write: not", base + start)
                case:
                    return fail("invalid character '" + printable(code, start) + "'", base + start)
            append(comp.tokens, Token{Symbol, code[start:at], base + start, line})
            if b == '(' or b == '[' or b == '{':
                append(opens, start)
            elif b == ')' or b == ']' or b == '}':
                if opens.len == 0:
                    return fail("unexpected '" + code[start:at] + "' with nothing open to close", base + start)
                opener := opens[-1]
                opens.len -= 1
                if b == ')' and bytes[opener] != '(' or b == ']' and bytes[opener] != '[' or b == '}' and bytes[opener] != '{':
                    return fail("unexpected '" + code[start:at] + "', the bracket open here is '" + code[opener:opener + 1] + "'", base + start)
    if opens.len > 0:
        return fail("this bracket never closes", base + opens[-1])
    append(comp.tokens, Token{Line, nothing, base + code.len, line})
    append(comp.tokens, Token{End, nothing, base + code.len, line})
    append(comp.tokens, Token{End, nothing, base + code.len, line})
    append(comp.tokens, Token{End, nothing, base + code.len, line})
    for k in scopes:
        comp.trusted[k].to = base + code.len
    return null

func is_letter(b: u8) -> bool:
    return b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b == '_'

func is_digit(b: u8) -> bool:
    return b >= '0' and b <= '9'

func is_hex(b: u8) -> bool:
    return is_digit(b) or b >= 'a' and b <= 'f' or b >= 'A' and b <= 'F'

func escape_end(code: &strview, slash: usize, base: usize) -> usize|Fail:
    bytes := items(code)
    last := slash + 1
    if last >= code.len or bytes[last] == '\n' or bytes[last] == '\r':
        return slash
    b := bytes[last]
    if b == 'x':
        last += 2
        if last >= code.len or not is_hex(bytes[last - 1]) or not is_hex(bytes[last]):
            return fail("\\x expects two hexadecimal digits: \\x41", base + slash)
    elif not (b == 'n' or b == 't' or b == 'r' or b == '0' or b == 'e' or b == '\\' or b == '"' or b == '\''):
        return fail("unknown escape sequence '\\" + printable(code, last) + "', the escapes are \\n \\t \\r \\0 \\e \\\\ \\\" \\' and \\x41", base + slash)
    return last

func printable(code: &strview, at: usize) -> &strview:
    b := items(code)[at]
    if b >= ' ' and b <= '~':
        return code[at:at + 1]
    tail: usize = 0
    while at + tail + 1 < code.len and (items(code)[at + tail + 1] and 0xc0) == 0x80:
        tail += 1
    if b >= 0xc0 and tail == 1 + usize(b >= 0xe0) + usize(b >= 0xf0):
        return code[at:at + tail + 1]
    digits: &strview = "0123456789abcdef"
    return "\\x" + digits[b >> 4:(b >> 4) + 1] + digits[b and 15:(b and 15) + 1]
