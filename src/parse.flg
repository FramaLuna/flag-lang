@trust
use fs

func parse() -> Fail?:
    file := comp.files.len - 1
    first := comp.pos
    module: &strview
    header := true
    while here().kind != End:
        t := here()
        if t.kind == Line:
            if t.text.len != 0:
                return fail("a declaration starts at the first column", t.at)
            comp.pos += 1
            continue
        if t.text == "module" and comp.pos == first + 1 or t.text == "use" and header:
            comp.pos += 1
            given := here().text
            at := here().at
            folder: &strview
            if t.text == "use" and here().kind == Str:
                folder = unquoted(given)
                while folder.len > 1 and ends_with(folder, "/"):
                    folder = folder[:-1]
                given = base_name(folder)
                if ends_with(given, ".flg"):
                    return fail("a use in quotes names a folder, not a file: put " + given + " in a folder " + folder[:-4] + " and write use \"" + folder[:-4] + "\"", at)
                valid := given.len > 0 and is_letter(items(given)[0]) and not reserved(given)
                for b in items(given):
                    valid = valid and (is_letter(b) or is_digit(b))
                if not valid:
                    return fail("'" + given + "' cannot name a module, the last folder of a use names its module: rename the folder", at)
                if not starts_with(folder, "/") and not (@windows() and contains(folder, ":")):
                    path := view(comp.files[file].path)
                    folder = join_path(path[:path.len - base_name(path).len], folder)
            elif here().kind != Name:
                return unexpected(t.text + " expects the name of a module after it")
            reached := layered(given, file)
            if t.text == "module":
                try new_name(false)
                module = reached
                comp.files[file].module = reached
            comp.pos += 1
            if t.text == "use":
                name := given
                alias: &strview
                if peek("as"):
                    comp.pos += 1
                    if here().kind != Name:
                        return unexpected("as expects the name this file gives the module: use fs as files")
                    try new_name(false)
                    alias = here().text
                    name = alias
                    comp.pos += 1
                if reached == module:
                    return fail("this file is part of module " + given + ", it sees its names without use", t.at)
                if module_of(name, file).len > 0:
                    return fail(name + " already names a module in this file", t.at)
                append(comp.uses, Use{file, reached, alias, at, folder})
            try end_line()
            continue
        header = false
        try declaration(module, true)
    while comp.pos < comp.tokens.len and here().kind == End:
        comp.pos += 1
    return null

# kept is false inside a where block that does not hold on the target: its declarations are read and dropped
func declaration(module: &strview, kept: bool) -> Fail?:
    file := comp.files.len - 1
    t := here()
    after := comp.tokens[comp.pos + 1]
    if t.text == "module" and after.kind == Name:
        return fail("module goes on the first line of its file", t.at)
    if t.text == "use" and (after.kind == Name or after.kind == Str):
        return fail("use goes in the header of the file, before the first declaration", t.at)
    if where_block():
        holds := try on_target()
        try deeper(t.at)
        try expect(":")
        outer := comp.width
        inner := here().text.len
        if here().kind != Line or inner <= outer:
            return fail("':' expects an indented block of declarations after it", comp.tokens[comp.pos - 1].at)
        comp.width = inner
        while try next_line(outer, inner):
            try declaration(module, kept and holds)
        comp.width = outer
        comp.depth -= 1
        return null
    sym := Sym{module = module, library = comp.files[file].library}
    sym.priv = t.text == "priv"
    if sym.priv:
        sym.module = comp.files[file].module
        comp.pos += 1
    sym.packed = peek("packed")
    sym.export = peek("export")
    inline := peek("inline")
    noinline := peek("noinline")
    after = comp.tokens[comp.pos + 1]
    if sym.export and after.text == "inline" or inline and after.text == "export":
        return fail("an export function cannot be inline, other languages call it and cannot take its body", here().at)
    if inline and after.text == "noinline" or noinline and after.text == "inline":
        return fail("a function is inline or noinline, not both", here().at)
    if sym.export and after.text != "func":
        return fail("export goes before a func declaration: export func name():", here().at)
    if inline and after.text != "func" and after.text != "operator":
        return fail("inline goes before a func or an operator declaration: inline func name():", here().at)
    if noinline and after.text != "func" and after.text != "operator":
        return fail("noinline goes before a func or an operator declaration: noinline func name():", here().at)
    shared := peek("shared") and after.kind == Name # the word before a context, and not a constant named shared
    inherited := peek("inherited") and after.kind == Name
    if shared and after.text == "inherited" or inherited and after.text == "shared":
        return fail("a context is one for each thread or one for all of them, so it is shared or inherited, not both", here().at)
    if shared and after.text != "context":
        return fail("shared goes before a context: shared context name:", here().at)
    if inherited and after.text != "context":
        return fail("inherited goes before a context: inherited context name:", here().at)
    if sym.packed or sym.export or inline or noinline or shared or inherited:
        comp.pos += 1
    t = here()
    after = comp.tokens[comp.pos + 1]
    n := comp.nodes.len
    if t.text == "type" or t.text == "context":
        comp.pos += 1
        sym.error = t.text == "type" and peek("error")
        if sym.error:
            comp.pos += 1
        form := t.text
        if t.text == "type" and (peek("enum") or peek("fatptr")):
            form = here().text
            comp.pos += 1
        if here().kind != Name:
            return unexpected("a type declaration expects a name")
        try new_name(false)
        begin(Void, comp.pos)
        comp.pos += 1
        if peek("[") and (form == "context" or form == "enum"):
            why: &strview = "its variants carry no data to shape"
            if form == "context":
                why = "it is one value and not a family of types"
            return fail(form + " " + text(n) + " cannot have type parameters, " + why, here().at)
        if peek("["):
            comp.pos += 1
            while true:
                if here().kind != Generic:
                    return unexpected("a type parameter is a $name or a $$name")
                finish(begin(TName, comp.pos))
                comp.pos += 1
                if not peek(","):
                    break
                comp.pos += 1
            try expect("]")
        if form == "enum" and (peek("=") or peek(":")):
            comp.nodes[n].kind = Alias
            union := begin(TUnion, comp.pos)
            indented := peek(":")
            comp.pos += 1
            separator: &strview = "|"
            width := 0
            if indented:
                separator = ","
                width = here().text.len
                if here().kind != Line or width <= comp.width:
                    return fail("enum " + text(n) + " expects its variants in an indented block after ':'", comp.tokens[comp.pos - 1].at)
            while true:
                if indented and here().kind == Line and not try next_line(comp.width, width):
                    break
                if here().kind != Name:
                    return unexpected("enum variants are plain names")
                try new_name(false)
                finish(begin(TName, comp.pos))
                comp.pos += 1
                if peek(separator):
                    comp.pos += 1
                elif not indented or here().kind != Line:
                    break
            finish(union)
        elif peek("=") and form == "type":
            if sym.error:
                return fail("an alias cannot be marked error, " + text(n) + " is just the type it names: declare type error " + text(n) + " on its own or with fields", here().at)
            comp.nodes[n].kind = Alias
            comp.pos += 1
            try type_expr()
        elif peek(":") and form != "enum":
            comp.nodes[n].kind = Struct
            if form == "fatptr":
                comp.nodes[n].kind = Fat
            elif form == "context":
                comp.nodes[n].kind = Context
            comp.pos += 1
            if here().kind != Line or here().text.len <= comp.width:
                return fail(form + " " + text(n) + " expects its fields in an indented block after ':'", comp.tokens[comp.pos - 1].at)
            try fields(comp.width)
        elif form != "type":
            what: &strview = "fields in an indented block after ':'"
            if form == "enum":
                what = "variants after '=' or in an indented block after ':'"
            return unexpected(form + " " + text(n) + " expects its " + what)
        finish(n)
        if form == "enum":
            for c in n + 2..node_end(n):
                finish(begin(Void, comp.nodes[c].tok))
    elif t.text == "func" or t.text == "operator":
        try func_decl(false)
        if inline and text(n) == "main" and module.len == 0 and params(n) == 0:
            return fail("main is the entry point of the program, it cannot be inline", comp.tokens[comp.nodes[n].tok].at)
    elif t.text == "extern":
        if after.kind != Str:
            return fail("extern expects the library name as text: extern \"c\":", t.at)
        begin(Extern, comp.pos + 1)
        comp.pos += 2
        kept = try on_target() and kept
        try expect(":")
        if here().kind != Line:
            return unexpected("an extern block holds its functions on the lines below it")
        width := here().text.len
        while try next_line(comp.width, width):
            if peek("inline"):
                return fail("an extern func cannot be inline, it has no body: its library holds it", here().at)
            if peek("noinline"):
                return fail("an extern func cannot be noinline, it has no body: its library holds it", here().at)
            if here().kind == Name and comp.tokens[comp.pos + 1].text == ":": # the address of a variable of C
                try new_name(true)
                v := begin(Var, comp.pos)
                comp.pos += 2
                try type_expr()
                try symbol()
                finish(v)
            elif peek("func"):
                try func_decl(true)
            else:
                return fail("an extern block declares functions and the addresses of variables of C", here().at)
        finish(n)
    elif t.kind == Name and (after.text == "=" or after.text == ":"):
        try new_name(true)
        begin(Constant, comp.pos)
        comp.pos += 2
        if after.text == ":":
            try type_expr()
            if not peek("="):
                return fail(t.text + " has no value, and at the root a name with a type is a constant: give it its value, or keep what changes in a context, or in a shared context for all the threads", t.at)
            comp.pos += 1
        try expr(1)
        finish(n)
    elif t.kind == Name and after.text == ":=" and comp.tokens[comp.pos + 2].kind != Line:
        last := comp.pos + 2
        while comp.tokens[last + 1].kind != Line:
            last += 1
        return fail(":= declares a variable, and at the root a name is a constant: " + t.text + " = " + excerpt(comp.pos + 2, last) + ", or keep what changes in a context, or in a shared context for all the threads", after.at)
    elif sym.priv:
        return unexpected("priv expects a declaration after it")
    else:
        return unexpected("only declarations go here and code belongs inside a function")
    if sym.packed and comp.nodes[n].kind != Struct:
        return fail("packed goes before a type with fields: packed type Name:", comp.tokens[comp.nodes[n].tok].at)
    c := n
    while kept and c < comp.nodes.len:
        sym.name = text(c)
        if t.text == "operator" and sym.name == "next":
            sym.name = "operator next" # the one name of an operator that a function can take too
        try declare(c, sym)
        try nested(c, sym)
        c = node_end(c)
    if not kept:
        comp.nodes.len = n
    return end_line()

func fields(outer: i64) -> Fail?:
    width := here().text.len
    while try next_line(outer, width):
        if here().kind != Name or comp.tokens[comp.pos + 1].text != ":":
            return unexpected("a field is written name: type")
        try new_name(false)
        f := begin(Field, comp.pos)
        comp.pos += 2
        if here().kind == Line and here().text.len > width:
            inner := begin(Struct, comp.pos - 2)
            try fields(width)
            finish(inner)
        else:
            try type_expr()
            if here().kind == Builtin:
                other := here().text[1:]
                finish(begin(Name, comp.pos))
                comp.pos += 1
                if peek("="):
                    return fail(text(f) + " cannot have a default value, it shares the storage of " + other + " and starts as " + other + " does", here().at)
            if peek("="):
                comp.pos += 1
                if here().kind == Builtin and comp.tokens[comp.pos + 1].text != "(":
                    return fail("the default of " + text(f) + " cannot read the field " + here().text[1:] + ", " + KNOWN, here().at)
                try expr(1)
            try end_line()
        finish(f)
    return null

func nested(n: i64, outer: Sym) -> Fail?:
    k := comp.nodes[n].kind
    if k != Struct and k != Context and k != Fat:
        return null
    c := kid(n, type_params(n))
    while c < node_end(n):
        if comp.nodes[c].kind == Field and comp.nodes[c + 1].kind == Struct:
            if type_params(n) > 0:
                return fail("a type with parameters cannot hold a block of fields inside, the inner type would not see " + text(n + 1) + ": declare it on its own, with its own parameters", comp.tokens[comp.nodes[c].tok].at)
            inner := outer
            inner.name = outer.name + "." + text(c)
            try declare(c + 1, inner)
            try nested(c + 1, inner)
        c = node_end(c)
    return null

func declare(n: i64, sym: Sym) -> Fail?:
    kind := comp.nodes[n].kind
    if kind == Extern:
        c := n + 1
        while c < node_end(n):
            inner := sym
            inner.name = text(c)
            try declare(c, inner)
            c = node_end(c)
        return null
    at := comp.tokens[comp.nodes[n].tok].at
    id := comp.type_ids[sym.name]
    if id is i64 and id <= NEVER and kind != Func:
        return fail(sym.name + " is a built-in type, it cannot be declared again", at)
    if sym.name == "ptr" or sym.name == "print" or sym.name == "eprint":
        return fail(sym.name + " belongs to the language, it cannot be declared again", at)
    if sym.name == "hash" and kind == Func and comp.tokens[comp.nodes[n].tok - 1].text != "operator":
        return fail("a func cannot be named hash, hash(x) calls operator hash: declare operator hash in place of func hash", at)
    s := first_sym(sym.name)
    while s != 0:
        old := comp.syms[s]
        other := comp.nodes[old.node].kind
        if old.module == sym.module and old.library != sym.library and kind != Func and other != Func:
            comp.syms[s].name = "core." + sym.name
        elif old.module == sym.module and old.library == sym.library:
            problem: &strview
            if kind == Func and other == Func:
                new_end := body(n)
                old_end := body(old.node)
                if new_end == 0:
                    new_end = node_end(n)
                if old_end == 0:
                    old_end = node_end(old.node)
                taken := kid(n, params(n))
                new_where := where_start(n)
                old_where := where_start(old.node)
                twin := taken - n == kid(old.node, params(old.node)) - old.node and same_nodes(n + 1, old.node + 1, taken - n - 1) and new_end - new_where == old_end - old_where and same_nodes(new_where, old_where, new_end - new_where)
                if twin:
                    problem = " is declared twice with the same parameters"
            elif kind == Func or other == Func:
                if kind == Constant or other == Constant:
                    problem = " is declared as a constant and as a function, a name is one or the other"
            elif other != Void or kind != Void:
                problem = " is declared twice"
            elif old.error != sym.error:
                problem = " is declared as an error and as a plain void type, it cannot be both"
            else:
                return null
            if problem.len > 0:
                failed := fail(sym.name + problem, at)
                note("the other " + sym.name + " is declared here", comp.tokens[comp.nodes[old.node].tok].at)
                return failed
        s = old.next
    made := sym
    made.node = n
    made.next = first_sym(sym.name)
    append(comp.syms, made)
    put(comp.names, sym.name, comp.syms.len - 1)
    return null

func same_nodes(a: i64, b: i64, count: i64) -> bool:
    for i in 0..count:
        x := comp.nodes[a + i]
        y := comp.nodes[b + i]
        if x.kind != y.kind or x.size != y.size or x.module != y.module or x.kind != Var and text(a + i) != text(b + i) or x.kind == Var and gathers(a + i) != gathers(b + i):
            return false
    return true

func where_start(f: i64) -> i64:
    c := kid(f, params(f))
    while c < node_end(f) and comp.nodes[c].kind != Where and comp.nodes[c].kind != Block:
        c = node_end(c)
    return c

func func_decl(external: bool) -> Fail?:
    keyword := here().text
    comp.pos += 1
    name := here()
    if keyword == "func" and name.kind != Name or keyword == "operator" and name.kind != Symbol and name.kind != Name:
        return unexpected("a declaration expects a name here")
    sides: &strview # the parameters an operator expects
    least := 1
    most := 1
    if keyword == "func":
        try new_name(false)
    else:
        problem: &strview
        switch name.text:
        case "+", "-", "*", "/", "%", "==", "<", "<<", ">>", "and", "or", "xor", "=", "+=":
            sides = "two parameters, its left side and its right side"
            least = 2
            most = 2
        case "not":
            sides = "one parameter, the value on its right"
        case "[]":
            sides = "two parameters, the x and i of x[i]"
            least = 2
            most = 2
        case "[]=":
            sides = "three parameters, the x, i and v of x[i] = v, or two when it gives a pointer to the element"
            least = 2
            most = 3
        case "[:]":
            sides = "three parameters, the x, a and b of x[a:b]"
            least = 3
            most = 3
        case "for":
            sides = "one parameter, the x of for e in x"
        case "reverse":
            sides = "one parameter, the x of for e in reverse x"
        case "next":
            sides = "one parameter, a pointer to what operator for gives"
        case "with":
            sides = "one parameter, the x of with x"
        case "hash":
            sides = "one parameter, the x of hash(x)"
        case "!=":
            problem = " follows from ==, declare operator == instead"
        case ">", "<=", ">=":
            problem = " follows from <, declare operator < instead"
        case "-=", "*=", "/=", "%=":
            problem = " follows from " + name.text[:1] + ", declare operator " + name.text[:1] + " instead"
        case:
            problem = " cannot be declared, the operators to declare are + - * / % == < << >> and or xor not = += [] []= [:] for reverse next with hash"
        if problem.len > 0:
            return fail("operator " + name.text + problem, name.at)
    n := begin(Func, comp.pos)
    comp.pos += 1
    try expect("(")
    count := 0
    while not peek(")"):
        if peek("..") and comp.tokens[comp.pos + 1].text == ".":
            if not external:
                return fail("... is for the extra arguments of a C function, a func of Flag gathers them as ..items: T", here().at)
            if comp.tokens[comp.pos + 2].text != ")":
                return fail("... stands for the extra arguments of a C function, it goes last", here().at)
            finish(begin(Var, comp.pos))
            comp.pos += 2
            break
        gathering := peek("..")
        if gathering and external:
            return fail("an extern func ends with ... for the extra arguments of C, ..items: T is for a func of Flag", here().at)
        if gathering and keyword == "operator":
            return fail("operator " + name.text + " expects " + sides + ", ..items: T is for a func", here().at)
        if gathering:
            comp.pos += 1
        if here().kind != Name or comp.tokens[comp.pos + 1].text != ":":
            return unexpected("a parameter is written name: type")
        param := comp.nodes.len
        if comp.tokens[comp.pos + 2].text == "type" and keyword == "func" and not external and not gathering:
            try new_name(true)
            begin(Var, comp.pos)
            begin(TUnary, comp.pos + 2)
            comp.pos += 3
            given := here()
            after := comp.tokens[comp.pos + 1]
            bare := given.kind == Generic and not starts_with(given.text, "$$")
            if not bare or after.text != "," and after.text != ")":
                at := given.at
                if bare:
                    at = after.at
                return fail("type expects a bare $T after it, with no shape and no default value: kind: type $T", at)
            finish(begin(TName, comp.pos))
            comp.pos += 1
            finish(param + 1)
            finish(param)
        else:
            try variable()
        if gathering and kids(param) == 2:
            return fail(".." + text(param) + " cannot have a default value, with no extra arguments it is an empty view", comp.tokens[comp.nodes[param].tok].at)
        if gathering and not peek(")"):
            return fail(".." + text(param) + " goes last, it gathers the arguments after the others", comp.tokens[comp.nodes[param].tok].at)
        count += 1
        for i in param..comp.nodes.len:
            at := comp.tokens[comp.nodes[i].tok].at
            after := comp.tokens[comp.nodes[i].tok - 1].text
            if comp.nodes[i].kind == Unary and text(i) == "try":
                return fail("a default value runs in the caller, so try would return from the caller: handle the error with iferror or trust", at)
            if comp.nodes[i].kind == Return:
                return fail("a default value runs in the caller, so return would return from the caller: write a value after " + after, at)
            if comp.nodes[i].kind == Jump:
                return fail("a default value runs in the caller, so " + text(i) + " would jump in a loop of the caller: write a value after " + after, at)
        if keyword == "operator" and count > most and kids(param) == 1:
            return fail("operator " + name.text + " expects " + sides + ", and one more needs a default value", comp.tokens[comp.nodes[param].tok].at)
        if not peek(","):
            break
        comp.pos += 1
    try expect(")")
    if keyword == "operator" and count < least:
        return fail("operator " + name.text + " expects " + sides, name.at)
    if peek("->"):
        comp.pos += 1
        result := comp.nodes.len
        try type_expr()
        for i in result..comp.nodes.len:
            g := comp.tokens[comp.nodes[i].tok]
            bound := g.kind != Generic
            for j in n + 1..result:
                bound = bound or text(j) == g.text
            if not bound and starts_with(g.text, "$$"):
                return fail(g.text + " is not bound here, a generic gets its number from a parameter: take it from a type, values: array[$T, " + g.text + "]", g.at)
            if not bound:
                return fail(g.text + " is not bound here, a generic gets its type from a parameter: take it as kind: type " + g.text, g.at)
    if peek("=") and not external:
        return fail("only a func of an extern block names its C function with = \"symbol\"", here().at)
    try symbol()
    try where_clause()
    if not external:
        try block()
    elif peek(":"):
        return fail("an extern func has no body, its library holds it", here().at)
    finish(n)
    return null

# = "name" after a declaration of an extern block, the symbol of C when it is not the name in Flag
func symbol() -> Fail?:
    if not peek("="):
        return null
    comp.pos += 1
    named := here().kind == Str and here().text.len > 2
    if named:
        for i, b in items(here().text[1:here().text.len - 1]):
            named = named and (is_letter(b) or b == '.' or i > 0 and (is_digit(b) or b == '$'))
    if not named:
        return unexpected("= expects the symbol of C as text, a name of letters, digits, _, . and $: = \"objc_msgSend\"")
    finish(begin(Literal, comp.pos))
    comp.pos += 1
    return null

func where_clause() -> Fail?:
    if peek("where"):
        w := begin(Where, comp.pos)
        comp.pos += 1
        try expr(1)
        finish(w)
    return null

# a where that opens a block, and not a variable named where
func where_block() -> bool:
    t := here()
    after := comp.tokens[comp.pos + 1]
    return t.text == "where" and (after.kind != Symbol and after.kind != Line or after.text == "(" and after.at > t.at + t.text.len)

# a where outside a function holds or not before anything is declared, so it reads only the target
func on_target() -> bool|Fail:
    start := comp.nodes.len
    try where_clause()
    values: &list[bool] = heap([])
    defer free(values)
    for n in reverse start + 1..comp.nodes.len:
        o := text(n)
        k := comp.nodes[n].kind
        built := platform(o)
        if k == Unary and o == "not":
            values[-1] = not values[-1]
        elif k == Binary and (o == "and" or o == "or"):
            left := trust pop(values)
            values[-1] = left and values[-1] if o == "and" else left or values[-1]
        elif k == Name and (o == "true" or o == "false"):
            append(values, o == "true")
        elif k == Call and kids(n) == 0 and built is bool:
            append(values, built)
        else:
            return fail("a where outside a function reads only the system and the processor, like @linux() and not @arm64()", at_of(n))
    comp.nodes.len = start
    return values.len == 0 or values[0]

func block() -> Fail?:
    try deeper(here().at)
    defer comp.depth -= 1
    try expect(":")
    outer := comp.width
    inner := here().text.len
    if here().kind != Line or inner <= outer:
        return fail("':' expects an indented block after it, write pass when the block does nothing", comp.tokens[comp.pos - 1].at)
    n := begin(Block, comp.pos)
    comp.width = inner
    while try next_line(outer, inner):
        try stmt()
        try end_line()
    finish(n)
    comp.width = outer
    return null

func next_line(outer: i64, inner: i64) -> bool|Fail:
    t := here()
    if t.kind != Line or t.text.len <= outer:
        return false
    if t.text.len != inner:
        what: &strview = "is deeper than the block it belongs to"
        if t.text.len < inner:
            what = "matches no block open above it"
        return fail("unexpected indentation, this line " + what, t.at)
    comp.pos += 1
    return true

func stmt() -> Fail?:
    t := here()
    after := comp.tokens[comp.pos + 1].text
    if t.kind != Name:
        try assignment()
    elif after == ":=" or after == ":" and t.text != "else" and t.text != "case":
        try variable()
    elif t.text == "if":
        opened: &list[i64] = heap([])
        defer free(opened)
        append(opened, begin(If, comp.pos))
        comp.pos += 1
        try expr(1)
        try block()
        while same_line_next("elif") or same_line_next("else"):
            comp.pos += 1
            if peek("else"):
                comp.pos += 1
                try block()
                if same_line_next("elif") or same_line_next("else"):
                    late := comp.tokens[comp.pos + 1]
                    return fail(late.text + " cannot follow an else, the else above already ended this if", late.at)
                break
            append(opened, begin(If, comp.pos))
            comp.pos += 1
            try expr(1)
            try block()
        while opened.len > 0:
            finish(opened[-1])
            opened.len -= 1
    elif t.text == "elif" or t.text == "else":
        return fail(t.text + " expects an if above it at the same column", t.at)
    elif t.text == "while" or t.text == "with":
        n := begin(While, comp.pos)
        if t.text == "with":
            comp.nodes[n].kind = With
        comp.pos += 1
        try expr(1)
        try block()
        finish(n)
    elif t.text == "for":
        counted := comp.tokens[comp.pos + 2].text == ","
        name := comp.pos + 1 + 2 * i64(counted)
        if comp.tokens[comp.pos + 1].kind != Name or comp.tokens[name].kind != Name or comp.tokens[name + 1].text != "in":
            return fail("for expects a name and 'in' after it: for x in items: or for i, x in items:", t.at)
        if counted and comp.tokens[comp.pos + 1].text == comp.tokens[name].text:
            return fail("variable " + comp.tokens[name].text + " is already declared and still in scope", comp.tokens[name].at)
        comp.pos += 1
        try new_name(true)
        comp.pos = name
        try new_name(true)
        n := begin(For, comp.pos)
        if counted:
            finish(begin(Name, comp.pos - 2))
        comp.pos += 2
        if peek("reverse"):
            backward := begin(Unary, comp.pos)
            comp.pos += 1
            try expr(1)
            finish(backward)
        else:
            try expr(1)
        try block()
        finish(n)
    elif t.text == "switch":
        n := begin(Switch, comp.pos)
        comp.pos += 1
        try expr(1)
        try expect(":")
        if not same_line_next("case"):
            return fail("switch expects its cases on the lines below it, at the same column", t.at)
        while same_line_next("case"):
            comp.pos += 1
            c := begin(Case, comp.pos)
            comp.pos += 1
            depth := 0
            while depth > 0 or not peek(":") and here().kind != Line:
                if peek("(") or peek("[") or peek("{"):
                    depth += 1
                elif peek(")") or peek("]") or peek("}"):
                    depth -= 1
                comp.pos += 1
            try block()
            finish(c)
        finish(n)
    elif t.text == "case":
        return fail("case expects a switch above it at the same column", t.at)
    elif t.text == "return":
        n := begin(Return, comp.pos)
        first := comp.pos
        while comp.tokens[first - 1].kind != Line:
            first -= 1
        comp.pos += 1
        if here().kind != Line and unclosed(first, comp.pos) > 0: # inside brackets, after ifnull, a comma goes on
            try expr(1)
        elif here().kind != Line:
            try several()
        finish(n)
    elif t.text == "break" or t.text == "continue":
        n := begin(Jump, comp.pos)
        comp.pos += 1
        if here().kind == Int:
            finish(begin(Literal, comp.pos))
            comp.pos += 1
        finish(n)
    elif where_block():
        n := begin(Where, comp.pos)
        comp.pos += 1
        try expr(1)
        try block()
        finish(n)
    elif t.text == "assert":
        n := begin(Assert, comp.pos)
        comp.pos += 1
        try expr(1)
        if peek(","):
            comp.pos += 1
            try expr(1)
        finish(n)
    elif t.text == "func" and comp.tokens[comp.pos + 1].kind == Name and comp.tokens[comp.pos + 2].text == "(":
        return fail("a function is declared at the first column, not inside another one: it could not use the variables around it, pass them as arguments", t.at)
    elif t.text == "defer":
        n := begin(Defer, comp.pos)
        comp.pos += 1
        if here().kind == Line:
            return unexpected("defer expects a statement after it")
        try stmt()
        if comp.nodes[n + 1].kind == Var or comp.nodes[n + 1].kind == Defer or comp.nodes[n + 1].kind == Assign and text(n + 1) == ":=":
            return fail("defer runs a statement when its block ends, a declaration or another defer leaves it nothing to run", comp.tokens[comp.nodes[n].tok + 1].at)
        finish(n)
    elif t.text == "pass":
        finish(begin(Block, comp.pos))
        comp.pos += 1
    elif (t.text == "use" or t.text == "module") and comp.tokens[comp.pos + 1].kind == Name:
        return fail(t.text + " goes in the header of the file, before the first declaration", t.at)
    else:
        try assignment()
    return null

func variable() -> Fail?:
    try new_name(true)
    n := begin(Var, comp.pos)
    comp.pos += 1
    if peek(":="):
        comp.pos += 1
        try expr(1)
    else:
        comp.pos += 1
        try type_expr()
        if peek("="):
            comp.pos += 1
            try expr(1)
    finish(n)
    last := kid(n, kids(n) - 1)
    if comp.nodes[last].kind == Binary and (text(last) == "iferror" or text(last) == "ifnull") and assigning():
        return fail("an assignment on the right of " + text(last) + " is a statement of its own, " + text(n) + " would be left without a value", here().at)
    return null

func assignment() -> Fail?:
    first := comp.pos
    start := comp.nodes.len
    try expr(1)
    if peek(","): # a, b = b, a or lo, hi := f()
        while peek(","):
            comp.pos += 1
            try expr(1)
        sign := comp.pos
        if peek(":="):
            c := start
            while c < comp.nodes.len:
                if comp.nodes[c].kind != Name or comp.nodes[c].size != 1 or comp.nodes[c].module.len > 0:
                    return fail(":= declares names, and this is not one: several places are assigned with =", at_of(c))
                comp.pos = comp.nodes[c].tok
                try new_name(true)
                c += 1
            comp.pos = sign
        elif not peek("="):
            return unexpected("several places take their values with = and several names with :=")
        comp.pos += 1
        try several()
        wrap(start, Assign, sign)
        finish(start)
        return null
    if assigning():
        target := start
        if comp.nodes[start].kind == Binary and (text(start) == "iferror" or text(start) == "ifnull") and unclosed(first, comp.nodes[start].tok) == 0:
            target = node_end(start + 1)
        wrap(target, Assign, comp.pos)
        comp.pos += 1
        try expr(1)
        finish(target)
        finish(start)
    return null

# a value, or several separated by commas, which make a tuple
func several() -> Fail?:
    start := comp.nodes.len
    try expr(1)
    if peek(","):
        wrap(start, Fill, comp.pos)
        while peek(","):
            comp.pos += 1
            try expr(1)
        finish(start)
    return null

func assigning() -> bool:
    t := here()
    return t.kind == Symbol and (t.text == "=" or t.text == "+=" or t.text == "-=" or t.text == "*=" or t.text == "/=" or t.text == "%=")

func expr(min: i64) -> Fail?:
    start := comp.nodes.len
    first := comp.pos
    if peek("not") and min <= 4:
        try deeper(here().at)
        n := begin(Unary, comp.pos)
        comp.pos += 1
        try expr(4)
        finish(n)
        comp.depth -= 1
    else:
        try unary()
    operators: &list[i64] = heap([])
    defer free(operators)
    last := 0
    while true:
        t := here()
        prec := 0
        if t.kind == Symbol or t.kind == Name:
            switch t.text:
            case "or":
                prec = 2
            case "and", "xor":
                prec = 3
            case "is":
                prec = 5
            case "==", "!=", "<", ">", "<=", ">=":
                prec = 6
            case "iferror", "ifnull":
                prec = 7
            case "..", "..=", "<<", ">>":
                prec = 8
            case "+", "-":
                prec = 9
            case "*", "/", "%":
                prec = 10
            case "as":
                prec = 11
            case "||":
                return fail("'||' is not an operator, write: or", t.at)
        if prec == 0 or prec < min:
            break
        append(operators, comp.pos)
        comp.pos += 1
        if t.text == "is" or t.text == "as":
            try type_expr()
        elif prec == 7 and (peek("return") or peek("break") or peek("continue")):
            try stmt()
        else:
            try expr(prec + 1)
        if prec == 6 and last == 6:
            o := comp.tokens[operators[-2]].text
            a := excerpt(first, operators[-2] - 1)
            b := excerpt(operators[-2] + 1, operators[-1] - 1)
            c := excerpt(operators[-1] + 1, comp.pos - 1)
            return fail("comparisons do not chain, write " + a + " " + o + " " + b + " and " + b + " " + t.text + " " + c + ", or (" + a + " " + o + " " + b + ") " + t.text + " " + c, t.at)
        last = prec
    if operators.len > 0 and comp.tokens[first - 1].text == "not": # the operand of a not
        switch comp.tokens[operators[0]].text:
        case "+", "-", "*", "/", "%", "<<", ">>", "as":
            x := excerpt(first, operators[0] - 1)
            whole := excerpt(first, comp.pos - 1)
            return fail("not " + whole + " needs parentheses, write (not " + x + ") " + excerpt(operators[0], comp.pos - 1) + " to flip the bits of " + x + ", or not (" + whole + ")", comp.tokens[first - 1].at)
    for o in operators:
        begin(Binary, o)
    i := comp.nodes.len
    while i > start + operators.len:
        i -= 1
        comp.nodes[i] = comp.nodes[i - operators.len]
    n := start + operators.len
    end := node_end(n)
    for o in operators:
        n -= 1
        end = node_end(end)
        comp.nodes[n] = Node{Binary, o, end - n, ""}
    if min > 1 or not peek("if"):
        return null
    try deeper(here().at)
    wrap(start, Choice, comp.pos)
    comp.pos += 1
    try expr(2)
    if not peek("else"):
        return unexpected("an if inside an expression expects its else: a if c else b")
    comp.pos += 1
    try expr(1)
    finish(start)
    comp.depth -= 1
    return null

func unary() -> Fail?:
    try deeper(here().at)
    defer comp.depth -= 1
    t := here()
    if t.text == "not":
        tighter := comp.tokens[comp.pos - 1].text
        comp.pos += 1
        operand := comp.pos
        try unary()
        return fail("not is looser than " + tighter + ", write (not " + excerpt(operand, comp.pos - 1) + ")", t.at)
    if t.text == "reverse":
        return fail("reverse goes only after the in of a for, as in for x in reverse items, and flip(items) turns the items around in place", t.at)
    if t.text == "-" or t.text == "try" or t.text == "trust" or t.text == "parallel":
        n := begin(Unary, comp.pos)
        comp.pos += 1
        try unary()
        finish(n)
        if t.text == "parallel" and comp.nodes[n + 1].kind != Call:
            return fail("parallel goes before a call, it runs that call in a new thread: parallel f(x)", at_of(n + 1))
        return null
    if t.text == "&" or t.text == "*" or t.kind == Generic and not starts_with(t.text, "$$") or t.text == "func" and comp.tokens[comp.pos + 1].text == "(" or t.text == "extern" and comp.tokens[comp.pos + 1].text == "func":
        return type_expr() # only a type starts so, as in make(&list[i32])
    start := comp.nodes.len
    first := comp.pos
    name := first
    if qualifier().len > 0:
        name += 2
    t = comp.tokens[name]
    after := comp.tokens[name + 1].text
    brace := after == "{"
    converts := false
    listed := false
    if t.kind == Name and after == "[":
        depth := 0
        i := name + 1
        while comp.tokens[i].kind != Line and comp.tokens[i].kind != End:
            word := comp.tokens[i].text
            if word == "[" or word == "(" or word == "{":
                depth += 1
            elif word == "]" or word == ")" or word == "}":
                depth -= 1
                if depth == 0:
                    brace = comp.tokens[i + 1].text == "{"
                    converts = listed and comp.tokens[i + 1].text == "(" # an index has no comma, simd[f32, 4](x) names a type
                    break
            listed = listed or word == "," and depth == 1
            i += 1
    if t.kind == Name and not brace:
        j := name
        while comp.tokens[j + 1].text == "." and comp.tokens[j + 2].kind == Name:
            j += 2
        brace = j > name and comp.tokens[j + 1].text == "{"
    if t.kind == Name and brace:
        n := begin(Brace, name)
        try type_expr()
        try expect("{")
        try arguments("}")
        finish(n)
    elif t.kind == Name and converts:
        n := begin(Call, name)
        try type_expr()
        try paren(first)
        try expect("(")
        try arguments(")")
        finish(n)
    elif listed:
        return type_expr() # Pair[i32, f64], an index has no comma
    elif (t.kind == Name or t.kind == Builtin) and after == "(":
        n := qualified(Call)
        try paren(first)
        comp.pos += 1
        try arguments(")")
        finish(n)
    elif t.kind == Name or t.kind == Generic:
        finish(qualified(Name))
    elif t.kind == Int or t.kind == Float or t.kind == Str:
        finish(begin(Literal, comp.pos))
        comp.pos += 1
    elif t.text == "(":
        try paren(comp.pos)
        comp.pos += 1
        try expr(1)
        try expect(")")
    elif t.text == "[":
        n := begin(Items, comp.pos)
        comp.pos += 1
        while not peek("]"):
            try expr(1)
            if not peek(","):
                break
            comp.pos += 1
        try expect("]")
        finish(n)
    elif t.text == "{":
        n := begin(Pairs, comp.pos)
        comp.pos += 1
        count := 0
        while not peek("}"):
            try argument()
            count += 1
            pair := peek(":")
            if count == 1 and not pair:
                comp.nodes[n].kind = Fill
            if pair != (comp.nodes[n].kind == Pairs):
                return unexpected("a {} literal holds key: value pairs or values, not both")
            if pair:
                comp.pos += 1
                try expr(1)
            if not peek(","):
                break
            comp.pos += 1
        try expect("}")
        finish(n)
    else:
        return unexpected("a value goes here")
    links := 0
    while true:
        comp.depth -= links # each link nests, its arguments do not
        if peek(".") and (comp.tokens[comp.pos + 1].kind == Name or comp.tokens[comp.pos + 1].kind == Int):
            wrap(start, Field, comp.pos + 1)
            comp.pos += 2
            finish(start)
        elif peek("("):
            wrap(start, Call, comp.pos)
            try paren(first)
            comp.pos += 1
            try arguments(")")
            finish(start)
        elif peek(".*"):
            wrap(start, Unary, comp.pos)
            comp.pos += 1
            finish(start)
        elif peek("["):
            wrap(start, Index, comp.pos)
            comp.pos += 1
            if peek(":"):
                finish(begin(Block, comp.pos))
            else:
                try expr(1)
            if peek(":"):
                comp.pos += 1
                if peek("]"):
                    finish(begin(Block, comp.pos))
                else:
                    try expr(1)
            try expect("]")
            finish(start)
        else:
            break
        comp.depth += links
        try deeper(here().at)
        links += 1
    k := comp.nodes[start].kind
    if (peek("?") or peek("|") or peek("||")) and (k == Name or k == Field or k == Index or k == TName or k == TUnary or k == TUnion or k == TFunc or k == TTuple):
        comp.nodes.len = start
        comp.pos = first
        return type_expr() # Point?, i32|null and u8||u64 are types
    return null

# here() is a (, and callee up to it is what it calls, nothing for a group
func paren(callee: i64) -> Fail?:
    open := comp.pos
    last := comp.tokens[open - 1]
    glued := last.at + last.text.len == here().at
    keyword := glued and last.kind == Name and reserved(last.text)
    if not keyword and (glued or callee == open):
        return null
    close := open
    depth := 1
    while depth > 0:
        close += 1
        depth += unclosed(close, close)
    if not keyword:
        return fail("a call writes its ( right after what it calls: " + excerpt(callee, open - 1) + excerpt(open, close), here().at)
    inside := excerpt(open, close)
    if close == open + 2:
        inside = excerpt(open + 1, open + 1)
    return fail("'" + last.text + "' is a keyword of the language, not a function, so a space goes after it: " + last.text + " " + inside, last.at)

func deeper(at: i64) -> Fail?:
    comp.depth += 1
    if comp.depth > DEEP:
        return fail("this code nests more than " + DEEP + " levels deep, move the inner part to a function or a variable", at)
    return null

func arguments(last: &strview) -> Fail?:
    while not peek(last):
        try argument()
        if not peek(","):
            break
        comp.pos += 1
    return expect(last)

func argument() -> Fail?:
    kind: NodeKind = Unary # ..view, which gives the extra arguments
    if here().kind == Name and comp.tokens[comp.pos + 1].text == "=":
        kind = Named
    elif not peek(".."):
        return expr(1)
    n := begin(kind, comp.pos)
    comp.pos += 1 + i64(kind == Named)
    try expr(1)
    finish(n)
    return null

func type_expr() -> Fail?:
    try deeper(here().at)
    defer comp.depth -= 1
    start := comp.nodes.len
    while true:
        at := comp.nodes.len
        prefixes := 0
        while peek("*") or peek("&"):
            try deeper(here().at)
            begin(TUnary, comp.pos)
            comp.pos += 1
            prefixes += 1
        t := here()
        if t.text == "type":
            return fail("type $T goes only in a parameter of a func with a body, where each call gives the type: func make(kind: type $T)", t.at)
        foreign := t.text == "extern" and comp.tokens[comp.pos + 1].text == "func" and comp.tokens[comp.pos + 2].text == "("
        if foreign or t.text == "func" and comp.tokens[comp.pos + 1].text == "(":
            n := begin(TFunc, comp.pos)
            comp.pos += 2 + i64(foreign)
            while not peek(")"):
                if here().kind == Name and comp.tokens[comp.pos + 1].text == ":":
                    return unexpected("a function type lists types without names: func(i32, i32) -> bool")
                taken := begin(Var, comp.pos)
                try type_expr()
                finish(taken)
                if not peek(","):
                    break
                comp.pos += 1
            try expect(")")
            if peek("->"):
                comp.pos += 1
                try type_expr()
            finish(n)
        elif t.kind == Name or t.kind == Generic:
            n := qualified(TName)
            outer: &str = heap("")
            while peek(".") and comp.tokens[comp.pos + 1].kind == Name:
                if outer.len > 0:
                    outer += "."
                outer += text(n)
                comp.nodes[n].tok = comp.pos + 1
                comp.pos += 2
            if outer.len > 0:
                comp.nodes[n].module = comp.nodes[n].module + "." + outer
            if peek("["):
                comp.pos += 1
                while true:
                    if here().kind == Int:
                        finish(begin(Literal, comp.pos))
                        comp.pos += 1
                    else:
                        try type_expr()
                    if not peek(","):
                        break
                    comp.pos += 1
                try expect("]")
            finish(n)
        elif t.text == "(":
            try paren(comp.pos)
            open := comp.pos
            inner := comp.nodes.len
            comp.pos += 1
            try type_expr()
            if peek(","): # a tuple, (i32, bool), where (T) is T
                wrap(inner, TTuple, open)
                while peek(","):
                    comp.pos += 1
                    try type_expr()
                finish(inner)
            try expect(")")
        else:
            return unexpected("a type goes here")
        while prefixes > 0:
            prefixes -= 1
            comp.depth -= 1
            finish(at + prefixes)
        if peek("?"):
            wrap(at, TUnary, comp.pos)
            comp.pos += 1
            finish(at)
        if not peek("|") and not peek("||"):
            break
        if at == start:
            wrap(start, TUnion, comp.pos)
        elif here().text != text(start):
            return unexpected("a type mixes | and ||, group one side in parentheses")
        comp.pos += 1
    if comp.nodes[start].kind == TUnion:
        finish(start)
    return null

func qualifier() -> &strview:
    if here().kind == Name and comp.tokens[comp.pos + 1].text == "." and comp.tokens[comp.pos + 2].kind == Name:
        return module_of(here().text, file_of(here().at))
    return ""

func qualified(kind: NodeKind) -> i64:
    module := qualifier()
    if module.len > 0:
        comp.pos += 2
    n := begin(kind, comp.pos)
    comp.nodes[n].module = module
    comp.pos += 1
    return n

func new_name(of_value: bool) -> Fail?:
    t := here()
    if reserved(t.text):
        return fail("'" + t.text + "' is a keyword of the language, it cannot be used as a name", t.at)
    if of_value and module_of(t.text, comp.files.len - 1).len > 0:
        return fail(t.text + " names a module in this file, a variable or a constant cannot take it", t.at)
    return null

func reserved(word: &strview) -> bool:
    switch word:
    case "if", "elif", "else", "while", "for", "in", "reverse", "switch", "case", "break", "continue", "return", "assert", "defer", "with", "pass", "and", "or", "xor", "not", "is", "as", "try", "trust", "parallel", "iferror", "ifnull", "true", "false", "null", "inf", "nan":
        return true
    return false

func same_line_next(word: &strview) -> bool:
    t := here()
    return t.kind == Line and t.text.len == comp.width and comp.tokens[comp.pos + 1].text == word

func end_line() -> Fail?:
    if here().kind != Line and here().kind != End:
        return unexpected("the statement already ended")
    return null

func peek(s: &strview) -> bool:
    t := here()
    return t.kind != Str and t.text == s

func expect(s: &strview) -> Fail?:
    if not peek(s):
        return unexpected("'" + s + "' goes here")
    comp.pos += 1
    return null

func unexpected(message: &strview) -> Fail?:
    t := here()
    if t.kind == Line:
        last := comp.tokens[comp.pos - 1]
        return fail("the line ends here, " + message, last.at + last.text.len)
    return fail("unexpected '" + t.text + "', " + message, t.at)

func here() -> Token:
    return comp.tokens[comp.pos]

func begin(kind: NodeKind, tok: i64) -> i64:
    append(comp.nodes, Node{kind, tok, 0, ""})
    return comp.nodes.len - 1

func finish(n: i64):
    comp.nodes[n].size = comp.nodes.len - n

func wrap(start: i64, kind: NodeKind, tok: i64):
    append(comp.nodes, Node{kind, tok, 0, ""})
    i := comp.nodes.len - 1
    while i > start:
        comp.nodes[i] = comp.nodes[i - 1]
        i -= 1
    comp.nodes[start] = Node{kind, tok, 0, ""}
