@trust
func parse() -> Fail?:
    file := comp.files.len - 1
    first := comp.pos
    start := comp.nodes.len
    module: &strview
    while here().kind != End:
        t := here()
        if t.kind == Line:
            if t.text.len != 0:
                return fail("a declaration starts at the first column", t.at)
            comp.pos += 1
            continue
        if t.text == "module" or t.text == "use":
            if t.text == "module" and comp.pos != first + 1:
                return fail("module goes on the first line of its file", t.at)
            if comp.nodes.len != start:
                return fail(t.text + " goes in the header of the file, before the first declaration", t.at)
            comp.pos += 1
            if here().kind != Name:
                return unexpected(t.text + " expects the name of a module after it")
            given := here().text
            if t.text == "module":
                try new_name(false)
                module = given
                comp.files[file].module = given
            comp.pos += 1
            if t.text == "use":
                name := given
                alias: &strview
                if peek("as"):
                    comp.pos += 1
                    if here().kind != Name:
                        return unexpected("as expects the name this file gives the module: use fs as files")
                    try new_name(false)
                    alias = here().text
                    name = alias
                    comp.pos += 1
                if given == module:
                    return fail("this file is part of module " + given + ", it sees its names without use", t.at)
                if module_of(name, file).len > 0:
                    return fail(name + " already names a module in this file", t.at)
                append(comp.uses, Use{file, given, alias, t.at})
            try end_line()
            continue
        sym := Sym{module = module, library = comp.files[file].library}
        sym.priv = t.text == "priv"
        if sym.priv:
            sym.module = comp.files[file].module
            comp.pos += 1
        sym.packed = peek("packed")
        sym.export = peek("export")
        inline := peek("inline")
        after := comp.tokens[comp.pos + 1]
        if sym.export and after.text == "inline" or inline and after.text == "export":
            return fail("an export function cannot be inline, other languages call it and cannot take its body", here().at)
        if sym.export and after.text != "func":
            return fail("export goes before a func declaration: export func name():", here().at)
        if inline and after.text != "func" and after.text != "operator":
            return fail("inline goes before a func or an operator declaration: inline func name():", here().at)
        if sym.packed or sym.export or inline:
            comp.pos += 1
        t = here()
        after = comp.tokens[comp.pos + 1]
        n := comp.nodes.len
        if t.text == "type" or t.text == "context":
            comp.pos += 1
            sym.error = t.text == "type" and peek("error")
            if sym.error:
                comp.pos += 1
            form := t.text
            if t.text == "type" and (peek("enum") or peek("fatptr")):
                form = here().text
                comp.pos += 1
            if here().kind != Name:
                return unexpected("a type declaration expects a name")
            try new_name(false)
            begin(Void, comp.pos)
            comp.pos += 1
            if peek("[") and (form == "context" or form == "enum"):
                why: &strview = "its variants carry no data to shape"
                if form == "context":
                    why = "it is one value and not a family of types"
                return fail(form + " " + text(n) + " cannot have type parameters, " + why, here().at)
            if peek("["):
                comp.pos += 1
                while true:
                    if here().kind != Generic:
                        return unexpected("a type parameter is a $name or a $$name")
                    finish(begin(TName, comp.pos))
                    comp.pos += 1
                    if not peek(","):
                        break
                    comp.pos += 1
                try expect("]")
            if form == "enum" and (peek("=") or peek(":")):
                comp.nodes[n].kind = Alias
                union := begin(TUnion, comp.pos)
                indented := peek(":")
                comp.pos += 1
                separator: &strview = "|"
                width: usize = 0
                if indented:
                    separator = ","
                    width = here().text.len
                    if here().kind != Line or width == 0:
                        return fail("enum " + text(n) + " expects its variants in an indented block after ':'", comp.tokens[comp.pos - 1].at)
                while true:
                    if indented and here().kind == Line and not try next_line(0, width):
                        break
                    if here().kind != Name:
                        return unexpected("enum variants are plain names")
                    try new_name(false)
                    finish(begin(TName, comp.pos))
                    comp.pos += 1
                    if peek(separator):
                        comp.pos += 1
                    elif not indented or here().kind != Line:
                        break
                finish(union)
            elif peek("=") and form == "type":
                if sym.error:
                    return fail("an alias cannot be marked error, " + text(n) + " is just the type it names: declare type error " + text(n) + " on its own or with fields", here().at)
                comp.nodes[n].kind = Alias
                comp.pos += 1
                try type_expr()
            elif peek(":") and form != "enum":
                comp.nodes[n].kind = Struct
                if form == "fatptr":
                    comp.nodes[n].kind = Fat
                elif form == "context":
                    comp.nodes[n].kind = Context
                comp.pos += 1
                if here().kind != Line or here().text.len == 0:
                    return fail(form + " " + text(n) + " expects its fields in an indented block after ':'", comp.tokens[comp.pos - 1].at)
                try fields(0)
            elif form != "type":
                what: &strview = "fields in an indented block after ':'"
                if form == "enum":
                    what = "variants after '=' or in an indented block after ':'"
                return unexpected(form + " " + text(n) + " expects its " + what)
            finish(n)
            if form == "enum":
                for c in n + 2..node_end(n):
                    finish(begin(Void, comp.nodes[c].tok))
        elif t.text == "func" or t.text == "operator":
            try func_decl(false)
            if inline and text(n) == "main":
                return fail("main is the entry point of the program, it cannot be inline", comp.tokens[comp.nodes[n].tok].at)
        elif t.text == "extern":
            if after.kind != Str:
                return fail("extern expects the library name as text: extern \"c\":", t.at)
            begin(Extern, comp.pos + 1)
            comp.pos += 2
            try where_clause()
            try expect(":")
            if here().kind != Line:
                return unexpected("an extern block holds its functions on the lines below it")
            width := here().text.len
            while try next_line(0, width):
                if peek("inline"):
                    return fail("an extern func cannot be inline, it has no body: its library holds it", here().at)
                if not peek("func"):
                    return fail("an extern block declares functions only", here().at)
                try func_decl(true)
            finish(n)
        elif t.kind == Name and after.text == "=":
            try new_name(true)
            begin(Constant, comp.pos)
            comp.pos += 2
            try expr(1)
            finish(n)
        elif t.kind == Name and after.text == ":":
            try variable()
        elif sym.priv:
            return unexpected("priv expects a declaration after it")
        else:
            return unexpected("only declarations go here and code belongs inside a function")
        if sym.packed and comp.nodes[n].kind != Struct:
            return fail("packed goes before a type with fields: packed type Name:", comp.tokens[comp.nodes[n].tok].at)
        c := n
        while c < comp.nodes.len:
            sym.name = text(c)
            try declare(c, sym)
            try nested(c, sym)
            c = node_end(c)
        try end_line()
    while comp.pos < comp.tokens.len and here().kind == End:
        comp.pos += 1
    return null

func fields(outer: usize) -> Fail?:
    width := here().text.len
    while try next_line(outer, width):
        if here().kind != Name or comp.tokens[comp.pos + 1].text != ":":
            return unexpected("a field is written name: type")
        try new_name(false)
        f := begin(Field, comp.pos)
        comp.pos += 2
        if here().kind == Line and here().text.len > width:
            inner := begin(Struct, comp.pos - 2)
            try fields(width)
            finish(inner)
        else:
            try type_expr()
            if here().kind == Builtin:
                finish(begin(Name, comp.pos))
                comp.pos += 1
            try end_line()
        finish(f)
    return null

func nested(n: usize, outer: Sym) -> Fail?:
    k := comp.nodes[n].kind
    if k != Struct and k != Context and k != Fat:
        return null
    c := kid(n, type_params(n))
    while c < node_end(n):
        if comp.nodes[c].kind == Field and comp.nodes[c + 1].kind == Struct:
            if type_params(n) > 0:
                return fail("a type with parameters cannot hold a block of fields inside, the inner type would not see " + text(n + 1) + ": declare it on its own, with its own parameters", comp.tokens[comp.nodes[c].tok].at)
            inner := outer
            inner.name = outer.name + "." + text(c)
            try declare(c + 1, inner)
            try nested(c + 1, inner)
        c = node_end(c)
    return null

func declare(n: usize, sym: Sym) -> Fail?:
    kind := comp.nodes[n].kind
    if kind == Extern:
        c := n + 1
        while c < node_end(n):
            if comp.nodes[c].kind != Where:
                inner := sym
                inner.name = text(c)
                try declare(c, inner)
            c = node_end(c)
        return null
    at := comp.tokens[comp.nodes[n].tok].at
    id := comp.type_ids[sym.name]
    if id is usize and id <= ITERATIONEND and kind != Func:
        return fail(sym.name + " is a built-in type, it cannot be declared again", at)
    s := first_sym(sym.name)
    while s != 0:
        old := comp.syms[s]
        other := comp.nodes[old.node].kind
        if old.module == sym.module and old.library != sym.library and kind != Func and other != Func:
            comp.syms[s].name = "core." + sym.name
        elif old.module == sym.module and old.library == sym.library:
            problem: &strview
            if kind == Func and other == Func:
                new_body := body(n)
                old_body := body(old.node)
                if new_body == 0 and old_body == 0:
                    return null
                twin := new_body != 0 and old_body != 0 and new_body - n == old_body - old.node
                i: usize = 1
                while twin and n + i < new_body:
                    x := comp.nodes[old.node + i]
                    y := comp.nodes[n + i]
                    twin = x.kind == y.kind and x.size == y.size and x.module == y.module and (x.kind == Var or text(old.node + i) == text(n + i))
                    i += 1
                if twin:
                    problem = " is declared twice with the same parameters"
            elif kind == Func or other == Func:
                if kind == Constant or other == Constant:
                    problem = " is declared as a constant and as a function, a name is one or the other"
            elif other != Void or kind != Void:
                problem = " is declared twice"
            elif old.error != sym.error:
                problem = " is declared as an error and as a plain void type, it cannot be both"
            else:
                return null
            if problem.len > 0:
                failed := fail(sym.name + problem, at)
                note("the other " + sym.name + " is declared here", comp.tokens[comp.nodes[old.node].tok].at)
                return failed
        s = old.next
    made := sym
    made.node = n
    made.next = first_sym(sym.name)
    append(comp.syms, made)
    put(comp.names, sym.name, comp.syms.len - 1)
    return null

func func_decl(external: bool) -> Fail?:
    keyword := here().text
    comp.pos += 1
    name := here()
    if keyword == "func" and name.kind != Name or keyword == "operator" and name.kind != Symbol and name.kind != Name:
        return unexpected("a declaration expects a name here")
    if keyword == "func":
        try new_name(false)
    else:
        problem: &strview = " cannot be declared, the operators to declare are + - * / % == < << >> and or xor = +="
        switch name.text:
        case "+", "-", "*", "/", "%", "==", "<", "<<", ">>", "and", "or", "xor", "=", "+=":
            problem = ""
        case "!=":
            problem = " follows from ==, declare operator == instead"
        case ">", "<=", ">=":
            problem = " follows from <, declare operator < instead"
        case "-=", "*=", "/=", "%=":
            problem = " follows from " + name.text[:1] + ", declare operator " + name.text[:1] + " instead"
        if problem.len > 0:
            return fail("operator " + name.text + problem, name.at)
    n := begin(Func, comp.pos)
    comp.pos += 1
    try expect("(")
    count: usize = 0
    while not peek(")"):
        if peek("..") and comp.tokens[comp.pos + 1].text == ".":
            if not external or comp.tokens[comp.pos + 2].text != ")":
                return fail("... stands for the extra arguments of a C function, it goes last in an extern func", here().at)
            finish(begin(Var, comp.pos))
            comp.pos += 2
            break
        if here().kind != Name or comp.tokens[comp.pos + 1].text != ":":
            return unexpected("a parameter is written name: type")
        param := comp.nodes.len
        try variable()
        count += 1
        for i in param..comp.nodes.len:
            if comp.nodes[i].kind == Unary and text(i) == "try":
                return fail("a default value runs in the caller, so try would return from the caller: handle the error with iferror or trust", comp.tokens[comp.nodes[i].tok].at)
        if keyword == "operator" and count > 2 and kids(param) == 1:
            return fail("operator " + name.text + " takes its left side and its right side, a parameter after them needs a default value", comp.tokens[comp.nodes[param].tok].at)
        if not peek(","):
            break
        comp.pos += 1
    try expect(")")
    if keyword == "operator" and count < 2:
        return fail("operator " + name.text + " expects two parameters, its left side and its right side", name.at)
    if peek("->"):
        comp.pos += 1
        try type_expr()
    try where_clause()
    if not external:
        try block()
    elif peek(":"):
        return fail("an extern func has no body, its library holds it", here().at)
    finish(n)
    return null

func where_clause() -> Fail?:
    if peek("where"):
        w := begin(Where, comp.pos)
        comp.pos += 1
        try expr(1)
        finish(w)
    return null

func block() -> Fail?:
    try deeper(here().at)
    defer comp.depth -= 1
    try expect(":")
    outer := comp.width
    inner := here().text.len
    if here().kind != Line or inner <= outer:
        return fail("':' expects an indented block after it, write pass when the block does nothing", comp.tokens[comp.pos - 1].at)
    n := begin(Block, comp.pos)
    comp.width = inner
    while try next_line(outer, inner):
        try stmt()
        try end_line()
    finish(n)
    comp.width = outer
    return null

func next_line(outer: usize, inner: usize) -> bool|Fail:
    t := here()
    if t.kind != Line or t.text.len <= outer:
        return false
    if t.text.len != inner:
        what: &strview = "is deeper than the block it belongs to"
        if t.text.len < inner:
            what = "matches no block open above it"
        return fail("unexpected indentation, this line " + what, t.at)
    comp.pos += 1
    return true

func stmt() -> Fail?:
    t := here()
    after := comp.tokens[comp.pos + 1].text
    if t.kind != Name:
        try assignment()
    elif after == ":=" or after == ":" and t.text != "else" and t.text != "case":
        try variable()
    elif t.text == "if":
        opened: &list[usize]
        defer free(opened)
        append(opened, begin(If, comp.pos))
        comp.pos += 1
        try expr(1)
        try block()
        while same_line_next("elif") or same_line_next("else"):
            comp.pos += 1
            if peek("else"):
                comp.pos += 1
                try block()
                if same_line_next("elif") or same_line_next("else"):
                    late := comp.tokens[comp.pos + 1]
                    return fail(late.text + " cannot follow an else, the else above already ended this if", late.at)
                break
            append(opened, begin(If, comp.pos))
            comp.pos += 1
            try expr(1)
            try block()
        while opened.len > 0:
            finish(opened[-1])
            opened.len -= 1
    elif t.text == "elif" or t.text == "else":
        return fail(t.text + " expects an if above it at the same column", t.at)
    elif t.text == "while" or t.text == "with":
        n := begin(While, comp.pos)
        if t.text == "with":
            comp.nodes[n].kind = With
        comp.pos += 1
        try expr(1)
        try block()
        finish(n)
    elif t.text == "for":
        counted := comp.tokens[comp.pos + 2].text == ","
        name := comp.pos + 1 + 2 * usize(counted)
        if comp.tokens[comp.pos + 1].kind != Name or comp.tokens[name].kind != Name or comp.tokens[name + 1].text != "in":
            return fail("for expects a name and 'in' after it: for x in items: or for i, x in items:", t.at)
        comp.pos += 1
        try new_name(true)
        comp.pos = name
        try new_name(true)
        n := begin(For, comp.pos)
        if counted:
            finish(begin(Name, comp.pos - 2))
        comp.pos += 2
        if peek("reverse"):
            backward := begin(Unary, comp.pos)
            comp.pos += 1
            try expr(1)
            finish(backward)
        else:
            try expr(1)
        try block()
        finish(n)
    elif t.text == "switch":
        n := begin(Switch, comp.pos)
        comp.pos += 1
        try expr(1)
        try expect(":")
        if not same_line_next("case"):
            return fail("switch expects its cases on the lines below it, at the same column", t.at)
        while same_line_next("case"):
            comp.pos += 1
            c := begin(Case, comp.pos)
            comp.pos += 1
            depth: usize = 0
            while depth > 0 or not peek(":") and here().kind != Line:
                if peek("(") or peek("[") or peek("{"):
                    depth += 1
                elif peek(")") or peek("]") or peek("}"):
                    depth -= 1
                comp.pos += 1
            try block()
            finish(c)
        finish(n)
    elif t.text == "case":
        return fail("case expects a switch above it at the same column", t.at)
    elif t.text == "return":
        n := begin(Return, comp.pos)
        comp.pos += 1
        if here().kind != Line:
            try expr(1)
        finish(n)
    elif t.text == "break" or t.text == "continue":
        n := begin(Jump, comp.pos)
        comp.pos += 1
        if here().kind == Int:
            finish(begin(Literal, comp.pos))
            comp.pos += 1
        finish(n)
    elif t.text == "func" and comp.tokens[comp.pos + 1].kind == Name and comp.tokens[comp.pos + 2].text == "(":
        return fail("a function is declared at the first column, not inside another one: it could not use the variables around it, pass them as arguments", t.at)
    elif t.text == "defer":
        n := begin(Defer, comp.pos)
        comp.pos += 1
        if here().kind == Line:
            return unexpected("defer expects a statement after it")
        try stmt()
        if comp.nodes[n + 1].kind == Var or comp.nodes[n + 1].kind == Defer:
            return fail("defer runs a statement when its block ends, a declaration or another defer leaves it nothing to run", comp.tokens[comp.nodes[n].tok + 1].at)
        finish(n)
    elif t.text == "pass":
        finish(begin(Block, comp.pos))
        comp.pos += 1
    elif (t.text == "use" or t.text == "module") and comp.tokens[comp.pos + 1].kind == Name:
        return fail(t.text + " goes in the header of the file, before the first declaration", t.at)
    else:
        try assignment()
    return null

func variable() -> Fail?:
    try new_name(true)
    n := begin(Var, comp.pos)
    comp.pos += 1
    if peek(":="):
        comp.pos += 1
        try expr(1)
    else:
        comp.pos += 1
        try type_expr()
        if peek("="):
            comp.pos += 1
            try expr(1)
    finish(n)
    return null

func assignment() -> Fail?:
    start := comp.nodes.len
    try expr(1)
    t := here()
    if t.kind == Symbol and (t.text == "=" or t.text == "+=" or t.text == "-=" or t.text == "*=" or t.text == "/=" or t.text == "%="):
        wrap(start, Assign, comp.pos)
        comp.pos += 1
        try expr(1)
        finish(start)
    return null

func expr(min: usize) -> Fail?:
    start := comp.nodes.len
    try unary()
    operators: &list[usize]
    defer free(operators)
    while true:
        t := here()
        prec: usize = 0
        if t.kind == Symbol or t.kind == Name:
            switch t.text:
            case "or":
                prec = 1
            case "and", "xor":
                prec = 2
            case "is":
                prec = 3
            case "==", "!=":
                prec = 4
            case "<", ">", "<=", ">=":
                prec = 5
            case "iferror", "ifnull":
                prec = 6
            case "..", "<<", ">>":
                prec = 7
            case "+", "-":
                prec = 8
            case "*", "/", "%":
                prec = 9
            case "as":
                prec = 10
            case "||":
                return fail("'||' is not an operator, write: or", t.at)
        if prec == 0 or prec < min:
            break
        append(operators, comp.pos)
        comp.pos += 1
        if t.text == "is" or t.text == "as":
            try type_expr()
        else:
            try expr(prec + 1)
    for o in operators:
        begin(Binary, o)
    i := comp.nodes.len
    while i > start + operators.len:
        i -= 1
        comp.nodes[i] = comp.nodes[i - operators.len]
    n := start + operators.len
    end := node_end(n)
    for o in operators:
        n -= 1
        end = node_end(end)
        comp.nodes[n] = Node{Binary, o, end - n, ""}
    return null

func unary() -> Fail?:
    try deeper(here().at)
    defer comp.depth -= 1
    t := here()
    if t.text == "-" or t.text == "not" or t.text == "try" or t.text == "trust" or t.text == "parallel" or t.text == "wait":
        n := begin(Unary, comp.pos)
        comp.pos += 1
        try unary()
        finish(n)
        if t.text == "parallel" and comp.nodes[n + 1].kind != Call:
            return fail("parallel goes before a call, it runs that call in a new thread: parallel f(x)", at_of(n + 1))
        return null
    start := comp.nodes.len
    name := comp.pos
    if qualifier().len > 0:
        name += 2
    t = comp.tokens[name]
    after := comp.tokens[name + 1].text
    brace := after == "{"
    if t.kind == Name and after == "[":
        depth: usize = 0
        i := name + 1
        while comp.tokens[i].kind != Line and comp.tokens[i].kind != End:
            if comp.tokens[i].text == "[":
                depth += 1
            elif comp.tokens[i].text == "]":
                depth -= 1
                if depth == 0:
                    brace = comp.tokens[i + 1].text == "{"
                    break
            i += 1
    if t.kind == Name and not brace:
        j := name
        while comp.tokens[j + 1].text == "." and comp.tokens[j + 2].kind == Name:
            j += 2
        brace = j > name and comp.tokens[j + 1].text == "{"
    if t.kind == Name and brace:
        n := begin(Brace, name)
        try type_expr()
        try expect("{")
        try arguments("}")
        finish(n)
    elif (t.kind == Name or t.kind == Builtin) and after == "(":
        n := qualified(Call)
        comp.pos += 1
        while not peek(")"):
            if comp.nodes[n].module.len == 0 and (t.text == "sizeof" or t.text == "can_assign"):
                try type_expr()
            else:
                try argument()
            if not peek(","):
                break
            comp.pos += 1
        try expect(")")
        finish(n)
    elif t.kind == Name or t.kind == Generic:
        finish(qualified(Name))
    elif t.kind == Int or t.kind == Float or t.kind == Str:
        finish(begin(Literal, comp.pos))
        comp.pos += 1
    elif t.text == "(":
        comp.pos += 1
        try expr(1)
        try expect(")")
    elif t.text == "[":
        n := begin(Items, comp.pos)
        comp.pos += 1
        while not peek("]"):
            try expr(1)
            if not peek(","):
                break
            comp.pos += 1
        try expect("]")
        finish(n)
    elif t.text == "{":
        n := begin(Pairs, comp.pos)
        comp.pos += 1
        count: usize = 0
        while not peek("}"):
            try argument()
            count += 1
            pair := peek(":")
            if count == 1 and not pair:
                comp.nodes[n].kind = Fill
            if pair != (comp.nodes[n].kind == Pairs):
                return unexpected("a {} literal holds key: value pairs or values, not both")
            if pair:
                comp.pos += 1
                try expr(1)
            if not peek(","):
                break
            comp.pos += 1
        try expect("}")
        finish(n)
    else:
        return unexpected("a value goes here")
    links: usize = 0
    while true:
        comp.depth -= links # each link nests, its arguments do not
        if peek(".") and comp.tokens[comp.pos + 1].kind == Name:
            wrap(start, Field, comp.pos + 1)
            comp.pos += 2
            finish(start)
        elif peek("("):
            wrap(start, Call, comp.pos)
            comp.pos += 1
            try arguments(")")
            finish(start)
        elif peek(".*"):
            wrap(start, Unary, comp.pos)
            comp.pos += 1
            finish(start)
        elif peek("["):
            wrap(start, Index, comp.pos)
            comp.pos += 1
            if peek(":"):
                finish(begin(Block, comp.pos))
            else:
                try expr(1)
            if peek(":"):
                comp.pos += 1
                if peek("]"):
                    finish(begin(Block, comp.pos))
                else:
                    try expr(1)
            try expect("]")
            finish(start)
        else:
            break
        comp.depth += links
        try deeper(here().at)
        links += 1
    return null

func deeper(at: usize) -> Fail?:
    comp.depth += 1
    if comp.depth > DEEP:
        return fail("this code nests more than " + DEEP + " levels deep, move the inner part to a function or a variable", at)
    return null

func arguments(last: &strview) -> Fail?:
    while not peek(last):
        try argument()
        if not peek(","):
            break
        comp.pos += 1
    return expect(last)

func argument() -> Fail?:
    if here().kind == Name and comp.tokens[comp.pos + 1].text == "=":
        n := begin(Named, comp.pos)
        comp.pos += 2
        try expr(1)
        finish(n)
        return null
    return expr(1)

func type_expr() -> Fail?:
    try deeper(here().at)
    defer comp.depth -= 1
    start := comp.nodes.len
    while true:
        at := comp.nodes.len
        prefixes: usize = 0
        while peek("*") or peek("&"):
            try deeper(here().at)
            begin(TUnary, comp.pos)
            comp.pos += 1
            prefixes += 1
        t := here()
        if t.text == "func" and comp.tokens[comp.pos + 1].text == "(":
            n := begin(TFunc, comp.pos)
            comp.pos += 2
            while not peek(")"):
                if here().kind == Name and comp.tokens[comp.pos + 1].text == ":":
                    return unexpected("a function type lists types without names: func(i32, i32) -> bool")
                taken := begin(Var, comp.pos)
                try type_expr()
                finish(taken)
                if not peek(","):
                    break
                comp.pos += 1
            try expect(")")
            if peek("->"):
                comp.pos += 1
                try type_expr()
            finish(n)
        elif t.kind == Name or t.kind == Generic:
            n := qualified(TName)
            outer: &str
            while peek(".") and comp.tokens[comp.pos + 1].kind == Name:
                if outer.len > 0:
                    outer += "."
                outer += text(n)
                comp.nodes[n].tok = comp.pos + 1
                comp.pos += 2
            if outer.len > 0:
                comp.nodes[n].module = comp.nodes[n].module + "." + outer
            if peek("["):
                comp.pos += 1
                while true:
                    if here().kind == Int:
                        finish(begin(Literal, comp.pos))
                        comp.pos += 1
                    else:
                        try type_expr()
                    if not peek(","):
                        break
                    comp.pos += 1
                try expect("]")
            finish(n)
        elif t.text == "(":
            comp.pos += 1
            try type_expr()
            try expect(")")
        else:
            return unexpected("a type goes here")
        while prefixes > 0:
            prefixes -= 1
            comp.depth -= 1
            finish(at + prefixes)
        if peek("?"):
            wrap(at, TUnary, comp.pos)
            comp.pos += 1
            finish(at)
        if not peek("|") and not peek("||"):
            break
        if at == start:
            wrap(start, TUnion, comp.pos)
        elif here().text != text(start):
            return unexpected("a type mixes | and ||, group one side in parentheses")
        comp.pos += 1
    if comp.nodes[start].kind == TUnion:
        finish(start)
    return null

func qualifier() -> &strview:
    if here().kind == Name and comp.tokens[comp.pos + 1].text == "." and comp.tokens[comp.pos + 2].kind == Name:
        return module_of(here().text, file_of(here().at))
    return ""

func qualified(kind: NodeKind) -> usize:
    module := qualifier()
    if module.len > 0:
        comp.pos += 2
    n := begin(kind, comp.pos)
    comp.nodes[n].module = module
    comp.pos += 1
    return n

func new_name(of_value: bool) -> Fail?:
    t := here()
    if reserved(t.text) or of_value and t.text == "reverse":
        return fail("'" + t.text + "' is a keyword of the language, it cannot be used as a name", t.at)
    if of_value and module_of(t.text, comp.files.len - 1).len > 0:
        return fail(t.text + " names a module in this file, a variable or a constant cannot take it", t.at)
    return null

func reserved(word: &strview) -> bool:
    switch word:
    case "if", "elif", "else", "while", "for", "in", "switch", "case", "break", "continue", "return", "defer", "with", "pass", "and", "or", "xor", "not", "is", "as", "try", "trust", "parallel", "wait", "iferror", "ifnull", "true", "false", "null":
        return true
    return false

func same_line_next(word: &strview) -> bool:
    t := here()
    return t.kind == Line and t.text.len == comp.width and comp.tokens[comp.pos + 1].text == word

func end_line() -> Fail?:
    if here().kind != Line and here().kind != End:
        return unexpected("the statement already ended")
    return null

func peek(s: &strview) -> bool:
    t := here()
    return t.kind != Str and t.text == s

func expect(s: &strview) -> Fail?:
    if not peek(s):
        return unexpected("'" + s + "' goes here")
    comp.pos += 1
    return null

func unexpected(message: &strview) -> Fail?:
    t := here()
    if t.kind == Line:
        last := comp.tokens[comp.pos - 1]
        return fail("the line ends here, " + message, last.at + last.text.len)
    return fail("unexpected '" + t.text + "', " + message, t.at)

func here() -> Token:
    return comp.tokens[comp.pos]

func begin(kind: NodeKind, tok: usize) -> usize:
    append(comp.nodes, Node{kind, tok, 0, ""})
    return comp.nodes.len - 1

func finish(n: usize):
    comp.nodes[n].size = comp.nodes.len - n

func wrap(start: usize, kind: NodeKind, tok: usize):
    append(comp.nodes, Node{kind, tok, 0, ""})
    i := comp.nodes.len - 1
    while i > start:
        comp.nodes[i] = comp.nodes[i - 1]
        i -= 1
    comp.nodes[start] = Node{kind, tok, 0, ""}
