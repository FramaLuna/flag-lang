@trust
use fs
use os

type error Fail

type enum TokenKind:
    Name, Builtin, Generic, Int, Float, Str, Symbol, Line, End

type Token:
    kind: TokenKind
    text: &strview
    at: i64
    line: i64

type Source:
    path: &str
    code: &str
    start: i64
    module: &strview
    library: bool

type Trust:
    from: i64
    to: i64
    check: bool

type Use:
    file: i64
    module: &strview
    alias: &strview
    at: i64
    path: &strview # the folder of a use in quotes

type enum NodeKind:
    Func, Struct, Fat, Context, Alias, Void, Extern, Field, Var, Named, Constant, Assign
    TName, TUnary, TUnion, TFunc, TTuple
    Block, Return, If, While, For, Switch, Case, Jump, Assert, Defer, With, Where
    Name, Literal, Call, Brace, Fill, Index, Binary, Unary, Choice, Items, Pairs

type Node:
    kind: NodeKind
    tok: i64
    size: i64
    module: &strview

type Sym:
    name: &strview = ""
    node: i64
    next: i64
    module: &strview = ""
    priv: bool
    error: bool
    packed: bool
    export: bool
    library: bool

type enum TypeKind:
    Void, Bool, Int, Uint, Float, Ptr, Func, Bytes, Struct, Fat, Union, Untagged, Array, Simd, Thread, Given, Atomic

type Type:
    kind: TypeKind
    name: &strview
    size: i64
    align: i64
    elem: i64
    ret: i64
    first: i64
    count: i64
    start: i64
    args: i64
    decl: i64
    tag: u32
    error: bool
    packed: bool
    foreign: bool
    stamped: bool # it starts at something other than zero: the tag of a union without null, or the default value of a field
    hollow: bool # zero is not a value of it: a fat pointer, or a struct or an array that holds one with no default

type Item:
    name: &strview = ""
    type: i64
    n: i64
    shared: bool
    default: i64 # the node of the default value of a field, 0 when it has none

type Inst:
    node: i64
    name: &strview
    binds: i64
    count: i64
    ret: i64
    at: i64
    export: bool
    library: bool
    depth: i64
    taken_as: i64

type enum ArgKind:
    Empty, Temp, Const, Single, Double, Global

type Arg:
    kind: ArgKind
    n: i64

type Ins:
    op: &strview
    cls: u32
    to: u32
    a: Arg
    b: Arg
    c: Arg
    first: u32
    count: u32
    pos: i64
    shape: i64 # the type whose words it copies, for -memory to see which hold a pointer
    number: bool
    copy: bool
    ghost: bool
    member: u32

type Pass:
    cls: u32
    arg: Arg
    number: bool
    value: i64 # of a parameter, the struct or array that the function takes by value, else VOID

type enum PieceKind:
    Zeros, Number, Address, Text, File

type Piece:
    kind: PieceKind
    size: i64 # of a number, 1, 2, 4 or 8 bytes
    n: i64 # the number, how many zeros, or what the address adds
    text: &strview = "" # the bytes, the path of the file, or the name of what the address points to

type CField: # a field of a type that crosses the C ABI by value, as the calling conventions read it
    kind: u8 # b, h, w, l, s or d, or c for a type of C, type
    type: i64
    count: i64

type Data:
    name: &strview
    align: i64 = 8
    first: i64 # its pieces in comp.pieces
    count: i64
    fixed: bool # the program only reads it
    thread: bool # each thread has its own, and the code names it thread $name

type Mention:
    temp: u32
    name: &strview
    type: i64
    tok: i64
    scope: i64
    pointer: u32

type Proc:
    name: &strview
    cls: u32
    file: i64
    params: i64
    count: i64
    code: i64
    end: i64
    temps: u32
    last: u32
    labels: u32
    mentions: i64
    mentioned: i64
    scopes: i64
    scoped: i64
    node: i64
    inst: i64
    export: bool
    recursive: bool

type Local:
    name: &strview
    type: i64
    addr: Arg
    depth: i64
    tok: i64
    limit: u64
    fixed: &strview # why it cannot be assigned, or nothing when it can
    unread: i64 # where it got an error or a thread that nothing read since, or 0
    given: bool # some path gave it a value, which one of a hollow type declared without a value has not
    inside: bool # the element in place of what a for walks, which lives where that does

type Value:
    type: i64
    at: Arg
    mem: bool
    place: bool
    lit: bool
    neg: bool
    flipped: bool # a literal made by not, its bits wrap at the width of an unsigned place
    n: u64
    element: i64

type Loop:
    exit: u32
    again: u32
    defers: i64
    slots: i64 # the first slot of a round
    counter: i64 # the local that counts the elements of a walk, or 0
    walk: u32 # the walk that counter counts, for -memory
    whole: i64 # the node of the list or array that the walk visits whole, 0 for none, NONE once it indexes another one that holds pointers
    broke: bool

type Deferred:
    node: i64
    visible: i64
    subject: Value

context comp:
    files: &list[Source] = heap([])
    uses: &list[Use] = heap([])
    libs: &list[&strview] = heap([])
    library: &str = heap("")
    tokens: &list[Token] = heap([])
    trusted: &list[Trust] = heap([])
    nodes: &list[Node] = heap([])
    pos: i64
    width: i64
    depth: i64
    syms: &list[Sym] = heap([])
    names: &map[&strview, i64] = heap({})
    types: &list[Type] = heap([])
    type_ids: &map[&strview, i64] = heap({})
    items: &list[Item] = heap([])
    binds: &list[Item] = heap([])
    frame: i64
    insts: &list[Inst] = heap([])
    inst_ids: &map[&strview, i64] = heap({})
    inst_binds: &list[Item] = heap([])
    chosen: &map[&strview, i64] = heap({})
    resolving: &list[i64] = heap([])
    spelled: i64
    c_types: &list[i64] = heap([])
    c_fields: &list[CField] = heap([]) # those of each of c_types, after each one with no count
    data: &list[Data] = heap([])
    pieces: &list[Piece] = heap([])
    texts: &list[i64] = heap([])
    stored: &map[&strview, i64] = heap({})
    globals: &list[&strview] = heap([])
    global_ids: &map[&strview, i64] = heap({})
    reached: i64
    procs: &list[Proc] = heap([])
    code: &list[Ins] = heap([])
    body: &list[Ins] = heap([])
    slots: &list[Ins] = heap([])
    spare: &list[i64] = heap([])
    held: &list[i64] = heap([])
    passes: &list[Pass] = heap([])
    mentions: &list[Mention] = heap([])
    scopes: &list[i64] = heap([])
    scope: i64
    temps: u32
    numbers: &list[bool] = heap([])
    labels: u32
    at: i64
    site: i64
    target: i64
    passed: i64
    elements: &list[Value] = heap([])
    turns: &list[i64] = heap([]) # of the values of each call or literal being made, those whose code calls something: the index and where the code starts
    calls: i64 # how many calls the code made, but for those that never return, to know when it may have changed what was read
    vars: &list[Local] = heap([])
    given: &list[i64] = heap([]) # the locals that got their first value, in order, so a branch takes back what the one before it gave
    defers: &list[Deferred] = heap([])
    loops: &list[Loop] = heap([])
    sliced: i64 # the last slice that shows a whole list or array, for -memory
    leaving: i64
    staying: i64
    ret: i64
    dest: Arg
    blame: i64
    live: bool
    inst: i64
    entry: i64 # main, the main of C
    tests: &list[i64] = heap([])
    settler: i64 # main, when the program starts threads
    stamping: bool # a context of a thread starts at something other than zero, which stamp writes when the thread enters
    asked: i64
    defined: &list[i64] = heap([])
    hover: &str = heap("")
    system: &strview = ""
    machine: &strview = ""
    choosing: bool
    debug: bool
    shared: bool
    err: &strview = "error: " # in color when the errors go to a terminal
    note: &strview = "note: "
    warn: &strview = "warning: "

extern "c":
    func realpath(path: cstr, into: *u8) -> cstr
    func _wfullpath(into: wstr, path: wstr, size: i64) -> wstr
    func getpid() -> i32
    func flag_embedded(index: i64, name: *cstr, size: *i64) -> *bytes
    func flag_version() -> cstr
    func flag_stamp() -> cstr
    func flag_target() -> cstr
    func isatty(fd: i32) -> i32

extern "c" where @linux():
    func getrlimit(what: i32, limits: *array[u64, 2]) -> i32
    func setrlimit(what: i32, limits: *array[u64, 2]) -> i32

func main() -> i32:
    where @linux(): # 500 levels of nesting take more than 8 MiB of stack on arm64
        stack: array[u64, 2]
        _ = getrlimit(3, ptr(stack))
        stack[0] = max(stack[0], min(u64(16 << 20), stack[1]))
        _ = setrlimit(3, ptr(stack))
    plain := env("NO_COLOR") ifnull ""
    if isatty(2) != 0 and plain.len == 0:
        comp.err = "\e[1;31merror:\e[0m "
        comp.note = "\e[1;36mnote:\e[0m "
        comp.warn = "\e[1;33mwarning:\e[0m "
    output: &str = heap("")
    keep := false
    check := false
    memory := false
    overlay: &strview
    query: &strview|null = null
    target := view(flag_target())
    inputs: &list[&strview] = heap([])
    rest: &list[&strview] = heap([])
    arguments := args()
    testing := arguments.len > 1 and arguments[1] == "test"
    running := arguments.len > 1 and arguments[1] == "run" or testing
    program: &list[&strview] = heap([])
    seconds := 10
    passing := false
    i := 1 + i64(running)
    while i < arguments.len:
        a := arguments[i]
        if running and a == "--":
            append(program, arguments[i + 1:])
            break
        if passing:
            append(rest, a)
        elif a == "-cc":
            passing = true
        elif a == "-o" or a == "-overlay" or a == "-at" or a == "-target" or a == "-timeout":
            i += 1
            if i == arguments.len:
                eprint(comp.err, "option ", a, " requires a value")
                return 2
            if a == "-o":
                output = arguments[i]
            elif a == "-overlay":
                overlay = arguments[i]
            elif a == "-target":
                target = arguments[i]
            elif a == "-timeout":
                seconds = parse_int(arguments[i]) ifnull 0
                if seconds < 1 or seconds > 2000000:
                    eprint(comp.err, "-timeout expects an integer between 1 and 2000000 seconds, got ", arguments[i])
                    return 2
            else:
                query = arguments[i]
        elif a == "-keep":
            keep = true
        elif a == "-check":
            check = true
        elif a == "-memory":
            memory = true
        elif a == "-debug":
            comp.debug = true
        elif a == "-shared":
            comp.shared = true
        elif a == "-version":
            print("flag ", view(flag_version()))
            return 0
        elif a == "-docs":
            folder: &str = heap(dir_of(executable()))
            folder += "../docs"
            if not exists(join_path(folder, "Reference.md")): # a docs folder beside bin that lacks it is someone else's
                library := cached_library()
                folder = join_path(library, "docs")
                if not exists(join_path(library, "core.flg")) or make_dir(view(folder)) is FsError or not unpack(view(folder), true):
                    eprint(comp.err, "failed to unpack documentation into ", folder)
                    return 1
            print(real_path(view(folder)))
            return 0
        elif ends_with(a, ".flg") or is_dir(a): # a folder gives its files once the overlay is read
            append(inputs, a)
        elif a == "run" or a == "test":
            line: &str = heap("flagc " + a)
            for j in 1..arguments.len:
                if j != i:
                    line += " " + arguments[j]
            eprint(comp.err, "'", a, "' must be the first argument: ", line)
            return 2
        elif a == "--":
            line: &str = heap("flagc run")
            for b in arguments[1:]:
                line += " " + b
            eprint(comp.err, "'--' passes arguments to 'run' or test filters to 'test', so it requires 'run' or 'test' first: ", line)
            return 2
        elif starts_with(a, "-") or exists(a):
            line: &str = heap("flagc")
            moved := false
            for j in 1..arguments.len:
                b := arguments[j]
                if j == i:
                    continue
                if not moved and b == "--":
                    line += " -cc " + a
                    moved = true
                line += " " + b
                if not moved and b == "-cc":
                    line += " " + a
                    moved = true
            if not moved:
                line += " -cc " + a
            if starts_with(a, "-"):
                eprint(comp.err, "unknown flagc option ", a, "; pass C compiler options after -cc: ", line)
            else:
                eprint(comp.err, "non-Flag file ", a, " must be passed to the C compiler after -cc: ", line)
            return 2
        else:
            eprint(comp.err, "unrecognized argument ", a, " (not a flagc option, .flg file, or directory)")
            return 2
        i += 1
    if inputs.len == 0:
        eprint("usage: flagc [run|test] file.flg dir ... [-o output] [-shared] [-keep] [-check] [-memory] [-debug] [-target os-arch] [-overlay file] [-at file:line:col] [-timeout seconds] [-version] [-docs] [-cc cc-args...] [-- run-args | test-filters]")
        return 2
    if running and comp.shared:
        eprint(comp.err, "'", arguments[1], "' executes a program, but '-shared' builds a shared library; build with '-o' and load it from a host program")
        return 2
    targets := ["linux-x86_64", "linux-arm64", "linux-riscv64", "macos-x86_64", "macos-arm64", "windows-x86_64", "wasm-wasm32", "wasm-wasm64"]
    if not contains(ptr(targets), target):
        eprint(comp.err, "unknown target ", target, "; supported targets are: ", join(ptr(targets), ", "))
        return 2
    comp.system = target[:trust find(target, "-")]
    comp.machine = target[comp.system.len + 1:]
    if running and comp.system == "wasm":
        eprint(comp.err, "'", arguments[1], "' executes a program, but -target ", target, " builds a WebAssembly module; build with '-o' and load it from a WebAssembly host")
        return 2
    texts: &map[&strview, &strview] = heap({})
    if overlay.len > 0:
        given := read_file(overlay)
        if given is FsError:
            eprint(comp.err, given)
            return 1
        rest_of := view(given)
        while rest_of.len > 0:
            path_end := find(rest_of, "\n")
            size_end: i64|null = null
            size: i64|null = null
            if path_end is i64:
                size_end = find(rest_of[path_end + 1:], "\n")
            if path_end is i64 and size_end is i64:
                size = parse_int(rest_of[path_end + 1:path_end + 1 + size_end])
            if path_end is null or size_end is null or size is null or size < 0 or size > rest_of.len - path_end - size_end - 2:
                eprint(comp.err, "invalid overlay file ", overlay, "; each entry must be a path line, a byte-length line, and that many bytes of content")
                return 1
            from := path_end + size_end + 2
            put(texts, real_path(rest_of[:path_end]), rest_of[from:from + size])
            rest_of = rest_of[from + size:]
    files: &list[&strview] = heap([]) # the inputs, with the .flg files of each folder, saved or in the overlay, in order
    for input in inputs:
        if ends_with(input, ".flg"):
            append(files, input)
            continue
        found: &list[&strview] = heap([])
        walked := walk_dir(input)
        if walked is &listview[&strview]:
            for path in walked:
                if ends_with(path, ".flg"):
                    append(found, path)
        root := real_path(input)
        for e in texts:
            if ends_with(e.key, ".flg") and starts_with(e.key, root) and e.key.len > root.len + 1:
                inner := e.key[root.len:]
                if items(inner)[0] == '/' or items(inner)[0] == '\\':
                    append(found, join_path(input, inner))
        if found.len == 0:
            eprint(comp.err, "directory ", input, " contains no .flg files")
            return 2
        sort(found)
        append(files, found[:])
    fleeting := running and output.len == 0
    suffix: &strview = ".out"
    if comp.system == "windows":
        suffix = ".exe"
    if comp.system == "wasm":
        suffix = ".wasm"
    elif comp.shared:
        suffixes := {"linux": ".so", "macos": ".dylib", "windows": ".dll"}
        suffix = trust suffixes[comp.system]
    if fleeting:
        output = "/tmp"
        temp_dir := env("TEMP")
        if temp_dir is &strview and temp_dir.len > 0:
            output = temp_dir
        output += "/flag-run-" + getpid() + suffix
    elif output.len == 0:
        output = "a" + suffix
    builtin: &strview = "void null bool i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 bytes cstr wstr emptyarray emptyfixmap IterationEnd never bool8 bool16 bool32 bool64"
    start := 0
    for k in 0..=builtin.len:
        if k == builtin.len or items(builtin)[k] == ' ':
            id := comp.types.len
            t := Type{kind = Void, name = builtin[start:k], align = 1}
            if id == BOOL:
                t.kind = Bool
                t.size = 1
            elif id >= I8 and id <= I64:
                t.kind = Int
                t.size = 1 << (id - I8)
            elif id >= U8 and id <= U64:
                t.kind = Uint
                t.size = 1 << (id - U8)
            elif id >= F32 and id <= F64:
                t.kind = Float
                t.size = 4 * (id - F32 + 1)
            elif id == BYTES:
                t.kind = Bytes
            elif id == CSTR or id == WSTR:
                t.kind = Ptr
                t.size = 8
                t.elem = U8 + id - CSTR # u8 or u16
            elif id >= BOOL8:
                t.kind = Bool
                t.size = 1 << (id - BOOL8)
            if t.size > 0:
                t.align = t.size
            add_type(t)
            start = k + 1
    nothing: Sym
    append(comp.syms, nothing)
    finish(begin(Void, 0)) # node 0 is no node, as symbol 0 is no symbol
    comp.library = dir_of(executable())
    comp.library += "../lib/"
    here := current_dir() + "/"
    if starts_with(view(comp.library), here):
        comp.library = comp.library[here.len:]
    if not exists(join_path(comp.library, "core.flg")):
        comp.library = cached_library()
        if not exists(join_path(comp.library, "core.flg")):
            eprint(comp.err, "failed to unpack standard library into ", comp.library)
            return 1
    core: &str = heap(join_path(comp.library, "core.flg"))
    loaded: &map[&strview, i64] = heap({}) # the files of the program by their real path, and core
    put(loaded, real_path(view(core)), 0)
    if add_file(core, read_source(view(core), texts), true) is Fail:
        return 1
    for path in files:
        if load(path, loaded, texts) is Fail:
            return 1
    # the folders of the uses in quotes go before the library, whose modules give way to those of the program
    done := 0
    while done < comp.uses.len:
        u := comp.uses[done]
        done += 1
        if u.path.len == 0:
            continue
        if not is_dir(u.path):
            if exists(join_path(comp.library, u.module + ".flg")):
                _ = fail("directory " + u.path + " not found; standard library module " + u.module + " is imported without quotes: use " + u.module, u.at)
            else:
                _ = fail("directory " + u.path + " not found; relative 'use' paths are resolved from this file's directory", u.at)
            return 1
        again := false
        for v in comp.uses[:done - 1]:
            if v.path.len > 0 and v.module == u.module and real_path(v.path) != real_path(u.path):
                _ = fail("module name conflict: both " + v.path + " and " + u.path + " provide module " + u.module + "; module names must be unique", u.at)
                return 1
            again = again or v.path.len > 0 and v.module == u.module
        if again:
            continue
        found: &list[&strview] = heap([])
        names := list_dir(u.path)
        if names is &listview[&strview]:
            for name in names:
                if ends_with(name, ".flg"):
                    append(found, join_path(u.path, name))
        for e in texts:
            unsaved := join_path(u.path, base_name(e.key))
            if ends_with(unsaved, ".flg") and real_path(unsaved) == e.key:
                append(found, unsaved)
        if found.len == 0:
            _ = fail("directory " + u.path + " contains no .flg files", u.at)
            return 1
        sort(found)
        holds := false
        for path in found:
            k := load(path, loaded, texts)
            if k is Fail:
                return 1
            holds = holds or comp.files[k].module == u.module
        if not holds:
            _ = fail("directory " + u.path + " has no file declaring 'module " + u.module + "'; the directory name must match the module name", u.at)
            return 1
    done = 0
    while done < comp.uses.len:
        u := comp.uses[done]
        done += 1
        if u.path.len > 0:
            continue
        known := false
        path: &str = heap(join_path(comp.library, written(u.module) + ".flg"))
        fresh := exists(view(path))
        for f in comp.files:
            known = known or f.module == u.module
            fresh = fresh and not (f.library and f.path == path)
        if not known and fresh:
            if add_file(path, read_source(view(path), texts), true) is Fail:
                return 1
            known = comp.files[-1].module == u.module
        if not known:
            _ = fail("module " + u.module + " not found in project files or standard library (" + u.module + ".flg)", u.at)
            return 1
    if query is &strview:
        parts := split(query, ":")
        line: i64|null = null
        column: i64|null = null
        if parts.len > 2:
            line = parse_int(parts[-2])
            column = parse_int(parts[-1])
        if line is null or column is null or line < 1 or column < 1:
            eprint(comp.err, "-at expects 'file:line:column', got ", query)
            return 2
        path := query[:query.len - parts[-2].len - parts[-1].len - 2]
        wanted := real_path(path)
        f := 0
        while f < comp.files.len and real_path(view(comp.files[f].path)) != wanted:
            f += 1
        if f == comp.files.len:
            eprint(comp.err, "-at file ", path, " is not among the compiled files")
            return 2
        code := comp.files[f].code
        first := 0
        row := 1
        while row < line and first < code.len:
            if items(code)[first] == '\n':
                row += 1
            first += 1
        last := first
        while last < code.len and items(code)[last] != '\n':
            last += 1
        if row < line:
            eprint(comp.err, "-at ", query, " is past end of file (last line is ", row, ")")
            return 2
        if first + column - 1 > last:
            eprint(comp.err, "-at ", query, " is past end of line (last column is ", last - first + 1, ")")
            return 2
        at := comp.files[f].start + first + column - 1
        for t in 0..comp.tokens.len:
            k := comp.tokens[t]
            if k.kind != Line and k.at <= at and at < k.at + k.text.len:
                comp.asked = t + 1
    failed := gen_program(check, testing) is Fail
    if memory and not failed:
        check_memory()
    if comp.asked != 0:
        for s in comp.syms:
            if s.name.len > 0 and comp.nodes[s.node].tok == comp.asked - 1:
                mark(comp.asked - 1)
        for d in comp.defined:
            print("definition ", location(comp.tokens[d].at))
        if comp.hover.len > 0:
            for line in split(view(comp.hover), "\n"):
                print("hover ", line)
    if failed:
        return 1
    if check:
        return 0
    if comp.system == "wasm":
        module := assemble()
        if module is Fail:
            return 1
        if write_file(view(output), module) is FsError:
            eprint(comp.err, "failed to write WebAssembly module ", output)
            return 1
        return 0
    asm_file: &str = heap(output)
    asm_file += ".s"
    if write_file(view(asm_file), assembly()) is FsError:
        eprint(comp.err, "failed to write assembly file ", asm_file)
        return 1
    cc: &list[&strview] = heap([])
    compiler: &strview = "cc"
    given := env("CC")
    if given is &strview and given.len > 0:
        compiler = given
    for part in split(compiler, " "):
        if part.len > 0:
            append(cc, part)
    linking: &strview = "; flagc links using a C compiler (set the CC environment variable to choose one)"
    source := view(asm_file)
    object: &str = heap(output)
    object += ".o"
    apart := comp.debug and comp.system == "macos" # dsymutil reads the DWARF from the object, so it outlives the link
    if apart:
        assembling: &list[&strview] = heap([])
        append(assembling, cc)
        append(assembling, ptr(["-c", "-o", view(object), view(asm_file)]))
        if not ran(assembling, linking):
            return 1
        source = view(object)
    link: &list[&strview] = heap([])
    append(link, cc)
    append(link, "-o")
    append(link, output)
    append(link, source)
    folders: &list[&strview] = heap([]) # where the linker looks for a library, and flagc for a file that an extern names
    for k, r in rest:
        if starts_with(r, "-L") and r.len > 2:
            append(folders, r[2:])
        elif r == "-L" and k + 1 < rest.len:
            append(folders, rest[k + 1])
    append(folders, comp.library)
    for f in comp.files:
        if not f.library:
            append(folders, dir_of(view(f.path)))
    for f in folders:
        append(link, "-L" + f)
    for l in comp.libs:
        if ends_with(l, ".framework"):
            append(link, ptr(["-framework", l[:-10]]))
        elif not (ends_with(l, ".so") or contains(l, ".so.") or ends_with(l, ".a") or ends_with(l, ".dylib") or ends_with(l, ".dll")):
            append(link, "-l" + l)
        elif comp.system == "linux":
            append(link, "-l:" + l) # the linker looks in its own folders too, where the libraries of the system are
        else:
            path := ""
            for f in folders:
                if path.len == 0 and exists(join_path(f, l)):
                    path = join_path(f, l)
            if path.len == 0:
                eprint(comp.err, "library file ", l, " not found in search directories: ", join(folders, ", "))
                return 1
            append(link, path)
    if comp.shared:
        append(link, "-shared")
    if comp.shared and comp.system == "linux":
        append(link, ptr(["-fPIC", "-Wl,-Bsymbolic"])) # a library calls its own functions, never those of the program or of another library
    for r in rest:
        append(link, r)
    if not ran(link, linking):
        return 1
    if apart and exists(view(output)) and not ran(ptr(["dsymutil", view(output)]), ", -debug on macOS keeps the DWARF in " + output + ".dSYM with dsymutil"):
        return 1
    if not keep:
        _ = remove_file(view(asm_file))
        if apart:
            _ = remove_file(view(object))
    if not running:
        return 0
    me := view(output)
    if not contains(me, "/"):
        me = "./" + me
    code: i32|FsError = 0
    if testing:
        chosen: &list[i64] = heap([])
        for k in comp.tests:
            picked := program.len == 0
            for word in program:
                picked = picked or contains(test_name(k), word)
            if picked:
                append(chosen, k)
        if chosen.len == 0:
            words: &str = heap("")
            for word in program:
                if words.len > 0:
                    words += " or "
                words += word
            eprint(comp.err, "no test name matches ", words)
            code = 2
        commands: &list[&list[&strview]] = heap([])
        codes: &list[i32|FsError] = heap([])
        said: &list[&str] = heap([])
        for k in chosen:
            append(commands, heap([me, test_name(k), "" + seconds]))
            append(codes, 0)
            append(said, heap(""))
        queue: Channel[i64, 64]
        workers: &list[Thread[null]] = heap([])
        while workers.len < cores() and workers.len < chosen.len:
            append(workers, parallel run_tests(ptr(queue), commands, codes, said))
        for j in 0..chosen.len:
            send(ptr(queue), j)
        close(ptr(queue))
        for w in workers:
            wait(w)
        failures := 0
        for j, k in chosen:
            ended := codes[j]
            if ended is i32 and ended == 0:
                continue
            failures += 1
            how := "" + ended
            if ended is i32 and ended < 0:
                how = "exit code " + hex(ended) # the exception of Windows that ended it, like 0xc0000005
            elif ended is i32:
                how = "exit code " + ended
            at := comp.tokens[comp.nodes[comp.syms[k].node].tok].at
            print("FAIL ", test_name(k), ", ", comp.files[file_of(at)].path, ":", line_of(at), ", ", how)
            write(stdout, said[j])
            if said[j].len > 0 and not ends_with(said[j], "\n"):
                print()
        if chosen.len > 0:
            print(chosen.len - failures, " passed, ", failures, " failed")
            code = i32(failures > 0)
    else:
        insert(program, 0, me)
        code = run(program)
    if fleeting:
        _ = remove_file(view(output))
    if code is FsError:
        eprint(comp.err, code)
        return 1
    return code

# each test reads the end of its input and writes to a pipe, the output and the errors in the order it wrote them
func run_tests(queue: *Channel[i64, 64], commands: &listview[&list[&strview]], codes: &listview[i32|FsError], said: &listview[&str]):
    for j in queue:
        p := start(commands[j])
        if p is FsError:
            codes[j] = p
            continue
        close(p.input)
        got := 1
        while got > 0:
            got = read(p.output, ptr(said[j]), 65536) iferror 0
        close(p.output)
        codes[j] = wait(p)

# the folder of this version in the cache, which holds its library from the moment it exists
func cached_library() -> &str:
    root: &str = heap("/tmp")
    cache := env("XDG_CACHE_HOME")
    local := env("LOCALAPPDATA")
    home := env("HOME")
    if cache is &strview and cache.len > 0:
        root = cache
    elif local is &strview and local.len > 0:
        root = local
    elif home is &strview and home.len > 0:
        root = home
        root += "/.cache"
    folder: &str = heap(join_path(root, "flag/"))
    folder += view(flag_stamp()) + "/"
    if not exists(join_path(folder, "core.flg")):
        part: &str = heap(folder[:-1])
        part += ".part" + getpid()
        _ = make_dir(view(part))
        if unpack(view(part), false):
            _ = rename_file(view(part), folder[:-1])
        left := list_dir(view(part)) # another flagc got there first
        if left is &listview[&strview]:
            for name in left:
                _ = remove_file(join_path(part, name))
        _ = remove_file(view(part))
    return folder

# writes each embedded file that folder lacks, of the docs or of the library, whole: another flagc may be reading it
func unpack(folder: &strview, docs: bool) -> bool:
    whole := true
    name: cstr
    size := 0
    k := 0
    data := flag_embedded(k, ptr(name), ptr(size))
    while data as u64 != 0:
        if starts_with(view(name), "docs/") == docs:
            path: &str = heap(join_path(folder, base_name(view(name))))
            if not exists(view(path)):
                part: &str = heap(path)
                part += ".part" + getpid()
                file: &strview
                file = data
                file.len = size
                whole = write_file(view(part), file) is null and rename_file(view(part), view(path)) is null and whole
                _ = remove_file(view(part))
        k += 1
        data = flag_embedded(k, ptr(name), ptr(size))
    return whole

func ran(command: &listview[&strview], why: &strview) -> bool:
    code := run(command)
    if code is FsError:
        eprint(comp.err, code, why)
        return false
    return code == 0

func real_path(path: &strview) -> &strview where not @windows():
    found := realpath(cstr(path), 0 as *u8)
    if found as u64 != 0:
        return view(found)
    folder := dir_of(path)
    if folder == "./":
        here := realpath(".", 0 as *u8)
        if here as u64 == 0:
            return path
        return heap(join_path(view(here), path))
    if folder == "/" or folder == path:
        return path
    return heap(join_path(real_path(folder[:-1]), base_name(path)))

func real_path(path: &strview) -> &strview where @windows():
    found := _wfullpath(0 as wstr, wstr(path), 0)
    if found as u64 == 0:
        return path
    return heap(tmp(found))

# a file of the program, loaded once, and its place among the files
func load(path: &strview, loaded: *&map[&strview, i64], texts: &map[&strview, &strview]) -> i64|Fail:
    real := real_path(path)
    known := loaded[real]
    if known is i64:
        return known
    put(loaded, real, comp.files.len)
    try add_file(heap(path), read_source(path, texts), false)
    return comp.files.len - 1

func read_source(path: &strview, texts: &map[&strview, &strview]) -> &str|FsError:
    code := texts[real_path(path)] ifnull view(try read_file(path))
    if starts_with(code, "\xef\xbb\xbf"):
        code = code[3:]
    return heap(code)

func add_file(path: &str, code: &str|FsError, library: bool) -> Fail?:
    if code is &str:
        start := 0
        if comp.files.len > 0:
            last := comp.files[-1]
            start = last.start + last.code.len + 1
        own: &str = heap("")
        for b in items(base_name(view(path))):
            if is_letter(b) or is_digit(b) or b == '.':
                add_byte(own, b)
            else:
                add_byte(own, '_')
        for f in comp.files:
            if f.module == view(own):
                own += "." + comp.files.len
        append(comp.files, Source{path, code, start, view(own), library})
        comp.pos = comp.tokens.len # a file loaded for an error comes in the middle of the checks
        comp.depth = 0
        try lex(comp.files.len - 1)
        return parse()
    eprint(comp.err, code)
    return Fail

func fail(message: &strview, at: i64) -> Fail:
    eprint(comp.err, message)
    show(at)
    return Fail

func note(message: &strview, at: i64):
    eprint(comp.note, message)
    show(at)

func show(at: i64):
    blamed := comp.blame
    comp.blame = 0
    if blamed != 0 and comp.insts[comp.inst].library and blamed != at:
        show(blamed)
        eprint(comp.note, "failed here inside library generic ", text(comp.insts[comp.inst].node), " with ", made(comp.inst))
    f := comp.files[file_of(at)]
    bytes := items(f.code)
    local := at - f.start
    first := line_start(at) - f.start
    line: &str = heap("")
    pad: &str = heap("")
    i := first
    while i < f.code.len and bytes[i] != '\n':
        b := bytes[i]
        if b < ' ' and b != '\t':
            b = ' '
        add_byte(line, b)
        if i < local and b == '\t':
            pad += "\t"
        elif i < local and (b and 0xc0) != 0x80:
            pad += " "
        i += 1
    eprint("  --> ", location(at))
    eprint("   | ", line)
    eprint("   | ", pad, "^")
    free(line)
    free(pad)
    if blamed != 0 and not comp.insts[comp.inst].library:
        note("while instantiating " + text(comp.insts[comp.inst].node) + " for this call with " + made(comp.inst), blamed)

func location(at: i64) -> &str:
    f := comp.files[file_of(at)]
    out: &str = heap("")
    out += f.path + ":" + line_of(at) + ":" + (at - line_start(at) + 1)
    return out

func token_at(at: i64) -> i64:
    low := 0
    high := comp.tokens.len
    while high - low > 1:
        middle := (low + high) / 2
        if comp.tokens[middle].at <= at:
            low = middle
        else:
            high = middle
    return low

func line_of(at: i64) -> i64:
    f := comp.files[file_of(at)]
    low := token_at(at)
    line := 1
    from := f.start
    if comp.tokens[low].at >= f.start and comp.tokens[low].at <= at:
        line = comp.tokens[low].line
        from = comp.tokens[low].at
    for i in from..at:
        if items(f.code)[i - f.start] == '\n':
            line += 1
    return line

func line_start(at: i64) -> i64:
    f := comp.files[file_of(at)]
    while at > f.start and items(f.code)[at - f.start - 1] != '\n':
        at -= 1
    return at

func header(tok: i64) -> &strview:
    first := tok
    while comp.tokens[first - 1].kind != Line:
        first -= 1
    last := tok
    while comp.tokens[last + 1].kind != Line:
        last += 1
    return excerpt(first, last)

func excerpt(first: i64, last: i64) -> &strview:
    f := comp.files[file_of(comp.tokens[first].at)]
    return f.code[comp.tokens[first].at - f.start:comp.tokens[last].at + comp.tokens[last].text.len - f.start]

# how many brackets the tokens from first to last open, less the ones they close
func unclosed(first: i64, last: i64) -> i64:
    open := 0
    for t in comp.tokens[first:last + 1]:
        if t.kind == Symbol and (t.text == "(" or t.text == "[" or t.text == "{"):
            open += 1
        elif t.kind == Symbol and (t.text == ")" or t.text == "]" or t.text == "}"):
            open -= 1
    return open

func mark(tok: i64, hover: &strview = ""):
    for d in comp.defined:
        if d == tok:
            return
    append(comp.defined, tok)
    if comp.hover.len > 0:
        comp.hover += "\n"
    if hover.len == 0:
        hover = header(tok)
    comp.hover += hover

func node_end(n: i64) -> i64:
    return n + comp.nodes[n].size

func kid(n: i64, k: i64) -> i64:
    c := n + 1
    for i in 0..k:
        c += comp.nodes[c].size
    return c

func kids(n: i64) -> i64:
    count := 0
    c := n + 1
    while c < node_end(n):
        count += 1
        c += comp.nodes[c].size
    return count

# the function of C that a func of an extern block calls: its name, or the symbol after =
func linked(f: i64) -> &strview:
    c := kid(f, params(f))
    while c < node_end(f) and comp.nodes[c].kind != Literal:
        c = node_end(c)
    if c == node_end(f):
        return text(f)
    return text(c)[1:text(c).len - 1]

func body(f: i64) -> i64:
    last := 0
    c := f + 1
    while c < node_end(f):
        last = c
        c = node_end(c)
    if last != 0 and comp.nodes[last].kind == Block:
        return last
    return 0

func text(n: i64) -> &strview:
    return comp.tokens[comp.nodes[n].tok].text
