module json

type enum Kind:
    Nothing, Boolean, Number, Text, Array, Object

type Node:
    kind: Kind
    from: usize
    to: usize
    size: usize

type Document:
    text: &strview
    nodes: &list[Node]

type error NotJson

func parse(text: &strview) -> Document|NotJson:
    nodes: &list[Node]
    end := value(text, 0, nodes, 0)
    if end is null or skip(text, end) != text.len:
        free(nodes)
        return NotJson
    return Document{text, nodes}

func free(d: Document):
    free(d.nodes)

func get(d: Document, at: usize|null, path: &strview) -> usize|null:
    found := at
    with scratch():
        for key in split(path, "."):
            if found is null or d.nodes[found].kind != Object:
                return null
            object := found
            found = null
            c := object + 1
            while c < object + d.nodes[object].size and found is null:
                if text(d, c) == key:
                    found = c + 1
                c += 1
                c += d.nodes[c].size
    return found

priv type Children:
    d: Document
    at: usize
    end: usize
    object: bool

func children(d: Document, at: usize|null) -> Children:
    if at is null or d.nodes[at].kind != Array and d.nodes[at].kind != Object:
        return Children{d, 0, 0, false}
    return Children{d, at + 1, at + d.nodes[at].size, d.nodes[at].kind == Object}

func iter(c: Children) -> Children:
    return c

func next(c: *Children) -> usize|IterationEnd:
    if c.at >= c.end:
        return IterationEnd
    if c.object:
        c.at += c.d.nodes[c.at].size
    value := c.at
    c.at += c.d.nodes[c.at].size
    return value

func count(d: Document, at: usize|null) -> usize:
    n: usize = 0
    for c in children(d, at):
        n += 1
    return n

func item(d: Document, at: usize|null, index: usize) -> usize|null:
    for i, c in children(d, at):
        if i == index:
            return c
    return null

func key(d: Document, at: usize|null, index: usize) -> &strview:
    value := item(d, at, index)
    if value is null or kind(d, at) != Object:
        return ""
    return text(d, value - 1)

func kind(d: Document, at: usize|null) -> Kind:
    if at is null:
        return Nothing
    return d.nodes[at].kind

func raw(d: Document, at: usize|null) -> &strview:
    if at is null:
        return ""
    return d.text[d.nodes[at].from:d.nodes[at].to]

func number(d: Document, at: usize|null) -> f64|null:
    if at is null or d.nodes[at].kind != Number:
        return null
    return parse_float(raw(d, at))

func integer(d: Document, at: usize|null) -> i64|null:
    if at is null or d.nodes[at].kind != Number:
        return null
    return parse_int(raw(d, at))

func boolean(d: Document, at: usize|null) -> bool|null:
    if at is null or d.nodes[at].kind != Boolean:
        return null
    return raw(d, at) == "true"

func text(d: Document, at: usize|null) -> &strview:
    if at is null or d.nodes[at].kind != Text:
        return ""
    s := d.text[d.nodes[at].from + 1:d.nodes[at].to - 1]
    if find(items(s), '\\') is null:
        return temp(s)
    out: &str
    i: usize = 0
    while i < s.len:
        if items(s)[i] == '\\':
            e := trust escape(s, i)
            add_char(out, e.code)
            i += e.size
        else:
            add_byte(out, items(s)[i])
            i += 1
    result := temp(out)
    free(out)
    return result

func quoted(out: *&str, text: &strview):
    digits: &strview = "0123456789abcdef"
    out.* += "\""
    i: usize = 0
    while i < text.len:
        run := i
        while run < text.len and items(text)[run] >= ' ' and items(text)[run] != '"' and items(text)[run] != '\\':
            run += 1
        out.* += text[i:run]
        i = run
        if i < text.len:
            b := items(text)[i]
            if b == '"' or b == '\\':
                out.* += "\\" + text[i:i + 1]
            elif b == '\n':
                out.* += "\\n"
            elif b == '\t':
                out.* += "\\t"
            else:
                out.* += "\\u00" + digits[usize(b) / 16:usize(b) / 16 + 1] + digits[usize(b) % 16:usize(b) % 16 + 1]
            i += 1
    out.* += "\""

priv type Escape:
    code: u32
    size: usize

priv func escape(s: &strview, at: usize) -> Escape?:
    if at + 2 > s.len:
        return null
    names: &strview = "\"\\/bfnrt"
    codes: &strview = "\"\\/\x08\x0c\n\r\t"
    simple := find(items(names), items(s)[at + 1])
    if simple is usize:
        return Escape{u32(items(codes)[simple]), 2}
    if items(s)[at + 1] != 'u' or at + 6 > s.len:
        return null
    code := parse_hex(s[at + 2:at + 6])
    if code is null:
        return null
    if code < 0xD800 or code >= 0xE000:
        return Escape{u32(code), 6}
    if code >= 0xDC00 or at + 12 > s.len or s[at + 6:at + 8] != "\\u":
        return null
    low := parse_hex(s[at + 8:at + 12])
    if low is null or low < 0xDC00 or low >= 0xE000:
        return null
    return Escape{u32(0x10000 + (code - 0xD800) * 0x400 + low - 0xDC00), 12}

priv func value(s: &strview, start: usize, nodes: *&list[Node], depth: usize) -> usize|null:
    b := items(s)
    at := skip(s, start)
    if at >= s.len or depth > 512:
        return null
    n := nodes.len
    append(nodes, Node{Nothing, at, at, 1})
    c := b[at]
    if c == '{' or c == '[':
        close: u8 = ']'
        nodes[n].kind = Array
        if c == '{':
            close = '}'
            nodes[n].kind = Object
        at = skip(s, at + 1)
        if at < s.len and b[at] == close:
            at += 1
        else:
            while true:
                if c == '{':
                    name := nodes.len
                    after := value(s, at, nodes, depth + 1)
                    if after is null or nodes[name].kind != Text:
                        return null
                    at = skip(s, after)
                    if at >= s.len or b[at] != ':':
                        return null
                    at += 1
                next := value(s, at, nodes, depth + 1)
                if next is null:
                    return null
                at = skip(s, next)
                if at < s.len and b[at] == ',':
                    at += 1
                elif at < s.len and b[at] == close:
                    at += 1
                    break
                else:
                    return null
    elif c == '"':
        nodes[n].kind = Text
        at += 1
        while at < s.len and b[at] != '"':
            if b[at] < ' ':
                return null
            if b[at] == '\\':
                e := escape(s, at)
                if e is null:
                    return null
                at += e.size
            else:
                at += 1
        if at >= s.len:
            return null
        at += 1
    elif c == '-' or c >= '0' and c <= '9':
        nodes[n].kind = Number
        if c == '-':
            at += 1
        end := digits(s, at)
        if end == at or end > at + 1 and b[at] == '0':
            return null
        at = end
        if at < s.len and b[at] == '.':
            end = digits(s, at + 1)
            if end == at + 1:
                return null
            at = end
        if at < s.len and (b[at] == 'e' or b[at] == 'E'):
            at += 1
            if at < s.len and (b[at] == '+' or b[at] == '-'):
                at += 1
            end = digits(s, at)
            if end == at:
                return null
            at = end
    elif starts_with(s[at:s.len], "true"):
        nodes[n].kind = Boolean
        at += 4
    elif starts_with(s[at:s.len], "false"):
        nodes[n].kind = Boolean
        at += 5
    elif starts_with(s[at:s.len], "null"):
        at += 4
    else:
        return null
    nodes[n].to = at
    nodes[n].size = nodes.len - n
    return at

priv func skip(s: &strview, start: usize) -> usize:
    return s.len - trim_start(s[start:s.len]).len

priv func digits(s: &strview, start: usize) -> usize:
    at := start
    while at < s.len and items(s)[at] >= '0' and items(s)[at] <= '9':
        at += 1
    return at
