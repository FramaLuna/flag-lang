module fs

priv extern "c":
    func fopen(path: cstr, mode: cstr) -> *bytes
    func fwrite(from: *bytes, size: usize, count: usize, file: *bytes) -> usize
    func fseek(file: *bytes, offset: i64, whence: i32) -> i32
    func fgetpos(file: *bytes, into: *i64) -> i32
    func fclose(file: *bytes) -> i32
    func access(path: cstr, mode: i32) -> i32
    func remove(path: cstr) -> i32
    func rmdir(path: cstr) -> i32
    func rename(from: cstr, to: cstr) -> i32
    func mkdir(path: cstr, mode: u32) -> i32
    func opendir(path: cstr) -> *bytes
    func readdir(dir: *bytes) -> *u8
    func closedir(dir: *bytes) -> i32
    func readlink(path: cstr, into: *u8, size: usize) -> i64

func read_text_file(path: &strview) -> &str|FsError:
    f := try open(path)
    out: &str
    got := read(f, out, 65536)
    while got is usize and got > 0:
        got = read(f, out, 65536)
    _ = close(f)
    if got is FsError:
        free(out)
        return got
    return out

func write_file(path: &strview, text: &strview) -> FsError?:
    return put_file(path, text, "wb")

func append_file(path: &strview, text: &strview) -> FsError?:
    return put_file(path, text, "ab")

priv func put_file(path: &strview, text: &strview, mode: cstr) -> FsError?:
    file := fopen(path, mode)
    if file as usize == 0:
        return FsError{"write", path, system_error()}
    done := fwrite(ptr(text.*), 1, text.len, file)
    if fclose(file) != 0 or done != text.len:
        return FsError{"write", path, system_error()}
    return null

priv func fopen(path: &strview, mode: cstr) -> *bytes:
    with scratch():
        return fopen(cstr(path), mode)

func exists(path: &strview) -> bool:
    with scratch():
        return access(cstr(path), 0) == 0

func is_dir(path: &strview) -> bool:
    with scratch():
        dir := opendir(cstr(path))
        if dir as usize != 0:
            closedir(dir)
            return true
    return false

func file_size(path: &strview) -> usize|FsError:
    if is_dir(path):
        return FsError{"read the size of", path, "it is a folder"}
    file := fopen(path, "rb")
    if file as usize == 0:
        return FsError{"open", path, system_error()}
    at: array[i64, 4]
    if fseek(file, 0, 2) != 0 or fgetpos(file, ptr(at) as *i64) != 0:
        failed := FsError{"read the size of", path, system_error()}
        fclose(file)
        return failed
    fclose(file)
    return usize(at[0])

func remove(path: &strview) -> FsError?:
    failed := false
    with scratch():
        if is_dir(path):
            failed = rmdir(cstr(path)) != 0
        else:
            failed = remove(cstr(path)) != 0
    if failed:
        return FsError{"remove", path, system_error()}
    return null

func rename(from: &strview, to: &strview) -> FsError?:
    failed := false
    with scratch():
        failed = rename(cstr(from), cstr(to)) != 0
    if failed:
        return FsError{"rename", from, system_error()}
    return null

func make_dir(path: &strview) -> FsError?:
    with scratch():
        for i in 1..path.len:
            if slash(items(path)[i]):
                mkdir(cstr(path[0:i]), 493)
    if is_dir(path):
        return null
    failed := false
    with scratch():
        failed = mkdir(cstr(path), 493) != 0
    if failed:
        return FsError{"make", path, system_error()}
    return null

func list_dir(path: &strview) -> &slice[&strview]|FsError:
    dir := opendir(cstr(path))
    if dir as usize == 0:
        return FsError{"list", path, system_error()}
    names: &list[&strview]
    entry := readdir(dir)
    while entry as usize != 0:
        part := view((entry as usize + name_in_entry()) as *u8)
        if part != "." and part != "..":
            append(names, temp(part))
        entry = readdir(dir)
    closedir(dir)
    sort(names)
    out := temp(names)
    free(names)
    return out

func walk(folder: &strview) -> &slice[&strview]|FsError:
    files: &list[&strview]
    defer free(files)
    folders: &list[&strview]
    defer free(folders)
    append(folders, folder)
    i: usize = 0
    while i < folders.len:
        names := list_dir(folders[i])
        if names is FsError and i == 0:
            return names
        if names is &slice[&strview]:
            for name in names:
                path := join(folders[i], name)
                if is_dir(path) and not is_link(path):
                    append(folders, path)
                else:
                    append(files, path)
        i += 1
    sort(files)
    return temp(files)

func join(first: &strview, second: &strview) -> &strview:
    if first.len == 0:
        return first + second
    head := first
    while head.len > 0 and slash(items(head)[head.len - 1]):
        head = head[0:head.len - 1]
    tail := second
    while tail.len > 0 and slash(items(tail)[0]):
        tail = tail[1:tail.len]
    return head + "/" + tail

func base_name(path: &strview) -> &strview:
    return path[name_start(path):path.len]

func extension(path: &strview) -> &strview:
    name := base_name(path)
    while starts_with(name, "."):
        name = name[1:name.len]
    dot := find_last(name, ".")
    if dot is usize:
        return name[dot:name.len]
    return ""

func dir_of(path: &strview) -> &strview:
    if name_start(path) == 0:
        return "./"
    return path[0:name_start(path)]

priv func name_in_entry() -> usize where @linux():
    return 19

priv func name_in_entry() -> usize where @macos():
    return 21

priv func name_in_entry() -> usize where @windows():
    return 8

priv func is_link(path: &strview) -> bool where not @windows():
    buf: array[u8, 1]
    with scratch():
        return readlink(cstr(path), ptr(buf) as *u8, 1) >= 0

priv func is_link(path: &strview) -> bool where @windows():
    return false

priv func slash(c: u8) -> bool where not @windows():
    return c == '/'

priv func slash(c: u8) -> bool where @windows():
    return c == '/' or c == '\\'

priv func name_start(path: &strview) -> usize:
    for k in reverse 0..path.len:
        if slash(items(path)[k]):
            return k + 1
    return 0
