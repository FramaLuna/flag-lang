module fs

priv extern "c":
    func fopen(path: cstr, mode: cstr) -> *bytes
    func fwrite(from: *bytes, size: usize, count: usize, file: *bytes) -> usize
    func fclose(file: *bytes) -> i32
    func stat(path: cstr, into: *bytes) -> i32
    func lstat(path: cstr, into: *bytes) -> i32
    func _stat64(path: cstr, into: *bytes) -> i32
    func GetFileAttributesA(path: cstr) -> u32
    func remove(path: cstr) -> i32
    func rmdir(path: cstr) -> i32
    func rename(from: cstr, to: cstr) -> i32
    func MoveFileExA(from: cstr, to: cstr, flags: u32) -> i32
    func GetLastError() -> u32
    func mkdir(path: cstr, mode: u32) -> i32
    func opendir(path: cstr) -> *bytes
    func readdir(dir: *bytes) -> *u8
    func closedir(dir: *bytes) -> i32

func read_file(path: &strview) -> &str|FsError:
    f := try open(path)
    out: &str
    known := status(path)
    if known is Status:
        reserve(out, usize(known.size) + 1)
    got: usize|FsError = 1
    while got is usize and got > 0:
        if out.len == out.cap:
            reserve(out, out.len + 65536)
        got = read(f, out, out.cap - out.len)
    close(f)
    if got is FsError:
        free(out)
        return got
    return out

func write_file(path: &strview, text: &strview) -> FsError?:
    return put_file(path, text, "wb")

func append_file(path: &strview, text: &strview) -> FsError?:
    return put_file(path, text, "ab")

priv func put_file(path: &strview, text: &strview, mode: cstr) -> FsError?:
    file := usize(0) as *bytes
    with scratch():
        file = fopen(cstr(path), mode)
    if file as usize == 0:
        return FsError{errno(), "write", path}
    done := fwrite(ptr(text.*), 1, text.len, file)
    if fclose(file) != 0 or done != text.len:
        return FsError{errno(), "write", path}
    return null

func exists(path: &strview) -> bool:
    return status(path) is Status

func is_dir(path: &strview) -> bool:
    found := status(path)
    return found is Status and found.folder

func file_size(path: &strview) -> usize|FsError:
    found := status(path)
    if found is null:
        return FsError{errno(), "read the size of", path}
    if found.folder:
        return FsError{21, "read the size of", path} # EISDIR on every system
    return usize(found.size)

func remove(path: &strview) -> FsError?:
    failed := false
    with scratch():
        failed = remove(cstr(path)) != 0 and (not is_dir(path) or rmdir(cstr(path)) != 0) # the remove of Windows takes no folder
    if failed:
        return FsError{errno(), "remove", path}
    return null

func rename(from: &strview, to: &strview) -> FsError? where not @windows():
    failed := false
    with scratch():
        failed = rename(cstr(from), cstr(to)) != 0
    if failed:
        return FsError{errno(), "rename", from}
    return null

func rename(from: &strview, to: &strview) -> FsError? where @windows():
    failed := false
    with scratch():
        failed = MoveFileExA(cstr(from), cstr(to), 3) == 0 # MOVEFILE_REPLACE_EXISTING and MOVEFILE_COPY_ALLOWED
    if failed:
        return FsError{0 - i32(GetLastError()), "rename", from}
    return null

func make_dir(path: &strview) -> FsError?:
    with scratch():
        for i in 1..path.len:
            if slash(path[i]):
                mkdir(cstr(path[:i]), 493)
    if is_dir(path):
        return null
    failed := false
    with scratch():
        failed = mkdir(cstr(path), 493) != 0
    if failed:
        return FsError{errno(), "make", path}
    return null

func list_dir(path: &strview) -> &slice[&strview]|FsError:
    dir := opendir(cstr(path))
    if dir as usize == 0:
        return FsError{errno(), "list", path}
    names: &list[&strview]
    defer free(names)
    entry := readdir(dir)
    while entry as usize != 0:
        part := view((entry as usize + name_in_entry()) as *u8)
        if part != "." and part != "..":
            append(names, temp(part))
        entry = readdir(dir)
    closedir(dir)
    sort(names)
    return temp(names)

func walk(folder: &strview) -> &slice[&strview]|FsError:
    files: &list[&strview]
    defer free(files)
    folders: &list[&strview]
    defer free(folders)
    append(folders, folder)
    i: usize = 0
    while i < folders.len:
        names := list_dir(folders[i])
        if names is FsError and i == 0:
            return names
        if names is &slice[&strview]:
            for name in names:
                path := join(folders[i], name)
                found := status(path, follow_links = false)
                if found is Status and found.folder:
                    append(folders, path)
                else:
                    append(files, path)
        i += 1
    sort(files)
    return temp(files)

func join(first: &strview, second: &strview) -> &strview:
    if first.len == 0:
        return first + second
    head := first
    while head.len > 0 and slash(head[-1]):
        head = head[:-1]
    tail := second
    while tail.len > 0 and slash(tail[0]):
        tail = tail[1:]
    return head + "/" + tail

func base_name(path: &strview) -> &strview:
    return path[name_start(path):]

func extension(path: &strview) -> &strview:
    name := base_name(path)
    while starts_with(name, "."):
        name = name[1:]
    dot := find_last(name, ".")
    if dot is usize:
        return name[dot:]
    return ""

func dir_of(path: &strview) -> &strview:
    if name_start(path) == 0:
        return "./"
    return path[:name_start(path)]

priv type Status:
    folder: bool
    size: u64

priv func status(path: &strview, follow_links: bool = true) -> Status?:
    room: array[u64, 20]
    with scratch():
        if not stat_into(path, ptr(room) as *bytes, follow_links):
            return null
    place := layout()
    mode := ((ptr(room) as usize + place[0]) as *u16).* and 0xf000
    return Status{mode == 0x4000, ((ptr(room) as usize + place[1]) as *u64).*} # S_IFDIR

priv func stat_into(path: &strview, into: *bytes, follow_links: bool) -> bool where not @windows():
    if follow_links:
        return stat(cstr(path), into) == 0
    return lstat(cstr(path), into) == 0

priv func stat_into(path: &strview, into: *bytes, follow_links: bool) -> bool where @windows():
    plain := path
    while plain.len > 1 and slash(plain[-1]) and plain[-2] != ':':
        plain = plain[:-1] # the C library doesn't find a folder with a / after it
    if _stat64(cstr(plain), into) != 0:
        return false
    if not follow_links and (GetFileAttributesA(cstr(plain)) and 0x400) != 0: # a link or a junction
        ((into as usize + 6) as *u16).* = 0xa000 # S_IFLNK, so it's not a folder
    return true

priv func layout() -> array[usize, 2] where @linux() and @x86_64():
    return [24, 48] # where struct stat has st_mode and st_size

priv func layout() -> array[usize, 2] where @linux() and not @x86_64():
    return [16, 48]

priv func layout() -> array[usize, 2] where @macos() and @arm64():
    return [4, 96]

priv func layout() -> array[usize, 2] where @macos() and @x86_64():
    return [8, 72] # the stat of 32-bit inodes, the one of the plain symbol

priv func layout() -> array[usize, 2] where @windows():
    return [6, 24] # struct _stat64

priv func name_in_entry() -> usize where @linux():
    return 19

priv func name_in_entry() -> usize where @macos() and @arm64():
    return 21

priv func name_in_entry() -> usize where @macos() and @x86_64():
    return 8 # the dirent of 32-bit inodes, the one of the plain readdir

priv func name_in_entry() -> usize where @windows():
    return 8

priv func slash(c: u8) -> bool where not @windows():
    return c == '/'

priv func slash(c: u8) -> bool where @windows():
    return c == '/' or c == '\\'

priv func name_start(path: &strview) -> usize:
    for k in reverse 0..path.len:
        if slash(path[k]):
            return k + 1
    return 0
