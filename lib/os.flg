module os

priv type Clock:
    seconds: i64
    nanos: i64

type Date:
    year: i32
    month: i32
    day: i32
    hour: i32
    minute: i32
    second: i32
    weekday: i32

type Process:
    id: i64
    input: File
    output: File

priv extern "c":
    func getenv(name: cstr) -> cstr
    func clock_gettime(id: i32, into: *Clock) -> i32
    func nanosleep(want: *Clock, left: *Clock) -> i32
    func read(fd: i32, at: *bytes, size: i64) -> i32
    func write(fd: i32, at: *bytes, size: i64) -> i32
    func close(fd: i32) -> i32
    func pipe(fds: *i32) -> i32
    func pipe2(fds: *i32, flags: i32) -> i32
    func socketpair(family: i32, kind: i32, protocol: i32, fds: *i32) -> i32
    func setsockopt(fd: i32, level: i32, name: i32, value: *bytes, size: u32) -> i32
    func fcntl(fd: i32, command: i32, ...) -> i32
    func _pipe(fds: *i32, size: u32, mode: i32) -> i32
    func dup2(from: i32, to: i32) -> i32
    func fork() -> i32
    func execvp(file: cstr, args: *cstr) -> i32
    func waitpid(pid: i32, status: *i32, options: i32) -> i32
    func waitid(kind: i32, id: u32, info: *bytes, options: i32) -> i32
    func kill(pid: i32, signal: i32) -> i32
    func _exit(code: i32)
    func readlink(path: cstr, into: *u8, size: i64) -> i64
    func _NSGetExecutablePath(into: *u8, size: *u32) -> i32
    func realpath(path: cstr, into: *u8) -> cstr
    func getcwd(into: *u8, size: i64) -> cstr
    func chdir(path: cstr) -> i32
    func time(into: *i64) -> i64
    func localtime_r(when: *i64, into: *bytes) -> *bytes
    func getrandom(into: *bytes, size: i64, flags: u32) -> i64
    func getentropy(into: *bytes, size: i64) -> i32
    func dlopen(path: cstr, flags: i32) -> *bytes
    func flag_shapes() -> *u64
    func dlerror() -> cstr
    func _wgetenv(name: wstr) -> wstr
    func _wgetcwd(into: wstr, size: i32) -> wstr
    func _wchdir(path: wstr) -> i32
    func _get_osfhandle(fd: i32) -> u64
    func _time64(into: *i64) -> i64
    func _localtime64_s(into: *bytes, when: *i64) -> i32
    func GetModuleFileNameW(module: *bytes, into: wstr, size: u32) -> u32
    func GetCommandLineW() -> wstr
    func LocalFree(memory: *bytes) -> *bytes
    func GetStdHandle(which: u32) -> u64
    func GetCurrentProcess() -> u64
    func DuplicateHandle(from: u64, handle: u64, to: u64, copy: *u64, access: u32, inherit: i32, options: u32) -> i32
    func CloseHandle(handle: u64) -> i32
    func CreateFileW(path: wstr, access: u32, share: u32, security: *bytes, how: u32, flags: u32, template: u64) -> u64
    func InitializeProcThreadAttributeList(list: *bytes, count: u32, flags: u32, size: *i64) -> i32
    func UpdateProcThreadAttribute(list: *bytes, flags: u32, attribute: u64, value: *bytes, size: i64, previous: *bytes, returned: *i64) -> i32
    func DeleteProcThreadAttributeList(list: *bytes)
    func CreateProcessW(name: wstr, line: wstr, process: *bytes, thread: *bytes, inherit: i32, flags: u32, environment: *bytes, folder: wstr, startup: *StartupInfo, info: *ProcessInfo) -> i32
    func GetConsoleProcessList(into: *u32, count: u32) -> u32
    func WaitForSingleObject(handle: u64, milliseconds: u32) -> u32
    func GetExitCodeProcess(process: u64, code: *u32) -> i32
    func TerminateProcess(process: u64, code: u32) -> i32
    func GetLastError() -> u32
    func LoadLibraryW(path: wstr) -> *bytes
    func FormatMessageW(flags: u32, source: *bytes, code: u32, language: u32, into: wstr, size: u32, arguments: *bytes) -> u32
    func GetSystemTimePreciseAsFileTime(into: *u64)
    func sysconf(name: i32) -> i64
    func GetActiveProcessorCount(group: u16) -> u32
    func QueryPerformanceCounter(into: *i64) -> i32
    func QueryPerformanceFrequency(into: *i64) -> i32
