priv extern "c" where not @windows():
    func dlsym(handle: *bytes, name: cstr) -> *bytes
    func dlclose(handle: *bytes) -> i32

priv extern "c" where @windows():
    func dlsym(handle: *bytes, name: cstr) -> *bytes = "GetProcAddress"
    func dlclose(handle: *bytes) -> i32 = "FreeLibrary"

priv extern "c" where @macos():
    func posix_spawn_file_actions_init(actions: **bytes) -> i32
    func posix_spawn_file_actions_adddup2(actions: **bytes, from: i32, to: i32) -> i32
    func posix_spawn_file_actions_addinherit_np(actions: **bytes, fd: i32) -> i32
    func posix_spawn_file_actions_addchdir_np(actions: **bytes, path: cstr) -> i32
    func posix_spawn_file_actions_destroy(actions: **bytes) -> i32
    func posix_spawnattr_init(attributes: **bytes) -> i32
    func posix_spawnattr_setflags(attributes: **bytes, flags: i16) -> i32
    func posix_spawnattr_destroy(attributes: **bytes) -> i32
    func posix_spawnp(pid: *i32, file: cstr, actions: **bytes, attributes: **bytes, args: *cstr, environment: *cstr) -> i32
    func _NSGetEnviron() -> **cstr

priv extern "shell32" where @windows():
    func CommandLineToArgvW(line: wstr, count: *i32) -> *wstr

priv extern "bcrypt" where @windows():
    func BCryptGenRandom(algorithm: *bytes, into: *bytes, size: u32, flags: u32) -> i32

priv extern "ntdll" where @windows():
    func RtlNtStatusToDosError(status: i32) -> u32

priv type StartupInfo: # STARTUPINFOEXW
    size: u32
    texts: array[u64, 3]
    window: array[u32, 7]
    flags: u32
    show: array[u16, 4]
    reserved: u64
    handles: array[u64, 3]
    attributes: *bytes

priv type ProcessInfo: # PROCESS_INFORMATION
    process: u64
    thread: u64
    ids: array[u32, 2]

priv type Startup:
    args: &list[&strview] = heap([])
    values: &list[&strview] = heap([]) # what env gave on Windows, kept so it lives like the environment does

priv shared context startup:
    given: Lock[Startup]

func env(name: &strview) -> &strview|null where not @windows():
    with scratch():
        found := getenv(cstr(name))
        if found as u64 != 0:
            return view(found)
    return null

func env(name: &strview) -> &strview|null where @windows():
    with lock(startup.given):
        with scratch():
            found := _wgetenv(wstr(name))
            if found as u64 == 0:
                return null
            value := tmp(found)
            for kept in startup.given.value.values:
                if kept == value:
                    return kept
            copy: &str = heap(value)
            append(startup.given.value.values, view(copy))
            return copy

func args() -> &listview[&strview] where not @windows():
    with lock(startup.given):
        if startup.given.value.args.len == 0:
            for i in 0..@argc():
                append(startup.given.value.args, view(((@argv() as *bytes + i * 8) as *cstr).*))
        return startup.given.value.args

func args() -> &listview[&strview] where @windows():
    with lock(startup.given):
        if startup.given.value.args.len == 0 and @argc() > 0: # a library has none, its main of C gives it no argc
            count: i32 = 0
            given := CommandLineToArgvW(GetCommandLineW(), ptr(count))
            for i in 0..count:
                kept: &str = heap("") # lives all the program
                with scratch():
                    kept = tmp(((given as *bytes + i * 8) as *wstr).*)
                append(startup.given.value.args, view(kept))
            LocalFree(given as *bytes)
        return startup.given.value.args

func run(command: &strview, folder: &strview = "") -> i32|FsError:
    return finish(try spawn(command, array[i32, 3]{-1, -1, -1}, folder))

func run(program: &listview[&strview], folder: &strview = "") -> i32|FsError:
    if program.len == 0:
        return FsError{22, "run", "[]"} # EINVAL on every system
    return finish(try spawn(program, array[i32, 3]{-1, -1, -1}, folder))

func output(command: &strview, into: *&str, folder: &strview = "") -> i32|FsError:
    return captured(command, into, folder)

func output(program: &listview[&strview], into: *&str, folder: &strview = "") -> i32|FsError:
    if program.len == 0:
        return FsError{22, "run", "[]"} # EINVAL on every system
    return captured(program, into, folder)

# the standard output and the error output go to one pipe, in the order the program writes them
priv func captured(launched: &listview[&strview]|&strview, into: *&str, folder: &strview) -> i32|FsError:
    fds: array[i32, 2]
    if not make_pipe(ptr(fds)):
        return FsError{errno(), "run", named(launched, folder)}
    id := spawn(launched, [-1, fds[1], fds[1]], folder)
    close(fds[1])
    if id is FsError:
        close(fds[0])
        return id
    got: i32 = 1
    while got > 0:
        reserve(into, into.len + 65536)
        got = read(fds[0], ptr(into.*.*) + into.len, 65536)
        if got > 0:
            into.len += got
    close(fds[0])
    return finish(id)

func start(program: &listview[&strview], folder: &strview = "") -> Process|FsError:
    if program.len == 0:
        return FsError{22, "run", "[]"} # EINVAL on every system
    input: array[i32, 2] # the end the program reads, and yours
    output: array[i32, 2] # yours, and the end the program writes
    if not make_input(ptr(input)):
        return FsError{errno(), "run", named(program, folder)}
    if not make_pipe(ptr(output)):
        failed := FsError{errno(), "run", named(program, folder)}
        close(input[0])
        close(input[1])
        return failed
    id := spawn(program, [input[0], output[1], -1], folder)
    close(input[0])
    close(output[1])
    if id is FsError:
        close(input[1])
        close(output[0])
        return id
    return Process{id, File{input[1]}, File{output[0]}}

func done(p: Process, place: &strview = @here()) -> bool:
    if p.id == 0:
        gone("done", place = place)
    flush()
    return ended(p.id)

func wait(p: *Process, place: &strview = @here()) -> i32:
    if p.id == 0:
        gone("wait", place = place)
    flush()
    code := finish(p.id, place = place)
    p.id = 0
    return code

func kill(p: Process, place: &strview = @here()):
    if p.id == 0:
        gone("kill", place = place)
    end(p.id)

priv func gone(what: &strview, place: &strview) -> never:
    panic("'" + what + "' called on a Process that is not running (never started or already waited)", place = place)

# what the errors of run name: the program, and the folder it runs in
priv func named(launched: &listview[&strview]|&strview, folder: &strview) -> &strview:
    program := launched if launched is &strview else launched[0]
    if folder.len == 0:
        return program
    return program + " in " + folder

func random_bytes(into: &listview[u8]) where @linux():
    at := 0
    while at < into.len:
        got := getrandom(ptr(into.*) + at, into.len - at, 0)
        if got < 0 and errno() != 4: # EINTR
            no_random(errno())
        if got > 0:
            at += got

func random_bytes(into: &listview[u8]) where @macos():
    for at in 0..(into.len + 255) / 256:
        part := into[at * 256:]
        if part.len > 256:
            part = part[:256] # the most getentropy gives at once
        if getentropy(ptr(part.*), part.len) != 0:
            no_random(errno())

func random_bytes(into: &listview[u8]) where @windows():
    most := 0x8000_0000 # BCryptGenRandom counts in 32 bits
    for at in 0..(into.len + most - 1) / most:
        part := into[at * most:]
        if part.len > most:
            part = part[:most]
        failed := BCryptGenRandom(0 as *bytes, ptr(part.*), u32(part.len), 2) # BCRYPT_USE_SYSTEM_PREFERRED_RNG
        if failed != 0:
            no_random(windows_errno(RtlNtStatusToDosError(failed))) # an NTSTATUS, not an error of GetLastError

# a key that comes out weak is worse than a program that stops
priv func no_random(code: i32):
    panic("" + FsError{code, "read random bytes", ""})

# close on exec from the start, so a program that another thread starts doesn't take it
priv func make_pipe(fds: *array[i32, 2]) -> bool where @linux():
    return pipe2(fds as *i32, 0x80000) == 0 # O_CLOEXEC

priv func make_pipe(fds: *array[i32, 2]) -> bool where @macos():
    if pipe(fds as *i32) != 0:
        return false
    fcntl(fds.*[0], 2, 1) # FD_CLOEXEC
    fcntl(fds.*[1], 2, 1)
    return true

priv func make_pipe(fds: *array[i32, 2]) -> bool where @windows():
    return _pipe(fds as *i32, 65536, 0x8080) == 0 # _O_BINARY and _O_NOINHERIT

# a socket pair and not a pipe, so writing to a program that ended is an error and not a SIGPIPE that ends yours
priv func make_input(fds: *array[i32, 2]) -> bool where @linux():
    return socketpair(1, 0x80001, 0, fds as *i32) == 0 # AF_UNIX, and SOCK_STREAM with SOCK_CLOEXEC, Linux sends with MSG_NOSIGNAL

priv func make_input(fds: *array[i32, 2]) -> bool where @macos():
    if socketpair(1, 1, 0, fds as *i32) != 0: # AF_UNIX and SOCK_STREAM
        return false
    fcntl(fds.*[0], 2, 1)
    fcntl(fds.*[1], 2, 1)
    yes: i32 = 1
    setsockopt(fds.*[1], 65535, 0x1022, ptr(yes) as *bytes, 4) # SO_NOSIGPIPE
    return true

priv func make_input(fds: *array[i32, 2]) -> bool where @windows():
    return make_pipe(fds)

# given holds the standard input, output and error of the program, and -1 leaves it the one of yours
priv func spawn(launched: &listview[&strview]|&strview, given: array[i32, 3], folder: &strview) -> i64|FsError where @linux():
    failure: array[i32, 2]
    if not make_pipe(ptr(failure)):
        return FsError{errno(), "run", named(launched, folder)}
    flush()
    args := arguments(launched)
    pid: i32 = 0
    code: i32 = 0
    with scratch():
        path := cstr(folder)
        pid = fork()
        if pid == 0:
            for k in 0..3:
                standard(given[k], i32(k))
            if folder.len == 0 or chdir(path) == 0:
                execvp(args.*, args)
            failed := errno()
            write(failure[1], ptr(failed) as *bytes, 4)
            _exit(127)
        code = errno()
    free(args)
    close(failure[1])
    told := read(failure[0], ptr(code) as *bytes, 4)
    close(failure[0])
    if told == 4:
        finish(i64(pid))
    if pid < 0 or told == 4:
        return FsError{code, "run", named(launched, folder)}
    return i64(pid)

# in the child, fd becomes the standard file, also when it already has that number and only has to stay open
priv func standard(fd: i32, number: i32) where @linux():
    if fd == number:
        fcntl(fd, 2, 0) # F_SETFD without FD_CLOEXEC
    elif fd >= 0:
        dup2(fd, number)

# POSIX_SPAWN_CLOEXEC_DEFAULT closes in the program every file of this one but its three
priv func spawn(launched: &listview[&strview]|&strview, given: array[i32, 3], folder: &strview) -> i64|FsError where @macos():
    actions := 0 as *bytes
    attributes := 0 as *bytes
    posix_spawn_file_actions_init(ptr(actions))
    posix_spawnattr_init(ptr(attributes))
    posix_spawnattr_setflags(ptr(attributes), 0x4000)
    for k in 0..3:
        if given[k] >= 0 and given[k] != i32(k):
            posix_spawn_file_actions_adddup2(ptr(actions), given[k], i32(k))
        elif given[k] == i32(k) or fcntl(i32(k), 1) == 0: # F_GETFD: a closed one stays closed, and one of the library at its number is close-on-exec
            posix_spawn_file_actions_addinherit_np(ptr(actions), i32(k))
    if folder.len > 0:
        with scratch():
            posix_spawn_file_actions_addchdir_np(ptr(actions), cstr(folder))
    flush()
    args := arguments(launched)
    pid: i32 = 0
    code := posix_spawnp(ptr(pid), args.*, ptr(actions), ptr(attributes), args, _NSGetEnviron().*)
    free(args)
    posix_spawn_file_actions_destroy(ptr(actions))
    posix_spawnattr_destroy(ptr(attributes))
    if code != 0:
        return FsError{code, "run", named(launched, folder)}
    return i64(pid)

# the arguments as C takes them, in one block: a command goes to sh
priv func arguments(launched: &listview[&strview]|&strview) -> *cstr where not @windows():
    command := ["/bin/sh", "-c", ""]
    program: &listview[&strview]
    if launched is &strview:
        command[2] = launched
        program = ptr(command)
    else:
        program = launched
    table := (program.len + 1) * 8
    size := table
    for part in program:
        size += part.len + 1
    args := malloc(size)
    at := table
    for i in 0..=program.len:
        slot := (args + i * 8) as *cstr
        slot.* = 0 as cstr
        if i < program.len:
            text := args + at
            memcpy(text, ptr(program[i].*), program[i].len)
            ((text + program[i].len) as *u8).* = 0
            slot.* = text as cstr
            at += program[i].len + 1
    return args as *cstr

# the program inherits only its three handles, and gets no window of its own when this one has no console
priv func spawn(launched: &listview[&strview]|&strview, given: array[i32, 3], folder: &strview) -> i64|FsError where @windows():
    line: &str = heap("")
    defer free(line)
    made: i32 = 0
    code: u32 = 0
    info: ProcessInfo
    program: &listview[&strview]
    if launched is &strview:
        line += "cmd.exe /d /s /c \"" + launched + "\"" # what _wsystem runs, with every handle of this program but its three kept to itself
    else:
        program = launched
    with scratch():
        if program.len > 0:
            name := program[0]
            while name.len > 0 and (name[-1] == '.' or name[-1] == ' '): # Windows drops them, x.bat. is x.bat
                name = name[:name.len - 1]
            dot := name.len
            for i in reverse 0..name.len:
                c := name[i]
                if c == '.':
                    dot = i
                if c == '.' or c == '/' or c == '\\':
                    break
            extension := lower(name[dot:])
            if extension == ".bat" or extension == ".cmd":
                return FsError{22, "run", program[0]} # cmd.exe would read the arguments again, a batch file goes with run(command)
            for i, word in program:
                part := word
                if i == 0 and extension.len == 0:
                    part = name + ".exe" # CreateProcessW adds it only to a name without a folder
                if line.len > 0:
                    line += " "
                if part.len > 0 and not contains(part, " ") and not contains(part, "\t") and not contains(part, "\""):
                    line += part
                else:
                    line += "\""
                    slashes := 0
                    for c in items(part):
                        if c == '"':
                            for k in 0..=slashes:
                                add_byte(line, '\\')
                        add_byte(line, c)
                        if c == '\\':
                            slashes += 1
                        else:
                            slashes = 0
                    for k in 0..slashes:
                        add_byte(line, '\\')
                    line += "\""
        flush()
        launch := StartupInfo{size = 112, flags = 0x100} # STARTF_USESTDHANDLES
        nowhere: u64 = 0 # the NUL device, for a standard handle that this program doesn't have
        for k in 0..3:
            source := GetStdHandle(u32(0xffff_fff6) - u32(k)) # STD_INPUT_HANDLE, STD_OUTPUT_HANDLE and STD_ERROR_HANDLE
            if given[k] >= 0:
                source = _get_osfhandle(given[k])
            if source == 0 or source == 0xffff_ffff_ffff_ffff: # none, or INVALID_HANDLE_VALUE
                if nowhere == 0:
                    nowhere = CreateFileW(wstr("NUL"), 0xc000_0000, 3, 0 as *bytes, 3, 0, 0) # GENERIC_READ and GENERIC_WRITE, shared, OPEN_EXISTING
                source = nowhere
            DuplicateHandle(GetCurrentProcess(), source, GetCurrentProcess(), ptr(launch.handles[k]), 0, 1, 2) # inheritable, DUPLICATE_SAME_ACCESS
        size := 0
        InitializeProcThreadAttributeList(0 as *bytes, 1, 0, ptr(size))
        launch.attributes = tmp(size)
        InitializeProcThreadAttributeList(launch.attributes, 1, 0, ptr(size))
        UpdateProcThreadAttribute(launch.attributes, 0, 0x20002, ptr(launch.handles) as *bytes, 24, 0 as *bytes, 0 as *i64) # PROC_THREAD_ATTRIBUTE_HANDLE_LIST
        flags: u32 = 0x80000 # EXTENDED_STARTUPINFO_PRESENT
        consoles: u32 = 0
        if GetConsoleProcessList(ptr(consoles), 1) == 0:
            flags = flags or 0x800_0000 # CREATE_NO_WINDOW
        made = CreateProcessW(0 as wstr, wstr(line), 0 as *bytes, 0 as *bytes, 1, flags, 0 as *bytes, wstr(folder) if folder.len > 0 else 0 as wstr, ptr(launch), ptr(info))
        code = GetLastError()
        DeleteProcThreadAttributeList(launch.attributes)
        for h in launch.handles:
            CloseHandle(h)
        if nowhere != 0:
            CloseHandle(nowhere)
    if made == 0:
        return FsError{windows_errno(code), "run", named(launched, folder)}
    CloseHandle(info.thread)
    return i64(info.process)

priv func finish(pid: i64, place: &strview = @here()) -> i32 where not @windows():
    status: i32 = 0
    while waitpid(i32(pid), ptr(status), 0) < 0:
        if errno() != 4: # EINTR
            gone("wait", place = place)
    return exit_code(status)

priv func finish(process: i64, place: &strview = @here()) -> i32 where @windows():
    code: u32 = 0
    if WaitForSingleObject(u64(process), 0xffff_ffff) != 0:
        gone("wait", place = place)
    GetExitCodeProcess(u64(process), ptr(code))
    CloseHandle(u64(process))
    return i32(code)

# without taking it, so the pid is not reused until wait
priv func ended(pid: i64) -> bool where not @windows():
    info: array[u32, 32]
    waitid(1, u32(pid), ptr(info) as *bytes, 0x100_0005 if @linux() else 0x25) # P_PID, and WEXITED, WNOHANG and WNOWAIT
    return info[0] != 0 and info[2] >= 1 and info[2] <= 3 # si_code CLD_EXITED, CLD_KILLED or CLD_DUMPED, macOS gives a stopped one too

priv func ended(process: i64) -> bool where @windows():
    return WaitForSingleObject(u64(process), 0) == 0

priv func end(pid: i64) where not @windows():
    kill(i32(pid), 9) # SIGKILL

priv func end(process: i64) where @windows():
    TerminateProcess(u64(process), 137) # what a SIGKILL gives on the other systems

priv func exit_code(status: i32) -> i32 where not @windows():
    if (status and 127) != 0:
        return 128 + (status and 127)
    return (status >> 8) and 255

priv func exit_code(status: i32) -> i32 where @windows():
    return status

func executable() -> &strview where @linux():
    buf: array[u8, 4096]
    size := readlink("/proc/self/exe", ptr(buf) as *u8, 4096)
    if size < 0 or size == 4096:
        return ""
    found: &strview
    found = ptr(buf) as *bytes
    found.len = size
    return tmp(found)

func executable() -> &strview where @macos():
    buf: array[u8, 4096]
    size: u32 = 4096
    if _NSGetExecutablePath(ptr(buf) as *u8, ptr(size)) != 0:
        return ""
    full := realpath(ptr(buf) as cstr, 0 as *u8)
    defer free(full as *bytes)
    if full as u64 == 0:
        return ""
    return tmp(view(full))

func executable() -> &strview where @windows():
    buf: array[u16, 4096]
    size := GetModuleFileNameW(0 as *bytes, ptr(buf) as wstr, 4096)
    if size == 0 or size == 4096:
        return ""
    return replace(tmp(ptr(buf) as wstr), "\\", "/")

func system_name() -> &strview:
    return "Windows" if @windows() else "Darwin" if @macos() else "Linux"

func current_dir() -> &strview where not @windows():
    buf: array[u8, 4096]
    if getcwd(ptr(buf) as *u8, 4096) as u64 == 0:
        return ""
    return tmp(view(ptr(buf) as cstr))

func current_dir() -> &strview where @windows():
    buf: array[u16, 4096]
    if _wgetcwd(ptr(buf) as wstr, 4096) as u64 == 0:
        return ""
    return replace(tmp(ptr(buf) as wstr), "\\", "/")

func change_dir(path: &strview) -> FsError?:
    failed := false
    with scratch():
        failed = enter(path) != 0
    if failed:
        return FsError{errno(), "enter", path}
    return null

priv func enter(path: &strview) -> i32 where not @windows():
    return chdir(cstr(path))

priv func enter(path: &strview) -> i32 where @windows():
    return _wchdir(wstr(path))

priv func seconds(c: Clock) -> f64:
    return f64(c.seconds) + f64(c.nanos) / 1000000000.0

func now() -> f64 where not @windows():
    c: Clock
    clock_gettime(0, ptr(c))
    return seconds(c)

func now() -> f64 where @windows():
    ticks: u64 = 0
    GetSystemTimePreciseAsFileTime(ptr(ticks))
    return f64(ticks - 116444736000000000) / 10000000.0

func clock() -> f64 where @linux():
    c: Clock
    clock_gettime(1, ptr(c))
    return seconds(c)

func clock() -> f64 where @macos():
    c: Clock
    clock_gettime(6, ptr(c))
    return seconds(c)

func clock() -> f64 where @windows():
    ticks := 0
    rate := 1
    QueryPerformanceCounter(ptr(ticks))
    QueryPerformanceFrequency(ptr(rate))
    return f64(ticks) / f64(rate)

func date() -> Date where not @windows():
    moment := time(0 as *i64)
    fields: array[i32, 16]
    localtime_r(ptr(moment), ptr(fields) as *bytes)
    return Date{fields[5] + 1900, fields[4] + 1, fields[3], fields[2], fields[1], fields[0], fields[6]}

func date() -> Date where @windows():
    moment := _time64(0 as *i64)
    fields: array[i32, 16]
    _localtime64_s(ptr(fields) as *bytes, ptr(moment))
    return Date{fields[5] + 1900, fields[4] + 1, fields[3], fields[2], fields[1], fields[0], fields[6]}

func cores() -> i64:
    return GetActiveProcessorCount(0xffff) if @windows() else sysconf(84 if @linux() else 58) # ALL_PROCESSOR_GROUPS, and _SC_NPROCESSORS_ONLN

func sleep(seconds: f64) where not @windows():
    flush() # what you wrote goes out before the program waits
    whole := seconds
    if whole > 1000000000.0:
        whole = 1000000000.0 # 31 years, the most the nanoseconds can count
    left := Clock{i64(whole), 0}
    left.nanos = i64((whole - f64(left.seconds)) * 1000000000.0)
    while left.seconds >= 0 and left.nanos >= 0 and left.nanos < 1000000000 and nanosleep(ptr(left), ptr(left)) != 0:
        pass

func sleep(seconds: f64) where @windows():
    flush()
    left := seconds
    while left > 0.0:
        part := left
        if part > 1000000.0:
            part = 1000000.0 # Sleep counts milliseconds in 32 bits
        Sleep(u32(part * 1000.0 + 0.999)) # whole milliseconds, rounded up so a short sleep still waits
        left -= part

extern "dl" where @linux():

type Library:
    handle: *bytes

type error LoadError:
    path: &strview
    reason: &strview

operator +=(s: *&str, e: LoadError):
    with scratch():
        s.* += "cannot load " + e.path + ": " + e.reason

# a type that a program or a library made, in the table that each one carries sorted by tag, which flagc writes
priv type Shape:
    tag: u32
    variants: u32 # an alias or an enum, that holds the tag of its union
    hash: u64
    name: cstr

# the library, unless a type that it and the program both made has other fields or variants in each
priv func checked(handle: *bytes, path: &strview) -> Library|LoadError:
    found := dlsym(handle, "flag_shapes")
    if found as u64 == 0:
        return Library{handle} # a library of C
    head := (found as extern func() -> *u64)()
    theirs: &listview[Shape]
    theirs = head as *bytes + 8
    theirs.len = i64(head.*)
    head = flag_shapes()
    ours: &listview[Shape]
    ours = head as *bytes + 8
    ours.len = i64(head.*)
    i := 0
    for t in theirs:
        while i < ours.len and ours[i].tag < t.tag:
            i += 1
        if i < ours.len and ours[i].tag == t.tag and ours[i].hash != t.hash:
            name := view(ours[i].name) # the one of the program, the one of the library goes with it
            dlclose(handle)
            if ours[i].variants != 0:
                return LoadError{path, "its " + name + " has other variants than the " + name + " of this program"}
            return LoadError{path, "its " + name + " has other fields than the " + name + " of this program"}
    return Library{handle}

func load_library(path: &strview) -> Library|LoadError where not @windows():
    handle := 0 as *bytes
    with scratch():
        handle = dlopen(cstr(path), 2 if @linux() else 6) # RTLD_NOW and RTLD_LOCAL, that is 0 on Linux
    if handle as u64 != 0:
        return checked(handle, path)
    reason := view(dlerror())
    if starts_with(reason, path) and starts_with(reason[path.len:], ": "):
        reason = reason[path.len + 2:] # glibc says the path first
    return LoadError{path, tmp(reason)}

func load_library(path: &strview) -> Library|LoadError where @windows():
    handle := 0 as *bytes
    code: u32 = 0
    with scratch():
        handle = LoadLibraryW(wstr(path))
        code = GetLastError()
    if handle as u64 != 0:
        return checked(handle, path)
    text: array[u16, 512]
    FormatMessageW(0x1200, 0 as *bytes, code, 0, ptr(text) as wstr, 512, 0 as *bytes)
    return LoadError{path, trim_end(tmp(ptr(text) as wstr))}

func symbol(library: Library, name: &strview) -> *bytes?:
    found := 0 as *bytes
    with scratch():
        found = dlsym(library.handle, cstr(name))
    if found as u64 == 0:
        return null
    return found

func close(library: Library):
    done := symbol(library, "flag_exit") # what a library of Flag printed goes out now, macOS keeps a library with thread data loaded
    if done is *bytes:
        (done as extern func())()
    dlclose(library.handle)

operator with(library: Library):
    close(library)
