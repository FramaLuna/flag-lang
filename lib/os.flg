priv extern "c" where not @windows():
    func dlsym(handle: *bytes, name: cstr) -> *bytes
    func dlclose(handle: *bytes) -> i32

priv extern "c" where @windows():
    func dlsym(handle: *bytes, name: cstr) -> *bytes = "GetProcAddress"
    func dlclose(handle: *bytes) -> i32 = "FreeLibrary"

priv extern "c" where @macos():
    func posix_spawn_file_actions_init(actions: **bytes) -> i32
    func posix_spawn_file_actions_adddup2(actions: **bytes, from: i32, to: i32) -> i32
    func posix_spawn_file_actions_addinherit_np(actions: **bytes, fd: i32) -> i32
    func posix_spawn_file_actions_destroy(actions: **bytes) -> i32
    func posix_spawnattr_init(attributes: **bytes) -> i32
    func posix_spawnattr_setflags(attributes: **bytes, flags: i16) -> i32
    func posix_spawnattr_destroy(attributes: **bytes) -> i32
    func posix_spawnp(pid: *i32, file: *u8, actions: **bytes, attributes: **bytes, args: **u8, environment: **u8) -> i32
    func _NSGetEnviron() -> ***u8

priv extern "shell32" where @windows():
    func CommandLineToArgvW(line: wstr, count: *i32) -> *wstr

priv extern "bcrypt" where @windows():
    func BCryptGenRandom(algorithm: *bytes, into: *bytes, size: u32, flags: u32) -> i32

priv type StartupInfo: # STARTUPINFOEXW
    size: u32
    texts: array[usize, 3]
    window: array[u32, 7]
    flags: u32
    show: array[u16, 4]
    reserved: usize
    handles: array[usize, 3]
    attributes: *bytes

priv type ProcessInfo: # PROCESS_INFORMATION
    process: usize
    thread: usize
    ids: array[u32, 2]

priv type Startup:
    lock: Lock
    args: &list[&strview]
    values: &list[&strview] # what env gave on Windows, kept so it lives like the environment does

priv startup: Startup

func env(name: &strview) -> &strview|null where not @windows():
    with scratch():
        found := getenv(cstr(name))
        if found as usize != 0:
            return view(found)
    return null

func env(name: &strview) -> &strview|null where @windows():
    with lock(startup.lock):
        with scratch():
            found := _wgetenv(wstr(name))
            if found as usize == 0:
                return null
            value := temp(found)
            for kept in startup.values:
                if kept == value:
                    return kept
            copy: &str = value
            append(startup.values, view(copy))
            return copy

func args() -> &slice[&strview] where not @windows():
    with lock(startup.lock):
        if startup.args.len == 0:
            for i in 0..usize(@argc()):
                append(startup.args, view(((@argv() as usize + i * 8) as **u8).*))
        return startup.args

func args() -> &slice[&strview] where @windows():
    with lock(startup.lock):
        if startup.args.len == 0:
            count: i32 = 0
            given := CommandLineToArgvW(GetCommandLineW(), ptr(count))
            for i in 0..usize(count):
                kept: &str # lives all the program
                with scratch():
                    kept = temp(((given as usize + i * 8) as *wstr).*)
                append(startup.args, view(kept))
            LocalFree(given as *bytes)
        return startup.args

func run(command: &strview) -> i32|FsError:
    return finish(try spawn(command, -1, -1))

func run(program: &slice[&strview]) -> i32|FsError:
    if program.len == 0:
        return FsError{22, "run", "[]"} # EINVAL on every system
    return finish(try spawn(program, -1, -1))

func output(command: &strview, into: *&str) -> i32|FsError:
    return captured(command, into)

func output(program: &slice[&strview], into: *&str) -> i32|FsError:
    if program.len == 0:
        return FsError{22, "run", "[]"} # EINVAL on every system
    return captured(program, into)

priv func captured(launched: &slice[&strview]|&strview, into: *&str) -> i32|FsError:
    fds: array[i32, 2]
    if not make_pipe(ptr(fds)):
        return FsError{errno(), "run", named(launched)}
    id := spawn(launched, -1, fds[1])
    close(fds[1])
    if id is FsError:
        close(fds[0])
        return id
    got: i32 = 1
    while got > 0:
        reserve(into, into.len + 65536)
        got = read(fds[0], (ptr(into.*.*) as usize + into.len) as *bytes, 65536)
        if got > 0:
            into.len += usize(got)
    close(fds[0])
    return finish(id)

func start(program: &slice[&strview]) -> Process|FsError:
    if program.len == 0:
        return FsError{22, "run", "[]"} # EINVAL on every system
    input: array[i32, 2] # the end the program reads, and yours
    output: array[i32, 2] # yours, and the end the program writes
    if not make_input(ptr(input)):
        return FsError{errno(), "run", program[0]}
    if not make_pipe(ptr(output)):
        failed := FsError{errno(), "run", program[0]}
        close(input[0])
        close(input[1])
        return failed
    id := spawn(program, input[0], output[1])
    close(input[0])
    close(output[1])
    if id is FsError:
        close(input[1])
        close(output[0])
        return id
    return Process{id, File{input[1]}, File{output[0]}}

func done(p: Process, place: &strview = @here()) -> bool:
    if p.id == 0:
        gone("done", place)
    flush()
    return ended(p.id)

func join(p: *Process, place: &strview = @here()) -> i32:
    if p.id == 0:
        gone("wait", place)
    flush()
    code := finish(p.id, place)
    p.id = 0
    return code

func kill(p: Process, place: &strview = @here()):
    if p.id == 0:
        gone("kill", place)
    end(p.id)

priv func gone(what: &strview, place: &strview) -> never:
    panic(what + " of a process that is not running: it was never started, or it was waited already", place)

priv func named(launched: &slice[&strview]|&strview) -> &strview:
    if launched is &strview:
        return launched
    return launched[0]

func random_bytes(into: &slice[u8]) where @linux():
    at: usize = 0
    while at < into.len:
        got := getrandom((ptr(into.*) as usize + at) as *bytes, into.len - at, 0)
        if got < 0 and errno() != 4: # EINTR
            no_random(errno())
        if got > 0:
            at += usize(got)

func random_bytes(into: &slice[u8]) where @macos():
    for at in 0..(into.len + 255) / 256:
        part := into[at * 256:]
        if part.len > 256:
            part = part[:256] # the most getentropy gives at once
        if getentropy(ptr(part.*), part.len) != 0:
            no_random(errno())

func random_bytes(into: &slice[u8]) where @windows():
    most: usize = 0x8000_0000 # BCryptGenRandom counts in 32 bits
    for at in 0..(into.len + most - 1) / most:
        part := into[at * most:]
        if part.len > most:
            part = part[:most]
        failed := BCryptGenRandom(usize(0) as *bytes, ptr(part.*), u32(part.len), 2) # BCRYPT_USE_SYSTEM_PREFERRED_RNG
        if failed != 0:
            no_random(failed)

# a key that comes out weak is worse than a program that stops
priv func no_random(code: i32):
    panic("" + FsError{code, "read random bytes", ""})

# close on exec from the start, so a program that another thread starts doesn't take it
priv func make_pipe(fds: *array[i32, 2]) -> bool where @linux():
    return pipe2(fds as *i32, 0x80000) == 0 # O_CLOEXEC

priv func make_pipe(fds: *array[i32, 2]) -> bool where @macos():
    if pipe(fds as *i32) != 0:
        return false
    fcntl(fds.*[0], 2, 1) # FD_CLOEXEC
    fcntl(fds.*[1], 2, 1)
    return true

priv func make_pipe(fds: *array[i32, 2]) -> bool where @windows():
    return _pipe(fds as *i32, 65536, 0x8080) == 0 # _O_BINARY and _O_NOINHERIT

# a socket pair and not a pipe, so writing to a program that ended is an error and not a SIGPIPE that ends yours
priv func make_input(fds: *array[i32, 2]) -> bool where @linux():
    return socketpair(1, 0x80001, 0, fds as *i32) == 0 # AF_UNIX, and SOCK_STREAM with SOCK_CLOEXEC, Linux sends with MSG_NOSIGNAL

priv func make_input(fds: *array[i32, 2]) -> bool where @macos():
    if socketpair(1, 1, 0, fds as *i32) != 0: # AF_UNIX and SOCK_STREAM
        return false
    fcntl(fds.*[0], 2, 1)
    fcntl(fds.*[1], 2, 1)
    yes: i32 = 1
    setsockopt(fds.*[1], 65535, 0x1022, ptr(yes) as *bytes, 4) # SO_NOSIGPIPE
    return true

priv func make_input(fds: *array[i32, 2]) -> bool where @windows():
    return make_pipe(fds)

priv func spawn(launched: &slice[&strview]|&strview, input: i32, output: i32) -> i64|FsError where @linux():
    failure: array[i32, 2]
    if not make_pipe(ptr(failure)):
        return FsError{errno(), "run", named(launched)}
    flush()
    args := arguments(launched)
    pid := fork()
    if pid == 0:
        standard(input, 0)
        standard(output, 1)
        execvp(args.*, args)
        failed := errno()
        write(failure[1], ptr(failed) as *bytes, 4)
        _exit(127)
    code := errno()
    free(args)
    close(failure[1])
    told := read(failure[0], ptr(code) as *bytes, 4)
    close(failure[0])
    if told == 4:
        finish(i64(pid))
    if pid < 0 or told == 4:
        return FsError{code, "run", named(launched)}
    return i64(pid)

# in the child, fd becomes the standard file, also when it already has that number and only has to stay open
priv func standard(fd: i32, number: i32) where @linux():
    if fd == number:
        fcntl(fd, 2, 0) # F_SETFD without FD_CLOEXEC
    elif fd >= 0:
        dup2(fd, number)

# POSIX_SPAWN_CLOEXEC_DEFAULT closes in the program every file of this one but its three
priv func spawn(launched: &slice[&strview]|&strview, input: i32, output: i32) -> i64|FsError where @macos():
    actions := usize(0) as *bytes
    attributes := usize(0) as *bytes
    posix_spawn_file_actions_init(ptr(actions))
    posix_spawnattr_init(ptr(attributes))
    posix_spawnattr_setflags(ptr(attributes), 0x4000)
    given := [input, output, -1]
    for k in 0..3:
        if given[k] >= 0 and given[k] != i32(k):
            posix_spawn_file_actions_adddup2(ptr(actions), given[k], i32(k))
        else:
            posix_spawn_file_actions_addinherit_np(ptr(actions), i32(k))
    flush()
    args := arguments(launched)
    pid: i32 = 0
    code := posix_spawnp(ptr(pid), args.*, ptr(actions), ptr(attributes), args, _NSGetEnviron().*)
    free(args)
    posix_spawn_file_actions_destroy(ptr(actions))
    posix_spawnattr_destroy(ptr(attributes))
    if code != 0:
        return FsError{code, "run", named(launched)}
    return i64(pid)

# the arguments as C takes them, in one block: a command goes to sh
priv func arguments(launched: &slice[&strview]|&strview) -> **u8 where not @windows():
    program: &slice[&strview]
    if launched is &strview:
        program = ptr(["/bin/sh", "-c", launched])
    else:
        program = launched
    table := (program.len + 1) * 8
    size := table
    for part in program:
        size += part.len + 1
    args := malloc(size) as **u8
    at := table
    for i in 0..program.len + 1:
        slot := (args as usize + i * 8) as **u8
        slot.* = usize(0) as *u8
        if i < program.len:
            text := (args as usize + at) as *u8
            memcpy(text as *bytes, ptr(program[i].*), program[i].len)
            ((text as usize + program[i].len) as *u8).* = 0
            slot.* = text
            at += program[i].len + 1
    return args

# the program inherits only its three handles, and gets no window of its own when this one has no console
priv func spawn(launched: &slice[&strview]|&strview, input: i32, output: i32) -> i64|FsError where @windows():
    line: &str
    defer free(line)
    made: i32 = 0
    code: u32 = 0
    info: ProcessInfo
    program: &slice[&strview]
    if launched is &strview:
        line += "cmd.exe /d /s /c \"" + launched + "\"" # what _wsystem runs, with every handle of this program but its three kept to itself
    else:
        program = launched
    with scratch():
        if program.len > 0:
            dot := program[0].len
            for i in reverse 0..program[0].len:
                c := program[0][i]
                if c == '.':
                    dot = i
                if c == '.' or c == '/' or c == '\\':
                    break
            extension := lower(program[0][dot:])
            if extension == ".bat" or extension == ".cmd":
                return FsError{22, "run", program[0]} # cmd.exe would read the arguments again, a batch file goes with run(command)
            for i, word in program:
                part := word
                if i == 0 and extension.len == 0:
                    part = word + ".exe" # CreateProcessW adds it only to a name without a folder
                if line.len > 0:
                    line += " "
                if part.len > 0 and not contains(part, " ") and not contains(part, "\t") and not contains(part, "\""):
                    line += part
                else:
                    line += "\""
                    slashes: usize = 0
                    for c in items(part):
                        if c == '"':
                            for k in 0..slashes + 1:
                                add_byte(line, '\\')
                        add_byte(line, c)
                        if c == '\\':
                            slashes += 1
                        else:
                            slashes = 0
                    for k in 0..slashes:
                        add_byte(line, '\\')
                    line += "\""
        flush()
        given := [input, output, -1]
        launch := StartupInfo{size = 112, flags = 0x100} # STARTF_USESTDHANDLES
        nowhere: usize = 0 # the NUL device, for a standard handle that this program doesn't have
        for k in 0..3:
            source := GetStdHandle(u32(0xffff_fff6) - u32(k)) # STD_INPUT_HANDLE, STD_OUTPUT_HANDLE and STD_ERROR_HANDLE
            if given[k] >= 0:
                source = _get_osfhandle(given[k])
            if (source == 0 or source == usize(0) - 1) and nowhere == 0:
                nowhere = CreateFileW(wstr("NUL"), 0xc000_0000, 3, usize(0) as *bytes, 3, 0, 0) # GENERIC_READ and GENERIC_WRITE, shared, OPEN_EXISTING
            if source == 0 or source == usize(0) - 1:
                source = nowhere
            DuplicateHandle(GetCurrentProcess(), source, GetCurrentProcess(), ptr(launch.handles[k]), 0, 1, 2) # inheritable, DUPLICATE_SAME_ACCESS
        size: usize = 0
        InitializeProcThreadAttributeList(usize(0) as *bytes, 1, 0, ptr(size))
        launch.attributes = temp(size)
        InitializeProcThreadAttributeList(launch.attributes, 1, 0, ptr(size))
        UpdateProcThreadAttribute(launch.attributes, 0, 0x20002, ptr(launch.handles) as *bytes, 24, usize(0) as *bytes, usize(0) as *usize) # PROC_THREAD_ATTRIBUTE_HANDLE_LIST
        flags: u32 = 0x80000 # EXTENDED_STARTUPINFO_PRESENT
        consoles: u32 = 0
        if GetConsoleProcessList(ptr(consoles), 1) == 0:
            flags = flags or 0x800_0000 # CREATE_NO_WINDOW
        made = CreateProcessW(usize(0) as wstr, wstr(line), usize(0) as *bytes, usize(0) as *bytes, 1, flags, usize(0) as *bytes, usize(0) as wstr, ptr(launch), ptr(info))
        code = GetLastError()
        DeleteProcThreadAttributeList(launch.attributes)
        for h in launch.handles:
            CloseHandle(h)
        if nowhere != 0:
            CloseHandle(nowhere)
    if made == 0:
        return FsError{windows_errno(code), "run", named(launched)}
    CloseHandle(info.thread)
    return i64(info.process)

priv func finish(pid: i64, place: &strview = @here()) -> i32 where not @windows():
    status: i32 = 0
    while waitpid(i32(pid), ptr(status), 0) < 0:
        if errno() != 4: # EINTR
            gone("wait", place)
    return exit_code(status)

priv func finish(process: i64, place: &strview = @here()) -> i32 where @windows():
    code: u32 = 0
    if WaitForSingleObject(usize(process), 0xffff_ffff) != 0:
        gone("wait", place)
    GetExitCodeProcess(usize(process), ptr(code))
    CloseHandle(usize(process))
    return i32(code)

# without taking it, so the pid is not reused until wait
priv func ended(pid: i64) -> bool where not @windows():
    info: array[u32, 32]
    waitid(1, u32(pid), ptr(info) as *bytes, peeking()) # P_PID
    return info[0] != 0 and info[2] >= 1 and info[2] <= 3 # si_code CLD_EXITED, CLD_KILLED or CLD_DUMPED, macOS gives a stopped one too

priv func peeking() -> i32 where @linux():
    return 0x100_0005 # WEXITED, WNOHANG and WNOWAIT

priv func peeking() -> i32 where @macos():
    return 0x25

priv func ended(process: i64) -> bool where @windows():
    return WaitForSingleObject(usize(process), 0) == 0

priv func end(pid: i64) where not @windows():
    kill(i32(pid), 9) # SIGKILL

priv func end(process: i64) where @windows():
    TerminateProcess(usize(process), 137) # what a SIGKILL gives on the other systems

priv func exit_code(status: i32) -> i32 where not @windows():
    if (status and 127) != 0:
        return 128 + (status and 127)
    return (status >> 8) and 255

priv func exit_code(status: i32) -> i32 where @windows():
    return status

func executable() -> &strview where @linux():
    buf: array[u8, 4096]
    size := readlink("/proc/self/exe", ptr(buf) as *u8, 4096)
    if size < 0 or size == 4096:
        return ""
    found: &strview
    found = ptr(buf) as *bytes
    found.len = usize(size)
    return temp(found)

func executable() -> &strview where @macos():
    buf: array[u8, 4096]
    size: u32 = 4096
    full: array[u8, 4096]
    if _NSGetExecutablePath(ptr(buf) as *u8, ptr(size)) != 0 or realpath(ptr(buf) as *u8, ptr(full) as *u8) as usize == 0:
        return ""
    return temp(view(ptr(full) as *u8))

func executable() -> &strview where @windows():
    buf: array[u16, 4096]
    size := GetModuleFileNameW(usize(0) as *bytes, ptr(buf) as wstr, 4096)
    if size == 0 or size == 4096:
        return ""
    return replace(temp(ptr(buf) as wstr), "\\", "/")

func system_name() -> &strview where @linux():
    return "Linux"

func system_name() -> &strview where @macos():
    return "Darwin"

func system_name() -> &strview where @windows():
    return "Windows"

func current_dir() -> &strview where not @windows():
    buf: array[u8, 4096]
    if getcwd(ptr(buf) as *u8, 4096) as usize == 0:
        return ""
    return temp(view(ptr(buf) as *u8))

func current_dir() -> &strview where @windows():
    buf: array[u16, 4096]
    if _wgetcwd(ptr(buf) as wstr, 4096) as usize == 0:
        return ""
    return replace(temp(ptr(buf) as wstr), "\\", "/")

func change_dir(path: &strview) -> FsError?:
    failed := false
    with scratch():
        failed = enter(path) != 0
    if failed:
        return FsError{errno(), "enter", path}
    return null

priv func enter(path: &strview) -> i32 where not @windows():
    return chdir(cstr(path))

priv func enter(path: &strview) -> i32 where @windows():
    return _wchdir(wstr(path))

priv func seconds(c: Clock) -> f64:
    return f64(c.seconds) + f64(c.nanos) / 1000000000.0

func now() -> f64 where not @windows():
    c: Clock
    clock_gettime(0, ptr(c))
    return seconds(c)

func now() -> f64 where @windows():
    ticks: u64 = 0
    GetSystemTimePreciseAsFileTime(ptr(ticks))
    return f64(ticks - 116444736000000000) / 10000000.0

func clock() -> f64 where @linux():
    c: Clock
    clock_gettime(1, ptr(c))
    return seconds(c)

func clock() -> f64 where @macos():
    c: Clock
    clock_gettime(6, ptr(c))
    return seconds(c)

func clock() -> f64 where @windows():
    ticks: i64 = 0
    rate: i64 = 1
    QueryPerformanceCounter(ptr(ticks))
    QueryPerformanceFrequency(ptr(rate))
    return f64(ticks) / f64(rate)

func date() -> Date where not @windows():
    moment := time(usize(0) as *i64)
    fields: array[i32, 16]
    localtime_r(ptr(moment), ptr(fields) as *bytes)
    return Date{fields[5] + 1900, fields[4] + 1, fields[3], fields[2], fields[1], fields[0], fields[6]}

func date() -> Date where @windows():
    moment := _time64(usize(0) as *i64)
    fields: array[i32, 16]
    _localtime64_s(ptr(fields) as *bytes, ptr(moment))
    return Date{fields[5] + 1900, fields[4] + 1, fields[3], fields[2], fields[1], fields[0], fields[6]}

func sleep(seconds: f64) where not @windows():
    whole := seconds
    if whole > 1000000000.0:
        whole = 1000000000.0 # 31 years, the most the nanoseconds can count
    left := Clock{i64(whole), 0}
    left.nanos = i64((whole - f64(left.seconds)) * 1000000000.0)
    while left.seconds >= 0 and left.nanos >= 0 and left.nanos < 1000000000 and nanosleep(ptr(left), ptr(left)) != 0:
        pass

func sleep(seconds: f64) where @windows():
    left := seconds
    while left > 0.0:
        part := left
        if part > 1000000.0:
            part = 1000000.0 # Sleep counts milliseconds in 32 bits
        Sleep(u32(part * 1000.0))
        left -= part

extern "dl" where @linux():

type Library:
    handle: *bytes

type error LoadError:
    path: &strview
    reason: &strview

operator +=(s: *&str, e: LoadError):
    s.* += "cannot load " + e.path + ": " + e.reason

func load(path: &strview) -> Library|LoadError where not @windows():
    handle := usize(0) as *bytes
    with scratch():
        handle = dlopen(cstr(path), loading())
    if handle as usize != 0:
        return Library{handle}
    reason := view(dlerror())
    if starts_with(reason, path) and starts_with(reason[path.len:], ": "):
        reason = reason[path.len + 2:] # glibc says the path first
    return LoadError{path, temp(reason)}

func load(path: &strview) -> Library|LoadError where @windows():
    handle := usize(0) as *bytes
    code: u32 = 0
    with scratch():
        handle = LoadLibraryW(wstr(path))
        code = GetLastError()
    if handle as usize != 0:
        return Library{handle}
    text: array[u16, 512]
    FormatMessageW(0x1200, usize(0) as *bytes, code, 0, ptr(text) as wstr, 512, usize(0) as *bytes)
    return LoadError{path, trim_end(temp(ptr(text) as wstr))}

priv func loading() -> i32 where @linux():
    return 2 # RTLD_NOW, and RTLD_LOCAL is 0

priv func loading() -> i32 where @macos():
    return 6 # RTLD_NOW and RTLD_LOCAL

func symbol(library: Library, name: &strview) -> *bytes?:
    found := usize(0) as *bytes
    with scratch():
        found = dlsym(library.handle, cstr(name))
    if found as usize == 0:
        return null
    return found

func close(library: Library):
    dlclose(library.handle)
