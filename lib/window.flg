module window
use os
use utf8
use x11
use win32
use objc
use cocoa

type Window:
    state: *State # where the events wait, in one place for the callbacks of the system

type error WindowError:
    reason: &strview

operator +=(s: *&str, e: WindowError):
    s.* += e.reason

type enum Key:
    KeyUnknown, KeySpace, KeyApostrophe, KeyComma, KeyMinus, KeyPeriod, KeySlash, KeySemicolon, KeyEqual
    Key0, Key1, Key2, Key3, Key4, Key5, Key6, Key7, Key8, Key9
    KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM
    KeyN, KeyO, KeyP, KeyQ, KeyR, KeyS, KeyT, KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ
    KeyLeftBracket, KeyBackslash, KeyRightBracket, KeyGrave
    KeyEscape, KeyEnter, KeyTab, KeyBackspace, KeyInsert, KeyDelete, KeyCapsLock, KeyMenu
    KeyArrowRight, KeyArrowLeft, KeyArrowDown, KeyArrowUp, KeyPageUp, KeyPageDown, KeyHome, KeyEnd
    KeyF1, KeyF2, KeyF3, KeyF4, KeyF5, KeyF6, KeyF7, KeyF8, KeyF9, KeyF10, KeyF11, KeyF12
    KeyLeftShift, KeyLeftControl, KeyLeftAlt, KeyLeftSuper, KeyRightShift, KeyRightControl, KeyRightAlt, KeyRightSuper

type enum Button = MouseLeft|MouseRight|MouseMiddle

type enum CursorShape = CursorArrow|CursorText|CursorHand|CursorCrosshair|CursorResizeH|CursorResizeV|CursorResizeAll|CursorNotAllowed|CursorHidden

type Mods:
    shift: bool
    control: bool
    alt: bool
    super: bool

type Closed

type Resized:
    width: i32
    height: i32

type Focus:
    on: bool

type KeyDown:
    key: Key
    repeat: bool
    mods: Mods

type KeyUp:
    key: Key
    mods: Mods

type Typed:
    code: u32

type MouseMoved:
    x: f64
    y: f64

type MouseDown:
    button: Button
    x: f64
    y: f64
    mods: Mods

type MouseUp:
    button: Button
    x: f64
    y: f64
    mods: Mods

type Scrolled:
    x: f64
    y: f64

type Event = Closed|Resized|Focus|KeyDown|KeyUp|Typed|MouseMoved|MouseDown|MouseUp|Scrolled

# the key at each position of the keyboard: Linux numbers them like the scancodes of Windows, up to F12
KEYS: array[Key, 89] = [KeyUnknown, KeyEscape, Key1, Key2, Key3, Key4, Key5, Key6, Key7, Key8, Key9, Key0, KeyMinus, KeyEqual, KeyBackspace, KeyTab, KeyQ, KeyW, KeyE, KeyR, KeyT, KeyY, KeyU, KeyI, KeyO, KeyP, KeyLeftBracket, KeyRightBracket, KeyEnter, KeyLeftControl, KeyA, KeyS, KeyD, KeyF, KeyG, KeyH, KeyJ, KeyK, KeyL, KeySemicolon, KeyApostrophe, KeyGrave, KeyLeftShift, KeyBackslash, KeyZ, KeyX, KeyC, KeyV, KeyB, KeyN, KeyM, KeyComma, KeyPeriod, KeySlash, KeyRightShift, KeyUnknown, KeyLeftAlt, KeySpace, KeyCapsLock, KeyF1, KeyF2, KeyF3, KeyF4, KeyF5, KeyF6, KeyF7, KeyF8, KeyF9, KeyF10, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyF11, KeyF12]

# the next event that is waiting, or null when there is none
func poll(w: Window) -> Event?:
    pump(w.state, false)
    return taken(w.state)

func wait(w: Window) -> Event:
    while true:
        found := taken(w.state)
        if found != null:
            return found
        pump(w.state, true)

# the size of the drawing area in pixels
func size(w: Window) -> (i32, i32):
    return w.state.width, w.state.height

# pixels for each point of the system: 2.0 on a screen of double density
func scale(w: Window) -> f64:
    return w.state.scale

priv func taken(s: *State) -> Event?:
    if s.first == s.events.len:
        s.first = 0
        s.events.len = 0
        return null
    s.first += 1
    return s.events[s.first - 1]

priv func typed(s: *State, text: &strview):
    for c in text:
        code := first_code(c)
        if code is u32 and code >= 32 and code != 127 and (code < 0xf700 or code > 0xf8ff): # macOS gives its function keys as private characters
            append(s.events, Typed{code})

where @linux():
    type State:
        display: *Display
        handle: x11.Window
        im: XIM
        ic: XIC
        closing: Atom
        clipboard: Atom
        utf8: Atom
        targets: Atom
        incoming: Atom
        incr: Atom
        owned: &str = heap("")
        piece: i64 # the most bytes one request to the server carries
        sending: &list[Transfer] = heap([])
        width: i32
        height: i32
        scale: f64 = 1.0
        down: array[bool, 256]
        cursor: x11.Cursor
        events: &list[Event] = heap([])
        first: i64

    type Native:
        display: *Display
        window: x11.Window

    # a window that takes owned in pieces, each one after it deletes the last
    priv type Transfer:
        requestor: x11.Window
        property: Atom
        given: i64

    priv extern "c":
        func setlocale(category: i32, locale: cstr) -> cstr

    func open(title: &strview, width: i32, height: i32) -> Window|WindowError:
        _ = XInitThreads() # a program of Flag may call Xlib from many threads
        _ = setlocale(0, "") # LC_CTYPE, so the input method gives text in UTF-8
        _ = XSetLocaleModifiers("")
        display := XOpenDisplay(0 as cstr)
        if display as u64 == 0:
            return WindowError{"cannot open window; no X server at DISPLAY"}
        screen := XDefaultScreen(display)
        given: XSetWindowAttributes
        given.event_mask = KeyPressMask or KeyReleaseMask or ButtonPressMask or ButtonReleaseMask or PointerMotionMask or StructureNotifyMask or FocusChangeMask or PropertyChangeMask
        given.background_pixel = XBlackPixel(display, screen)
        handle := XCreateWindow(display, XRootWindow(display, screen), 0, 0, u32(width), u32(height), 0, CopyFromParent, InputOutput, 0 as *Visual, CWEventMask or CWBackPixel, ptr(given))
        s := heap(State{display = display, handle = handle, width = width, height = height})
        s.closing = XInternAtom(display, "WM_DELETE_WINDOW", False)
        _ = XSetWMProtocols(display, handle, ptr(s.closing), 1)
        s.clipboard = XInternAtom(display, "CLIPBOARD", False)
        s.utf8 = XInternAtom(display, "UTF8_STRING", False)
        s.targets = XInternAtom(display, "TARGETS", False)
        s.incoming = XInternAtom(display, "FLAG_CLIPBOARD", False)
        s.incr = XInternAtom(display, "INCR", False)
        s.piece = XMaxRequestSize(display) * 4 - 1024
        _ = XkbSetDetectableAutoRepeat(display, True, 0 as *i32) # a held key sends presses only, not a release before each
        s.im = XOpenIM(display, 0 as XrmDatabase, 0 as cstr, 0 as cstr)
        if s.im as u64 != 0:
            s.ic = XCreateIC(s.im, XNInputStyle, i64(XIMPreeditNothing or XIMStatusNothing), XNClientWindow, handle, XNFocusWindow, handle, 0 as cstr)
        resources := XResourceManagerString(display)
        if resources as u64 != 0:
            XrmInitialize()
            database := XrmGetStringDatabase(resources)
            kind := 0 as cstr
            found: XrmValue
            if XrmGetResource(database, "Xft.dpi", "Xft.Dpi", ptr(kind), ptr(found)) != 0 and found.addr as u64 != 0:
                s.scale = strtod(found.addr, 0 as *bytes) / 96.0
            XrmDestroyDatabase(database)
        w := Window{s}
        set_title(w, title)
        _ = XMapWindow(display, handle)
        _ = XFlush(display)
        return w

    func close(w: Window):
        s := w.state
        if s.ic as u64 != 0:
            XDestroyIC(s.ic)
        if s.im as u64 != 0:
            _ = XCloseIM(s.im)
        if s.cursor != 0:
            _ = XFreeCursor(s.display, s.cursor)
        _ = XDestroyWindow(s.display, s.handle)
        _ = XCloseDisplay(s.display)
        free(s.owned)
        free(s.sending)
        free(s.events)
        free(s)

    func native(w: Window) -> Native:
        return Native{w.state.display, w.state.handle}

    priv func pump(s: *State, block: bool):
        waiting := block
        while waiting or XPending(s.display) > 0:
            waiting = false
            e: XEvent
            _ = XNextEvent(s.display, ptr(e))
            if XFilterEvent(ptr(e), 0) != 0: # the input method took it
                continue
            switch i32(e):
            case KeyPress:
                k := XKeyEvent(e)
                code := k.keycode and 255
                append(s.events, KeyDown{key_of(k.keycode), s.down[code], mods_of(k.state)})
                s.down[code] = true
                if s.ic as u64 != 0:
                    text: array[u8, 64]
                    status: i32
                    n := Xutf8LookupString(s.ic, ptr(k), ptr(text[0]) as cstr, 63, 0 as *KeySym, ptr(status))
                    if status == XLookupChars or status == XLookupBoth:
                        text[n] = 0
                        typed(s, view(ptr(text[0]) as cstr))
            case KeyRelease:
                k := XKeyEvent(e)
                s.down[k.keycode and 255] = false
                append(s.events, KeyUp{key_of(k.keycode), mods_of(k.state)})
            case ButtonPress:
                b := XButtonEvent(e)
                switch b.button:
                case 4, 5:
                    append(s.events, Scrolled{0.0, 1.0 if b.button == 4 else -1.0})
                case 6, 7:
                    append(s.events, Scrolled{1.0 if b.button == 6 else -1.0, 0.0})
                case 1, 2, 3:
                    append(s.events, MouseDown{button_of(b.button), f64(b.x), f64(b.y), mods_of(b.state)})
            case ButtonRelease:
                b := XButtonEvent(e)
                if b.button >= 1 and b.button <= 3:
                    append(s.events, MouseUp{button_of(b.button), f64(b.x), f64(b.y), mods_of(b.state)})
            case MotionNotify:
                m := XMotionEvent(e)
                append(s.events, MouseMoved{f64(m.x), f64(m.y)})
            case ConfigureNotify:
                c := XConfigureEvent(e)
                if c.width != s.width or c.height != s.height:
                    s.width = c.width
                    s.height = c.height
                    append(s.events, Resized{c.width, c.height})
            case FocusIn, FocusOut:
                on := i32(e) == FocusIn
                if s.ic as u64 != 0 and on:
                    XSetICFocus(s.ic)
                elif s.ic as u64 != 0:
                    XUnsetICFocus(s.ic)
                append(s.events, Focus{on})
            case ClientMessage:
                if u64(array[i64, 5](XClientMessageEvent(e).data)[0]) == s.closing:
                    append(s.events, Closed)
            case SelectionRequest:
                r := XSelectionRequestEvent(e)
                reply := XSelectionEvent{type = SelectionNotify, display = s.display, requestor = r.requestor, selection = r.selection, target = r.target, property = r.property, time = r.time}
                if r.target == s.targets:
                    offered: array[Atom, 2] = [s.targets, s.utf8]
                    _ = XChangeProperty(s.display, r.requestor, r.property, XA_ATOM, 32, PropModeReplace, ptr(offered[0]) as *u8, 2)
                elif r.target == s.utf8 and s.owned.len > s.piece: # in pieces, each one after the requestor deletes the last
                    total := s.owned.len
                    _ = XSelectInput(s.display, r.requestor, PropertyChangeMask)
                    _ = XChangeProperty(s.display, r.requestor, r.property, s.incr, 32, PropModeReplace, ptr(total) as *u8, 1)
                    append(s.sending, Transfer{r.requestor, r.property, 0})
                elif r.target == s.utf8 and s.owned.len > 0:
                    _ = XChangeProperty(s.display, r.requestor, r.property, s.utf8, 8, PropModeReplace, ptr(s.owned.*) as *u8, i32(s.owned.len))
                else:
                    reply.property = None
                sent: XEvent = reply
                _ = XSendEvent(s.display, r.requestor, False, 0, ptr(sent))
            case SelectionClear:
                s.owned.len = 0
                s.sending.len = 0
            case PropertyNotify:
                p := XPropertyEvent(e)
                for k, sent in s.sending:
                    if p.window == sent.requestor and p.atom == sent.property and p.state == PropertyDelete:
                        part := min(s.piece, s.owned.len - sent.given)
                        _ = XChangeProperty(s.display, sent.requestor, sent.property, s.utf8, 8, PropModeReplace, (ptr(s.owned.*) as *bytes + sent.given) as *u8, i32(part))
                        sent.given += part
                        if part == 0: # the empty piece says it is all there
                            _ = XSelectInput(s.display, sent.requestor, NoEventMask)
                            s.sending[k] = s.sending[-1]
                            s.sending.len -= 1
                        break

    priv func button_of(button: u32) -> Button:
        if button == 1:
            return MouseLeft
        if button == 2:
            return MouseMiddle
        return MouseRight

    priv func mods_of(state: u32) -> Mods:
        return Mods{(state and ShiftMask) != 0, (state and ControlMask) != 0, (state and Mod1Mask) != 0, (state and Mod4Mask) != 0}

    priv func key_of(keycode: u32) -> Key:
        code := keycode - 8 # X numbers the keys from 8
        if code < 89:
            return KEYS[code]
        switch code:
        case 96:
            return KeyEnter
        case 97:
            return KeyRightControl
        case 100:
            return KeyRightAlt
        case 102:
            return KeyHome
        case 103:
            return KeyArrowUp
        case 104:
            return KeyPageUp
        case 105:
            return KeyArrowLeft
        case 106:
            return KeyArrowRight
        case 107:
            return KeyEnd
        case 108:
            return KeyArrowDown
        case 109:
            return KeyPageDown
        case 110:
            return KeyInsert
        case 111:
            return KeyDelete
        case 125:
            return KeyLeftSuper
        case 126:
            return KeyRightSuper
        case 127:
            return KeyMenu
        return KeyUnknown

    func set_title(w: Window, title: &strview):
        s := w.state
        _ = XStoreName(s.display, s.handle, cstr(title))
        _ = XChangeProperty(s.display, s.handle, XInternAtom(s.display, "_NET_WM_NAME", False), s.utf8, 8, PropModeReplace, cstr(title) as *u8, i32(title.len))
        _ = XFlush(s.display)

    func set_size(w: Window, width: i32, height: i32):
        _ = XResizeWindow(w.state.display, w.state.handle, u32(width), u32(height))
        _ = XFlush(w.state.display)

    func set_fullscreen(w: Window, on: bool):
        s := w.state
        message := XClientMessageEvent{type = ClientMessage, window = s.handle, message_type = XInternAtom(s.display, "_NET_WM_STATE", False), format = 32}
        wanted: array[i64, 5] = [1 if on else 0, i64(XInternAtom(s.display, "_NET_WM_STATE_FULLSCREEN", False)), 0, 1, 0]
        message.data = wanted
        sent: XEvent = message
        _ = XSendEvent(s.display, XDefaultRootWindow(s.display), False, SubstructureRedirectMask or SubstructureNotifyMask, ptr(sent))
        _ = XFlush(s.display)

    func set_cursor(w: Window, shape: CursorShape):
        s := w.state
        if s.cursor != 0:
            _ = XFreeCursor(s.display, s.cursor)
        if shape == CursorHidden:
            blank: array[u8, 1] = [0]
            pixmap := XCreateBitmapFromData(s.display, s.handle, ptr(blank[0]) as cstr, 1, 1)
            color: XColor
            s.cursor = XCreatePixmapCursor(s.display, pixmap, pixmap, ptr(color), ptr(color), 0, 0)
            _ = XFreePixmap(s.display, pixmap)
        else:
            glyph: u32 = XC_left_ptr
            switch shape:
            case CursorText:
                glyph = XC_xterm
            case CursorHand:
                glyph = XC_hand2
            case CursorCrosshair:
                glyph = XC_crosshair
            case CursorResizeH:
                glyph = XC_sb_h_double_arrow
            case CursorResizeV:
                glyph = XC_sb_v_double_arrow
            case CursorResizeAll:
                glyph = XC_fleur
            case CursorNotAllowed:
                glyph = XC_X_cursor
            case:
                pass
            s.cursor = XCreateFontCursor(s.display, glyph)
        _ = XDefineCursor(s.display, s.handle, s.cursor)
        _ = XFlush(s.display)

    func clipboard(w: Window) -> &str:
        s := w.state
        text: &str = heap("")
        if XGetSelectionOwner(s.display, s.clipboard) == s.handle:
            text += s.owned
            return text
        _ = XConvertSelection(s.display, s.clipboard, s.utf8, s.incoming, s.handle, CurrentTime)
        e: XEvent
        if not arrived(s, SelectionNotify, ptr(e)) or XSelectionEvent(e).property == None:
            return text
        kind, count := received(s, ptr(text))
        if kind == s.incr: # the owner sends it in pieces, each one after we delete the last
            done := false
            while not done and arrived(s, PropertyNotify, ptr(e)):
                if XPropertyEvent(e).atom == s.incoming and XPropertyEvent(e).state == PropertyNewValue:
                    kind, count = received(s, ptr(text))
                    done = kind != 0 and count == 0 # the empty piece ends it; the notice of the INCR finds no property
        return text

    # waits a second at most for an event of this kind on the window
    priv func arrived(s: *State, kind: i32, e: *XEvent) -> bool:
        for tries in 0..200:
            if XCheckTypedWindowEvent(s.display, s.handle, kind, e) != 0:
                return true
            sleep(0.005)
        return false

    # adds the incoming property to text and deletes it, which asks the owner for the next piece
    priv func received(s: *State, text: *&str) -> (Atom, u64):
        kind: Atom
        format: i32
        count: u64
        after: u64
        data := 0 as *u8
        if XGetWindowProperty(s.display, s.handle, s.incoming, 0, 0x7fff_ffff, True, AnyPropertyType, ptr(kind), ptr(format), ptr(count), ptr(after), ptr(data)) != Success or data as u64 == 0:
            return 0, 0
        if kind != s.incr:
            text.* += view(data as cstr) # Xlib ends the bytes with a 0
        _ = XFree(data as *bytes)
        return kind, count

    func set_clipboard(w: Window, text: &strview):
        s := w.state
        s.owned = text
        s.sending.len = 0 # pieces of the text before are no use
        _ = XSetSelectionOwner(s.display, s.clipboard, s.handle, CurrentTime)
        _ = XFlush(s.display)

where @windows():
    type State:
        hwnd: HWND
        instance: HINSTANCE
        width: i32
        height: i32
        scale: f64 = 1.0
        cursor: HCURSOR
        high: u32 # the first half of a character that UTF-16 writes in two
        fullscreen: bool
        style: LONG_PTR
        placement: RECT
        events: &list[Event] = heap([])
        first: i64

    type Native:
        hwnd: HWND
        instance: HINSTANCE

    func open(title: &strview, width: i32, height: i32) -> Window|WindowError:
        _ = SetProcessDpiAwarenessContext(0xffff_ffff_ffff_fffc as DPI_AWARENESS_CONTEXT) # per monitor, version 2
        instance := GetModuleHandleW(0 as LPCWSTR)
        arrow := LoadCursorW(0 as HINSTANCE, IDC_ARROW as LPCWSTR)
        class := WNDCLASSEXW{cbSize = @sizeof(WNDCLASSEXW), style = CS_HREDRAW or CS_VREDRAW or CS_OWNDC, lpfnWndProc = flag_window_proc, hInstance = instance, hCursor = arrow, lpszClassName = wstr("flag")}
        _ = RegisterClassExW(class) # the second window finds the class there
        frame := RECT{0, 0, width, height}
        _ = AdjustWindowRectEx(ptr(frame), WS_OVERLAPPEDWINDOW, FALSE, 0)
        hwnd := CreateWindowExW(0, wstr("flag"), wstr(title), WS_OVERLAPPEDWINDOW, CW_USEDEFAULT, CW_USEDEFAULT, frame.right - frame.left, frame.bottom - frame.top, 0 as HWND, 0 as HMENU, instance, 0 as LPVOID)
        if hwnd as u64 == 0:
            return WindowError{"cannot open window; Windows error " + GetLastError()}
        s := heap(State{hwnd = hwnd, instance = instance, width = width, height = height, cursor = arrow})
        s.scale = f64(GetDpiForWindow(hwnd)) / 96.0
        _ = SetWindowLongPtrW(hwnd, GWLP_USERDATA, s as LONG_PTR)
        _ = ShowWindow(hwnd, SW_SHOW)
        _ = UpdateWindow(hwnd)
        return Window{s}

    func close(w: Window):
        _ = SetWindowLongPtrW(w.state.hwnd, GWLP_USERDATA, 0)
        _ = DestroyWindow(w.state.hwnd)
        free(w.state.events)
        free(w.state)

    func native(w: Window) -> Native:
        return Native{w.state.hwnd, w.state.instance}

    priv func pump(s: *State, block: bool):
        message: MSG
        if block and GetMessageW(ptr(message), 0 as HWND, 0, 0) > 0:
            _ = TranslateMessage(message)
            _ = DispatchMessageW(message)
        while PeekMessageW(ptr(message), 0 as HWND, 0, 0, PM_REMOVE) != 0:
            _ = TranslateMessage(message)
            _ = DispatchMessageW(message)

    export func flag_window_proc(hwnd: HWND, message: UINT, w: WPARAM, l: LPARAM) -> LRESULT:
        found := GetWindowLongPtrW(hwnd, GWLP_USERDATA)
        if found == 0: # the messages before open stores the state
            return DefWindowProcW(hwnd, message, w, l)
        s := found as *State
        low := i32(l and 0xffff)
        high := i32((l >> 16) and 0xffff)
        switch message:
        case WM_CLOSE:
            append(s.events, Closed)
            return 0
        case WM_SIZE:
            s.width = low
            s.height = high
            append(s.events, Resized{low, high})
        case WM_SETFOCUS, WM_KILLFOCUS:
            append(s.events, Focus{message == WM_SETFOCUS})
        case WM_KEYDOWN, WM_SYSKEYDOWN:
            append(s.events, KeyDown{key_of(l), ((l >> 30) and 1) != 0, mods()})
        case WM_KEYUP, WM_SYSKEYUP:
            append(s.events, KeyUp{key_of(l), mods()})
        case WM_CHAR:
            unit := u32(w and 0xffff)
            if unit >= 0xd800 and unit < 0xdc00:
                s.high = unit
                return 0
            code := unit
            if unit >= 0xdc00 and unit < 0xe000:
                code = 0x10000 + ((s.high - 0xd800) << 10) + (unit - 0xdc00)
            if code >= 32 and code != 127:
                append(s.events, Typed{code})
            return 0
        case WM_MOUSEMOVE:
            append(s.events, MouseMoved{f64(signed(low)), f64(signed(high))})
        case WM_LBUTTONDOWN, WM_RBUTTONDOWN, WM_MBUTTONDOWN:
            _ = SetCapture(hwnd)
            append(s.events, MouseDown{button_of(message), f64(signed(low)), f64(signed(high)), mods()})
        case WM_LBUTTONUP, WM_RBUTTONUP, WM_MBUTTONUP:
            _ = ReleaseCapture()
            append(s.events, MouseUp{button_of(message), f64(signed(low)), f64(signed(high)), mods()})
        case WM_MOUSEWHEEL:
            append(s.events, Scrolled{0.0, f64(signed(i32((w >> 16) and 0xffff))) / 120.0})
        case WM_MOUSEHWHEEL:
            append(s.events, Scrolled{-f64(signed(i32((w >> 16) and 0xffff))) / 120.0, 0.0}) # Windows counts a tilt right as positive
        case WM_SETCURSOR:
            if low == HTCLIENT:
                _ = SetCursor(s.cursor)
                return TRUE
        case WM_DPICHANGED:
            s.scale = f64((w >> 16) and 0xffff) / 96.0
            r := l as *RECT
            _ = SetWindowPos(hwnd, 0 as HWND, r.left, r.top, r.right - r.left, r.bottom - r.top, SWP_NOZORDER or SWP_NOACTIVATE)
            return 0
        case WM_ERASEBKGND: # the GPU paints it all
            return 1
        return DefWindowProcW(hwnd, message, w, l)

    priv func signed(half: i32) -> i32:
        if half >= 0x8000:
            return half - 0x10000
        return half

    priv func button_of(message: UINT) -> Button:
        if message == WM_LBUTTONDOWN or message == WM_LBUTTONUP:
            return MouseLeft
        if message == WM_MBUTTONDOWN or message == WM_MBUTTONUP:
            return MouseMiddle
        return MouseRight

    priv func mods() -> Mods:
        return Mods{GetKeyState(VK_SHIFT) < 0, GetKeyState(VK_CONTROL) < 0, GetKeyState(VK_MENU) < 0, GetKeyState(VK_LWIN) < 0 or GetKeyState(VK_RWIN) < 0}

    priv func key_of(l: LPARAM) -> Key:
        code := (l >> 16) and 0xff
        if ((l >> 24) and 1) == 0: # not one of the keys the first keyboards did not have
            return KEYS[code] if code < 89 else KeyUnknown
        switch code:
        case 0x1c:
            return KeyEnter
        case 0x1d:
            return KeyRightControl
        case 0x38:
            return KeyRightAlt
        case 0x47:
            return KeyHome
        case 0x48:
            return KeyArrowUp
        case 0x49:
            return KeyPageUp
        case 0x4b:
            return KeyArrowLeft
        case 0x4d:
            return KeyArrowRight
        case 0x4f:
            return KeyEnd
        case 0x50:
            return KeyArrowDown
        case 0x51:
            return KeyPageDown
        case 0x52:
            return KeyInsert
        case 0x53:
            return KeyDelete
        case 0x5b:
            return KeyLeftSuper
        case 0x5c:
            return KeyRightSuper
        case 0x5d:
            return KeyMenu
        return KeyUnknown

    func set_title(w: Window, title: &strview):
        _ = SetWindowTextW(w.state.hwnd, wstr(title))

    func set_size(w: Window, width: i32, height: i32):
        frame := RECT{0, 0, width, height}
        _ = AdjustWindowRectEx(ptr(frame), u32(GetWindowLongPtrW(w.state.hwnd, GWL_STYLE)), FALSE, 0)
        _ = SetWindowPos(w.state.hwnd, 0 as HWND, 0, 0, frame.right - frame.left, frame.bottom - frame.top, SWP_NOMOVE or SWP_NOZORDER or SWP_NOACTIVATE)

    func set_fullscreen(w: Window, on: bool):
        s := w.state
        if on == s.fullscreen:
            return
        s.fullscreen = on
        r := s.placement
        if on:
            s.style = GetWindowLongPtrW(s.hwnd, GWL_STYLE)
            _ = GetWindowRect(s.hwnd, ptr(s.placement))
            monitor := MONITORINFO{cbSize = @sizeof(MONITORINFO)}
            _ = GetMonitorInfoW(MonitorFromWindow(s.hwnd, MONITOR_DEFAULTTONEAREST), ptr(monitor))
            _ = SetWindowLongPtrW(s.hwnd, GWL_STYLE, WS_POPUP or WS_VISIBLE)
            r = monitor.rcMonitor
        else:
            _ = SetWindowLongPtrW(s.hwnd, GWL_STYLE, s.style)
        _ = SetWindowPos(s.hwnd, 0 as HWND, r.left, r.top, r.right - r.left, r.bottom - r.top, SWP_FRAMECHANGED or SWP_NOOWNERZORDER)

    func set_cursor(w: Window, shape: CursorShape):
        name := IDC_ARROW
        switch shape:
        case CursorText:
            name = IDC_IBEAM
        case CursorHand:
            name = IDC_HAND
        case CursorCrosshair:
            name = IDC_CROSS
        case CursorResizeH:
            name = IDC_SIZEWE
        case CursorResizeV:
            name = IDC_SIZENS
        case CursorResizeAll:
            name = IDC_SIZEALL
        case CursorNotAllowed:
            name = IDC_NO
        case:
            pass
        w.state.cursor = 0 as HCURSOR if shape == CursorHidden else LoadCursorW(0 as HINSTANCE, name as LPCWSTR)
        _ = SetCursor(w.state.cursor)

    func clipboard(w: Window) -> &str:
        text: &str = heap("")
        if OpenClipboard(w.state.hwnd) == 0:
            return text
        data := GetClipboardData(CF_UNICODETEXT)
        if data as u64 != 0:
            text += tmp(GlobalLock(data) as wstr)
            _ = GlobalUnlock(data)
        _ = CloseClipboard()
        return text

    func set_clipboard(w: Window, text: &strview):
        units := 1 # with the 0 at the end
        for c in text:
            units += 2 if c.len == 4 else 1
        memory := GlobalAlloc(GMEM_MOVEABLE, units * 2)
        _ = memcpy(GlobalLock(memory), wstr(text) as *bytes, units * 2)
        _ = GlobalUnlock(memory)
        if OpenClipboard(w.state.hwnd) != 0:
            _ = EmptyClipboard()
            _ = SetClipboardData(CF_UNICODETEXT, memory)
            _ = CloseClipboard()

where @macos():
    type State:
        app: *NSApplication
        window: *NSWindow
        width: i32
        height: i32
        scale: f64 = 1.0
        focused: bool
        hidden: bool
        marked: bool # the input method is composing a character
        delegate: id
        events: &list[Event] = heap([])
        first: i64

    type Native:
        window: *NSWindow
        view: *NSView

    NOT_FOUND: u64 = 0x7fff_ffff_ffff_ffff # NSNotFound, an empty range of text

    priv extern "Foundation.framework":
        NSDefaultRunLoopMode: **NSString

    func open(title: &strview, width: i32, height: i32) -> Window|WindowError:
        pool := init(alloc(NSAutoreleasePool))
        app := sharedApplication(NSApplication)
        _ = setActivationPolicy(app, NSApplicationActivationPolicyRegular)
        finishLaunching(app)
        frame := NSRect{CGPoint{0.0, 0.0}, CGSize{f64(width), f64(height)}}
        style: NSWindowStyleMask = NSWindowStyleMaskTitled or NSWindowStyleMaskClosable or NSWindowStyleMaskMiniaturizable or NSWindowStyleMaskResizable
        made := initWithContentRect_styleMask_backing_defer(alloc(NSWindow), frame, style, NSBackingStoreBuffered, false)
        if made as u64 == 0:
            drain(pool)
            return WindowError{"cannot open window; AppKit returned no window"}
        setReleasedWhenClosed(made, false) # close() releases it
        setAcceptsMouseMovedEvents(made, true)
        center(made)
        s := heap(State{app = app, window = made, width = width, height = height})
        s.scale = backingScaleFactor(made)
        # two classes made once at run time, each holding the state: the content view takes keys through the input method,
        # and the delegate turns the close button into a Closed event
        views := objc_lookUpClass("FlagView")
        if views as u64 == 0:
            views = objc_allocateClassPair(objc_getClass("NSView") as Class, "FlagView", 0)
            _ = class_addIvar(views, "flag_state", 8, 3, "^v")
            _ = class_addProtocol(views, objc_getProtocol("NSTextInputClient"))
            method(views, "acceptsFirstResponder", ptr(flag_accepts_first_responder), "c@:")
            method(views, "keyDown:", ptr(flag_key_down), "v@:@")
            method(views, "insertText:replacementRange:", ptr(flag_insert_text), "v@:@{_NSRange=QQ}")
            method(views, "setMarkedText:selectedRange:replacementRange:", ptr(flag_set_marked_text), "v@:@{_NSRange=QQ}{_NSRange=QQ}")
            method(views, "unmarkText", ptr(flag_unmark_text), "v@:")
            method(views, "hasMarkedText", ptr(flag_has_marked_text), "c@:")
            method(views, "markedRange", ptr(flag_no_range), "{_NSRange=QQ}@:")
            method(views, "selectedRange", ptr(flag_no_range), "{_NSRange=QQ}@:")
            method(views, "validAttributesForMarkedText", ptr(flag_valid_attributes), "@@:")
            method(views, "attributedSubstringForProposedRange:actualRange:", ptr(flag_attributed_substring), "@@:{_NSRange=QQ}^{_NSRange=QQ}")
            method(views, "characterIndexForPoint:", ptr(flag_character_index), "Q@:{CGPoint=dd}")
            method(views, "firstRectForCharacterRange:actualRange:", ptr(flag_first_rect), "{CGRect={CGPoint=dd}{CGSize=dd}}@:{_NSRange=QQ}^{_NSRange=QQ}")
            method(views, "doCommandBySelector:", ptr(flag_do_command), "v@::")
            objc_registerClassPair(views)
        delegates := objc_lookUpClass("FlagWindowDelegate")
        if delegates as u64 == 0:
            delegates = objc_allocateClassPair(objc_getClass("NSObject") as Class, "FlagWindowDelegate", 0)
            _ = class_addIvar(delegates, "flag_state", 8, 3, "^v")
            method(delegates, "windowShouldClose:", ptr(flag_window_should_close), "c@:@")
            objc_registerClassPair(delegates)
        view := initWithFrame((objc_msgSend as extern func(Class, SEL) -> *NSView)(views, sel_registerName("alloc")), frame)
        state_slot(view as id).* = s
        setContentView(made, view)
        _ = makeFirstResponder(made, view as *NSResponder)
        release(view)
        s.delegate = (objc_msgSend as extern func(Class, SEL) -> id)(delegates, sel_registerName("new"))
        state_slot(s.delegate).* = s
        setDelegate(made, s.delegate)
        w := Window{s}
        set_size(w, width, height) # the window took points, and on a screen of double density a point is 2 pixels
        set_title(w, title)
        makeKeyAndOrderFront(made, 0 as id)
        activateIgnoringOtherApps(app, true)
        drain(pool)
        return w

    func close(w: Window):
        setDelegate(w.state.window, 0 as id) # the window does not keep its delegate
        release(w.state.delegate as *NSObject)
        close(w.state.window)
        release(w.state.window)
        free(w.state.events)
        free(w.state)

    priv func method(kind: Class, selector: cstr, code: *bytes, types: cstr):
        _ = class_addMethod(kind, sel_registerName(selector), code as IMP, types)

    # where an object of the two classes keeps the state of its window
    priv func state_slot(object: id) -> **State:
        offset := ivar_getOffset(class_getInstanceVariable(object_getClass(object), "flag_state"))
        return (object as *bytes + offset) as **State

    # the text of an NSString, or of the NSAttributedString that the input method may give instead
    priv func plain(text: id) -> *NSString:
        if isKindOfClass(text as *NSObject, objc_getClass("NSAttributedString") as Class):
            return (objc_msgSend as extern func(id, SEL) -> *NSString)(text, sel_registerName("string"))
        return text as *NSString

    export func flag_window_should_close(self: id, command: SEL, sender: id) -> bool:
        append(state_slot(self).*.events, Closed)
        return false # the program decides, and calls close()

    export func flag_accepts_first_responder(self: id, command: SEL) -> bool:
        return true

    export func flag_key_down(self: id, command: SEL, event: *NSEvent):
        interpretKeyEvents(self as *NSView, arrayWithObject(NSArray, event as *NSObject)) # the input method answers with the calls below

    export func flag_insert_text(self: id, command: SEL, text: id, replaced: NSRange):
        s := state_slot(self).*
        s.marked = false
        typed(s, view(UTF8String(plain(text))))

    export func flag_set_marked_text(self: id, command: SEL, text: id, selected: NSRange, replaced: NSRange):
        state_slot(self).*.marked = length(plain(text)) > 0

    export func flag_unmark_text(self: id, command: SEL):
        state_slot(self).*.marked = false

    export func flag_has_marked_text(self: id, command: SEL) -> bool:
        return state_slot(self).*.marked

    export func flag_no_range(self: id, command: SEL) -> NSRange:
        return NSRange{NOT_FOUND, 0}

    export func flag_valid_attributes(self: id, command: SEL) -> *NSArray:
        return array(NSArray)

    export func flag_attributed_substring(self: id, command: SEL, range: NSRange, actual: *NSRange) -> id:
        return 0 as id

    export func flag_character_index(self: id, command: SEL, at: NSPoint) -> u64:
        return NOT_FOUND

    export func flag_first_rect(self: id, command: SEL, range: NSRange, actual: *NSRange) -> NSRect:
        return NSRect{frame(window(self as *NSView)).origin, CGSize{0.0, 0.0}} # the input method puts its candidates there

    export func flag_do_command(self: id, command: SEL, selector: SEL):
        pass # Enter, Backspace and the arrows already came as KeyDown, and AppKit beeps when nothing answers

    func native(w: Window) -> Native:
        return Native{w.state.window, contentView(w.state.window)}

    priv func pump(s: *State, block: bool):
        pool := init(alloc(NSAutoreleasePool))
        until := dateWithTimeIntervalSinceNow(NSDate, 1.0e9 if block else 0.0)
        while true:
            event := nextEventMatchingMask_untilDate_inMode_dequeue(s.app, NSEventMaskAny, until, NSDefaultRunLoopMode.* as *NSRunLoopMode, true)
            if event as u64 == 0:
                break
            until = dateWithTimeIntervalSinceNow(NSDate, 0.0) # after the first, only what is waiting
            flags := modifierFlags(event)
            switch type(event):
            case NSEventTypeKeyDown:
                append(s.events, KeyDown{key_of(keyCode(event)), isARepeat(event), mods_of(flags)})
            case NSEventTypeKeyUp:
                append(s.events, KeyUp{key_of(keyCode(event)), mods_of(flags)})
            case NSEventTypeFlagsChanged:
                key := key_of(keyCode(event))
                mask: u64 = NSEventModifierFlagCapsLock
                if key == KeyLeftShift or key == KeyRightShift:
                    mask = NSEventModifierFlagShift
                elif key == KeyLeftControl or key == KeyRightControl:
                    mask = NSEventModifierFlagControl
                elif key == KeyLeftAlt or key == KeyRightAlt:
                    mask = NSEventModifierFlagOption
                elif key == KeyLeftSuper or key == KeyRightSuper:
                    mask = NSEventModifierFlagCommand
                if (flags and mask) != 0:
                    append(s.events, KeyDown{key, false, mods_of(flags)})
                else:
                    append(s.events, KeyUp{key, mods_of(flags)})
            case NSEventTypeMouseMoved, NSEventTypeLeftMouseDragged, NSEventTypeRightMouseDragged, NSEventTypeOtherMouseDragged:
                x, y := point(s, event)
                append(s.events, MouseMoved{x, y})
            case NSEventTypeLeftMouseDown, NSEventTypeRightMouseDown, NSEventTypeOtherMouseDown:
                x, y := point(s, event)
                append(s.events, MouseDown{button_of(event), x, y, mods_of(flags)})
            case NSEventTypeLeftMouseUp, NSEventTypeRightMouseUp, NSEventTypeOtherMouseUp:
                x, y := point(s, event)
                append(s.events, MouseUp{button_of(event), x, y, mods_of(flags)})
            case NSEventTypeScrollWheel:
                step := 0.1 if hasPreciseScrollingDeltas(event) else 1.0 # a trackpad gives pixels, a wheel gives lines
                append(s.events, Scrolled{scrollingDeltaX(event) * step, scrollingDeltaY(event) * step})
            sendEvent(s.app, event)
        updateWindows(s.app)
        s.scale = backingScaleFactor(s.window)
        frame := frame(contentView(s.window))
        width := i32(frame.size.width * s.scale)
        height := i32(frame.size.height * s.scale)
        if width != s.width or height != s.height:
            s.width = width
            s.height = height
            append(s.events, Resized{width, height})
        focused := isKeyWindow(s.window)
        if focused != s.focused:
            s.focused = focused
            append(s.events, Focus{focused})
        drain(pool)

    priv func point(s: *State, event: *NSEvent) -> (f64, f64):
        at := locationInWindow(event)
        height := frame(contentView(s.window)).size.height
        return at.x * s.scale, (height - at.y) * s.scale

    priv func button_of(event: *NSEvent) -> Button:
        switch buttonNumber(event):
        case 0:
            return MouseLeft
        case 1:
            return MouseRight
        return MouseMiddle

    priv func mods_of(flags: u64) -> Mods:
        return Mods{(flags and NSEventModifierFlagShift) != 0, (flags and NSEventModifierFlagControl) != 0, (flags and NSEventModifierFlagOption) != 0, (flags and NSEventModifierFlagCommand) != 0}

    KEYCODES: array[Key, 128] = [KeyA, KeyS, KeyD, KeyF, KeyH, KeyG, KeyZ, KeyX, KeyC, KeyV, KeyUnknown, KeyB, KeyQ, KeyW, KeyE, KeyR, KeyY, KeyT, Key1, Key2, Key3, Key4, Key6, Key5, KeyEqual, Key9, Key7, KeyMinus, Key8, Key0, KeyRightBracket, KeyO, KeyU, KeyLeftBracket, KeyI, KeyP, KeyEnter, KeyL, KeyJ, KeyApostrophe, KeyK, KeySemicolon, KeyBackslash, KeyComma, KeySlash, KeyN, KeyM, KeyPeriod, KeyTab, KeySpace, KeyGrave, KeyBackspace, KeyUnknown, KeyEscape, KeyRightSuper, KeyLeftSuper, KeyLeftShift, KeyCapsLock, KeyLeftAlt, KeyLeftControl, KeyRightShift, KeyRightAlt, KeyRightControl, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyEnter, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyF5, KeyF6, KeyF7, KeyF3, KeyF8, KeyF9, KeyUnknown, KeyF11, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyUnknown, KeyF10, KeyMenu, KeyF12, KeyUnknown, KeyUnknown, KeyInsert, KeyHome, KeyPageUp, KeyDelete, KeyF4, KeyEnd, KeyF2, KeyPageDown, KeyF1, KeyArrowLeft, KeyArrowRight, KeyArrowDown, KeyArrowUp, KeyUnknown]

    priv func key_of(code: u16) -> Key:
        if code >= 128:
            return KeyUnknown
        return KEYCODES[code]

    priv func nsstring(text: &strview) -> *NSString:
        return stringWithCString_encoding(NSString, cstr(text), NSUTF8StringEncoding)

    func set_title(w: Window, title: &strview):
        setTitle(w.state.window, nsstring(title))

    func set_size(w: Window, width: i32, height: i32):
        setContentSize(w.state.window, NSSize{f64(width) / w.state.scale, f64(height) / w.state.scale})

    func set_fullscreen(w: Window, on: bool):
        if ((styleMask(w.state.window) and NSWindowStyleMaskFullScreen) != 0) != on:
            toggleFullScreen(w.state.window, 0 as id)

    func set_cursor(w: Window, shape: CursorShape):
        if shape == CursorHidden:
            if not w.state.hidden:
                hide(NSCursor)
                w.state.hidden = true
            return
        if w.state.hidden:
            unhide(NSCursor)
            w.state.hidden = false
        cursor := arrowCursor(NSCursor)
        switch shape:
        case CursorText:
            cursor = IBeamCursor(NSCursor)
        case CursorHand:
            cursor = pointingHandCursor(NSCursor)
        case CursorCrosshair:
            cursor = crosshairCursor(NSCursor)
        case CursorResizeH:
            cursor = resizeLeftRightCursor(NSCursor)
        case CursorResizeV:
            cursor = resizeUpDownCursor(NSCursor)
        case CursorResizeAll:
            cursor = closedHandCursor(NSCursor)
        case CursorNotAllowed:
            cursor = operationNotAllowedCursor(NSCursor)
        case:
            pass
        set(cursor)

    func clipboard(w: Window) -> &str:
        pool := init(alloc(NSAutoreleasePool))
        text: &str = heap("")
        found := stringForType(generalPasteboard(NSPasteboard), NSPasteboardTypeString.*)
        if found as u64 != 0:
            text += view(UTF8String(found))
        drain(pool)
        return text

    func set_clipboard(w: Window, text: &strview):
        pool := init(alloc(NSAutoreleasePool))
        board := generalPasteboard(NSPasteboard)
        _ = clearContents(board)
        _ = setString_forType(board, nsstring(text), NSPasteboardTypeString.*)
        drain(pool)
