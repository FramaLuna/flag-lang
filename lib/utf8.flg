module utf8

func code(s: &strview) -> u32|null:
    for c in s:
        b := items(c)
        if b[0] < 0x80:
            return u32(b[0])
        if c.len == 1:
            return null
        code := u32(b[0]) and (u32(0x7f) >> u32(c.len))
        for k in 1..c.len:
            code = (code << 6) or u32(b[k] and 0x3f)
        return code
    return null

func count(s: &strview) -> usize:
    n: usize = 0
    for c in s:
        n += 1
    return n

func valid(s: &strview) -> bool:
    for c in s:
        if c.len == 1 and items(c)[0] >= 0x80:
            return false
    return true
