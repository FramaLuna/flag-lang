module net

priv extern "c":
    func socket(family: i32, kind: i32, protocol: i32) -> i32
    func connect(fd: i64, address: *bytes, size: u32) -> i32
    func bind(fd: i64, address: *bytes, size: u32) -> i32
    func listen(fd: i64, backlog: i32) -> i32
    func accept(fd: i64, address: *bytes, size: *u32) -> i32
    func accept4(fd: i64, address: *bytes, size: *u32, flags: i32) -> i32
    func getsockname(fd: i64, address: *bytes, size: *u32) -> i32
    func setsockopt(fd: i64, level: i32, name: i32, value: *bytes, size: u32) -> i32
    func getaddrinfo(host: cstr, service: cstr, hints: *bytes, found: **bytes) -> i32
    func freeaddrinfo(found: *bytes)
    func sendto(fd: i64, data: *bytes, size: i64, flags: i32, address: *bytes, address_size: u32) -> i32
    func recvfrom(fd: i64, into: *bytes, size: i64, flags: i32, address: *bytes, address_size: *u32) -> i32
    func inet_ntop(family: i32, address: *bytes, into: *u8, size: i64) -> cstr
    func fcntl(fd: i64, command: i32, ...) -> i32
    func close(fd: i64) -> i32
    func shutdown(fd: i64, how: i32) -> i32
    func SetHandleInformation(handle: i64, mask: u32, flags: u32) -> i32

priv extern "ws2_32" where @windows():
    func WSAStartup(version: u16, into: *bytes) -> i32
    func WSAGetLastError() -> i32
    func WSAIoctl(fd: i64, code: u32, given: *bytes, given_size: u32, into: *bytes, into_size: u32, returned: *u32, overlapped: *bytes, done: *bytes) -> i32
    func closesocket(fd: i64) -> i32

type Socket:
    fd: i32
    peer: Address # who is on the other side

type Server:
    fd: i32

type Udp:
    fd: i32

type Address:
    ip: array[u8, 16] # IPv6, and an IPv4 address as ::ffff:a.b.c.d
    port: u16

type error NetError:
    code: i32
    action: &strview
    address: &strview

operator +=(s: *&str, e: NetError):
    s.* += FsError{e.code, e.action, e.address} # a connection fails in the words of a file

func connect(host: &strview, port: u16) -> Socket|NetError:
    return opened(host, port, false)

func listen(port: u16, host: &strview = "0.0.0.0") -> Server|NetError:
    s := try opened(host, port, true)
    return Server{s.fd}

# a socket on the first address of the host that takes it, connected to it or listening on it
priv func opened(host: &strview, port: u16, listening: bool) -> Socket|NetError:
    start()
    action: &strview = "listen on" if listening else "connect to"
    hints: array[i32, 12]
    hints[2] = 1 # SOCK_STREAM
    found: *bytes
    code: i32 = 0
    with scratch():
        code = getaddrinfo(cstr(host), cstr("" + port), ptr(hints) as *bytes, ptr(found))
    if code != 0:
        if code > 0:
            code = 0 - code # getaddrinfo's codes go negative, apart from errno
        return NetError{code, action, host + ":" + port}
    failed: NetError
    entry := found
    while entry as u64 != 0:
        fields := entry as *array[i32, 4]
        fd := i64(socket(fields.*[1], sealed(fields.*[2]), fields.*[3]))
        raw := ((entry + ADDRESS_IN_INFO) as **bytes).*
        size := ((entry + 16) as *u32).*
        if fd >= 0:
            prepare(fd)
        if fd >= 0 and (bind(fd, raw, size) == 0 and listen(fd, 64) == 0 if listening else connect(fd, raw, size) == 0):
            made := Socket{i32(fd), address(raw)} # before freeaddrinfo, which frees what raw points to
            freeaddrinfo(found)
            return made
        failed = NetError{failure(), action, host + ":" + port}
        if fd >= 0:
            dispose(fd)
        entry = ((entry + 40) as **bytes).*
    freeaddrinfo(found)
    return failed

func accept(server: Server) -> Socket|NetError:
    flush() # what you wrote goes out before the program waits for a connection
    raw: array[u8, 28]
    size: u32 = 28
    fd := i64(accept4(i64(server.fd), ptr(raw) as *bytes, ptr(size), 0x80000) if @linux() else accept(i64(server.fd), ptr(raw) as *bytes, ptr(size))) # SOCK_CLOEXEC, see sealed
    if fd < 0:
        return NetError{failure(), "accept a connection", ""}
    prepare(fd)
    return Socket{i32(fd), address(ptr(raw) as *bytes)}

func port(s: $T) -> u16 where $T is Server|Udp:
    address: array[u8, 128]
    size: u32 = 128
    getsockname(i64(s.fd), ptr(address) as *bytes, ptr(size))
    return u16(address[2]) << 8 or u16(address[3])

func close(s: $T) where $T is Server|Udp:
    dispose(i64(s.fd))

operator with(s: $T) where $T is Server|Udp:
    close(s)

func udp(port: u16) -> Udp|NetError:
    start()
    fd := open_udp()
    raw := socket_address(Address{port = port})
    if fd < 0 or bind(fd, ptr(raw) as *bytes, 28) != 0:
        failed := NetError{failure(), "open the UDP port", "" + port}
        if fd >= 0:
            dispose(fd)
        return failed
    return Udp{i32(fd)}

func address(host: &strview, port: u16) -> Address|NetError:
    start()
    hints: array[i32, 12]
    hints[2] = 2 # SOCK_DGRAM, so each address comes once
    found: *bytes
    code: i32 = 0
    with scratch():
        code = getaddrinfo(cstr(host), 0 as cstr, ptr(hints) as *bytes, ptr(found))
    if code != 0:
        if code > 0:
            code = 0 - code
        return NetError{code, "find", host}
    out := address(((found + ADDRESS_IN_INFO) as **bytes).*)
    out.port = port
    freeaddrinfo(found)
    return out

# a struct sockaddr_in or sockaddr_in6, where macOS puts its length before the family
priv func address(raw: *bytes) -> Address:
    bytes := raw as *array[u8, 24] # read in place, a sockaddr_in has only 16
    out := Address{port = u16(bytes.*[2]) << 8 or u16(bytes.*[3])}
    if bytes.*[1 if @macos() else 0] == 2: # AF_INET
        out.ip[10] = 255
        out.ip[11] = 255
        for i in 0..4:
            out.ip[12 + i] = bytes.*[4 + i]
    else:
        for i in 0..16:
            out.ip[i] = bytes.*[8 + i]
    return out

func send(u: Udp, to: Address, data: &strview) -> NetError?:
    raw := socket_address(to)
    if sendto(i64(u.fd), ptr(data.*), data.len, 0, ptr(raw) as *bytes, 28) < 0:
        return NetError{failure(), "send to", "" + to}
    return null

func receive(u: Udp, into: *&str) -> Address|NetError:
    flush() # what you wrote goes out before the program waits for an answer
    reserve(into, into.len + 65536)
    raw: array[u8, 28]
    size: u32 = 28
    got := recvfrom(i64(u.fd), ptr(into.*.*) + into.len, 65536, 0, ptr(raw) as *bytes, ptr(size))
    if got < 0:
        return NetError{failure(), "receive", ""}
    into.len += got
    return address(ptr(raw) as *bytes)

operator +=(s: *&str, a: Address):
    mapped := a.ip[10] == 255 and a.ip[11] == 255
    for b in a.ip[:10]:
        mapped = mapped and b == 0
    text: array[u8, 64]
    if mapped:
        inet_ntop(2, ptr(a.ip[12]) as *bytes, ptr(text) as *u8, 64)
        s.* += view(ptr(text) as cstr) + ":" + a.port
    else:
        inet_ntop(FAMILY6, ptr(a.ip) as *bytes, ptr(text) as *u8, 64)
        s.* += "[" + view(ptr(text) as cstr) + "]:" + a.port

func ready(waiting: &listview[$T], seconds: f64 = 0.0) -> &listview[i64] where @can_assign(Socket|Server|Udp, $T):
    files: &list[File] = heap([])
    defer free(files)
    for x in waiting:
        one: Socket|Server|Udp = x
        switch one:
        case Socket:
            append(files, file(one))
        case Server:
            append(files, file(one))
        case Udp:
            append(files, file(one))
    return ready(files, seconds)

func ready(x: $T, seconds: f64 = 0.0) -> bool where @can_assign(Socket|Server|Udp, $T):
    with scratch():
        return ready(ptr([x]), seconds).len > 0

func write(s: Socket, value: $T, place: &strview = @here()):
    write(file(s), value, place)

func read(s: Socket, into: *&str, size: i64, place: &strview = @here()) -> i64|NetError:
    got := read(file(s), into, size, place)
    if got is FsError:
        return NetError{got.code, got.action, got.path}
    return got

func read_line(s: Socket, place: &strview = @here()) -> &strview|null|NetError:
    line := read_line(file(s), place)
    if line is FsError:
        return NetError{line.code, line.action, line.path}
    return line

func flush(s: Socket, place: &strview = @here()) -> NetError?:
    failed := flush(file(s), place)
    if failed is FsError:
        return NetError{failed.code, failed.action, failed.path}
    return null

func close(s: Socket, place: &strview = @here()):
    _ = flush(s)
    shutdown(i64(s.fd), 2) # both ways: a read that another thread waits in ends, and lets close take the socket
    close(file(s), place)

operator with(s: Socket, place: &strview = @here()):
    close(s, place)

priv func file(s: $T) -> File where $T is Socket|Server|Udp:
    return File{8192 + s.fd if @windows() else s.fd} # core reads a File past the 8192 descriptors of the C runtime of Windows as a socket

func timeout(s: $T, seconds: f64) where $T is Socket|Udp and @linux():
    limit := timeval(seconds)
    setsockopt(i64(s.fd), 1, 20, ptr(limit) as *bytes, 16)
    setsockopt(i64(s.fd), 1, 21, ptr(limit) as *bytes, 16)

func timeout(s: $T, seconds: f64) where $T is Socket|Udp and @macos():
    limit := timeval(seconds)
    setsockopt(i64(s.fd), 65535, 0x1006, ptr(limit) as *bytes, 16)
    setsockopt(i64(s.fd), 65535, 0x1005, ptr(limit) as *bytes, 16)

func timeout(s: $T, seconds: f64) where $T is Socket|Udp and @windows():
    limit: u32 = 0
    if seconds > 0.0:
        limit = u32(seconds * 1000.0) + 1 # in milliseconds, rounded up so it is never 0, forever
    setsockopt(i64(s.fd), 65535, 0x1006, ptr(limit) as *bytes, 4)
    setsockopt(i64(s.fd), 65535, 0x1005, ptr(limit) as *bytes, 4)

priv func timeval(seconds: f64) -> array[i64, 2]:
    micros := 0
    if seconds > 0.0:
        micros = i64(seconds * 1000000.0) + 1 # rounded up so it is never 0, forever
    return [micros / 1000000, micros % 1000000]

priv func start() where not @windows():
    return

priv func start() where @windows():
    data: array[u8, 408]
    WSAStartup(514, ptr(data) as *bytes)

# close on exec from the start, so a program that another thread starts on Linux doesn't take it
priv func sealed(kind: i32) -> i32:
    return kind or 0x80000 if @linux() else kind # SOCK_CLOEXEC

priv func prepare(fd: i64) where @linux():
    yes: i32 = 1
    setsockopt(fd, 1, 2, ptr(yes) as *bytes, 4) # SO_REUSEADDR
    setsockopt(fd, 6, 1, ptr(yes) as *bytes, 4) # TCP_NODELAY, what you flush goes at once

priv func prepare(fd: i64) where @macos():
    yes: i32 = 1
    fcntl(fd, 2, 1) # close on exec
    setsockopt(fd, 65535, 4, ptr(yes) as *bytes, 4) # SO_REUSEADDR
    setsockopt(fd, 65535, 0x1022, ptr(yes) as *bytes, 4) # SO_NOSIGPIPE, a closed peer is an error and not a signal
    setsockopt(fd, 6, 1, ptr(yes) as *bytes, 4) # TCP_NODELAY

priv func prepare(fd: i64) where @windows():
    yes: i32 = 1
    SetHandleInformation(fd, 1, 0) # not inherited by the programs you run
    setsockopt(fd, 6, 1, ptr(yes) as *bytes, 4) # TCP_NODELAY

priv func failure() -> i32 where not @windows():
    code := errno()
    if code == 11 or code == 35: # EAGAIN on Linux and on macOS, what a socket gives when its timeout runs out
        return TIMED_OUT
    return code

priv func failure() -> i32 where @windows():
    return 0 - WSAGetLastError()

priv func dispose(fd: i64) where not @windows():
    close(fd)

priv func dispose(fd: i64) where @windows():
    closesocket(fd)

priv func open_udp() -> i64 where @linux():
    fd := i64(socket(10, 0x80002, 0)) # AF_INET6, and SOCK_DGRAM with SOCK_CLOEXEC
    if fd < 0:
        return fd # with its errno
    no: i32 = 0
    setsockopt(fd, 41, 26, ptr(no) as *bytes, 4) # IPV6_V6ONLY off, so it takes IPv4 too
    return fd

priv func open_udp() -> i64 where @macos():
    fd := i64(socket(30, 2, 0))
    if fd < 0:
        return fd
    no: i32 = 0
    fcntl(fd, 2, 1)
    setsockopt(fd, 41, 27, ptr(no) as *bytes, 4)
    return fd

priv func open_udp() -> i64 where @windows():
    fd := i64(socket(23, 2, 0))
    if fd < 0:
        return fd
    no: i32 = 0
    got: u32 = 0
    SetHandleInformation(fd, 1, 0)
    setsockopt(fd, 41, 27, ptr(no) as *bytes, 4)
    WSAIoctl(fd, 0x9800_000c, ptr(no) as *bytes, 4, 0 as *bytes, 0, ptr(got), 0 as *bytes, 0 as *bytes) # SIO_UDP_CONNRESET off: an old ICMP port unreachable would fail the next receive
    return fd

priv FAMILY6 = 23 if @windows() else 30 if @macos() else 10

priv func socket_address(a: Address) -> array[u8, 28] where not @macos():
    out: array[u8, 28] # a struct sockaddr_in6
    out[0] = FAMILY6
    out[2] = u8(a.port >> 8)
    out[3] = u8(a.port and 255)
    for i in 0..16:
        out[8 + i] = a.ip[i]
    return out

priv func socket_address(a: Address) -> array[u8, 28] where @macos():
    out: array[u8, 28]
    out[0] = 28 # sin6_len
    out[1] = FAMILY6
    out[2] = u8(a.port >> 8)
    out[3] = u8(a.port and 255)
    for i in 0..16:
        out[8 + i] = a.ip[i]
    return out

priv ADDRESS_IN_INFO = 24 if @linux() else 32
