extern "c":
    func malloc(size: usize) -> *bytes
    func calloc(count: usize, size: usize) -> *bytes
    func realloc(at: *bytes, size: usize) -> *bytes
    func free(at: *bytes)
    func memcpy(to: *bytes, from: *bytes, size: usize) -> *bytes
    func memmove(to: *bytes, from: *bytes, size: usize) -> *bytes
    func memcmp(a: *bytes, b: *bytes, size: usize) -> i32
    func memchr(at: *bytes, byte: i32, size: usize) -> *bytes
    func strlen(s: cstr) -> usize
    func exit(code: i32)
    func snprintf(into: *u8, size: usize, format: cstr, ...) -> i32
    func strtod(text: cstr, end: *bytes) -> f64

priv extern "c":
    func read(fd: i32, at: *bytes, size: usize) -> i32
    func write(fd: i32, at: *bytes, size: usize) -> i32
    func open(path: cstr, flags: i32, ...) -> i32
    func close(fd: i32) -> i32
    func isatty(fd: i32) -> i32
    func poll(fds: *bytes, count: u64, wait: i32) -> i32
    func send(fd: i64, at: *bytes, size: usize, flags: i32) -> i32
    func recv(fd: i64, at: *bytes, size: usize, flags: i32) -> i32
    func getsockname(fd: i64, address: *bytes, size: *u32) -> i32
    func atexit(callback: *bytes) -> i32
    func _exit(code: i32)
    func strerror(code: i32) -> cstr
    func gai_strerror(code: i32) -> cstr
    func __errno_location() -> *i32
    func __error() -> *i32
    func _errno() -> *i32
    func FormatMessageA(flags: u32, source: *bytes, code: u32, language: u32, into: *u8, size: u32, arguments: *bytes) -> u32

priv extern "ws2_32" where @windows():
    func WSAGetLastError() -> i32
    func closesocket(fd: i64) -> i32

type Integer = i8|i16|i32|i64|u8|u16|u32|u64|usize

func heap(v: $T) -> *$T:
    p := malloc(sizeof($T)) as *$T
    if p as usize == 0:
        out_of_memory()
    p.* = v
    return p

func free(p: *$T):
    free(p as *bytes)

func panic(message: &strview, place: &strview = @here()):
    eprint("flag: ", message)
    eprint("  --> ", place)
    exit(134)

func assert(condition: bool, message: &strview = "assertion failed", place: &strview = @here()):
    if not condition:
        panic(message, place)

type cstr = *u8

func cstr(text: &strview) -> cstr:
    return ptr(temp(text).*) as *u8

func out_of_memory():
    message: &strview = "flag: out of memory\n"
    write(2, ptr(message.*), message.len)
    exit(9)

func out_of_bounds(i: $I, len: usize, place: &strview = @here()) where $I is Integer:
    panic("index " + i + " is out of bounds, length " + len, place)

func out_of_bounds(from: $I, to: $I, len: usize, place: &strview = @here()) where $I is Integer:
    panic("slice " + from + ":" + to + " is out of bounds, length " + len, place)

func natural(i: $I, len: usize) -> usize where $I is Integer:
    if i < 0:
        return len + usize(i) # wraps into the length, or stays past it
    return usize(i)

type fatptr slice[$T]:
    len: usize

func slice(s: &slice[$T], from: $I, to: $I, place: &strview = @here()) -> &slice[$T] where $I is Integer:
    first := natural(from, s.len)
    last := natural(to, s.len)
    if first > last or last > s.len:
        out_of_bounds(from, to, s.len, place)
    out: &slice[$T]
    out = (ptr(s.*) as usize + first * sizeof($T)) as *bytes
    out.len = last - first
    return out

priv type Walk[$T]:
    base: *bytes
    len: usize
    i: usize

func next(w: *Walk[$T]) -> $T|IterationEnd:
    if w.i >= w.len:
        return IterationEnd
    p := (w.base as usize + w.i * sizeof($T)) as *$T
    w.i += 1
    return p.*

operator +(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer|f32|f64:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] + b[i]
    return out

operator -(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer|f32|f64:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] - b[i]
    return out

operator *(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer|f32|f64:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] * b[i]
    return out

operator /(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is f32|f64:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] / b[i]
    return out

operator /(a: *array[$T, $$n], b: *array[$T, $$n], place: &strview = @here()) -> array[$T, $$n] where $T is Integer:
    out: array[$T, $$n]
    for i in 0..$$n:
        if b[i] == 0:
            panic("division by zero", place)
        out[i] = a[i] / b[i]
    return out

operator %(a: *array[$T, $$n], b: *array[$T, $$n], place: &strview = @here()) -> array[$T, $$n] where $T is Integer:
    out: array[$T, $$n]
    for i in 0..$$n:
        if b[i] == 0:
            panic("division by zero", place)
        out[i] = a[i] % b[i]
    return out

operator and(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] and b[i]
    return out

operator or(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] or b[i]
    return out

operator xor(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] xor b[i]
    return out

operator <<(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] << b[i]
    return out

operator >>(a: *array[$T, $$n], b: *array[$T, $$n]) -> array[$T, $$n] where $T is Integer:
    out: array[$T, $$n]
    for i in 0..$$n:
        out[i] = a[i] >> b[i]
    return out

operator ==(a: *array[$T, $$n], b: *array[$T, $$n]) -> bool:
    for i in 0..$$n:
        if a[i] != b[i]:
            return false
    return true

type fatptr list[$T]:
    len: usize
    cap: usize

func reserve(l: *&list[$T], want: usize):
    if want <= l.cap:
        return
    cap := l.cap * 2
    if cap < want:
        cap = want
    if cap < 8:
        cap = 8
    grown := realloc(ptr(l.*.*), cap * sizeof($T))
    if grown as usize == 0 and sizeof($T) > 0:
        out_of_memory()
    l.* = grown
    l.cap = cap

func append(l: *&list[$T], v: $T):
    if l.len == l.cap:
        reserve(l, l.len + 1)
    p := (ptr(l.*.*) as usize + l.len * sizeof($T)) as *$T
    p.* = v
    l.len += 1

func append(l: *&list[$T], items: &slice[$T]):
    if ptr(items.*) as usize - ptr(l.*.*) as usize < l.cap * sizeof($T):
        with scratch():
            append(l, temp(items))
        return
    reserve(l, l.len + items.len)
    memcpy((ptr(l.*.*) as usize + l.len * sizeof($T)) as *bytes, ptr(items.*), items.len * sizeof($T))
    l.len += items.len

func pop(l: *&list[$T]) -> $T|null:
    if l.len == 0:
        return null
    l.len -= 1
    p := (ptr(l.*.*) as usize + l.len * sizeof($T)) as *$T
    return p.*

func insert(l: *&list[$T], at: $I, v: $T, place: &strview = @here()) where $I is Integer:
    n := natural(at, l.len)
    if n > l.len:
        out_of_bounds(at, l.len, place)
    append(l, v)
    first := (ptr(l.*.*) as usize + n * sizeof($T)) as *bytes
    memmove((first as usize + sizeof($T)) as *bytes, first, (l.len - 1 - n) * sizeof($T))
    l[n] = v

func remove(l: *&list[$T], at: $I, place: &strview = @here()) -> $T where $I is Integer:
    n := natural(at, l.len)
    if n >= l.len:
        out_of_bounds(at, l.len, place)
    kept := l[n]
    first := (ptr(l.*.*) as usize + n * sizeof($T)) as *bytes
    memmove(first, (first as usize + sizeof($T)) as *bytes, (l.len - 1 - n) * sizeof($T))
    l.len -= 1
    return kept

func find(items: &slice[$T], v: $T) -> usize|null:
    for i in 0..items.len:
        if items[i] == v:
            return i
    return null

func find(items: &slice[$T], fits: func($T) -> bool) -> usize|null:
    for i in 0..items.len:
        if fits(items[i]):
            return i
    return null

func contains(items: &slice[$T], v: $T) -> bool:
    return find(items, v) is usize

func binary_search(items: &slice[$T], v: $T) -> usize|null:
    low: usize = 0
    high := items.len
    while low < high:
        middle := (low + high) / 2
        if items[middle] < v:
            low = middle + 1
        elif v < items[middle]:
            high = middle
        else:
            return middle
    return null

operator ==(a: &slice[$T], b: &slice[$T]) -> bool:
    if a.len != b.len:
        return false
    for i in 0..a.len:
        if a[i] != b[i]:
            return false
    return true

func reverse(items: &slice[$T]):
    for i in 0..items.len / 2:
        swap(items, i, items.len - 1 - i)

func clear(l: *&list[$T]):
    l.len = 0

func free(l: *&list[$T]):
    free(ptr(l.*.*))
    l.* = usize(0) as *bytes
    l.len = 0
    l.cap = 0

func sort(s: &slice[$T]):
    before: func($T, $T) -> bool = less
    sort(s, before)

priv func less(a: $T, b: $T) -> bool:
    return a < b

func sort(s: &slice[$T], before: func($T, $T) -> bool):
    if s.len < 2:
        return
    spare: &slice[$T]
    spare = malloc(s.len / 2 * sizeof($T))
    if ptr(spare.*) as usize == 0:
        out_of_memory()
    spare.len = s.len / 2
    merge_sort(s, spare, before)
    free(ptr(spare.*))

priv func merge_sort(s: &slice[$T], spare: &slice[$T], before: func($T, $T) -> bool):
    if s.len <= 16:
        for i in 1..s.len:
            v := s[i]
            j := i
            while j > 0 and before(v, s[j - 1]):
                s[j] = s[j - 1]
                j -= 1
            s[j] = v
        return
    half := s.len / 2
    merge_sort(s[:half], spare, before)
    merge_sort(s[half:], spare, before)
    if not before(s[half], s[half - 1]):
        return
    memcpy(ptr(spare.*), ptr(s.*), half * sizeof($T))
    i: usize = 0
    j := half
    k: usize = 0
    while i < half:
        if j < s.len and before(s[j], spare[i]):
            s[k] = s[j]
            j += 1
        else:
            s[k] = spare[i]
            i += 1
        k += 1

func swap(s: &slice[$T], i: $I, j: $I, place: &strview = @here()) where $I is Integer:
    a := natural(i, s.len)
    b := natural(j, s.len)
    if a >= s.len:
        out_of_bounds(i, s.len, place)
    if b >= s.len:
        out_of_bounds(j, s.len, place)
    kept := s[a]
    s[a] = s[b]
    s[b] = kept

type fatptr strview:
    len: usize

type fatptr str:
    len: usize
    cap: usize

func view(s: &str) -> &strview:
    v: &strview
    v = ptr(s.*)
    v.len = s.len
    return v

func view(c: cstr) -> &strview:
    out: &strview
    if c as usize != 0:
        out = c
        out.len = strlen(c)
    return out

func view(bytes: &slice[u8]) -> &strview:
    out: &strview
    out = ptr(bytes.*)
    out.len = bytes.len
    return out

func items(s: &strview) -> &slice[u8]:
    out: &slice[u8]
    out = ptr(s.*)
    out.len = s.len
    return out

func slice(v: &strview, from: $I, to: $I, place: &strview = @here()) -> &strview where $I is Integer:
    first := natural(from, v.len)
    last := natural(to, v.len)
    if first > last or last > v.len:
        out_of_bounds(from, to, v.len, place)
    out: &strview
    out = (ptr(v.*) as usize + first) as *bytes
    out.len = last - first
    return out

func reserve(s: *&str, want: usize):
    if want <= s.cap:
        return
    cap := s.cap * 2
    if cap < want:
        cap = want
    if cap < 32:
        cap = 32
    grown := realloc(ptr(s.*.*), cap)
    if grown as usize == 0:
        out_of_memory()
    s.* = grown
    s.cap = cap

type Scratch:
    count: usize
    used: usize

priv context scratch_space:
    blocks: &list[&strview]
    count: usize
    used: usize

func scratch() -> Scratch:
    return Scratch{scratch_space.count, scratch_space.used}

func close(s: Scratch):
    scratch_space.count = s.count
    scratch_space.used = s.used

func temp(size: usize) -> *bytes:
    need := (size + 7) / 8 * 8
    if scratch_space.count == 0 or scratch_space.used + need > scratch_space.blocks[scratch_space.count - 1].len:
        if scratch_space.count == scratch_space.blocks.len or scratch_space.blocks[scratch_space.count].len < need:
            room: usize = 65536
            if room < need:
                room = need
            block: &strview
            block = malloc(room)
            if ptr(block.*) as usize == 0:
                out_of_memory()
            block.len = room
            insert(scratch_space.blocks, scratch_space.count, block)
        scratch_space.count += 1
        scratch_space.used = 0
    out := (ptr(scratch_space.blocks[scratch_space.count - 1].*) as usize + scratch_space.used) as *bytes
    scratch_space.used += need
    return out

func temp(text: &strview) -> &strview:
    at := temp(text.len + 1)
    memcpy(at, ptr(text.*), text.len)
    ((at as usize + text.len) as *u8).* = 0
    out: &strview
    out = at
    out.len = text.len
    return out

func temp(items: &slice[$T]) -> &slice[$T]:
    out: &slice[$T]
    out = temp(items.len * sizeof($T))
    out.len = items.len
    memcpy(ptr(out.*), ptr(items.*), items.len * sizeof($T))
    return out

operator +=(s: *&str, v: &strview):
    inside := ptr(v.*) as usize - ptr(s.*.*) as usize < s.cap
    if inside:
        with scratch():
            s.* += temp(v)
        return
    reserve(s, s.len + v.len)
    memcpy((ptr(s.*.*) as usize + s.len) as *bytes, ptr(v.*), v.len)
    s.len += v.len

func c_text(s: &str) -> cstr:
    if s.cap <= s.len:
        return cstr(view(s))
    last := (ptr(s.*) as usize + s.len) as *u8
    last.* = 0
    return ptr(s.*) as *u8

operator =(s: *&str, v: &strview) -> &str:
    s.len = 0
    s.* += v
    return s.*

func free(s: *&str):
    free(ptr(s.*.*))
    s.* = usize(0) as *bytes
    s.len = 0
    s.cap = 0

operator ==(a: &strview, b: &strview) -> bool:
    if a.len != b.len:
        return false
    if a.len == 0:
        return true
    return memcmp(ptr(a.*), ptr(b.*), a.len) == 0

operator <(a: &strview, b: &strview) -> bool:
    shorter := a.len
    if b.len < shorter:
        shorter = b.len
    order: i32 = 0
    if shorter > 0:
        order = memcmp(ptr(a.*), ptr(b.*), shorter)
    return order < 0 or order == 0 and a.len < b.len

func add_byte(s: *&str, b: u8):
    reserve(s, s.len + 1)
    ((ptr(s.*.*) as usize + s.len) as *u8).* = b
    s.len += 1

func add_char(s: *&str, code: u32):
    if code < 0x80:
        add_byte(s, u8(code))
    elif code < 0x800:
        add_byte(s, u8(0xC0 or code >> 6))
        add_byte(s, u8(0x80 or code and 0x3F))
    elif code < 0x10000:
        add_byte(s, u8(0xE0 or code >> 12))
        add_byte(s, u8(0x80 or (code >> 6) and 0x3F))
        add_byte(s, u8(0x80 or code and 0x3F))
    else:
        add_byte(s, u8(0xF0 or code >> 18))
        add_byte(s, u8(0x80 or (code >> 12) and 0x3F))
        add_byte(s, u8(0x80 or (code >> 6) and 0x3F))
        add_byte(s, u8(0x80 or code and 0x3F))

func parse_hex(s: &strview) -> u64|null:
    if s.len == 0 or s.len > 16:
        return null
    n: u64 = 0
    for b in items(s):
        digit: u64 = 16
        if b >= '0' and b <= '9':
            digit = u64(b - '0')
        elif b >= 'a' and b <= 'f':
            digit = u64(b - 'a') + 10
        elif b >= 'A' and b <= 'F':
            digit = u64(b - 'A') + 10
        if digit == 16:
            return null
        n = n * 16 + digit
    return n

func find(s: &strview, part: &strview) -> usize|null: @trust
    if part.len == 0:
        return 0
    first := i32(part[0])
    at: usize = 0
    while at + part.len <= s.len:
        hit := memchr((ptr(s.*) as usize + at) as *bytes, first, s.len - part.len + 1 - at)
        if hit as usize == 0:
            return null
        at = hit as usize - ptr(s.*) as usize
        if memcmp(hit, ptr(part.*), part.len) == 0:
            return at
        at += 1
    return null

func find_last(s: &strview, part: &strview) -> usize|null:
    if part.len > s.len:
        return null
    for i in reverse 0..s.len - part.len + 1:
        if s[i:i + part.len] == part:
            return i
    return null

func contains(s: &strview, part: &strview) -> bool:
    return find(s, part) is usize

func replace(s: &strview, old: &strview, new: &strview) -> &strview:
    out: &str
    defer free(out)
    rest := s
    cut := find(rest, old)
    while cut is usize and old.len > 0:
        out += rest[:cut]
        out += new
        rest = rest[cut + old.len:]
        cut = find(rest, old)
    out += rest
    return temp(out)

func join(parts: &slice[$T], separator: &strview) -> &strview:
    out: &str
    defer free(out)
    for i, part in parts:
        if i > 0:
            out += separator
        out += part
    return temp(out)

func lower(s: &strview) -> &strview:
    out := temp(s)
    bytes := items(out)
    for i in 0..bytes.len:
        if bytes[i] >= 'A' and bytes[i] <= 'Z':
            bytes[i] += 32
    return out

func upper(s: &strview) -> &strview:
    out := temp(s)
    bytes := items(out)
    for i in 0..bytes.len:
        if bytes[i] >= 'a' and bytes[i] <= 'z':
            bytes[i] -= 32
    return out

func starts_with(s: &strview, head: &strview) -> bool:
    return s.len >= head.len and s[:head.len] == head

func ends_with(s: &strview, tail: &strview) -> bool:
    return s.len >= tail.len and s[s.len - tail.len:] == tail

func trim(s: &strview) -> &strview:
    return trim_end(trim_start(s))

func trim_start(s: &strview) -> &strview:
    bytes := items(s)
    first: usize = 0
    while first < bytes.len and blank(bytes[first]):
        first += 1
    return s[first:]

func trim_end(s: &strview) -> &strview:
    bytes := items(s)
    last := bytes.len
    while last > 0 and blank(bytes[last - 1]):
        last -= 1
    return s[:last]

priv func blank(b: u8) -> bool:
    return b == ' ' or b == '\t' or b == '\n' or b == '\r'

func split(s: &strview, separator: &strview) -> &slice[&strview]:
    count: usize = 1
    rest := s
    cut := find(rest, separator)
    while cut is usize and separator.len > 0:
        count += 1
        rest = rest[cut + separator.len:]
        cut = find(rest, separator)
    parts: &slice[&strview]
    parts = temp(count * sizeof(&strview))
    parts.len = count
    rest = s
    for k in 0..count - 1:
        at := trust find(rest, separator)
        parts[k] = rest[:at]
        rest = rest[at + separator.len:]
    parts[count - 1] = rest
    return parts

func parse_int(s: &strview) -> i64|null:
    b := items(s)
    negative := s.len > 0 and b[0] == '-'
    i: usize = 0
    if negative or s.len > 0 and b[0] == '+':
        i = 1
    if i == s.len:
        return null
    limit: u64 = 0x7fff_ffff_ffff_ffff
    if negative:
        limit += 1
    n: u64 = 0
    while i < s.len:
        if b[i] < '0' or b[i] > '9':
            return null
        digit := u64(b[i] - '0')
        if n > (limit - digit) / 10:
            return null
        n = n * 10 + digit
        i += 1
    if negative:
        return 0 - i64(n)
    return i64(n)

func parse_float(s: &strview) -> f64|null:
    if s.len == 0 or s[0] <= ' ':
        return null
    with scratch():
        text := cstr(s)
        end := text
        x := strtod(text, ptr(end) as *bytes)
        if end as usize == text as usize + s.len:
            return x
    return null

operator +=(s: *&str, n: usize):
    digits: array[u8, 20]
    i: usize = 20
    v := n
    while true:
        i -= 1
        digits[i] = u8(v % 10) + '0'
        v = v / 10
        if v == 0:
            break
    out: &strview
    out = (ptr(digits) as usize + i) as *bytes
    out.len = 20 - i
    s.* += out

operator +=(s: *&str, n: i64):
    if n < 0:
        s.* += "-" + usize(0 - n)
    else:
        s.* += usize(n)

operator +=(s: *&str, n: i32):
    s.* += i64(n)

operator +=(s: *&str, n: i16):
    s.* += i64(n)

operator +=(s: *&str, n: i8):
    s.* += i64(n)

operator +=(s: *&str, n: u64):
    s.* += usize(n)

operator +=(s: *&str, n: u32):
    s.* += usize(n)

operator +=(s: *&str, n: u16):
    s.* += usize(n)

operator +=(s: *&str, n: u8):
    s.* += usize(n)

operator +=(s: *&str, b: bool):
    if b:
        s.* += "true"
    else:
        s.* += "false"

operator +=(s: *&str, f: f64):
    float_text(s, f, false)

operator +=(s: *&str, f: f32):
    float_text(s, f64(f), true)

priv func float_text(s: *&str, f: f64, single: bool):
    if f - f != 0.0:
        name: &strview = "nan"
        if f > 0.0:
            name = "inf"
        elif f < 0.0:
            name = "-inf"
        s.* += name
        return
    digits: i32 = 15
    most: i32 = 17
    smallest := 2.2250738585072014e-308
    if single:
        digits = 6
        most = 9
        smallest = 1.1754943508222875e-38
    if f < smallest and f > 0.0 - smallest:
        digits = 1 # a subnormal number holds fewer digits
    # up to 15 digits (6 for f32) the shortest that reads back is the rounding with the zeros at the end cut
    buf: array[u8, 32]
    at := ptr(buf) as *u8
    out: &strview
    out = ptr(buf) as *bytes
    out.len = usize(snprintf(at, 32, "%#.*e", digits - 1, f))
    while digits < most:
        back := strtod(at, usize(0) as *bytes)
        if back == f or single and f32(back) == f32(f):
            break
        digits += 1
        out.len = usize(snprintf(at, 32, "%#.*e", digits - 1, f))
    lead := usize(buf[0] == '-')
    mark := lead + usize(digits) + 1
    exponent: i32 = 0
    for i in mark + 2..out.len:
        exponent = exponent * 10 + i32(buf[i] - '0')
    if buf[mark + 1] == '-':
        exponent = 0 - exponent
    last := mark
    while buf[last - 1] == '0':
        last -= 1
    buf[lead + 1] = buf[lead]
    shown := out[lead + 1:last]
    s.* += out[:lead]
    if exponent < -4 or exponent >= 16:
        s.* += shown[:1]
        if shown.len > 1:
            s.* += "." + shown[1:]
        sign: &strview = "e+"
        if exponent < 0:
            sign = "e-"
            exponent = 0 - exponent
        s.* += sign
        if exponent < 10:
            s.* += "0"
        s.* += exponent
    elif exponent < 0:
        s.* += "0."
        for k in 0..-exponent - 1:
            add_byte(s, '0')
        s.* += shown
    elif shown.len > usize(exponent) + 1:
        point := usize(exponent) + 1
        s.* += shown[:point] + "." + shown[point:]
    else:
        s.* += shown
        for k in shown.len..usize(exponent) + 1:
            add_byte(s, '0')
        s.* += ".0"

operator +=(s: *&str, items: &slice[$T]):
    s.* += "["
    for i, item in items:
        if i > 0:
            s.* += ", "
        s.* += item
    s.* += "]"

operator +=(s: *&str, p: *$T):
    s.* += hex(p as u64)

type Fixed:
    value: f64
    places: i32

func fixed(value: f64, places: i32) -> Fixed:
    return Fixed{value, places}

func fixed(value: f32, places: i32) -> Fixed:
    return Fixed{f64(value), places}

operator +=(s: *&str, f: Fixed):
    value := f.value
    if value - value != 0.0:
        s.* += value
        return
    places := f.places
    if places < 0:
        places = 0
    halves := value
    for k in 0..places + 1:
        halves *= 2.0
    tie := halves > -9007199254740992.0 and halves < 9007199254740992.0 and f64(i64(halves)) == halves and i64(halves) % 2 != 0 # 2^53
    bits := ptr(value) as *u64
    bits.* -= u64(tie)
    with scratch():
        room := usize(places) + 312 # the sign, 309 digits, the point and the zero
        out: &strview
        out = temp(room)
        out.len = usize(snprintf(ptr(out.*) as *u8, room, "%.*f", places, value))
        if tie and out[-1] % 2 == 1:
            bits.* += 2
            out.len = usize(snprintf(ptr(out.*) as *u8, room, "%.*f", places, value))
        s.* += out

type Hex:
    value: u64

func hex(value: u64) -> Hex:
    return Hex{value}

operator +=(s: *&str, h: Hex):
    digits: &strview = "0123456789abcdef"
    buf: array[u8, 16]
    i: usize = 16
    v := h.value
    while true:
        i -= 1
        buf[i] = digits[v and 15]
        v = v >> 4
        if v == 0:
            break
    out: &strview
    out = (ptr(buf) as usize + i) as *bytes
    out.len = 16 - i
    s.* += "0x" + out

type Padded[$T]:
    value: $T
    width: i32

func pad(value: $T, width: i32) -> Padded[$T]:
    return Padded[$T]{value, width}

operator +=(s: *&str, p: Padded[$T]):
    text := "" + p.value
    count: i32 = 0
    for c in text:
        count += 1
    if p.width > 0:
        for k in count..p.width:
            add_byte(s, ' ')
    s.* += text
    for k in count..-p.width:
        add_byte(s, ' ')

type File:
    fd: i32

stdin = File{0}
stdout = File{1}
stderr = File{2}

TIMED_OUT = -10060 # the Windows code, negative like every code that is not errno

type error FsError:
    code: i32
    action: &strview
    path: &strview

operator +=(s: *&str, e: FsError):
    s.* += "cannot " + e.action
    if e.path.len > 0:
        s.* += " " + e.path
    if e.code == TIMED_OUT:
        s.* += ": the timeout ran out"
    else:
        s.* += ": " + reason(e.code)

priv type Stream:
    fd: i32
    open: bool
    socket: bool
    by_lines: bool
    failed: i32
    path: &str
    unsent: &str
    received: &str
    given: usize

priv context io:
    streams: &list[*Stream]
    last: i32

priv func stream(f: File, place: &strview = @here()) -> *Stream:
    if f.fd < 0:
        panic("File{" + f.fd + "} is not an open file", place)
    if io.streams.len == 0:
        atexit(ptr(flag_exit))
    while io.streams.len <= usize(f.fd):
        append(io.streams, usize(0) as *Stream)
    if io.streams[usize(f.fd)] as usize == 0:
        io.streams[usize(f.fd)] = heap(Stream{fd = f.fd})
    s := io.streams[usize(f.fd)]
    if not s.open:
        s.open = true
        address: array[u8, 128]
        size: u32 = 128
        s.socket = getsockname(i64(f.fd), ptr(address) as *bytes, ptr(size)) == 0
        s.by_lines = not s.socket and (f.fd == 2 or isatty(f.fd) != 0)
        if f.fd < 3:
            names := ["the standard input", "the standard output", "the error output"]
            s.path = names[f.fd]
    return s

func flush():
    for s in io.streams:
        if s as usize != 0:
            drain(s)

priv export func flag_exit():
    flush()
    lost := flush(stdout)
    if lost is FsError:
        eprint("flag: ", lost)
        _exit(1)

func open(path: &strview) -> File|FsError:
    return opened(path, 0, "open")

func create(path: &strview, append: bool = false) -> File|FsError:
    return opened(path, 1 + usize(append), "create")

priv func opened(path: &strview, mode: usize, action: &strview) -> File|FsError:
    flags := open_flags()
    f := File{-1}
    with scratch():
        f.fd = open(cstr(path), flags[mode], flags[3])
    if f.fd < 0:
        return FsError{errno(), action, path}
    stream(f).path = path
    return f

func write(f: File, value: $T, place: &strview = @here()):
    s := stream(f, place)
    if (f.fd == 1 or f.fd == 2) and io.last != f.fd:
        drain(stream(File{3 - f.fd})) # stdout and stderr keep the order of the calls
        io.last = f.fd
    s.unsent += value
    if s.unsent.len >= 65536 or s.by_lines and find(s.unsent, "\n") is usize:
        drain(s)
        if s.unsent.cap > 131072:
            free(s.unsent) # after a big text the stream keeps only its usual room

func flush(f: File, place: &strview = @here()) -> FsError?:
    s := stream(f, place)
    drain(s)
    if s.failed == 0:
        return null
    failed := FsError{s.failed, "write", temp(s.path)}
    s.failed = 0
    return failed

priv func drain(s: *Stream):
    sent: usize = 0
    while sent < s.unsent.len:
        n := transfer(s, (ptr(s.unsent.*) as usize + sent) as *bytes, s.unsent.len - sent, true)
        if n is FsError:
            if s.failed == 0:
                s.failed = n.code
            break
        sent += n
    s.unsent.len = 0

func read(f: File, into: *&str, size: usize, place: &strview = @here()) -> usize|FsError:
    s := stream(f, place)
    if s.given == s.received.len:
        s.given = 0
        s.received.len = 0
        if size >= 65536:
            return receive(s, into, size)
        try receive(s, s.received, 65536)
    taken := s.received.len - s.given
    if taken > size:
        taken = size
    into.* += s.received[s.given:s.given + taken]
    s.given += taken
    return taken

func read_line(f: File, place: &strview = @here()) -> &strview|null|FsError:
    s := stream(f, place)
    checked: usize = 0
    while true:
        line: &strview
        line = (ptr(s.received.*) as usize + s.given) as *bytes
        line.len = s.received.len - s.given
        end := memchr((ptr(line.*) as usize + checked) as *bytes, '\n', line.len - checked)
        if end as usize != 0:
            line.len = end as usize - ptr(line.*) as usize @trust
            s.given += line.len + 1
            if line.len > 0 and line[-1] == '\r':
                line.len -= 1
            return temp(line)
        checked = line.len
        if s.given > 0:
            memmove(ptr(s.received.*), ptr(line.*), line.len)
            s.received.len = line.len
            s.given = 0
        if try receive(s, s.received, 65536) == 0:
            s.given = s.received.len
            if s.received.len == 0:
                return null
            return temp(view(s.received))

priv func receive(s: *Stream, into: *&str, size: usize) -> usize|FsError:
    flush() # what you wrote goes out before the program waits for an answer
    reserve(into, into.len + size)
    got := try transfer(s, (ptr(into.*.*) as usize + into.len) as *bytes, size, false)
    into.len += got
    return got

priv func transfer(s: *Stream, at: *bytes, size: usize, writing: bool) -> usize|FsError:
    while true:
        n := moved(s, at, size, writing)
        if n >= 0:
            return usize(n)
        code := failure(s, writing)
        if code != 0 and writing:
            return FsError{code, "write", temp(s.path)}
        if code != 0:
            return FsError{code, "read", temp(s.path)}

func close(f: File, place: &strview = @here()):
    s := stream(f, place)
    drain(s)
    release(s)
    s.open = false
    s.failed = 0
    s.path.len = 0
    s.received.len = 0
    s.given = 0

func errno() -> i32 where @linux():
    return __errno_location().*

func errno() -> i32 where @macos():
    return __error().*

func errno() -> i32 where @windows():
    return _errno().*

priv func moved(s: *Stream, at: *bytes, size: usize, writing: bool) -> i32 where @linux():
    if not writing:
        return read(s.fd, at, size)
    if s.socket:
        return send(i64(s.fd), at, size, 0x4000) # MSG_NOSIGNAL, a closed peer is an error and not a signal
    return write(s.fd, at, size)

priv func moved(s: *Stream, at: *bytes, size: usize, writing: bool) -> i32 where @macos():
    if writing:
        return write(s.fd, at, size) # net sets SO_NOSIGPIPE on its sockets
    return read(s.fd, at, size)

priv func moved(s: *Stream, at: *bytes, size: usize, writing: bool) -> i32 where @windows():
    if s.socket and writing:
        return send(i64(s.fd), at, size, 0)
    if s.socket:
        return recv(i64(s.fd), at, size, 0)
    if writing:
        return write(s.fd, at, size)
    return read(s.fd, at, size)

priv func failure(s: *Stream, writing: bool) -> i32 where not @windows():
    code := errno()
    blocked := code == 11 or code == 35 # EAGAIN on Linux and on macOS, the other number never comes from a read
    if blocked and s.socket:
        return TIMED_OUT
    if blocked:
        events: i32 = 1 # POLLIN
        if writing:
            events = 4 # POLLOUT
        wait := array[i32, 2]{s.fd, events} # a struct pollfd
        poll(ptr(wait) as *bytes, 1, -1)
        return 0
    if code == 4: # EINTR
        return 0
    return code

priv func failure(s: *Stream, writing: bool) -> i32 where @windows():
    if s.socket:
        return 0 - WSAGetLastError()
    return errno()

priv func release(s: *Stream) where not @windows():
    close(s.fd)

priv func release(s: *Stream) where @windows():
    if s.socket:
        closesocket(i64(s.fd))
    else:
        close(s.fd)

priv func open_flags() -> array[i32, 4] where @linux():
    return [0x80000, 0x80241, 0x80441, 438] # to read, to write from the start or at the end, and 0o666: O_CLOEXEC, O_WRONLY 1, O_CREAT 0x40, O_TRUNC 0x200, O_APPEND 0x400

priv func open_flags() -> array[i32, 4] where @macos():
    return [0x1000000, 0x1000601, 0x1000209, 438] # O_CLOEXEC 0x1000000, O_CREAT 0x200, O_TRUNC 0x400, O_APPEND 8

priv func open_flags() -> array[i32, 4] where @windows():
    return [0x8080, 0x8381, 0x8189, 0x180] # _O_BINARY 0x8000, _O_NOINHERIT 0x80, _O_CREAT 0x100, _O_TRUNC 0x200, _O_APPEND 8, _S_IREAD and _S_IWRITE

priv func reason(code: i32) -> &strview where @linux():
    if code < 0:
        return view(gai_strerror(code))
    return view(strerror(code))

priv func reason(code: i32) -> &strview where @macos():
    if code < 0:
        return view(gai_strerror(0 - code))
    return view(strerror(code))

priv func reason(code: i32) -> &strview where @windows():
    if code >= 0:
        return view(strerror(code))
    text: array[u8, 512]
    size := FormatMessageA(0x1200, usize(0) as *bytes, u32(0 - code), 0, ptr(text) as *u8, 512, usize(0) as *bytes)
    out: &strview
    out = ptr(text) as *bytes
    out.len = usize(size)
    return trim_end(out) + " (" + (0 - code) + ")"

type entry[$K, $V]:
    key: $K
    value: $V

type fatptr map[$K, $V]:
    len: usize
    cap: usize

func hash(s: &strview) -> u64:
    # FNV-1a
    h: u64 = 0xcbf2_9ce4_8422_2325
    for b in items(s):
        h = (h xor u64(b)) * 0x100_0000_01b3
    return h

func hash(n: $T) -> u64 where $T is Integer:
    h := u64(n) * 0x9e37_79b9_7f4a_7c15 # 2^64 over the golden ratio
    return h xor (h >> 32)

func hash(f: f64) -> u64:
    if f == 0.0:
        return 0
    return hash(f as u64)

func hash(f: f32) -> u64:
    return hash(f64(f))

priv type Slot[$K, $V]:
    hash: u64
    key: $K
    value: $V

priv func slots(m: &map[$K, $V]) -> &slice[Slot[$K, $V]]:
    out: &slice[Slot[$K, $V]]
    out = ptr(m.*)
    out.len = m.cap
    return out

priv func kept_hash(key: $K) -> u64:
    return hash(key) or 0x8000_0000_0000_0000 # 0 marks a free slot

priv func locate(m: &map[$K, $V], key: $K) -> usize:
    table := slots(m)
    h := kept_hash(key)
    i := usize(h) and m.cap - 1
    while table[i].hash != 0 and (table[i].hash != h or table[i].key != key):
        i = (i + 1) and m.cap - 1
    return i

func put(m: *&map[$K, $V], key: $K, value: $V):
    put(m, key).* = value

func put(m: *&map[$K, $V], key: $K) -> *$V:
    if (m.len + 1) * 2 > m.cap:
        old := slots(m.*)
        cap := m.cap * 2
        if cap < 16:
            cap = 16
        grown := calloc(cap, sizeof(Slot[$K, $V]))
        if grown as usize == 0:
            out_of_memory()
        m.* = grown
        m.cap = cap
        table := slots(m.*)
        for s in old:
            if s.hash != 0:
                j := usize(s.hash) and cap - 1
                while table[j].hash != 0:
                    j = (j + 1) and cap - 1
                table[j] = s
        free(ptr(old.*))
    i := locate(m.*, key)
    table := slots(m.*)
    if table[i].hash == 0:
        table[i] = Slot[$K, $V]{hash = kept_hash(key), key = key}
        m.len += 1
    return ptr(table[i].value)

func get(m: &map[$K, $V], key: $K) -> $V|null:
    if m.cap == 0:
        return null
    table := slots(m)
    i := locate(m, key)
    if table[i].hash == 0:
        return null
    return table[i].value

func contains(m: &map[$K, $V], key: $K) -> bool:
    return m.cap > 0 and slots(m)[locate(m, key)].hash != 0

func at(m: &map[$K, $V], key: $K) -> $V|null:
    return get(m, key)

func remove(m: *&map[$K, $V], key: $K) -> $V|null:
    if m.cap == 0:
        return null
    table := slots(m.*)
    hole := locate(m.*, key)
    if table[hole].hash == 0:
        return null
    value := table[hole].value
    j := hole
    while table[(j + 1) and m.cap - 1].hash != 0:
        j = (j + 1) and m.cap - 1
        home := usize(table[j].hash) and m.cap - 1
        if j > hole and (home <= hole or home > j) or j < hole and home <= hole and home > j:
            table[hole] = table[j]
            hole = j
    table[hole].hash = 0
    m.len -= 1
    return value

func clear(m: *&map[$K, $V]):
    table := slots(m.*)
    for i in 0..table.len:
        table[i].hash = 0
    m.len = 0

func free(m: *&map[$K, $V]):
    free(ptr(m.*.*))
    m.* = usize(0) as *bytes
    m.len = 0
    m.cap = 0

priv type Pairs[$K, $V]:
    table: &slice[Slot[$K, $V]]
    i: usize

func iter(m: &map[$K, $V]) -> Pairs[$K, $V]:
    return Pairs[$K, $V]{slots(m), 0}

func next(p: *Pairs[$K, $V]) -> entry[$K, $V]|IterationEnd:
    while p.i < p.table.len:
        p.i += 1
        s := p.table[p.i - 1]
        if s.hash != 0:
            return entry[$K, $V]{s.key, s.value}
    return IterationEnd

operator +=(s: *&str, m: &map[$K, $V]):
    s.* += "{"
    first := true
    for e in m:
        if not first:
            s.* += ", "
        first = false
        s.* += e.key + ": " + e.value
    s.* += "}"

type fixmap[$K, $V, $$max]:
    len: usize
    entries: array[entry[$K, $V], $$max]

type error MapFull

priv func place(m: *fixmap[$K, $V, $$max], key: $K) -> usize:
    i: usize = 0
    while i < m.len and m.entries[i].key != key:
        i += 1
    return i

func put(m: *fixmap[$K, $V, $$max], key: $K, value: $V) -> MapFull?:
    i := place(m, key)
    if i == $$max:
        return MapFull
    if i == m.len:
        m.len += 1
    m.entries[i] = entry[$K, $V]{key, value}
    return null

func get(m: *fixmap[$K, $V, $$max], key: $K) -> $V|null:
    i := place(m, key)
    if i == m.len:
        return null
    return m.entries[i].value

func at(m: *fixmap[$K, $V, $$max], key: $K) -> $V|null:
    return get(m, key)

func contains(m: *fixmap[$K, $V, $$max], key: $K) -> bool:
    return place(m, key) < m.len

func remove(m: *fixmap[$K, $V, $$max], key: $K) -> $V|null:
    i := place(m, key)
    if i == m.len:
        return null
    value := m.entries[i].value
    for k in i..m.len - 1:
        m.entries[k] = m.entries[k + 1]
    m.len -= 1
    return value

func clear(m: *fixmap[$K, $V, $$max]):
    m.len = 0

func iter(m: *fixmap[$K, $V, $$max]) -> Walk[entry[$K, $V]]:
    return Walk[entry[$K, $V]]{ptr(m.entries) as *bytes, m.len, 0}

operator +=(s: *&str, m: *fixmap[$K, $V, $$max]):
    s.* += "{"
    for i in 0..m.len:
        if i > 0:
            s.* += ", "
        s.* += m.entries[i].key + ": " + m.entries[i].value
    s.* += "}"
