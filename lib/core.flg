extern "pthread" where @linux():

priv extern "ws2_32" where @windows():
    func WSAGetLastError() -> i32
    func closesocket(fd: i64) -> i32
    func WSAPoll(fds: *bytes, count: u32, timeout: i32) -> i32

type Integer = i8|i16|i32|i64|u8|u16|u32|u64

func min(a: $T, b: $T) -> $T:
    if b < a:
        return b
    return a

func max(a: $T, b: $T) -> $T:
    if a < b:
        return b
    return a

func clamp(x: $T, low: $T, high: $T) -> $T:
    return min(max(x, low), high)

func clamp(x: simd[$T, $$n], low: $T, high: $T) -> simd[$T, $$n]:
    return min(max(x, low), high)

func abs(x: $T) -> $T where $T is i8|i16|i32|i64:
    if x < 0:
        return 0 - x
    return x

func abs(x: $T) -> $T where $T is f32:
    return (x as u32 and 0x7fff_ffff) as f32

func abs(x: $T) -> $T where $T is f64:
    return (x as u64 and 0x7fff_ffff_ffff_ffff) as f64

func lerp(a: $T, b: $T, t: $T) -> $T where $T is f32|f64:
    return a + (b - a) * t

func heap(v: $T) -> *$T:
    p := malloc(@sizeof($T)) as *$T
    if p as u64 == 0:
        out_of_memory()
    p.* = v
    return p

func free(p: *$T):
    free(p as *bytes)

func panic(message: &strview, place: &strview = @here()) -> never:
    tell(134)
    flush()
    report("flag: ")
    report(message)
    if place.len > 0:
        report("\n  --> ")
        report(place)
    report("\n")
    frame := flag_frame()
    trace(Crash{frame, 0, frame, 0, 0})
    hook := failure.hook
    if hook as u64 != 0:
        hook(message, place)
    exit(134)

# the function that runs when the program stops with 134, after the message and the chain of calls: a new one replaces the last
func on_panic(hook: func(&strview, &strview)):
    failure.hook = hook

func cstr(text: &strview) -> cstr:
    return ptr(tmp(text).*) as cstr

func wstr(text: &strview) -> wstr:
    out := tmp(text.len * 2 + 2) as *u16
    at := out
    for c in text:
        code := u32(c[0])
        if c.len > 1:
            code = code and 0x7f >> u32(c.len)
            for b in items(c[1:]):
                code = code << 6 or u32(b and 0x3f)
        elif code >= 0x80:
            code = 0xfffd # a byte that is not UTF-8
        if code >= 0x10000:
            at.* = u16(0xd800 + (code - 0x10000 >> 10))
            at = (at as *bytes + 2) as *u16
            code = 0xdc00 or code and 0x3ff
        at.* = u16(code)
        at = (at as *bytes + 2) as *u16
    at.* = 0
    return out as wstr

func tmp(w: wstr) -> &strview:
    if w as u64 == 0:
        return ""
    out: &str = heap("")
    defer free(out)
    at := w as *u16
    while at.* != 0:
        code := u32(at.*)
        at = (at as *bytes + 2) as *u16
        if code >= 0xd800 and code < 0xdc00 and at.* >= 0xdc00 and at.* < 0xe000:
            code = 0x10000 + (code - 0xd800 << 10) + u32(at.*) - 0xdc00
            at = (at as *bytes + 2) as *u16
        elif code >= 0xd800 and code < 0xe000:
            code = 0xfffd # half of a pair, alone
        add_char(out, code)
    return tmp(out)

func windows_errno(code: u32) -> i32:
    switch code:
    case 2, 3, 15, 18, 53, 67, 161, 206:
        return 2 # ENOENT
    case 5, 16, 19..=36, 65, 82, 83, 108, 132, 158, 167:
        return 13 # EACCES
    case 1, 12, 13, 87, 124, 131:
        return 22 # EINVAL
    case 7, 8, 9, 1816:
        return 12 # ENOMEM
    case 6, 114, 130:
        return 9 # EBADF
    case 80, 183:
        return 17 # EEXIST
    case 11, 188..=202:
        return 8 # ENOEXEC
    case 89, 164, 215:
        return 11 # EAGAIN
    case 128, 129:
        return 10 # ECHILD
    case 4:
        return 24 # EMFILE
    case 10:
        return 7 # E2BIG
    case 17:
        return 18 # EXDEV
    case 109:
        return 32 # EPIPE
    case 112:
        return 28 # ENOSPC
    case 145:
        return 41 # ENOTEMPTY
    case:
        return 0 - i32(code)

type error NoMemory

priv MOST = 0x7fff_ffff_ffff_ffff # the most bytes C allocates at once, PTRDIFF_MAX

func out_of_memory() -> never:
    tell(9)
    drain()
    report("flag: out of memory\n")
    _exit(9)

func out_of_bounds(i: $I, len: i64, place: &strview = @here()) -> never where $I is Integer:
    panic("index " + i + " is out of bounds, length " + len, place)

func out_of_bounds(from: $I, to: $I, len: i64, place: &strview = @here()) -> never where $I is Integer:
    panic("slice " + from + ":" + to + " is out of bounds, length " + len, place)

type fatptr listview[$T]:
    len: i64

operator [:](s: &listview[$T], from: $I, to: $I, place: &strview = @here()) -> &listview[$T] where $I is Integer:
    first := u64(from) # a negative is past every length
    last := u64(to)
    if first > last or last > u64(s.len):
        out_of_bounds(from, to, s.len, place)
    out: &listview[$T]
    out = ptr(s.*) + first * @sizeof($T)
    out.len = i64(last - first)
    return out

priv type Walk[$T]:
    base: *bytes
    len: i64
    i: i64

operator next(w: *Walk[$T]) -> $T|IterationEnd:
    if w.i >= w.len:
        return IterationEnd
    p := (w.base + w.i * @sizeof($T)) as *$T
    w.i += 1
    return p.*

operator ==(a: *array[$T, $$n], b: *array[$T, $$n]) -> bool:
    for i in 0..$$n:
        if a[i] != b[i]:
            return false
    return true

type fatptr list[$T]:
    len: i64
    cap: i64
    arena: *Arena

func reserve(l: *&list[$T], want: i64):
    if want < 0:
        out_of_memory()
    if want <= l.cap:
        return
    cap := doubled(l.cap, want, 8)
    bytes := cap * @sizeof($T)
    if bytes / cap != @sizeof($T):
        out_of_memory()
    grown := resize(l.arena, ptr(l.*.*), l.cap * @sizeof($T), bytes, NO_LIST)
    if grown as u64 == 0 and bytes > 0:
        out_of_memory()
    l.* = grown
    l.cap = cap

# a new block and a copy: -memory reads resize as a move, and here the old block stays when there is no memory
func try_reserve(l: *&list[$T], want: i64) -> NoMemory?:
    if want < 0:
        return NoMemory
    if want <= l.cap:
        return null
    cap := doubled(l.cap, want, 8)
    bytes := cap * @sizeof($T)
    if bytes / cap != @sizeof($T):
        return NoMemory
    grown := resize(l.arena, 0 as *bytes, 0, bytes, NO_LIST)
    if grown as u64 == 0 and bytes > 0:
        return NoMemory
    memcpy(grown, ptr(l.*.*), l.len * @sizeof($T))
    discard(l.arena, ptr(l.*.*))
    l.* = grown
    l.cap = cap
    return null

priv func doubled(cap: i64, want: i64, least: i64) -> i64:
    more := cap * 2
    if more < want:
        more = want
    if more < least:
        more = least
    return more

func append(l: *&list[$T], v: $T):
    if l.len == l.cap:
        reserve(l, l.len + 1)
    p := (ptr(l.*.*) + l.len * @sizeof($T)) as *$T
    p.* = v
    l.len += 1

func append(l: *&list[$T], items: &listview[$T]):
    if u64(ptr(items.*) - ptr(l.*.*)) < u64(l.cap * @sizeof($T)): # a negative is past every length
        with scratch():
            append(l, tmp(items))
        return
    reserve(l, l.len + items.len)
    memcpy(ptr(l.*.*) + l.len * @sizeof($T), ptr(items.*), items.len * @sizeof($T))
    l.len += items.len

operator =(l: *&list[$T], items: &listview[$T]) -> &list[$T]:
    clear(l)
    append(l, items)
    return l.*

func pop(l: *&list[$T]) -> $T|null:
    if l.len == 0:
        return null
    l.len -= 1
    p := (ptr(l.*.*) + l.len * @sizeof($T)) as *$T
    return p.*

func insert(l: *&list[$T], at: $I, v: $T, place: &strview = @here()) where $I is Integer:
    n := i64(at)
    if u64(n) > u64(l.len): # a negative is past every length
        out_of_bounds(at, l.len, place)
    append(l, v)
    first := ptr(l.*.*) + n * @sizeof($T)
    memmove(first + @sizeof($T), first, (l.len - 1 - n) * @sizeof($T))
    l[n] = v

func remove(l: *&list[$T], at: $I, place: &strview = @here()) -> $T where $I is Integer:
    n := i64(at)
    if u64(n) >= u64(l.len): # a negative is past every length
        out_of_bounds(at, l.len, place)
    kept := l[n]
    first := ptr(l.*.*) + n * @sizeof($T)
    memmove(first, first + @sizeof($T), (l.len - 1 - n) * @sizeof($T))
    l.len -= 1
    return kept

func find(items: &listview[$T], v: $T) -> i64|null:
    for i in 0..items.len:
        if items[i] == v:
            return i
    return null

func find(items: &listview[$T], fits: func($T) -> bool) -> i64|null:
    for i in 0..items.len:
        if fits(items[i]):
            return i
    return null

func contains(items: &listview[$T], v: $T) -> bool:
    return find(items, v) is i64

func binary_search(items: &listview[$T], v: $T) -> i64|null:
    low := 0
    high := items.len
    while low < high:
        middle := (low + high) / 2
        if items[middle] < v:
            low = middle + 1
        elif v < items[middle]:
            high = middle
        else:
            return middle
    return null

operator ==(a: &listview[$T], b: &listview[$T]) -> bool:
    if a.len != b.len:
        return false
    for i in 0..a.len:
        if a[i] != b[i]:
            return false
    return true

func flip(items: &listview[$T]):
    for i in 0..items.len / 2:
        swap(items, i, items.len - 1 - i)

func clear(l: *&list[$T]):
    l.len = 0

func free(l: *&list[$T]):
    discard(l.arena, ptr(l.*.*))
    l.* = 0 as *bytes
    l.len = 0
    l.cap = 0

func sort(s: &listview[$T]):
    before: func($T, $T) -> bool = less
    sort(s, before)

priv func less(a: $T, b: $T) -> bool:
    return a < b

func sort(s: &listview[$T], before: func($T, $T) -> bool):
    if s.len < 2:
        return
    spare: &listview[$T]
    spare = malloc(s.len / 2 * @sizeof($T))
    if ptr(spare.*) as u64 == 0:
        out_of_memory()
    spare.len = s.len / 2
    merge_sort(s, spare, before)
    free(ptr(spare.*))

priv func merge_sort(s: &listview[$T], spare: &listview[$T], before: func($T, $T) -> bool):
    if s.len <= 16:
        for i in 1..s.len:
            v := s[i]
            j := i
            while j > 0 and before(v, s[j - 1]):
                s[j] = s[j - 1]
                j -= 1
            s[j] = v
        return
    half := s.len / 2
    merge_sort(s[:half], spare, before)
    merge_sort(s[half:], spare, before)
    if not before(s[half], s[half - 1]):
        return
    memcpy(ptr(spare.*), ptr(s.*), half * @sizeof($T))
    i := 0
    j := half
    k := 0
    while i < half:
        if j < s.len and before(s[j], spare[i]):
            s[k] = s[j]
            j += 1
        else:
            s[k] = spare[i]
            i += 1
        k += 1

func swap(s: &listview[$T], i: $I, j: $I, place: &strview = @here()) where $I is Integer:
    if u64(i) >= u64(s.len): # a negative is past every length
        out_of_bounds(i, s.len, place)
    if u64(j) >= u64(s.len):
        out_of_bounds(j, s.len, place)
    kept := s[i]
    s[i] = s[j]
    s[j] = kept

type fatptr strview:
    len: i64

type fatptr str:
    len: i64
    cap: i64
    arena: *Arena

func view(s: &str) -> &strview:
    v: &strview
    v = ptr(s.*)
    v.len = s.len
    return v

func view(c: cstr) -> &strview:
    out: &strview
    if c as u64 != 0:
        out = c as *u8
        out.len = strlen(c)
    return out

operator +=(s: *&str, c: cstr):
    s.* += view(c)

operator +=(s: *&str, w: wstr):
    s.* += tmp(w)

func view(bytes: &listview[u8]) -> &strview:
    out: &strview
    out = ptr(bytes.*)
    out.len = bytes.len
    return out

func items(s: &strview) -> &listview[u8]:
    out: &listview[u8]
    out = ptr(s.*)
    out.len = s.len
    return out

operator [:](v: &strview, from: $I, to: $I, place: &strview = @here()) -> &strview where $I is Integer:
    first := u64(from) # a negative is past every length
    last := u64(to)
    if first > last or last > u64(v.len):
        out_of_bounds(from, to, v.len, place)
    out: &strview
    out = ptr(v.*) + first
    out.len = i64(last - first)
    return out

func reserve(s: *&str, want: i64):
    if want < 0:
        out_of_memory()
    if want <= s.cap:
        return
    cap := doubled(s.cap, want, 32)
    grown := resize(s.arena, ptr(s.*.*), s.cap, cap, NO_TEXT)
    if grown as u64 == 0:
        out_of_memory()
    s.* = grown
    s.cap = cap

func try_reserve(s: *&str, want: i64) -> NoMemory?:
    if want < 0:
        return NoMemory
    if want <= s.cap:
        return null
    cap := doubled(s.cap, want, 32)
    grown := resize(s.arena, 0 as *bytes, 0, cap, NO_TEXT)
    if grown as u64 == 0:
        return NoMemory
    memcpy(grown, ptr(s.*.*), s.len)
    discard(s.arena, ptr(s.*.*))
    s.* = grown
    s.cap = cap
    return null

type Arena:
    blocks: &list[&strview] = heap([])
    count: i64
    used: i64

func arena(a: *Arena, v: $T) -> *$T:
    p := take(a, @sizeof($T)) as *$T
    if p as u64 == 0:
        out_of_memory()
    p.* = v
    return p

# the arena of an owner whose memory is in the heap, which the compiler writes too: 0 is an owner with no memory
priv HEAP = 1
priv NO_LIST = "this &list has no memory to grow in: give it heap([]) or arena(a, [])"
priv NO_TEXT = "this &str has no memory to grow in: give it heap(\"\") or arena(a, \"\")"
priv NO_MAP = "this &map has no memory to grow in: give it heap({}) or arena(a, {})"

# the words of an owner, to make one in its arena
priv type Owner:
    data: *bytes
    len: i64
    cap: i64
    arena: *Arena

# an owner of never holds nothing, so it goes where any owner of its kind goes
func heap(items: emptyarray) -> &list[never]:
    return arena(HEAP as *Arena, items)

func arena(a: *Arena, items: emptyarray) -> &list[never]:
    return Owner{arena = a} as &list[never]

func heap(pairs: emptyfixmap) -> &map[never, never]:
    return arena(HEAP as *Arena, pairs)

func arena(a: *Arena, pairs: emptyfixmap) -> &map[never, never]:
    return Owner{arena = a} as &map[never, never]

func heap(text: &strview) -> &str:
    return arena(HEAP as *Arena, text)

func arena(a: *Arena, text: &strview) -> &str:
    out := Owner{arena = a} as &str
    out += text
    return out

func heap(items: &listview[$T]) -> &list[$T]:
    return arena(HEAP as *Arena, items)

func arena(a: *Arena, items: &listview[$T]) -> &list[$T]:
    out := Owner{arena = a} as &list[$T]
    append(out, items)
    return out

func heap(items: array[$T, $$n]) -> &list[$T]:
    return arena(HEAP as *Arena, items)

func arena(a: *Arena, items: array[$T, $$n]) -> &list[$T]:
    return arena(a, items[:])

func heap(pairs: fixmap[$K, $V, $$n]) -> &map[$K, $V]:
    return arena(HEAP as *Arena, pairs)

func arena(a: *Arena, pairs: fixmap[$K, $V, $$n]) -> &map[$K, $V]:
    out := Owner{arena = a} as &map[$K, $V]
    for e in pairs:
        out[e.key] = e.value
    return out

func clear(a: *Arena):
    reclaim(a, false)

func free(a: *Arena):
    reclaim(a, true)

func reserve(a: *Arena, size: i64):
    if try_reserve(a, size) is NoMemory:
        out_of_memory()

func try_reserve(a: *Arena, size: i64) -> NoMemory?:
    count := a.count
    used := a.used
    if take(a, size) as u64 == 0:
        return NoMemory
    if a.count == count:
        a.used = used # the piece goes back, and the room stays
    else:
        a.used = 0
    return null

# 0 when there is no memory, like malloc
priv func take(a: *Arena, size: i64) -> *bytes:
    if size < 0 or size > MOST - 15:
        return 0 as *bytes
    need := (size + 15) / 16 * 16
    if a.count == 0 or a.used + need > a.blocks[a.count - 1].len:
        if a.count == a.blocks.len or a.blocks[a.count].len < need:
            room := 65536
            if room < need:
                room = need
            block: &strview
            block = malloc(room)
            if ptr(block.*) as u64 == 0 or try_reserve(a.blocks, a.blocks.len + 1) is NoMemory:
                free(ptr(block.*))
                return 0 as *bytes
            block.len = room
            insert(a.blocks, a.count, block)
        a.count += 1
        a.used = 0
    out := ptr(a.blocks[a.count - 1].*) + a.used
    a.used += need
    return out

priv func resize(a: *Arena, at: *bytes, size: i64, wanted: i64, no_memory: &strview) -> *bytes:
    if a as u64 == HEAP:
        return realloc(at, wanted)
    if a as u64 == 0:
        panic(no_memory, "") # no place, it would be here: the chain shows the function that grew it
    held := (size + 15) / 16 * 16
    last := a.count > 0 and at + held == ptr(a.blocks[a.count - 1].*) + a.used
    if last:
        a.used -= held # the last piece of the block, take gives the same place back when it fits
    grown := take(a, wanted)
    if grown as u64 == 0 and last:
        a.used += held
    elif grown != at:
        memcpy(grown, at, size)
    return grown

priv func discard(a: *Arena, at: *bytes):
    if a as u64 == HEAP:
        free(at)

priv func reclaim(a: *Arena, freeing: bool):
    if freeing:
        for block in a.blocks:
            free(ptr(block.*))
        free(a.blocks)
    a.count = 0
    a.used = 0

type Scratch:
    count: i64
    used: i64

priv context scratch_space:
    arena: Arena

func scratch() -> Scratch:
    return Scratch{scratch_space.arena.count, scratch_space.arena.used}

operator with(s: Scratch):
    scratch_space.arena.count = s.count
    scratch_space.arena.used = s.used

func tmp(size: i64) -> *bytes:
    at := take(scratch_space.arena, size)
    if at as u64 == 0:
        out_of_memory()
    return at

func tmp(text: &strview) -> &strview:
    at := tmp(text.len + 1)
    memcpy(at, ptr(text.*), text.len)
    ((at + text.len) as *u8).* = 0
    out: &strview
    out = at
    out.len = text.len
    return out

func tmp(items: &listview[$T]) -> &listview[$T]:
    out: &listview[$T]
    out = tmp(items.len * @sizeof($T))
    out.len = items.len
    memcpy(ptr(out.*), ptr(items.*), items.len * @sizeof($T))
    return out

operator +=(s: *&str, v: &strview):
    inside := u64(ptr(v.*) - ptr(s.*.*)) < u64(s.cap) # a negative is past every length
    if inside:
        with scratch():
            s.* += tmp(v)
        return
    reserve(s, s.len + v.len)
    memcpy(ptr(s.*.*) + s.len, ptr(v.*), v.len)
    s.len += v.len

func c_text(s: &str) -> cstr:
    if s.cap <= s.len:
        return cstr(view(s))
    last := (ptr(s.*) + s.len) as *u8
    last.* = 0
    return ptr(s.*) as cstr

operator =(s: *&str, v: &strview) -> &str:
    s.len = 0
    s.* += v
    return s.*

func free(s: *&str):
    discard(s.arena, ptr(s.*.*))
    s.* = 0 as *bytes
    s.len = 0
    s.cap = 0

operator ==(a: &strview, b: &strview) -> bool:
    if a.len != b.len:
        return false
    if a.len == 0:
        return true
    return memcmp(ptr(a.*), ptr(b.*), a.len) == 0

operator <(a: &strview, b: &strview) -> bool:
    shorter := a.len
    if b.len < shorter:
        shorter = b.len
    order: i32 = 0
    if shorter > 0:
        order = memcmp(ptr(a.*), ptr(b.*), shorter)
    return order < 0 or order == 0 and a.len < b.len

func add_byte(s: *&str, b: u8):
    reserve(s, s.len + 1)
    ((ptr(s.*.*) + s.len) as *u8).* = b
    s.len += 1

func add_char(s: *&str, code: u32):
    if code < 0x80:
        add_byte(s, u8(code))
    elif code < 0x800:
        add_byte(s, u8(0xC0 or code >> 6))
        add_byte(s, u8(0x80 or code and 0x3F))
    elif code < 0x10000:
        add_byte(s, u8(0xE0 or code >> 12))
        add_byte(s, u8(0x80 or (code >> 6) and 0x3F))
        add_byte(s, u8(0x80 or code and 0x3F))
    else:
        add_byte(s, u8(0xF0 or code >> 18))
        add_byte(s, u8(0x80 or (code >> 12) and 0x3F))
        add_byte(s, u8(0x80 or (code >> 6) and 0x3F))
        add_byte(s, u8(0x80 or code and 0x3F))

func parse_hex(s: &strview) -> u64|null:
    if s.len == 0 or s.len > 16:
        return null
    n: u64 = 0
    for b in items(s):
        digit: u64 = 16
        if b >= '0' and b <= '9':
            digit = u64(b - '0')
        elif b >= 'a' and b <= 'f':
            digit = u64(b - 'a') + 10
        elif b >= 'A' and b <= 'F':
            digit = u64(b - 'A') + 10
        if digit == 16:
            return null
        n = n * 16 + digit
    return n

func find(s: &strview, part: &strview) -> i64|null:
    if part.len == 0:
        return 0
    first := i32(part[0])
    at := 0
    while at + part.len <= s.len:
        hit := memchr(ptr(s.*) + at, first, s.len - part.len + 1 - at)
        if hit as u64 == 0:
            return null
        at = hit - ptr(s.*)
        if memcmp(hit, ptr(part.*), part.len) == 0:
            return at
        at += 1
    return null

func find_last(s: &strview, part: &strview) -> i64|null:
    if part.len > s.len:
        return null
    if part.len == 0:
        return s.len
    first := part[0]
    for at in reverse 0..=s.len - part.len:
        hit := ptr(s.*) + at
        if (hit as *u8).* == first and memcmp(hit, ptr(part.*), part.len) == 0:
            return at
    return null

func contains(s: &strview, part: &strview) -> bool:
    return find(s, part) is i64

func replace(s: &strview, old: &strview, new: &strview) -> &strview:
    out: &str = heap("")
    defer free(out)
    rest := s
    cut := find(rest, old)
    while cut is i64 and old.len > 0:
        out += rest[:cut]
        out += new
        rest = rest[cut + old.len:]
        cut = find(rest, old)
    out += rest
    return tmp(out)

func join(parts: &listview[$T], separator: &strview) -> &strview:
    out: &str = heap("")
    defer free(out)
    for i, part in parts:
        if i > 0:
            out += separator
        out += part
    return tmp(out)

func lower(s: &strview) -> &strview:
    out := tmp(s)
    bytes := items(out)
    for i in 0..bytes.len:
        if bytes[i] >= 'A' and bytes[i] <= 'Z':
            bytes[i] += 32
    return out

func upper(s: &strview) -> &strview:
    out := tmp(s)
    bytes := items(out)
    for i in 0..bytes.len:
        if bytes[i] >= 'a' and bytes[i] <= 'z':
            bytes[i] -= 32
    return out

func starts_with(s: &strview, head: &strview) -> bool:
    return s.len >= head.len and s[:head.len] == head

func ends_with(s: &strview, tail: &strview) -> bool:
    return s.len >= tail.len and s[s.len - tail.len:] == tail

func trim(s: &strview) -> &strview:
    return trim_end(trim_start(s))

func trim_start(s: &strview) -> &strview:
    bytes := items(s)
    first := 0
    while first < bytes.len and blank(bytes[first]):
        first += 1
    return s[first:]

func trim_end(s: &strview) -> &strview:
    bytes := items(s)
    last := bytes.len
    while last > 0 and blank(bytes[last - 1]):
        last -= 1
    return s[:last]

priv func blank(b: u8) -> bool:
    return b == ' ' or b == '\t' or b == '\n' or b == '\r'

func words(s: &strview) -> &listview[&strview]:
    found: &list[&strview] = heap([])
    defer free(found)
    bytes := items(s)
    at := 0
    while at < bytes.len:
        start := at
        while at < bytes.len and not blank(bytes[at]):
            at += 1
        if at > start:
            append(found, s[start:at])
        at += 1
    return tmp(found)

func split(s: &strview, separator: &strview) -> &listview[&strview]:
    count := 1
    rest := s
    cut := find(rest, separator)
    while cut is i64 and separator.len > 0:
        count += 1
        rest = rest[cut + separator.len:]
        cut = find(rest, separator)
    parts: &listview[&strview]
    parts = tmp(count * @sizeof(&strview))
    parts.len = count
    rest = s
    for k in 0..count - 1:
        at := trust find(rest, separator)
        parts[k] = rest[:at]
        rest = rest[at + separator.len:]
    parts[count - 1] = rest
    return parts

func parse_int(s: &strview) -> i64|null:
    b := items(s)
    negative := s.len > 0 and b[0] == '-'
    i := 0
    if negative or s.len > 0 and b[0] == '+':
        i = 1
    if i == s.len:
        return null
    limit: u64 = 0x7fff_ffff_ffff_ffff
    if negative:
        limit += 1
    n: u64 = 0
    while i < s.len:
        if b[i] < '0' or b[i] > '9':
            return null
        digit := b[i] - '0'
        if n > (limit - digit) / 10:
            return null
        n = n * 10 + digit
        i += 1
    if negative:
        return 0 - i64(n)
    return i64(n)

func parse_float(s: &strview) -> f64|null:
    word := s
    if starts_with(word, "-") or starts_with(word, "+"):
        word = word[1:]
    if word.len == 0:
        return null
    if word != "inf" and word != "nan":
        for b in items(word):
            if (b < '0' or b > '9') and b != '.' and b != 'e' and b != 'E' and b != '-' and b != '+':
                return null # only decimal, strtod would read 0x10 and infinity too
    with scratch():
        text := cstr(s)
        end := text
        x := strtod(text, ptr(end) as *bytes)
        if end as *bytes == text as *bytes + s.len:
            return x
    return null

operator +=(s: *&str, n: u64):
    digits: array[u8, 20]
    i := 20
    while true:
        i -= 1
        digits[i] = u8(n % 10) + '0'
        n = n / 10
        if n == 0:
            break
    out: &strview
    out = ptr(digits) as *bytes + i
    out.len = 20 - i
    s.* += out

operator +=(s: *&str, n: i64):
    if n < 0:
        s.* += "-" + u64(0 - n)
    else:
        s.* += u64(n)

operator +=(s: *&str, n: i32):
    s.* += i64(n)

operator +=(s: *&str, n: i16):
    s.* += i64(n)

operator +=(s: *&str, n: i8):
    s.* += i64(n)

operator +=(s: *&str, n: u32):
    s.* += u64(n)

operator +=(s: *&str, n: u16):
    s.* += u64(n)

operator +=(s: *&str, n: u8):
    s.* += u64(n)

operator +=(s: *&str, b: bool):
    if b:
        s.* += "true"
    else:
        s.* += "false"

operator +=(s: *&str, f: f64):
    float_text(s, f, false)

operator +=(s: *&str, f: f32):
    float_text(s, f64(f), true)

priv func float_text(s: *&str, f: f64, single: bool):
    if f - f != 0.0:
        name: &strview = "nan"
        if f > 0.0:
            name = "inf"
        elif f < 0.0:
            name = "-inf"
        s.* += name
        return
    digits: i32 = 15
    most: i32 = 17
    smallest := 2.2250738585072014e-308
    if single:
        digits = 6
        most = 9
        smallest = 1.1754943508222875e-38
    if f < smallest and f > 0.0 - smallest:
        digits = 1 # a subnormal number holds fewer digits
    # shortest digits that read back: round, then cut the zeros
    buf: array[u8, 32]
    at := ptr(buf) as *u8
    out: &strview
    out = ptr(buf) as *bytes
    out.len = snprintf(at, 32, "%#.*e", digits - 1, f)
    while digits < most:
        back := strtod(at as cstr, 0 as *bytes)
        if back == f or single and f32(back) == f32(f):
            break
        digits += 1
        out.len = snprintf(at, 32, "%#.*e", digits - 1, f)
    lead := i64(buf[0] == '-')
    mark := lead + digits + 1
    exponent: i32 = 0
    for i in mark + 2..out.len:
        exponent = exponent * 10 + (buf[i] - '0')
    if buf[mark + 1] == '-':
        exponent = 0 - exponent
    last := mark
    while buf[last - 1] == '0':
        last -= 1
    buf[lead + 1] = buf[lead]
    shown := out[lead + 1:last]
    s.* += out[:lead]
    if exponent < -4 or exponent >= 16:
        s.* += shown[:1]
        if shown.len > 1:
            s.* += "." + shown[1:]
        sign: &strview = "e+"
        if exponent < 0:
            sign = "e-"
            exponent = 0 - exponent
        s.* += sign
        if exponent < 10:
            s.* += "0"
        s.* += exponent
    elif exponent < 0:
        s.* += "0."
        for k in 0..-exponent - 1:
            add_byte(s, '0')
        s.* += shown
    elif shown.len > exponent + 1:
        point := exponent + 1
        s.* += shown[:point] + "." + shown[point:]
    else:
        s.* += shown
        for k in shown.len..=exponent:
            add_byte(s, '0')
        s.* += ".0"

operator +=(s: *&str, items: &listview[$T]):
    s.* += "["
    for i, item in items:
        if i > 0:
            s.* += ", "
        s.* += item
    s.* += "]"

operator +=(s: *&str, p: *$T):
    s.* += hex(p as u64)

type Fixed:
    value: f64
    places: i32

func fixed(value: f64, places: i32) -> Fixed:
    return Fixed{value, places}

func fixed(value: f32, places: i32) -> Fixed:
    return Fixed{f64(value), places}

operator +=(s: *&str, f: Fixed):
    value := f.value
    if value - value != 0.0:
        s.* += value
        return
    places := f.places
    if places < 0:
        places = 0
    halves := value
    for k in 0..=places:
        halves *= 2.0
    tie := halves > -9007199254740992.0 and halves < 9007199254740992.0 and f64(i64(halves)) == halves and i64(halves) % 2 != 0 # 2^53
    bits := ptr(value) as *u64
    bits.* -= u64(tie)
    with scratch():
        room := places + 312 # the sign, 309 digits, the point and the zero
        out: &strview
        out = tmp(room)
        out.len = snprintf(ptr(out.*) as *u8, room, "%.*f", places, value)
        if tie and out[-1] % 2 == 1:
            bits.* += 2
            out.len = snprintf(ptr(out.*) as *u8, room, "%.*f", places, value)
        if out[0] == '-' and strtod(ptr(out.*) as cstr, 0 as *bytes) == 0.0:
            out = out[1:] # every digit is zero, so the sign says nothing
        s.* += out

type Hex:
    value: u64

func hex(value: $I) -> Hex where $I is Integer:
    bits := u64(value)
    if @sizeof($I) < 8:
        bits = bits and (u64(1) << u64(@sizeof($I) * 8)) - 1 # the bits of its own size, a negative i8 is 0xff
    return Hex{bits}

operator +=(s: *&str, h: Hex):
    digits: &strview = "0123456789abcdef"
    buf: array[u8, 16]
    i := 16
    v := h.value
    while true:
        i -= 1
        buf[i] = digits[v and 15]
        v = v >> 4
        if v == 0:
            break
    out: &strview
    out = ptr(buf) as *bytes + i
    out.len = 16 - i
    s.* += "0x" + out

type Padded[$T]:
    value: $T
    width: i32

func pad(value: $T, width: i32) -> Padded[$T]:
    return Padded[$T]{value, width}

operator +=(s: *&str, p: Padded[$T]):
    text := "" + p.value
    count: i32 = 0
    for c in text:
        count += 1
    if p.width > 0:
        for k in count..p.width:
            add_byte(s, ' ')
    s.* += text
    for k in count..-p.width:
        add_byte(s, ' ')

type Lock[$T]:
    room: array[u64, 8] # a pthread_mutex_t or an SRWLOCK
    owner: atomic[*bytes] # the thread that holds it, which the others read too
    depth: i64
    value: $T # what it guards, null when it guards code

type Locked:
    lock: *Lock[null]

# every Lock starts as a Lock[null], and its value goes after, so one code takes them all
func lock(l: *Lock[$T]) -> Locked where $T != null:
    return lock(l as *Lock[null])

func lock(l: *Lock[null]) -> Locked:
    if get(l.owner) != me():
        acquire(l)
        set(l.owner, me())
    l.depth += 1
    return Locked{l}

operator with(held: Locked):
    l := held.lock
    l.depth -= 1
    if l.depth == 0:
        set(l.owner, 0 as *bytes)
        release(l)

# takes the lock only when no thread holds it, this one neither, so a thread that must not wait never does
priv func try_lock(l: *Lock[$T]) -> bool where $T != null:
    return try_lock(l as *Lock[null])

priv func try_lock(l: *Lock[null]) -> bool:
    if not seized(l):
        return false
    set(l.owner, me())
    l.depth = 1
    return true

priv func me() -> *bytes:
    return ptr(scratch_space) as *bytes # each thread has its own

priv func acquire(l: *Lock[null]) where not @windows():
    sign(ptr(l.room[0]), 0x32aa_aba7)
    pthread_mutex_lock(ptr(l.room) as *bytes)

priv func acquire(l: *Lock[null]) where @windows():
    AcquireSRWLockExclusive(ptr(l.room) as *bytes)

priv func seized(l: *Lock[null]) -> bool where not @windows():
    sign(ptr(l.room[0]), 0x32aa_aba7)
    return pthread_mutex_trylock(ptr(l.room) as *bytes) == 0

priv func seized(l: *Lock[null]) -> bool where @windows():
    return TryAcquireSRWLockExclusive(ptr(l.room) as *bytes) != 0

priv func release(l: *Lock[null]) where not @windows():
    pthread_mutex_unlock(ptr(l.room) as *bytes)

priv func release(l: *Lock[null]) where @windows():
    ReleaseSRWLockExclusive(ptr(l.room) as *bytes)

priv shared context signing:
    lock: u32 # an os_unfair_lock, valid at zero

# at zero they are ready, but on macOS their initializer is a signature and zeros
priv func sign(first: *u64, signature: u64) where @macos():
    if first.* == 0:
        os_unfair_lock_lock(ptr(signing.lock))
        if first.* == 0:
            first.* = signature
        os_unfair_lock_unlock(ptr(signing.lock))

priv func sign(first: *u64, signature: u64) where not @macos():
    return

priv type Condition:
    room: array[u64, 6] # a pthread_cond_t or a CONDITION_VARIABLE

priv func pause(c: *Condition, l: *Lock[$T]) where $T != null:
    pause(c, l as *Lock[null])

priv func pause(c: *Condition, l: *Lock[null]):
    depth := l.depth
    set(l.owner, 0 as *bytes)
    l.depth = 0
    rest(c, l)
    set(l.owner, me())
    l.depth = depth

priv func rest(c: *Condition, l: *Lock[null]) where not @windows():
    sign(ptr(c.room[0]), 0x3cb0_b1bb)
    pthread_cond_wait(ptr(c.room) as *bytes, ptr(l.room) as *bytes)

priv func rest(c: *Condition, l: *Lock[null]) where @windows():
    SleepConditionVariableSRW(ptr(c.room) as *bytes, ptr(l.room) as *bytes, 0xffff_ffff, 0)

priv func wake(c: *Condition) where not @windows():
    sign(ptr(c.room[0]), 0x3cb0_b1bb)
    pthread_cond_broadcast(ptr(c.room) as *bytes)

priv func wake(c: *Condition) where @windows():
    WakeAllConditionVariable(ptr(c.room) as *bytes)

priv type Started: # the start of the block of a thread, the result goes after it
    handle: u64
    done: bool
    alone: bool
    left: Arena # the temporaries the result may point to, for the thread that waits

priv HEAD = 64 # where the compiler puts the result of a thread

priv shared context threads:
    running: Lock[i64] # it guards the done and alone of each thread too
    changed: Condition

priv STACK = 8 << 20

priv func spawn(size: i64) -> *bytes:
    block := calloc(1, size)
    if block as u64 == 0:
        out_of_memory()
    return block

priv func launch(block: *bytes, run: *bytes, place: &strview):
    with lock(threads.running):
        threads.running.value += 1
    if not started(block as *Started, run):
        panic("cannot start a thread, the system refuses one more", place)

priv func started(t: *Started, run: *bytes) -> bool where not @windows():
    attributes: array[u64, 8]
    pthread_attr_init(ptr(attributes) as *bytes)
    pthread_attr_setstacksize(ptr(attributes) as *bytes, STACK)
    failed := pthread_create(ptr(t.handle), ptr(attributes) as *bytes, run, t as *bytes)
    pthread_attr_destroy(ptr(attributes) as *bytes)
    return failed == 0

priv func started(t: *Started, run: *bytes) -> bool where @windows():
    t.handle = CreateThread(0 as *bytes, STACK, run, t as *bytes, 0x10000, 0 as *u32) # STACK_SIZE_PARAM_IS_A_RESERVATION
    return t.handle != 0

priv func finished(block: *bytes, pointing: bool):
    free(printing.line)
    drop_stack()
    t := block as *Started
    alone := false
    with lock(threads.running):
        alone = t.alone
        if pointing and not alone:
            t.left = scratch_space.arena
        t.done = true
        threads.running.value -= 1
        wake(threads.changed)
    if alone or not pointing:
        free(scratch_space.arena)
    if alone:
        free(block)

# the blocks of the temporaries of the thread go to the scratch of this one, as if a call had made them
priv func reap(block: *bytes, place: &strview):
    if block as u64 == 0:
        panic("wait of a thread that was never started", place)
    t := block as *Started
    wait_for(t.handle)
    a := ptr(scratch_space.arena)
    had := a.blocks.len
    for i in 0..t.left.count:
        insert(a.blocks, a.count, t.left.blocks[i])
        a.count += 1
        a.used = t.left.used
    for b in t.left.blocks[t.left.count:]:
        free(ptr(b.*))
    free(t.left.blocks)
    while a.blocks.len > had and a.blocks.len > a.count:
        last := trust pop(a.blocks) # one spare block less for each one it got, so waiting in a loop doesn't grow
        free(ptr(last.*))

priv func wait_for(handle: u64) where not @windows():
    pthread_join(handle, 0 as *bytes)

priv func wait_for(handle: u64) where @windows():
    WaitForSingleObject(handle, 0xffff_ffff)
    CloseHandle(handle)

priv func detach(block: *bytes):
    t := block as *Started
    let_go(t.handle)
    done := false
    with lock(threads.running):
        done = t.done
        t.alone = true
    if done:
        free(t.left)
        free(block)

priv func let_go(handle: u64) where not @windows():
    pthread_detach(handle)

priv func let_go(handle: u64) where @windows():
    CloseHandle(handle)

priv func settle():
    with lock(threads.running):
        while threads.running.value > 0:
            pause(threads.changed, threads.running)

func wait(t: Thread[$T], place: &strview = @here()) -> $T:
    reap(t as *bytes, place)
    defer free(t as *bytes)
    return ((t as *bytes + HEAD) as *$T).*

func done(t: Thread[$T], place: &strview = @here()) -> bool:
    if t as u64 == 0:
        panic("done of a thread that was never started", place)
    with lock(threads.running):
        return (t as *Started).done

type Channel[$T, $$size]:
    queue: Lock[Queue[$T, $$size]]
    filled: Condition
    emptied: Condition

priv type Queue[$T, $$size]:
    first: i64
    len: i64
    closed: bool
    items: array[$T, $$size]

func send(c: *Channel[$T, $$size], v: $T, place: &strview = @here()) where $$size == 0:
    @compile_error("a channel holds at least one value, its size cannot be 0")

func send(c: *Channel[$T, $$size], v: $T, place: &strview = @here()) where $$size > 0:
    with lock(c.queue):
        q := ptr(c.queue.value)
        while q.len == $$size and not q.closed:
            pause(c.emptied, c.queue)
        if q.closed:
            panic("send on a closed channel", place)
        q.items[(q.first + q.len) % $$size] = v
        q.len += 1
        wake(c.filled)

func receive(c: *Channel[$T, $$size]) -> $T|null:
    for v in c:
        return v
    return null

func close(c: *Channel[$T, $$size]):
    with lock(c.queue):
        c.queue.value.closed = true
        wake(c.filled)
        wake(c.emptied)

operator with(c: *Channel[$T, $$size]):
    close(c)

priv type Receiving[$T, $$size]:
    channel: *Channel[$T, $$size]

operator for(c: *Channel[$T, $$size]) -> Receiving[$T, $$size]:
    return Receiving[$T, $$size]{c}

operator next(r: *Receiving[$T, $$size]) -> $T|IterationEnd where $$size == 0:
    @compile_error("a channel holds at least one value, its size cannot be 0")

operator next(r: *Receiving[$T, $$size]) -> $T|IterationEnd where $$size > 0:
    c := r.channel
    with lock(c.queue):
        q := ptr(c.queue.value)
        while q.len == 0 and not q.closed:
            pause(c.filled, c.queue)
        if q.len == 0:
            return IterationEnd
        v := q.items[q.first]
        q.first = (q.first + 1) % $$size
        q.len -= 1
        wake(c.emptied)
        return v

type File:
    fd: i32

stdin = File{0}
stdout = File{1}
stderr = File{2}

TIMED_OUT = -10060 # the Windows code, negative like every code that is not errno

type error FsError:
    code: i32
    action: &strview
    path: &strview

operator +=(s: *&str, e: FsError):
    s.* += "cannot " + e.action
    if e.path.len > 0:
        s.* += " " + e.path
    if e.code == TIMED_OUT:
        s.* += ": the timeout ran out"
    else:
        s.* += ": " + reason(e.code)

priv type Stream:
    writing: Lock[Outbox]
    reading: Lock[Inbox]
    fd: i32
    open: bool
    socket: bool
    by_lines: bool
    path: &str = heap("")

priv type Outbox:
    unsent: &str = heap("")
    failed: i32 # the code of the first write that failed

priv type Inbox:
    received: &str = heap("")
    given: i64 # how much of it read and read_line gave

priv type Streams:
    streams: &list[*Stream] = heap([])
    last: i32

# a stream is locked for reading before it is locked for writing, and nothing else is locked while the table is
priv shared context io:
    table: Lock[Streams]

priv standard_paths: array[&strview, 3] = ["the standard input", "the standard output", "the error output"]

# each thread keeps the streams of stdin, stdout and stderr, so print doesn't lock the table
priv context cached:
    standard: array[*Stream?, 3]

priv func stream(f: File, place: &strview = @here()) -> *Stream:
    valid(f, place)
    if f.fd < 3:
        known := cached.standard[f.fd]
        if known is *Stream and known.open:
            return known
    with lock(io.table):
        streams := ptr(io.table.value.streams)
        if streams.len == 0:
            atexit(ptr(flag_exit))
        while streams.len <= f.fd:
            append(streams, 0 as *Stream)
        if streams[f.fd] as u64 == 0:
            streams[f.fd] = heap(Stream{fd = f.fd})
        s := streams[f.fd]
        if not s.open:
            s.open = true
            s.fd = f.fd
            recognize(s)
            s.by_lines = not s.socket and (f.fd == 2 or isatty(f.fd) != 0)
            if f.fd < 3:
                s.path = standard_paths[f.fd]
        if f.fd < 3:
            cached.standard[f.fd] = s
        return s

# a file that another thread writes at this moment is left to it, so one thread never waits for another
func flush():
    with scratch():
        all: &listview[*Stream]
        with lock(io.table):
            all = tmp(io.table.value.streams)
        for s in all:
            if s as u64 != 0 and try_lock(s.writing):
                with Locked{ptr(s.writing) as *Lock[null]}:
                    drain(s)

priv export func flag_exit():
    flush()
    s := stream(stdout)
    if try_lock(s.writing) and s.writing.value.failed != 0: # never let go, the program ends
        eprint("flag: ", FsError{s.writing.value.failed, "write", s.path})
        _exit(1)

func file(fd: i32, path: &strview, place: &strview = @here()) -> File:
    f := File{fd}
    stream(f, place).path = path
    return f

# print formats its line here, and a print inside the += of a value adds its own after it
priv context printing:
    line: &str = heap("")

priv func line() -> *&str:
    return ptr(printing.line)

priv func print_line(f: File, from: i64):
    write(f, printing.line[from:])
    printing.line.len = from

func write(f: File, value: $T, place: &strview = @here()):
    with scratch():
        write(f, "" + value, place) # formatted before the lock, its += may print

func write(f: File, text: &strview, place: &strview = @here()):
    s := stream(f, place)
    if (f.fd == 1 or f.fd == 2) and io.table.value.last != f.fd:
        other := stream(File{3 - f.fd})
        switched := false
        with lock(io.table):
            switched = io.table.value.last != f.fd
            io.table.value.last = f.fd
        if switched:
            with lock(other.writing):
                drain(other) # stdout and stderr keep the order of the calls
    with lock(s.writing):
        outbox := ptr(s.writing.value)
        outbox.unsent += text
        if outbox.unsent.len >= 65536 or s.by_lines and contains(text, "\n"):
            drain(s)
            if outbox.unsent.cap > 131072:
                free(outbox.unsent) # after a big text the stream keeps only its usual room

func flush(f: File, place: &strview = @here()) -> FsError?:
    s := stream(f, place)
    with lock(s.writing):
        drain(s)
        outbox := ptr(s.writing.value)
        if outbox.failed == 0:
            return null
        failed := FsError{outbox.failed, "write", tmp(s.path)}
        outbox.failed = 0
        return failed

priv func drain(s: *Stream):
    outbox := ptr(s.writing.value)
    sent := 0
    while sent < outbox.unsent.len:
        n := transfer(s, ptr(outbox.unsent.*) + sent, outbox.unsent.len - sent, true)
        if n is FsError:
            if outbox.failed == 0:
                outbox.failed = n.code
            break
        sent += n
    outbox.unsent.len = 0

func read(f: File, into: *&str, size: i64, place: &strview = @here()) -> i64|FsError:
    s := stream(f, place)
    with lock(s.reading):
        inbox := ptr(s.reading.value)
        if inbox.given == inbox.received.len:
            inbox.given = 0
            inbox.received.len = 0
            if size >= 65536:
                return receive(s, into, size) # straight into yours, without a copy
            try receive(s, inbox.received, 65536)
        taken := inbox.received.len - inbox.given
        if taken > size:
            taken = size
        into.* += inbox.received[inbox.given:inbox.given + taken]
        inbox.given += taken
        return taken

func read_line(f: File, place: &strview = @here()) -> &strview|null|FsError:
    s := stream(f, place)
    with lock(s.reading):
        inbox := ptr(s.reading.value)
        checked := 0
        while true:
            line: &strview
            line = ptr(inbox.received.*) + inbox.given
            line.len = inbox.received.len - inbox.given
            end := memchr(ptr(line.*) + checked, '\n', line.len - checked)
            if end as u64 != 0:
                line.len = end - ptr(line.*)
                inbox.given += line.len + 1
                if line.len > 0 and line[-1] == '\r':
                    line.len -= 1
                return tmp(line)
            checked = line.len
            if inbox.given > 0:
                memmove(ptr(inbox.received.*), ptr(line.*), line.len)
                inbox.received.len = line.len
                inbox.given = 0
            if try receive(s, inbox.received, 65536) == 0:
                inbox.given = inbox.received.len
                if inbox.received.len == 0:
                    return null
                return tmp(view(inbox.received))

priv func receive(s: *Stream, into: *&str, size: i64) -> i64|FsError:
    flush() # what you wrote goes out before the program waits for an answer
    reserve(into, into.len + size)
    got := try transfer(s, ptr(into.*.*) + into.len, size, false)
    into.len += got
    return got

priv func transfer(s: *Stream, at: *bytes, size: i64, writing: bool) -> i64|FsError:
    part := size
    if part > 1 << 30:
        part = 1 << 30 # macOS refuses 2 GiB in one call, and Windows counts in an i32
    while true:
        n := moved(s, at, part, writing)
        if n >= 0:
            return n
        code := failure(s, writing)
        if code != 0 and writing:
            return FsError{code, "write", ""} # drain keeps only its code, so a crash can write without memory
        if code != 0:
            return FsError{code, "read", tmp(s.path)}

func ready(f: File, seconds: f64 = 0.0, place: &strview = @here()) -> bool:
    with scratch():
        return ready(ptr([f]), seconds, place).len > 0

func ready(files: &listview[File], seconds: f64 = 0.0, place: &strview = @here()) -> &listview[i64] where not @windows():
    flush() # what you wrote goes out before the program waits for an answer
    polled: &list[array[i32, 2]] = heap([]) # each a struct pollfd: the descriptor, POLLIN, and what poll finds
    defer free(polled)
    limit := milliseconds(seconds)
    for f in files:
        valid(f, place)
        append(polled, [f.fd, 1])
        if buffered(f):
            limit = 0
    while poll(ptr(polled.*), polled.len, limit) < 0 and errno() == 4: # EINTR
        pass
    found: &list[i64] = heap([])
    defer free(found)
    for i, p in polled:
        if p[1] >> 16 != 0 or buffered(files[i]):
            append(found, i)
    return tmp(found)

# WSAPoll waits only for sockets, so with a pipe or a console it looks again every millisecond
func ready(files: &listview[File], seconds: f64 = 0.0, place: &strview = @here()) -> &listview[i64] where @windows():
    flush()
    limit := milliseconds(seconds)
    began := GetTickCount64()
    sockets: &list[Polled] = heap([])
    defer free(sockets)
    found: &list[i64] = heap([])
    defer free(found)
    while true:
        clear(sockets)
        for f in files:
            valid(f, place)
            if f.fd >= 8192:
                append(sockets, Polled{u64(f.fd - 8192), 0x100, 0}) # POLLRDNORM
        if sockets.len > 0:
            WSAPoll(ptr(sockets.*), u32(sockets.len), 0)
        k := 0
        for i, f in files:
            hit := buffered(f)
            if f.fd >= 8192:
                hit = hit or sockets[k].found != 0
                k += 1
            else:
                hit = hit or arrived(_get_osfhandle(f.fd))
            if hit:
                append(found, i)
        left := limit - i32(GetTickCount64() - began)
        if found.len > 0 or limit >= 0 and left <= 0:
            return tmp(found)
        if sockets.len == files.len:
            WSAPoll(ptr(sockets.*), u32(sockets.len), left) # then the next round tells which
        elif sockets.len > 0:
            WSAPoll(ptr(sockets.*), u32(sockets.len), 1)
        else:
            Sleep(1)

priv type Polled: # a WSAPOLLFD
    socket: u64
    events: i16
    found: i16

priv func arrived(file: u64) -> bool:
    kind := GetFileType(file)
    if kind == 3: # FILE_TYPE_PIPE
        left: u32 = 0
        return PeekNamedPipe(file, 0 as *bytes, 0, 0 as *u32, ptr(left), 0 as *u32) == 0 or left > 0 # a pipe that is broken gives its end
    if kind == 2: # FILE_TYPE_CHAR, a console
        return WaitForSingleObject(file, 0) == 0
    return true

priv func milliseconds(seconds: f64) -> i32:
    if seconds < 0.0:
        return -1
    if seconds > 2000000.0:
        return 2000000000 # 23 days, about the most an i32 of milliseconds holds
    return i32(seconds * 1000.0 + 0.999)

# what a read gives without asking the system, and nothing when another thread is reading it now
priv func buffered(f: File) -> bool:
    s := 0 as *Stream
    with lock(io.table):
        if f.fd < io.table.value.streams.len:
            s = io.table.value.streams[f.fd]
    if s as u64 == 0 or not s.open or not try_lock(s.reading):
        return false
    with Locked{ptr(s.reading) as *Lock[null]}:
        return s.reading.value.given < s.reading.value.received.len

priv func valid(f: File, place: &strview):
    if f.fd < 0:
        panic("File{" + f.fd + "} is not an open file", place)

func close(f: File, place: &strview = @here()):
    s := stream(f, place)
    with lock(s.reading):
        with lock(s.writing):
            drain(s)
            s.writing.value.failed = 0
            s.path.len = 0
            inbox := ptr(s.reading.value)
            inbox.received.len = 0
            inbox.given = 0
            if inbox.received.cap > 131072:
                free(inbox.received) # after a long line the stream keeps only its usual room
            with lock(io.table):
                s.open = false
            release(s) # last, a file that another thread opens can get the same number

operator with(f: File, place: &strview = @here()):
    close(f, place)

func errno() -> i32 where @linux():
    return __errno_location().*

func errno() -> i32 where @macos():
    return __error().*

func errno() -> i32 where @windows():
    return _errno().*

priv func moved(s: *Stream, at: *bytes, size: i64, writing: bool) -> i32 where @linux():
    if not writing:
        return read(s.fd, at, size)
    if s.socket:
        return send(i64(s.fd), at, size, 0x4000) # MSG_NOSIGNAL, a closed peer is an error and not a signal
    return write(s.fd, at, size)

priv func moved(s: *Stream, at: *bytes, size: i64, writing: bool) -> i32 where @macos():
    if writing:
        return write(s.fd, at, size) # net sets SO_NOSIGPIPE on its sockets
    return read(s.fd, at, size)

priv func moved(s: *Stream, at: *bytes, size: i64, writing: bool) -> i32 where @windows():
    if s.socket and writing:
        return send(i64(s.fd), at, size, 0)
    if s.socket:
        return recv(i64(s.fd), at, size, 0)
    if writing:
        return write(s.fd, at, size)
    return read(s.fd, at, size)

priv func failure(s: *Stream, writing: bool) -> i32 where not @windows():
    code := errno()
    blocked := code == 11 or code == 35 # EAGAIN, 11 on Linux and 35 on macOS, where the other number is not an error of read or write
    if blocked and s.socket:
        return TIMED_OUT
    if blocked:
        events: i32 = 1 # POLLIN
        if writing:
            events = 4 # POLLOUT
        polled := array[i32, 2]{s.fd, events} # a struct pollfd
        poll(ptr(polled) as *bytes, 1, -1)
        return 0
    if code == 4: # EINTR
        return 0
    return code

priv func failure(s: *Stream, writing: bool) -> i32 where @windows():
    if s.socket:
        return 0 - WSAGetLastError()
    return errno()

priv func recognize(s: *Stream) where not @windows():
    address: array[u8, 128]
    size: u32 = 128
    s.socket = getsockname(i64(s.fd), ptr(address) as *bytes, ptr(size)) == 0

priv func recognize(s: *Stream) where @windows():
    s.socket = s.fd >= 8192 # net gives a socket as File{8192 + handle}, past every descriptor of the C runtime, so the numbers never meet
    if s.socket:
        s.fd -= 8192

priv func release(s: *Stream) where not @windows():
    close(s.fd)

priv func release(s: *Stream) where @windows():
    if s.socket:
        closesocket(i64(s.fd))
    else:
        close(s.fd)

priv func reason(code: i32) -> &strview where @linux():
    if code < 0:
        return view(gai_strerror(code))
    return view(strerror(code))

priv func reason(code: i32) -> &strview where @macos():
    if code < 0:
        return view(gai_strerror(0 - code))
    return view(strerror(code))

priv func reason(code: i32) -> &strview where @windows():
    if code >= 0:
        return view(strerror(code))
    text: array[u16, 512]
    FormatMessageW(0x1200, 0 as *bytes, u32(0 - code), 0, ptr(text) as wstr, 512, 0 as *bytes)
    return trim_end(tmp(ptr(text) as wstr)) + " (" + (0 - code) + ")"

type entry[$K, $V]:
    key: $K
    value: $V

type fatptr map[$K, $V]:
    len: i64
    cap: i64
    arena: *Arena

operator hash(s: &strview) -> u64:
    # FNV-1a
    h: u64 = 0xcbf2_9ce4_8422_2325
    for b in items(s):
        h = (h xor u64(b)) * 0x100_0000_01b3
    return h

operator hash(n: $T) -> u64 where $T is Integer:
    h := u64(n) * 0x9e37_79b9_7f4a_7c15 # 2^64 over the golden ratio
    return h xor (h >> 32)

operator hash(f: f64) -> u64:
    if f == 0.0:
        return 0
    return hash(f as u64)

operator hash(f: f32) -> u64:
    return hash(f64(f))

priv type Slot[$K, $V]:
    hash: u64
    key: $K
    value: $V

priv func slots(m: &map[$K, $V]) -> &listview[Slot[$K, $V]]:
    out: &listview[Slot[$K, $V]]
    out = ptr(m.*)
    out.len = m.cap
    return out

priv TAKEN = 0x8000_0000_0000_0000 # in the hash of every key, so 0 marks a free slot

priv func locate(m: &map[$K, $V], key: $Q) -> i64:
    table := slots(m)
    h := hash(key) or TAKEN
    i := i64(h) and m.cap - 1
    while table[i].hash != 0 and (table[i].hash != h or table[i].key != key):
        i = (i + 1) and m.cap - 1
    return i

# keys of text are copies that the map frees, so those maps have functions of their own
func put(m: *&map[$K, $V], key: $K, value: $V) where $K != &str:
    put(m, key).* = value

func put(m: *&map[&str, $V], key: &strview, value: $V):
    put(m, key).* = value

operator []=(m: *&map[$K, $V], key: $K, value: $V) where $K != &str:
    put(m, key, value)

operator []=(m: *&map[&str, $V], key: &strview, value: $V):
    put(m, key, value)

operator []=(m: *&map[$K, $V], key: $K) -> *$V where $K != &str:
    return put(m, key)

operator []=(m: *&map[&str, $V], key: &strview) -> *$V:
    return put(m, key)

priv func put(m: *&map[$K, $V], key: $Q) -> *$V:
    reserve(m, m.len + 1)
    i := locate(m.*, key)
    table := slots(m.*)
    if table[i].hash == 0:
        where $K == &str:
            table[i] = Slot[$K, $V]{hash = hash(key) or TAKEN, key = arena(m.arena, key)}
        where $K != &str:
            table[i] = Slot[$K, $V]{hash = hash(key) or TAKEN, key = key}
        m.len += 1
    return ptr(table[i].value)

operator [](m: &map[$K, $V], key: $K) -> $V|null where $K != &str:
    return found(m, key)

operator [](m: &map[&str, $V], key: &strview) -> $V|null:
    return found(m, key)

priv func found(m: &map[$K, $V], key: $Q) -> $V|null:
    if m.cap == 0:
        return null
    table := slots(m)
    i := locate(m, key)
    if table[i].hash == 0:
        return null
    return table[i].value

func contains(m: &map[$K, $V], key: $K) -> bool where $K != &str:
    return m.cap > 0 and slots(m)[locate(m, key)].hash != 0

func contains(m: &map[&str, $V], key: &strview) -> bool:
    return m.cap > 0 and slots(m)[locate(m, key)].hash != 0

func remove(m: *&map[$K, $V], key: $K) -> $V|null where $K != &str:
    return removed(m, key)

func remove(m: *&map[&str, $V], key: &strview) -> $V|null:
    return removed(m, key)

priv func removed(m: *&map[$K, $V], key: $Q) -> $V|null:
    if m.cap == 0:
        return null
    table := slots(m.*)
    hole := locate(m.*, key)
    if table[hole].hash == 0:
        return null
    value := table[hole].value
    where $K == &str:
        free(table[hole].key)
    j := hole
    while table[(j + 1) and m.cap - 1].hash != 0:
        j = (j + 1) and m.cap - 1
        home := i64(table[j].hash) and m.cap - 1
        if j > hole and (home <= hole or home > j) or j < hole and home <= hole and home > j:
            table[hole] = table[j]
            hole = j
    table[hole].hash = 0
    m.len -= 1
    return value

func reserve(m: *&map[$K, $V], want: i64):
    if (want < 0 or want > m.cap / 2) and try_reserve(m, want) is NoMemory:
        out_of_memory()

func try_reserve(m: *&map[$K, $V], want: i64) -> NoMemory?:
    if want < 0 or want > MOST / 2 / @sizeof(Slot[$K, $V]):
        return NoMemory
    if want <= m.cap / 2:
        return null
    cap := m.cap
    if cap < 16:
        cap = 16
    while cap < want * 2:
        cap *= 2
    grown := resize(m.arena, 0 as *bytes, 0, cap * @sizeof(Slot[$K, $V]), NO_MAP)
    if grown as u64 == 0:
        return NoMemory
    old := slots(m.*)
    memset(grown, 0, cap * @sizeof(Slot[$K, $V]))
    m.* = grown
    m.cap = cap
    table := slots(m.*)
    for s in old:
        if s.hash != 0:
            j := i64(s.hash) and cap - 1
            while table[j].hash != 0:
                j = (j + 1) and cap - 1
            table[j] = s
    discard(m.arena, ptr(old.*))
    return null

func clear(m: *&map[$K, $V]):
    table := slots(m.*)
    for i in 0..table.len:
        where $K == &str:
            if table[i].hash != 0:
                free(table[i].key)
        table[i].hash = 0
    m.len = 0

func free(m: *&map[$K, $V]):
    where $K == &str:
        clear(m)
    discard(m.arena, ptr(m.*.*))
    m.* = 0 as *bytes
    m.len = 0
    m.cap = 0

priv type Pairs[$K, $V]:
    table: &listview[Slot[$K, $V]]
    i: i64

operator for(m: &map[$K, $V]) -> Pairs[$K, $V]:
    return Pairs[$K, $V]{slots(m), 0}

operator next(p: *Pairs[$K, $V]) -> entry[$K, $V]|IterationEnd:
    while p.i < p.table.len:
        p.i += 1
        s := p.table[p.i - 1]
        if s.hash != 0:
            return entry[$K, $V]{s.key, s.value}
    return IterationEnd

operator +=(s: *&str, m: &map[$K, $V]):
    s.* += "{"
    first := true
    for e in m:
        if not first:
            s.* += ", "
        first = false
        s.* += e.key + ": " + e.value
    s.* += "}"

type fixmap[$K, $V, $$max]:
    len: i64
    entries: array[entry[$K, $V], $$max]

type error MapFull

priv func place(m: *fixmap[$K, $V, $$max], key: $K) -> i64:
    i := 0
    while i < m.len and m.entries[i].key != key:
        i += 1
    return i

func put(m: *fixmap[$K, $V, $$max], key: $K, value: $V) -> MapFull?:
    i := place(m, key)
    if i == $$max:
        return MapFull
    if i == m.len:
        m.len += 1
    m.entries[i] = entry[$K, $V]{key, value}
    return null

operator []=(m: *fixmap[$K, $V, $$max], key: $K, value: $V) -> MapFull?:
    return put(m, key, value)

operator [](m: *fixmap[$K, $V, $$max], key: $K) -> $V|null:
    i := place(m, key)
    if i == m.len:
        return null
    return m.entries[i].value

func contains(m: *fixmap[$K, $V, $$max], key: $K) -> bool:
    return place(m, key) < m.len

func remove(m: *fixmap[$K, $V, $$max], key: $K) -> $V|null:
    i := place(m, key)
    if i == m.len:
        return null
    value := m.entries[i].value
    for k in i..m.len - 1:
        m.entries[k] = m.entries[k + 1]
    m.len -= 1
    return value

func clear(m: *fixmap[$K, $V, $$max]):
    m.len = 0

operator for(m: *fixmap[$K, $V, $$max]) -> Walk[entry[$K, $V]]:
    return Walk[entry[$K, $V]]{ptr(m.entries) as *bytes, m.len, 0}

operator ==(a: *fixmap[$K, $V, $$max], b: *fixmap[$K, $V, $$max]) -> bool:
    if a.len != b.len:
        return false
    for i in 0..a.len:
        k := place(b, a.entries[i].key)
        if k == b.len or b.entries[k].value != a.entries[i].value:
            return false
    return true

operator hash(m: *fixmap[$K, $V, $$max]) -> u64:
    h: u64 = 0
    for i in 0..m.len:
        h += hash(m.entries[i].key) * 31 + hash(m.entries[i].value) # a sum, so the order of the entries doesn't count
    return h

operator +=(s: *&str, m: *fixmap[$K, $V, $$max]):
    s.* += "{"
    for i in 0..m.len:
        if i > 0:
            s.* += ", "
        s.* += m.entries[i].key + ": " + m.entries[i].value
    s.* += "}"

@trust
priv SHOWN_CALLS = 20

priv type Function:
    start: u64
    place: u32
    library: bool

priv type Crash:
    frame: u64
    code: u64
    stack: u64
    address: u64
    leaf: u64 # where a function of C keeps the address it returns to while it keeps nothing on the stack

priv type Chain:
    head: u64
    table: &listview[Function]
    line: i64
    times: i64
    shown: i64
    more: i64

priv context failing:
    stack: *bytes # where the handler runs, each thread takes its own

priv shared context failure:
    telling: Lock[null] # the first thread that fails takes it and keeps it, the others wait there for the end
    hook: func(&strview, &strview) # what on_panic gave, it runs before the program ends with 134

# one thread tells how the program fails, and if it fails again while it tells, it ends at once
priv func tell(code: i32):
    if get(failure.telling.owner) == me():
        _exit(code)
    lock(failure.telling)

priv export func flag_start():
    catch_crashes()
    guard_stack()

priv func catch_crashes() where @linux():
    for signal in [4, 7, 8, 11]: # SIGILL, SIGBUS, SIGFPE, SIGSEGV
        catch(i32(signal))

priv func catch_crashes() where @macos():
    for signal in [4, 8, 10, 11]: # SIGILL, SIGFPE, SIGBUS, SIGSEGV
        catch(i32(signal))

priv func catch(signal: i32) where @linux():
    action: array[u64, 19] # struct sigaction: the handler, the mask, the flags and the restorer
    action[0] = ptr(flag_crash) as u64
    action[17] = 0x4800_0004 # SA_NODEFER, SA_ONSTACK, SA_SIGINFO
    sigaction(signal, ptr(action) as *bytes, 0 as *bytes)

priv func catch(signal: i32) where @macos():
    action := [ptr(flag_crash) as u64, 0x51 << 32] # struct sigaction: the handler, then the mask and the flags SA_SIGINFO, SA_NODEFER and SA_ONSTACK
    sigaction(signal, ptr(action) as *bytes, 0 as *bytes)

priv func catch_crashes() where @windows():
    AddVectoredExceptionHandler(1, ptr(flag_exception))

priv type Test:
    name: cstr
    run: func()

priv shared context testing:
    overtime: &str = heap("") # what a test says when its time is up
    thread: u64 # the thread that runs the test, on Windows

# the main of the program that flagc test builds: it runs the test it names, in the seconds it gives
priv func run_test() -> i32:
    head := flag_tests()
    tests: &listview[Test]
    tests = head as *bytes + 8
    tests.len = head.*
    given: &listview[cstr]
    given = @argv()
    given.len = @argc()
    if given.len < 2:
        eprint("flag: name the test to run")
        return 2
    for t in tests:
        if view(t.name) == view(given[1]):
            dup2(1, 2) # what the test writes to each one comes out in order
            if given.len > 2:
                seconds := parse_int(view(given[2])) ifnull 0
                if seconds > 0:
                    testing.overtime += "the test takes more than " + seconds + " s"
                    limit(u32(seconds))
            t.run()
            return 0
    eprint("flag: there is no test named ", view(given[1]))
    return 2

priv func limit(seconds: u32) where not @windows():
    catch(14) # SIGALRM
    alarm(seconds)

priv func limit(seconds: u32) where @windows():
    DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), ptr(testing.thread), 0, 0, 2) # DUPLICATE_SAME_ACCESS
    timer: u64 = 0
    CreateTimerQueueTimer(ptr(timer), 0, ptr(flag_overtime), 0 as *bytes, seconds * 1000, 0, 8) # WT_EXECUTEONLYONCE

priv export func flag_overtime(parameter: *bytes, fired: u8) where @windows():
    SuspendThread(testing.thread)
    room: array[u64, 160]
    context := (ptr(room) as u64 + 15) / 16 * 16 # a CONTEXT is aligned to 16
    ((context + 48) as *u32).* = 0x10_0003 # ContextFlags: CONTEXT_CONTROL and CONTEXT_INTEGER
    GetThreadContext(testing.thread, context as *bytes)
    record: array[u64, 6] # with no address in it
    crashed(testing.overtime, crash(ptr(record) as u64, context), 142)

# each thread keeps room for the handler, so a stack overflow is reported too
priv func guard_stack() where @linux():
    failing.stack = malloc(65536)
    if failing.stack as u64 == 0:
        out_of_memory()
    stack := [failing.stack as u64, 0, 65536] # stack_t: where, the flags and the size
    sigaltstack(ptr(stack) as *bytes, 0 as *bytes)

priv func guard_stack() where @macos():
    failing.stack = malloc(65536)
    if failing.stack as u64 == 0:
        out_of_memory()
    stack := [failing.stack as u64, 65536, 0] # stack_t: where, the size and the flags
    sigaltstack(ptr(stack) as *bytes, 0 as *bytes)

priv func guard_stack() where @windows():
    room: u32 = 65536 # what a stack overflow leaves to the handler
    SetThreadStackGuarantee(ptr(room))

priv func drop_stack() where @linux():
    stack := [0, 2, 0] # SS_DISABLE
    sigaltstack(ptr(stack) as *bytes, 0 as *bytes)
    free(failing.stack)

priv func drop_stack() where @macos():
    stack := [0, 0, 4] # SS_DISABLE
    sigaltstack(ptr(stack) as *bytes, 0 as *bytes)
    free(failing.stack)

priv func drop_stack() where @windows():
    return

priv export func flag_crash(signal: i32, info: *bytes, context: *bytes):
    c := crash(info as u64, context as u64)
    what: &strview = "invalid memory access"
    if signal == 4:
        what = "illegal instruction"
    elif signal == 8:
        what = "arithmetic error"
    elif signal == 14:
        what = testing.overtime
    elif c.address + 65536 >= c.stack and c.address < c.stack + 1048576:
        what = "stack overflow"
    crashed(what, c, 128 + signal)

priv export func flag_exception(pointers: *bytes) -> i32:
    record := peek(pointers as u64)
    code := (record as *u32).*
    what: &strview
    switch code:
    case 0xc0000005, 0xc0000006: # EXCEPTION_ACCESS_VIOLATION, EXCEPTION_IN_PAGE_ERROR
        what = "invalid memory access"
    case 0xc00000fd:
        what = "stack overflow"
    case 0xc000001d, 0xc0000096:
        what = "illegal instruction"
    case 0xc0000094, 0xc0000095:
        what = "arithmetic error"
    if what.len > 0:
        crashed(what, crash(record, peek(pointers as u64 + 8)), i32(code))
    return 0 # EXCEPTION_CONTINUE_SEARCH, the exception is not one that ends the program

priv func crash(info: u64, context: u64) -> Crash where @linux() and @x86_64():
    return {peek(context + 120), peek(context + 168), peek(context + 160), peek(info + 16), peek(context + 160)} # rbp, rip and rsp of the ucontext_t, si_addr of the siginfo_t

priv func crash(info: u64, context: u64) -> Crash where @linux() and @arm64():
    return {peek(context + 416), peek(context + 440), peek(context + 432), peek(info + 16), context + 424} # x29, pc, sp and x30

priv func crash(info: u64, context: u64) -> Crash where @linux() and @riscv64():
    return {peek(context + 240), peek(context + 176), peek(context + 192), peek(info + 16), context + 184} # s0, pc, sp and ra

priv func crash(info: u64, context: u64) -> Crash where @macos() and @x86_64():
    state := peek(context + 48)
    return {peek(state + 64), peek(state + 144), peek(state + 72), peek(info + 24), peek(state + 72)} # rbp, rip and rsp of the mcontext, si_addr

priv func crash(info: u64, context: u64) -> Crash where @macos() and @arm64():
    state := peek(context + 48)
    return {peek(state + 248), peek(state + 272), peek(state + 264), peek(info + 24), state + 256} # fp, pc, sp and lr

priv func crash(record: u64, context: u64) -> Crash where @windows():
    return {peek(context + 0xa0), peek(context + 0xf8), peek(context + 0x98), peek(record + 40), peek(context + 0x98)} # Rbp, Rip and Rsp of the CONTEXT, the address of an access violation

# asks for no memory and waits for no lock: a crash can come from inside malloc, or while a lock is held
priv func crashed(what: &strview, c: Crash, code: i32) -> never:
    tell(code)
    if what == "stack overflow":
        c.leaf = 0 # the stack pointer can be past the end of the stack
    drain()
    report("flag: ")
    report(what)
    if what == "invalid memory access":
        report(" at 0x")
        report(c.address, 16)
    report("\n")
    trace(c)
    _exit(code)

# what was written goes out, without memory and without waiting for a lock, and the locks it takes stay taken: the program ends
priv func drain():
    if try_lock(io.table):
        for s in io.table.value.streams:
            if s as u64 != 0 and try_lock(s.writing):
                drain(s)

# the functions of yours in the chain of calls, read from the frame pointers and written without memory of its own
priv func trace(c: Crash):
    head := flag_functions() as u64 # how many functions, where the last one ends, and then each function in the order of their code
    table: &listview[Function]
    table = (head + 16) as *bytes
    table.len = i64(peek(head))
    chain := Chain{head, table, table.len, 0, 0, 0}
    code := c.code
    fp := c.frame
    reached := false # a function of the program, the library too
    while true:
        if code == 0 and fp != 0 and fp % 8 == 0:
            code = peek(fp + 8) - 1
            up := peek(fp)
            if up <= fp:
                up = 0 # the stack grows down, a caller is above
            fp = up
        low: i64 = 0 # how many functions start at code or before it
        high := table.len
        while low < high:
            middle := (low + high) / 2
            if table[middle].start <= code:
                low = middle + 1
            else:
                high = middle
        known := low > 0 and (low < table.len or code < peek(head + 8))
        if not known and reached:
            break # a function of C that called yours
        if not known: # the crash is in a function of C
            framed := fp >= c.stack and fp < c.stack + STACK
            if c.leaf != 0 and not (framed and peek(c.leaf) == peek(fp + 8)):
                code = peek(c.leaf) - 1 # it keeps nothing on the stack yet, so this is where it returns
            elif framed:
                code = 0 # its frame pointers lead to yours
            else:
                break
            c.leaf = 0
            continue
        reached = true
        code = 0
        f := low - 1
        if table[f].library:
            continue
        if f == chain.line:
            chain.times += 1
        else:
            put_line(chain)
            chain.line = f
            chain.times = 1
    put_line(chain)
    if chain.more > 0:
        report("  ... and ")
        report(u64(chain.more), 10)
        report(" more\n")

priv func put_line(chain: *Chain):
    if chain.line == chain.table.len:
        return
    if chain.shown == SHOWN_CALLS:
        chain.more += 1
        return
    chain.shown += 1
    report("  in ")
    report(view((chain.head + chain.table[chain.line].place) as cstr))
    if chain.times > 1:
        report(", ")
        report(u64(chain.times), 10)
        report(" times")
    report("\n")

priv func peek(at: u64) -> u64:
    return (at as *u64).*

priv func report(text: &strview):
    write(2, ptr(text.*), text.len)

priv func report(n: u64, base: u64):
    digits: array[u8, 20]
    i := 20
    while true:
        i -= 1
        digits[i] = "0123456789abcdef"[n % base]
        n = n / base
        if n == 0:
            break
    report(view(digits[i:]))
