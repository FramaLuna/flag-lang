module ring

type fatptr ring[$T]:
    len: i64
    cap: i64
    first: i64

# an empty ring of kind, which grows in the heap: q := ring(i32)
func ring(kind: type $T) -> &ring[$T]:
    out: &ring[$T]
    out = 0 as *bytes # no elements yet, the first one allocates
    return out

priv func slot(r: &ring[$T], i: i64) -> *$T:
    return (ptr(r.*) + (r.first + i) % r.cap * @sizeof($T)) as *$T

priv func grow(r: *&ring[$T]):
    if r.len < r.cap:
        return
    cap := r.cap * 2
    if cap < 8:
        cap = 8
    moved := malloc(cap * @sizeof($T))
    if moved as u64 == 0:
        out_of_memory()
    for i in 0..r.len:
        ((moved + i * @sizeof($T)) as *$T).* = slot(r.*, i).*
    free(ptr(r.*.*))
    r.* = moved
    r.cap = cap
    r.first = 0

func append(r: *&ring[$T], v: $T):
    grow(r)
    r.len += 1
    slot(r.*, r.len - 1).* = v

func prepend(r: *&ring[$T], v: $T):
    grow(r)
    r.first = (r.first + r.cap - 1) % r.cap
    r.len += 1
    slot(r.*, 0).* = v

func pop(r: *&ring[$T]) -> $T|null:
    if r.len == 0:
        return null
    r.len -= 1
    return slot(r.*, r.len).*

func take(r: *&ring[$T]) -> $T|null:
    if r.len == 0:
        return null
    v := slot(r.*, 0).*
    r.first = (r.first + 1) % r.cap
    r.len -= 1
    return v

operator [](r: &ring[$T], i: $I, place: &strview = @here()) -> *$T where $I is Integer:
    n := i64(i)
    if u64(n) >= u64(r.len): # a negative is past every length
        out_of_bounds(i, r.len, place = place)
    return slot(r, n)

func clear(r: *&ring[$T]):
    r.len = 0
    r.first = 0

func free(r: *&ring[$T]):
    free(ptr(r.*.*))
    r.* = 0 as *bytes
    r.len = 0
    r.cap = 0
    r.first = 0

priv type Walk[$T]:
    r: &ring[$T]
    i: i64

operator for(r: &ring[$T]) -> Walk[$T]:
    return Walk[$T]{r, 0}

operator next(w: *Walk[$T]) -> $T|IterationEnd:
    if w.i == w.r.len:
        return IterationEnd
    w.i += 1
    return slot(w.r, w.i - 1).*

operator +=(s: *&str, r: &ring[$T]):
    s.* += "["
    for i, v in r:
        if i > 0:
            s.* += ", "
        s.* += v
    s.* += "]"
