func DisableLeakTrackingForThread(This: *IDXGIDebug1):
    This.lpVtbl.DisableLeakTrackingForThread(This)

func IsLeakTrackingEnabledForThread(This: *IDXGIDebug1) -> WINBOOL:
    return This.lpVtbl.IsLeakTrackingEnabledForThread(This)
