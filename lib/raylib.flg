module raylib
use math

type Vector2:
    x: f32
    y: f32

type Vector3:
    x: f32
    y: f32
    z: f32

type Color:
    r: u8
    g: u8
    b: u8
    a: u8

type Rectangle:
    x: f32
    y: f32
    width: f32
    height: f32

type Image:
    data: *bytes
    width: i32
    height: i32
    mipmaps: i32
    format: i32

type Texture:
    id: u32
    width: i32
    height: i32
    mipmaps: i32
    format: i32

type RenderTexture:
    id: u32
    texture: Texture
    depth: Texture

type GlyphInfo:
    value: i32
    offset_x: i32
    offset_y: i32
    advance_x: i32
    image: Image

type Font:
    base_size: i32
    glyph_count: i32
    glyph_padding: i32
    texture: Texture
    recs: *Rectangle
    glyphs: *GlyphInfo

type Camera2D:
    offset: Vector2
    target: Vector2
    rotation: f32
    zoom: f32

type Camera3D:
    position: Vector3
    target: Vector3
    up: Vector3
    fovy: f32
    projection: i32

type AudioStream:
    buffer: *bytes
    processor: *bytes
    sample_rate: u32
    sample_size: u32
    channels: u32

type Sound:
    stream: AudioStream
    frame_count: u32

type Music:
    stream: AudioStream
    frame_count: u32
    looping: bool
    context_type: i32
    context_data: *bytes

extern "raylib":
    func InitWindow(width: i32, height: i32, title: cstr)
    func CloseWindow()
    func WindowShouldClose() -> bool
    func SetConfigFlags(flags: u32)
    func SetTargetFPS(fps: i32)
