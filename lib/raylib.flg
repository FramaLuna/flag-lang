    func GetWindowPosition() -> Vector2
    func MaximizeWindow()
    func MinimizeWindow()
    func RestoreWindow()
    func IsWindowMaximized() -> bool
    func IsWindowMinimized() -> bool
    func IsWindowResized() -> bool
