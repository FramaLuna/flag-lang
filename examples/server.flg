use net

func main() -> i32:
    server := listen(8080)
    if server is NetError:
        eprint(server)
        return 1
    print("serving on http://localhost:8080, ctrl+c stops it")
    visits := 0
    while true:
        client := accept(server)
        if client is NetError:
            continue
        with client:
            timeout(client, 5.0)
            with scratch():
                request := read_line(client)
                header := request
                while header is &strview and header.len > 0:
                    header = read_line(client) # the headers end with an empty line
                if request is &strview:
                    visits += 1
                    print(visits, " ", request)
                    body := "hello from flag, you are visit number " + visits + "\n"
                    write(client, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " + body.len + "\r\nConnection: close\r\n\r\n" + body)
