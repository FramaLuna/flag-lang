use net

func main() -> i32:
    server := listen(8080)
    if server is NetError:
        eprint(server)
        return 1
    print("serving on http://localhost:8080, ctrl+c stops it")
    visits := 0
    request: &str
    defer free(request)
    while true:
        client := accept(server)
        if client is NetError:
            continue
        timeout(client, 5.0)
        request.len = 0
        with scratch():
            got := receive(client, request, 65536)
            if got is NetError:
                eprint(got)
            else:
                line := view(request)
                cut := find(line, "\r\n")
                if cut is usize:
                    line = line[:cut]
                visits += 1
                print(visits, " ", line)
                body := "hello from flag, you are visit number " + visits + "\n"
                _ = send(client, "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: " + body.len + "\r\nConnection: close\r\n\r\n" + body)
        close(client)
