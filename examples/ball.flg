use raylib
use math

func main() -> i32:
    InitWindow(800, 450, "flag + raylib")
    SetTargetFPS(60)
    position := Vector2{400, 225}
    speed := Vector2{240, 180}
    radius: f32 = 20
    color := MAROON
    bounces := 0
    label: &str
    while not WindowShouldClose():
        dt := GetFrameTime()
        if IsMouseButtonDown(MOUSE_BUTTON_LEFT):
            speed = speed + (GetMousePosition() - position) * (4 * dt)
        if IsKeyPressed(KEY_SPACE):
            color = ColorFromHSV(f32(GetRandomValue(0, 360)), 0.8, 0.9)
        position = position + speed * dt
        if position.x < radius or position.x > 800 - radius:
            speed.x = -speed.x
            bounces += 1
        if position.y < radius or position.y > 450 - radius:
            speed.y = -speed.y
            bounces += 1
        position.x = clamp(position.x, radius, 800 - radius)
        position.y = clamp(position.y, radius, 450 - radius)
        BeginDrawing()
        ClearBackground(RAYWHITE)
        DrawCircleV(position, radius, color)
        DrawText("hold the mouse to pull the ball, space recolors it", 10, 10, 20, GRAY)
        label.len = 0
        label += "bounces: " + bounces
        DrawText(label, 10, 40, 20, DARKGRAY)
        DrawFPS(10, 420)
        EndDrawing()
    CloseWindow()
    return 0
