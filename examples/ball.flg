use draw
use math
use window

func main() -> i32:
    s := open_screen("flag + draw", 800, 450)
    if s is DrawError:
        eprint(s)
        return 1
    defer close_screen(s)
    font := default_font(s, 20.0)
    x := 400.0
    y := 225.0
    speed_x := 240.0
    speed_y := 180.0
    radius := 20.0
    color := Color{190, 33, 55, 255}
    bounces := 0
    label: &str = heap("")
    defer free(label)
    while frame(s):
        dt := frame_time(s)
        if mouse_down(s, MouseLeft):
            mx, my := mouse(s)
            speed_x += (mx - x) * 4.0 * dt
            speed_y += (my - y) * 4.0 * dt
        if key_pressed(s, KeySpace):
            color = Color{u8(random(0, 255)), u8(random(0, 255)), u8(random(0, 255)), 255}
        x += speed_x * dt
        y += speed_y * dt
        if x < radius or x > 800.0 - radius:
            speed_x = -speed_x
            bounces += 1
        if y < radius or y > 450.0 - radius:
            speed_y = -speed_y
            bounces += 1
        x = clamp(x, radius, 800.0 - radius)
        y = clamp(y, radius, 450.0 - radius)
        clear(s, Color{245, 245, 245, 255})
        fill_circle(s, x, y, radius, color)
        draw_text(s, font, "hold the mouse to pull the ball, space recolors it", 10.0, 10.0, GRAY)
        label.len = 0
        label += "bounces: " + bounces
        draw_text(s, font, label, 10.0, 40.0, Color{80, 80, 80, 255})
    return 0
