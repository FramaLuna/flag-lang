use json

func main() -> i32:
    text := "{\"store\": \"corner shop\", \"items\": [{\"name\": \"apple\", \"price\": 0.5, \"count\": 40}, {\"name\": \"bread\", \"price\": 2.25, \"count\": 12}, {\"name\": \"milk\", \"price\": 1.1, \"count\": 0}]}"
    doc := parse(text)
    if doc is NotJson:
        eprint("the inventory is ", doc)
        return 1
    defer free(doc)
    print("store: ", text(doc, get(doc, 0, "store")))
    worth := 0.0
    for at in children(doc, get(doc, 0, "items")):
        name := text(doc, get(doc, at, "name"))
        price := number(doc, get(doc, at, "price"))
        units := integer(doc, get(doc, at, "count"))
        if price is null or units is null:
            eprint(name, " has no price or count")
            return 1
        if units == 0:
            print(name, ": sold out")
        else:
            print(name, ": ", units, " at ", fixed(price, 2))
            worth += price * f64(units)
    print("the stock is worth ", fixed(worth, 2))
    print("{\"store\": " + quoted("corner \"shop\"") + ", \"worth\": " + worth + "}")
    return 0
