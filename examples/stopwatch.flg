use os

func main() -> i32:
    if args().len < 2:
        eprint("usage: stopwatch program [arguments]")
        return 2
    program := args()[1:]
    start := now()
    code := run(program)
    took := now() - start
    if code is FsError:
        eprint(code)
        return 127
    d := date()
    eprint(program[0], " ended with code ", code, " after ", fixed(took, 3), " seconds, at ", d.hour, ":", d.minute / 10, d.minute % 10)
    return code
