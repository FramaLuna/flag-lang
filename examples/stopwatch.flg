use os

func main() -> i32:
    if args().len < 2:
        eprint("usage: stopwatch program [arguments]")
        return 2
    program: &list[&strview]
    defer free(program)
    for i, a in args():
        if i > 0:
            append(program, a)
    start := now()
    code := run(program)
    took := now() - start
    d := date()
    eprint(program[0], " ended with code ", code, " after ", fixed(took, 3), " seconds, at ", d.hour, ":", d.minute / 10, d.minute % 10)
    return code
