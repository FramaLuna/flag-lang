use fs
use os

type Count:
    word: &strview
    times: u32

operator <(a: Count, b: Count) -> bool:
    return a.times > b.times or a.times == b.times and a.word < b.word

func main() -> i32:
    if args().len < 2:
        eprint("usage: words file.txt")
        return 2
    file := read_file(args()[1])
    if file is FsError:
        eprint(file)
        return 1
    defer free(file)
    text := lower(file)
    letters := items(text)
    for i, c in letters:
        if (c < 'a' or c > 'z') and c != '\'':
            letters[i] = ' '
    counts: &map[&strview, u32]
    defer free(counts)
    for word in words(text):
        counts[word] += 1
    ranking: &list[Count]
    defer free(ranking)
    for e in counts:
        append(ranking, Count{e.key, e.value})
    sort(ranking)
    for i, c in ranking:
        if i == 10:
            break
        print(pad(c.times, 6), "  ", c.word)
    return 0
